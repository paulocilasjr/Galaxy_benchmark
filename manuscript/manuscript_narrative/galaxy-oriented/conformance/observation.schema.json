{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conformance observation",
  "description": "One line of observations.jsonl: what a deployment returned for one fixture. Fields a fixture does not check may be omitted.",
  "type": "object",
  "required": ["fixture_id", "response"],
  "properties": {
    "fixture_id": {"type": "string"},
    "deployment": {"type": "string", "description": "Deployment name and frozen catalogue identifier."},
    "adapter_version": {"type": "string", "description": "Interface adapter commit or version."},
    "response": {
      "type": "object",
      "properties": {
        "outcome": {"enum": ["accepted", "rejected"]},
        "job_created": {"type": "boolean"},
        "phase": {"enum": ["validation", "pre_dispatch", "runtime", "completed", "dry_run"]},
        "job_state": {"type": "string", "description": "Final job state, e.g. ok or error."},
        "resolved_state": {"type": "object", "description": "Resolved non-dataset parameters, keyed by pipe-separated path."},
        "resolved_defaults": {"type": "object", "description": "Values filled from defaults, keyed by path."},
        "comparison": {
          "type": "object",
          "properties": {
            "status": {"enum": ["matched", "mismatch", "dataset_only", "unsupported"]},
            "compared_paths": {"type": "array", "items": {"type": "string"}},
            "unsupported_paths": {"type": "array", "items": {"type": "string"}}
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "availability": {"enum": ["stderr", "stdout", "tool_message", "structured_reason", "none"]},
            "message": {"type": "string", "description": "Full returned text, not a truncated excerpt."},
            "exit_code": {"type": ["integer", "null"]},
            "unbound_keys": {"type": "array", "items": {"type": "string"}},
            "allowed_values": {"type": "array"}
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "underlying_software": {"type": "array", "items": {"type": "object", "required": ["name", "version"]}},
            "outputs": {"type": "array", "items": {"type": "object"}}
          }
        },
        "schema": {"type": ["object", "null"]},
        "results": {"type": "array", "items": {"type": "object"}},
        "response_bytes": {"type": "integer", "description": "Size of the reply returned to the agent."},
        "receipt": {
          "type": "object",
          "properties": {
            "run_id": {"type": "string"},
            "account": {"type": "string"},
            "history_id": {"type": "string"},
            "job_ids": {"type": "array", "items": {"type": "string"}},
            "execution_location": {"enum": ["workbench_job", "local", "external"]},
            "checked_by_interface": {"type": "boolean"},
            "input_hashes": {"type": "object", "description": "File name to SHA-256 of what was staged."},
            "output_hashes": {"type": "object"}
          }
        },
        "dataset": {"type": "object"},
        "dataset_count": {"type": "integer"},
        "downloaded_sha256": {"type": "string"},
        "resume_token": {"type": "string"},
        "audit_logged": {"type": "boolean"}
      }
    }
  }
}
