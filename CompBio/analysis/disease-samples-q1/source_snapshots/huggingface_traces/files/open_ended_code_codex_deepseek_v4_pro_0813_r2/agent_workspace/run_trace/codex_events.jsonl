{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np\np='disease.samples.q1.tsv'\ndf=pd.read_csv(p,sep='\\\\t',index_col=0)\nX=np.log2(df.values+1)\n# center by gene\nXc=X-X.mean(axis=1,keepdims=True)\nU,S,Vt=np.linalg.svd(Xc, full_matrices=False)\n# scores = U*S, loadings = V\nprint('S',S[:10])\nprint('V rows samples first 3')\nfor i,c in enumerate(df.columns): print(c, Vt[0,i], Vt[1,i], Vt[2,i])\ngenes=df.index\n# PC1 loadings are Vt[0] sample coefficients; gene projections U*S? Actually Xc = U S Vt. Gene loading for PC1 = U[:,0]*S[0], high positive associated with samples positive.\nld=U[:,0]*S[0]\nidx=np.argsort(ld)[::-1]\nprint('top positive genes')\nfor i in idx[:50]: print(genes[i], df.iloc[i].values, ld[i])\nprint('top negative genes')\nfor i in idx[-50:]: print(genes[i], df.iloc[i].values, ld[i])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
