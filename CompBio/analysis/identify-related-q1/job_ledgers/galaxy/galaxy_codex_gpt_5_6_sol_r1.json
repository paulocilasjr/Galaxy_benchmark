      "tool": "run_galaxy_udt_and_wait",
      "command": null,
      "parameters": {
        "history_id": "bbd44e69cb8906b591edb777013dc0ac",
        "representation": {
          "class": "GalaxyUserTool",
          "id": "classify_first_degree_ibd",
          "version": "0.1.0",
          "name": "Classify first-degree relatives from PLINK IBD",
          "container": "python:3.12-slim",
          "shell_command": "python - \"$(inputs.genome.path)\" <<'PY'\nimport sys\nsrc = sys.argv[1]\nrows = []\nwith open(src) as fh:\n    header = fh.readline().split()\n    idx = {name: i for i, name in enumerate(header)}\n    for line in fh:\n        fields = line.split()\n        if not fields:\n            continue\n        row = {\n            \"iid1\": fields[idx[\"IID1\"]],\n            \"iid2\": fields[idx[\"IID2\"]],\n            \"z0\": float(fields[idx[\"Z0\"]]),\n            \"z1\": float(fields[idx[\"Z1\"]]),\n            \"z2\": float(fields[idx[\"Z2\"]]),\n            \"pi\": float(fields[idx[\"PI_HAT\"]]),\n            \"ibs0\": int(fields[idx[\"IBS0\"]]),\n            \"ibs1\": int(fields[idx[\"IBS1\"]]),\n            \"ibs2\": int(fields[idx[\"IBS2\"]])\n        }\n        rows.append(row)\nrows.sort(key=lambda r: (-r[\"pi\"], r[\"iid1\"], r[\"iid2\"]))\nselected = [r for r in rows if r[\"pi\"] >= 0.375]\nnear = [r for r in rows if r[\"pi\"] >= 0.300]\npeople = sorted({r[\"iid1\"] for r in selected} | {r[\"iid2\"] for r in selected})\nwith open(\"selected_pairs.tsv\", \"w\") as out:\n    out.write(\"IID1\\tIID2\\tZ0\\tZ1\\tZ2\\tPI_HAT\\tIBS0\\tIBS1\\tIBS2\\n\")\n    for r in selected:\n        out.write(f'{r[\"iid1\"]}\\t{r[\"iid2\"]}\\t{r[\"z0\"]:.4f}\\t{r[\"z1\"]:.4f}\\t{r[\"z2\"]:.4f}\\t{r[\"pi\"]:.4f}\\t{r[\"ibs0\"]}\\t{r[\"ibs1\"]}\\t{r[\"ibs2\"]}\\n')\nwith open(\"near_boundary.tsv\", \"w\") as out:\n    out.write(\"IID1\\tIID2\\tZ0\\tZ1\\tZ2\\tPI_HAT\\n\")\n    for r in near:\n        out.write(f'{r[\"iid1\"]}\\t{r[\"iid2\"]}\\t{r[\"z0\"]:.4f}\\t{r[\"z1\"]:.4f}\\t{r[\"z2\"]:.4f}\\t{r[\"pi\"]:.4f}\\n')\nwith open(\"individuals.txt\", \"w\") as out:\n    out.write(\",\".join(people) if people else \"None\")\n    out.write(\"\\n\")\nbelow = [r for r in rows if r[\"pi\"] < 0.375]\nwith open(\"diagnostics.txt\", \"w\") as out:\n    out.write(f\"total_pairs={len(rows)}\\n\")\n    out.write(f\"selected_pairs={len(selected)}\\n\")\n    out.write(f\"selected_individuals={len(people)}\\n\")\n    out.write(f\"min_selected_pi_hat={min((r['pi'] for r in selected), default=float('nan')):.4f}\\n\")\n    out.write(f\"max_below_threshold_pi_hat={max((r['pi'] for r in below), default=float('nan')):.4f}\\n\")\n    out.write(f\"near_boundary_pairs_pi_hat_ge_0.300={len(near)}\\n\")\n    out.write(f\"threshold=0.375\\n\")\nPY",
          "inputs": [
            {
              "name": "genome",
              "type": "data",
              "format": "tabular"
            }
          ],
          "outputs": [
            {
              "name": "selected_pairs",
              "type": "data",
              "format": "tabular",
              "from_work_dir": "selected_pairs.tsv"
            },
            {
              "name": "near_boundary",
              "type": "data",
              "format": "tabular",
              "from_work_dir": "near_boundary.tsv"
            },
            {
              "name": "individuals",
              "type": "data",
              "format": "txt",
              "from_work_dir": "individuals.txt"
            },
            {
              "name": "diagnostics",
              "type": "data",
              "format": "txt",
              "from_work_dir": "diagnostics.txt"
            }
          ]
        },
        "tool_inputs": {
