      "tool": "shell",
      "command": "/bin/bash -lc \"cat > compare.py <<'PY'\nimport numpy as np,gzip,json\nfrom scipy.stats import spearmanr\nchroms=['chr'+str(i) for i in range(1,23)]\ndata=[np.load(f'bins_{i}.npz') for i in range(1,11)]\nsizes={c:max(len(d[c]) for d in data) for c in chroms}\narrays=[{c:np.pad(d[c],(0,sizes[c]-len(d[c]))) for c in chroms} for d in data]\nx=np.array([np.concatenate([d[c] for c in chroms]) for d in arrays])\nnp.set_printoptions(precision=3,suppress=True,linewidth=200)\nprint('PEARSON log1p bin counts\\\\n',np.corrcoef(np.log1p(x)))\nprint('SPEARMAN\\\\n',spearmanr(x,axis=1).statistic)\nprint('concentration')\nfor i,v in enumerate(x):\n s=np.sort(v);n=len(s)\n print(i+1,'top 1% fraction',s[-n//100:].sum()/s.sum(),'nonzero',np.mean(v>0),'quantiles',np.quantile(v,[.5,.9,.99,.999]),'max',v.max())\ntss={c:set() for c in chroms}; bodies={c:np.zeros(sizes[c],dtype=bool) for c in chroms};exons={c:np.zeros(sizes[c],dtype=bool) for c in chroms}\nwith gzip.open('refGene.txt.gz','rt') as f:\n for l in f:\n  a=l.split();c=a[2]\n  if c not in tss:continue\n  st,en=int(a[4]),int(a[5]);t=st if a[3]=='+' else en\n  tss[c].add((t//1000,1 if a[3]=='+' else -1))\n  bodies[c][st//1000:en//1000+1]=True\n  for st,en in zip(a[9].strip(',').split(','),a[10].strip(',').split(',')):exons[c][int(st)//1000:int(en)//1000+1]=True\nprint('TSS mean signal at offsets -10kb to 10kb')\nfor i,d in enumerate(arrays):\n profile=np.zeros(21);n=0\n for c in chroms:\n  for p,st in tss[c]:\n   idx=p+st*np.arange(-10,11)\n   if idx.min()<0 or idx.max()>=sizes[c]:continue\n   profile+=d[c][idx];n+=1\n print(i+1,profile/n,'gene_enrich',np.mean(np.concatenate([d[c][bodies[c]] for c in chroms]))/x[i].mean(),'exon_enrich',np.mean(np.concatenate([d[c][exons[c]] for c in chroms]))/x[i].mean())\nPY\"",
