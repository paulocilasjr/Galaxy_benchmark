      "command": "/bin/bash -lc \"cat > fine_profiles.py <<'PY'\nimport numpy as np,gzip,json\nfrom scipy.fft import rfft,irfft,next_fast_len\nfrom concurrent.futures import ProcessPoolExecutor\n\ndef run(i):\n plus=[];minus=[]\n with gzip.open(f'odd.one.out.q1/{i}.tagAlign.gz','rt') as h:\n  for l in h:\n   a=l.split()\n   if a[0]\"'!='\"'chr1':break\n   (plus if a[5]=='+' else minus).append(int(a[1]) if a[5]=='+' else int(a[2])-1)\n plus=np.sort(plus);minus=np.sort(minus)\n # Cross-correlation of 5' ends in 2 Mb chunks from 2-42 Mb; positive lag means minus downstream of plus\n n=2000000;fft_n=next_fast_len(2*n-1);power=None\n for start in range(2000000,42000000,n):\n  p=plus[(plus>=start)&(plus<start+n)]-start;m=minus[(minus>=start)&(minus<start+n)]-start\n  vp=np.bincount(p,minlength=n).astype(np.float32);vm=np.bincount(m,minlength=n).astype(np.float32)\n  vp-=vp.mean();vm-=vm.mean()\n  q=np.conj(rfft(vp,fft_n))*rfft(vm,fft_n)\n  if power is None:power=q\n  else:power+=q\n cc=irfft(power,fft_n);corr=np.concatenate([cc[-1000:],cc[:1001]])\n tss=set()\n with gzip.open('refGene.txt.gz','rt') as h:\n  for l in h:\n   a=l.split()\n   if a[2]=='chr1':tss.add((int(a[4]) if a[3]=='+' else int(a[5]),a[3]))\n prof=np.zeros((2,1000))\n for t,st in tss:\n  for j,vec in enumerate([plus,minus]):\n   vals=vec[np.searchsorted(vec,t-5000):np.searchsorted(vec,t+5000)]-t\n   if st=='-':vals=-vals-1\n   idx=(vals+5000)//10\n   prof[j if st=='+' else 1-j]+=np.bincount(idx,minlength=1000)\n np.savez_compressed(f'fine_{i}.npz',corr=corr,profile=prof/len(tss))\n pos=corr[1000:];smooth=np.convolve(pos,np.ones(11)/11,'same')\n print(i,'corr peaks',sorted([(int(k),float(pos[k])) for k in np.argsort(pos[1:501])[-10:]+1]),'smoothpeak',np.argmax(smooth[10:501])+10,flush=True)\nif __name__=='__main__':\n with ProcessPoolExecutor(max_workers=2) as ex:list(ex.map(run,range(1,11)))\nPY\nOPENBLAS_NUM_THREADS=1 python3 fine_profiles.py > fine_results.txt\"",
