

import scanpy as sc
import pandas as pd
import numpy as np
    
    

adata = sc.read_h5ad('anndata.h5ad')
    
    

with open('/jetstream2/scratch/main/jobs/79315511/inputs/dataset_4f910c67-d2a1-4aba-9756-75464500be62.dat', 'r') as filter_f:
    filters = [str(x.strip()) for x in filter_f.readlines()]
filtered = filters
print(filtered)

adata = adata[:,filtered]


adata.write_h5ad('anndata.h5ad', compression='gzip')
with open('anndata_info.txt','w', encoding='utf-8') as ainfo:
    print(adata, file=ainfo)
    
    

        
