import sys

import h5py
import numpy as np
import pandas as pd
from scipy import sparse
from scipy.optimize import linear_sum_assignment
from scipy.stats import rankdata


def read_categorical(node):
    if isinstance(node, h5py.Dataset):
        values = node[()]
        return values.astype(str)
    categories = node["categories"][()].astype(str)
    codes = node["codes"][()]
    return categories[codes]


def read_csc_matrix(group):
    shape = tuple(int(v) for v in group.attrs["shape"])
    return sparse.csc_matrix(
        (group["data"][()], group["indices"][()], group["indptr"][()]), shape=shape
    ).tocsr()


def load_h5ad(path):
    with h5py.File(path, "r") as f:
        x = read_csc_matrix(f["X"])
        guide = read_categorical(f["obs"]["guide"]).astype(str)
        target = (
            read_categorical(f["obs"]["target_gene"]).astype(str)
            if "target_gene" in f["obs"]
            else np.full(guide.shape, "", dtype=str)
        )
        genes = read_categorical(f["var"]["_index"]).astype(str)
    return x, guide, target, genes


def align_common(ref_x, ref_genes, query_x, query_genes):
    common, ref_idx, query_idx = np.intersect1d(ref_genes, query_genes, return_indices=True)
    if common.size < 1000:
        raise RuntimeError(f"Too few common genes: {common.size}")
    return ref_x[:, ref_idx], query_x[:, query_idx], ref_genes[ref_idx], query_genes[query_idx]


def log_normalized_csr(x):
    totals = np.asarray(x.sum(axis=1)).ravel().astype(float)
    totals[totals <= 0] = 1.0
    scale = 1e4 / totals
    counts = np.diff(x.indptr)
    x = x.copy()
    x.data = x.data.astype(float) * np.repeat(scale, counts)
    x.data = np.log1p(x.data)
    x.eliminate_zeros()
    return x.tocsr()


def group_mean_vectors(x, labels, groups):
    out = np.zeros((len(groups), x.shape[1]), dtype=float)
    for i, group in enumerate(groups):
        idx = np.flatnonzero(labels == group)
        if idx.size:
            out[i] = np.asarray(x[idx, :].mean(axis=0)).ravel()
    return out


def nt_mean_vector(x, labels):
    mask = np.array([s.startswith("NT-") for s in labels])
    return np.asarray(x[mask, :].mean(axis=0)).ravel()


def safe_pearson(a, b):
    a = a - a.mean(axis=1, keepdims=True)
    b = b - b.mean(axis=1, keepdims=True)
    denom = np.sqrt((a * a).sum(axis=1, keepdims=True)) @ np.sqrt(
        (b * b).sum(axis=1, keepdims=True)
    ).T
    with np.errstate(invalid="ignore", divide="ignore"):
        corr = (a @ b.T) / denom
    return np.nan_to_num(corr, nan=0.0, posinf=0.0, neginf=0.0)


def spearman_matrix(a, b):
    return safe_pearson(
        np.vstack([rankdata(row) for row in a]),
        np.vstack([rankdata(row) for row in b]),
    )


def top_variable_genes(concat, n=5000):
    var = np.var(concat, axis=0)
    return np.argsort(var)[::-1][: min(n, int((var > 0).sum()))]


def hungarian_assignment(corr):
    row, col = linear_sum_assignment(-corr)
    return row, col


def top_sets_from_sig(sig, n=200):
    return [set(np.argsort(np.abs(row))[::-1][:n]) for row in sig]


def jaccard_matrix(query_sets, ref_sets):
    out = np.zeros((len(query_sets), len(ref_sets)), dtype=float)
    for i, q in enumerate(query_sets):
        for j, r in enumerate(ref_sets):
            inter = len(q & r)
            union = len(q | r)
            out[i, j] = inter / union if union else 0.0
    return out


def assignments_table(corr, query_names, ref_names, metric):
    row, col = hungarian_assignment(corr)
    return pd.DataFrame(
        {
            "metric": metric,
            "query_guide": query_names[row],
            "assigned_target": ref_names[col],
            "score": corr[row, col],
        }
    )


def target_candidates(corr, query_names, ref_names, targets, metric):
    rows = []
    for target in targets:
        j = int(np.flatnonzero(ref_names == target)[0])
        order = np.argsort(corr[:, j])[::-1]
        for rank in range(min(3, len(order))):
            i = order[rank]
            rows.append(
                {
                    "target_gene": target,
                    "metric": metric,
                    "rank": rank + 1,
                    "query_guide": query_names[i],
                    "score": corr[i, j],
                }
            )
    return pd.DataFrame(rows)


def main(ref_path, query_path, out_prefix):
    ref_x, ref_guide, ref_target, ref_genes = load_h5ad(ref_path)
    query_x, query_guide, _, query_genes = load_h5ad(query_path)
    ref_x, query_x, ref_genes, query_genes = align_common(
        ref_x, ref_genes, query_x, query_genes
    )
    ref_x = log_normalized_csr(ref_x)
    query_x = log_normalized_csr(query_x)

    ref_groups = np.unique(ref_guide)
    query_groups = np.unique(query_guide)
    ref_pert_groups = np.array([g for g in ref_groups if not g.startswith("NT-")])
    query_pert_groups = np.array([g for g in query_groups if not g.startswith("NT-")])

    ref_means = group_mean_vectors(ref_x, ref_guide, ref_groups)
    query_means = group_mean_vectors(query_x, query_guide, query_groups)
    ref_nt = nt_mean_vector(ref_x, ref_guide)
    query_nt = nt_mean_vector(query_x, query_guide)

    ref_row = {g: i for i, g in enumerate(ref_groups)}
    query_row = {g: i for i, g in enumerate(query_groups)}
    ref_sig = ref_means[[ref_row[g] for g in ref_pert_groups]] - ref_nt[None, :]
    query_sig = query_means[[query_row[g] for g in query_pert_groups]] - query_nt[None, :]
    ref_target_names = np.array([ref_target[ref_guide == g][0] for g in ref_pert_groups])
    query_names = query_pert_groups

    var_genes = top_variable_genes(np.vstack([ref_sig, query_sig]), n=5000)
    metrics = {
        "pearson_all": safe_pearson(query_sig, ref_sig),
        "pearson_var": safe_pearson(query_sig[:, var_genes], ref_sig[:, var_genes]),
        "spearman_var": spearman_matrix(query_sig[:, var_genes], ref_sig[:, var_genes]),
        "jaccard_top200": jaccard_matrix(
            top_sets_from_sig(query_sig, 200), top_sets_from_sig(ref_sig, 200)
        ),
    }

    assignment_frames = [
        assignments_table(corr, query_names, ref_target_names, name)
        for name, corr in metrics.items()
    ]
    pd.concat(assignment_frames, ignore_index=True).to_csv(
        f"{out_prefix}.assignments.tsv", sep="\t", index=False
    )

    interest = ["PABPC1", "NUDT21", "LEO1"]
    candidate_frames = [
        target_candidates(corr, query_names, ref_target_names, interest, name)
        for name, corr in metrics.items()
    ]
    pd.concat(candidate_frames, ignore_index=True).to_csv(
        f"{out_prefix}.interest.tsv", sep="\t", index=False
    )

    with open(f"{out_prefix}.readme.txt", "w") as out:
        out.write(
            "Global guide-target assignment and target candidates.\n"
            "Metrics: pearson all genes, pearson top 5000 variable genes, "
            "spearman top 5000 variable genes, jaccard overlap of top 200 "
            "absolute signatures.\n"
            f"query perturbation guides={len(query_pert_groups)}, "
            f"reference targets={len(ref_pert_groups)}\n"
        )


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2], sys.argv[3])
