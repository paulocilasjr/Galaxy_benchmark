      "tool": "shell",
      "command": "/bin/bash -c \"python3 - <<'PY'\nimport gzip, pysam, sys, re, json\nref='chr9.fa'\nfasta=pysam.FastaFile(ref)\nchrom='chr9'\nseq=fasta.fetch(chrom)\n\n# parse refGene transcripts for chr9\ntxs=[]\nwith gzip.open('refGene.txt.gz','rt') as f:\n    for line in f:\n        parts=line.rstrip('\\\\n').split('\\\\t')\n        if len(parts)<16: continue\n        chrom_=parts[2]\n        if chrom_\"'!=chrom: continue\n        name=parts[1]\n        strand=parts[3]\n        txStart=int(parts[4]); txEnd=int(parts[5])\n        cdsStart=int(parts[6]); cdsEnd=int(parts[7])\n        exonCount=int(parts[8])\n        starts=[int(x) for x in parts[9].rstrip('\"',').split(',') if x]\n        ends=[int(x) for x in parts[10].rstrip(',').split(',') if x]\n        gene=parts[12]\n        if cdsStart>=cdsEnd or exonCount==0: continue\n        exons=list(zip(starts,ends))\n        # collect coding positions in transcript order [1-based genomic coordinates]\n        pos=[]\n        if strand=='+':\n            # exons are ascending; for each exon intersect with cds\n            for st,en in exons:\n                lo=max(st+1,cdsStart+1); hi=min(en,cdsEnd)\n                for p in range(lo,hi+1):\n                    pos.append(p)\n        elif strand=='-':\n            # transcription starts high, exons ascending; reverse exons, each positions descending\n            for st,en in reversed(exons):\n                lo=max(st+1,cdsStart+1); hi=min(en,cdsEnd)\n                for p in range(hi,lo-1,-1):\n                    pos.append(p)\n        else: continue\n        if len(pos)%3\"'!=0:\n            # warn but still use full length maybe truncated\n            pass\n        txs.append({'\"'name':name,'gene':gene,'strand':strand,'cdsStart':cdsStart,'cdsEnd':cdsEnd,'pos':pos})\n\nprint('transcripts chr9 with CDS', len(txs))\n\n# parse variants.vcf; filter homozygous SNVs\nvariants=[]\nwith open('variants.vcf') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.rstrip('\\\\n').split('\\\\t')\n        ch,pos,id,ref,alt,qual,filter,info,format,sample=p[:10]\n        if ch\"'!=chrom or len(ref)!=1 or len(alt)!=1: continue\n        if sample.split('\"':')[0].split('/')[0] \"'!= sample.split('\"':')[0].split('/')[1] or sample.split(':')[0].split('/')[0]\"'!='\"'1':\n            # only 1/1 or 1|1\n            gt=sample.split(':')[0]\n            if not (gt=='1/1' or gt=='1|1'): continue\n        dp=None\n        for field in info.split(';'):\n            if field.startswith('DP='): dp=int(field[3:])\n            if field.startswith('DP4='):\n                d=field[4:].split(','); dp4=list(map(int,d))\n        # store DP4 as ref f,r alt f,r\n        dp4=None\n        m=re.search(r'DP4=([0-9,]+)', info)\n        if m: dp4=list(map(int,m.group(1).split(',')))\n        mq0f=None; m=re.search(r'MQ0F=([\"'^;]+)'\"', info); \n        if m: mq0f=float(m.group(1))\n        mq=None; m=re.search(r'(?<\"'![A-Z])MQ=([0-9.]+)'\"', info)\n        if m: mq=float(m.group(1))\n        variants.append({'ch':ch,'pos':int(pos),'ref':ref,'alt':alt,'qual':float(qual),'dp':dp,'dp4':dp4,'mq0f':mq0f,'mq':mq,'info':info,'sample':sample})\n\nprint('homo SNVs', len(variants))\n\ncomp=str.maketrans('ACGTN','TGCAN')\ndef revcomp(s): return s.translate(comp)[::-1]\n\n# annotate stop_gain per transcript\nresults=[]\nfor v in variants:\n    pos=v['pos']\n    for t in txs:\n        if pos in t['pos']:\n            idx=t['pos'].index(pos)  # first occurrence only\n            codon_start=idx//3*3\n            if codon_start+3>len(t['pos']): continue\n            gp=t['pos'][codon_start:codon_start+3]\n            # reference coding bases\n            if t['strand']=='+':\n                bases=[seq[p-1] for p in gp]\n                alt_base=v['alt']\n            else:\n                bases=[revcomp(seq[p-1]) for p in gp]\n                alt_base=revcomp(v['alt'])\n            ref_codon=''.join(bases).upper()\n            if not set(ref_codon)<=set('ACGTN'): continue\n            mut=list(ref_codon); mut[idx%3]=alt_base\n            mut_codon=''.join(mut)\n            aa_ref=codon_to_aa.get(ref_codon,'X')\n            aa_alt=codon_to_aa.get(mut_codon,'X')\n            if aa_alt=='*' and aa_ref\"'!='\"'*':\n                # compute hgvsc maybe simple\n                c_pos=idx+1\n                hgvs=f\\\"c.{c_pos}{ref_codon.upper()}>? not\\\"\n                results.append({'pos':pos,'ref':v['ref'],'alt':v['alt'],'gene':t['gene'],'transcript':t['name'],'strand':t['strand'],'ref_codon':ref_codon,'mut_codon':mut_codon,'aa_ref':aa_ref,'aa_alt':aa_alt,'dp':v['dp'],'dp4':v['dp4'],'qual':v['qual'],'mq':v['mq'],'mq0f':v['mq0f'],'sample':v['sample']})\n\n# codon table\n# define above missing? reorder\nPY\"",
