import concurrent.futures
import json
import re
import time
import urllib.parse
import urllib.request


UA = {"User-Agent": "codex-provenance-overlap/1.0"}


def fetch_text(url, timeout=120):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as handle:
        return handle.read().decode("utf-8")


def fetch_json(url, accept_json=False, timeout=120, retries=4):
    headers = dict(UA)
    if accept_json:
        headers["Accept"] = "application/json"
    last_error = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=timeout) as handle:
                return json.load(handle)
        except Exception as exc:
            last_error = exc
            time.sleep(1.5 * (attempt + 1))
    raise last_error


def encode_search_all():
    params = urllib.parse.urlencode(
        {
            "type": "Experiment",
            "limit": "all",
            "field": ["accession", "dbxrefs"],
            "format": "json",
        },
        doseq=True,
    )
    data = fetch_json(
        "https://www.encodeproject.org/search/?" + params,
        accept_json=True,
        timeout=300,
    )
    mapping = {}
    for rec in data.get("@graph", []):
        acc = rec.get("accession")
        if not acc:
            continue
        gsms = set()
        for dbxref in rec.get("dbxrefs") or []:
            gsms.update(re.findall(r"GSM\d+", dbxref))
        mapping[acc] = gsms
    return mapping, len(data.get("@graph", []))


def cistrome_search_gsm(gsm, timeout=60, retries=3):
    params = urllib.parse.urlencode(
        {
            "species": "Homo sapiens",
            "cellinfos": "all",
            "factors": "all",
            "keyword": gsm,
            "page": 1,
        }
    )
    data = fetch_json("https://dc2.cistrome.org/api/main_filter_ng?" + params, timeout=timeout, retries=retries)
    hits = []
    for d in data.get("datasets", []):
        if str(d.get("species__name")) == "Homo sapiens":
            hits.append(
                {
                    "id": str(d["id"]),
                    "gsm": gsm,
                    "factor": d.get("factor__name") or "",
                    "source": d.get("biological_source") or "",
                }
            )
    return gsm, hits


sei_url = "https://raw.githubusercontent.com/FunctionLab/sei-framework/main/model/target.names"
borzoi_url = "https://raw.githubusercontent.com/calico/borzoi/main/examples/targets_human.txt"

sei_text = fetch_text(sei_url)
borzoi_text = fetch_text(borzoi_url)

sei_ids = set()
sei_lines_by_id = {}
for line in sei_text.splitlines():
    m = re.search(r"\bID:(\d+)\b", line)
    if m:
        cid = m.group(1)
        sei_ids.add(cid)
        sei_lines_by_id.setdefault(cid, line)

direct_borzoi_gsms = set(re.findall(r"GSM\d+", borzoi_text))
borzoi_encode_experiments = set(re.findall(r"/(ENCSR[A-Z0-9]+)/", borzoi_text))

print("downloading ENCODE search metadata", flush=True)
encode_map, encode_total_records = encode_search_all()
missing = sorted(borzoi_encode_experiments - set(encode_map))
encode_gsms = set()
for acc in borzoi_encode_experiments:
    encode_gsms.update(encode_map.get(acc, set()))

borzoi_gsms = direct_borzoi_gsms | encode_gsms

cistrome_hits = []
cistrome_failures = []
print(f"querying Cistrome for {len(borzoi_gsms)} Borzoi GEO sample accessions", flush=True)
with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
    futures = [ex.submit(cistrome_search_gsm, gsm) for gsm in sorted(borzoi_gsms)]
    for i, fut in enumerate(concurrent.futures.as_completed(futures), 1):
        try:
            _gsm, hits = fut.result()
            cistrome_hits.extend(hits)
        except Exception as exc:
            cistrome_failures.append(repr(exc))
        if i % 100 == 0:
            print(f"completed Cistrome lookups: {i}/{len(futures)}", flush=True)

overlap_hits = [h for h in cistrome_hits if h["id"] in sei_ids]
overlap_ids = sorted(set(h["id"] for h in overlap_hits), key=int)
overlap_count = len(overlap_ids)
rounded = int(round(overlap_count / 100.0) * 100)

with open("provenance_summary.tsv", "w") as out:
    out.write("metric\tvalue\n")
    out.write(f"sei_lines\t{len(sei_text.splitlines())}\n")
    out.write(f"sei_tracks_with_cistrome_id\t{len(sei_ids)}\n")
    out.write(f"borzoi_human_lines_including_header\t{len(borzoi_text.splitlines())}\n")
    out.write(f"borzoi_direct_gsm_count\t{len(direct_borzoi_gsms)}\n")
    out.write(f"borzoi_encode_experiment_count\t{len(borzoi_encode_experiments)}\n")
    out.write(f"encode_search_records\t{encode_total_records}\n")
    out.write(f"borzoi_encode_experiments_requiring_individual_lookup\t{len(missing)}\n")
    out.write(f"borzoi_encode_gsm_count\t{len(encode_gsms)}\n")
    out.write(f"borzoi_total_gsm_provenance_count\t{len(borzoi_gsms)}\n")
    out.write(f"cistrome_hits_for_borzoi_gsms\t{len(cistrome_hits)}\n")
    out.write(f"cistrome_lookup_failures\t{len(cistrome_failures)}\n")
    out.write(f"overlap_sei_cistrome_ids_unrounded\t{overlap_count}\n")
    out.write(f"rounded_nearest_100\t{rounded}\n")

with open("overlap_hits.tsv", "w") as out:
    out.write("cistrome_id\tgsm\tfactor\tbiological_source\tsei_track\n")
    for cid in overlap_ids:
        cid_hits = [h for h in overlap_hits if h["id"] == cid]
        h = sorted(cid_hits, key=lambda x: x["gsm"])[0]
        out.write(
            f"{cid}\t{h['gsm']}\t{h['factor']}\t{h['source']}\t"
            f"{sei_lines_by_id.get(cid, '')}\n"
        )

with open("answer.txt", "w") as out:
    out.write(str(rounded) + "\n")

print(f"rounded={rounded} unrounded={overlap_count}")
