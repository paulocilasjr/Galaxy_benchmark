{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport gzip, re\n\ndef natural_key(chrom):\n    m=re.match(r'chr(\\\\d+|X|Y|M)',chrom)\n    if m:\n        s=m.group(1)\n        if s.isdigit(): return (0,int(s))\n        return (1,s)\n    return (2,chrom)\n\n# read blacklist\nblack=[]\nwith gzip.open('ENCFF356LFX.bed.gz','rt') as f:\n    for line in f:\n        p=line.rstrip('\\\\n').split('\\\\t')\n        chrom=p[0]; s=int(p[1]); e=int(p[2])\n        black.append((natural_key(chrom),chrom,s,e))\nblack_by={}\nfor _,chrom,s,e in black:\n    black_by.setdefault(chrom,[]).append((s,e))\nfor chrom in black_by:\n    black_by[chrom].sort()\n\nintervals={}\ncount=0\nwith gzip.open('ENCFF333TAT.bed.gz','rt') as f:\n    for line in f:\n        p=line.rstrip('\\\\n').split('\\\\t')\n        chrom=p[0]; start=int(p[1]); summit=int(p[9])\n        center=start+summit\n        s=center-250; e=center+250\n        if s<0: s=0\n        intervals.setdefault(chrom,[]).append((s,e))\n        count+=1\n\ndef merge(lst):\n    if not lst: return []\n    lst.sort()\n    out=[]\n    cs,ce=lst[0]\n    for s,e in lst[1:]:\n        if s<=ce:\n            if e>ce: ce=e\n        else:\n            out.append((cs,ce)); cs,ce=s,e\n    out.append((cs,ce))\n    return out\n\ndef remove_overlap(lst, blacklst):\n    out=[]\n    j=0\n    for s,e in lst:\n        # advance black that ends <= s? overlap if black_s < e and black_e > s\n        while j<len(blacklst) and blacklst[j][1] <= s:\n            j+=1\n        k=j\n        overlaps=False\n        while k<len(blacklst) and blacklst[k][0] < e:\n            bs,be=blacklst[k]\n            if bs < e and be > s:\n                overlaps=True; break\n            k+=1\n        if not overlaps:\n            out.append((s,e))\n    return out\n\ntotal=0\nmerged_count=0\nfor chrom in sorted(intervals, key=natural_key):\n    m=merge(intervals[chrom])\n    merged_count+=len(m)\n    bl=black_by.get(chrom,[])\n    fin=remove_overlap(m,bl)\n    total+=sum(e-s for s,e in fin)\nprint('peaks',count,'merged',merged_count,'final_count?',sum(len(remove_overlap(merge(intervals[c]),black_by.get(c,[])) for c in intervals)))\nprint('total',total)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
