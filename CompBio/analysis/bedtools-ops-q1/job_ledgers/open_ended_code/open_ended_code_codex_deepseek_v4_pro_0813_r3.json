      "tool": "shell",
      "command": "/bin/bash -c \"python3 - <<'PY'\nimport gzip, sys\n\ndef read_bed(path):\n    intervals=[]\n    with gzip.open(path,'rt') as f:\n        for line in f:\n            if not line.strip(): continue\n            c=line.rstrip('\\\\n').split('\\\\t')\n            intervals.append((c[0], int(c[1]), int(c[2])))\n    return intervals\n\npeaks=[]\nwith gzip.open('ENCFF333TAT.bed.gz','rt') as f:\n    for line in f:\n        c=line.rstrip('\\\\n').split('\\\\t')\n        s=int(c[1])+int(c[9])\n        peaks.append((c[0],s-250,s+250))\n\npeaks.sort(key=lambda x:(x[0],x[1],x[2]))\n# merge (chrom change)\nmerged=[]\nfor c,s,e in peaks:\n    if not merged or merged[-1][0]\"'!=c or s>merged[-1][2]:\n        merged.append([c,s,e])\n    else:\n        if e>merged[-1][2]:\n            merged[-1][2]=e\nprint('\"'merged count',len(merged),'sum',sum(e-s for c,s,e in merged))\nblack=read_bed('ENCFF356LFX.bed.gz')\nblack.sort(key=lambda x:(x[0],x[1],x[2]))\n# mark intervals overlap any blacklist using sweep\nbi=0; rem=[]\nfor c,s,e in merged:\n    # advance blacklist not relevant, then scan current for any overlap in same chrom. Simpler linear enough? black small.\n    overlap=False\n    for bc,bs,be in black:\n        if bc\"'!=c: continue\n        if s < be and e > bs:\n            overlap=True; break\n    if not overlap:\n        rem.append((c,s,e))\nprint('\"'remain count',len(rem),'sum',sum(e-s for c,s,e in rem))\n# subtract variant total\n# for each merged interval, break around blacklist intervals on same chrom\nres=[]; total=0\nfor c,s,e in merged:\n    cuts=[]; cur=s\n    for bc,bs,be in black:\n        if bc\"'!=c: continue\n        if be<=cur or bs>=e: continue\n        if bs>cur: cuts.append((cur,bs)); cur=bs\n        if be>cur: cur=be\n        if cur>=e: break\n    if cur<e: cuts.append((cur,e))\n    for a,b in cuts:\n        total += b-a\nprint('\"'subtract sum', total)\nPY\"",
