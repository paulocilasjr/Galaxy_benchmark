      "tool": "shell",
      "command": "/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, gzip, re\nfrom scipy.optimize import linear_sum_assignment\nrna=pd.read_csv('multiome.match.atac.rna.q1.rna.tsv.gz',sep='\\\\t',index_col=0)\natac=pd.read_csv('multiome.match.atac.rna.q1.atac.tsv.gz',sep='\\\\t',index_col=0)\nprint(rna.shape,atac.shape)\n# parse gene features\ncoords={}\npat=re.compile(r'gene_name \\\"([\"'^\"]+)\"'\"')\nwith gzip.open('gencode.annotation.gtf.gz','rt') as f:\n for line in f:\n  if line.startswith('#'): continue\n  z=line.rstrip().split('\\\\t')\n  if len(z)<9 or z[2]\"'!='\"'gene': continue\n  m=pat.search(z[8])\n  if m: coords[m.group(1)]=(z[0],int(z[3])-1,int(z[4]),z[6])\n# atac mapping\namap={k:i for i,k in enumerate(atac.index)}\ncommon=[g for g in rna.index if g in coords]\nprint('coords common',len(common))\nA=atac.to_numpy(float); R=rna.loc[common].to_numpy(float)\n\ndef calc(radius,emin,topvar=None, standard=True):\n rows=[]; vals=[]; gs=[]\n for ri,g in enumerate(common):\n  chrom,s,e,strand=coords[g]; t=s if strand=='+' else e-1\n  inds=[]\n  b=(t//10000)*10000\n  for off in range(-radius,radius+1):\n   st=b+off*10000\n   j=amap.get(f'{chrom}_{st}_{st+10000}')\n   if j is not None: inds.append(j)\n  if inds:\n   rows.append(ri); vals.append(A[inds].mean(0)); gs.append(g)\n rr=R[rows]; aa=np.array(vals)\n keep=(rr.max(1)>=emin)&(aa.max(1)>0)&(np.std(rr,1)>0)&(np.std(aa,1)>0)\n rr=np.log1p(rr[keep]); aa=np.log1p(aa[keep]); gg=np.array(gs)[keep]\n # rank/filter variable by RNA specificity\n if topvar:\n  score=np.std(rr,1)*np.std(aa,1)\n  ix=np.argsort(score)[-topvar:]\n  rr,aa,gg=rr[ix],aa[ix],gg[ix]\n rr-=rr.mean(1,keepdims=True); aa-=aa.mean(1,keepdims=True)\n if standard:\n  rr/=rr.std(1,keepdims=True)+1e-9; aa/=aa.std(1,keepdims=True)+1e-9\n sim=rr.T@aa/len(rr)\n x,y=linear_sum_assignment(-sim)\n perm=y[np.argsort(x)]\n return len(rr),perm,sim\nfor rad in [0,1,2,5]:\n for emin in [0.1,1,5,10]:\n  for tv in [None,1000,3000,8000]:\n   n,p,s=calc(rad,emin,tv)\n   margin=np.mean([s[i,p[i]]-np.partition(s[i],-2)[-2] for i in range(8)])\n   print(rad,emin,tv,n,''.join(map(str,p)), 'diag',np.round(s[np.arange(8),p],3),'margin',round(margin,4))\nPY\"",
