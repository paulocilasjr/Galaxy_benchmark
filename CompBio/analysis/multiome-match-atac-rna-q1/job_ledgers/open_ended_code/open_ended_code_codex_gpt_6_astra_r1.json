      "command": "/bin/bash -lc \"cat > match.py <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import linear_sum_assignment\nr=pd.read_csv('multiome.match.atac.rna.q1.rna.tsv.gz',sep='\\\\t',index_col=0)\na=pd.read_csv('multiome.match.atac.rna.q1.atac.tsv.gz',sep='\\\\t',index_col=0)\ng=pd.read_csv('hg38.ncbiRefSeq.txt.gz',sep='\\\\t',header=None)\ng=g[g[12].isin(r.index)&g[2].isin(['chr'+str(i) for i in range(1,23)]+['chrX','chrY'])].copy()\ng['tss']=np.where(g[3]=='+',g[4],g[5]-1)\ng['bin']=g.tss//10000*10000\ng=g.drop_duplicates([12,2,'bin'])\ndef std(x):\n x=x-x.mean(axis=1,keepdims=True)\n return x/np.maximum(np.linalg.norm(x,axis=1,keepdims=True),1e-12)\nfor radius in [0,10000,20000]:\n vals=[]\n names=[]\n for name,grp in g.groupby(12):\n  keys=set()\n  for _,row in grp.iterrows():\n   for shift in range(-radius,radius+1,10000):\n    start=row['bin']+shift\n    key=f'{row[2]}_{start}_{start+10000}'\n    if key in a.index: keys.add(key)\n  if keys:\n   vals.append(a.loc[list(keys)].mean(axis=0).values)\n   names.append(name)\n A=np.array(vals)\n R=r.loc[names].values\n for minexpr in [1,10,50]:\n  mask=(R.max(axis=1)>=minexpr)&(A.max(axis=1)>0)\n  X=std(np.log1p(R[mask])); Y=std(np.log1p(A[mask]))\n  scores=X.T@Y / len(X)\n  ri,ai=linear_sum_assignment(-scores)\n  print('radius',radius,'minexpr',minexpr,'n',len(X),flush=True)\n  print(np.round(scores,3),flush=True)\n  print('MATCH',ai,'score',scores[ri,ai].sum(),flush=True)\nPY\"",
