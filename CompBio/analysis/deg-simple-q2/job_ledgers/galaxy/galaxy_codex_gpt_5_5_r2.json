            "file_type": "txt",
            "content": "import gzip, sys, collections\n\ndef open_maybe_gz(path):\n    return gzip.open(path, 'rt') if path.endswith('.gz') else open(path)\n\ndef analyze(path, label):\n    n=0; lengths=collections.Counter(); bases=collections.Counter(); first=[]; ids=[]\n    with open_maybe_gz(path) as fh:\n        while True:\n            h=fh.readline().rstrip('\\n')\n            if not h: break\n            s=fh.readline().rstrip('\\n')\n            p=fh.readline().rstrip('\\n')\n            q=fh.readline().rstrip('\\n')\n            n += 1\n            lengths[len(s)] += 1\n            bases.update(s)\n            if len(first) < 20:\n                first.append((label,n,h,s,q[:20]))\n            if len(ids) < 20:\n                ids.append(h)\n    return n,lengths,bases,first,ids\n\nwith open(sys.argv[3], 'w') as out, open(sys.argv[4], 'w') as reads:\n    out.write('sample\\tmetric\\tvalue\\n')\n    reads.write('sample\\tread_index\\theader\\tsequence\\tqual_prefix\\n')\n    for path,label in [(sys.argv[1],'sampleA'),(sys.argv[2],'sampleB')]:\n        n,lengths,bases,first,ids=analyze(path,label)\n        out.write(f'{label}\\tread_count\\t{n}\\n')\n        out.write(f'{label}\\tlengths\\t' + ','.join(f'{k}:{v}' for k,v in sorted(lengths.items())) + '\\n')\n        out.write(f'{label}\\tbases\\t' + ','.join(f'{k}:{v}' for k,v in sorted(bases.items())) + '\\n')\n        out.write(f'{label}\\tfirst_header\\t{ids[0] if ids else \"\"}\\n')\n        for rec in first:\n            reads.write('\\t'.join(map(str, rec)).replace('\\n',' ') + '\\n')\n"
          }
