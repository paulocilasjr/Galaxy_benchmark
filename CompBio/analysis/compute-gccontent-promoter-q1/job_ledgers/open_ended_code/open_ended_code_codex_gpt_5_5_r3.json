      "tool": "shell",
      "command": "/bin/bash -lc \"python3 - <<'PY'\nimport gzip, re\ntranscript_id='ENST00000269305'\nwith gzip.open('Homo_sapiens.GRCh38.115.gtf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'):\n            continue\n        fields=line.rstrip('\\\\n').split('\\\\t')\n        if len(fields) < 9 or fields[2] \"'!= '\"'transcript':\n            continue\n        attrs=dict(re.findall(r'(\\\\S+) \\\"([\"'^\"]+)\";'\"', fields[8]))\n        if attrs.get('transcript_id') == transcript_id:\n            chrom,start,end,strand=fields[0], int(fields[3]), int(fields[4]), fields[6]\n            tss = start if strand == '+' else end\n            up, down = 500, 100\n            if strand == '+':\n                p_start, p_end = tss - up, tss + down - 1\n            else:\n                p_start, p_end = tss - down + 1, tss + up\n            seq=[]\n            with gzip.open('Homo_sapiens.GRCh38.dna.chromosome.17.fa.gz','rt') as fa:\n                for l in fa:\n                    if not l.startswith('>'):\n                        seq.append(l.strip().upper())\n            s=''.join(seq)\n            prom=s[p_start-1:p_end]\n            gc=sum(1 for b in prom if b in 'GC')\n            print(chrom, start, end, strand, tss, p_start, p_end, len(prom), gc, f'{gc/len(prom):.2f}')\n            print(f'{chrom};{p_start};{p_end};{strand};{len(prom)};{gc};{gc/len(prom):.2f}')\n            break\nPY\"",
