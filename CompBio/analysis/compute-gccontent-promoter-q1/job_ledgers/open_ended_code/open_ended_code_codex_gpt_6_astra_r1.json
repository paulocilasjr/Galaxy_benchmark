      "tool": "shell",
      "command": "/bin/bash -lc \"cat > calculate_promoter.py <<'PY'\nimport gzip\nimport json\nfrom pathlib import Path\n\ntranscript_id = 'ENST00000269305'\nwith gzip.open('Homo_sapiens.GRCh38.115.chr.gtf.gz', 'rt') as handle:\n    matches = [line.rstrip('\\\\n') for line in handle if '\\\\ttranscript\\\\t' in line and f'transcript_id \\\"{transcript_id}\\\";' in line]\nassert len(matches) == 1, matches\nPath('release115_transcript.gtf').write_text(matches[0] + '\\\\n')\nfields = matches[0].split('\\\\t')\nchromosome, transcript_start, transcript_end, strand = fields[0], int(fields[3]), int(fields[4]), fields[6]\nupstream, downstream = 500, 100\nif strand == '+':\n    tss = transcript_start\n    start, end = tss - upstream, tss + downstream - 1\nelse:\n    assert strand == '-'\n    tss = transcript_end\n    start, end = tss - downstream + 1, tss + upstream\nwith gzip.open('Homo_sapiens.GRCh38.dna.chromosome.17.fa.gz', 'rt') as handle:\n    header = next(handle).strip()\n    assert header.startswith('>17 ') and 'GRCh38' in header\n    chromosome_sequence = ''.join(line.strip() for line in handle).upper()\nassert 1 <= start <= end <= len(chromosome_sequence)\nsequence = chromosome_sequence[start-1:end]\nif strand == '-':\n    sequence = sequence.translate(str.maketrans('ACGT', 'TGCA'))[::-1]\nassert len(sequence) == upstream + downstream\nassert set(sequence) <= set('ACGT')\nPath('release115_promoter.fa').write_text(f'>{chromosome}:{start}-{end}:{strand}\\\\n{sequence}\\\\n')\ngc_count = sequence.count('G') + sequence.count('C')\nanswer = f'{chromosome};{start};{end};{strand};{len(sequence)};{gc_count};{gc_count / len(sequence):.2f}'\nPath('answer.txt').write_text(answer + '\\\\n')\nprint(matches[0])\nprint(header)\nprint(answer)\nprint('Matches REST sequence:', sequence == Path('promoter_sequence.txt').read_text().strip().upper())\nPY\"",
