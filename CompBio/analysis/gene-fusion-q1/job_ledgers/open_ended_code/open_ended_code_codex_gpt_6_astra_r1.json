      "command": "/bin/bash -lc \"cat > analyze_pairs.py <<'PY'\nimport pysam,collections,json\n\ndef read(path):\n out={}; split=collections.Counter(); cnt=collections.Counter()\n with pysam.AlignmentFile(path) as f:\n  for a in f:\n   if a.is_unmapped or a.is_secondary: continue\n   gene=a.reference_name.split('|')[5]\n   cnt[gene]+=1\n   if a.is_supplementary:continue\n   out[a.query_name]=(gene,a.mapping_quality,a.reference_name,a.reference_start,a.reference_end,a.is_reverse,a.cigarstring,a.get_tag('AS'),a.get_tag('NM'))\n return out,cnt\nr1,c1=read('r1.sam');r2,c2=read('r2.sam')\npairs=collections.Counter();examples=collections.defaultdict(list)\nfor name,a in r1.items():\n if name not in r2:continue\n b=r2[name]\n if a[0]\"'!=b[0]:\n  key=tuple(sorted([a[0],b[0]]));pairs[key]+=1\n  if len(examples[key])<8:examples[key].append((name,a,b))\nprint('\"'Mapped',len(r1),len(r2))\nprint('Top expression',c1.most_common(25))\nfor pair,n in pairs.most_common(40):\n print('\\\\nPAIR',pair,n)\n for x in examples[pair][:3]:print(x)\nwith open('pairs.json','w') as h:json.dump({'pairs':[(k,n,examples[k]) for k,n in pairs.most_common(100)]},h,indent=2)\nPY\"",
