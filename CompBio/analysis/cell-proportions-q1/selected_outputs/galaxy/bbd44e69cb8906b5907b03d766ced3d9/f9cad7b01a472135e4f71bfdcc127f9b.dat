

import scanpy as sc
import pandas as pd
import numpy as np
    
    

adata = sc.read_h5ad('anndata.h5ad')
    
    

sc.pp.pca(
    data=adata,
    n_comps=min(50, adata.n_vars-1),
    
    
    
    dtype='float32',
    chunked=False,
    zero_center=True,
    svd_solver='arpack',
    random_state=0,
    copy=False)



adata.write_h5ad('anndata.h5ad', compression='gzip')
with open('anndata_info.txt','w', encoding='utf-8') as ainfo:
    print(adata, file=ainfo)
    
    
        
        