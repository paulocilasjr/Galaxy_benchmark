

import scanpy as sc
import pandas as pd
import numpy as np
    
    

adata = sc.read_h5ad('anndata.h5ad')
    
    

sc.pp.neighbors(
    adata=adata,
    n_neighbors=30,
    n_pcs=30,
    knn=True,
    method='umap',
    metric='euclidean',
    random_state=0,
    copy=False)



adata.write_h5ad('anndata.h5ad', compression='gzip')
with open('anndata_info.txt','w', encoding='utf-8') as ainfo:
    print(adata, file=ainfo)
    
    
        
        anndata.h5ad
anndata_info.txt
