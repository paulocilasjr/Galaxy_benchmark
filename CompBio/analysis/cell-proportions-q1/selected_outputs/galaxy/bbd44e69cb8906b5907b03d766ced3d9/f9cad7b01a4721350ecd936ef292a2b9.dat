

import scanpy as sc
import pandas as pd
import numpy as np
    
    

adata = sc.read_h5ad('anndata.h5ad')
    
    

sc.tl.leiden(
    adata=adata,
    resolution=0.5,
    random_state=0,
    key_added='leiden_r05',
    directed=None,
    use_weights=True,
    n_iterations=-1,
    
    
    
    flavor='leidenalg',
    copy=False)



adata.write_h5ad('anndata.h5ad', compression='gzip')
with open('anndata_info.txt','w', encoding='utf-8') as ainfo:
    print(adata, file=ainfo)
    
    
        
        