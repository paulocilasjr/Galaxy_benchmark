#!/usr/bin/env python3
import hashlib
import re
import subprocess
import sys


VCF_URL = (
    "https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/data_collections/"
    "1000G_2504_high_coverage/working/20201028_3202_raw_GT_with_annot/"
    "20201028_CCDG_14151_B01_GRM_WGS_2020-08-05_chr1.recalibrated_variants.vcf.gz"
)

BASES = {"A", "C", "G", "T"}
OBSERVED_RE = re.compile(r"^([ACGT])/([ACGT])$")


def read_peaks(path):
    peaks = []
    total = 0
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue
            total += 1
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 10:
                continue
            chrom = parts[0]
            try:
                start = int(parts[1])
                end = int(parts[2])
                qvalue = float(parts[9])
            except ValueError:
                continue
            peaks.append((qvalue, chrom, start, end))
    # Genome-wide strongest 1000 peaks by qValue. qValue is -log10(q-value),
    # so larger values are stronger peaks.
    peaks.sort(key=lambda x: (-x[0], x[1], x[2], x[3]))
    top1000 = peaks[:1000]
    chr1_peaks = [p for p in top1000 if p[1] == "chr1"]
    chr1_peaks.sort(key=lambda p: (p[2], p[3]))

    # Deduplicate overlapping/identical intervals. Duplicate rows in the peak
    # file should not cause duplicate VCF records in the final table.
    # Merge overlapping intervals. Keeping overlaps would make tabix emit the
    # same VCF record more than once. Since each interval is a 0-based
    # half-open BED interval, two intervals overlap exactly when
    # next.start < current.end.
    intervals = []
    for _, chrom, start, end in chr1_peaks:
        if intervals and intervals[-1][0] == chrom and start < intervals[-1][2]:
            if end > intervals[-1][2]:
                intervals[-1] = (chrom, intervals[-1][1], end)
            continue
        intervals.append((chrom, start, end))

    return total, len(top1000), len(chr1_peaks), intervals


def read_target_positions(snps_path, intervals):
    total_snps = 0
    valid_observed = 0
    positions = []
    peak_idx = 0
    n_intervals = len(intervals)

    with open(snps_path, "r", encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue
            total_snps += 1
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 10:
                continue
            chrom = parts[1]
            if chrom != "chr1":
                continue
            try:
                chrom_start = int(parts[2])
            except ValueError:
                continue
            observed = parts[9]
            m = OBSERVED_RE.match(observed)
            if not m:
                continue
            if m.group(1) == m.group(2):
                continue
            valid_observed += 1

            pos = chrom_start + 1
            # Move interval pointer forward. Intervals are sorted by 0-based
            # [start, end), and SNP POS is 1-based, so overlap means
            # start < POS <= end.
            while peak_idx < n_intervals and pos > intervals[peak_idx][2]:
                peak_idx += 1
            if peak_idx >= n_intervals:
                # SNP file is coordinate-sorted, but continue to count lines.
                continue
            start = intervals[peak_idx][1]
            end = intervals[peak_idx][2]
            if start < pos <= end:
                positions.append(pos)

    positions = sorted(set(positions))
    return total_snps, valid_observed, positions


def run_tabix(intervals):
    regions = [f"{chrom}:{start + 1}-{end}" for chrom, start, end in intervals]
    cmd = ["tabix", "-h", VCF_URL] + regions
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    return proc, regions


def main():
    if len(sys.argv) != 6:
        print(
            "usage: build_1kg_genotypes.py SNPS PEADS "
            "FINAL_TSV DIAGNOSTICS_TSV SUMMARY_TXT",
            file=sys.stderr,
        )
        return 2

    snps_path, peaks_path, final_path, diag_path, summary_path = sys.argv[1:6]

    total_peaks, top1000_count, chr1_peak_rows, intervals = read_peaks(peaks_path)
    total_snps, valid_observed, target_positions = read_target_positions(
        snps_path, intervals
    )
    target_set = set(target_positions)

    proc, regions = run_tabix(intervals)

    header_samples = []
    sorted_samples = []
    sample_to_output_idx = {}
    vcf_records_read = 0
    vcf_target_records = 0
    seen_target_positions = set()
    filtered_ref_alt = 0
    rows = []

    assert proc.stdout is not None
    for raw_line in proc.stdout:
        line = raw_line.rstrip("\n")
        if line.startswith("#CHROM"):
            fields = line.split("\t")
            # VCF columns before samples: CHROM POS ID REF ALT QUAL FILTER INFO FORMAT
            header_samples = fields[9:]
            sorted_samples = sorted(header_samples)
            sample_to_output_idx = {
                sample: i for i, sample in enumerate(sorted_samples)
            }
            continue
        if line.startswith("#") or not line:
            continue

        vcf_records_read += 1
        parts = line.split("\t")
        if len(parts) < 10:
            continue
        chrom = parts[0]
        if chrom != "chr1":
            continue
        try:
            pos = int(parts[1])
        except ValueError:
            continue
        if pos not in target_set:
            continue

        vcf_target_records += 1
        seen_target_positions.add(pos)
        ref = parts[3]
        alt = parts[4]
        if (
            len(ref) != 1
            or ref not in BASES
            or len(alt) != 1
            or alt not in BASES
        ):
            filtered_ref_alt += 1
            continue

        format_parts = parts[8].split(":")
        gt_index = 0
        if "GT" in format_parts:
            gt_index = format_parts.index("GT")

        n_samples = len(header_samples)
        output_gts = ["./."] * n_samples
        for orig_idx, sample in enumerate(header_samples):
            col_idx = 9 + orig_idx
            sample_value = parts[col_idx] if col_idx < len(parts) else "."
            tokens = sample_value.split(":")
            gt = tokens[gt_index] if gt_index < len(tokens) else "."
            gt = gt.replace("|", "/")
            if gt not in ("0/0", "0/1", "1/1"):
                gt = "./."
            output_gts[sample_to_output_idx[sample]] = gt

        rows.append((pos, ref, alt, output_gts))

    stderr = proc.stderr.read() if proc.stderr is not None else ""
    returncode = proc.wait()
    if returncode != 0:
        with open(diag_path, "w", encoding="utf-8") as f:
            f.write("tabix_failed\treturncode\tstderr\n")
            f.write(f"1\t{returncode}\t{stderr}\n")
        with open(summary_path, "w", encoding="utf-8") as f:
            f.write("0;00000000000000000000000000000000\n")
        return 3

    if not header_samples:
        with open(diag_path, "w", encoding="utf-8") as f:
            f.write("tabix_failed\treturncode\tstderr\n")
            f.write(f"1\t{returncode}\tno CHROM header found\n")
        with open(summary_path, "w", encoding="utf-8") as f:
            f.write("0;00000000000000000000000000000000\n")
        return 4

    # Safety net: deduplicate by POS in case tabix produced an overlapping
    # region for any reason.
    rows_by_pos = {}
    for row in rows:
        rows_by_pos.setdefault(row[0], row)
    rows = list(rows_by_pos.values())
    rows.sort(key=lambda row: (row[0], row[1], row[2]))

    with open(final_path, "w", encoding="utf-8") as f:
        header = ["CHROM", "POS", "REF", "ALT"] + sorted_samples
        f.write("\t".join(header) + "\n")
        for pos, ref, alt, gts in rows:
            f.write("chr1\t" + str(pos) + "\t" + ref + "\t" + alt + "\t")
            f.write("\t".join(gts) + "\n")

    line_count = 0
    md5 = hashlib.md5()
    with open(final_path, "rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            md5.update(block)
    with open(final_path, "r", encoding="utf-8") as f:
        for _ in f:
            line_count += 1
    digest = md5.hexdigest()

    missing_positions = sorted(target_set - seen_target_positions)
    with open(diag_path, "w", encoding="utf-8") as f:
        f.write("metric\tvalue\n")
        f.write(f"peaks_total\t{total_peaks}\n")
        f.write(f"peaks_top1000_genomewide\t{top1000_count}\n")
        f.write(f"peaks_chr1_top1000\t{chr1_peak_rows}\n")
        f.write(f"peak_intervals_after_dedup\t{len(intervals)}\n")
        f.write(f"snp151_rows\t{total_snps}\n")
        f.write(f"snp151_valid_observed_biallelic\t{valid_observed}\n")
        f.write(f"target_positions\t{len(target_positions)}\n")
        f.write(f"vcf_records_read\t{vcf_records_read}\n")
        f.write(f"vcf_records_at_target_positions\t{vcf_target_records}\n")
        f.write(f"final_rows\t{len(rows)}\n")
        f.write(f"line_count_with_header\t{line_count}\n")
        f.write(f"filtered_ref_alt\t{filtered_ref_alt}\n")
        f.write(f"missing_target_positions\t{len(missing_positions)}\n")
        f.write(f"samples\t{len(sorted_samples)}\n")
        f.write("missing_position_examples\t" + ",".join(map(str, missing_positions[:20])) + "\n")
        f.write("first_sample_ids\t" + ",".join(sorted_samples[:10]) + "\n")
        f.write("last_sample_ids\t" + ",".join(sorted_samples[-10:]) + "\n")
        f.write("tabix_regions\t" + str(len(regions)) + "\n")

    with open(summary_path, "w", encoding="utf-8") as f:
        f.write(f"{line_count};{digest}\n")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
