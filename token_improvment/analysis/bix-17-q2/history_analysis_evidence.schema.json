{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/galaxy-benchmark/history-analysis-evidence-2.0.schema.json",
  "type": "object",
  "required": ["schema_version", "audit", "task", "experimental_design", "sources", "runs", "comparisons", "manuscript_findings", "validation"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "audit": {"type": "object", "required": ["audit_id", "timestamp_utc", "scope", "limitations"], "properties": {"audit_id": {"type": "string", "minLength": 1}, "timestamp_utc": {"type": "string", "format": "date-time"}, "scope": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "task": {"type": "object", "required": ["benchmark", "task_id", "prompt", "evaluation_definition"], "properties": {"benchmark": {"enum": ["bixbench", "compbio", "iwc"]}, "task_id": {"type": "string", "minLength": 1}, "prompt": {"type": ["string", "null"]}, "evaluation_definition": {"type": "string"}}},
    "experimental_design": {"type": "object", "required": ["conditions", "coverage_status", "matching_rule"], "properties": {"conditions": {"type": "array", "uniqueItems": true, "items": {"enum": ["galaxy", "open_ended_code"]}}, "coverage_status": {"enum": ["unknown_protocol_inventory", "protocol_defined"]}, "matching_rule": {"type": "string"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "location", "access_status"], "properties": {"source_id": {"type": "string"}, "location": {"type": "string"}, "access_status": {"enum": ["retrieved", "partial", "history_metadata_only", "unavailable", "not_collected"]}, "redactions": {"type": "array"}}}},
    "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}},
    "comparisons": {"type": "array", "items": {"type": "object", "required": ["comparison_id", "status", "included_run_ids", "excluded_run_ids", "estimate", "uncertainty"], "properties": {"comparison_id": {"type": "string"}, "status": {"enum": ["descriptive_only", "not_assessable"]}, "included_run_ids": {"type": "array", "items": {"type": "string"}}, "excluded_run_ids": {"type": "array", "items": {"type": "string"}}, "estimate": {"type": ["number", "null"]}}}},
    "manuscript_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "validation": {"type": "object", "required": ["schema", "reference_integrity", "unresolved_issues"], "properties": {"schema": {"type": "object", "required": ["path", "dialect", "sha256", "validation_status"]}, "reference_integrity": {"type": "string"}, "unresolved_issues": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_id", "benchmark", "task_id", "prompt_variant", "iteration_setting", "condition", "model", "replicate_id", "seed", "status", "source_ids", "timestamps", "budgets", "input_provenance", "environment", "evidence_completeness", "limitations", "events", "artifacts", "solution_route", "outcome", "recovery_episodes", "usage", "derived_metrics"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "benchmark": {"enum": ["bixbench", "compbio", "iwc"]},
        "task_id": {"type": "string", "minLength": 1}, "prompt_variant": {"type": ["string", "null"]},
        "iteration_setting": {"type": ["string", "integer", "null"]},
        "condition": {"enum": ["galaxy", "open_ended_code"]},
        "model": {"type": "object", "required": ["supplied_label", "verified_runtime_id", "harness", "reasoning_setting", "verification_status"], "properties": {"supplied_label": {"type": "string"}, "verified_runtime_id": {"type": ["string", "null"]}, "harness": {"type": ["string", "null"]}, "reasoning_setting": {"type": ["string", "null"]}, "verification_status": {"enum": ["runtime_verified", "user_supplied_only"]}}},
        "replicate_id": {"type": "integer", "minimum": 1}, "seed": {"type": ["integer", "string", "null"]},
        "status": {"enum": ["trace_observed", "history_observed", "source_incomplete"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "timestamps": {"type": "object"}, "budgets": {"type": "object"}, "input_provenance": {"type": "object"}, "environment": {"type": "object"}, "evidence_completeness": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "event_type", "execution_location", "status", "evidence_refs"], "properties": {"event_id": {"type": "string"}, "event_type": {"enum": ["input_acquisition", "input_preparation", "discovery", "analysis", "validation", "answer_generation", "orchestration"]}, "execution_location": {"enum": ["galaxy_job", "agent_runtime", "external_service", "mixed", "unknown"]}, "status": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}},
        "artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "role", "status"], "properties": {"artifact_id": {"type": "string"}, "role": {"enum": ["shared_input", "analytical_output", "final_answer", "error_output", "auditor_summary", "agent_trace", "evaluator_output", "usage_record", "recovered_code"]}, "status": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]}, "observed_size": {"type": ["integer", "null"], "minimum": 0}}}},
        "solution_route": {"type": "object"}, "outcome": {"type": "object"}, "recovery_episodes": {"type": "array"}, "usage": {"type": "object"}, "derived_metrics": {"type": "object"}
      }
    },
    "finding": {
      "type": "object", "required": ["finding_id", "section", "question", "claim", "scope", "unit_of_analysis", "eligible_run_ids", "evidence_refs", "contradictory_evidence_refs", "numerator", "denominator", "estimate", "uncertainty", "missingness", "limitations", "interpretation_status"],
      "properties": {"finding_id": {"type": "string"}, "section": {"enum": ["accuracy", "execution", "variability", "cost_readability"]}, "claim": {"type": ["string", "null"]}, "scope": {"enum": ["case_study", "benchmark", "cross_benchmark"]}, "unit_of_analysis": {"enum": ["task", "run", "event", "artifact"]}, "eligible_run_ids": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "contradictory_evidence_refs": {"type": "array", "items": {"type": "string"}}, "numerator": {"type": ["integer", "null"], "minimum": 0}, "denominator": {"type": ["integer", "null"], "minimum": 0}, "estimate": {"type": ["number", "null"]}, "missingness": {"type": ["string", "null"]}, "limitations": {"type": "array", "items": {"type": "string"}}, "interpretation_status": {"enum": ["observed", "inferred", "hypothesis", "not_assessable"]}}
    }
  }
}
