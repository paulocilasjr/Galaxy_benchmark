      "body": "{\n  \"@context\": \"http://reg.genome.network/schema/allele.jsonld\",\n  \"@id\": \"http://reg.genome.network/allele/CA548798891\",\n  \"communityStandardTitle\": [\n    \"NM_003106.4(SOX2):c.-18C>T\"\n  ],\n  \"externalRecords\": {\n    \"MyVariantInfo_hg19\": [\n      {\n        \"@id\": \"http://myvariant.info/v1/variant/chr3:g.181430131C>T?assembly=hg19\",\n        \"id\": \"chr3:g.181430131C>T\"\n      }\n    ],\n    \"MyVariantInfo_hg38\": [\n      {\n        \"@id\": \"http://myvariant.info/v1/variant/chr3:g.181712343C>T?assembly=hg38\",\n        \"id\": \"chr3:g.181712343C>T\"\n      }\n    ],\n    \"dbSNP\": [\n      {\n        \"@id\": \"http://www.ncbi.nlm.nih.gov/snp/1444210633\",\n        \"rs\": 1444210633\n      }\n    ],\n    \"gnomAD_2\": [\n      {\n        \"@id\": \"http://gnomad.broadinstitute.org/variant/3-181430131-C-T?dataset=gnomad_r2_1\",\n        \"id\": \"3-181430131-C-T\",\n        \"variant\": \"3:181430131 C / T\"\n      }\n    ],\n    \"gnomAD_3\": [\n      {\n        \"@id\": \"http://gnomad.broadinstitute.org/variant/3-181712343-C-T?dataset=gnomad_r3\",\n        \"id\": \"3-181712343-C-T\",\n        \"variant\": \"3:181712343 C / T\"\n      }\n    ],\n    \"gnomAD_4\": [\n      {\n        \"@id\": \"http://gnomad.broadinstitute.org/variant/3-181712343-C-T?dataset=gnomad_r4\",\n        \"id\": \"3-181712343-C-T\",\n        \"variant\": \"3:181712343 C / T\"\n      }\n    ]\n  },\n  \"genomicAlleles\": [\n    {\n      \"chromosome\": \"3\",\n      \"coordinates\": [\n        {\n          \"allele\": \"T\",\n          \"end\": 181712343,\n          \"referenceAllele\": \"C\",\n          \"start\": 181712342\n        }\n      ],\n      \"hgvs\": [\n        \"NC_000003.12:g.181712343C>T\",\n        \"CM000665.2:g.181712343C>T\"\n      ],\n      \"referenceGenome\": \"GRCh38\",\n      \"referenceSequence\": \"http://reg.genome.network/refseq/RS000051\"\n    },\n    {\n      \"chromosome\": \"3\",\n      \"coordinates\": [\