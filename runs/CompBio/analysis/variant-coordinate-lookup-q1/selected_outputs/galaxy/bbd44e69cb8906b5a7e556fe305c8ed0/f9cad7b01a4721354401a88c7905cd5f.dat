      "body": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n                        \n<ClinVarResult-Set><VariationArchive VariationID=\"587372\" VariationName=\"NM_004311.4(ARL3):c.445C&gt;T (p.Arg149Cys)\" VariationType=\"single nucleotide variant\" Accession=\"VCV000587372\" Version=\"6\" RecordType=\"classified\" NumberOfSubmissions=\"2\" NumberOfSubmitters=\"2\" DateLastUpdated=\"2026-02-15\" DateCreated=\"2018-11-05\" MostRecentSubmission=\"2026-02-15\">\n  <RecordStatus>current</RecordStatus>\n  <Species>Homo sapiens</Species>\n  <ClassifiedRecord>\n    <SimpleAllele AlleleID=\"578329\" VariationID=\"587372\">\n      <GeneList>\n        <Gene Symbol=\"ARL3\" FullName=\"ARF like GTPase 3\" GeneID=\"403\" HGNC_ID=\"HGNC:694\" Source=\"submitted\" RelationshipType=\"within single gene\">\n          <Location>\n            <CytogeneticLocation>10q24.32</CytogeneticLocation>\n            <SequenceLocation Assembly=\"GRCh38\" AssemblyAccessionVersion=\"GCF_000001405.38\" AssemblyStatus=\"current\" Chr=\"10\" Accession=\"NC_000010.11\" start=\"102673731\" stop=\"102714397\" display_start=\"102673731\" display_stop=\"102714397\" Strand=\"-\"/>\n            <SequenceLocation Assembly=\"GRCh37\" AssemblyAccessionVersion=\"GCF_000001405.25\" AssemblyStatus=\"previous\" Chr=\"10\" Accession=\"NC_000010.10\" start=\"104433483\" stop=\"104474189\" display_start=\"104433483\" display_stop=\"104474189\" Strand=\"-\"/>\n          </Location>\n          <OMIM>604695</OMIM>\n        </Gene>\n      </GeneList>\n      <Name>NM_004311.4(ARL3):c.445C&gt;T (p.Arg149Cys)</Name>\n      <CanonicalSPDI>NC_000010.11:102685871:G:A</CanonicalSPDI>\n      <VariantType>single nucleotide variant</VariantType>\n      <Location>\n        <CytogeneticLocation>10q24.32</CytogeneticLocation>\n        <SequenceLocation Assembly=\"GRCh38\" AssemblyAccessionVersion=\"GCF_000001405.38\" forDisplay=\"true\" AssemblyStatus=\"current\" Chr=\"10\" Accession=\"NC_000010.11\" start=\"102685872\" stop=\"102685872\" display_start=\"102685872\" display_stop=\"102685872\" variantLength=\"1\" positionVCF=\"102685872\" referenceAlleleVCF=\"G\" alternateAlleleVCF=\"A\"/>\n        <SequenceLocation Assembly=\"GRCh37\" AssemblyAccessionVersion=\"GCF_000001405.25\" AssemblyStatus=\"previous\" Chr=\"10\" Accession=\"NC_000010.10\" start=\"104445629\" stop=\"104445629\" display_start=\"104445629\" display_stop=\"104445629\" variantLength=\"1\" positionVCF=\"104445629\" referenceAlleleVCF=\"G\" alternateAlleleVCF=\"A\"/>\n      </Location>\n      <ProteinChange>R149C</ProteinChange>\n      <HGVSlist>\n        <HGVS Assembly=\"GRCh37\" Type=\"genomic, top-level\">\n          <NucleotideExpression sequenceAccessionVersion=\"NC_000010.10\" sequenceAccession=\"NC_000010\" sequenceVersion=\"10\" change=\"g.104445629G&gt;A\" Assembly=\"GRCh37\">\n            <Expression>NC_000010.10:g.104445629G&gt;A</Expression>\n          </NucleotideExpression>\n        </HGVS>\n        <HGVS Assembly=\"GRCh38\" Type=\"genomic, top-level\">\n          <NucleotideExpression sequenceAccessionVersion=\"NC_000010.11\" sequenceAccession=\"NC_000010\" sequenceVersion=\"11\" change=\"g.102685872G&gt;A\" Assembly=\"GRCh38\">\n            <Expression>NC_000010.11:g.102685872G&gt;A</Expression>\n          </NucleotideExpression>\n        </HGVS>\n        <HGVS Type=\"coding\">\n          <NucleotideExpression sequenceAccessionVersion=\"NM_004311.4\" sequenceAccession=\"NM_004311\" sequenceVersion=\"4\" change=\"c.445C&gt;T\" MANESelect=\"true\">\n            <Expression>NM_004311.4:c.445C&gt;T</Expression>\n          </NucleotideExpression>\n          <ProteinExpression sequenceAccessionVersion=\"NP_004302.1\" sequenceAccession=\"NP_004302\" sequenceVersion=\"1\" change=\"p.Arg149Cys\" singleLetterProteinChange=\"R149C\">\n            <Expression>NP_004302.1:p.Arg149Cys</Expression>\n          </ProteinExpression>\n          <MolecularConsequence ID=\"SO:0001583\" Type=\"missense variant\" DB=\"SO\"/>\n        </HGVS>\n      </HGVSlist>\n      <XRefList>\n        <XRef ID=\"CA5668429\" DB=\"ClinGen\"/>\n        <XRef Type=\"Allelic variant\" ID=\"604695.0001\" DB=\"OMIM\"/>\n        <XRef Type=\"rs\" ID=\"776901858\" DB=\"dbSNP\"/>\n      </XRefList>\n      <AlleleFrequencyList>\n        <AlleleFrequency Value=\"0.00001\" Source=\"The Genome Aggregation Database (gnomAD)\"/>\n        <AlleleFrequency Value=\"0.00001\" Source=\"The Genome Aggregation Database (gnomAD), exomes\"/>\n        <AlleleFrequency Value=\"0.00002\" Source=\"Trans-Omics for Precision Medicine (TOPMed)\"/>\n        <AlleleFrequency Value=\"0.00003\" Source=\"Exome Aggregation Consortium (ExAC)\"/>\n        <AlleleFrequency Value=\"0.00003\" Source=\"The Genome Aggregation Database (gnomAD), exomes\"/>\n      </AlleleFrequencyList>\n    </SimpleAllele>\n    <RCVList>\n      <RCVAccession Title=\"NM_004311.4(ARL3):c.445C&gt;T (p.Arg149Cys) AND Joubert syndrome 35\" Accession=\"RCV000714511\" Version=\"1\">\n        <ClassifiedConditionList TraitSetID=\"44993\">\n          <ClassifiedCondition DB=\"MedGen\" ID=\"C4748442\">Joubert syndrome 35</ClassifiedCondition>\n        </ClassifiedConditionList>\n        <RCVClassifications>\n          <GermlineClassification>\n            <ReviewStatus>no assertion criteria provided</ReviewStatus>\n            <Description DateLastEvaluated=\"2018-10-30\" SubmissionCount=\"1\">Pathogenic</Description>\n          </GermlineClassification>\n        </RCVClassifications>\n      </RCVAccession>\n      <RCVAccession Title=\"NM_004311.4(ARL3):c.445C&gt;T (p.Arg149Cys) AND not provided\" Accession=\"RCV001861999\" Version=\"6\">\n        <ClassifiedConditionList TraitSetID=\"9460\">\n          <ClassifiedCondition DB=\"MedGen\" ID=\"C3661900\">not provided</ClassifiedCondition>\n        </ClassifiedConditionList>\n        <RCVClassifications>\n          <GermlineClassification>\n            <ReviewStatus>criteria provided, single submitter</ReviewStatus>\n            <Description DateLastEvaluated=\"2024-03-27\" SubmissionCount=\"1\">Pathogenic</Description>\n          </GermlineClassification>\n        </RCVClassifications>\n      </RCVAccession>\n    </RCVList>\n    <Classifications>\n      <GermlineClassification DateLastEvaluated=\"2024-03-27\" NumberOfSubmissions=\"2\" NumberOfSubmitters=\"2\" DateCreated=\"2018-11-05\" MostRecentSubmission=\"2026-02-15\">\n        <ReviewStatus>criteria provided, single submitter</ReviewStatus>\n        <Description>Pathogenic</Description>\n        <Explanation DataSource=\"ClinVar\" Type=\"public\">Pathogenic (1)</Explanation>\n        <Citation Type=\"general\">\n          <ID Source=\"PubMed\">30269812</ID>\n        </Citation>\n        <ConditionList>\n          <TraitSet ID=\"44993\" Type=\"Disease\" ContributesToAggregateClassification=\"false\">\n            <Trait ID=\"40744\" Type=\"Disease\">\n              <Name>\n                <ElementValue Type=\"Preferred\">Joubert syndrome 35</ElementValue>\n                <XRef ID=\"MONDO:0032570\" DB=\"MONDO\"/>\n              </Name>\n              <Symbol>\n                <ElementValue Type=\"Alternate\">JBTS35</ElementValue>\n                <XRef Type=\"MIM\" ID=\"618161\" DB=\"OMIM\"/>\n              </Symbol>\n              <AttributeSet>\n                <Attribute Type=\"GARD id\" integerValue=\"16297\"/>\n                <XRef ID=\"16297\" DB=\"Office of Rare Diseases\"/>\n              </AttributeSet>\n              <XRef ID=\"C4748442\" DB=\"MedGen\"/>\n              <XRef ID=\"MONDO:0032570\" DB=\"MONDO\"/>\n              <XRef Type=\"MIM\" ID=\"618161\" DB=\"OMIM\"/>\n            </Trait>\n          </TraitSet>\n          <TraitSet ID=\"9460\" Type=\"Disease\" ContributesToAggregateClassification=\"true\">\n            <Trait ID=\"17556\" Type=\"Disease\">\n              <Name>\n                <ElementValue Type=\"Preferred\">not provided</ElementValue>\n                <XRef ID=\"13DG0619\" DB=\"Genomic Medicine Center of Excellence, King Faisal Specialist Hospital and Research Centre\"/>\n              </Name>\n              <Name>\n                <ElementValue Type=\"Alternate\">none provided</ElementValue>\n              </Name>\n              <AttributeSet>\n                <Attribute Type=\"public definition\">The term 'not provided' is registered in MedGen to support identification of submissions to ClinVar for which no condition was named when assessing the variant. 'not provided' differs from 'not specified', which is used when a variant is asserted to be benign, likely benign, or of uncertain significance for conditions that have not been specified.</Attribute>\n              </AttributeSet>\n              <XRef ID=\"C3661900\" DB=\"MedGen\"/>\n            </Trait>\n          </TraitSet>\n        </ConditionList>\n      </GermlineClassification>\n    </Classifications>\n    <ClinicalAssertionList>\n      <ClinicalAssertion ID=\"1648071\" SubmissionDate=\"2018-10-30\" ContributesToAggregateClassification=\"false\" DateLastUpdated=\"2018-11-05\" DateCreated=\"2018-11-05\">\n        <ClinVarSubmissionID localKey=\"604695.0001_JOUBERT SYNDROME 35\" title=\"ARL3, ARG149CYS_JOUBERT SYNDROME 35\"/>\n        <ClinVarAccession Accession=\"SCV000845201\" DateUpdated=\"2018-11-05\" DateCreated=\"2018-11-05\" Type=\"SCV\" Version=\"1\" SubmitterName=\"OMIM\" OrgID=\"3\" OrganizationCategory=\"resource\"/>\n        <RecordStatus>current</RecordStatus>\n        <Classification DateLastEvaluated=\"2018-10-30\">\n          <ReviewStatus>no assertion criteria provided</ReviewStatus>\n          <GermlineClassification>Pathogenic</GermlineClassification>\n        </Classification>\n        <Assertion>variation to disease</Assertion>\n        <ObservedInList>\n          <ObservedIn>\n            <Sample>\n              <Origin>germline</Origin>\n              <Species>human</Species>\n              <AffectedStatus>not provided</AffectedStatus>\n            </Sample>\n            <Method>\n              <MethodType>literature only</MethodType>\n            </Method>\n            <ObservedData>\n              <Attribute Type=\"Description\">In a 5-year-old boy, born of consanguineous Saudi Arabian parents (family 1), with Joubert syndrome-35 (JBTS35; 618161), Alkanderi et al. (2018) identified a homozygous c.445C-T transition (c.445C-T, NM_004311.3) in the ARL3 gene, resulting in an arg149-to-cys (R149C) substitution at a highly conserved residue predicted to interact with ARL13B (608922). The mutation, which was found by a combination of homozygosity mapping and exome sequencing, segregated with the disorder in the family.</Attribute>\n              <Citation>\n                <ID Source=\"PubMed\">30269812</ID>\n              </Citation>\n              <XRef DB=\"OMIM\" ID=\"618161\" Type=\"MIM\"/>\n              <XRef DB=\"OMIM\" ID=\"608922\" Type=\"MIM\"/>\n            </ObservedData>\n          </ObservedIn>\n        </ObservedInList>\n        <SimpleAllele>\n          <GeneList>\n            <Gene Symbol=\"ARL3\"/>\n          </GeneList>\n          <Name>ARL3, ARG149CYS</Name>\n          <VariantType>Variation</VariantType>\n          <OtherNameList>\n            <Name Type=\"NonHGVS\">ARG149CYS</Name>\n          </OtherNameList>\n          <XRefList>\n            <XRef DB=\"OMIM\" ID=\"604695.0001\" Type=\"Allelic variant\"/>\n          </XRefList>\n        </SimpleAllele>\n        <TraitSet Type=\"Disease\">\n          <Trait Type=\"Disease\">\n            <Name>\n              <ElementValue Type=\"Preferred\">JOUBERT SYNDROME 35</ElementValue>\n            </Name>\n          </Trait>\n        </TraitSet>\n      </ClinicalAssertion>\n      <ClinicalAssertion ID=\"4133278\" SubmissionDate=\"2026-02-05\" ContributesToAggregateClassification=\"true\" DateLastUpdated=\"2026-02-15\" DateCreated=\"2022-03-28\">\n        <ClinVarSubmissionID localKey=\"5886458|MedGen:CN517202\" submittedAssembly=\"GRCh37\"/>\n        <ClinVarAccession Accession=\"SCV002111627\" DateUpdated=\"2026-02-15\" DateCreated=\"2022-03-28\" Type=\"SCV\" Version=\"5\" SubmitterName=\"Labcorp Genetics (formerly Invitae), Labcorp\" OrgID=\"500031\" OrganizationCategory=\"laboratory\"/>\n        <RecordStatus>current</RecordStatus>\n        <Classification DateLastEvaluated=\"2024-03-27\">\n          <ReviewStatus>criteria provided, single submitter</ReviewStatus>\n          <GermlineClassification>Pathogenic</GermlineClassification>\n          <Citation>\n            <ID Source=\"PubMed\">30269812</ID>\n          </Citation>\n          <Citation>\n            <ID Source=\"PubMed\">30269812</ID>\n          </Citation>\n          <Comment Type=\"public\">This sequence change replaces arginine, which is basic and polar, with cysteine, which is neutral and slightly polar, at codon 149 of the ARL3 protein (p.Arg149Cys). This variant is present in population databases (rs776901858, gnomAD 0.01%). This missense change has been observed in individual(s) with autosomal recessive Joubert syndrome (PMID: 30269812). It has also been observed to segregate with disease in related individuals. ClinVar contains an entry for this variant (Variation ID: 587372). An algorithm developed to predict the effect of missense changes on protein structure and function (PolyPhen-2) suggests that this variant is likely to be disruptive. This variant disrupts the p.Arg149 amino acid residue in ARL3. Other variant(s) that disrupt this residue have been determined to be pathogenic (PMID: 30269812). This suggests that this residue is clinically significant, and that variants that disrupt this residue are likely to be disease-causing. For these reasons, this variant has been classified as Pathogenic.</Comment>\n        </Classification>\n        <Assertion>variation to disease</Assertion>\n        <AttributeSet>\n          <Attribute Type=\"AssertionMethod\">Invitae Variant Classification Sherloc (09022015)</Attribute>\n          <Citation>\n            <ID Source=\"PubMed\">28492532</ID>\n          </Citation>\n        </AttributeSet>\n        <ObservedInList>\n          <ObservedIn>\n            <Sample>\n              <Origin>germline</Origin>\n              <Species TaxonomyId=\"9606\">human</Species>\n              <AffectedStatus>unknown</AffectedStatus>\n            </Sample>\n            <Method>\n              <MethodType>clinical testing</MethodType>\n            </Method>\n            <ObservedData>\n              <Attribute Type=\"Description\">not provided</Attribute>\n            </ObservedData>\n          </ObservedIn>\n        </ObservedInList>\n        <SimpleAllele>\n          <GeneList>\n            <Gene Symbol=\"ARL3\"/>\n          </GeneList>\n          <VariantType>Variation</VariantType>\n          <AttributeSet>\n            <Attribute Type=\"HGVS\">NC_000010.10:g.104445629G&gt;A</Attribute>\n          </AttributeSet>\n        </SimpleAllele>\n        <TraitSet Type=\"Disease\">\n          <Trait Type=\"Disease\">\n            <XRef DB=\"MedGen\" ID=\"CN517202\" Type=\"CUI\"/>\n          </Trait>\n        </TraitSet>\n        <SubmissionNameList>\n          <SubmissionName>SUB11173117</SubmissionName>\n          <SubmissionName>SUB12508014</SubmissionName>\n          <SubmissionName>SUB14200314</SubmissionName>\n          <SubmissionName>SUB15075422</SubmissionName>\n          <SubmissionName>SUB15990450</SubmissionName>\n        </SubmissionNameList>\n      </ClinicalAssertion>\n    </ClinicalAssertionList>\n    <TraitMappingList>\n      <TraitMapping ClinicalAssertionID=\"1648071\" TraitType=\"Disease\" MappingType=\"Name\" MappingValue=\"JOUBERT SYNDROME 35\" MappingRef=\"Preferred\">\n        <MedGen CUI=\"C4748442\" Name=\"Joubert syndrome 35\"/>\n      </TraitMapping>\n      <TraitMapping ClinicalAssertionID=\"4133278\" TraitType=\"Disease\" MappingType=\"XRef\" MappingValue=\"CN517202\" MappingRef=\"MedGen\">\n        <MedGen CUI=\"C3661900\" Name=\"not provided\"/>\n      </TraitMapping>\n    </TraitMappingList>\n  </ClassifiedRecord>\n</VariationArchive>\n</ClinVarResult-Set>",
