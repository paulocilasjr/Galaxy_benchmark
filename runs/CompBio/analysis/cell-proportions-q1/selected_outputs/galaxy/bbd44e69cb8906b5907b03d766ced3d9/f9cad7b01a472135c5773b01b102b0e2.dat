

import scanpy as sc
import pandas as pd
import numpy as np
    
    

adata = sc.read_h5ad('anndata.h5ad')
    
    


sc.pp.calculate_qc_metrics(
    adata=adata,
    expr_type='counts',
    var_type='genes',
    use_raw=False,
    log1p=True,
    inplace=True)



adata.write_h5ad('anndata.h5ad', compression='gzip')
with open('anndata_info.txt','w', encoding='utf-8') as ainfo:
    print(adata, file=ainfo)
    
    
        
        anndata.h5ad
anndata_info.txt
