      "tool": "shell",
      "command": "/bin/bash -lc \"python -u - <<'PY'\nimport gzip, numpy as np, time\nfrom sklearn.decomposition import PCA\nfrom sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score, adjusted_rand_score\nfrom sklearn.preprocessing import StandardScaler\n\n# load\nwith gzip.open('cell.proportions.q1.mtx.gz','rt') as f:\n    for line in f:\n        if not line.startswith('%'): break\n    dims=tuple(map(int,line.split()))\n    vals=np.fromiter((float(line) for line in f),dtype=np.float32)\nX=vals.reshape(dims,order='F').T # cells x genes\nlib=X.sum(1)\n# log normalize\nY=np.log1p(X/lib[:,None]*1e4).astype(np.float32)\n# gene stats and variable selection\nmu=Y.mean(0); va=Y.var(0); cv=va/(mu+1e-6)\nfor n in [50,100,200,300,500,1000]:\n idx=np.argsort(va)[-n:]\n p=PCA(n_components=30,random_state=1,svd_solver='randomized').fit_transform(Y[:,idx])\n print('\\\\nNVAR',n,'explained first',PCA(n_components=10,random_state=1,svd_solver='randomized').fit(Y[:,idx]).explained_variance_ratio_.round(4))\n for k in range(2,11):\n  lab=KMeans(n_clusters=k,n_init=10,random_state=1,algorithm='lloyd').fit_predict(p[:,:20])\n  sil=silhouette_score(p[:,:20],lab,sample_size=min(5350,3000),random_state=1)\n  sizes=np.bincount(lab)\n  print('k',k,'sil',round(sil,4),'sizes',','.join(map(str,sorted(sizes,reverse=True))))\nPY\"",
