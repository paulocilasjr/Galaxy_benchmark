      "exit_code": 0,
      "stdout_excerpt": "import gzip\nimport sys\nimport numpy as np\nfrom scipy.io import mmread\n\nsource, out = sys.argv[1:3]\nopener = gzip.open if source.endswith(\".gz\") else open\nwith opener(source, \"rb\") as handle:\n    x = mmread(handle).tocsr()\n\ndef quantiles(values):\n    qs = [0, .001, .01, .05, .1, .25, .5, .75, .9, .95, .99, .999, 1]\n    return \",\".join(f\"{q:g}:{np.quantile(values, q):.6g}\" for q in qs)\n\nwith open(out, \"w\") as fh:\n    fh.write(f\"shape\\t{x.shape[0]}\\t{x.shape[1]}\\n\")\n    fh.write(f\"nnz\\t{x.nnz}\\n\")\n    for axis, label in [(1, \"rows\"), (0, \"cols\")]:\n        totals = np.asarray(x.sum(axis=axis)).ravel()\n        detected = np.asarray((x > 0).sum(axis=axis)).ravel()\n        fh.write(f\"{label}_totals_quantiles\\t{quantiles(totals)}\\n\")\n        fh.write(f\"{label}_detected_quantiles\\t{quantiles(detected)}\\n\")\n        fh.write(f\"{label}_zero_total\\t{int(np.sum(totals == 0))}\\n\")\n        fh.write(f\"{label}_noninteger_values\\t{int(np.sum(np.abs(x.data - np.rint(x.data)) > 1e-8))}\\n\")\n",
