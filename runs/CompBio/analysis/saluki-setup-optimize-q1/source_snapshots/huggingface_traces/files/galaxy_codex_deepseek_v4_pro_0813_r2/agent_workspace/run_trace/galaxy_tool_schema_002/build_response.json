        {
          "area": false,
          "argument": "--min-count",
          "datalist": [],
          "default_value": "2",
          "help": "(kmin+1)-mer with multiplicity lower than d (default 2, specified by --min-count option) will be discarded. You should be cautious to set d less than 2, which will lead to a much larger and noisy graph. We recommend using the default value 2 for metagenomics assembly. If you want to use MEGAHIT to do generic assemblies, please change this value according to the sequencing depth. (recommend --min-count 3 for >40x).",
          "help_format": "html",
          "hidden": false,
          "is_dynamic": false,
          "label": "minimum multiplicity for filtering (k_min+1)-mers",
          "max": null,
          "min": null,
          "model_class": "IntegerToolParameter",
          "name": "min_count",
          "optional": false,
          "refresh_on_change": false,
          "text_value": "2",
          "type": "integer",
          "value": "2"
        },
        {
          "cases": [
            {
              "inputs": [
                {
                  "area": false,
                  "argument": "--k-list",
                  "datalist": [],
                  "default_value": "21,29,39,59,79,99,119,141",
                  "help": "all must be odd, in the range 15-255, and with increments <= 28",
                  "help_format": "html",
                  "hidden": false,
                  "is_dynamic": false,
                  "label": "Comma-separated list of kmer size",
                  "model_class": "TextToolParameter",
                  "name": "k_list",
