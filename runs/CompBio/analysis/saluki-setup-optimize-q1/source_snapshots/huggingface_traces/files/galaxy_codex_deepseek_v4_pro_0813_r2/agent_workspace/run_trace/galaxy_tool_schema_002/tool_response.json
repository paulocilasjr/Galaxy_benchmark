      "inputs": [
        {
          "area": false,
          "argument": "--min-count",
          "datalist": [],
          "help": "(kmin+1)-mer with multiplicity lower than d (default 2, specified by --min-count option) will be discarded. You should be cautious to set d less than 2, which will lead to a much larger and noisy graph. We recommend using the default value 2 for metagenomics assembly. If you want to use MEGAHIT to do generic assemblies, please change this value according to the sequencing depth. (recommend --min-count 3 for >40x).",
          "help_format": "html",
          "hidden": false,
          "is_dynamic": false,
          "label": "minimum multiplicity for filtering (k_min+1)-mers",
          "max": null,
          "min": null,
          "model_class": "IntegerToolParameter",
          "name": "min_count",
          "optional": false,
          "refresh_on_change": false,
          "type": "integer",
          "value": "2"
        },
        {
          "cases": [
            {
              "inputs": [
                {
                  "area": false,
                  "argument": "--k-list",
                  "datalist": [],
                  "help": "all must be odd, in the range 15-255, and with increments <= 28",
                  "help_format": "html",
                  "hidden": false,
                  "is_dynamic": false,
                  "label": "Comma-separated list of kmer size",
                  "model_class": "TextToolParameter",
                  "name": "k_list",
                  "optional": true,
                  "refresh_on_change": false,
                  "type": "text",
                  "value": "21,29,39,59,79,99,119,141"
                }
              ],
              "model_class": "ConditionalWhen",
              "value": "klist_method"
            },
            {
              "inputs": [
                {
                  "area": false,
                  "argument": "--k-min",
                  "datalist": [],
                  "help": "Must be odd number. For ultra complex metagenomics data such as soil, a larger kmin, say 27, is recommended to reduce the complexity of the de Bruijn graph. Quality trimming is also recommended. For high-depth generic data, large --k-min (25 to 31) is recommended. Smaller --k-step, say 10, is more friendly to low-coverage datasets.",
                  "help_format": "html",
                  "hidden": false,
                  "is_dynamic": false,
                  "label": "Minimum kmer size",
                  "max": 255,
                  "min": null,
                  "model_class": "IntegerToolParameter",
                  "name": "k_min",
                  "optional": false,
                  "refresh_on_change": false,
                  "type": "integer",
                  "value": "21"
                },
                {
                  "area": false,
                  "argument": "--k-max",
                  "datalist": [],
                  "help": "must be odd number",
                  "help_format": "html",
                  "hidden": false,
                  "is_dynamic": false,
                  "label": "Maximum kmer size",
                  "max": 255,
                  "min": null,
                  "model_class": "IntegerToolParameter",
                  "name": "k_max",
                  "optional": false,
                  "refresh_on_change": false,
                  "type": "integer",
                  "value": "141"
                },
                {
                  "area": false,
                  "argument": "--k-step",
                  "datalist": [],
                  "help": "must be even number",
                  "help_format": "html",
                  "hidden": false,
                  "is_dynamic": false,
                  "label": "Increment of kmer size of each iteration",
                  "max": 28,
                  "min": null,
                  "model_class": "IntegerToolParameter",
                  "name": "k_step",
                  "optional": false,
                  "refresh_on_change": false,
                  "type": "integer",
                  "value": "12"
                }
              ],
              "model_class": "ConditionalWhen",
              "value": "klim_method"
            }
