{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport requests, time\nsymbols = ['RHO','NRL','GNAT1','PDE6B','CNGA1','ARR3','GNAT2','PDE6C','OPN1LW','OPN1MW','RLBP1','GLUL','SLC1A3','SOX9','GFAP','AQP4','ALDH1L1','SLC1A2','PTPRC','AIF1','CX3CR1','C1QA','TMEM119','RBPMS','SNCG','POU4F2','THY1','LHX1','ONECUT1','PROX1','CALB1','GAD1','GAD2','SLC6A1','TFAP2A','GRIK1','SLC24A2','PCP2','RORB']\nfor s in symbols:\n    url=f'https://rest.ensembl.org/lookup/symbol/homo_sapiens/{s}'\n    r=requests.get(url, headers={'Content-Type':'application/json'}, timeout=20)\n    if r.status_code\"'!=200:\n        print(s, '\"'ERR', r.status_code, r.text[:100])\n        continue\n    d=r.json()\n    print('\\\\t'.join(map(str,[s,d.get('seq_region_name'),d.get('start'),d.get('end'),d.get('strand'),d.get('id'),d.get('biotype')])) )\n    time.sleep(0.1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
