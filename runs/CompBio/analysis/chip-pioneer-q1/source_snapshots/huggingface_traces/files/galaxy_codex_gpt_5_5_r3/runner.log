{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, os, time, urllib.request\nurl=os.environ['GALAXY_URL'].rstrip('/')\nwith open(os.environ['GALAXY_API_KEY_FILE']) as f: key=f.read().strip()\nheaders={'x-api-key':key,'content-type':'application/json'}\nhist='bbd44e69cb8906b50681acff57730a4b'\ntool='toolshed.g2.bx.psu.edu/repos/iuc/bedtools/bedtools_intersectbed/2.31.1+galaxy0'\ndef hda(i): return {'src':'hda','id':i}\npeaks={\n'TF1':'f9cad7b01a472135c0960994fd9c8b0c',\n'TF2':'f9cad7b01a472135c240789ea3469a11',\n'TF3':'f9cad7b01a4721355d4a7a0a591d95f8',\n'TF4':'f9cad7b01a472135f3ca1eea0d8da127',\n'TF5':'f9cad7b01a472135e3c9bcd5ab2fecc0',\n'TF6':'f9cad7b01a4721351d16bb4d5ed748a3',\n}\ndnase={\n'ENCODE3_narrow_union':['f9cad7b01a47213573ebf46587165d27','f9cad7b01a47213585ac64ee32756468'],\n'ENCODE3_hotspot_union':['f9cad7b01a472135fbd4153e732a373a','f9cad7b01a472135b3c821989e0c9ae8'],\n'ENCODE4_narrow_union':['f9cad7b01a472135502a4c468c3d1fd4','f9cad7b01a47213536b3721cad398164'],\n'Hotspot3_peaks_union':['f9cad7b01a47213593cd27e3c1b075bf','f9cad7b01a47213593e9dcabbbc1814e'],\n'Hotspot3_hotspot':['f9cad7b01a47213518082d94b3ec2364'],\n}\nsubmitted={}\nfor tf,pid in peaks.items():\n  for label,bids in dnase.items():\n    inputs={\n      'inputA': hda(pid),\n      'reduce_or_iterate': {'reduce_or_iterate_selector':'reduce','inputB':[hda(x) for x in bids], 'names':False},\n      'strand':'',\n      'overlap_mode':'-wa',\n      'split':False,\n      'fraction_cond': {'fraction_select':'default'},\n      'invert':True,\n      'once':False,\n      'count':False,\n      'bed':False,\n      'sorted':False,\n      'genome_file_opts': {'genome_file_opts_selector':'loc','genome':'hg38'},\n      'header':False,\n    }\n    payload={'history_id':hist,'tool_id':tool,'inputs':inputs,'input_format':'21.01'}\n    req=urllib.request.Request(url+'/api/tools', data=json.dumps(payload).encode(), headers=headers, 