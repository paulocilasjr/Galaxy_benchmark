{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, os, time, urllib.request, urllib.error\nurl=os.environ['GALAXY_URL'].rstrip('/')\nwith open(os.environ['GALAXY_API_KEY_FILE']) as f: key=f.read().strip()\nheaders={'x-api-key':key,'content-type':'application/json'}\nhist='bbd44e69cb8906b50681acff57730a4b'\ntool='toolshed.g2.bx.psu.edu/repos/iuc/macs2/macs2_callpeak/2.2.9.1+galaxy0'\ndef hda(i): return {'src':'hda','id':i}\nTF={\n'TF1': {'t':['f9cad7b01a472135016a1e197a651db3','f9cad7b01a47213597f20f99d878be80'], 'c':['f9cad7b01a472135b5076ffd06994e89','f9cad7b01a4721354bf16cfc1da9dde8']},\n'TF2': {'t':['f9cad7b01a472135c48034a9aa4d03fa','f9cad7b01a4721351c3fff4fbce00679'], 'c':['f9cad7b01a472135ce10c9545664703b','f9cad7b01a4721353519347ce6e6236d']},\n'TF3': {'t':['f9cad7b01a472135151d568d6e3fb40c','f9cad7b01a4721359122e17dc467385c'], 'c':['f9cad7b01a47213516e217c835c6628f','f9cad7b01a472135b9a459fbb38344a3']},\n'TF4': {'t':['f9cad7b01a472135bfc5e62c18c4462d','f9cad7b01a4721351dedf0429a254e0a'], 'c':['f9cad7b01a47213542946b7de6c1b185','f9cad7b01a472135917bcf6d6d5d81c7']},\n'TF5': {'t':['f9cad7b01a4721353f573cf411ed4710','f9cad7b01a472135fc24c2749187aa66'], 'c':['f9cad7b01a4721359b0e9ab39af493dc']},\n}\noutputs={}\nfor tf, ids in TF.items():\n    c_multi='Yes' if len(ids['c'])>1 else 'No'\n    ctrl = [hda(x) for x in ids['c']] if c_multi=='Yes' else hda(ids['c'][0])\n    inputs={\n      'treatment': {'t_multi_select':'Yes','input_treatment_file':[hda(x) for x in ids['t']]},\n      'control': {'c_select':'Yes','c_multiple': {'c_multi_select':c_multi,'input_control_file':ctrl}},\n      'format':'BED',\n      'effective_genome_size_options': {'effective_genome_size_options_selector':'2700000000'},\n      'nomodel_type': {'nomodel_type_selector':'create_model','mfold_lower':5,'mfold_upper':50,'band_width':300},\n      'cutoff_options': {'cutoff_options_selector':'qvalue','qvalue':0.05},\n      'outputs': ['peaks_tabular'],\n      'advanced_options': {'to_large':False,'nolambda':False,'spmr':False,'ratio':'','slocal':'','llocal':'','broad_options': {'broad_options_selector':'nobroad','call_summits':False}, 'keep_dup_options': {'keep_dup_options_selector':'auto'}, 'd_min':20, 'buffer_size':100000}\n    }\n    payload={'history_id':hist,'tool_id':tool,'inputs':inputs,'input_format':'21.01'}\n    req=urllib.request.Request(url+'/api/tools', data=json.dumps(payload).encode(), headers=headers, method='POST')\n    with urllib.request.urlopen(req, timeout=120) as r: resp=json.load(r)\n    outmap={o['output_name']:o['id'] for o in resp.get('outputs',[])}\n    outputs[tf]=outmap\n    print('SUBMITTED', tf, json.dumps(outmap))\nprint('WAITING')\nterminal={'ok','error','failed_metadata','deleted','discarded'}\nall_ids=[v['output_narrowpeaks'] for v in outputs.values()]\nwhile True:\n    states=[]\n    for did in all_ids:\n        req=urllib.request.Request(f'{url}/api/histories/{hist}/contents/{did}', headers={'x-api-key':key})\n        with urllib.request.urlopen(req, timeout=60) as r: d=json.load(r)\n        states.append(d.get('state'))\n    if all(s in terminal for s in states):\n        break\n    time.sleep(120)\nprint('FINAL')\nfor tf,outmap in outputs.items():\n    did=outmap['output_narrowpeaks']\n    req=urllib.request.Request(f'{url}/api/histories/{hist}/contents/{did}', headers={'x-api-key':key})\n    with urllib.request.urlopen(req, timeout=60) as r: d=json.load(r)\n    print(tf, did, d.get('state'), d.get('file_size'), d.get('misc_blurb'), d.get('name'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
