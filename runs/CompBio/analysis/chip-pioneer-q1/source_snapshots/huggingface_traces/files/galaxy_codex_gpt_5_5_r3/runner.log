{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport urllib.request, json\nurl='https://www.encodeproject.org/experiments/ENCSR000EME/?format=json'\nreq=urllib.request.Request(url, headers={'accept':'application/json','user-agent':'codex-galaxy-analysis'})\ndata=json.load(urllib.request.urlopen(req, timeout=60))\nfor f in data.get('files',[]):\n    if f.get('assembly')=='GRCh38' and f.get('status')=='released' and f.get('file_type','').startswith('bed'):\n        keys=['accession','file_type','output_type','biological_replicates','technical_replicates','preferred_default','processed','analysis_step_version','date_created','href','file_size','md5sum']\n        print('\\\\n'+f['accession'])\n        for k in keys:\n            print(k,':', f.get(k))\n        for k in ['dataset','lab','award','dbxrefs','derived_from','analyses']:\n            v=f.get(k)\n            if k in ['derived_from','analyses'] and v: print(k,':', v[:5], 'n=',len(v))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
