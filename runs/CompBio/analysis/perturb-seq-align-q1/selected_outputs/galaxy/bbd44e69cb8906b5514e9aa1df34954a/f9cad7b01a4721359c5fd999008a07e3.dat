import sys

import h5py
import numpy as np


def read_categorical(dataset):
    """Read a categorical or string array from an h5ad dataframe column group."""
    if isinstance(dataset, h5py.Dataset):
        data = dataset[()]
        if data.dtype.kind == "O":
            data = data.astype(str)
        else:
            data = data.astype(str)
        return data
    categories = dataset["categories"][()].astype(str)
    codes = dataset["codes"][()]
    return categories[codes]


def main(path, out_path):
    lines = []
    with h5py.File(path, "r") as f:
        lines.append("top-level: " + ",".join(f.keys()))
        x = f["X"]
        lines.append(f"X.attrs={dict(x.attrs)}")
        obs = f["obs"]
        lines.append(f"obs.attrs={dict(obs.attrs)}")
        for col in list(obs.keys()):
            vals = read_categorical(obs[col])
            lines.append(f"obs[{col}]: n={len(vals)} unique={len(np.unique(vals))} first={list(vals[:10])}")
        var = f["var"]
        lines.append(f"var.attrs={dict(var.attrs)}")
        if "_index" in var:
            vals = read_categorical(var["_index"])
            lines.append(f"var[_index]: n={len(vals)} first={list(vals[:10])}")
    with open(out_path, "w") as out:
        out.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2])
