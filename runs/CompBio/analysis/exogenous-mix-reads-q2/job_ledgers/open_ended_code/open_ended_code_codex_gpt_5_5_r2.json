      "tool": "shell",
      "command": "/bin/bash -lc \"python3 - <<'PY'\nfrom collections import Counter\nfiles=['exogenous.mix.reads.q2.exo.fq','exogenous.mix.reads.q2.endo.fq','exogenous.mix.reads.q2.mix.fq']\ndef read_fastq(path):\n    rec=[]\n    with open(path) as f:\n        while True:\n            h=f.readline().rstrip()\n            if not h: break\n            s=f.readline().rstrip(); p=f.readline().rstrip(); q=f.readline().rstrip()\n            rec.append((h,s,q))\n    return rec\nR={p:read_fastq(p) for p in files}\nfor p,rec in R.items():\n    print(p, 'records', len(rec), 'unique_seq', len(set(s for _,s,_ in rec)), 'unique_seqqual', len(set((s,q) for _,s,q in rec)))\n    print('dups seq', sum(c-1 for c in Counter(s for _,s,_ in rec).values() if c>1))\n# overlap of exact seq and seqqual sets\nfor a in files:\n  for b in files:\n    if a<b:\n      Sa=set(s for _,s,_ in R[a]); Sb=set(s for _,s,_ in R[b])\n      Qa=set((s,q) for _,s,q in R[a]); Qb=set((s,q) for _,s,q in R[b])\n      print('overlap',a,b,'seq',len(Sa&Sb),'seqqual',len(Qa&Qb))\n# multiset containment classify mix exact seqqual unique to refs\nexo=Counter((s,q) for _,s,q in R[files[0]])\nendo=Counter((s,q) for _,s,q in R[files[1]])\nmix=Counter((s,q) for _,s,q in R[files[2]])\nprint('mix seqqual in exo not endo',sum(c for k,c in mix.items() if k in exo and k not in endo))\nprint('mix seqqual in endo not exo',sum(c for k,c in mix.items() if k in endo and k not in exo))\nprint('mix seqqual in both',sum(c for k,c in mix.items() if k in exo and k in endo))\nprint('mix seqqual in neither',sum(c for k,c in mix.items() if k not in exo and k not in endo))\n# sequence-only\nexoS=set(s for _,s,_ in R[files[0]]); endoS=set(s for _,s,_ in R[files[1]])\nprint('mix seq in exo not endo',sum(1 for _,s,_ in R[files[2]] if s in exoS and s not in endoS))\nprint('mix seq in endo not exo',sum(1 for _,s,_ in R[files[2]] if s in endoS and s not in exoS))\nprint('mix seq in both',sum(1 for _,s,_ in R[files[2]] if s in exoS and s in endoS))\nprint('mix seq neither',sum(1 for _,s,_ in R[files[2]] if s not in exoS and s not in endoS))\nPY\"",
