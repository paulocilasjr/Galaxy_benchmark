{"type":"item.started","item":{"id":"item_59","type":"mcp_tool_call","server":"bixbench_galaxy_execute","tool":"run_galaxy_udt_and_wait","arguments":{"history_id":"bbd44e69cb8906b5847ff5a04c01bbfb","input_format":"auto","timeout_seconds":5400,"representation":{"class":"GalaxyUserTool","container":"quay.io/biocontainers/phykit:2.4.1--pyhdfd78af_0","id":"bixbench_pis_counts_v2","inputs":[{"format":["zip"],"name":"animals_archive","type":"data"},{"format":["zip"],"name":"fungi_archive","type":"data"},{"name":"animals_label","type":"text"},{"name":"fungi_label","type":"text"}],"name":"Batch PhyKIT parsimony informative site counts v2","outputs":[{"format":"tabular","from_work_dir":"pis_counts.tsv","name":"counts","type":"data"}],"shell_command":"set -eu\npython3 - <<'PY'\nimport pathlib\nimport subprocess\nimport sys\nimport zipfile\n\npairs = [\n    ('$(inputs.animals_label)', '$(inputs.animals_archive.path)'),\n    ('$(inputs.fungi_label)', '$(inputs.fungi_archive.path)'),\n]\n\nout_path = pathlib.Path('pis_counts.tsv')\nwork_root = pathlib.Path('alignments')\nwith out_path.open('w') as out:\n    out.write('group\\tfile\\tparsimony_informative\\ttotal_sites\\tpercent\\n')\n    for group, archive_path in pairs:\n        with zipfile.ZipFile(archive_path) as archive:\n            members = sorted(\n                name for name in archive.namelist() if name.endswith('.mafft')\n            )\n            for member in members:\n                alignment_path = work_root / group / pathlib.PurePosixPath(member).name\n                alignment_path.parent.mkdir(parents=True, exist_ok=True)\n                alignment_path.write_bytes(archive.read(member))\n                result = subprocess.run(\n                    ['phykit', 'parsimony_informative_sites', str(alignment_path)],\n                    capture_output=True,\n                    text=True,\n                )\n                if result.returncode != 0:\n                    print(result.stderr, file=sys.stderr)\n                    sys.exit(result.returncode)\n                values = result.stdout.strip().split('\\t')\n                if len(values) != 3:\n                    print('Unexpected phykit output for ' + member + ': ' + result.stdout, file=sys.stderr)\n                    sys.exit(1)\n                out.write('\\t'.join([group, member, values[0], values[1], values[2]]) + '\\n')\nPY","version":"0.1.0"},"tool_inputs":{"animals_archive":{"id":"f9cad7b01a472135addc0d72c99ce162","src":"hda"},"animals_label":"animals","fungi_archive":{"id":"f9cad7b01a4721358d885ed0e2038681","src":"hda"},"fungi_label":"fungi"}},"result":null,"error":null,"status":"in_progress"}}
