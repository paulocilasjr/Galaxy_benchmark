{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom bioblend.galaxy import GalaxyInstance\nkey=Path('/run/secrets/galaxy_api_key').read_text().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\ntid='toolshed.g2.bx.psu.edu/repos/goeckslab/nonparametric_rank_tests/nonparametric_rank_tests/0.1.0+galaxy2'\ntry:\n    src=gi.tools.get_tool_source(tid)\n    print(src)\nexcept Exception as e:\n    print(type(e).__name__, e)\nPY\"","aggregated_output":"<tool id=\"nonparametric_rank_tests\" name=\"Nonparametric rank tests\" version=\"0.1.0+galaxy2\" profile=\"22.05\">\n    <description>run rank-based tests on tabular data</description>\n    <requirements>\n        <requirement type=\"package\" version=\"1.2.1\">gseapy</requirement>\n    </requirements>\n    <command detect_errors=\"exit_code\">\npython '$__tool_directory__/nonparametric_rank_tests.py'\n    --test '$test'\n    --input-mode '$input_mode.selector'\n    --alternative '$alternative'\n    #if $test == \"mann_whitney_u\"\n        --method '$mann_whitney_options.method'\n        --use-continuity '$mann_whitney_options.use_continuity'\n    #else\n        --wilcoxon-method '$wilcoxon_options.method'\n        --zero-method '$wilcoxon_options.zero_method'\n        --correction '$wilcoxon_options.correction'\n    #end if\n    #if $input_mode.selector == \"grouped_table\"\n        --input '$input_mode.input'\n        --value-column '$input_mode.value_column'\n        --group-column '$input_mode.group_column'\n        --has-header '$input_mode.has_header'\n        --group-a '$input_mode.group_a'\n        --group-b '$input_mode.group_b'\n    #else\n        --input-a '$input_mode.input_a'\n        --input-b '$input_mode.input_b'\n        --value-column-a '$input_mode.value_column_a'\n        --value-column-b '$input_mode.value_column_b'\n        --has-header-a '$input_mode.has_header_a'\n        --has-header-b '$input_mode.has_header_b'\n        --label-a '$input_mode.label_a'\n        --label-b '$input_mode.label_b'\n    #end if\n    --output '$output'\n    </command>\n    <inputs>\n        <param name=\"test\" type=\"select\" label=\"Statistical test\">\n            <option value=\"mann_whitney_u\" selected=\"true\">Mann-Whitney U test for independent samples</option>\n            <option value=\"wilcoxon_signed_rank\">Wilcoxon signed-rank test for paired samples</option>\n        </param>\n        <conditional name=\"input_mode\">\n            <param name=\"selector\" type=\"select\" label=\"Input layout\">\n                <option value=\"grouped_table\" selected=\"true\">One table with value and group columns</option>\n                <option value=\"two_tables\">Two tables, one value column per group</option>\n            </param>\n            <when value=\"grouped_table\">\n                <param name=\"input\" type=\"data\" format=\"tabular,txt\" label=\"Input table\"/>\n                <param name=\"has_header\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Input has a header row\"/>\n                <param name=\"value_column\" type=\"integer\" min=\"1\" value=\"2\" label=\"Value column\" help=\"One-based column number containing numeric observations.\"/>\n                <param name=\"group_column\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group column\" help=\"One-based column number containing group labels.\"/>\n                <param name=\"group_a\" type=\"text\" value=\"\" optional=\"true\" label=\"Group A label\" help=\"Leave both group labels blank to use the two groups found in the file.\"/>\n                <param name=\"group_b\" type=\"text\" value=\"\" optional=\"true\" label=\"Group B label\" help=\"Leave both group labels blank to use the two groups found in the file.\"/>\n            </when>\n            <when value=\"two_tables\">\n                <param name=\"input_a\" type=\"data\" format=\"tabular,txt\" label=\"Group A table\"/>\n                <param name=\"input_b\" type=\"data\" format=\"tabular,txt\" label=\"Group B table\"/>\n                <param name=\"has_header_a\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Group A table has a header row\"/>\n                <param name=\"has_header_b\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Group B table has a header row\"/>\n                <param name=\"value_column_a\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group A value column\"/>\n                <param name=\"value_column_b\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group B value column\"/>\n                <param name=\"label_a\" type=\"text\" value=\"group_a\" label=\"Group A output label\"/>\n                <param name=\"label_b\" type=\"text\" value=\"group_b\" label=\"Group B output label\"/>\n            </when>\n        </conditional>\n        <param name=\"alternative\" type=\"select\" label=\"Alternative hypothesis\">\n            <option value=\"two-sided\" selected=\"true\">two-sided</option>\n            <option value=\"less\">less</option>\n            <option value=\"greater\">greater</option>\n        </param>\n        <section name=\"mann_whitney_options\" title=\"Mann-Whitney U options\">\n            <param name=\"method\" type=\"select\" label=\"P-value method\">\n                <option value=\"auto\" selected=\"true\">auto</option>\n                <option value=\"exact\">exact</option>\n                <option value=\"asymptotic\">asymptotic</option>\n            </param>\n            <param name=\"use_continuity\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Use continuity correction for asymptotic method\"/>\n        </section>\n        <section name=\"wilcoxon_options\" title=\"Wilcoxon signed-rank options\">\n            <param name=\"method\" type=\"select\" label=\"P-value method\">\n                <option value=\"auto\" selected=\"true\">auto</option>\n                <option value=\"exact\">exact</option>\n                <option value=\"approx\">approximate/asymptotic</option>\n            </param>\n            <param name=\"zero_method\" type=\"select\" label=\"Zero-difference handling\">\n                <option value=\"wilcox\" selected=\"true\">wilcox: discard zero differences</option>\n                <option value=\"pratt\">pratt: include zero differences in ranking</option>\n                <option value=\"zsplit\">zsplit: split zero ranks between positive and negative sides</option>\n            </param>\n            <param name=\"correction\" type=\"boolean\" checked=\"false\" truevalue=\"true\" falsevalue=\"false\" label=\"Apply continuity correction for normal approximation\"/>\n        </section>\n    </inputs>\n    <outputs>\n        <data name=\"output\" format=\"tabular\" label=\"${tool.name} on ${on_string}: results\"/>\n    </outputs>\n    <tests>\n        <test>\n            <param name=\"test\" value=\"mann_whitney_u\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"input_mode|group_b\" value=\"fungi\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"mann_whitney_options|method\" value=\"exact\"/>\n            <param name=\"mann_whitney_options|use_continuity\" value=\"true\"/>\n            <output name=\"output\" file=\"mann_whitney_grouped_results.tsv\"/>\n        </test>\n        <test>\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"two_tables\"/>\n            <param name=\"input_mode|input_a\" value=\"paired_before.tsv\"/>\n            <param name=\"input_mode|input_b\" value=\"paired_after.tsv\"/>\n            <param name=\"input_mode|has_header_a\" value=\"true\"/>\n            <param name=\"input_mode|has_header_b\" value=\"true\"/>\n            <param name=\"input_mode|value_column_a\" value=\"1\"/>\n            <param name=\"input_mode|value_column_b\" value=\"1\"/>\n            <param name=\"input_mode|label_a\" value=\"before\"/>\n            <param name=\"input_mode|label_b\" value=\"after\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"exact\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <output name=\"output\" file=\"wilcoxon_paired_results.tsv\"/>\n        </test>\n        <test>\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"two_tables\"/>\n            <param name=\"input_mode|input_a\" value=\"paired_before.tsv\"/>\n            <param name=\"input_mode|input_b\" value=\"paired_after.tsv\"/>\n            <param name=\"input_mode|has_header_a\" value=\"true\"/>\n            <param name=\"input_mode|has_header_b\" value=\"true\"/>\n            <param name=\"input_mode|value_column_a\" value=\"1\"/>\n            <param name=\"input_mode|value_column_b\" value=\"1\"/>\n            <param name=\"input_mode|label_a\" value=\"before\"/>\n            <param name=\"input_mode|label_b\" value=\"after\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"approx\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <output name=\"output\" file=\"wilcoxon_paired_approx_results.tsv\"/>\n        </test>\n        <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"mann_whitney_u\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"mann_whitney_options|method\" value=\"exact\"/>\n            <param name=\"mann_whitney_options|use_continuity\" value=\"true\"/>\n            <assert_stderr>\n                <has_text text=\"Provide both group labels, or leave both blank to auto-detect groups\"/>\n            </assert_stderr>\n        </test>\n        <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"input_mode|group_b\" value=\"fungi\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"exact\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <assert_stderr>\n                <has_text text=\"Wilcoxon signed-rank test requires paired observations; use two_tables input mode\"/>\n            </assert_stderr>\n        </test>\n        <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"two_tables\"/>\n            <param name=\"input_mode|input_a\" value=\"paired_before_missing.tsv\"/>\n            <param name=\"input_mode|input_b\" value=\"paired_after_missing.tsv\"/>\n            <param name=\"input_mode|has_header_a\" value=\"true\"/>\n            <param name=\"input_mode|has_header_b\" value=\"true\"/>\n            <param name=\"input_mode|value_column_a\" value=\"1\"/>\n            <param name=\"input_mode|value_column_b\" value=\"1\"/>\n            <param name=\"input_mode|label_a\" value=\"before\"/>\n            <param name=\"input_mode|label_b\" value=\"after\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"exact\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <assert_stderr>\n                <has_text text=\"Wilcoxon signed-rank test requires complete paired observations\"/>\n            </assert_stderr>\n        </test>\n    </tests>\n    <help>\nThis tool currently runs two common nonparametric rank tests:\n\n**Mann-Whitney U**\n  Use for two independent groups.\n\n**Wilcoxon signed-rank**\n  Use for paired observations with equal group lengths. This test requires the\n  two-table input layout so observations are paired by row.\n\nInputs may be provided as one table with a group column and a numeric value\ncolumn, or as two separate tables with one numeric value column per group.\nMissing values encoded as blank, NA, NaN, None, or null are skipped for\nindependent Mann-Whitney U tests. Wilcoxon signed-rank tests require complete\npaired observations.\n\nThe output is a two-column tabular summary containing the selected test,\ngroup labels, sample sizes, alternative hypothesis, method, statistic, and\np-value.\n    </help>\n    <citations>\n        <citation type=\"doi\">10.1038/s41592-019-0686-2</citation>\n    </citations>\n</tool>\n","exit_code":0,"status":"completed"}}
