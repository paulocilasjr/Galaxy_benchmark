{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections\nfor name in ['JD','ZF']:\n    with open(f'/workspace/inputs/{name}_AgeRelated_CpG_noMT_Final.csv', newline='', encoding='utf-8-sig') as f:\n        r=csv.DictReader(f)\n        pos_counts=collections.Counter()\n        rows=0\n        chrom_pos=collections.defaultdict(set)\n        chrom_rows=collections.Counter()\n        for row in r:\n            rows+=1\n            chrom=row['Chromosome'].strip()\n            pos=row['Pos'].strip()\n            chrom_rows[chrom]+=1\n            chrom_pos[chrom].add(pos)\n    with open(f'/workspace/inputs/{name}_Chromosome_Length.csv', newline='', encoding='utf-8-sig') as f:\n        r=csv.DictReader(f)\n        lengths={row['Chromosome'].strip(): int(row['Length']) for row in r}\n    print(name, 'rows',rows, 'unique Pos', len({p for s in chrom_pos.values() for p in s}), 'chroms', len(chrom_pos))\n    print('top row counts by chrom', chrom_rows.most_common(5))\n    print('top site counts by chrom', sorted(((len(v),k) for k,v in chrom_pos.items()), reverse=True)[:10])\n    print('chrom not in length', set(chrom_pos)-set(lengths))\n    print('length chrom not in sites', set(lengths)-set(chrom_pos))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
