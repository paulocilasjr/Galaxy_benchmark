{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nfor d in ['tmp/scogs_a','tmp/scogs_f']:\n  allgap=0; total_cols=0; files_allgap=0\n  for p in Path(d).glob('*.mafft'):\n    seqs=[]; cur=[]; name=None\n    for line in p.read_text().splitlines():\n      if line.startswith('>'):\n        if name is not None: seqs.append((name,''.join(cur)))\n        name=line[1:].strip(); cur=[]\n      else: cur.append(line.strip())\n    if name is not None: seqs.append((name,''.join(cur)))\n    n=len(seqs); L=len(seqs[0][1]); total_cols+=L\n    fg=0\n    for j in range(L):\n      if all(s[j] in '-.' for n,s in seqs): fg+=1\n    allgap+=fg; files_allgap += (fg>0)\n  print(d,'total cols',total_cols,'allgap cols',allgap,'files with allgap',files_allgap)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
