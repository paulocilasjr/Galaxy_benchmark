{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport scipy.stats as st\n\ndef read_fasta(p):\n    seqs=[]\n    name=None; cur=[]\n    for line in p.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append((name,''.join(cur)))\n            name=line[1:].strip(); cur=[]\n        else: cur.append(line.strip())\n    if name is not None: seqs.append((name,''.join(cur)))\n    return seqs\n\ndef calc(p, gap_as_state=False, require_non_gap=False):\n    seqs=read_fasta(p)\n    names=[n for n,s in seqs]\n    arr=[list(s) for n,s in seqs]\n    n=len(arr); L=len(arr[0])\n    pis=0\n    for j in range(L):\n        col=[arr[i][j] for i in range(n)]\n        # choose symbols\n        if gap_as_state:\n            syms=col\n        else:\n            syms=[c for c in col if c not in ('-','.')]\n        counts=Counter(syms)\n        # distinct states observed, each at least 2\n        states=[c for c,v in counts.items() if v>=2]\n        if len(set(states))>=2:\n            pis+=1\n    return pis/L*100\n\nfor gap_as_state in [False, True]:\n  print('gap_as_state',gap_as_state)\n  for d in ['tmp/scogs_a','tmp/scogs_f']:\n      vals=[]\n      for p in Path(d).glob('*.mafft'):\n          vals.append(calc(p, gap_as_state=gap_as_state))\n      vals.sort()\n      print(d,'n',len(vals),'min',min(vals),'median',vals[len(vals)//2],'max',max(vals),'mean',sum(vals)/len(vals))\n  A=sorted(calc(p, gap_as_state=gap_as_state) for p in Path('tmp/scogs_a').glob('*.mafft'))\n  F=sorted(calc(p, gap_as_state=gap_as_state) for p in Path('tmp/scogs_f').glob('*.mafft'))\n  for alt in ['two-sided','less','greater']:\n      res=st.mannwhitneyu(A,F,alternative=alt,method='auto')\n      print(alt,res.statistic,res.pvalue)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
