{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport scipy.stats as st\nprint('scipy',st.__version__)\ndef read(p):\n  seqs=[]; name=None; cur=[]\n  for line in p.read_text().splitlines():\n    if line.startswith('>'):\n      if name is not None: seqs.append((name,''.join(cur)))\n      name=line[1:].strip(); cur=[]\n    else: cur.append(line.strip())\n  if name is not None: seqs.append((name,''.join(cur)))\n  return seqs\n\ndef pis(p, exclude_gap=True, ambiguous='XBZJUO?*'):\n  seqs=read(p); n=len(seqs); L=len(seqs[0][1]); cnt=0\n  for j in range(L):\n    col=[s[j] for n,s in seqs]\n    syms=[c for c in col if c not in '-.' and (not ambiguous or c not in ambiguous)]\n    counts=Counter(syms)\n    states=[c for c,v in counts.items() if v>=2]\n    if len(states)>=2: cnt+=1\n  return cnt/L*100\nA=sorted(pis(p) for p in Path('tmp/scogs_a').glob('*.mafft'))\nF=sorted(pis(p) for p in Path('tmp/scogs_f').glob('*.mafft'))\nfor alt in ['two-sided','less','greater']:\n  for cont in [True,False]:\n    res=st.mannwhitneyu(A,F,alternative=alt,use_continuity=cont,method='auto')\n    print('A,F',alt,cont,res.statistic,res.pvalue)\n  res=st.mannwhitneyu(F,A,alternative=alt,use_continuity=True,method='auto')\n  print('F,A',alt,True,res.statistic,res.pvalue)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
