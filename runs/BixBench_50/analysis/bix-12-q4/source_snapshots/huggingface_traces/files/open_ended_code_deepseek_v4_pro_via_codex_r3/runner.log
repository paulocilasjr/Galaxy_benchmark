{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport scipy.stats as st\n\nAMBIGUOUS=set('XBZJUO?*')\n\ndef read_fasta(path):\n    seqs=[]; name=None; buf=[]\n    with path.open() as f:\n        for raw in f:\n            line=raw.strip()\n            if not line:\n                continue\n            if line.startswith('>'):\n                if name is not None:\n                    seqs.append((name,''.join(buf)))\n                name=line[1:]; buf=[]\n            else:\n                buf.append(line)\n    if name is not None:\n        seqs.append((name,''.join(buf)))\n    return seqs\n\ndef pis_percent(path):\n    seqs=read_fasta(path)\n    n=len(seqs)\n    if n==0:\n        raise ValueError(f'empty alignment: {path}')\n    lengths={len(s) for _,s in seqs}\n    if len(lengths)\"'!=1:\n        raise ValueError(f'\"'ragged alignment: {path}: {lengths}')\n    L=lengths.pop()\n    informative=0\n    for col in range(L):\n        chars=[s[col] for _,s in seqs]\n        counts=Counter(c for c in chars if c not in '-.' and c not in AMBIGUOUS)\n        states=[c for c,v in counts.items() if v>=2]\n        if len(set(states))>=2:\n            informative += 1\n    return 100.0*informative/L\n\nfor group in ['tmp/scogs_a','tmp/scogs_f']:\n    vals=[pis_percent(p) for p in sorted(Path(group).glob('*.mafft'))]\n    print(group, 'n=',len(vals), 'min=%.12g'%min(vals), 'median=%.12g'%sorted(vals)[len(vals)//2], 'max=%.12g'%max(vals), 'mean=%.12g'%(sum(vals)/len(vals)))\n\nA=[pis_percent(p) for p in sorted(Path('tmp/scogs_a').glob('*.mafft'))]\nF=[pis_percent(p) for p in sorted(Path('tmp/scogs_f').glob('*.mafft'))]\nres=st.mannwhitneyu(A,F,alternative='two-sided',use_continuity=True,method='auto')\nprint('U animals-first =',repr(res.statistic))\nprint('U fungi-first =',len(A)*len(F)-res.statistic)\nprint('p-value =',res.pvalue)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
