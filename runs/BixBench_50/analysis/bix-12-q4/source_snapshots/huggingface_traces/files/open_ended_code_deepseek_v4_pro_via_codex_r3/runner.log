{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c 'cd /workspace && mkdir -p tmp/busco && for f in inputs/*.busco.zip; do b=$(basename \"$f\" .busco.zip); unzip -q -o \"$f\" -d \"tmp/busco/$b\"; done && python3 - <<'\"'PY'\nfrom pathlib import Path\nimport pandas as pd, collections, re, os\nbase=Path('tmp/busco')\nfor clade, species_list in [('Animals',['Animals_Cele','Animals_Ggal','Animals_Mmus','Animals_Xlae']),('Fungi',['Fungi_Ncra','Fungi_Scer','Fungi_Spom','Fungi_Umay'])]:\n  print('\\\\n',clade)\n  counts=collections.Counter()\n  for sp in species_list:\n    ft=base/sp/'run_eukaryota_odb10'/'full_table.tsv'\n    rows=[]\n    for line in ft.read_text().splitlines():\n      if line.startswith('#'): continue\n      parts=line.split('\\\\t')\n      rows.append(parts)\n    for parts in rows:\n      busco=parts[0]; status=parts[1]\n      if status=='Complete': counts[busco]+=1\n  dist=collections.Counter(counts.values())\n  print('complete counts dist',dist)\n  print('total distinct complete',len(counts))\n  print('genes with 4 complete', sum(1 for g,c in counts.items() if c==4))\n  print('genes with >=1',sum(1 for g,c in counts.items() if c>=1))\n  # Compare with scogs mafft ids\n  scog={p.name.split('.faa')[0] for p in (Path('tmp/scogs_a') if clade=='Animals' else Path('tmp/scogs_f')).glob('*.mafft')}\n  print('scogs count',len(scog))\n  print('scogs not complete any', len(scog-set(counts)), 'complete not scogs', len(set(counts)-scog))\n  # show distribution complete count for scog ids\n  scog_dist=collections.Counter(counts[g] for g in scog if g in counts)\n  print('scog complete count dist',scog_dist)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
