{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfor d in ['tmp/scogs_a','tmp/scogs_f']:\n    ids={p.name[:-len('.mafft')] for p in Path(d).glob('*.mafft')}\n    faas={p.name for p in Path(d).glob('*.faa')}\n    print(d, len(ids), 'mafft ids')\n    print('ids no faa', len(ids-faas), sorted(ids-faas)[:5])\n    print('faa no mafft', len(faas-ids), sorted(faas-ids)[:5])\nan= {p.stem.replace('.faa','') for p in Path('tmp/scogs_a').glob('*.mafft')}\nfu={p.stem.replace('.faa','') for p in Path('tmp/scogs_f').glob('*.mafft')}\nprint('intersection', len(an&fu),'animal-only',len(an-fu), sorted(an-fu)[:20],'fungi-only',len(fu-an), sorted(fu-an)[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
