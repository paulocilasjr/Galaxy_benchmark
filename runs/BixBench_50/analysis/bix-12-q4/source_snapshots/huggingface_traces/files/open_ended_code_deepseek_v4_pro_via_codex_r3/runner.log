{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef read_fasta(p):\n    seqs=[]; name=None; cur=[]\n    for line in p.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append((name,''.join(cur)))\n            name=line[1:].strip(); cur=[]\n        else: cur.append(line.strip())\n    if name is not None: seqs.append((name,''.join(cur)))\n    return seqs\n\ndef calc(p, gap_as_state=False):\n    seqs=read_fasta(p); n=len(seqs); L=len(seqs[0][1])\n    pis=0\n    for j in range(L):\n        col=[s[j] for n,s in seqs]\n        if gap_as_state: syms=col\n        else: syms=[c for c in col if c not in ('-','.')]\n        counts=Counter(syms)\n        states=[c for c,v in counts.items() if v>=2]\n        if len(set(states))>=2: pis+=1\n    return pis/L*100\n\ndef mw_u(A,B):\n    # U for A vs B: number of A_i < B_j plus half ties? scipy uses rank sum ties correction? statistic U = R1 - n1*(n1+1)/2 using average ranks.\n    vals=sorted([(x,0) for x in A]+[(y,1) for y in B], key=lambda t:t[0])\n    n=len(vals); ranks=[0]*n\n    i=0\n    while i<n:\n        j=i\n        while j<n and vals[j][0]==vals[i][0]: j+=1\n        avg=(i+1 + j)/2\n        for k in range(i,j): ranks[k]=avg\n        i=j\n    R1=sum(ranks[k] for k in range(n) if vals[k][1]==0)\n    n1=len(A)\n    U=R1-n1*(n1+1)/2\n    return U\n\nfor gap_as_state in [False, True]:\n  print('gap_as_state',gap_as_state)\n  for d in ['tmp/scogs_a','tmp/scogs_f']:\n      vals=[calc(p, gap_as_state=gap_as_state) for p in Path(d).glob('*.mafft')]\n      vals.sort()\n      print(d,'n',len(vals),'min',min(vals),'median',vals[len(vals)//2],'max',max(vals),'mean',sum(vals)/len(vals))\n  A=sorted(calc(p, gap_as_state=gap_as_state) for p in Path('tmp/scogs_a').glob('*.mafft'))\n  F=sorted(calc(p, gap_as_state=gap_as_state) for p in Path('tmp/scogs_f').glob('*.mafft'))\n  print('U A,F', mw_u(A,F), 'U F,A', mw_u(F,A), 'n1*n2',len(A)*len(F))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
