{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os, glob, math, json, tempfile, subprocess, sys\nfrom collections import Counter\n\ndef read_fasta(path):\n    seqs=[]; name=None; parts=[]\n    with open(path) as f:\n        for line in f:\n            if line.startswith('>'):\n                if name is not None: seqs.append(''.join(parts).replace('\\\\n',''))\n                name=line[1:].strip(); parts=[]\n            else: parts.append(line.strip())\n        if name is not None: seqs.append(''.join(parts))\n    return seqs\n\ndef pis_pct(path):\n    seqs=read_fasta(path); n=len(seqs); L=len(seqs[0])\n    pi=0\n    for j in range(L):\n        cnt=Counter(s[j] for s in seqs if s[j] not in '-.Xx?*')\n        if sum(v>=2 for v in cnt.values())>=2: pi+=1\n    return pi, L\n\narrs={}\nfor label,root in [('animal','/workspace/tmp/scogs_animal'),('fungi','/workspace/tmp/scogs_fungi')]:\n    arr=[]\n    for f in glob.glob(root+'/*.mafft'):\n        pi,L=pis_pct(f); arr.append(100*pi/L)\n    arrs[label]=arr\n    print(label,len(arr),sum(arr)/len(arr),min(arr),max(arr))\n\na=arrs['animal']; b=arrs['fungi']\n\n# rank with average ties\nvals=sorted(set(a+b))\nrank={v:i+1 for i,v in enumerate(vals)}\nfrom collections import defaultdict\nallv=a+b\npos=defaultdict(list)\nfor i,v in enumerate(sorted(allv)): pos[v].append(i+1)\navg={v:sum(l)/len(l) for v,l in pos.items()}\nR1=sum(avg[v] for v in a)\nU1=R1 - len(a)*(len(a)+1)/2\nU2=len(a)*len(b)-U1\nprint('avg rank',R1,'U1',U1,'U2',U2,'min',min(U1,U2))\n# concordant count: for each a > b U1; ties half? standard U with ties from concordance\nconc=0; tie=0\nfor x in a:\n  for y in b:\n    if x>y: conc+=1\n    elif x==y: tie+=1\nUconc=conc+tie/2\nprint('concordant U1',Uconc,'U2',len(a)*len(b)-Uconc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
