{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os, glob, math\nfrom collections import Counter, defaultdict\n\ndef read_fasta(path):\n    seqs=[]; name=None; parts=[]\n    with open(path) as f:\n        for line in f:\n            if line.startswith('>'):\n                if name is not None:\n                    seqs.append(''.join(parts).replace('\\\\n',''))\n                name=line[1:].strip(); parts=[]\n            else:\n                parts.append(line.strip())\n        if name is not None: seqs.append(''.join(parts))\n    return seqs\n\ndef stats(path):\n    seqs=read_fasta(path)\n    n=len(seqs)\n    L=len(seqs[0]) if n else 0\n    allchars=set('-Xx?.*')\n    pi=0; pi_ambig=0; variable=0; occupied_cols=0\n    for j in range(L):\n        col=[s[j] for s in seqs]\n        cnt=Counter(c for c in col if c not in ['-','.','?','X','x','*'])\n        # gap-only?\n        if not cnt:\n            continue\n        occupied_cols += 1\n        # standard two chars each >=2\n        if sum(v>=2 for v in cnt.values()) >= 2:\n            pi += 1\n        # variable\n        if len(cnt)>1:\n            variable += 1\n    return pi, L, occupied_cols, variable, n\n\nfor label, root in [('animal','/workspace/tmp/scogs_animal'),('fungi','/workspace/tmp/scogs_fungi')]:\n    files=glob.glob(root+'/*.mafft')\n    arr=[]\n    print('\\\\n',label,len(files))\n    for f in files:\n        pi,L,occ,var,n=stats(f)\n        pct=100.0*pi/L\n        arr.append((pct,pi,L,occ,var,n,os.path.basename(f)))\n    # means denominator L\n    print('mean pct over L',sum(x[0] for x in arr)/len(arr))\n    print('sum pi/sum L',sum(x[1] for x in arr)/sum(x[2] for x in arr)*100)\n    print('range',min(x[0] for x in arr),max(x[0] for x in arr))\n    print('zeros',sum(x[1]==0 for x in arr),'all?',arr[:3])\n    globals()[label+'_arr']=arr\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
