{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\nimport zipfile, subprocess, os, tempfile, re\nfrom scipy import stats\nfrom scipy.stats import mannwhitneyu\n\ndef calc_pis(path):\n    p=subprocess.run(['/opt/agent-venv/bin/phykit','parsimony_informative_sites',path],capture_output=True,text=True,check=True)\n    # output tabs: count total percentage\n    parts=p.stdout.strip().split('\\\\t')\n    return float(parts[2]), int(parts[0]), int(parts[1])\n\ndef extract(zipname, dest):\n    z=zipfile.ZipFile(zipname)\n    for n in z.namelist():\n        if n.endswith('.faa.mafft'):\n            data=z.read(n)\n            path=os.path.join(dest,os.path.basename(n))\n            with open(path,'wb') as f:f.write(data)\n    z.close()\nextract('inputs/scogs_animals.zip','tmp/scogs_a')\nextract('inputs/scogs_fungi.zip','tmp/scogs_f')\nfor label,d in [('a','tmp/scogs_a'),('f','tmp/scogs_f')]:\n    vals=[]\n    for fn in sorted(os.listdir(d)):\n        if fn.endswith('.faa.mafft'):\n            pct,c,t=calc_pis(os.path.join(d,fn))\n            vals.append((fn,pct,c,t))\n    print(label, len(vals), 'mean pct', sum(v[1] for v in vals)/len(vals), 'minmax',min(v[1] for v in vals),max(v[1] for v in vals))\n    # save\n    globals()[label]=vals\n# Need same order maybe common files paired? First independent all\npct_a=[v[1] for v in a]; pct_f=[v[1] for v in f]\nres=mannwhitneyu(pct_a,pct_f, alternative='two-sided', method='auto')\nprint('scipy default auto', res)\n# R-like U = sum ranks group x - n*(n+1)/2? \nimport numpy as np\nx=np.array(pct_a); y=np.array(pct_f)\n# scipy U1 = stat\nU1=res.statistic; U2=len(x)*len(y)-U1\nprint('U1 U2',U1,U2,'R W for x',U1, 'W y',U2)\n# method exact maybe\nfor method in ['auto','exact','asymptotic']:\n    try:\n      r=mannwhitneyu(pct_a,pct_f, alternative='two-sided', method=method)\n      print(method, r)\n    except Exception as e: print(method,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
