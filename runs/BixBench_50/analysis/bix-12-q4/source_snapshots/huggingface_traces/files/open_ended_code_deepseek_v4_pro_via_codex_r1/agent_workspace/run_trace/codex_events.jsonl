{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\nimport zipfile, re, os\nfor name in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    z=zipfile.ZipFile(name)\n    names=z.namelist()\n    ma=[n for n in names if n.endswith('.faa.mafft')]\n    faa=[n for n in names if n.endswith('.faa')]\n    print(name, 'total',len(names),'mafft',len(ma),'faa',len(faa), 'nonmatch', set(ma)-set(f[:-1]+'.mafft' for f in faa))\n    # inspect sequence count per first files and lengths etc\n    import collections\n    seqcounts=collections.Counter()\n    for n in ma[:10]:\n        data=z.read(n).decode()\n        seqcounts[len(re.findall(r'\"'^>'\"', data, re.M))]+=1\n    print('seq counts first 10',seqcounts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
