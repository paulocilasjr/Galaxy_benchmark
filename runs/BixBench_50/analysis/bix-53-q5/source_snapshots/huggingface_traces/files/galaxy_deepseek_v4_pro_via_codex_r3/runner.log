{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, os\nsrc='tmp/Galaxy1-[count.csv].csv'\noutdir='tmp/samples'\nos.makedirs(outdir, exist_ok=True)\nsamples=['KL1','KL2','KL3','WL1','WL2','WL3']\nwith open(src, newline='') as f:\n    r=csv.DictReader(f)\n    rows=list(r)\nprint('rows', len(rows))\nfor s in samples:\n    p=os.path.join(outdir, f'{s}.tsv')\n    with open(p,'w', newline='') as f:\n        w=csv.writer(f, delimiter='\\\\t', lineterminator='\\\\n')\n        w.writerow(['geneID', s])\n        for row in rows:\n            w.writerow([row['geneID'], row[s]])\n    print(p, os.path.getsize(p))\n# sample sheet\np='tmp/sample_sheet.tsv'\nwith open(p,'w', newline='') as f:\n    w=csv.writer(f, delimiter='\\\\t', lineterminator='\\\\n')\n    w.writerow(['sample','condition'])\n    for s in samples:\n        w.writerow([s, s[:2]])\nprint(p, os.path.getsize(p))\nPY\nhead -3 tmp/samples/KL1.tsv; cat tmp/sample_sheet.tsv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
