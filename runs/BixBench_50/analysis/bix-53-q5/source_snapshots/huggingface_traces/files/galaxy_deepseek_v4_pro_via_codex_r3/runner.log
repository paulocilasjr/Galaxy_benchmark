oscounts' estimator deals with a gene with                         some zeros, by calculating a modified geometric mean by taking the n-th root of the product of the non-zero counts. This evolved out of                         use cases with Paul McMurdie's phyloseq package for metagenomic samples. The 'iterate' estimator iterates between estimating the dispersion                         with a design of ~1, and finding a size factor vector by numerically optimizing the likelihood of the ~1 model.\", 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Method for estimateSizeFactors', 'model_class': 'SelectToolParameter', 'multiple': False, 'name': 'esf', 'optional': False, 'options': [['No Selection (use default)', '', True], ['ratio', 'ratio', False], ['poscounts', 'poscounts', False], ['iterate', 'iterate', False], ['User-provided', 'user', False]], 'refresh_on_change': True, 'text_value': 'No Selection (use default)', 'textable': False, 'type': 'select', 'value': ''}, 'type': 'conditional'}, {'argument': None, 'default_value': '1', 'display': None, 'help': '', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Fit type', 'model_class': 'SelectToolParameter', 'multiple': False, 'name': 'fit_type', 'optional': False, 'options': [['parametric', '1', True], ['local', '2', False], ['mean', '3', False]], 'refresh_on_change': False, 'text_value': 'parametric', 'textable': False, 'type': 'select', 'value': '1'}, {'argument': None, 'default_value': False, 'falsevalue': '', 'help': 'When there are more than 6 replicates for a given sample, the DESeq2 will automatically replace                     counts with large Cook’s distance with the trimmed mean over all samples, scaled up by the size factor                     or normalization factor for that sample', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Turn off outliers replacement (only affects with >6 replicates)', 'model_class': 'BooleanToolParameter', 'name': 'outlier_replace_off', 'optional': False, 'refresh_on_change': False, 'text_value': 'False', 'truevalue': '-a', 'type': 'boolean', 'value': False}, {'argument': None, 'default_value': False, 'falsevalue': '', 'help': 'When there are more than 2 replicates for a given sample, the DESeq2 will automatically                     filter genes which contain a Cook’s distance above a cutoff', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Turn off outliers filtering (only affects with >2 replicates)', 'model_class': 'BooleanToolParameter', 'name': 'outlier_filter_off', 'optional': False, 'refresh_on_change': False, 'text_value': 'False', 'truevalue': '-b', 'type': 'boolean', 'value': False}, {'argument': None, 'default_value': False, 'falsevalue': '', 'help': ' DESeq2 performs independent filtering by default using the mean of normalized counts as a filter statistic', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Turn off independent filtering', 'model_class': 'BooleanToolParameter', 'name': 'auto_mean_filter_off', 'optional': False, 'refresh_on_change': False, 'text_value': 'False', 'truevalue': '-c', 'type': 'boolean', 'value': False}, {'cases': [{'inputs': [{'area': False, 'argument': None, 'datalist': [], 'default_value': '10', 'help': 'Keep only rows that have at least N reads total.', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Pre-filter value', 'max': None, 'min': 0, 'model_class': 'IntegerToolParameter', 'name': 'prefilter_value', 'optional': False, 'refresh_on_change': False, 'text_value': '10', 'type': 'integer', 'value': '10'}], 'model_class': 'ConditionalWhen', 'value': '-P'}, {'inputs': [], 'model_class': 'ConditionalWhen', 'value': ''}], 'model_class': 'Conditional', 'name': 'prefilter_conditional', 'test_param': {'argument': None, 'display': None, 'help': 'While it is not necessary to pre-filter                     low count genes before running the DESeq2 functions, there are two reasons which make pre-filtering useful:                     by removing rows in which there are very few reads, we reduce the required memory, and we increase the speed.                     It can also improve visualizations, as features with no information for differential expression are not plotted.', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Perform pre-filtering', 'model_class': 'SelectToolParameter', 'multiple': False, 'name': 'prefilter', 'optional': False, 'options': [['Enabled', '-P', False], ['Disabled', '', True]], 'refresh_on_change': True, 'text_value': 'Disabled', 'textable': False, 'type': 'select', 'value': ''}, 'type': 'conditional'}, {'argument': None, 'default_value': False, 'falsevalue': '', 'help': 'Whether or not to put a zero-mean normal prior on the non-intercept coefficients', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Use beta priors', 'model_class': 'BooleanToolParameter', 'name': 'use_beta_priors', 'optional': False, 'refresh_on_change': False, 'text_value': 'False', 'truevalue': '-d', 'type': 'boolean', 'value': False}, {'argument': None, 'default_value': 'none', 'display': None, 'help': '', 'help_format': 'html', 'hidden': False, 'is_dynamic': False, 'label': 'Log2 fold-change shrinkage after DESeq2', 'model_class': 'SelectToolParameter', 'multiple': False, 'name': 'lfc_shrinkage_type', 'optional': False, 'options': [['Do not apply lfcShrink', 'none', True], ['DESeq2 lfcShrink: normal', 'normal', False], ['DESeq2 lfcShrink: apeglm', 'apeglm', False], ['DESeq2 lfcShrink: ashr', 'ashr', False]], 'refresh_on_change': False, 'text_value': 'Do not apply lfcShrink', 'textable': False, 'type': 'select', 'value': 'none'}], 'model_class': 'Section', 'name': 'advanced_options', 'title': 'Advanced options', 'type': 'section'}, {'expanded': False, 'help': None, 'inputs': [{'argument': None, 'default_value': 'pdf', 'display': 'checkboxes', 'help': '', 'help_format': 'html', 'hidden': False,