e=\"factorLevel\" value=\"Untreated\"/>\n618:            <param name=\"select_data|countsFile\">\n628:            <repeat name=\"rep_factorName\">\n629:                <param name=\"factorName\" value=\"Treatment\"/>\n630:                <repeat name=\"rep_factorLevel\">\n631:                    <param name=\"factorLevel\" value=\"Treated\"/>\n634:                <repeat name=\"rep_factorLevel\">\n635:                    <param name=\"factorLevel\" value=\"Untreated\"/>\n659:            <repeat name=\"rep_factorName\">\n660:                <param name=\"factorName\" value=\"Treatment\"/>\n661:                <repeat name=\"rep_factorLevel\">\n662:                    <param name=\"factorLevel\" value=\"Treated\"/>\n663:                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n665:                <repeat name=\"rep_factorLevel\">\n666:                    <param name=\"factorLevel\" value=\"Untreated\"/>\n667:                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n689:            <repeat name=\"rep_factorName\">\n","exit_code":0,"status":"completed"}}
