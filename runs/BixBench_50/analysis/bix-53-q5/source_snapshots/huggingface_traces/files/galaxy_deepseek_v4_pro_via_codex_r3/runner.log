{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, json, time\nfrom bioblend.galaxy import GalaxyInstance\nwith open(os.environ['GALAXY_API_KEY_FILE']) as f: key=f.read().strip()\ngi=GalaxyInstance(url=os.environ['GALAXY_URL'], key=key)\nhid='bbd44e69cb8906b52a649076d93210d7'\nfiles={\n 'KL1':'tmp/samples/KL1.tsv',\n 'KL2':'tmp/samples/KL2.tsv',\n 'KL3':'tmp/samples/KL3.tsv',\n 'WL1':'tmp/samples/WL1.tsv',\n 'WL2':'tmp/samples/WL2.tsv',\n 'WL3':'tmp/samples/WL3.tsv',\n 'sample_sheet':'tmp/sample_sheet.tsv',\n}\nids={}\nfor name,path in files.items():\n    print('uploading',name)\n    res=gi.tools.upload_file(path, hid, file_name=name, file_type='tabular', space_to_tab=False, to_posix_lines=True)\n    # output structure\n    out=None\n    for o in res.get('outputs',[]):\n        if o.get('name')==name or True:\n            out=o; break\n    print(json.dumps(res, indent=2)[:2000])\n    dsid=res.get('outputs',[{}])[0].get('id')\n    if not dsid:\n        # maybe job output\n        print(res)\n        raise SystemExit('no id')\n    ids[name]=dsid\nprint('IDS',json.dumps(ids, indent=2))\n# Wait until all ok\nfor name,dsid in ids.items():\n    for i in range(120):\n        ds=gi.datasets.show_dataset(dsid)\n        if ds['state']=='ok':\n            print(name, dsid, 'ok')\n            break\n        if ds['state']=='error':\n            print(name,'error',ds); raise SystemExit('upload error')\n        time.sleep(2)\n    else:\n        print(name,'timeout')\n# save ids\nwith open('tmp/upload_ids.json','w') as f: json.dump(ids,f)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
