{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url=os.environ['GALAXY_URL'], key=key)\nfor label, ds in [('apeglm','f9cad7b01a472135df2a05dfc85b3bb0'),('ashr','f9cad7b01a472135404f1022a31949c2')]:\n    text=gi.datasets.download_dataset(ds).decode('utf-8', errors='replace')\n    lines=text.splitlines()\n    syms=[]; seen=set()\n    for line in lines[1:]:\n        p=line.split('\\\\t')\n        if len(p)<2: continue\n        s=p[1].strip()\n        if s and s not in seen:\n            seen.add(s); syms.append(s)\n    path=f'/workspace/tmp/sig_symbols_{label}.txt'\n    with open(path,'w') as f:\n        for s in syms: f.write(s+'\\\\n')\n    print(label, 'unique symbols', len(syms))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
