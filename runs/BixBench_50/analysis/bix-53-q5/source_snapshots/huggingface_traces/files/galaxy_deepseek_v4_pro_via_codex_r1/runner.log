{"type":"item.started","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, math\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url=os.environ['GALAXY_URL'], key=key)\nds='f9cad7b01a4721351c1d5f1015e5b01d'\ntext=gi.datasets.download_dataset(ds).decode('utf-8', errors='replace')\nrows=[]\nfor line in text.splitlines():\n    parts=line.split('\\\\t')\n    if len(parts)<6: continue\n    gid=parts[0]\n    def f(s):\n        s=s.strip()\n        if s in ('NA',''): return None\n        try:return float(s)\n        except:return None\n    vals=[f(x) for x in parts[1:6]]\n    rows.append((gid,)+tuple(vals))\nbase_mean_idx=1; lfc_idx=2; p_idx=4\nsig=[]\nfor r in rows:\n    bm=r[base_mean_idx]; lfc=r[lfc_idx]; p=r[p_idx]\n    if bm is None or lfc is None or p is None: continue\n    if p<0.05 and abs(lfc)>1 and bm>10:\n        sig.append(r)\nprint('total rows', len(rows), 'sig', len(sig))\nprint('first 10 sig')\nfor r in sig[:10]: print(r)\n# save gene IDs\nos.makedirs('/workspace/tmp', exist_ok=True)\nwith open('/workspace/tmp/sig_ensembl_ids.txt','w') as f:\n    for r in sig:\n        f.write(r[0]+'\\\\n')\nprint('wrote', len(sig))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
