{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, csv, io\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url=os.environ['GALAXY_URL'], key=key)\nds='f9cad7b01a4721359cc256cbe09d3718'\ntext=gi.datasets.download_dataset(ds).decode('utf-8', errors='replace')\nrows=list(csv.DictReader(io.StringIO(text), delimiter='\\\\t'))\nprint('num rows', len(rows))\nfor sortkey, rev in [('p_value',False),('adjusted_p_value',False),('combined_score',True)]:\n    def key(r):\n        v=float(r[sortkey])\n        return (-v if rev else v)\n    s=sorted(rows, key=key)[:20]\n    print('\\\\n', sortkey, 'rev', rev)\n    for r in s:\n        print(r['rank'], r['term'], r['p_value'], r['adjusted_p_value'], r['combined_score'])\n    ox=[r for r in s if 'oxidative' in r['term'].lower()]\n    print('ox count', len(ox), [r['term'] for r in ox])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
