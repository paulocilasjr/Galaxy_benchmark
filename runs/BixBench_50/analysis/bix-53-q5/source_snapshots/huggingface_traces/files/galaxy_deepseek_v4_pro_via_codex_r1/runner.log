{"type":"item.started","item":{"id":"item_115","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url=os.environ['GALAXY_URL'], key=key)\nfor label, ds in [('normal','f9cad7b01a4721351c1d5f1015e5b01d'),('apeglm','f9cad7b01a47213555d8958e31bef570'),('ashr','f9cad7b01a472135ff67b81701ebbf62')]:\n    text=gi.datasets.download_dataset(ds).decode('utf-8', errors='replace')\n    sig=[]\n    for line in text.splitlines():\n        p=line.split('\\\\t')\n        if len(p)<6: continue\n        def f(s):\n            s=s.strip()\n            if s in ('NA',''): return None\n            try:return float(s)\n            except:return None\n        bm=f(p[1]); lfc=f(p[2]); pv=f(p[4])\n        if bm is None or lfc is None or pv is None: continue\n        if pv<0.05 and abs(lfc)>1 and bm>10: sig.append(p[0])\n    print(label, 'sig', len(sig))\n    # write for later if needed\n    with open(f'/workspace/tmp/sig_ensembl_ids_{label}.txt','w') as f:\n        for g in sig: f.write(g+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
