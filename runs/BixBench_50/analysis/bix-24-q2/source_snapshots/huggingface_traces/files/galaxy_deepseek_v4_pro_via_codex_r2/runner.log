{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, os\nsrc='/workspace/tmp/stage/counts_raw_unfiltered.csv'\noutdir='/workspace/tmp/stage/samples'\nos.makedirs(outdir, exist_ok=True)\nwith open(src, newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n    # header: first empty gene id then sample columns like 7_1\n    colmap={name:i for i,name in enumerate(header)}\n    samples={'3-1':'3_1','3-2':'3_2','3-3':'3_3','7-1':'7_1','7-2':'7_2','7-3':'7_3'}\n    handles={}\n    writers={}\n    for sid,col in samples.items():\n        path=os.path.join(outdir, f'counts_{sid}.tabular')\n        handles[sid]=open(path,'w',newline='')\n        handles[sid].write(f'Geneid\\\\t{sid}\\\\n')\n    for row in r:\n        gene=row[0].strip('\\\"')\n        for sid,col in samples.items():\n            handles[sid].write(f'{gene}\\\\t{row[colmap[col]]}\\\\n')\n    for h in handles.values():\n        h.close()\n# sample sheet\nwith open('/workspace/tmp/stage/sample_sheet.tsv','w') as f:\n    f.write('SampleID\\\\tGroup\\\\n')\n    for sid in ['3-1','3-2','3-3','7-1','7-2','7-3']:\n        grp='DMSO' if sid.startswith('3-') else 'CBD_IC50'\n        f.write(f'{sid}\\\\t{grp}\\\\n')\nprint('created')\nfor p in sorted(os.listdir(outdir)):\n    print(p, sum(1 for _ in open(os.path.join(outdir,p)))-1)\nPY\nhead -3 /workspace/tmp/stage/samples/counts_3-1.tabular; cat /workspace/tmp/stage/sample_sheet.tsv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
