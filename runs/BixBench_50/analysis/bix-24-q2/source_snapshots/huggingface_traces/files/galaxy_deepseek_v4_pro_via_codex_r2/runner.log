hen\",\n                \"value\": \"gtf\",\n                \"inputs\": [\n                  {\n                    \"model_class\": \"DataToolParameter\",\n                    \"name\": \"gtf_file\",\n                    \"argument\": null,\n                    \"type\": \"data\",\n                    \"label\": \"GTF/GFF3 annotation file\",\n                    \"help\": \"\",\n                    \"help_format\": \"html\",\n                    \"refresh_on_change\": true,\n                    \"optional\": false,\n                    \"hidden\": false,\n                    \"is_dynamic\": false,\n                    \"value\": null,\n                    \"extensions\": [\n                      \"gtf\",\n                      \"gff3\"\n                    ],\n                    \"edam\": {\n                      \"edam_formats\": [\n                        \"format_2306\",\n                        \"format_1975\"\n                      ],\n                      \"edam_data\": [\n                        \"data_1255\",\n                        \"data_1255\"\n                      ]\n                    },\n                    \"multiple\": false,\n                    \"tag\": null,\n                    \"options\": {\n                      \"dce\": [],\n                      \"ldda\": [],\n                      \"hda\": [],\n                      \"hdca\": []\n                    },\n                    \"pinned\": {\n                      \"dce\": [],\n                      \"ldda\": [],\n                      \"hda\": [],\n                      \"hdca\": []\n                    },\n                    \"options_meta\": {}\n                  }\n                ]\n              },\n              {\n                \"model_class\": \"ConditionalWhen\",\n                \"value\": \"tabular\",\n                \"inputs\": [\n                  {\n                    \"model_class\": \"DataToolParameter\",\n                    \"name\": \"tabular_file\",\n            