{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport csv, io, os\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b576e508585c90cfae'\nids={\n 'up_full':'f9cad7b01a472135642312f22fef4b87',\n 'down_sig':'f9cad7b01a472135c18270e1d4130bd5',\n}\nfor label,dsid in ids.items():\n    text=gi.datasets.download_dataset(dsid)\n    path=f'/workspace/tmp/stage/gprofiler_{label}.tsv'\n    open(path,'wb').write(text)\n    print(label,path,len(text))\nPY\npython3 - <<'PY'\nimport csv\nmetabolic_keywords=['metabolic','metabolism','catabolic','biosynthetic','biosynthesis','glycolysis','oxidation','lipid','carbohydrate','glucose','energy','mitochondri','respiratory','fatty acid','amino acid','nucleotide','steroid','cholesterol','drug','xenobiotic','detox']\nfor label in ['up_full','down_sig']:\n    path=f'/workspace/tmp/stage/gprofiler_{label}.tsv'\n    rows=[]\n    with open(path) as f:\n        r=csv.DictReader(f, delimiter='\\\\t')\n        for row in r:\n            rows.append(row)\n    print('\\\\n',label,'total rows',len(rows))\n    # print all rows with p<0.05 sorted\n    sig=[]\n    for row in rows:\n        try: p=float(row['p_value'])\n        except: continue\n        if p<0.05:\n            sig.append((p,row))\n    sig.sort()\n    print('significant p<0.05',len(sig))\n    for p,row in sig[:30]:\n        print(f'{p:.6g}\\\\t{row[\\\"term_id\\\"]}\\\\t{row[\\\"term_name\\\"]}')\n    met=[(p,row) for p,row in sig if any(k in row['term_name'].lower() for k in metabolic_keywords)]\n    print('metabolic sig count',len(met))\n    for p,row in met:\n        print(' METAB',f'{p:.6g}',row['term_id'],row['term_name'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
