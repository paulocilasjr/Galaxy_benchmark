{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\ntools=gi.tools.get_tools()\nkeys=['go','enrich','ora','pathway','gene ontology','ontolog','cluster','goseq','david','panther']\nseen=set()\nfor t in tools:\n    sid=(t.get('id','')+' '+t.get('name','')).lower()\n    if any(k in sid for k in keys):\n        key2=(t.get('id'),t.get('name'),t.get('version'))\n        if key2 not in seen:\n            seen.add(key2)\n            print(t.get('id'),'|',t.get('name'),'|',t.get('version'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
