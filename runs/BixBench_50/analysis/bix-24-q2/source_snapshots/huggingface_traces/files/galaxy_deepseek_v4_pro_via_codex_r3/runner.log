  </when>\n            <when value=\"datasets_per_level\">\n                <repeat name=\"rep_factorName\" title=\"Factor\" min=\"1\">\n            <param name=\"factorName\" type=\"text\" value=\"FactorName\" label=\"Specify a factor name, e.g. effects_drug_x or cancer_markers\" help=\"Only letters, numbers and underscores will be retained in this field\">\n                <sanitizer>\n                    <valid initial=\"string.letters,string.digits\"><add value=\"_\"/></valid>\n                </sanitizer>\n            </param>\n            <repeat name=\"rep_factorLevel\" title=\"Factor level\" min=\"2\" default=\"2\">\n                <param name=\"factorLevel\" type=\"text\" value=\"FactorLevel\" label=\"Specify a factor level, typical values could be 'tumor', 'normal', 'treated' or 'control'\" help=\"Only letters, numbers and underscores will be retained in this field\">\n                    <sanitizer>\n                        <valid initial=\"string.letters,string.digits\"><add value=\"_\"/></valid>\n                    </sanitizer>\n                </param>\n                <param name=\"countsFile\" type=\"data\" format=\"tabular\" multiple=\"true\" label=\"Counts file(s)\"/>\n                </repeat>\n        </repeat>\n    </when>\n            <when value=\"sample_sheet_contrasts\">\n                <param name=\"countsFile\" type=\"data_collection\" collection_type=\"list\" format=\"tabular,tsv\" label=\"Count file(s) collection\"/>\n                <param name=\"sample_sheet\" type=\"data\" format=\"tabular\" label=\"Sample sheet file\" help=\"A tabular file containing at least two columns: one with the element identifiers (matching those in the collection) and one or more columns with factor levels.\"/>\n                <conditional name=\"design_formula_mode\">\n                    <param name=\"mode\" type=\"select\" label=\"Design formula specification\">\n                        <option value=\"automatic\" selected=\"true\">Automatic (select factors from columns)</option>\n                        <option value=\"custom\">Custom design formula</option>\n                    </param>\n                    <when value=\"automatic\">\n                        <param name=\"factor\" type=\"data_column\" use_header_names=\"true\" data_ref=\"sample_sheet\" multiple=\"true\" optional=\"false\" label=\"Factor levels column(s)\" help=\"Select one or more columns from the sample sheet to define factor levels for DESeq2 analysis. First selected factor is the primary factor\"/>\n                        <param name=\"reference_level\" type=\"text\" label=\"Reference level for primary factor\" help=\"Specify the reference level for the primary factor. If left blank, the first encountered level of the primary factor will be used as reference.\" optional=\"true\"/>\n        <param name=\"target_level\" type=\"text\" label=\"Target level for primary factor\" help=\"Specify the target level for the primary factor. If left blank, all levels will be compared against the primary factor.\" optional=\"true\"/>\n    </when>\n                    <when value=\"custom\">\n                        <param name=\"design_formula\" type=\"text\" label=\"Design formula\" help=\"Specify the design formula using R formula syntax (e.g., '~ condition' or '~ batch + condition'). Column names must match those in the sample sheet. The last factor in the formula is used as the primary factor for contrasts.\">\n                            <validator type=\"regex\" message=\"Design formula must start with ~ and contain valid R variable names\">^~\\s*[a-zA-Z][a-zA-Z0-9_.]*(\\s*[+*:]\\s*[a-zA-Z][a-zA-Z0-9_.]*)*$</validator>\n                            <sanitizer>\n                                <valid initial=\"string.letters,string.digits\">\n                                    <add value=\"~\"/>\n                                    <add value=\":\"/>\n                                    <add value=\"+\"/>\n                                    <add value=\"*\"/>\n                                    <add value=\"_\"/>\n                                    <add value=\".\"/>\n                                    <add value=\" \"/>\n                                </valid>\n                            </sanitizer>\n                        </param>\n                        <param name=\"reference_level\" type=\"text\" label=\"Reference level for primary factor\" help=\"Specify the reference level for the primary factor. If left blank, the first encountered level of the primary factor will be used as reference.\" optional=\"true\"/>\n        <param name=\"target_level\" type=\"text\" label=\"Target level for primary factor\" help=\"Specify the target level for the primary factor. If left blank, all levels will be compared against the primary factor.\" optional=\"true\"/>\n    </when>\n                </conditional>\n            </when>\n        </conditional>\n\n        <param name=\"batch_factors\" type=\"data\" format=\"tabular\" optional=\"true\" label=\"(Optional) provide a tabular file with additional batch factors to include in the model.\" help=\"You can produce this file using RUVSeq or svaseq.\"/>\n        <param name=\"header\" type=\"boolean\" truevalue=\"-H\" falsevalue=\"\" checked=\"true\" label=\"Files have header?\" help=\"If this option is set to Yes, the tool will assume that the count files have column headers in the first row. Default: Yes\"/>\n\n        <conditional name=\"tximport\">\n            <param name=\"tximport_selector\" type=\"select\" label=\"Choice of Input data\">\n                <option value=\"count\" selected=\"True\">Count data (e.g. from HTSeq-count, featureCounts or StringTie)</option>\n                <option value=\"tximport\">TPM values (e.g. from kallisto, sailfish or salmon)</option>\n            </param>\n            <when value=\"tximport\">\n                <param name=\"txtype\" type=\"select\" label=\"Program used to generate TPMs\">\n                    <option value=\"kallisto\">kallisto</option>\n                    <option value=\"sailfish\">Sailfish</option>\n                    <option value=\"salmon\">Salmon</option>\n                </param>\n                <conditional name=\"mapping_format\">\n                    <param name=\"mapping_format_selector\" type=\"select\" label=\"Gene mapping format\">\n                        <option value=\"gtf\" selected=\"True\">GTF/GFF3</option>\n                        <option value=\"tabular\">Transcript-ID to Gene-ID mapping file</option>\n                    </param>\n                    <when value=\"gtf\">\n                        <param name=\"gtf_file\" type=\"data\" format=\"gtf,gff3\" label=\"GTF/GFF3 annotation file\"/>\n                    </when>\n                    <when value=\"tabular\">\n                        <param name=\"tabular_file\" type=\"data\" format=\"tabular\" label=\"Tabular file with Transcript-ID to Gene-ID mapping\"/>\n                    </when>\n                </conditional>\n            </when>\n            <when value=\"count\"/>\n        </conditional>\n        <section name=\"advanced_options\" title=\"Advanced options\">\n            <conditional name=\"esf_cond\">\n                <param name=\"esf\" type=\"select\" label=\"Method for estimateSizeFactors\" help=\"Method for estimation: either 'ratio', 'poscounts', or 'iterate'. 'ratio' uses the standard median ratio method introduced in DESeq.                         The size factor is the median ratio of the sample over a 'pseudosample': for each gene, the geometric mean of all samples.                         'poscounts' and 'iterate' offer alternative estimators, which can be used even when all genes contain a sample with a zero (a problem                         for the default method, as the geometric mean becomes zero, and the ratio undefined). The 'poscounts' estimator deals with a gene with                         some zeros, by calculating a modified geometric mean by taking the n-th root of the product of the non-zero counts. This evolved out of                         use cases with Paul McMurdie's phyloseq package for metagenomic samples. The 'iterate' estimator iterates between estimating the dispersion                         with a design of ~1, and finding a size factor vector by numerically optimizing the likelihood of the ~1 model.\">\n                    <option value=\"\" selected=\"true\">No Selection (use default)</option>\n                    <option value=\"ratio\">ratio</option>\n                    <option value=\"poscounts\">poscounts</option>\n                    <option value=\"iterate\">iterate</option>\n                    <option value=\"user\">User-provided</option>\n                </param>\n                <when value=\"\"/>\n                <when value=\"ratio\"/>\n                <when value=\"poscounts\"/>\n                <when value=\"iterate\"/>\n                <when value=\"user\">\n                    <param name=\"size_factor_input\" type=\"data\" format=\"tabular\" label=\"File with custom size factors\" help=\"The input must be a 2-column file: col1 should have the input file names. Col2 should contain your custom size factors.\"/>\n                </when>\n            </conditional>\n            <param name=\"fit_type\" type=\"select\" label=\"Fit type\">\n                <option value=\"1\" selected=\"true\">parametric</option>\n                <option value=\"2\">local</option>\n                <option value=\"3\">mean</option>\n            </param>\n            <param name=\"outlier_replace_off\" type=\"boolean\" truevalue=\"-a\" falsevalue=\"\" checked=\"false\" label=\"Turn off outliers replacement (only affects with &gt;6 replicates)\" help=\"When there are more than 6 replicates for a given sample, the DESeq2 will automatically replace                     counts with large Cook’s distance with the trimmed mean over all samples, scaled up by the size factor                     or normalization factor for that sample\"/>\n            <param name=\"outlier_filter_off\" type=\"boolean\" truevalue=\"-b\" falsevalue=\"\" checked=\"false\" label=\"Turn off outliers filtering (only affects with &gt;2 replicates)\" help=\"When there are more than 2 replicates for a given sample, the DESeq2 will automatically                     filter genes which contain a Cook’s distance above a cutoff\"/>\n            <param name=\"auto_mean_filter_off\" type=\"boolean\" truevalue=\"-c\" falsevalue=\"\" checked=\"false\" label=\"Turn off independent filtering\" help=\" DESeq2 performs independent filtering by default using the mean of normalized counts as a filter statistic\"/>\n            <conditional name=\"prefilter_conditional\">\n                <param name=\"prefilter\" type=\"select\" label=\"Perform pre-filtering\" help=\"While it is not necessary to pre-filter                     low count genes before running the DESeq2 functions, there are two reasons which make pre-filtering useful:                     by removing rows in which there are very few reads, we reduce the required memory, and we increase the speed.                     It can also improve visualizations, as features with no information for differential expression are not plotted.\">\n                    <option value=\"-P\">Enabled</option>\n                    <option value=\"\" selected=\"true\">Disabled</option>\n                </param>\n                <when value=\"-P\">\n                    <param name=\"prefilter_value\" type=\"integer\" min=\"0\" value=\"10\" label=\"Pre-filter value\" help=\"Keep only rows that have at least N reads total.\"/>\n                </when>\n                <when value=\"\"/>\n            </conditional>\n            <param name=\"use_beta_priors\" type=\"boolean\" truevalue=\"-d\" falsevalue=\"\" checked=\"false\" label=\"Use beta priors\" help=\"Whether or not to put a zero-mean normal prior on the non-intercept coefficients\"/>\n            <param name=\"lfc_shrinkage_type\" type=\"select\" label=\"Log2 fold-change shrinkage after DESeq2\">\n                <option value=\"none\" selected=\"true\">Do not apply lfcShrink</option>\n                <option value=\"normal\">DESeq2 lfcShrink: normal</option>\n                <option value=\"apeglm\">DESeq2 lfcShrink: apeglm</option>\n                <option value=\"ashr\">DESeq2 lfcShrink: ashr</option>\n            </param>\n        </section>\n        <section name=\"output_options\" title=\"Output options\">\n            <param name=\"output_selector\" type=\"select\" multiple=\"True\" optional=\"true\" display=\"checkboxes\" label=\"Output selector\">\n                <option value=\"pdf\" selected=\"True\">Generate plots for visualizing the analysis results (rlog for up to 30 samples; VST for larger datasets)</option>\n                <option value=\"sizefactors\">Output sample size factors</option>\n                <option value=\"normCounts\">Output normalised counts</option>\n                <option value=\"normVST\">Output VST normalized table</option>\n                <option value=\"normRLog\">Output rLog normalized table</option>\n                <option value=\"many_contrasts\">Output all levels vs all levels of primary factor (use when you have &gt;2 levels for primary factor)</option>\n            </param>\n            <param name=\"alpha_ma\" type=\"float\" min=\"0\" max=\"0.5\" value=\"0.1\" label=\"Alpha value for MA-plot\" help=\"Default value is 0.1. This option is only meaninful when plots are generated\"/>\n        </section>\n    </inputs>\n    <outputs>\n        <data name=\"deseq_out\" format=\"tabular\" label=\"DESeq2 result file on ${on_string}\">\n            <filter>'many_contrasts' not in output_options['output_selector']</filter>\n            <actions>\n                <conditional name=\"advanced_options.lfc_shrinkage_type\">\n                    <when value=\"none\">\n                        <action name=\"column_names\" type=\"metadata\" default=\"GeneID,Base mean,log2(FC),StdErr,Wald-Stats,P-value,P-adj\"/>\n                    </when>\n                    <when value=\"normal\">\n                        <action name=\"column_names\" type=\"metadata\" default=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                    </when>\n                    <when value=\"apeglm\">\n                        <action name=\"column_names\" type=\"metadata\" default=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                    </when>\n                    <when value=\"ashr\">\n                        <action name=\"column_names\" type=\"metadata\" default=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                    </when>\n                </conditional>\n            </actions>\n        </data>\n        <collection name=\"split_output\" type=\"list\" label=\"DESeq2 result files on ${on_string}\">\n            <filter>output_options['output_selector'] and 'many_contrasts' in output_options['output_selector']</filter>\n            <discover_datasets pattern=\"(?P&lt;designation&gt;.+_vs_.+)\" format=\"tabular\" directory=\".\" visible=\"false\"/>\n        </collection>\n        <data name=\"plots\" format=\"pdf\" label=\"DESeq2 plots on ${on_string}\">\n            <filter>output_options['output_selector'] and 'pdf' in output_options['output_selector']</filter>\n        </data>\n        <data name=\"sizefactors_out\" format=\"tabular\" label=\"Size Factors on ${on_string}\">\n            <filter>output_options['output_selector'] and 'sizefactors' in output_options['output_selector']</filter>\n        </data>\n        <data name=\"counts_out\" format=\"tabular\" label=\"Normalized counts file on ${on_string}\">\n            <filter>output_options['output_selector'] and 'normCounts' in output_options['output_selector']</filter>\n        </data>\n        <data name=\"rlog_out\" format=\"tabular\" label=\"rLog-Normalized counts file on ${on_string}\">\n            <filter>output_options['output_selector'] and 'normRLog' in output_options['output_selector']</filter>\n        </data>\n        <data name=\"vst_out\" format=\"tabular\" label=\"VST-Normalized counts file on ${on_string}\">\n            <filter>output_options['output_selector'] and 'normVST' in output_options['output_selector']</filter>\n        </data>\n    </outputs>\n    <tests>\n        \n        <test expect_num_outputs=\"4\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"GSM461179_treat_single.counts,GSM461180_treat_paired.counts,GSM461181_treat_paired.counts\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"GSM461176_untreat_single.counts,GSM461177_untreat_paired.counts,GSM461178_untreat_paired.counts,GSM461182_untreat_single.counts\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts,normRLog,normVST\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts\\tGSM461177_untreat_paired.counts\\tGSM461178_untreat_paired.counts\\tGSM461182_untreat_single.counts\\tGSM461179_treat_single.counts\\tGSM461180_treat_paired.counts\\tGSM461181_treat_paired.counts\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"rlog_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts\\tGSM461177_untreat_paired.counts\\tGSM461178_untreat_paired.counts\\tGSM461182_untreat_single.counts\\tGSM461179_treat_single.counts\\tGSM461180_treat_paired.counts\\tGSM461181_treat_paired.counts\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"vst_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts\\tGSM461177_untreat_paired.counts\\tGSM461178_untreat_paired.counts\\tGSM461182_untreat_single.counts\\tGSM461179_treat_single.counts\\tGSM461180_treat_paired.counts\\tGSM461181_treat_paired.counts\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"FBgn0003360\\t1933\\.9504.*\\t-2\\.8399.*\\t0\\.1309.*\\t-21\\.68.*\\t.*e-104\\t.*e-101\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"GSM461179_treat_single.counts,GSM461180_treat_paired.counts,GSM461181_treat_paired.counts\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"GSM461176_untreat_single.counts,GSM461177_untreat_paired.counts,GSM461178_untreat_paired.counts,GSM461182_untreat_single.counts\"/>\n                </repeat>\n            </repeat>\n            <param name=\"batch_factors\" value=\"batch_factors.tab\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"FBgn0003360\\t1933.*\\t-2.9.*\\t0.1.*\\t-26.*\\t1.*-152\\t4.*-149\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"GSM461179_treat_single.counts,GSM461180_treat_paired.counts,GSM461181_treat_paired.counts\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"GSM461176_untreat_single.counts,GSM461177_untreat_paired.counts,GSM461178_untreat_paired.counts,GSM461182_untreat_single.counts\"/>\n                </repeat>\n            </repeat>\n            <param name=\"batch_factors\" value=\"batch_factors.tab\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"FBgn0003360\\t1933.*\\t-3.*\\t0.1.*\\t-26.*\\t6.*-151\\t1.*-147\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"4\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"GSM461179_treat_single.counts.noheader,GSM461180_treat_paired.counts.noheader,GSM461181_treat_paired.counts.noheader\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"GSM461176_untreat_single.counts.noheader,GSM461177_untreat_paired.counts.noheader,GSM461178_untreat_paired.counts.noheader,GSM461182_untreat_single.counts.noheader\"/>\n                </repeat>\n            </repeat>\n            <param name=\"header\" value=\"False\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts,normRLog,normVST\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts.noheader\\tGSM461177_untreat_paired.counts.noheader\\tGSM461178_untreat_paired.counts.noheader\\tGSM461182_untreat_single.counts.noheader\\tGSM461179_treat_single.counts.noheader\\tGSM461180_treat_paired.counts.noheader\\tGSM461181_treat_paired.counts.noheader\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"rlog_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts.noheader\\tGSM461177_untreat_paired.counts.noheader\\tGSM461178_untreat_paired.counts.noheader\\tGSM461182_untreat_single.counts.noheader\\tGSM461179_treat_single.counts.noheader\\tGSM461180_treat_paired.counts.noheader\\tGSM461181_treat_paired.counts.noheader\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"vst_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts.noheader\\tGSM461177_untreat_paired.counts.noheader\\tGSM461178_untreat_paired.counts.noheader\\tGSM461182_untreat_single.counts.noheader\\tGSM461179_treat_single.counts.noheader\\tGSM461180_treat_paired.counts.noheader\\tGSM461181_treat_paired.counts.noheader\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\\t5.*\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"FBgn0003360\\t1933\\.9504.*\\t-2\\.8399.*\\t0\\.1309.*\\t-21\\.68.*\\t.*e-104\\t.*e-101\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish/sailfish_quant.sf1.tab,sailfish/sailfish_quant.sf2.tab,sailfish/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish/sailfish_quant.sf4.tab,sailfish/sailfish_quant.sf5.tab,sailfish/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"tabular\"/>\n            <param name=\"tabular_file\" value=\"tx2gene.tab\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"UGT3A2\\t1.8841.*\\t-0.1329.*\\t0.6936.*\\t-0.1917.*\\t0.8479.*\\t0.9999.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish/sailfish_quant.sf1.tab,sailfish/sailfish_quant.sf2.tab,sailfish/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish/sailfish_quant.sf4.tab,sailfish/sailfish_quant.sf5.tab,sailfish/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"GRCh38_latest_genomic.gff\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"UGT3A2\\t1.8841.*\\t-0.1329.*\\t0.6936.*\\t-0.1917.*\\t0.8479.*\\t0.9999.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"Homo_sapiens.GRCh38.94.gtf\" ftype=\"gtf\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"ENSG00000168671\\t1.8841.*\\t-0.1180.*\\t0.7429.*\\t-0.1589.*\\t0.8737.*\\t0.9999.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <param name=\"select_data|how\" value=\"group_tags\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"1\" value=\"sailfish/sailfish_quant.sf1.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"2\" value=\"sailfish/sailfish_quant.sf2.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"3\" value=\"sailfish/sailfish_quant.sf3.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"4\" value=\"sailfish/sailfish_quant.sf4.tab\" tags=\"group:primary:untreated\"/>\n                    <element name=\"5\" value=\"sailfish/sailfish_quant.sf5.tab\" tags=\"group:primary:untreated\"/>\n                    <element name=\"6\" value=\"sailfish/sailfish_quant.sf6.tab\" tags=\"group:primary:untreated\"/>\n                </collection>\n            </param>\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"groups\" value=\"primary:treated\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"groups\" value=\"primary:untreated\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"tabular\"/>\n            <param name=\"tabular_file\" value=\"tx2gene.tab\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"HOXC11\\t0.557.*\\t0.324.*\\t0.437.*\\t0.741.*\\t0.458.*\\t0.999.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <param name=\"select_data|how\" value=\"group_tags\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"1\" value=\"sailfish/sailfish_quant.sf1.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"2\" value=\"sailfish/sailfish_quant.sf2.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"3\" value=\"sailfish/sailfish_quant.sf3.tab\" tags=\"group:primary:treated\"/>\n                    <element name=\"4\" value=\"sailfish/sailfish_quant.sf4.tab\" tags=\"group:primary:untreated\"/>\n                    <element name=\"5\" value=\"sailfish/sailfish_quant.sf5.tab\" tags=\"group:primary:untreated\"/>\n                    <element name=\"6\" value=\"sailfish/sailfish_quant.sf6.tab\" tags=\"group:primary:untreated\"/>\n                </collection>\n            </param>\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"groups\" value=\"primary:treated\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"groups\" value=\"primary:untreated\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"many_contrasts\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"tabular\"/>\n            <param name=\"tabular_file\" value=\"tx2gene.tab\"/>\n            <output_collection name=\"split_output\" type=\"list\" count=\"1\">\n                <element name=\"Treatment_Treated_vs_Untreated\">\n                    <assert_contents>\n                        <has_text_matching expression=\"HOXC11\\t0.557.*\\t0.324.*\\t0.437.*\\t0.741.*\\t0.458.*\\t0.999.*\"/>\n                    </assert_contents>\n                </element>\n            </output_collection>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n                <param name=\"alpha_ma\" value=\"0.05\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"Homo_sapiens.GRCh38.94.gtf\" ftype=\"gtf\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"ENSG00000168671\\t1.8841.*\\t-0.1180.*\\t0.7429.*\\t-0.1589.*\\t0.8737.*\\t0.9999.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"sizefactors\"/>\n                <param name=\"alpha_ma\" value=\"0.05\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"Homo_sapiens.GRCh38.94.gtf\" ftype=\"gtf\"/>\n            <output name=\"sizefactors_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"sailfish_quant\\.sf4\\.tab\\t0\\.8\\d+\"/>\n                    <has_text_matching expression=\"sailfish_quant\\.sf3\\.tab\\t1\\.0\\d+\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"1\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n                <conditional name=\"esf_cond\">\n                    <param name=\"esf\" value=\"user\"/>\n                    <param name=\"size_factor_input\" value=\"size_factors_out.tsv\"/>\n                </conditional>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"\"/>\n                <param name=\"alpha_ma\" value=\"0.05\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"Homo_sapiens.GRCh38.94.gtf\" ftype=\"gtf\"/>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"ENSG00000168671\\t1.90.*\\t-0.05.*\\t0.75.*\\t-0.07.*\\t0.94.*\\t0.95.*\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf1.tab,sailfish_ensembl/sailfish_quant.sf2.tab,sailfish_ensembl/sailfish_quant.sf3.tab\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"sailfish_ensembl/sailfish_quant.sf4.tab,sailfish_ensembl/sailfish_quant.sf5.tab,sailfish_ensembl/sailfish_quant.sf6.tab\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <param name=\"esf\" value=\"poscounts\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"sizefactors\"/>\n                <param name=\"alpha_ma\" value=\"0.05\"/>\n            </section>\n            <param name=\"tximport_selector\" value=\"tximport\"/>\n            <param name=\"txtype\" value=\"sailfish\"/>\n            <param name=\"mapping_format_selector\" value=\"gtf\"/>\n            <param name=\"gtf_file\" value=\"Homo_sapiens.GRCh38.94.gtf\" ftype=\"gtf\"/>\n            <output name=\"sizefactors_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"sailfish_quant\\.sf4\\.tab\\t0\\.8\\d+\"/>\n                    <has_text_matching expression=\"sailfish_quant\\.sf3\\.tab\\t1\\.0\\d+\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <repeat name=\"rep_factorName\">\n                <param name=\"factorName\" value=\"Treatment\"/>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Treated\"/>\n                    <param name=\"countsFile\" value=\"GSM461179_treat_single.counts,GSM461180_treat_paired.counts,GSM461181_treat_paired.counts\"/>\n                </repeat>\n                <repeat name=\"rep_factorLevel\">\n                    <param name=\"factorLevel\" value=\"Untreated\"/>\n                    <param name=\"countsFile\" value=\"GSM461176_untreat_single.counts,GSM461177_untreat_paired.counts,GSM461178_untreat_paired.counts,GSM461182_untreat_single.counts\"/>\n                </repeat>\n            </repeat>\n            <section name=\"advanced_options\">\n                <conditional name=\"prefilter_conditional\">\n                    <param name=\"prefilter\" value=\"-P\"/>\n                    <param name=\"prefilter_value\" value=\"10\"/>\n                </conditional>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_n_lines n=\"2922\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_n_lines n=\"2921\"/>  \n                </assert_contents>\n            </output>\n        </test>\n\n        \n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461179_treat_single.counts\\tGSM461180_treat_paired.counts\\tGSM461181_treat_paired.counts\\tGSM461176_untreat_single.counts\\tGSM461177_untreat_paired.counts\\tGSM461178_untreat_paired.counts\\tGSM461182_untreat_single.counts\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    \n                    <has_text_matching expression=\"FBgn0003360\\t1933\\.9504.*\\t2\\.8399.*\\t0\\.1309.*\\t21\\.68.*\\t.*e-104\\t.*e-101\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n        </test>\n        \n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula