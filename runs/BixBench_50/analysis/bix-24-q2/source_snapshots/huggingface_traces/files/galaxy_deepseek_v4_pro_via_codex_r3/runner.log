{"type":"item.started","item":{"id":"item_132","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, csv\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\ndsid='f9cad7b01a47213560980ac9cb64f727'\np=gi.datasets.download_dataset(dsid, file_path='/workspace/tmp/gprofiler_up_all_out.tsv', use_default_filename=False)\nprint(p, os.path.getsize(p))\n# inspect header and counts\nwith open(p,newline='') as f:\n    r=csv.DictReader(f, delimiter='\\\\t')\n    headers=r.fieldnames\n    sig=0; total=0; minp=None; minrow=None\n    for row in r:\n        total+=1\n        try:\n            pv=float(row['p_value'])\n        except:\n            continue\n        if minp is None or pv<minp:\n            minp=pv; minrow=row\n        if pv<0.05:\n            sig+=1\n    print('headers',headers)\n    print('total',total,'p<0.05',sig,'minp',minp)\n    if minrow: print('min row',minrow)\n# count metabolic term ids with p<0.05 maybe broad\nwith open(p,newline='') as f:\n    r=csv.DictReader(f, delimiter='\\\\t')\n    sigrows=[row for row in r if row.get('p_value') not in ('NA','') and float(row['p_value'])<0.05]\n    print('sig rows count',len(sigrows))\n    print('sig term names first',[(x['term_id'],x['term_name'],x['p_value']) for x in sigrows[:20]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
