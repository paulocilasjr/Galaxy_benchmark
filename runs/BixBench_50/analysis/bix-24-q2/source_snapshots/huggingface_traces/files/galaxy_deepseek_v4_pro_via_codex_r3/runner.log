{"type":"item.started","item":{"id":"item_112","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport csv\np='/workspace/tmp/galaxy_inputs/counts_raw_unfiltered.csv'\nwith open(p,newline='') as f:\n    r=csv.reader(f); h=next(r); genes=[]\n    for row in r:\n        genes.append(row[0])\nprint('n',len(genes),'unique',len(set(genes)))\nfrom collections import Counter\nc=Counter(genes)\nprint('dups',sum(1 for v in c.values() if v>1), [k for k,v in c.items() if v>1][:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
