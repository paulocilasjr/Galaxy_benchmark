{"type":"item.started","item":{"id":"item_134","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, csv\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\ndsid='f9cad7b01a472135a470c9083290fcad'\np=gi.datasets.download_dataset(dsid, file_path='/workspace/tmp/gprofiler_down_all_out.tsv', use_default_filename=False)\nprint('size', os.path.getsize(p))\nwith open(p,newline='') as f:\n    r=csv.DictReader(f,delimiter='\\\\t')\n    sig=0; total=0; minp=None; minrow=None\n    for row in r:\n        total+=1\n        try: pv=float(row['p_value'])\n        except: continue\n        if minp is None or pv<minp: minp=pv; minrow=row\n        if pv<0.05: sig+=1\n    print('total',total,'p<0.05',sig,'minp',minp,'minrow',minrow['term_name'] if minrow else None)\nwith open(p,newline='') as f:\n    r=csv.DictReader(f,delimiter='\\\\t')\n    sigrows=[row for row in r if row.get('p_value') not in ('NA','') and float(row['p_value'])<0.05]\n    print('sig rows',len(sigrows))\n    print('first 20',[(x['term_id'],x['term_name'],x['p_value']) for x in sigrows[:20]])\n    # metabolic terms containing metabolism/metabolic/biosynthetic/catabolic/glycolysis/lipid/glucose/carbohydrate maybe\n    terms=[]\n    for x in sigrows:\n        name=x['term_name'].lower()\n        if any(k in name for k in ['metabol','biosynthetic','catabolic','glycol','glucone','lipid','glucose','carbohydrate','fatty acid','oxidation','respiratory','energy']):\n            terms.append((x['term_id'],x['term_name'],x['p_value']))\n    print('metabolic-related sig count',len(terms))\n    print(terms[:50])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
