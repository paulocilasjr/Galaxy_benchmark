{"type":"item.started","item":{"id":"item_123","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport csv, os\np='/workspace/tmp/deseq_out.tsv'\nup=[]; down=[]; all_genes=[]\nwith open(p,newline='') as f:\n    r=csv.reader(f, delimiter='\\\\t')\n    for row in r:\n        if len(row)<7: continue\n        gene=row[0]\n        all_genes.append(gene)\n        try:\n            lfc=float(row[2]); padj=float(row[6])\n        except (ValueError,IndexError):\n            continue\n        if padj < 0.05 and abs(lfc) > 0.5:\n            if lfc > 0: up.append(gene)\n            elif lfc < 0: down.append(gene)\nprint('total genes', len(all_genes))\nprint('up', len(up), 'down', len(down))\nos.makedirs('/workspace/tmp/gene_lists', exist_ok=True)\nfor name,genes in [('up_genes.txt',up),('down_genes.txt',down),('background_genes.txt',all_genes)]:\n    with open('/workspace/tmp/gene_lists/'+name,'w') as f:\n        f.write('\\\\n'.join(genes)+'\\\\n')\n    print(name, os.path.getsize('/workspace/tmp/gene_lists/'+name))\nprint('first up', up[:5]); print('first down', down[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
