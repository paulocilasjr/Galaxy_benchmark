{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, json\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhist=gi.histories.get_histories(name='Seed: Using differential expression analysis')\nprint('hist count', len(hist))\nfor h in hist[:10]:\n    print(h['id'], h['name'], h.get('state'))\nseed_id='bbd44e69cb8906b5caef0b33ab2fc154'\nprint('--- seed details')\ntry:\n    sh=gi.histories.show_history(seed_id)\n    print(json.dumps({k:sh.get(k) for k in ['id','name','state','deleted','purged','published']}, indent=2))\nexcept Exception as e:\n    print('ERR', repr(e))\nprint('--- datasets')\ntry:\n    ds=gi.histories.show_history(seed_id, contents=True)\n    for d in ds:\n        print(json.dumps({k:d.get(k) for k in ['id','name','state','deleted','visible','genome_build','file_ext','file_size','misc_info']}, indent=2))\nexcept Exception as e:\n    print('ERR datasets', repr(e))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
