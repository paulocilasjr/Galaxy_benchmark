{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport csv, os\nsrc='/workspace/tmp/galaxy_inputs/counts_raw_unfiltered.csv'\noutdir='/workspace/tmp/per_sample'\nos.makedirs(outdir, exist_ok=True)\nwith open(src, newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n    cols=header[1:]\n    # map counts header 3_1 to sample layout ID 3-1 (replace _ with -)\n    sample_ids=[c.replace('_','-') for c in cols]\n    openers={sid: open(os.path.join(outdir, sid+'.counts'), 'w', newline='') for sid in sample_ids}\n    writers={sid: csv.writer(op, delimiter='\\\\t', lineterminator='\\\\n') for sid,op in openers.items()}\n    for sid,w in writers.items():\n        w.writerow(['Geneid', sid])\n    for row in r:\n        gene=row[0]\n        vals=row[1:]\n        if len(vals)\"'!=len(sample_ids):\n            raise SystemExit(f'\"'bad row {gene} {len(vals)}')\n        for sid,val in zip(sample_ids, vals):\n            writers[sid].writerow([gene,val])\n    for op in openers.values(): op.close()\nprint('wrote', len(sample_ids), 'files')\nprint(sorted(os.listdir(outdir))[:10], '...')\nPY\nls -lh /workspace/tmp/per_sample | sed -n '1,40p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
