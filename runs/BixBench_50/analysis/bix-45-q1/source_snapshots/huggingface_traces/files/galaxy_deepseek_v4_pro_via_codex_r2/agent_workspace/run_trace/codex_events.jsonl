{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport bioblend.galaxy, json\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=bioblend.galaxy.GalaxyInstance(url='https://usegalaxy.org', key=key)\nurl=gi.base_url + '/api/tools/toolshed.g2.bx.psu.edu/repos/goeckslab/phykit_metrics/phykit_metrics/0.2.0+galaxy0?io_details=true'\nr=gi.make_get_request(url).json()\n\ndef walk(inputs, prefix=''):\n    for inp in inputs:\n        p=prefix+inp['name']\n        if inp.get('type')=='conditional':\n            print('\\\\nCOND', p)\n            for case in inp.get('cases',[]):\n                print(' CASE', case.get('value'))\n                walk(case.get('inputs',[]), p+'|')\n        elif inp.get('type')=='repeat':\n            print('\\\\nREPEAT', p, 'min', inp.get('min'), 'max', inp.get('max'))\n            walk(inp.get('inputs',[]), p+'|')\n        else:\n            print(f\\\"  {p} type={inp.get('type')} label={inp.get('label')} opt={inp.get('optional')} value={inp.get('value')} help={inp.get('help')}\\\")\n\nfor top in r['inputs']:\n    if top['name']=='operation':\n        for case in top.get('cases',[]):\n            if case.get('value')=='relative_composition_variability':\n                print('=== relative_composition_variability ===')\n                walk(case.get('inputs',[]), 'operation|')\n                # find grouped_zip and print full input JSON\n                for m in case.get('inputs',[]):\n                    if m['name']=='input_mode':\n                        for c in m.get('cases',[]):\n                            if c.get('value')=='grouped_zip_archives':\n                                print('\\\\nGROUPED ZIP FULL JSON:')\n                                print(json.dumps(c, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
