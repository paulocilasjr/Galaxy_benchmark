{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom Bio import AlignIO\nfrom collections import Counter\nfrom scipy import stats\nimport statistics\n\ndef rcv_bio(p):\n    aln=AlignIO.read(str(p),'fasta')\n    n=len(aln); L=aln.get_alignment_length()\n    all_chars=''.join(str(r.seq) for r in aln)\n    total=Counter(all_chars); total_chars=sum(total.values())\n    avg={c: total[c]/total_chars for c in total}\n    devsum=0\n    for rec in aln:\n        seq=str(rec.seq); sc=Counter(seq)\n        dev=sum(abs(sc.get(c,0)-avg[c]*len(seq)) for c in total)\n        devsum+=dev\n    return devsum/(n*L)\nfor grp in ['ani','fun']:\n    vals={p.name.split('.')[0]: round(rcv_bio(p),4) for p in Path('/workspace/tmp/extract_'+grp).glob('*.faa.mafft')}\n    print(grp,len(vals),'zeros',sum(v==0 for v in vals.values()),'minmax',min(vals.values()),max(vals.values()),'median',statistics.median(vals.values()))\n    globals()[grp]=list(vals.values())\nu,p=stats.mannwhitneyu(ani,fun,alternative='two-sided')\nprint('p',repr(p),'u',u)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
