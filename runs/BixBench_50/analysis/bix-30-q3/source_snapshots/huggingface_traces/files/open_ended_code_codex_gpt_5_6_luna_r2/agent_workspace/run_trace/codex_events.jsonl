{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, subprocess\np='inputs/pone.0150501.s002.xls'\nsh=xlrd.open_workbook(p).sheet_by_index(0)\n# Emit a TSV in memory to R, with literal NAN for missing cells.\nlines=['\\\\t'.join(str(x) for x in sh.row_values(1))]\nfor r in range(2,sh.nrows):\n    vals=sh.row_values(r)\n    out=[]\n    for x in vals:\n        if isinstance(x,str): out.append(x)\n        else: out.append('' if x is None else repr(x))\n    lines.append('\\\\t'.join(out))\nr_code=r'''\nd <- read.delim(file(\\\"stdin\\\"), header=TRUE, sep=\\\"\\\\\\\\t\\\", check.names=FALSE, na.strings=c(\\\"NAN\\\",\\\"\\\"), quote=\\\"\\\", comment.char=\\\"\\\")\nP <- d[, grep(\\\"\"'^P_\", names(d)), drop=FALSE]\nC <- d[, grep(\"''^C_\", names(d)), drop=FALSE]\ncalc <- function(test, equal=FALSE) {\n  raw <- vapply(seq_len(nrow(d)), function(i) {\n    x <- as.numeric(P[i,]); y <- as.numeric(C[i,]);\n    if (test == \"welch\") t.test(x,y,var.equal=FALSE)$p.value\n    else if (test == \"pooled\") t.test(x,y,var.equal=TRUE)$p.value\n    else if (test == \"paired\") t.test(x,y,paired=TRUE)$p.value\n    else if (test == \"wilcox\") wilcox.test(x,y,exact=FALSE)$p.value\n  }, numeric(1))\n  b <- p.adjust(raw, method=\"bonferroni\")\n  by <- p.adjust(raw, method=\"BY\")\n  cat(test, \"raw finite\", sum(is.finite(raw)), \"Bonf\", sum(b <= .05, na.rm=TRUE), \"BY\", sum(by <= .05, na.rm=TRUE), \"'\"\\\\n\\\")\n  # print values around thresholds\n  cat(\\\"min raw\\\", min(raw, na.rm=TRUE), \\\"min Bonf\\\", min(b,na.rm=TRUE), \\\"min BY\\\", min(by,na.rm=TRUE), \\\"\\\\n\\\")\n  invisible(list(raw=raw,b=b,by=by))\n}\nfor (test in c(\\\"welch\\\",\\\"pooled\\\",\\\"paired\\\",\\\"wilcox\\\")) calc(test)\n'''\nres=subprocess.run(['Rscript','--vanilla','-e',r_code],input='\\\\n'.join(lines).encode(),stdout=subprocess.PIPE,stderr=subprocess.PIPE)\nprint(res.stdout.decode())\nprint(res.stderr.decode())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
