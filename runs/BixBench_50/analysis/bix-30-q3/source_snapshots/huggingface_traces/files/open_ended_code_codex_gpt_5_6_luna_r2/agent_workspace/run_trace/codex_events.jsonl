{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n# Generate top Welch/pooled/two-sided p values via R and print miRNA name,p,mean diff.\nimport xlrd, subprocess\nsh=xlrd.open_workbook('inputs/pone.0150501.s002.xls').sheet_by_index(0)\nlines=['\\\\t'.join(str(x) for x in sh.row_values(1))]\nfor i in range(2,sh.nrows): lines.append('\\\\t'.join(x if isinstance(x,str) else repr(x) for x in sh.row_values(i)))\nr_code=r'''\nd <- read.delim(file(\\\"stdin\\\"), header=T, sep=\\\"\\\\t\\\", check.names=F, na.strings=c(\\\"NAN\\\",\\\"\\\"), quote=\\\"\\\", comment.char=\\\"\\\")\nP <- d[,grep(\\\"\"'^P_\",names(d)),drop=F]; C <- d[,grep(\"''^C_\",names(d)),drop=F]\nraw <- vapply(1:nrow(d),function(i)t.test(as.numeric(P[i,]),as.numeric(C[i,]))$p.value,numeric(1))\no <- order(raw)\nfor(i in o[1:20]) cat(d[i,1], raw[i], mean(as.numeric(P[i,]),na.rm=T)-mean(as.numeric(C[i,]),na.rm=T),\"'\"\\\\n\\\")\n'''\nres=subprocess.run(['Rscript','--vanilla','-e',r_code],input='\\\\n'.join(lines).encode(),stdout=subprocess.PIPE,stderr=subprocess.PIPE)\nprint(res.stdout.decode()); print(res.stderr.decode())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
