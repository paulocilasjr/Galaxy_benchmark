{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd\nimport numpy as np\nfrom scipy import stats\nfrom statsmodels.stats.multitest import multipletests\n\npath='inputs/pone.0150501.s002.xls'\nbook=xlrd.open_workbook(path)\nsh=book.sheet_by_index(0)\n# Rows: 0 title, 1 sample header, 2..176 miRNA rows\nmiRNAs=[]\nmat=[]\nfor r in range(2, sh.nrows):\n    miRNAs.append(sh.cell_value(r,0))\n    vals=[]\n    for c in range(1, sh.ncols):\n        v=sh.cell_value(r,c)\n        if isinstance(v,str) and v.strip().upper()=='NAN':\n            vals.append(np.nan)\n        else:\n            vals.append(float(v))\n    mat.append(vals)\nA=np.array(mat)  # 175 x 20\n\ndef analyze(data, patient_cols, control_cols, use_detected_mean=True):\n    # Per-sample normalization factor: mean Ct over all numeric values,\n    # or only detected Ct<34, depending on paper wording.\n    factors=[]\n    for j in range(data.shape[1]):\n        col=data[:,j]\n        valid=~np.isnan(col)\n        if use_detected_mean:\n            valid &= (col < 34)\n        factors.append(np.nanmean(col[valid]))\n    factors=np.array(factors)\n    # log2 mean-normalized expression is proportional to -(Ct - sample mean)\n    expr=factors[None,:]-data\n    pvals=[]\n    for i in range(data.shape[0]):\n        xp=expr[i, patient_cols]\n        xc=expr[i, control_cols]\n        xp=xp[~np.isnan(xp)]\n        xc=xc[~np.isnan(xc)]\n        t,p=stats.ttest_ind(xp,xc,equal_var=True)\n        pvals.append(p)\n    pvals=np.array(pvals)\n    results={}\n    for method in ['bonferroni','fdr_bh','fdr_by']:\n        rej, adj, _, _ = multipletests(pvals, alpha=0.05, method=method)\n        results[method]=(int(rej.sum()), [miRNAs[i] for i in np.where(rej)[0]])\n    return pvals, results\n\n# All provided samples: P_1..P_10 vs C_11..C_20\np1,r1=analyze(A, list(range(0,10)), list(range(10,20)), use_detected_mean=False)\nprint('all samples, mean all numeric: raw<0.05', int((p1<0.05).sum()))\nfor m in r1:\n    print(m, r1[m])\n\n# Paper-described haemolysis exclusions: remove P_3 (index 2) and C_18 (index 17)\nkeep=[i for i in range(20) if i not in (2,17)]\nA2=A[:,keep]\np_cols=[keep.index(i) for i in range(10) if i\"'!=2]\nc_cols=[keep.index(i) for i in range(10,20) if i!=17]\np2,r2=analyze(A2,p_cols,c_cols,use_detected_mean=True)\nprint('\"'excluded P3/C18, mean detected Ct<34: raw<0.05', int((p2<0.05).sum()))\nfor m in r2:\n    print(m, r2[m])\n\nprint('ANSWER', r1['bonferroni'][0], ':', r1['fdr_by'][0])\nprint('ANSWER excluded', r2['bonferroni'][0], ':', r2['fdr_by'][0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
