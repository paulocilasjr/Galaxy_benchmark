{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd, math\nimport numpy as np\nfrom scipy import stats\nsh=xlrd.open_workbook('inputs/pone.0150501.s002.xls').sheet_by_index(0)\nP_cols=range(1,11)\nC_cols=range(11,21)\nall_names=[]\nall_data=[]\nfor r in range(2,sh.nrows):\n    name=sh.cell_value(r,0)\n    vals=[]\n    for c in range(1,21):\n        v=sh.cell_value(r,c)\n        vals.append(np.nan if isinstance(v,str) and v.strip().upper()=='NAN' else (float(v) if isinstance(v,(int,float)) else np.nan))\n    all_names.append(name); all_data.append(vals)\nA=np.array(all_data) # rows x samples\nnames=all_names\nPmask=np.zeros(A.shape[1],bool); Pmask[list(P_cols)]=True\nCmask=np.zeros(A.shape[1],bool); Cmask[list(C_cols)]=True\n\ndef apply_discard(data, discard):\n    if not discard: return data\n    drop=[2,17] # indices P3, C18\n    keep=[i for i in range(data.shape[1]) if i not in drop]\n    return data[:,keep], Pmask[keep], Cmask[keep]\n\ndef compute(data,Pmask,Cmask, norm='detected', use_high=True, missing_policy='drop'):\n    # sample mean\n    means=[]\n    for j in range(data.shape[1]):\n        vals=data[:,j]\n        finite=~np.isnan(vals)\n        if norm=='detected':\n            finite=finite & (vals<34)\n        elif norm=='all':\n            pass\n        if finite.sum()==0: means.append(np.nan)\n        else: means.append(np.nanmean(vals[finite]))\n    means=np.array(means)\n    X = means[None,:] - data  # negative dCt, finite if data finite and mean finite\n    raw=[]; names2=[]\n    for i in range(data.shape[0]):\n        x=X[i]\n        if missing_policy=='drop':\n            # include finite x; NAN rows removed\n            xp=x[Pmask & ~np.isnan(x)]\n            xc=x[Cmask & ~np.isnan(x)]\n        elif missing_policy=='impute40':\n            # treat all NAN as 40 for row? x from mean-40; data missing replaced 40 before norm?\n            pass\n        if len(xp)>=2 and len(xc)>=2:\n            t,p=stats.ttest_ind(xp,xc,equal_var=True)\n            raw.append(p); names2.append(names[i])\n    return np.array(raw), names2, X\n\ndef adjust_counts(p, method):\n    m=len(p)\n    if method=='bonf': q=np.minimum(p*m,1)\n    elif method=='bh':\n        order=np.argsort(p); q=np.empty(m)\n        prev=1.0\n        for rank in range(m,0,-1):\n            idx=order[rank-1]\n            val=min(m/rank*p[idx],1)\n            prev=min(prev,val)\n            q[idx]=prev\n    elif method=='by':\n        order=np.argsort(p); q=np.empty(m)\n        # c(m)=sum 1/i\n        c=sum(1.0/k for k in range(1,m+1))\n        prev=1.0\n        for rank in range(m,0,-1):\n            idx=order[rank-1]\n            val=min(m*c/rank*p[idx],1)\n            prev=min(prev,val)\n            q[idx]=prev\n    return q\n\nfor discard in [False, True]:\n    data,P,C=apply_discard(A, discard)\n    for norm in ['detected','all','none']:\n        for use_high in [True]:\n            X=None\n            if norm=='none':\n                X=-data\n            else:\n                means=[]\n                for j in range(data.shape[1]):\n                    vals=data[:,j]; finite=~np.isnan(vals)\n                    if norm=='detected': finite &= vals<34\n                    if finite.sum()==0: means.append(np.nan)\n                    else: means.append(np.nanmean(vals[finite]))\n                X=np.array(means)[None,:]-data\n            pvals=[]; ns=[]\n            for i in range(data.shape[0]):\n                x=X[i]\n                xp=x[P & ~np.isnan(x)]\n                xc=x[C & ~np.isnan(x)]\n                if len(xp)>=2 and len(xc)>=2:\n                    pvals.append(stats.ttest_ind(xp,xc,equal_var=True).pvalue)\n                    ns.append(names[i])\n            p=np.array(pvals)\n            print('discard',discard,'norm',norm,'rows',len(p),'raw<.05',np.sum(p<.05))\n            for meth in ['bonf','bh','by']:\n                q=adjust_counts(p,meth)\n                sig=np.where(q<=0.05)[0]\n                print(' ',meth, len(sig), [ns[i] for i in sig], 'minp', p.min(), 'minq', q.min())\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
