{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd,numpy as np\nfrom scipy import stats\nsh=xlrd.open_workbook('inputs/pone.0150501.s002.xls').sheet_by_index(0)\nnames=[];rows=[]\nfor r in range(2,sh.nrows):\n    names.append(sh.cell_value(r,0));vals=[]\n    for c in range(1,21):\n        v=sh.cell_value(r,c); vals.append(np.nan if isinstance(v,str) and v.strip().upper()=='NAN' else float(v))\n    rows.append(vals)\nA=np.array(rows); P=list(range(10)); C=list(range(10,20))\nmeans=np.array([np.nanmean(A[:,j]) for j in range(20)])\nX=means[None,:]-A\nps=[];ns=[]\nfor i in range(A.shape[0]):\n    xp=X[i,P];xc=X[i,C];xp=xp[~np.isnan(xp)];xc=xc[~np.isnan(xc)]\n    if len(xp)>=2 and len(xc)>=2:\n        p=stats.ttest_ind(xp,xc,equal_var=True).pvalue\n        ps.append(p);ns.append(names[i])\nps=np.array(ps)\ndef adj(method):\n    m=len(ps)\n    if method=='bonf': q=np.minimum(ps*m,1)\n    else:\n        order=np.argsort(ps); q=np.empty(m); prev=1\n        factor=m*sum(1.0/k for k in range(1,m+1)) if method=='by' else m\n        for rank in range(m,0,-1):\n            idx=order[rank-1]; val=min(factor/rank*ps[idx],1); prev=min(prev,val); q[idx]=prev\n        return q\nprint('n',len(ps),'raw<.05',np.sum(ps<.05),'up/down etc')\nfor meth in ['bonf','bh','by']:\n    q=adj(meth); sig=np.where(q<=.05)[0]\n    print(meth,len(sig),[(ns[i],ps[i],q[i]) for i in sig])\n# Print key miR-21\nfor meth in ['bonf','bh','by']:\n    q=adj(meth); i=ns.index('hsa-miR-21');print(meth,'miR21 p adj',ps[i],q[i])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
