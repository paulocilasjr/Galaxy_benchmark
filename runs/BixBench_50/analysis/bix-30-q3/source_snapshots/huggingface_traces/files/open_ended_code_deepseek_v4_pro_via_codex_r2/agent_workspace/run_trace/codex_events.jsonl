{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd, numpy as np\nfrom scipy import stats\nsh=xlrd.open_workbook('inputs/pone.0150501.s002.xls').sheet_by_index(0)\nnames=[]; rows=[]\nfor r in range(2,sh.nrows):\n    names.append(sh.cell_value(r,0))\n    vals=[]\n    for c in range(1,21):\n        v=sh.cell_value(r,c)\n        if isinstance(v,str) and v.strip().upper()=='NAN': vals.append(np.nan)\n        elif isinstance(v,(int,float)): vals.append(float(v))\n        else: vals.append(np.nan)\n    rows.append(vals)\nA=np.array(rows)\nall_cols=list(range(20)); Pcols=list(range(0,10)); Ccols=list(range(10,20))\n\ndef adjust_counts(p, method):\n    m=len(p)\n    if m==0:return np.array([])\n    if method=='bonf': return np.minimum(p*m,1)\n    order=np.argsort(p); q=np.empty(m); prev=1.0\n    factor=m if method=='bh' else m*sum(1.0/k for k in range(1,m+1))\n    for rank in range(m,0,-1):\n        idx=order[rank-1]\n        val=min(factor/rank*p[idx],1)\n        prev=min(prev,val); q[idx]=prev\n    return q\n\ndef run(data, Pcols, Ccols, norm):\n    means=[]\n    for j in range(data.shape[1]):\n        vals=data[:,j]; finite=~np.isnan(vals)\n        if norm=='detected': finite &= vals<34\n        means.append(np.nanmean(vals[finite]) if finite.any() else np.nan)\n    means=np.array(means)\n    X = means[None,:]-data if norm\"'!='\"'none' else -data\n    pvals=[]; ns=[]\n    for i in range(data.shape[0]):\n        x=X[i]\n        xp=x[np.array(Pcols)[~np.isnan(x[Pcols])]] if False else x[Pcols]\n        # avoid indexing with mask issue\n        xp=x[np.array(Pcols)]\n        xc=x[np.array(Ccols)]\n        xp=xp[~np.isnan(xp)]; xc=xc[~np.isnan(xc)]\n        if len(xp)>=2 and len(xc)>=2:\n            p=stats.ttest_ind(xp,xc,equal_var=True).pvalue\n            pvals.append(p); ns.append(names[i])\n    p=np.array(pvals)\n    print('discard',data.shape[1],'norm',norm,'rows',len(p),'raw<.05',int(np.sum(p<.05)))\n    for meth in ['bonf','bh','by']:\n        q=adjust_counts(p,meth); sig=np.where(q<=0.05)[0]\n        print(' ',meth,len(sig),[ns[i] for i in sig],'minp',p.min(),'minq',q.min())\n\nfor discard in [False, True]:\n    if discard:\n        keep=[i for i in range(20) if i not in (2,17)]\n        data=A[:,keep]; P=[i for i in range(10) if i\"'!=2]; C=[i for i in range(10,20) if i!=17]\n        # after reindex C positions\n        P=[keep.index(i) for i in range(10) if i!=2]\n        C=[keep.index(i) for i in range(10,20) if i!=17]\n    else:\n        data=A; P=list(range(10)); C=list(range(10,20))\n    for norm in ['\"'none','detected','all']:\n        run(data,P,C,norm)\n    print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
