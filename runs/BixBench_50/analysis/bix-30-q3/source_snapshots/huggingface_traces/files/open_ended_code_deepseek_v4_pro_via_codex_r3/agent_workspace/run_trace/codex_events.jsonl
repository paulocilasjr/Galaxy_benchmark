{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, numpy as np\nfrom scipy import stats\np='/workspace/inputs/pone.0150501.s002.xls'\nwb=xlrd.open_workbook(p); ws=wb.sheet_by_index(0)\nnames=[]; M=[]\nfor r in range(2,ws.nrows):\n row=ws.row_values(r)\n name=row[0]; vals=[]\n for c in range(1,21):\n  v=row[c]\n  vals.append(v if isinstance(v,(int,float)) and not (isinstance(v,float) and np.isnan(v)) else np.nan)\n names.append(name); M.append(vals)\nM=np.array(M,float)\n# sample indices 0-9 patients, 10-19 controls; exclude P3 idx2, C18 idx17 (col17? headers: P_1 col1..P_10 col10, C_11 col11..C_20 col20; C18 = 18th control? actually C_18 is col18? Let's map)\n# P3 col3 (idx2); C18 col18? row header col 0? list: C_11 col11 idx10 ... C_18 col18 idx17, C_19 idx18, C_20 idx19. So exclude idx2 and idx17.\nkeep=np.array([i for i in range(20) if i not in (2,17)])\nPidx=keep[:9] # first 9 patients after exclude P3 = [0,1,3,4,5,6,7,8,9]\nCidx=keep[9:] # [10..16,18,19]\nprint(keep, Pidx, Cidx)\n\ndef ttest_arr(data, equal_var):\n ps=[]\n for row in data:\n  a=row[Pidx]; b=row[Cidx]\n  a=a[np.isfinite(a)]; b=b[np.isfinite(b)]\n  if len(a)<2 or len(b)<2:\n   ps.append(np.nan); continue\n  try:\n   ps.append(stats.ttest_ind(a,b,equal_var=equal_var).pvalue)\n  except: ps.append(np.nan)\n return np.array(ps)\n\ndef sample_means(data, use_lt34):\n means=[]\n for j in keep:\n  vals=data[:,j]\n  if use_lt34:\n   vals=vals[(np.isfinite(vals)) & (vals<34)]\n  else:\n   vals=vals[np.isfinite(vals)]\n  means.append(np.mean(vals) if len(vals) else np.nan)\n return np.array(means)\n\nvariants=[]\nfor rawtransform in ['ct','logct']:\n for norm in ['none','global_ct_subtract','global_expr']:\n  for lt in [False,True]:\n   for eq in [True,False]:\n    # transformed values per miRNA for t-test:\n    if norm=='none':\n     data=M\n    elif norm=='global_ct_subtract':\n     means=sample_means(M, lt)\n     data=M - means[None,:]\n    elif norm=='global_expr':\n     means=sample_means(M, lt)\n     # 2\"'^-(ct - mean) = 2''^(mean-ct); t-test on log2 expression = mean-ct same as subtract (up to sign) so same p; skip? include\n     data=means[None,:]-M\n    else: continue\n    if rawtransform=='\"'logct' and norm\"'!='\"'none':\n     # log2 raw expression before subtract? not meaningful\n     pass\n    ps=ttest_arr(data, eq)\n    n= np.sum(ps<0.05)\n    variants.append((norm,lt,eq,n,np.nanmin(ps),names[np.nanargmin(ps)] if np.any(ps<.05) else None))\n\nfor v in variants: print(v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
