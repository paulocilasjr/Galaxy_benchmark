{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, numpy as np\nfrom scipy import stats\nwb=xlrd.open_workbook('/workspace/inputs/pone.0150501.s002.xls'); ws=wb.sheet_by_index(0)\nnames=[]; raw=[]\nfor r in range(2,ws.nrows):\n row=ws.row_values(r); vals=[]\n for c in range(1,21):\n  v=row[c]; vals.append(v if isinstance(v,(int,float)) and not (isinstance(v,float) and np.isnan(v)) else np.nan)\n names.append(row[0]); raw.append(vals)\nM=np.array(raw,float)\nkeep=np.array([i for i in range(20) if i not in (2,17)])\nM=M[:,keep]\nPidx=np.arange(9); Cidx=np.arange(9,18)\n\ndef run(norm, use_lt34, eq):\n if norm=='none':\n  data=M.copy()\n else:\n  means=[]\n  for j in range(M.shape[1]):\n   vals=M[:,j]\n   if use_lt34: vals=vals[np.isfinite(vals)&(vals<34)]\n   else: vals=vals[np.isfinite(vals)]\n   means.append(vals.mean())\n  means=np.array(means)\n  data=M - means[None,:]\n ps=[]\n for i,row in enumerate(data):\n  a=row[Pidx]; b=row[Cidx]\n  a=a[np.isfinite(a)]; b=b[np.isfinite(b)]\n  p=stats.ttest_ind(a,b,equal_var=eq).pvalue if len(a)>=2 and len(b)>=2 else np.nan\n  ps.append(p)\n p=np.array(ps); m=len(p); valid=~np.isnan(p)\n # bonf on all valid; by on valid\n bonf=p*175 # tests 175 (nan propagates)\n # BY adjusted using valid only or all m? Use all m with nan omitted but ranking valid\n order=np.argsort(p[valid]); q=p[valid][order]; nvalid=len(q); by_adj=np.empty(nvalid)\n c=np.sum(1/np.arange(1,m+1))\n running=np.inf\n for j in range(nvalid-1,-1,-1):\n  running=min(running, q[j]*m*c/(j+1))\n  by_adj[j]=running\n # map back\n by=np.full(m,np.nan); by[valid]=by_adj[np.argsort(order)]\n print(f'norm={norm} lt={use_lt34} eq={eq}: raw<.05={np.nansum(p<.05):.0f}, bonf={np.nansum(bonf<=.05):.0f}, by={np.nansum(by<=.05):.0f}, minp={np.nanmin(p):.6g}, min_bonf={np.nanmin(bonf):.6g}, min_by={np.nanmin(by):.6g}, minmiR={names[np.nanargmin(p)]}')\n\nfor norm in ['none','global']:\n for lt in [False,True]:\n  for eq in [True,False]:\n   run(norm,lt,eq)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
