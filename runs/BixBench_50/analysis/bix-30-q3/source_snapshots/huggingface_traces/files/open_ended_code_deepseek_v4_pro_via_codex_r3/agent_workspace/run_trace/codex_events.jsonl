{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, numpy as np\nfrom scipy import stats\nwb=xlrd.open_workbook('/workspace/inputs/pone.0150501.s002.xls'); ws=wb.sheet_by_index(0)\nnames=[]; raw=[]\nfor r in range(2,ws.nrows):\n row=ws.row_values(r); vals=[]\n for c in range(1,21):\n  v=row[c]; vals.append(v if isinstance(v,(int,float)) and not (isinstance(v,float) and np.isnan(v)) else np.nan)\n names.append(row[0]); raw.append(vals)\nM=np.array(raw,float)\nkeep=np.array([i for i in range(20) if i not in (2,17)])\nMkeep=M[:,keep]\n# sample means all finite\nmeans=np.array([Mkeep[np.isfinite(Mkeep[:,j]),j].mean() for j in range(Mkeep.shape[1])])\ndata=Mkeep-means[None,:]\nPidx=np.arange(9); Cidx=np.arange(9,18)\n\ndef ps(data,eq):\n out=[]\n for row in data:\n  a=row[Pidx]; b=row[Cidx]; a=a[np.isfinite(a)]; b=b[np.isfinite(b)]\n  out.append(stats.ttest_ind(a,b,equal_var=eq).pvalue if len(a)>=2 and len(b)>=2 else np.nan)\n return np.array(out)\nfor maskname, mask in [\n ('all', np.ones(len(names),bool)),\n ('complete_before_excl', np.array([not np.any(np.isnan(row)) for row in M])),\n ('complete_after_excl', np.array([not np.any(np.isnan(row)) for row in Mkeep])),\n ('missing_lt2_eachgroup', np.array([(sum(np.isfinite(Mkeep[i,Pidx]))>=2 and sum(np.isfinite(Mkeep[i,Cidx]))>=2) for i in range(len(names))])),\n]:\n sub=data[mask]; nm=[n for n,m in zip(names,mask) if m]\n for eq in [True,False]:\n  p=ps(sub,eq); print(maskname,eq,len(sub),np.sum(p<0.05),np.sum(~np.isnan(p)))\n# List p<.05 names all\np=ps(data,True)\nfor i in np.where(p<0.05)[0]: print(i,names[i],p[i])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
