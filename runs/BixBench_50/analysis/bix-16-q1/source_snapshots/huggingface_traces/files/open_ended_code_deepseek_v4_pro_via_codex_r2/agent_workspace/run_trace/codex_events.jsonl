{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, time, numpy as np, scipy.stats as st, os\n\nt0=time.time()\ndef read_headers(path):\n    with open(path, newline='') as f:\n        return next(csv.reader(f))\n\neh=read_headers('inputs/CRISPRGeneEffect.csv')\nxh=read_headers('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv')\neg=eh[1:]; xg=xh[1:]\nprint('genes', len(eg), len(xg), 'full overlap', len(set(eg)&set(xg)), flush=True)\n\n# Read IDs\ndef read_ids(path):\n    ids=[]\n    with open(path,newline='') as f:\n        r=csv.reader(f); next(r)\n        for row in r: ids.append(row[0])\n    return ids\neids=read_ids('inputs/CRISPRGeneEffect.csv')\nxids=read_ids('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv')\ncommon_ids=[i for i in eids if i in set(xids)]\nxid_set={v:i for i,v in enumerate(xids)}\ne_rows=np.array([i for i,v in enumerate(eids) if v in xid_set],dtype=int)\nx_rows=np.array([xid_set[v] for v in eids if v in xid_set],dtype=int)\nprint('rows',len(eids),len(xids),len(common_ids), 'read ids time',time.time()-t0, flush=True)\n\n# common gene indices exact header\neset=set(eg); xset=set(xg)\ncommon_genes=sorted(eset&xset, key=lambda h: (h.rsplit(' (',1)[0], h))\n# preserve header order? Not necessary but output symbol. Use effect order perhaps\ncommon_genes=[h for h in eg if h in xset]\ne_cols=np.array([eg.index(h) for h in common_genes],dtype=int)\nx_cols=np.array([xg.index(h) for h in common_genes],dtype=int)\nprint('common genes',len(common_genes), common_genes[:3], common_genes[-3:], flush=True)\n\nt=time.time()\nprint('loading effect...', flush=True)\nE=np.genfromtxt('inputs/CRISPRGeneEffect.csv', delimiter=',', skip_header=1, usecols=np.arange(1,len(eh),dtype=int), dtype=np.float32, missing_values='', filling_values=np.nan)\nprint('E',E.shape,'nan',np.isnan(E).sum(),'load',time.time()-t, flush=True)\nt=time.time()\nprint('loading expr...', flush=True)\nX=np.loadtxt('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', delimiter=',', skiprows=1, usecols=np.arange(1,len(xh),dtype=int), dtype=np.float32)\nprint('X',X.shape,'nan',np.isnan(X).sum(),'load',time.time()-t, flush=True)\n\nt=time.time()\nEa=E[np.ix_(e_rows,e_cols)]\nXa=X[np.ix_(x_rows,x_cols)]\nprint('aligned',Ea.shape,Xa.shape, flush=True)\n# free full\ndel E,X\nprint('rank effect...', flush=True)\nRe=st.rankdata(Ea,axis=0,nan_policy='omit').astype(np.float64)\nprint('rank expr...', flush=True)\nRx=st.rankdata(Xa,axis=0,nan_policy='omit').astype(np.float64)\nprint('ranked time',time.time()-t, flush=True)\n# mean center ignoring nan pairwise; expr no nan but use pairwise\nvalid=~np.isnan(Re)\nn_valid=valid.sum(axis=0)\nprint('valid count range',n_valid.min(),n_valid.max(), 'genes with <100',np.sum(n_valid<100),'<10',np.sum(n_valid<10),'<3',np.sum(n_valid<3), flush=True)\n# loop pearson with pairwise\nrhos=np.full(len(common_genes),np.nan)\n# Precompute expression centered means per gene (no missing in expr)\nxmean=np.mean(Rx,axis=0)\nxdiff=Rx-xmean\nxss=np.sum(xdiff*xdiff,axis=0)\n# effect has missing; compute per gene with mask\n# Could vectorize with masked arrays but loop\nfor j in range(len(common_genes)):\n    m=valid[:,j]\n    n=n_valid[j]\n    if n<3:\n        continue\n    ym=Re[m,j].mean()\n    yd=Re[m,j]-ym\n    ydss=np.sum(yd*yd)\n    if ydss==0 or xss[j]==0:\n        continue\n    # expression diff already full; subset to m\n    num=np.sum(xdiff[m,j]*yd)\n    den=np.sqrt(xss[j]*ydss)\n    rhos[j]=num/den\nprint('rho nan',np.isnan(rhos).sum(),'range',np.nanmin(rhos),np.nanmax(rhos), flush=True)\n# top 20 negative with count, symbols\norder=np.argsort(rhos)\nprint('top negative:')\nfor k in order[:20]:\n    print(k, common_genes[k], rhos[k], int(n_valid[k]))\nprint('top positive:')\nfor k in order[-5:][::-1]:\n    print(k, common_genes[k], rhos[k], int(n_valid[k]))\nprint('total elapsed',time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
