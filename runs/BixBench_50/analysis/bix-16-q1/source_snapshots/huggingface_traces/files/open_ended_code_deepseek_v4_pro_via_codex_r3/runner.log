{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, re, time\nfrom scipy.stats import spearmanr\nstart=time.time()\nprint('loading data', flush=True)\neff=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nexpr=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\nclean=lambda col: re.sub(r'\\\\s*\\\\(.*\\\\)\"'$'\"','',col)\neff.columns=[clean(c) for c in eff.columns]\nexpr.columns=[clean(c) for c in expr.columns]\ncommon_rows=eff.index.intersection(expr.index)\ncommon_genes=eff.columns.intersection(expr.columns)\n# align rows and columns in common sorted order\neff=eff.loc[common_rows, common_genes]\nexpr=expr.loc[common_rows, common_genes]\nE=expr.to_numpy(dtype=np.float64)\n# essentiality = -gene_effect (positive-going dependency)\nD=-eff.to_numpy(dtype=np.float64)\nprint('shapes', E.shape, D.shape, 'loading', time.time()-start, flush=True)\nrows=[]\nfor j,g in enumerate(common_genes):\n    x=E[:,j]\n    y=D[:,j]\n    mask=~np.isnan(y)\n    if mask.sum() >= 2:\n        rho=spearmanr(x[mask], y[mask]).correlation\n        if np.isfinite(rho):\n            rows.append((rho,g,int(mask.sum())))\nres=pd.DataFrame(rows, columns=['rho','gene','n']).sort_values('rho')\nprint('computed', len(res), 'elapsed total', time.time()-start, flush=True)\nprint(res.head(20).to_string(index=False))\nprint('min gene', res.iloc[0]['gene'], 'rho', res.iloc[0]['rho'], 'n', res.iloc[0]['n'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
