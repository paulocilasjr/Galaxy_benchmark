{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport math, openpyxl\nwb=openpyxl.load_workbook('/workspace/inputs/data.xlsx', read_only=True, data_only=True)\nws=wb['Sheet1']\nrows=list(ws.iter_rows(values_only=True))\n# header row 0, data rows after\ny=[]; x=[]\nfor r in rows[1:]:\n    grp=r[1]; eff=r[2]; bmi=r[10]\n    if eff in ('PR','SD','PD') and bmi is not None:\n        y.append(1 if eff=='PR' else 0)\n        x.append(float(bmi))\nprint(len(y), sum(y), sum(1 for v in y if v==0), min(x), max(x))\n# MLE newton\nn=len(y)\nb0=0.0; b1=0.0\nfor it in range(100):\n    # compute p, gradient hessian\n    grad0=0; grad1=0; h00=0; h01=0; h11=0; ll=0\n    for yi, xi in zip(y,x):\n        eta=b0+b1*xi\n        # p logistic stable\n        if eta>=0:\n            p=1/(1+math.exp(-eta))\n        else:\n            e=math.exp(eta); p=e/(1+e)\n        # clip p\n        p=max(1e-15,min(1-1e-15,p))\n        # ll contribution\n        ll += yi*math.log(p)+(1-yi)*math.log(1-p)\n        d=yi-p\n        grad0 += d\n        grad1 += d*xi\n        w=p*(1-p)\n        h00 += w\n        h01 += w*xi\n        h11 += w*xi*xi\n    # solve 2x2 Hessian invert\n    det=h00*h11-h01*h01\n    if abs(det)<1e-15:\n        break\n    db0=(h11*grad0-h01*grad1)/det\n    db1=(-h01*grad0+h00*grad1)/det\n    b0 += db0; b1 += db1\n    if max(abs(db0),abs(db1))<1e-12:\n        print('converged',it)\n        break\n# recompute final ll\nll=0\nfor yi,xi in zip(y,x):\n    eta=b0+b1*xi\n    if eta>=0: p=1/(1+math.exp(-eta))\n    else: e=math.exp(eta); p=e/(1+e)\n    p=max(1e-15,min(1-1e-15,p))\n    ll += yi*math.log(p)+(1-yi)*math.log(1-p)\nk=2\naic=-2*ll+2*k\nprint('b0,b1',b0,b1)\nprint('ll',ll)\nprint('AIC',aic)\n# null ll for reference\np0=sum(y)/n\nll0=sum(y)*math.log(p0)+sum(1-yi for yi in y)*math.log(1-p0)\nprint('null ll', ll0, 'null AIC',-2*ll0+2)\nprint('deviance', -2*ll, 2*(ll-ll0))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
