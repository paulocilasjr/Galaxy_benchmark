{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom openpyxl import load_workbook\nimport numpy as np, math\nwb=load_workbook('/workspace/inputs/data.xlsx', data_only=True)\nws=wb['Sheet1']\nys=[]; xs=[]\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    if r[0] is None: continue\n    if r[2] is None or r[10] is None: continue\n    ys.append(1.0 if r[2]=='PR' else 0.0)\n    xs.append(float(r[10]))\ny=np.array(ys); x=np.array(xs)\nb0=-3.631934; b1=0.167746\nfor _ in range(100):\n    eta=b0+b1*x\n    p=1/(1+np.exp(-eta))\n    res=y-p\n    g0=res.sum(); g1=(res*x).sum()\n    w=p*(1-p)\n    H00=w.sum(); H01=(w*x).sum(); H11=(w*x*x).sum()\n    det=H00*H11-H01**2\n    db0=(H11*g0-H01*g1)/det\n    db1=(-H01*g0+H00*g1)/det\n    b0+=db0; b1+=db1\n    if max(abs(db0),abs(db1))<1e-12: break\neta=b0+b1*x\np=1/(1+np.exp(-eta))\np=np.clip(p,1e-300,1-1e-300)\nll=np.sum(y*np.log(p)+(1-y)*np.log(1-p))\nprint('n', len(y))\nprint('coefs', b0,b1)\nprint('ll',repr(float(ll)))\nprint('AIC',repr(float(-2*ll+2*2)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
