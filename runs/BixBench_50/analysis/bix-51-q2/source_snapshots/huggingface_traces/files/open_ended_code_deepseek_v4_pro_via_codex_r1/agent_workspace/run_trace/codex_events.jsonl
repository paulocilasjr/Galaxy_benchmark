{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport math\n# Parse and verify AIC manually with a Newton/optimization fallback\nfrom openpyxl import load_workbook\nimport statsmodels.api as sm, numpy as np, pandas as pd\nwb=load_workbook('/workspace/inputs/data.xlsx', data_only=True)\nws=wb['Sheet1']\ndata=[]\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    if r[0] is None: continue\n    data.append(r)\ndf=pd.DataFrame(data, columns=['seq','Groups','Efficacy','Age','Family history','ECOG-PS','Child-Pugh','Chemotherapy experience','HBV infection','Gender','BMI','Toxic'])\ny=(df.Efficacy=='PR').astype(float).to_numpy()\nx=df.BMI.astype(float).to_numpy()\n# simple coordinate optim\nb0,b1=-3.631934,0.167746\nfor _ in range(100):\n    eta=b0+b1*x\n    p=1/(1+np.exp(-eta))\n    res=y-p\n    g0=res.sum(); g1=(res*x).sum()\n    w=p*(1-p)\n    H00=w.sum(); H01=(w*x).sum(); H11=(w*x*x).sum()\n    det=H00*H11-H01**2\n    db0=(H11*g0-H01*g1)/det\n    db1=(-H01*g0+H00*g1)/det\n    b0+=db0; b1+=db1\n    if max(abs(db0),abs(db1))<1e-12: break\neta=b0+b1*x\np=1/(1+np.exp(-eta))\nll=np.sum(y*np.log(p)+(1-y)*np.log(1-p))\nprint(b0,b1,ll,-2*ll+2*2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
