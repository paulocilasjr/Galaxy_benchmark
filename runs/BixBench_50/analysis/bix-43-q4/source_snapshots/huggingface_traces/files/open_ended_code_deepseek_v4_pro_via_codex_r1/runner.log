{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport gseapy, pandas as pd, time, sys\nsymbols=pd.read_csv('/tmp/deg_symbols.txt', header=None)[0].tolist()\nprint('n genes', len(symbols))\nt=time.time()\ntry:\n    enr = gseapy.enrichr(gene_list=symbols, gene_sets='Reactome_2022', organism='human', outdir=None, cutoff=1.0)\n    print('done', time.time()-t)\n    res=enr.results\n    print(type(res), res.shape)\n    print(res.columns.tolist())\n    print(res.head().to_string())\n    # search pathway exact/contain\n    mask=res['Term'].str.contains('TP53 Regulates Transcription Of Cell Cycle Genes', case=False, na=False)\n    print('matches', mask.sum())\n    if mask.sum(): print(res.loc[mask].to_string(index=False))\n    enr.results.to_csv('/tmp/gseapy_enrichr_results.csv', index=False)\nexcept Exception as e:\n    print('ERROR', type(e), e)\n    raise\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
