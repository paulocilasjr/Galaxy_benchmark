{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\ncounts_idx=pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0).index\nm=pd.read_csv('inputs/ensg_to_gene_name.tsv', sep='\\\\t')\nunmatched=set(counts_idx)-set(m['ENSG'])\nprint('counts genes', len(counts_idx), 'mapped', len(set(counts_idx)&set(m['ENSG'])), 'unmatched', len(unmatched))\n# show first 20\nprint(sorted(unmatched)[:20])\n# mapping of top DE ids in our pydeseq2? not here.\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
