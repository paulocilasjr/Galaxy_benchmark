{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\nimport gseapy\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\n# Prepare data\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\ncounts.index.name = 'gene'\nlayout = pd.read_csv('inputs/sample_layout.csv')\nlayout['sample'] = layout['SampleID'].str.replace('-', '_', regex=False)\nlayout = layout.set_index('sample')\ncounts = counts[layout.index].T\nmetadata = layout[['Group']].copy()\nmetadata.columns = ['group']\nmetadata['group'] = pd.Categorical(metadata['group'])\n\n# Differential expression: combined treatment vs DMSO\ndds = DeseqDataSet(\n    counts=counts,\n    metadata=metadata,\n    design='~group',\n    design_factors='group',\n    ref_level=['group','DMSO'],\n    n_cpus=4,\n    quiet=True,\n)\ndds.deseq2()\nstat = DeseqStats(\n    dds,\n    contrast=['group','Cisplatin_IC50_CBD_IC50','DMSO'],\n    alpha=0.05,\n    cooks_filter=True,\n    independent_filter=True,\n    n_cpus=4,\n    quiet=True,\n)\nstat.summary()\nres = stat.results_df.copy()\nmask = (res['padj'] < 0.05) & (res['log2FoldChange'].abs() >= 0.5)\ndegs = res.loc[mask]\nprint('DEG count:', len(degs))\n\n# Map Ensembl IDs to symbols for Enrichr\nmapping = pd.read_csv('inputs/ensg_to_gene_name.tsv', sep='\\\\t').set_index('ENSG')['gene_name']\nsymbols = degs.index.map(mapping).dropna().drop_duplicates().sort_values().tolist()\nprint('Mapped unique DEG symbols:', len(symbols))\n\n# gseapy Enrichr, Reactome_2022\nenr = gseapy.enrichr(gene_list=symbols, gene_sets='Reactome_2022', organism='human', outdir=None, cutoff=1.0)\nterm_target = 'TP53 Regulates Transcription Of Cell Cycle Genes'\nrows = enr.results[enr.results['Term'].str.contains(term_target, case=False, na=False)]\nprint('Target pathway rows:')\nprint(rows[['Term','Overlap','P-value','Adjusted P-value','Genes']].to_string(index=False))\nprint('ANSWER_OVERLAP=', rows.iloc[0]['Overlap'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\nimport gseapy\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\n# Prepare data\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\ncounts.index.name = 'gene'\nlayout = pd.read_csv('inputs/sample_layout.csv')\nlayout['sample'] = layout['SampleID'].str.replace('-', '_', regex=False)\nlayout = layout.set_index('sample')\ncounts = counts[layout.index].T\nmetadata = layout[['Group']].copy()\nmetadata.columns = ['group']\nmetadata['group'] = pd.Categorical(metadata['group'])\n\n# Differential expression: combined treatment vs DMSO\ndds = DeseqDataSet(\n    counts=counts,\n    metadata=metadata,\n    design='~group',\n    design_factors='group',\n    ref_level=['group','DMSO'],\n    n_cpus=4,\n    quiet=True,\n)\ndds.deseq2()\nstat = DeseqStats(\n    dds,\n    contrast=['group','Cisplatin_IC50_CBD_IC50','DMSO'],\n    alpha=0.05,\n    cooks_filter=True,\n    independent_filter=True,\n    n_cpus=4,\n    quiet=True,\n)\nstat.summary()\nres = stat.results_df.copy()\nmask = (res['padj'] < 0.05) & (res['log2FoldChange'].abs() >= 0.5)\ndegs = res.loc[mask]\nprint('DEG count:', len(degs))\n\n# Map Ensembl IDs to symbols for Enrichr\nmapping = pd.read_csv('inputs/ensg_to_gene_name.tsv', sep='\\\\t').set_index('ENSG')['gene_name']\nsymbols = degs.index.map(mapping).dropna().drop_duplicates().sort_values().tolist()\nprint('Mapped unique DEG symbols:', len(symbols))\n\n# gseapy Enrichr, Reactome_2022\nenr = gseapy.enrichr(gene_list=symbols, gene_sets='Reactome_2022', organism='human', outdir=None, cutoff=1.0)\nterm_target = 'TP53 Regulates Transcription Of Cell Cycle Genes'\nrows = enr.results[enr.results['Term'].str.contains(term_target, case=False, na=False)]\nprint('Target pathway rows:')\nprint(rows[['Term','Overlap','P-value','Adjusted P-value','Genes']].to_string(index=False))\nprint('ANSWER_OVE