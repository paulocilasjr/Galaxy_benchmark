{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, numpy as np, time\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\ncounts.index.name='gene'\nlayout = pd.read_csv('inputs/sample_layout.csv')\nlayout['sample'] = layout['SampleID'].str.replace('-', '_', regex=False)\nlayout = layout.set_index('sample')\ncounts = counts[layout.index].T\nmetadata = layout[['Group']].copy()\nmetadata.columns=['group']\nmetadata['group'] = pd.Categorical(metadata['group'])\nprint('counts samples x genes', counts.shape)\nprint(metadata)\n\nt0=time.time()\ndds = DeseqDataSet(\n    counts=counts,\n    metadata=metadata,\n    design='~group',\n    design_factors='group',\n    ref_level=['group','DMSO'],\n    n_cpus=4,\n    quiet=False,\n)\ndds.deseq2()\nprint('dds time', time.time()-t0, 'n_obs', dds.n_obs, 'n_vars', dds.n_vars)\nprint('layers', dds.layers.keys() if hasattr(dds, 'layers') else '')\nstat = DeseqStats(dds, contrast=['group','Cisplatin_IC50_CBD_IC50','DMSO'], alpha=0.05, cooks_filter=True, independent_filter=True, n_cpus=4, quiet=False)\nstat.summary()\nres = stat.results_df.copy()\nprint('res shape', res.shape)\nprint(res.head())\nprint('nonNA padj', res['padj'].notna().sum())\nprint('padj<0.05', (res['padj']<0.05).sum())\nprint('padj<0.05 & abs log2FC>=0.5', ((res['padj']<0.05)&(res['log2FoldChange'].abs()>=0.5)).sum())\nprint('NA padj', res['padj'].isna().sum())\nres.to_csv('/tmp/pydeseq2_res.csv')\nwith open('/tmp/pydeseq2_meta.txt','w') as f:\n    f.write(f'genes_after_filtering={dds.n_obs}\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
