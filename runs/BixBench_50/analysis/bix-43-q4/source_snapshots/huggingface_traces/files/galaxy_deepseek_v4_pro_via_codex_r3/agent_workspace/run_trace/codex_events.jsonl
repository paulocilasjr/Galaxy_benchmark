{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, json\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url=os.environ.get('GALAXY_URL','https://usegalaxy.org'), key=key)\npanel=gi.tools.get_tool_panel()\n# recursively print tool names containing deseq, gsea, enrich, reactome, differential\nterms=['deseq','gsea','gseapy','enrich','reactome','differential','rna']\ndef walk(sec, depth=0):\n    if 'elems' in sec:\n        for e in sec['elems']:\n            walk(e, depth+1)\n    else:\n        name=str(sec.get('name','')) + ' ' + str(sec.get('id',''))\n        if any(t.lower() in name.lower() for t in terms):\n            print('\\\\t'*depth, sec.get('id'), '|', sec.get('name'))\nfor sec in panel:\n    walk(sec)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
