":\"data\",\"optional\":false,\"help\":\"\",\"extensions\":[\"gtf\",\"gff3\"],\"multiple\":false}]},{\"value\":\"tabular\",\"inputs\":[{\"name\":\"tabular_file\",\"label\":\"Tabular file with Transcript-ID to Gene-ID mapping\",\"type\":\"data\",\"optional\":false,\"help\":\"\",\"extensions\":[\"tabular\"],\"multiple\":false}]}]}]},{\"value\":\"count\",\"inputs\":[]}]},{\"name\":\"advanced_options\",\"label\":\"\",\"type\":\"section\",\"optional\":false,\"help\":null,\"inputs\":[{\"name\":\"esf_cond\",\"label\":\"\",\"type\":\"conditional\",\"optional\":false,\"help\":\"\",\"test_param\":{\"name\":\"esf\",\"label\":\"Method for estimateSizeFactors\",\"type\":\"select\",\"optional\":false,\"help\":\"Method for estimation: either 'ratio', 'poscounts', or 'iterate'. 'ratio' uses the standard median ratio method introduced in DESeq.                         The size factor is the median ratio of the sample over a 'pseudosample': for each gene, the geometric mean of all samples.                         'poscounts' and 'iterate' offer alternative estimators, which can be used even when all genes contain a sample with a zero (a problem                         for the default method, as the geometric mean becomes zero, and the ratio undefined). The 'poscounts' estimator deals with a gene with                         some zeros, by calculating a modified geometric mean by taking the n-th root of the product of the non-zero counts. This evolved out of                         use cases with Paul McMurdie's phyloseq package for metagenomic samples. The 'iterate' estimator iterates between estimating the dispersion                         with a design of ~1, and finding a size factor vector by numerically optimizing the likelihood of the ~1 model.\",\"options\":[{\"label\":\"No Selection (use default)\",\"value\":\"\"},{\"label\":\"ratio\",\"value\":\"ratio\"},{\"label\":\"poscounts\",\"value\":\"poscounts\"},{\"label\":\"iterate\",\"value\":\"iterate\"},{\"label\":\"User-provided\",\"value\":\"user\"}],\"default\":\"\",\"multiple\":false},\"cases\":[{\"value\":\"\",\"inputs\":[]},{\"value\":\"ratio\",\"inputs\":[]},{\"value\":\"poscounts\",\"inputs\":[]},{\"value\":\"iterate\",\"inputs\":[]},{\"value\":\"user\",\"inputs\":[{\"name\":\"size_factor_input\",\"label\":\"File with custom size factors\",\"type\":\"data\",\"optional\":false,\"help\":\"The input must be a 2-column file: col1 should have the input file names. Col2 should contain your custom size factors.\",\"extensions\":[\"tabular\"],\"multiple\":false}]}]},{\"name\":\"fit_type\",\"label\":\"Fit type\",\"type\":\"select\",\"optional\":false,\"help\":\"\",\"options\":[{\"label\":\"parametric\",\"value\":\"1\"},{\"label\":\"local\",\"value\":\"2\"},{\"label\":\"mean\",\"value\":\"3\"}],\"default\":\"1\",\"multiple\":false},{\"name\":\"outlier_replace_off\",\"label\":\"Turn off outliers replacement (only affects with >6 replicates)\",\"type\":\"boolean\",\"optional\":false,\"help\":\"When there are more than 6 replicates for a given sample, the DESeq2 will automatically replace                     counts with large Cook\\u2019s distance with the trimmed mean over all samples, scaled up by the size factor                     or normalization factor for that sample\",\"default\":false,\"truevalue\":\"-a\",\"falsevalue\":\"\"},{\"name\":\"outlier_filter_off\",\"label\":\"Turn off outliers filtering (only affects with >2 replicates)\",\"type\":\"boolean\",\"optional\":false,\"help\":\"When there are more than 2 replicates for a given sample, the DESeq2 will automatically                     filter genes which contain a Cook\\u2019s distance above a cutoff\",\"default\":false,\"truevalue\":\"-b\",\"falsevalue\":\"\"},{\"name\":\"auto_mean_filter_off\",\"label\":\"Turn off independent filtering\",\"type\":\"boolean\",\"optional\":false,\"help\":\" DESeq2 performs independent filtering by default using the mean of normalized counts as a filter statistic\",\"default\":false,\"truevalue\":\"-c\",\"falsevalue\":\"\"},{\"name\":\"prefilter_conditional\",\"label\":\"\",\"type\":\"conditional\",\"optional\":false,\"help\":\"\",\"test_param\":{\"name\":\"prefilter\",\"label\":\"Perform pre-filtering\",\"type\":\"select\",\"optional\":false,\"help\":\"While it is not necessary to pre-filter                     low count genes before running the DESeq2 functions, there are two reasons which make pre-filtering useful:                     by removing rows in which there are very few reads, we reduce the required memory, and we increase the speed.                     It can also improve visualizations, as features with no information for differential expression are not plotted.\",\"options\":[{\"label\":\"Enabled\",\"value\":\"-P\"},{\"label\":\"Disabled\",\"value\":\"\"}],\"default\":\"\",\"multiple\":false},\"cases\":[{\"value\":\"-P\",\"inputs\":[{\"name\":\"prefilter_value\",\"label\":\"Pre-filter value\",\"type\":\"integer\",\"optional\":false,\"help\":\"Keep only rows that have at least N reads total.\",\"default\":\"10\",\"min\":0,\"max\":null}]},{\"value\":\"\",\"inputs\":[]}]},{\"name\":\"use_beta_priors\",\"label\":\"Use beta priors\",\"type\":\"boolean\",\"optional\":false,\"help\":\"Whether or not to put a zero-mean normal prior on the non-intercept coefficients\",\"default\":false,\"truevalue\":\"-d\",\"falsevalue\":\"\"},{\"name\":\"lfc_shrinkage_type\",\"label\":\"Log2 fold-change shrinkage after DESeq2\",\"type\":\"select\",\"optional\":false,\"help\":\"\",\"options\":[{\"label\":\"Do not apply lfcShrink\",\"value\":\"none\"},{\"label\":\"DESeq2 lfcShrink: normal\",\"value\":\"normal\"},{\"label\":\"DESeq2 lfcShrink: apeglm\",\"value\":\"apeglm\"},{\"label\":\"DESeq2 lfcShrink: ashr\",\"value\":\"ashr\"}],\"default\":\"none\",\"multiple\":false}],\"expanded\":false},{\"name\":\"output_options\",\"label\":\"\",\"type\":\"section\",\"optional\":false,\"help\":null,\"inputs\":[{\"name\":\"output_selector\",\"label\":\"Output selector\",\"type\":\"select\",\"optional\":true,\"help\":\"\",\"options\":[{\"label\":\"Generate plots for visualizing the analysis results (rlog for up to 30 samples; VST for larger datasets)\",\"value\":\"pdf\"},{\"label\":\"Output sample size factors\",\"value\":\"sizefactors\"},{\"label\":\"Output normalised counts\",\"value\":\"normCounts\"},{\"label\":\"Output VST normalized table\",\"value\":\"normVST\"},{\"label\":\"Output rLog normalized table\",\"value\":\"normRLog\"},{\"label\":\"Output all levels vs all levels of primary factor (use when you have >2 levels for primary factor)\",\"value\":\"many_contrasts\"}],\"default\":\"pdf\",\"multiple\":true},{\"name\":\"alpha_ma\",\"label\":\"Alpha value for MA-plot\",\"type\":\"float\",\"optional\":false,\"help\":\"Default value is 0.1. This option is only meaninful when plots are generated\",\"default\":\"0.1\",\"min\":0.0,\"max\":0.5}],\"expanded\":false}],\"outputs\":[{\"name\":\"split_output\",\"format\":null,\"label\":\"DESeq2 result files on ${on_string}\"},{\"name\":\"deseq_out\",\"format\":\"tabular\",\"label\":\"DESeq2 result file on ${on_string}\"},{\"name\":\"plots\",\"format\":\"pdf\",\"label\":\"DESeq2 plots on ${on_string}\"},{\"name\":\"sizefactors_out\",\"format\":\"tabular\",\"label\":\"Size Factors on ${on_string}\"},{\"name\":\"counts_out\",\"format\":\"tabular\",\"label\":\"Normalized counts file on ${on_string}\"},{\"name\":\"rlog_out\",\"format\":\"tabular\",\"label\":\"rLog-Normalized counts file on ${on_string}\"},{\"name\":\"vst_out\",\"format\":\"tabular\",\"label\":\"VST-Normalized counts file on ${on_string}\"}],\"edam_topics\":[\"topic_3308\"],\"edam_operations\":[\"operation_3800\"],\"requirements\":[],\"help\":\"\"}\n","exit_code":0,"status":"completed"}}
