{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"curl -L --max-time 20 -s https://raw.githubusercontent.com/JLSteenwyk/PhyKIT/master/phykit/services/tree/base.py | grep -n -A120 'simple_newick_summary\\\\|calculate_treeness'\"","aggregated_output":"280:    def _cached_simple_newick_summary(file_path: str, file_hash: str):\n281:        return Tree._scan_simple_newick_summary(file_path)\n282-\n283-    @staticmethod\n284-    @lru_cache(maxsize=32)\n285-    def _cached_simple_newick_tip_names(file_path: str, file_hash: str):\n286-        return Tree._scan_simple_newick_tip_names(file_path)\n287-\n288-    @staticmethod\n289-    @lru_cache(maxsize=32)\n290-    def _cached_simple_newick_terminal_distance_stats(\n291-        file_path: str,\n292-        file_hash: str,\n293-    ):\n294-        return Tree._scan_simple_newick_terminal_distance_stats(file_path)\n295-\n296-    @staticmethod\n297-    def _get_file_hash(file_path: str) -> str:\n298-        \"\"\"Get a hash based on file path, size, and modification time.\"\"\"\n299-        try:\n300-            stat = os.stat(file_path)\n301-            return f\"{file_path}_{stat.st_size}_{stat.st_mtime_ns}\"\n302-        except OSError:\n303-            return \"\"\n304-\n305-    def read_tree_file(self):\n306-        return self._read_tree_with_error(self.tree_file_path, \"tree_file_path\")\n307-\n308-    def read_tree_file_unmodified(self):\n309-        return self._read_tree_with_error(\n310-            self.tree_file_path,\n311-            \"tree_file_path\",\n312-            copy_tree=False,\n313-        )\n314-\n315-    def read_tree1_file(self):\n316-        return self._read_tree_with_error(self.tree1_file_path, \"tree1_file_path\")\n317-\n318-    def read_tree1_file_unmodified(self):\n319-        return self._read_tree_with_error(\n320-            self.tree1_file_path,\n321-            \"tree1_file_path\",\n322-            copy_tree=False,\n323-        )\n324-\n325-