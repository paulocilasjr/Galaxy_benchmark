{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport zipfile, math\np='inputs/scogs_fungi.zip'\n# PhyKIT simple newick summary parser replicating _scan_simple_newick_summary\ndef scan(text):\n    text=text.strip()\n    if not text or any(c in text for c in \\\"'\\\\\\\"[]\\\"):\n        return None\n    tip_names=[]; total=0.0; internal=0.0; prev=None; i=0; n=len(text)\n    delims='(),:;'; ws=' \\\\t\\\\r\\\\n'\n    while i<n:\n        ch=text[i]\n        if ch in ws:\n            i+=1; continue\n        if ch=='(':\n            if prev not in (None,'(',','): return None\n            prev='('; i+=1; continue\n        if ch==',':\n            if prev in (None,'(',','): return None\n            prev=','; i+=1; continue\n        if ch==')':\n            if prev in (None,'(',','): return None\n            prev=')'; i+=1; continue\n        if ch==';':\n            if len(set(tip_names))\"'!=len(tip_names): return None\n            return tip_names,total,internal\n        if ch=='\"':':\n            if prev in (None,'(',','): return None\n            i+=1; start=i\n            while i<n and text[i] not in ',);':\n                if text[i] in ws: break\n                i+=1\n            number=text[start:i]\n            if not number: return None\n            try: bl=float(number)\n            except: return None\n            if not math.isfinite(bl): return None\n            total+=bl\n            if prev in (')','internal_label'): internal+=bl\n            prev='branch_length'; continue\n        start=i\n        while i<n and text[i] not in delims and text[i] not in ws: i+=1\n        token=text[start:i]\n        if not token: return None\n        if prev in ('(',',',None):\n            tip_names.append(token); prev='terminal_label'\n        elif prev==')': prev='internal_label'\n        else: return None\n    return None\n\nvals=[]\nwith zipfile.ZipFile(p) as z:\n    names=sorted(n for n in z.namelist() if n.endswith('.treefile'))\n    for name in names:\n        text=z.read(name).decode()\n        res=scan(text)\n        if res is None: print('FAILED',name,text[:100]); continue\n        tips,total,internal=res\n        t=internal/total if total else None\n        vals.append((name,t,internal,total))\nprint('n',len(vals))\nfor name,t,i,total in vals:\n    if t is not None and 0.05 < t < 0.07:\n        print('near',name,t,round(t,4),i,total)\nprint('raw >0.06', sum(1 for _,t,_,_ in vals if t is not None and t>0.06))\nprint('round4 >0.06', sum(1 for _,t,_,_ in vals if t is not None and round(t,4)>0.06))\nprint('raw count exact equal?', [(name,t) for name,t,i,total in vals if t is not None and abs(t-0.06)<1e-12][:10])\nprint('total internal stats')\nimport statistics\nts=[t for _,t,_,_ in vals if t is not None]\nprint(len(ts),min(ts),max(ts),statistics.median(ts),sum(t>0.06 for t in ts),sum(t>0.06 for t in ts)/len(ts)*100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
