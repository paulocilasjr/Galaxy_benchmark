{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport zipfile, re\nfor p in ['inputs/scogs_fungi.zip']:\n with zipfile.ZipFile(p) as z:\n  names=z.namelist()\n  raw=set(); mafft=set(); clip=set(); tree=set(); iq=set(); bionj=set(); mldist=set()\n  for n in names:\n   base=n\n   for suf in ['.faa.mafft.clipkit.treefile','.faa.mafft.clipkit.iqtree','.faa.mafft.clipkit.bionj','.faa.mafft.clipkit.mldist','.faa.mafft.clipkit','.faa.mafft','.faa']:\n    if n.endswith(suf):\n     b=n[:-len(suf)]\n     if suf=='.faa': raw.add(b)\n     elif suf=='.faa.mafft': mafft.add(b)\n     elif suf=='.faa.mafft.clipkit': clip.add(b)\n     elif suf=='.faa.mafft.clipkit.treefile': tree.add(b)\n     elif suf=='.faa.mafft.clipkit.iqtree': iq.add(b)\n     elif suf=='.faa.mafft.clipkit.bionj': bionj.add(b)\n     elif suf=='.faa.mafft.clipkit.mldist': mldist.add(b)\n     break\n  print('raw',len(raw),'mafft',len(mafft),'clip',len(clip),'tree',len(tree),'iq',len(iq),'bionj',len(bionj),'mldist',len(mldist))\n  print('raw not tree', sorted(raw-tree)[:20], len(raw-tree))\n  print('tree not raw', sorted(tree-raw)[:20], len(tree-raw))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
