{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport zipfile\nz=zipfile.ZipFile('/workspace/inspect/scogs_fungi.zip')\n# Print first treefile content and some alignment names, counts\nfor m in z.namelist():\n    if m.endswith('.treefile'):\n        print('TREE', m)\n        print(z.read(m).decode('utf-8','replace'))\n        break\nprint('--- faa sample')\nfor m in z.namelist():\n    if m.endswith('.faa'):\n        data=z.read(m).decode('utf-8','replace')\n        print(m)\n        print(data[:500])\n        break\n# list treefile base names and faa base names differences\nfaa=set(m.rsplit('.',1)[0] for m in z.namelist() if m.endswith('.faa'))\ntf=set(m.rsplit('.mafft.clipkit.treefile',1)[0] for m in z.namelist() if m.endswith('.treefile'))\nprint('faa count',len(faa),'treefile count',len(tf),'faa not treefile',sorted(faa-tf)[:20],len(faa-tf))\nprint('treefile not faa', sorted(tf-faa)[:5],len(tf-faa))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
