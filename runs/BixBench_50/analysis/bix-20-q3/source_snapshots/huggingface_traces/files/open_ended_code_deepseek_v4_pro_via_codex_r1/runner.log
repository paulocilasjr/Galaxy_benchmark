{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, glob, re, math\nfrom openpyxl import load_workbook\nfrom collections import Counter\n\n# read statuses\nwb=load_workbook('inputs/230215_Trio_Status.xlsx', read_only=False, data_only=True)\nws=wb.active\nstatus_rows=list(ws.iter_rows(min_row=2, values_only=True))\nstatus={}\nfor row in status_rows:\n    if row[0] is None: continue\n    sid=str(row[0]).rstrip('\\\\t').strip()\n    status[sid]=row\nwb.close()\n\n# carrier status IDs (numeric core)\ncarrier_cores=set()\nfor sid,row in status.items():\n    if row[3] == 'Carrier':\n        carrier_cores.add(sid)\nprint('carrier status IDs', sorted(carrier_cores, key=lambda x:(x.startswith('SRR'), x)))\n\nfiles=sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\ncarrier_files=[]\nfor f in files:\n    base=os.path.basename(f)[:-5]\n    sample=base.split('_CHIP_',1)[1]\n    if sample.startswith('SRR'):\n        core=sample\n    else:\n        core=sample.split('-')[0]\n    if core in carrier_cores:\n        carrier_files.append((core,sample,f))\nprint('carrier files count',len(carrier_files))\nfor x in carrier_files: print(x[:2])\n\nregion_bad=('intron','intergenic','utr')\nstage=Counter()\nclass_counter=Counter()\nregion_counter=Counter()\nvaf_problems=[]\nrows=[]\nfor core,sample,f in carrier_files:\n    wb=load_workbook(f, read_only=False, data_only=True)\n    ws=wb.active\n    data=list(ws.iter_rows(min_row=3, max_col=33, values_only=True))\n    wb.close()\n    for row in data:\n        # extract col indexes 1-based: chr1 ref2 zyg5 vaf10 seq14 class26\n        zyg=row[4] if len(row)>4 else None\n        vaf_raw=row[9] if len(row)>9 else None\n        seq=row[13] if len(row)>13 else None\n        cls=row[25] if len(row)>25 else None\n        stage['total']+=1\n        # reference filter\n        if zyg=='Reference':\n            stage['reference']+=1\n            continue\n        stage['nonreference']+=1\n        # region filter\n        seq_s=str(seq or '')\n        seq_lower=seq_s.lower()\n        bad=any(t in seq_lower for t in region_bad)\n        if bad:\n            region_counter[seq_s]+=1\n            stage['region_removed']+=1\n            continue\n        stage['after_region']+=1\n        # vaf filter\n        if vaf_raw is None:\n            stage['vaf_missing']+=1\n            continue\n        try:\n            vaf=float(str(vaf_raw).strip())\n        except Exception:\n            vaf_problems.append((f,vaf_raw,row[0]))\n            stage['vaf_bad']+=1\n            continue\n        if not (vaf < 0.3):\n            stage['vaf_ge03']+=1\n            continue\n        stage['somatic_vaf<0.3']+=1\n        # clinvar classification present\n        cls_s=str(cls or '').strip()\n        if cls_s=='':\n            stage['class_missing']+=1\n            continue\n        stage['classified']+=1\n        class_counter[cls_s]+=1\n        if cls_s in ('Benign','Likely Benign'):\n            stage['benign_likelybenign']+=1\nprint('\\\\nstages')\nfor k in ['total','reference','nonreference','region_removed','after_region','vaf_missing','vaf_bad','vaf_ge03','somatic_vaf<0.3','class_missing','classified','benign_likelybenign']:\n    print(k, stage[k])\nprint('class_counter',class_counter)\nprint('region_counter after reference',region_counter)\nprint('vaf_problems',vaf_problems[:20], len(vaf_problems))\nif stage['classified']:\n    print('proportion', stage['benign_likelybenign']/stage['classified'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
