{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport glob, os, re\nfrom openpyxl import load_workbook\n# status\nwb=load_workbook('inputs/230215_Trio_Status.xlsx', read_only=True, data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(min_row=2, values_only=True))\nstatus={}\nfor r in rows:\n    sid=r[0]\n    if sid is None: continue\n    s=str(sid).strip()\n    # strip trailing tab\n    s=s.rstrip('\\\\t').strip()\n    status[s]=r\nwb.close()\nprint('num status',len(status))\nfiles=sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\nprint('num files',len(files))\nfor f in files:\n    base=os.path.basename(f)[:-5]\n    m=re.match(r'230209_Exome_GRCh38_CHIP_(.+)', base)\n    sample=m.group(1)\n    # extract core id: before suffix and/or after; if SRR use full\n    core=sample\n    # match status by trying sample, strip P/PM/PF suffix? only non SRR? IDs numeric\n    if sample.startswith('SRR'):\n        key=sample\n    else:\n        key=sample.split('-')[0]\n    st=status.get(key)\n    blm=st[3] if st else None\n    print(sample, '->', key, 'BLM=', blm, 'Status=', st[1] if st else None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
