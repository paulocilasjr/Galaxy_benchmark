{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# compute unique variant id among filtered rows\nimport os,glob\nfrom openpyxl import load_workbook\nwb=load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True);ws=wb.active\nstatus={}\nfor r in ws.iter_rows(min_row=2,values_only=True):\n if r[0] is not None: status[str(r[0]).rstrip('\\\\t').strip()]=r\nwb.close(); carrier=set(k for k,r in status.items() if r[3]=='Carrier')\nids=[]\nclass_by_id={}\nfor f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n sample=os.path.basename(f)[:-5].split('_CHIP_',1)[1]\n core=sample if sample.startswith('SRR') else sample.split('-')[0]\n if core not in carrier: continue\n wb=load_workbook(f,data_only=True);ws=wb.active\n for r in ws.iter_rows(min_row=3,values_only=True):\n  zyg=r[4]; seq=str(r[13] or '').lower(); v=r[9]; cls=r[25]; vid=r[24]\n  if zyg=='Reference': continue\n  if any(t in seq for t in ('intron','intergenic','utr')): continue\n  if v is None: continue\n  try: val=float(str(v).strip())\n  except: continue\n  if val<0.3 and str(cls or '').strip()\"'!='\"'':\n   ids.append(vid); class_by_id.setdefault(vid,set()).add(cls)\n wb.close()\nprint('rows',len(ids),'unique variant ids',len(set(ids)))\nfrom collections import Counter\nprint('unique class sets',Counter(tuple(sorted(s)) for s in class_by_id.values()))\nprint('all unique B/LB', all(set(s)<= {'Benign','Likely Benign'} for s in class_by_id.values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
