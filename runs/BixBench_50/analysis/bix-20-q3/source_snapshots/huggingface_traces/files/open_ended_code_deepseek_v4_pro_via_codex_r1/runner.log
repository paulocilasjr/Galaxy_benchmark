{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os,glob\nfrom openpyxl import load_workbook\nfrom collections import Counter,defaultdict\n# status carrier\nwb=load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True); ws=wb.active\nstatus={}\nfor row in ws.iter_rows(min_row=2,values_only=True):\n    if row[0] is None: continue\n    status[str(row[0]).rstrip('\\\\t').strip()]=row\nwb.close()\ncarrier=set(k for k,r in status.items() if r[3]=='Carrier')\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nrows=[]\nfor f in files:\n    sample=os.path.basename(f)[:-5].split('_CHIP_',1)[1]\n    core=sample if sample.startswith('SRR') else sample.split('-')[0]\n    if core not in carrier: continue\n    wb=load_workbook(f,data_only=True); ws=wb.active\n    for r in ws.iter_rows(min_row=3,values_only=True):\n        chrpos=r[0]; refalt=r[1]; zyg=r[4]; vaf_raw=r[9]; gene=r[12]; seq=r[13]; cls=r[25]\n        if zyg=='Reference': continue\n        seq_s=str(seq or '').lower()\n        if any(t in seq_s for t in ('intron','intergenic','utr')): continue\n        if vaf_raw is None: continue\n        try: vaf=float(str(vaf_raw).strip())\n        except: continue\n        if vaf<0.3 and str(cls or '').strip()\"'!='\"'':\n            rows.append((sample,chrpos,refalt,zyg,vaf_raw,gene,seq,cls,str(r[26]),str(r[27])))\n    wb.close()\nprint('count',len(rows))\nprint('benign count',sum(1 for r in rows if r[7] in ('Benign','Likely Benign')))\nfor i,r in enumerate(rows,1):\n    print(i,r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
