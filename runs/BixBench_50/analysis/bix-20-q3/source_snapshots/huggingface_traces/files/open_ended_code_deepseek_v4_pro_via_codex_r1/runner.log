{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport glob, os\nfrom openpyxl import load_workbook\n# carrier status\nwb=load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True); ws=wb.active\nstatus={}\nfor row in ws.iter_rows(min_row=2,values_only=True):\n    if row[0] is None: continue\n    status[str(row[0]).rstrip('\\\\t').strip()]=row\nwb.close()\ncarrier=set(k for k,r in status.items() if r[3]=='Carrier')\nfor f in sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')):\n    sample=os.path.basename(f)[:-5].split('_CHIP_',1)[1]\n    core=sample if sample.startswith('SRR') else sample.split('-')[0]\n    if core not in carrier: continue\n    wb=load_workbook(f,data_only=True); ws=wb.active\n    lens=[len(r) for r in ws.iter_rows(min_row=3,values_only=True)]\n    print(sample, ws.max_row, 'data',len(lens),'minlen',min(lens),'maxlen',max(lens),'n_short',sum(1 for x in lens if x<31))\n    wb.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
