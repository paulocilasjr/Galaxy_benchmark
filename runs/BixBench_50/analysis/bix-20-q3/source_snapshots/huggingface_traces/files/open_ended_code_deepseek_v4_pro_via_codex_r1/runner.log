{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom collections import Counter, defaultdict\nf='inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_184-PM.xlsx'\nwb=load_workbook(f, data_only=False)\nws=wb.active\nprint('dims',ws.max_row,ws.max_column)\n# columns as headers row2\nheaders=[ws.cell(2,c).value for c in range(1,ws.max_column+1)]\nfor i,h in enumerate(headers,1): print(i,repr(h))\n# unique nonempty for each column relevant\ncols_to_show=list(range(1,ws.max_column+1))\nuniques={}\nfor r in range(3,ws.max_row+1):\n    for c in cols_to_show:\n        v=ws.cell(r,c).value\n        if v is not None:\n            uniques.setdefault(c,set()).add(v)\nfor c in sorted(uniques):\n    print('\\\\nCOL',c,headers[c-1], 'nunique', len(uniques[c]))\n    vals=sorted(uniques[c], key=lambda x: str(x))\n    print(vals[:50])\n    if len(vals)>50: print('...')\nwb.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
