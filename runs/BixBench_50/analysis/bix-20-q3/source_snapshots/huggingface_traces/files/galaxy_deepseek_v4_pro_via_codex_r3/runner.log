{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/tmp/inspect; python3 - <<'PY'\nimport openpyxl, glob, re, collections, os, math\n# Trio carrier IDs\nwb=openpyxl.load_workbook('/workspace/tmp/downloads/Trio_Status.xlsx', data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(values_only=True))\ncarriers=set()\nfor r in rows[1:]:\n if r[3]=='Carrier': carriers.add(str(r[0]).strip())\nprint('carriers', len(carriers), sorted(carriers))\nfiles={}\nfor fn in glob.glob('*.xlsx'):\n m=re.search(r'CHIP_(?:(\\\\d+)|(SRR\\\\d+))',fn)\n if m: files[m.group(1) or m.group(2)] = fn\n# Function parse file\nall_cnt=collections.Counter(); seq_terms=collections.Counter(); zyg=collections.Counter(); classif=collections.Counter(); vaf_status=collections.Counter()\nexamples=[]\nfor sid in sorted(carriers):\n if sid not in files: continue\n fn=files[sid]\n w=openpyxl.load_workbook(fn, data_only=True)\n s=w.active\n rows=list(s.iter_rows(values_only=True))\n if len(rows)<3: continue\n h1=rows[0]; h2=rows[1]\n # indexes\n idx={name:i for i,name in enumerate(h2) if name}\n # data rows\n n=0\n for r in rows[2:]:\n  if any(v is not None for v in r[:33]): n+=1\n all_cnt[sid]=n\n print(sid, fn, 'maxrow',s.max_row,'datacols',n)\n # count key values\n for r in rows[2:]:\n  zy=r[4]; so=r[13]; cl=r[25]; inchip=r[29]; vaf=r[9]\n  zyg[str(zy)] += 1\n  if so: seq_terms[str(so)] += 1\n  if cl: classif[str(cl)] += 1\n  # nonref vaf distribution\n  if zy\"'!='\"'Reference':\n   vaf_status[(isinstance(vaf,(int,float)), str(vaf))] += 1\n w.close()\nprint('\\\\nZygosity counts',zyg)\nprint('\\\\nSeq terms top',seq_terms.most_common(40))\nprint('\\\\nClassification counts',classif)\nprint('\\\\nnonref vaf status', vaf_status.most_common(20))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
