{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,openpyxl\nitems=json.load(open('/workspace/tmp/datasets.json'))\n# trio carriers\nwb=openpyxl.load_workbook('/workspace/tmp/downloads/Trio_Status.xlsx',data_only=True)\nws=wb.active\ncarriers=set()\nfor row in ws.iter_rows(values_only=True):\n if row[3]=='Carrier':\n  carriers.add(str(row[0]).strip())\nprint('carriers',sorted(carriers))\nres=[]\nfor d in items:\n name=d['name']\n m=re.search(r'CHIP_(?:(\\\\d+)|(SRR\\\\d+))', name)\n if not m: continue\n sid=m.group(1) or m.group(2)\n if sid in carriers:\n  res.append((sid,name,d['id'],d['extension'],d['state']))\nprint('n',len(res))\nfor r in sorted(res,key=lambda x:int(x[0])): print(r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
