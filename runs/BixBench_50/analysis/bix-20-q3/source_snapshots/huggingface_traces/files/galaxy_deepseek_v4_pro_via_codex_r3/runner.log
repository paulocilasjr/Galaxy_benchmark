{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/tmp/inspect; python3 - <<'PY'\nimport openpyxl,glob,re,collections\n# one file\nfn='230209_Exome_GRCh38_CHIP_184-PM.xlsx'\nwb=openpyxl.load_workbook(fn,data_only=True); ws=wb.active; rows=list(ws.iter_rows(values_only=True)); h2=rows[1]\nidx={n:i for i,n in enumerate(h2) if n}\nc=collections.Counter()\nfor r in rows[2:]:\n c[str(r[idx['In_CHIP']])]+=1\nprint('In_CHIP counts',c)\n# gene names not in chip? compare CHIP_Genes\nchip=set()\nwg=openpyxl.load_workbook('/workspace/tmp/downloads/CHIP_Genes.xlsx',data_only=True).active\nfor row in wg.iter_rows(values_only=True):\n if row[0]: chip.add(str(row[0]).strip())\nprint('chip genes',len(chip), sorted(chip))\ngenes=collections.Counter()\nfor r in rows[2:]:\n g=r[idx['Gene Names']]\n if g:\n  for x in str(g).split(','):\n   genes[x.strip()]+=1\nprint('genes count',len(genes))\nprint('not in chip', sorted(set(genes)-chip))\nprint('in chip gene rows', sum(1 for r in rows[2:] if r[idx['In_CHIP']]=='True'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
