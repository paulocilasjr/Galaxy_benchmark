{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os, json, time\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nwith open('/workspace/tmp/xlsx_map_result.json') as f: res=json.load(f)\njobs=[j['id'] for j in res['jobs']]\npending=set(jobs)\nterminal={'ok','error','deleted','deleted_new','failed'}\nlast=time.time()\nwhile pending:\n    still=set()\n    for jid in pending:\n        try:\n            j=gi.jobs.show_job(jid)\n        except Exception as e:\n            print('ERR show',jid,e); still.add(jid); continue\n        st=j.get('state')\n        if st in terminal:\n            print(jid,st,j.get('exit_code'))\n        else:\n            still.add(jid)\n    pending=still\n    if pending:\n        if time.time()-last>300:\n            print('still pending',len(pending), list(pending)[:5]); last=time.time()\n        time.sleep(5)\nprint('all terminal')\n# show collection\ncid='1ec53cba8bd34816'\ntry:\n c=gi.histories.show_dataset_collection('bbd44e69cb8906b501f52efa42087e1e',cid)\n print('collection',c.get('collection_type'),c.get('state'),c.get('element_count'))\n for e in c.get('elements',[]):\n  print(e.get('element_identifier'), e.get('object',{}).get('id'), e.get('object',{}).get('state'), e.get('object',{}).get('file_ext'))\nexcept Exception as e:\n print('ERR coll',e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
