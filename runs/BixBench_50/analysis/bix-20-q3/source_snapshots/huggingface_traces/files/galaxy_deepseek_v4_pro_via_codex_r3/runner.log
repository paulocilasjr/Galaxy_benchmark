{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/tmp/inspect; python3 - <<'PY'\nimport openpyxl, glob, re, os\nfiles=sorted(glob.glob('*.xlsx'))\nwb=openpyxl.load_workbook('/workspace/tmp/downloads/Trio_Status.xlsx', data_only=True)\nws=wb.active\ntrio=[]\nfor i,row in enumerate(ws.iter_rows(values_only=True)):\n if i==0: continue\n sid=str(row[0]).strip()\n trio.append((sid,row[1],row[2],row[3]))\n# file ids\nfile_ids=[]\nfor fn in files:\n m=re.search(r'CHIP_(?:(\\\\d+)|(SRR\\\\d+))', fn)\n if m:\n  sid=m.group(1) or m.group(2)\n  file_ids.append((sid,fn))\n# carrier IDs\ncarrier=[sid for sid,st,sex,blm in trio if blm=='Carrier']\nprint('trio rows',len(trio),'files',len(file_ids),'carriers',len(carrier))\nprint('carriers:', sorted(carrier))\n# compare sets\ntrio_ids={x[0] for x in trio}\nfids={x[0] for x in file_ids}\nprint('trio - files', sorted(trio_ids-fids))\nprint('files - trio', sorted(fids-trio_ids))\nprint('duplicate file ids', [x for x in fids if sum(1 for y in file_ids if y[0]==x)>1])\n# carriers not in files\nprint('carrier missing files', sorted(set(carrier)-fids))\n# carrier files\nfor sid in sorted(set(carrier)&fids):\n print(sid, [fn for i,fn in file_ids if i==sid])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
