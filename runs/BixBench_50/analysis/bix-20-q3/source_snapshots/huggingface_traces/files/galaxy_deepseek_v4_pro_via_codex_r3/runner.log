{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/tmp/inspect; python3 - <<'PY'\nimport openpyxl,glob,re,collections,os\n# load trio and carrier\ntwb=openpyxl.load_workbook('/workspace/tmp/downloads/Trio_Status.xlsx',data_only=True)\ntws=twb.active; trows=list(tws.iter_rows(values_only=True))\ncarriers=set()\nfor r in trows[1:]:\n if r[3]=='Carrier': carriers.add(str(r[0]).strip())\nfiles={}\nfor fn in glob.glob('*.xlsx'):\n m=re.search(r'CHIP_(?:(\\\\d+)|(SRR\\\\d+))',fn)\n if m: files[m.group(1) or m.group(2)] = fn\nBAD_SO=['intron_variant','intergenic_variant','intergenic_region','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant','UTR_variant']\ndef numeric(s):\n try: return float(s)\n except: return None\ncounts=collections.Counter(); per={}\nfor sid in sorted(carriers):\n fn=files.get(sid)\n if not fn: continue\n wb=openpyxl.load_workbook(fn,data_only=True); ws=wb.active; rows=list(ws.iter_rows(values_only=True)); h2=rows[1]\n idx={n:i for i,n in enumerate(h2) if n}\n for r in rows[2:]:\n  zy=r[idx['Zygosity']]\n  if zy=='Reference': continue\n  vaf=numeric(r[idx['Variant Allele Freq']])\n  if vaf is None or vaf >= 0.3: continue\n  so=str(r[idx['Sequence Ontology (Combined)']] or '')\n  if any(term in so for term in BAD_SO): continue\n  cl=r[idx['Classification']]\n  if cl is None or str(cl).strip()=='' : continue\n  counts['total'] +=1\n  per[sid]=per.get(sid,0)+1\n  if str(cl).strip() in ('Benign','Likely Benign'):\n   counts['benign_lb'] +=1\nprint('counts',counts)\nprint('per',per)\nprint('prop', counts['benign_lb']/counts['total'] if counts['total'] else None)\nprint('total carriers files',sum(1 for sid in carriers if sid in files))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
