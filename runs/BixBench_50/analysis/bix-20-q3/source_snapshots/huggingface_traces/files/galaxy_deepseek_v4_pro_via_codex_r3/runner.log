{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os,json,time\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org',key=key)\nh='bbd44e69cb8906b501f52efa42087e1e'\nids={\n'185':'f9cad7b01a472135066b70692e617a53',\n'285':'f9cad7b01a472135657158d0843c4bc0',\n'287':'f9cad7b01a472135273f88d65e656449',\n'353':'f9cad7b01a47213585dc067cd96c1268',\n'354':'f9cad7b01a472135f47fc9c992705e6a',\n'396':'f9cad7b01a4721353ca64ad4b25c28b6',\n'397':'f9cad7b01a4721359920bd290032bef6',\n'489':'f9cad7b01a4721358c2e288a32d3a932',\n'490':'f9cad7b01a472135fa6c3809052b88df',\n'499':'f9cad7b01a47213567f478af424ce9ca',\n'500':'f9cad7b01a472135a7baae945022699b',\n'503':'f9cad7b01a4721358c11ac313549c9fa',\n'504':'f9cad7b01a47213521cec1862bb1c4ce',\n'556':'f9cad7b01a4721351284eb4a8f056140',\n'557':'f9cad7b01a4721358e789a9167d97a72',\n'613':'f9cad7b01a47213550dd8c731a5a402c',\n'614':'f9cad7b01a4721350a54c4f78f2ecbf0',\n}\nfor sid,did in ids.items():\n    d=gi.histories.show_dataset(h,did)\n    if d['extension']=='xlsx' and d['state']=='ok': continue\n    gi.histories.update_dataset(h,did,datatype='xlsx')\n    print(sid,'update submitted')\n# poll\npending=set(ids)\nwhile pending:\n    time.sleep(2)\n    still=set()\n    for sid in pending:\n        d=gi.histories.show_dataset(h,ids[sid])\n        if d['state']=='ok' and d['extension']=='xlsx':\n            print(sid,'ok')\n        elif d['state']=='error':\n            print(sid,'ERROR',d)\n        else:\n            still.add(sid)\n    pending=still\nprint('done')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
