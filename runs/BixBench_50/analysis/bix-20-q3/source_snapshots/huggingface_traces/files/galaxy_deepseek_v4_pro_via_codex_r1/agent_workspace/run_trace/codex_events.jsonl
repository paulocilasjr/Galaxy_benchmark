{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport json,time,os\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5f8c7f91945ffba29'\nfilter_id='f9cad7b01a472135b5e46add06ed25c031'\ndef run(tid, inputs, wait=True):\n res=gi.tools.run_tool(history_id=hid, tool_id=tid, tool_inputs=inputs)\n jid=res['jobs'][0]['id']; print('job',tid,jid)\n if not wait: return res,None\n for i in range(180):\n  time.sleep(3); s=gi.jobs.show_job(jid,full_details=True)\n  if s['state'] in ['ok','error','failed','deleted']:\n   print('state',s['state'])\n   if s['state']\"'!='\"'ok': print('err details',s.get('stderr'),s.get('stdout'))\n   return res,s\n print('timeout'); return res,None\nres,s=run('Cut1',{'input':{'src':'hda','id':filter_id},'columnList':'c26','delimiter':'T'})\ncut_id=res['outputs'][0]['id']; print('cut',cut_id, gi.histories.show_dataset(hid,cut_id).get('misc_blurb'))\nres,s=run('Remove beginning1',{'input':{'src':'hda','id':cut_id},'num_lines':'2'})\nrm_id=res['outputs'][0]['id']; print('rm',rm_id, gi.histories.show_dataset(hid,rm_id).get('misc_blurb'))\nres,s=run('Count1',{'input':{'src':'hda','id':rm_id},'column':'c1','delim':'T','sorting':'value'})\ncount_id=res['outputs'][0]['id']; print('count',count_id, gi.histories.show_dataset(hid,count_id).get('misc_blurb'))\ncontent=gi.datasets.download_dataset(count_id).decode('utf-8','replace')\nprint('COUNT CONTENT:\\\\n'+content)\n# Also print filtered classification lines before count\nfor id_ in [filter_id, cut_id, rm_id]:\n d=gi.histories.show_dataset(hid,id_)\n print('\\\\nID',id_,d.get('name'),d.get('misc_blurb'))\n print(gi.datasets.download_dataset(id_).decode('utf-8','replace')[:2000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
