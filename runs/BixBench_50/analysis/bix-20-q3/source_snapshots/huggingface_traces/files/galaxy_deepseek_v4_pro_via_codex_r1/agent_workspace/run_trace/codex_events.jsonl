{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /workspace/tmp/carrier && python - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport os, re, openpyxl, collections\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5f8c7f91945ffba29'\ncs=gi.histories.show_history(hid, contents=True)\ncarrier_ids={185,184,285,287,353,354,381,396,397,489,490,499,500,503,504,556,557,613,614}\nfiles=[]\nfor c in cs:\n n=c['name']\n m=re.search(r'CHIP_(\\\\d+)-',n)\n if m and int(m.group(1)) in carrier_ids:\n  files.append((int(m.group(1)), c))\nprint('carrier files',len(files), sorted([x for x,_ in files]))\nfor sid,c in sorted(files):\n out=f'/workspace/tmp/carrier/{c[\\\"name\\\"]}'\n if not os.path.exists(out):\n  gi.datasets.download_dataset(c['id'], file_path=out, use_default_filename=False, maxwait=120)\n print('saved', c['name'], os.path.getsize(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
