{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, os, collections\nfiles=sorted(glob.glob('/workspace/tmp/carrier/*.xlsx'))\ndef analyze(exclude_utr=True, exclude_intron=True, exclude_upstream=False, exclude_ref_zyg=True, exclude_missing=True):\n seq_counter=collections.Counter(); cls_counter=collections.Counter(); examples=[]\n for f in files:\n  wb=openpyxl.load_workbook(f, read_only=False, data_only=False); ws=wb.active\n  rows=list(ws.iter_rows(values_only=True)); h=rows[1]; data=rows[2:]\n  idx={n:i for i,n in enumerate(h)}\n  for r in data:\n   zyg=r[idx['Zygosity']]; vaf=r[idx['Variant Allele Freq']]; seq=r[idx['Sequence Ontology (Combined)']]; cls=r[idx['Classification']]\n   if exclude_ref_zyg and zyg=='Reference': continue\n   if exclude_missing and (vaf is None or vaf==''): continue\n   try: x=float(vaf)\n   except: continue\n   if not x<0.3: continue\n   if exclude_intron and seq=='intron_variant': continue\n   if exclude_utr and ('UTR' in str(seq) or seq in ['3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant']): continue\n   if exclude_upstream and seq=='upstream_gene_variant': continue\n   seq_counter[seq]+=1; cls_counter[cls]+=1\n   examples.append((os.path.basename(f),r[idx['Chr:Pos']],r[idx['Gene Names']],seq,cls,vaf,zyg))\n print('seqs',seq_counter,'cls',cls_counter,'total',sum(seq_counter.values()))\n for e in examples: print(e)\nprint('standard exclude ref zygo + missing, vaf<.3')\nanalyze()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
