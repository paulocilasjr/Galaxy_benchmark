{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl, math\np='/workspace/inputs/data.xlsx'\nws=openpyxl.load_workbook(p, data_only=True).active\nX=[]; y=[]\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    if r[0] is None or not isinstance(r[0],(int,float)): continue\n    if r[1] is None or r[3] is None: continue\n    age=float(r[3]); grp=r[1]\n    y.append(1.0 if grp==1 else 0.0)\n    X.append((1.0, age))\nn=len(y)\nbeta=[0.0,0.0]\nfor it in range(100):\n    p=[1/(1+math.exp(-(beta[0]+beta[1]*x[1]))) for x in X]\n    grad=[sum((p[i]-y[i])*X[i][j] for i in range(n)) for j in range(2)]\n    H=[[0.0,0.0],[0.0,0.0]]\n    for i in range(n):\n        w=p[i]*(1-p[i])\n        for j in range(2):\n            for k in range(2):\n                H[j][k]+=w*X[i][j]*X[i][k]\n    # solve 2x2\n    det=H[0][0]*H[1][1]-H[0][1]*H[1][0]\n    inv=[[H[1][1]/det,-H[0][1]/det],[-H[1][0]/det,H[0][0]/det]]\n    step=[-(inv[0][0]*grad[0]+inv[0][1]*grad[1]), -(inv[1][0]*grad[0]+inv[1][1]*grad[1])]\n    beta=[beta[j]+step[j] for j in range(2)]\n    if max(abs(s) for s in step)<1e-12: break\nprint('n',n,'iter',it,'beta',beta)\nprint('age coef',beta[1])\n# SE and wald\np=[1/(1+math.exp(-(beta[0]+beta[1]*x[1]))) for x in X]\nH=[[0.0,0.0],[0.0,0.0]]\nfor i in range(n):\n w=p[i]*(1-p[i])\n for j in range(2):\n  for k in range(2):\n   H[j][k]+=w*X[i][j]*X[i][k]\ndet=H[0][0]*H[1][1]-H[0][1]*H[1][0]\ninv=[[H[1][1]/det,-H[0][1]/det],[-H[1][0]/det,H[0][0]/det]]\nimport math as m\nprint('se',m.sqrt(inv[1][1]),'z',beta[1]/m.sqrt(inv[1][1]))\n# log likelihoods\ndef ll(b):\n return sum(y[i]*(b[0]+b[1]*X[i][1]) - m.log(1+m.exp(b[0]+b[1]*X[i][1])) for i in range(n))\nprint('ll',ll(beta),'ll0',ll([math.log(sum(y)/(n-sum(y))),0]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
