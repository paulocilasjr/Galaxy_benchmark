nrichKEGG.R:28:enrichKEGG <- function(gene,\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:44:            KEGG_DATA <- prepare_KEGG(species, \"KEGG\", keyType)\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:71:get_KEGG_Env <- function() {\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:92:    KEGG_Env <- get_KEGG_Env()\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:160:prepare_KEGG <- function(species, KEGG_Type=\"KEGG\", keyType=\"kegg\") {\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:280:    PATHID2EXTID <- as.list(get_KEGG_db(\"KEGGPATHID2EXTID\"))\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:288:    PATHID2NAME <- as.list(get_KEGG_db(\"KEGGPATHID2NAME\"))\n/workspace/tmp/cp/clusterProfiler/R/enrichKEGG.R:294:get_KEGG_db <- function(kw) {\n/workspace/tmp/cp/clusterProfiler/R/enrichMKEGG.R:6:##' @inheritParams enrichKEGG\n/workspace/tmp/cp/clusterProfiler/R/enrichMKEGG.R:20:    KEGG_DATA <- prepare_KEGG(species, \"MKEGG\", keyType)\n/workspace/tmp/cp/clusterProfiler/R/gseAnalyzer.R:111:    KEGG_DATA <- prepare_KEGG(species, \"MKEGG\", keyType)\n/workspace/tmp/cp/clusterProfiler/R/gseAnalyzer.R:169:            KEGG_DATA <- prepare_KEGG(species, \"KEGG\", keyType)\n/workspace/tmp/cp/clusterProfiler/R/compareCluster.R:9:##' @param fun One of \"groupGO\", \"enrichGO\", \"enrichKEGG\", \"enrichDO\" or \"enrichPathway\" . \r\n/workspace/tmp/cp/clusterProfiler/R/compareCluster.R:32:##' xx <- compareCluster(gcSample, fun=\"enrichKEGG\",\r\n/workspace/tmp/cp/clusterProfiler/R/compareCluster.R:59:     if(fun %in% c(\"groupGO\", \"enrichGO\", \"enrichKEGG\",\r\n","exit_code":0,"status":"completed"}}
