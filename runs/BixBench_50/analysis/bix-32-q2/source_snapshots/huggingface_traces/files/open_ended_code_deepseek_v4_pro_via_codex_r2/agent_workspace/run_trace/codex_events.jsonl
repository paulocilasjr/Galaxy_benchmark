{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# Reuse by executing simplified ORA for pooled abs lists and also directional per strain; output counts\nimport math,csv,re\nfrom collections import defaultdict\np2g=defaultdict(set);g2p=defaultdict(set)\nfor l in open('/workspace/tmp/pau_link.tsv'):\n g,p=l.strip().split('\\\\t');g=g.split(':',1)[1];p=p.split(':',1)[1];p2g[p].add(g);g2p[g].add(p)\nnames=set(l.split('\\\\t',1)[0] for l in open('/workspace/tmp/pau_pathways.tsv'))\np2g={p:g for p,g in p2g.items() if p in names};g2p={g:{p for p in ps if p in names} for g,ps in g2p.items()}\nN=len({g for gs in p2g.values() for g in gs})\ndef bh(ps):\n n=len(ps);idx=sorted(range(n),key=lambda i:ps[i]);q=[0]*n;prev=1\n for rank,i in enumerate(idx): v=ps[i]*n/(rank+1); q[i]=min(v,prev);prev=q[i]\n return [min(x,1) for x in q]\ndef ora(gs):\n gs=set(gs)&set(g2p); mapped={g:set(g2p[g]) for g in gs}; qts=set().union(*mapped.values()) if mapped else set()\n qts={t for t in qts if 10<=len(p2g[t])<=500}; n=len(mapped); rows=[]\n for t in sorted(qts):\n  k=len(p2g[t]&set(mapped));M=len(p2g[t]);den=math.comb(N,n);p=sum(math.comb(M,i)*math.comb(N-M,n-i)/den for i in range(k,min(n,M)+1));rows.append((t,k,M,n,p))\n ps=[r[4] for r in rows];pa=bh(ps)\n return [r[0] for r,a in zip(rows,pa) if r[4]<=.05 and a<=.05]\nfor st in ['97','98','99']:\n genes=[(r['gene'],float(r['lfc'])) for r in csv.DictReader(open(f'/workspace/tmp/res_{st}.csv'))]\n for label,pred in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5),('abs',lambda x:abs(x)>1.5)]:\n  ids=ora([g for g,l in genes if pred(l)])\n  print(st,label,len(ids),ids)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# Reuse by executing simplified ORA for pooled abs lists and also directional per strain; output counts\nimport math,csv,re\nfrom collections import defaultdict\np2g=defaultdict(set);g2p=defaultdict(set)\nfor l in open('/workspace/tmp/pau_link.tsv'):\n g,p=l.strip().split('\\\\t');g=g.split(':',1)[1];p=p.split(':',1)[1];p2g[p].add(g);g2p[g].add(p)\nnames=set(l.split('\\\\t',1)[0] for l in open('/workspace/tmp/pau_pathways.tsv'))\np2g={p:g for p,g in p2g.items() if p in names};g2p={g:{p for p in ps if p in names} for g,ps in g2p.items()}\nN=len({g for gs in p2g.values() for g in gs})\ndef bh(ps):\n n=len(ps);idx=sorted(range(n),key=lambda i:ps[i]);q=[0]*n;prev=1\n for rank,i in enumerate(idx): v=ps[i]*n/(rank+1); q[i]=min(v,prev);prev=q[i]\n return [min(x,1) for x in q]\ndef ora(gs):\n gs=set(gs)&set(g2p); mapped={g:set(g2p[g]) for g in gs}; qts=set().union(*mapped.values()) if mapped else set()\n qts={t for t in qts if 10<=len(p2g[t])<=500}; n=len(mapped); rows=[]\n for t in sorted(qts):\n  k=len(p2g[t]&set(mapped));M=len(p2g[t]);den=math.comb(N,n);p=sum(math.comb(M,i)*math.comb(N-M,n-i)/den for i in range(k,min(n,M)+1));rows.append((t,k,M,n,p))\n ps=[r[4] for r in rows];pa=bh(ps)\n return [r[0] for r,a in zip(rows,pa) if r[4]<=.05 and a<=.05]\nfor st in ['97','98','99']:\n genes=[(r['gene'],float(r['lfc'])) for r in csv.DictReader(open(f'/workspace/tmp/res_{st}.csv'))]\n for label,pred in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5),('abs',lambda x:abs(x)>1.5)]:\n  ids=ora([g for g,l in genes if pred(l)])\n  print(st,label,len(ids),ids)\nPY\"","aggregated_output":"97 up 5 ['pau00405', 'pau00970', 'pau01110', 'pau02024', 'pau02025']\n97 down 7 ['pau00405', 'pau00860', 'pau00910', 'pau01110', 'pau01310', 'pau02024', 'pau04146']\n97 abs 7 ['pau00400', 'pau00405', 'pau01110', 'pau01310', 'pau02024', 'pau02025', 'pau04146']\n98 up 5 ['pau00190', 'pau00280', 'pau00650', 'pau00910', 'pau00920']\n98 down 8 ['pau00380', 'pau00500', 'pau00860', 'pau00910', 'pau01110', 'pau01310', 'pau02020', 'pau04146']\n98 abs 7 ['pau00380', 'pau00500', 'pau00860', 'pau00910', 'pau01310', 'pau02020', 'pau04146']\n99 up 4 ['pau00190', 'pau00740', 'pau00920', 'pau03010']\n99 down 10 ['pau00405', 'pau00460', 'pau00500', 'pau01110', 'pau01310', 'pau02020', 'pau02024', 'pau02025', 'pau02030', 'pau04146']\n99 abs 9 ['pau00190', 'pau00405', 'pau00500', 'pau01310', 'pau02020', 'pau02024', 'pau02025', 'pau02030', 'pau04146']\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\nlink <- read.table('/workspace/tmp/pau_link.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink[,1] <- sub('[\"'^:]+:'\"', '', link[,1])\nlink[,2] <- sub('[\"'^:]+:'\"', '', link[,2])\npaths <- read.table('/workspace/tmp/pau_pathways.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink <- link[link[,2] %in% paths[,1], ]\np2g <- split(link[,1], link[,2])\ng2p <- split(link[,2], link[,1])\nN <- length(unique(link[,1]))\ncat('N',N,'paths',length(p2g),'\\\\n')\nora <- function(gs) {\n  gs <- intersect(unique(gs), names(g2p))\n  if(length(gs)==0) return(character())\n  mapped <- g2p[gs]\n  qts <- unique(unlist(mapped))\n  qts <- qts[sapply(p2g[qts], length) >= 10 & sapply(p2g[qts], length) <= 500]\n  n <- length(mapped)\n  ans <- list()\n  for(t in qts) {\n    k <- sum(p2g[[t]] %in% gs)\n    M <- length(p2g[[t]])\n    p <- phyper(k-1, M, N-M, n, lower.tail=FALSE)\n    ans[[t]] <- c(k=k, M=M, n=n, p=p)\n  }\n  ps <- sapply(ans, function(x) x['p'])\n  pa <- p.adjust(ps, method='BH')\n  names(ans)[pa <= 0.05 & ps <= 0.05]\n}\nfor(st in c('97','98','99')) {\n d <- read.csv(sprintf('/workspace/tmp/res_%s.csv',st), stringsAsFactors=FALSE)\n cat('\\\\n',st,'\\\\n')\n for(dir in c('up','down')) {\n   if(dir=='up') g <- d\"'$gene[d$lfc > 1.5] else g <- d$gene[d$lfc < -1.5]\n   ids <- ora(g)\n   cat(dir,length(ids),paste(ids,collapse='\"','),'\\\\n')\n   assign(paste0(dir,st), ids)\n }\n}\nup <- Reduce(intersect,list(up97,up98,up99))\ndown <- Reduce(intersect,list(down97,down98,down99))\ncat('up common',length(up),up,'\\\\n')\ncat('down common',length(down),down,'\\\\n')\ncat('union',length(union(up,down)),union(up,down),'\\\\n')\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
