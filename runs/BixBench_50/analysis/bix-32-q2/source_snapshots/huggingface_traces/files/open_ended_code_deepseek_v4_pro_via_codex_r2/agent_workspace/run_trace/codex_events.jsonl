{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\n# Exact KEGG ORA as performed by clusterProfiler::enrichKEGG defaults for organism 'pau'\nlink <- read.table('/workspace/tmp/pau_link.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink[,1] <- sub('[\"'^:]+:'\"', '', link[,1])\nlink[,2] <- sub('[\"'^:]+:'\"', '', link[,2])\npath_names <- read.table('/workspace/tmp/pau_pathways.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink <- link[link[,2] %in% path_names[,1], ]\npath2gene <- split(link[,1], link[,2])\ngene2path <- split(link[,2], link[,1])\nN <- length(unique(link[,1]))\n\nora <- function(genes) {\n  genes <- intersect(unique(genes), names(gene2path))\n  if (length(genes) == 0) return(character())\n  mapped <- gene2path[genes]\n  terms <- unique(unlist(mapped))\n  terms <- terms[sapply(path2gene[terms], length) >= 10 & sapply(path2gene[terms], length) <= 500]\n  n <- length(mapped)\n  pvals <- sapply(terms, function(term) {\n    k <- sum(path2gene[[term]] %in% genes)\n    M <- length(path2gene[[term]])\n    phyper(k - 1, M, N - M, n, lower.tail = FALSE)\n  })\n  padj <- p.adjust(pvals, method = 'BH')\n  terms[pvals <= 0.05 & padj <= 0.05]\n}\n\nsets_up <- list()\nsets_down <- list()\nfor (strain in c('97', '98', '99')) {\n  d <- read.csv(sprintf('/workspace/tmp/res_%s.csv', strain), stringsAsFactors = FALSE)\n  sets_up[[strain]] <- ora(d\"'$gene[d$lfc > 1.5])\n  sets_down[[strain]] <- ora(d$gene[d$lfc < -1.5])\n}\nup_common <- Reduce(intersect, sets_up)\ndown_common <- Reduce(intersect, sets_down)\nanswer <- length(union(up_common, down_common))\nwriteLines(as.character(answer), '\"'/workspace/codex_output/answer.txt')\ncat(answer, '\\\\n')\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\n# Exact KEGG ORA as performed by clusterProfiler::enrichKEGG defaults for organism 'pau'\nlink <- read.table('/workspace/tmp/pau_link.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink[,1] <- sub('[\"'^:]+:'\"', '', link[,1])\nlink[,2] <- sub('[\"'^:]+:'\"', '', link[,2])\npath_names <- read.table('/workspace/tmp/pau_pathways.tsv', sep='\\\\t', header=FALSE, stringsAsFactors=FALSE, quote='')\nlink <- link[link[,2] %in% path_names[,1], ]\npath2gene <- split(link[,1], link[,2])\ngene2path <- split(link[,2], link[,1])\nN <- length(unique(link[,1]))\n\nora <- function(genes) {\n  genes <- intersect(unique(genes), names(gene2path))\n  if (length(genes) == 0) return(character())\n  mapped <- gene2path[genes]\n  terms <- unique(unlist(mapped))\n  terms <- terms[sapply(path2gene[terms], length) >= 10 & sapply(path2gene[terms], length) <= 500]\n  n <- length(mapped)\n  pvals <- sapply(terms, function(term) {\n    k <- sum(path2gene[[term]] %in% genes)\n    M <- length(path2gene[[term]])\n    phyper(k - 1, M, N - M, n, lower.tail = FALSE)\n  })\n  padj <- p.adjust(pvals, method = 'BH')\n  terms[pvals <= 0.05 & padj <= 0.05]\n}\n\nsets_up <- list()\nsets_down <- list()\nfor (strain in c('97', '98', '99')) {\n  d <- read.csv(sprintf('/workspace/tmp/res_%s.csv', strain), stringsAsFactors = FALSE)\n  sets_up[[strain]] <- ora(d\"'$gene[d$lfc > 1.5])\n  sets_down[[strain]] <- ora(d$gene[d$lfc < -1.5])\n}\nup_common <- Reduce(intersect, sets_up)\ndown_common <- Reduce(intersect, sets_down)\nanswer <- length(union(up_common, down_common))\nwriteLines(as.character(answer), '\"'/workspace/codex_output/answer.txt')\ncat(answer, '\\\\n')\nRS\"","aggregated_output":"2 \n","exit_code":0,"status":"completed"}}
