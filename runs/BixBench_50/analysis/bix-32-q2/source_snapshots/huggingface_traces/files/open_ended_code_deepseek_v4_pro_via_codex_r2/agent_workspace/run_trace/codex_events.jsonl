{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, csv, re\nfrom collections import defaultdict\n\n# parse KEGG exactly as clusterProfiler\npath2gene=defaultdict(set)\ngene2path=defaultdict(set)\nfor line in open('/workspace/tmp/pau_link.tsv'):\n    line=line.strip()\n    if not line: continue\n    gene,path=line.split('\\\\t')\n    gene=re.sub(r'[\"'^:]+:'\"', '', gene)\n    path=re.sub(r'[\"'^:]+:'\"', '', path)\n    path2gene[path].add(gene)\n    gene2path[gene].add(path)\n\nnames={}\nfor line in open('/workspace/tmp/pau_pathways.tsv'):\n    line=line.strip()\n    if not line: continue\n    path,name=line.split('\\\\t',1)\n    # clusterProfiler removes \\\" - organism (code)\\\" suffix\n    name=re.sub(r'\\\\s-\\\\s[a-zA-Z ]+\\\\(\\\\w+\\\\)\"'$'\"', '', name)\n    names[path]=name\n\n# keep only paths in names (as CP does)\npath2gene={p:g for p,g in path2gene.items() if p in names}\ngene2path={g:{p for p in ps if p in names} for g,ps in gene2path.items()}\nuniverse=sorted({g for gs in path2gene.values() for g in gs})\nN=len(universe)\nprint('N universe',N,'pathways',len(path2gene))\n\n# read gene results\nstrains={}\nfor st in ['97','98','99']:\n    genes=[]\n    with open(f'/workspace/tmp/res_{st}.csv') as f:\n        r=csv.DictReader(f)\n        for row in r:\n            genes.append((row['gene'], float(row['lfc']), float(row['padj'])))\n    strains[st]=genes\n    up=[g for g,l,p in genes if l>1.5]\n    down=[g for g,l,p in genes if l< -1.5]\n    print(st,'total',len(genes),'up',len(up),'down',len(down),'up mapped',len(set(up)&set(gene2path)),'down mapped',len(set(down)&set(gene2path)))\n\ndef bh(ps):\n    n=len(ps)\n    if n==0:return []\n    idx=sorted(range(n), key=lambda i:ps[i])\n    q=[0.0]*n\n    prev=1.0\n    for rank,i in enumerate(idx): # rank 0-based => rank+1\n        val=ps[i]*n/(rank+1)\n        q[i]=min(val, prev)\n        prev=q[i]\n    # R cummin reversed actually ensures nondecreasing; above sets q in sorted order to min(new, previous cumulative min), yes.\n    return [min(v,1.0) for v in q]\n\n# helper ORA, returns significant by criteria\ndef ora(gene_set, pvalue_cutoff=0.05, qvalue_cutoff=None):\n    gene_set=set(gene_set) & set(gene2path)\n    # qExtID2TermID: map each gene to its path\n    mapped={g:set(gene2path[g]) for g in gene_set}\n    qterms=set().union(*mapped.values()) if mapped else set()\n    if not qterms: return []\n    # filter gene set sizes 10..500\n    qterms={t for t in qterms if 10 <= len(path2gene[t]) <= 500}\n    # k, M, N, n\n    n=len(mapped)\n    rows=[]\n    for t in sorted(qterms):\n        k=len(path2gene[t] & set(mapped))\n        M=len(path2gene[t])\n        # phyper(k-1, M, N-M, n, lower.tail=FALSE)\n        p=0.0\n        # sum C(M,i)C(N-M,n-i)/C(N,n) for i=k..min(n,M)\n        denom=math.comb(N,n)\n        for i in range(k, min(n,M)+1):\n            p += math.comb(M,i)*math.comb(N-M,n-i)/denom\n        rows.append((t,k,M,n,p))\n    # p.adjust BH\n    ps=[r[4] for r in rows]\n    padj=bh(ps)\n    out=[]\n    for r,pa in zip(rows,padj):\n        t,k,M,n,p=r\n        # qvalue ignored? for p.adjust significance\n        if p<=pvalue_cutoff and pa<=pvalue_cutoff:\n            out.append((t,k,M,n,p,pa))\n    return out\n\nfor st in ['97','98','99']:\n    genes=strains[st]\n    up=[g for g,l,p in genes if l>1.5]\n    down=[g for g,l,p in genes if l< -1.5]\n    up_res=ora(up)\n    down_res=ora(down)\n    print('\\\\nSTRAIN',st)\n    print('up significant padj<=0.05 count',len(up_res),'IDs',[r[0] for r in up_res][:30])\n    print('down significant padj<=0.05 count',len(down_res),'IDs',[r[0] for r in down_res][:30])\n    # also pvalue only?\n    # store\n    globals()[f'up_{st}']=set(r[0] for r in up_res)\n    globals()[f'down_{st}']=set(r[0] for r in down_res)\n\nup_common=up_97&up_98&up_99\ndown_common=down_97&down_98&down_99\nprint('\\\\nUP COMMON',len(up_common),sorted(up_common))\nprint('DOWN COMMON',len(down_common),sorted(down_common))\nprint('UNION',len(up_common|down_common),sorted(up_common|down_common))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, csv, re\nfrom collections import defaultdict\n\n# parse KEGG exactly as clusterProfiler\npath2gene=defaultdict(set)\ngene2path=defaultdict(set)\nfor line in open('/workspace/tmp/pau_link.tsv'):\n    line=line.strip()\n    if not line: continue\n    gene,path=line.split('\\\\t')\n    gene=re.sub(r'[\"'^:]+:'\"', '', gene)\n    path=re.sub(r'[\"'^:]+:'\"', '', path)\n    path2gene[path].add(gene)\n    gene2path[gene].add(path)\n\nnames={}\nfor line in open('/workspace/tmp/pau_pathways.tsv'):\n    line=line.strip()\n    if not line: continue\n    path,name=line.split('\\\\t',1)\n    # clusterProfiler removes \\\" - organism (code)\\\" suffix\n    name=re.sub(r'\\\\s-\\\\s[a-zA-Z ]+\\\\(\\\\w+\\\\)\"'$'\"', '', name)\n    names[path]=name\n\n# keep only paths in names (as CP does)\npath2gene={p:g for p,g in path2gene.items() if p in names}\ngene2path={g:{p for p in ps if p in names} for g,ps in gene2path.items()}\nuniverse=sorted({g for gs in path2gene.values() for g in gs})\nN=len(universe)\nprint('N universe',N,'pathways',len(path2gene))\n\n# read gene results\nstrains={}\nfor st in ['97','98','99']:\n    genes=[]\n    with open(f'/workspace/tmp/res_{st}.csv') as f:\n        r=csv.DictReader(f)\n        for row in r:\n            genes.append((row['gene'], float(row['lfc']), float(row['padj'])))\n    strains[st]=genes\n    up=[g for g,l,p in genes if l>1.5]\n    down=[g for g,l,p in genes if l< -1.5]\n    print(st,'total',len(genes),'up',len(up),'down',len(down),'up mapped',len(set(up)&set(gene2path)),'down mapped',len(set(down)&set(gene2path)))\n\ndef bh(ps):\n    n=len(ps)\n    if n==0:return []\n    idx=sorted(range(n), key=lambda i:ps[i])\n    q=[0.0]*n\n    prev=1.0\n    for rank,i in enumerate(idx): # rank 0-based => rank+1\n        val=ps[i]*n/(rank+1)\n        q[i]=min(val, prev)\n        prev=q[i]\n    # R cummin reversed actually ensures nondecreasing; above sets q in sorted order to min(new, previous cumulative min), yes.\n    return [min(v,1.0) for v in q]\n\n# helper ORA, returns significant by criteria\ndef ora(gene_set, pvalue_cutoff=0.05, qvalue_cutoff=None):\n    gene_set=set(gene_set) & set(gene2path)\n    # qExtID2TermID: map each gene to its path\n    mapped={g:set(gene2path[g]) for g in gene_set}\n    qterms=set().union(*mapped.values()) if mapped else set()\n    if not qterms: return []\n    # filter gene set sizes 10..500\n    qterms={t for t in qterms if 10 <= len(path2gene[t]) <= 500}\n    # k, M, N, n\n    n=len(mapped)\n    rows=[]\n    for t in sorted(qterms):\n        k=len(path2gene[t] & set(mapped))\n        M=len(path2gene[t])\n        # phyper(k-1, M, N-M, n, lower.tail=FALSE)\n        p=0.0\n        # sum C(M,i)C(N-M,n-i)/C(N,n) for i=k..min(n,M)\n        denom=math.comb(N,n)\n        for i in range(k, min(n,M)+1):\n            p += math.comb(M,i)*math.comb(N-M,n-i)/denom\n        rows.append((t,k,M,n,p))\n    # p.adjust BH\n    ps=[r[4] for r in rows]\n    padj=bh(ps)\n    out=[]\n    for r,pa in zip(rows,padj):\n        t,k,M,n,p=r\n        # qvalue ignored? for p.adjust significance\n        if p<=pvalue_cutoff and pa<=pvalue_cutoff:\n            out.append((t,k,M,n,p,pa))\n    return out\n\nfor st in ['97','98','99']:\n    genes=strains[st]\n    up=[g for g,l,p in genes if l>1.5]\n    down=[g for g,l,p in genes if l< -1.5]\n    up_res=ora(up)\n    down_res=ora(down)\n    print('\\\\nSTRAIN',st)\n    print('up significant padj<=0.05 count',len(up_res),'IDs',[r[0] for r in up_res][:30])\n    print('down significant padj<=0.05 count',len(down_res),'IDs',[r[0] for r in down_res][:30])\n    # also pvalue only?\n    # store\n    globals()[f'up_{st}']=set(r[0] for r in up_res)\n    globals()[f'down_{st}']=set(r[0] for r in down_res)\n\nup_common=up_97&up_98&up_99\ndown_common=down_97&down_98&down_99\nprint('\\\\nUP COMMON',len(up_common),sorted(up_common))\nprint('DOWN COMMON',len(down_common),sorted(down_common))\nprint('UNION',len(up_common|down_common),sorted(up_common|down_common))\nPY\"","aggregated_output":"N universe 2055 pathways 138\n97 total 5828 up 13 down 166 up mapped 13 down mapped 74\n98 total 5828 up 35 down 173 up mapped 12 down mapped 54\n99 total 5828 up 81 down 397 up mapped 43 down mapped 141\n\nSTRAIN 97\nup significant padj<=0.05 count 5 IDs ['pau00405', 'pau00970', 'pau01110', 'pau02024', 'pau02025']\ndown significant padj<=0.05 count 7 IDs ['pau00405', 'pau00860', 'pau00910', 'pau01110', 'pau01310', 'pau02024', 'pau04146']\n\nSTRAIN 98\nup significant padj<=0.05 count 5 IDs ['pau00190', 'pau00280', 'pau00650', 'pau00910', 'pau00920']\ndown significant padj<=0.05 count 8 IDs ['pau00380', 'pau00500', 'pau00860', 'pau00910', 'pau01110', 'pau01310', 'pau02020', 'pau04146']\n\nSTRAIN 99\nup significant padj<=0.05 count 4 IDs ['pau00190', 'pau00740', 'pau00920', 'pau03010']\ndown significant padj<=0.05 count 10 IDs ['pau00405', 'pau00460', 'pau00500', 'pau01110', 'pau01310', 'pau02020', 'pau02024', 'pau02025', 'pau02030', 'pau04146']\n\nUP COMMON 0 []\nDOWN COMMON 3 ['pau01110', 'pau01310', 'pau04146']\nUNION 3 ['pau01110', 'pau01310', 'pau04146']\n","exit_code":0,"status":"completed"}}
