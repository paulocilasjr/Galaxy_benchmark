{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, csv, re\nfrom collections import defaultdict\np2g=defaultdict(set);g2p=defaultdict(set)\nfor line in open('/workspace/tmp/pau_link.tsv'):\n    g,p=line.strip().split('\\\\t');g=re.sub(r'[\"'^:]+:'\"','',g);p=re.sub(r'[\"'^:]+:'\"','',p);p2g[p].add(g);g2p[g].add(p)\nnames={l.split('\\\\t',1)[0] for l in open('/workspace/tmp/pau_pathways.tsv')}\np2g={p:g for p,g in p2g.items() if p in names};g2p={g:{p for p in ps if p in names} for g,ps in g2p.items()}\nN=len({g for gs in p2g.values() for g in gs})\n\ndef bh(ps):\n    n=len(ps)\n    if n==0:return []\n    # sorted ascending index\n    s=sorted(range(n), key=lambda i:ps[i])\n    # order decreasing p (same as rev(s)), rank i descending\n    # produce raw adjusted in original order\n    out=[0.0]*n\n    cummin=1.0\n    # iterate ascending reverse (largest to smallest), rank = n, n-1, ...\n    for rank,i in enumerate(reversed(s)):\n        r=n-rank # n, n-1...\n        raw=ps[i]*n/r\n        if raw < cummin: cummin=raw\n        out[i]=min(cummin,1.0)\n    return out\n\ndef qvalues(ps):\n    # pi0 bootstrap approximation\n    m=len(ps); lam=[i/20 for i in range(1,20)]\n    W=[sum(p>=l for p in ps) for l in lam]\n    pi0s=[W[i]/(m*(1-lam[i])) for i in range(len(lam))]\n    minpi0=sorted(pi0s)[int((len(pi0s)-1)*0.1)] if len(pi0s)>1 else min(pi0s)\n    mses=[(W[i]/(m*m*(1-lam[i])**2))*(1-W[i]/m)+(pi0s[i]-minpi0)**2 for i in range(len(lam))]\n    minmse=min(mses); pi0=min(min([pi0s[i] for i,v in enumerate(mses) if v==minmse]),1)\n    # q values exactly R qvalue with pi0 (pfdr false)\n    o=sorted(range(m), key=lambda i:-ps[i]); ro=[0]*m\n    for rank,i in enumerate(o): ro[i]=rank\n    cum=1.0; vals=[]\n    for rank,i in enumerate(o):\n        raw=ps[i]*m/(rank+1)\n        cum=min(cum,raw)\n        vals.append(cum)\n    return [min(pi0*vals[ro[i]],1.0) for i in range(m)]\n\ndef ora(gs, full_filter=True):\n    gs=set(gs)&set(g2p); mapped={g:set(g2p[g]) for g in gs}; qts=set().union(*mapped.values()) if mapped else set()\n    qts={t for t in qts if 10<=len(p2g[t])<=500}; n=len(mapped); rows=[]\n    for t in sorted(qts):\n        k=len(p2g[t]&set(mapped));M=len(p2g[t]);den=math.comb(N,n);p=sum(math.comb(M,i)*math.comb(N-M,n-i)/den for i in range(k,min(n,M)+1));rows.append((t,k,M,n,p))\n    ps=[r[4] for r in rows];pa=bh(ps);qv=qvalues(ps)\n    out=[]\n    for r,a,q in zip(rows,pa,qv):\n        t,k,M,n,p=r\n        ok=(p<=.05 and a<=.05 and (not full_filter or q<=.2))\n        out.append((t,p,a,q,k,M,n,ok))\n    return out\n\nfor st in ['97','98','99']:\n    genes=[(r['gene'],float(r['lfc'])) for r in csv.DictReader(open(f'/workspace/tmp/res_{st}.csv'))]\n    for direction,pred in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5)]:\n        res=ora([g for g,l in genes if pred(l)])\n        ids=[r[0] for r in res if r[7]]\n        print(st,direction,'sig',len(ids),ids)\n        globals()[f'{direction}_{st}']=set(ids)\n\nup=up_97&up_98&up_99;down=down_97&down_98&down_99\nprint('UP COMMON',len(up),up)\nprint('DOWN COMMON',len(down),down)\nprint('UNION',len(up|down),up|down)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, csv, re\nfrom collections import defaultdict\np2g=defaultdict(set);g2p=defaultdict(set)\nfor line in open('/workspace/tmp/pau_link.tsv'):\n    g,p=line.strip().split('\\\\t');g=re.sub(r'[\"'^:]+:'\"','',g);p=re.sub(r'[\"'^:]+:'\"','',p);p2g[p].add(g);g2p[g].add(p)\nnames={l.split('\\\\t',1)[0] for l in open('/workspace/tmp/pau_pathways.tsv')}\np2g={p:g for p,g in p2g.items() if p in names};g2p={g:{p for p in ps if p in names} for g,ps in g2p.items()}\nN=len({g for gs in p2g.values() for g in gs})\n\ndef bh(ps):\n    n=len(ps)\n    if n==0:return []\n    # sorted ascending index\n    s=sorted(range(n), key=lambda i:ps[i])\n    # order decreasing p (same as rev(s)), rank i descending\n    # produce raw adjusted in original order\n    out=[0.0]*n\n    cummin=1.0\n    # iterate ascending reverse (largest to smallest), rank = n, n-1, ...\n    for rank,i in enumerate(reversed(s)):\n        r=n-rank # n, n-1...\n        raw=ps[i]*n/r\n        if raw < cummin: cummin=raw\n        out[i]=min(cummin,1.0)\n    return out\n\ndef qvalues(ps):\n    # pi0 bootstrap approximation\n    m=len(ps); lam=[i/20 for i in range(1,20)]\n    W=[sum(p>=l for p in ps) for l in lam]\n    pi0s=[W[i]/(m*(1-lam[i])) for i in range(len(lam))]\n    minpi0=sorted(pi0s)[int((len(pi0s)-1)*0.1)] if len(pi0s)>1 else min(pi0s)\n    mses=[(W[i]/(m*m*(1-lam[i])**2))*(1-W[i]/m)+(pi0s[i]-minpi0)**2 for i in range(len(lam))]\n    minmse=min(mses); pi0=min(min([pi0s[i] for i,v in enumerate(mses) if v==minmse]),1)\n    # q values exactly R qvalue with pi0 (pfdr false)\n    o=sorted(range(m), key=lambda i:-ps[i]); ro=[0]*m\n    for rank,i in enumerate(o): ro[i]=rank\n    cum=1.0; vals=[]\n    for rank,i in enumerate(o):\n        raw=ps[i]*m/(rank+1)\n        cum=min(cum,raw)\n        vals.append(cum)\n    return [min(pi0*vals[ro[i]],1.0) for i in range(m)]\n\ndef ora(gs, full_filter=True):\n    gs=set(gs)&set(g2p); mapped={g:set(g2p[g]) for g in gs}; qts=set().union(*mapped.values()) if mapped else set()\n    qts={t for t in qts if 10<=len(p2g[t])<=500}; n=len(mapped); rows=[]\n    for t in sorted(qts):\n        k=len(p2g[t]&set(mapped));M=len(p2g[t]);den=math.comb(N,n);p=sum(math.comb(M,i)*math.comb(N-M,n-i)/den for i in range(k,min(n,M)+1));rows.append((t,k,M,n,p))\n    ps=[r[4] for r in rows];pa=bh(ps);qv=qvalues(ps)\n    out=[]\n    for r,a,q in zip(rows,pa,qv):\n        t,k,M,n,p=r\n        ok=(p<=.05 and a<=.05 and (not full_filter or q<=.2))\n        out.append((t,p,a,q,k,M,n,ok))\n    return out\n\nfor st in ['97','98','99']:\n    genes=[(r['gene'],float(r['lfc'])) for r in csv.DictReader(open(f'/workspace/tmp/res_{st}.csv'))]\n    for direction,pred in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5)]:\n        res=ora([g for g,l in genes if pred(l)])\n        ids=[r[0] for r in res if r[7]]\n        print(st,direction,'sig',len(ids),ids)\n        globals()[f'{direction}_{st}']=set(ids)\n\nup=up_97&up_98&up_99;down=down_97&down_98&down_99\nprint('UP COMMON',len(up),up)\nprint('DOWN COMMON',len(down),down)\nprint('UNION',len(up|down),up|down)\nPY\"","aggregated_output":"97 up sig 4 ['pau00405', 'pau00970', 'pau02024', 'pau02025']\n97 down sig 4 ['pau00405', 'pau01110', 'pau01310', 'pau02024']\n98 up sig 4 ['pau00190', 'pau00650', 'pau00910', 'pau00920']\n98 down sig 7 ['pau00500', 'pau00860', 'pau00910', 'pau01110', 'pau01310', 'pau02020', 'pau04146']\n99 up sig 5 ['pau00190', 'pau00740', 'pau00920', 'pau00970', 'pau03010']\n99 down sig 8 ['pau00405', 'pau00500', 'pau01110', 'pau01310', 'pau02020', 'pau02024', 'pau02025', 'pau02030']\nUP COMMON 0 set()\nDOWN COMMON 2 {'pau01110', 'pau01310'}\nUNION 2 {'pau01110', 'pau01310'}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\n# Print exact significant pathways and p/adjust for each\nlink <- read.table('/workspace/tmp/pau_link.tsv',sep='\\\\t',header=FALSE,stringsAsFactors=FALSE,quote='')\nlink[,1]<-sub('[\"'^:]+:'\"','',link[,1]);link[,2]<-sub('[\"'^:]+:'\"','',link[,2])\npaths<-read.table('/workspace/tmp/pau_pathways.tsv',sep='\\\\t',header=FALSE,stringsAsFactors=FALSE,quote='')\nlink<-link[link[,2]%in%paths[,1],]\np2g<-split(link[,1],link[,2]);g2p<-split(link[,2],link[,1]);N<-length(unique(link[,1]))\nora_details<-function(gs){\n gs<-intersect(unique(gs),names(g2p)); mapped<-g2p[gs]; qts<-unique(unlist(mapped)); qts<-qts[sapply(p2g[qts],length)>=10 & sapply(p2g[qts],length)<=500]; n<-length(mapped)\n ans<-list()\n for(t in qts){k<-sum(p2g[[t]]%in%gs);M<-length(p2g[[t]]);p<-phyper(k-1,M,N-M,n,lower.tail=FALSE);ans[[t]]<-c(k=k,M=M,n=n,p=p)}\n ps<-sapply(ans,function(x)x['p']);pa<-p.adjust(ps,'BH'); ids<-names(ps)[pa<=.05 & ps<=.05]\n data.frame(ID=ids,pvalue=ps[ids],padj=pa[ids],stringsAsFactors=FALSE)\n}\nfor(st in c('97','98','99')){\n d<-read.csv(sprintf('/workspace/tmp/res_%s.csv',st),stringsAsFactors=FALSE)\n cat('\\\\nSTRAIN',st,'\\\\n')\n for(dir in c('up','down')){\n  g<-if(dir=='up') d\"'$gene[d$lfc>1.5] else d$gene[d$lfc< -1.5]\n  print(ora_details(g))\n }\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
