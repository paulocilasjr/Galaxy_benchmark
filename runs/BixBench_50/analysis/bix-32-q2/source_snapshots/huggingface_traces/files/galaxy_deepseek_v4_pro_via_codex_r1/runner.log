{"type":"item.started","item":{"id":"item_112","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport csv, json\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nmapping={\n('97','up'):'f9cad7b01a472135c449a197d1e01938',\n('97','dn'):'f9cad7b01a472135e2fcfc9a0b45c181',\n('98','up'):'f9cad7b01a472135d2098a0be0401f2f',\n('98','dn'):'f9cad7b01a472135fbea55c92ae0a4be',\n('99','up'):'f9cad7b01a472135aa5cdd9db08c6432',\n('99','dn'):'f9cad7b01a47213538a046235d95d4d8',\n}\ndata={}\nfor (s,d),did in mapping.items():\n out=f'/workspace/tmp/ora_nopadj_{s}{d}.tsv'\n gi.datasets.download_dataset(did,file_path=out,use_default_filename=False)\n rows=list(csv.DictReader(open(out),delimiter='\\\\t'))\n data[(s,d)]=rows\n print(s,d,'rows',len(rows))\n sig=[r for r in rows if r['adjusted_p_value'] not in ('','NA') and float(r['adjusted_p_value'])<0.05]\n print(' sig',len(sig),[r['pathway_id'] for r in sig])\nup = set(r['pathway_id'] for r in data[('97','up')] if float(r['adjusted_p_value'])<0.05) & set(r['pathway_id'] for r in data[('98','up')] if float(r['adjusted_p_value'])<0.05) & set(r['pathway_id'] for r in data[('99','up')] if float(r['adjusted_p_value'])<0.05)\ndn = set(r['pathway_id'] for r in data[('97','dn')] if float(r['adjusted_p_value'])<0.05) & set(r['pathway_id'] for r in data[('98','dn')] if float(r['adjusted_p_value'])<0.05) & set(r['pathway_id'] for r in data[('99','dn')] if float(r['adjusted_p_value'])<0.05)\nprint('intersect up',up,'dn',dn,'total',len(up|dn))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
