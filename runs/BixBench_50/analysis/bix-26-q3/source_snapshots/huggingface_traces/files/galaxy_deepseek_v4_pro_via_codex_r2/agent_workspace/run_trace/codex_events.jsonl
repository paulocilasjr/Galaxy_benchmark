{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport requests\nr=requests.get('https://rest.kegg.jp/link/pathway/pau',timeout=60)\nprint(r.status_code,len(r.text))\nlines=r.text.strip().splitlines()\nprint('link lines',len(lines))\n# unique gene ids\ngenes=set()\npathways=set()\nfor line in lines:\n g,p=line.split('\\\\t')\n genes.add(g.split(':')[1]); pathways.add(p.split(':')[1])\nprint('unique genes in pathways',len(genes),'pathways',len(pathways))\n# sample genes\nprint(sorted(genes)[:10], sorted(genes)[-10:])\n# DESeq rows count local table\nimport csv\nrows=0; ids=set()\nfor line in open('/workspace/tmp/table.tsv'):\n if rows==0: rows+=1; continue\n f=line.rstrip('\\\\n').split('\\\\t'); ids.add(f[0]); rows+=1\nprint('DESeq rows',rows-1, 'unique',len(ids))\nprint('intersection',len(ids & genes), 'DE genes not in pathway',len(ids-genes), 'pathway genes not in DE',len(genes-ids))\n# ABC transporter pathway genes\nabc=set()\nfor line in lines:\n g,p=line.split('\\\\t')\n if p=='path:pau02010': abc.add(g.split(':')[1])\nprint('ABC members',len(abc))\nprint('ABC members sample',sorted(abc)[:20])\n# foreground filtered ids\nfids=set(); fh=True\nfor line in open('/workspace/tmp/filtered.tsv'):\n if fh: fh=False; continue\n f=line.split('\\\\t'); fids.add(f[0])\nprint('foreground',len(fids),'foreground in pathways',len(fids & genes),'foreground ABC overlap',len(fids & abc), sorted(fids&abc))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
