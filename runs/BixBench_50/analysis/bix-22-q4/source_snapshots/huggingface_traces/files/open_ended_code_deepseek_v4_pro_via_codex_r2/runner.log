{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math, statistics\nbase='/workspace/inputs'\n# parse annotation\nwith open(base+'/Sample_annotated_Zenodo.csv', newline='') as fh:\n    ann=list(csv.DictReader(fh))\ncd14=[r['sample'] for r in ann if r['celltype']=='CD14']\ncd14set=set(cd14)\n# meta\nmeta={}; pc=set()\nwith open(base+'/GeneMetaInfo_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh); h=next(r)\n    gi=h.index('Geneid'); li=h.index('Length'); bi=h.index('gene_biotype')\n    for row in r:\n        if len(row)<=max(gi,li,bi): continue\n        gid=row[gi]\n        if row[bi]=='protein_coding':\n            pc.add(gid); meta[gid]=float(row[li])\n# counts\nxs=[]; ys=[]\nwith open(base+'/BatchCorrectedReadCounts_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh); header=next(r)\n    header=[h.strip() for h in header]\n    idx=[j for j,h in enumerate(header) if h in cd14set]\n    assert len(idx)==132\n    for row in r:\n        if not row: continue\n        gid=row[0].strip()\n        if gid not in pc: continue\n        total=math.fsum(float(row[j]) for j in idx)\n        if total >= 10:\n            xs.append(meta[gid]); ys.append(total/132)\nn=len(xs)\nmx=math.fsum(xs)/n; my=math.fsum(ys)/n\n# centered\ncov=math.fsum((x-mx)*(y-my) for x,y in zip(xs,ys))\nvx=math.fsum((x-mx)**2 for x in xs)\nvy=math.fsum((y-my)**2 for y in ys)\nr=cov/math.sqrt(vx*vy)\nprint('n',n)\nprint('r fsum',repr(r))\nprint('r statistics',statistics.correlation(xs,ys) if hasattr(statistics,'correlation') else 'no')\n# two-pass explicit formula\nsx=math.fsum(xs); sy=math.fsum(ys); sxx=math.fsum(x*x for x in xs); syy=math.fsum(y*y for y in ys); sxy=math.fsum(x*y for x,y in zip(xs,ys))\nr2=(n*sxy-sx*sy)/math.sqrt((n*sxx-sx*sx)*(n*syy-sy*sy))\nprint('r formula',repr(r2))\n# maybe numpy via pip? skip\nprint('range x',min(xs),max(xs),'range y',min(ys),max(ys), 'mean y',my)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
