{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math, statistics\nbase='/workspace/inputs'\nann=[]\nwith open(base+'/Sample_annotated_Zenodo.csv', newline='') as fh:\n    r=csv.DictReader(fh)\n    for row in r: ann.append(row)\ncd14_ids=[row['sample'] for row in ann if row['celltype']=='CD14']\ncd14_set=set(cd14_ids)\nprint('n cd14', len(cd14_ids), len(cd14_set))\n\nmeta_len={}; biotypes={}; dup={}\nwith open(base+'/GeneMetaInfo_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh)\n    header=next(r)\n    # find Geneid and Length and gene_biotype columns\n    print('meta header',header)\n    gi=header.index('Geneid')\n    li=header.index('Length')\n    bi=header.index('gene_biotype')\n    for row in r:\n        if len(row)<=max(gi,li,bi): continue\n        gid=row[gi]\n        if gid in meta_len:\n            dup[gid]=dup.get(gid,0)+1\n        meta_len[gid]=row[li]\n        biotypes[gid]=row[bi]\nprint('meta genes',len(meta_len),'dup ids',len(dup))\nprint('biotype counts')\nfrom collections import Counter\nprint(Counter(biotypes.values()).most_common(20))\npc=set(g for g,b in biotypes.items() if b=='protein_coding')\nprint('protein_coding',len(pc))\n\n# read counts\nlengths=[]; sums=[]; n=0; matched_dup=0\nwith open(base+'/BatchCorrectedReadCounts_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh)\n    header=next(r)\n    # strip trailing spaces/newline\n    header=[h.strip() for h in header]\n    print('header0',repr(header[0]), 'sample names n',len(header)-1)\n    idx=[]\n    for j,h in enumerate(header):\n        if h in cd14_set:\n            idx.append(j)\n    print('matched cd14 cols',len(idx))\n    assert len(idx)==len(cd14_set), (len(idx),len(cd14_set))\n    for row in r:\n        if not row: continue\n        gid=row[0].strip()\n        if gid not in pc: continue\n        # total sum across CD14 columns\n        s=0.0\n        for j in idx:\n            val=row[j].strip()\n            try: s += float(val)\n            except: pass\n        lengths.append(float(meta_len[gid]))\n        sums.append(s)\n        n+=1\nprint('matched expressed rows',n, 'first', lengths[:5], sums[:5])\npairs=[]\nfor l,s in zip(lengths,sums):\n    if s>=10:\n        pairs.append((l,s/len(cd14_ids)))\nprint('filtered total>=10',len(pairs))\nprint('length sample', pairs[:5])\n# pearson\nx=[p[0] for p in pairs]; y=[p[1] for p in pairs]\nmx=sum(x)/len(x); my=sum(y)/len(y)\ncov=sum((a-mx)*(b-my) for a,b in zip(x,y))\nvx=sum((a-mx)**2 for a in x); vy=sum((b-my)**2 for b in y)\nr=cov/math.sqrt(vx*vy)\nprint('r',r)\nprint('r using total vs length', end=' ')\n# check mean vs total same\nprint('means range',min(y),max(y), 'length range',min(x),max(x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
