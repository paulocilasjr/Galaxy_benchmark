 total>=10 18033 r 0.02141315798790402\ncd14 total>=0 19942 r 0.031693908897984194\ncd14 mean>=1 19929 r 0.03158936199736878\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math\nbase='/workspace/inputs'\nwith open(base+'/Sample_annotated_Zenodo.csv', newline='') as fh:\n    ann=list(csv.DictReader(fh))\ncd14_ids={r['sample'] for r in ann if r['celltype']=='CD14'}\nmeta={}; pc=set()\nwith open(base+'/GeneMetaInfo_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh); h=next(r)\n    gi=h.index('Geneid'); li=h.index('Length'); bi=h.index('gene_biotype')\n    for row in r:\n        if len(row)<=max(gi,li,bi): continue\n        meta[row[gi]]=float(row[li])\n        if row[bi]=='protein_coding': pc.add(row[gi])\ndef pearson(pairs):\n    x=[p[0] for p in pairs]; y=[p[1] for p in pairs]\n    mx=sum(x)/len(x); my=sum(y)/len(y)\n    cov=sum((a-mx)*(b-my) for a,b in zip(x,y))\n    return cov/math.sqrt(sum((a-mx)**2 for a in x)*sum((b-my)**2 for b in y))\nwith open(base+'/BatchCorrectedReadCounts_Zenodo.csv', newline='') as fh:\n    r=csv.reader(fh); header=next(r)\n    header=[x.strip() for x in header]\n    idx=[j for j,h in enumerate(header) if h in cd14_ids]\n    allidx=list(range(1,len(header)))\n    rows=[]\n    for row in r:\n        gid=row[0].strip()\n        if gid not in pc: continue\n        cd14=sum(float(row[j]) for j in idx)\n        alls=sum(float(row[j]) for j in allidx)\n        rows.append((meta[gid],cd14,alls))\n    for name, filt in [\n      ('cd14 total>=10',lambda L,C,A:C>=10),\n      ('all total>=10',lambda L,C,A:A>=10),\n      ('no filter',lambda L,C,A:True),\n      ('cd14 mean>=1 (C>=132)',lambda L,C,A:C>=132),\n    ]:\n        pairs=[(L,C/len(idx)) for L,C,A in rows if filt(L,C,A)]\n        print(name, len(pairs), pearson(pairs))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
