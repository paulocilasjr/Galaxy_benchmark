e return value from the status code (type int) to a dict.\n        \"\"\"\n        url = \"/\".join((self._make_url(history_id, contents=True), dataset_id))\n        return self._put(payload=kwargs, url=url)\n\n","exit_code":0,"status":"completed"}}
