{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math, time\nstart=time.time()\n# Load CD14 sample indices from counts header and annotations set\ncd14=set()\nwith open('inputs/Sample_annotated_Zenodo.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        if row['celltype']=='CD14':\n            cd14.add(row['sample'])\n# Load metadata arrays in order, same order as counts confirmed\ngeneid=[]; length=[]; pc=[]\nwith open('inputs/GeneMetaInfo_Zenodo.csv', newline='') as f:\n    r=csv.reader(f); next(r)\n    for row in r:\n        geneid.append(row[0]); length.append(int(row[3])); pc.append(row[4]=='protein_coding')\nprint('meta loaded', len(geneid), time.time()-start)\n# Read counts header and get CD14 col indexes\ncols=None\nwith open('inputs/BatchCorrectedReadCounts_Zenodo.csv', newline='') as f:\n    r=csv.reader(f); header=next(r); cols=[i for i,c in enumerate(header) if c in cd14]\nprint('n CD14 cols', len(cols), 'expected', len(cd14), 'missing header', len(cd14)-len(cols), cd14-set(header))\nn=len(cols)\n# accumulate\ncnt=0; excluded_less10=0; total_pc=0\nsx=sy=sxx=syy=sxy=0.0\nmissing_values=0\n# also accum log10 length and log10 mean maybe for diagnostics\nslx=sly=slxx=slyy=slxy=0.0\nwith open('inputs/BatchCorrectedReadCounts_Zenodo.csv', newline='') as f:\n    r=csv.reader(f); next(r)\n    for i,row in enumerate(r):\n        if i>=len(geneid):\n            print('extra row', i); break\n        if not pc[i]:\n            continue\n        total_pc+=1\n        try:\n            s=sum(float(row[j]) for j in cols)\n        except Exception as e:\n            print('bad row', i, geneid[i], e, row[:5]); missing_values+=1; continue\n        if s < 10:\n            excluded_less10+=1\n            continue\n        mean=s/n\n        l=float(length[i])\n        cnt+=1\n        sx+=l; sy+=mean; sxx+=l*l; syy+=mean*mean; sxy+=l*mean\n        lx=math.log10(l) if l>0 else 0; ly=math.log10(mean) if mean>0 else 0\n        slx+=lx; sly+=ly; slxx+=lx*lx; slyy+=ly*ly; slxy+=lx*ly\nprint('total pc', total_pc, 'excluded<10', excluded_less10, 'included', cnt, 'missing', missing_values, 'time',time.time()-start)\ndef pear(n,sx,sy,sxx,syy,sxy):\n    denom=math.sqrt((n*sxx-sx*sx)*(n*syy-sy*sy))\n    return (n*sxy-sx*sy)/denom if denom else None\nprint('raw pearson', pear(cnt,sx,sy,sxx,syy,sxy))\nprint('log10 pearson', pear(cnt,slx,sly,slxx,slyy,slxy))\nprint('means len/mean', sx/cnt, sy/cnt)\n# print some quantiles maybe min max\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
