{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"cat > tmp/answer_calc.R <<'EOF'\nlinks <- read.delim('tmp/pau_pathway_links.txt', header=FALSE, sep='\\\\t', stringsAsFactors=FALSE, quote='')\nlinks[,1] <- sub('\"'^[''^:]+:'\"', '', links[,1]); links[,2] <- sub('\"'^[''^:]+:'\"', '', links[,2])\npl <- read.delim('tmp/pau_pathway_list.txt', header=FALSE, sep='\\\\t', stringsAsFactors=FALSE, quote='')\nlinks <- unique(links[links[,2] %in% pl[,1],])\nextid <- unique(links[,1]); N <- length(extid)\nrun <- function(csv) {\n  d <- read.csv(csv, stringsAsFactors=FALSE)\n  gene <- unique(d\"'$gene[!is.na(d$padj) & abs(d$log2FoldChange) > 1.5 & d$padj < 0.05])\n  q <- links[links[,1] %in% gene,,drop=FALSE]\n  qmap <- split(q[,2], q[,1]); n <- length(qmap)\n  terms <- unique(q[,2])\n  fullsizes <- sapply(terms, function(t) length(unique(links[links[,2]==t,1])))\n  terms <- terms[fullsizes >= 10 & fullsizes <= 500]\n  out <- lapply(terms, function(t) {\n    k <- length(unique(q[q[,2]==t,1])); M <- fullsizes[[t]]\n    data.frame(ID=t, k=k, M=M, p=phyper(k-1, M, N-M, n, lower.tail=FALSE))\n  })\n  out <- do.call(rbind, out); out$padj <- p.adjust(out$p, method='\"'BH')\n  out <- out[out\"'$padj < 0.05,]\n  out[order(out$p),]\n}\na <- run('\"'tmp/GluFevsGluFePlus.csv')\nb <- run('tmp/SuccvsGluFePlus.csv')\ncat('iron-depleted significant:\\\\n'); print(a)\ncat('innate-media significant:\\\\n'); print(b)\ncat('iron-only count:', length(setdiff(a\"'$ID,b$ID)), '\"'\\\\n'); print(setdiff(a\"'$ID,b$ID))\nEOF\nRscript tmp/answer_calc.R'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
