{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy.stats import hypergeom\nlinks=[]\nfor line in open('tmp/pau_pathway_links.txt'):\n a,b=line.strip().split('\\\\t'); links.append((b.split(':')[-1],a.split(':')[-1]))\npl={l.split('\\\\t')[0] for l in open('tmp/pau_pathway_list.txt') if l.strip()}\nlinks=[(p,g) for p,g in links if p in pl]\ndf=pd.DataFrame(links,columns=['path','gene'])\np2g={p:set(r.gene) for p,r in df.groupby('path')}; g2p={g:set(r.path) for g,r in df.groupby('gene')}; allg=set(df.gene)\ndef bh(p):\n p=np.asarray(p,float); n=len(p)\n if n==0:return p\n o=np.argsort(p); r=np.empty(n); r[o]=np.arange(1,n+1); a=p*n/r\n for i in range(n-2,-1,-1):\n  if a[o[i+1]]<a[o[i]]:a[o[i]]=a[o[i+1]]\n return a\ndef run(f,minS,maxS,universe_all=False):\n d=pd.read_csv(f); genes=sorted(set(d.gene[(d.log2FoldChange.abs()>1.5)&(d.padj<0.05)]))\n qmap={g:g2p.get(g,set()) for g in genes if g in g2p}; n=len(qmap)\n q2={}\n for ts in qmap.values():\n  for t in ts:q2.setdefault(t,set()).add(g)\n full={t:set(g for g in p2g[t]) for t in q2}\n keep={t for t,M in full.items() if minS<=len(M)<=maxS}\n q2={t:s for t,s in q2.items() if t in keep}; full={t:s for t,s in full.items() if t in keep}\n N=len(allg) if not universe_all else 5828\n out=[]\n for t in q2:\n  k=len(q2[t]); M=len(full[t]); p=hypergeom.sf(k-1,N,M,n); out.append((t,p))\n dfo=pd.DataFrame(out,columns=['ID','p']); dfo['padj']=bh(dfo.p)\n return set(dfo.ID[dfo.padj<0.05])\nfor uni in [False,True]:\n a=run('tmp/GluFevsGluFePlus.csv',10,500,uni); b=run('tmp/SuccvsGluFePlus.csv',10,500,uni)\n print('uni',uni,'A',len(a),'B',len(b),'only',len(a-b),a-b,'inter',a&b)\nfor minS,maxS in [(1,500),(10,1000),(1,10000),(10,500)]:\n a=run('tmp/GluFevsGluFePlus.csv',minS,maxS,False); b=run('tmp/SuccvsGluFePlus.csv',minS,maxS,False)\n print('sizes',minS,maxS,'only',len(a-b),'A',len(a),'B',len(b),a-b)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
