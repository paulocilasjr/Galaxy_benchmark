{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat > tmp/kegg_ora.py <<'PY'\nimport pandas as pd\nfrom scipy.stats import hypergeom\nimport numpy as np, math\n\ndef bh(p):\n    p=np.asarray(p, dtype=float)\n    n=len(p)\n    if n==0: return p\n    order=np.argsort(p, kind='mergesort')\n    rank=np.empty(n, dtype=float)\n    rank[order]=np.arange(1,n+1)\n    adj=p*n/rank\n    # enforce monotonicity as in R p.adjust\n    out=adj.copy()\n    for i in range(n-2,-1,-1):\n        o=order[i]\n        if out[order[i+1]] < out[o]:\n            out[o]=out[order[i+1]]\n    return out\n\n# KEGG links\nlinks=[]\nfor line in open('tmp/pau_pathway_links.txt'):\n    line=line.strip()\n    if not line: continue\n    a,b=line.split('\\\\t')\n    gene=a.split(':')[-1]\n    path=b.split(':')[-1]\n    links.append((path,gene))\nlinks_df=pd.DataFrame(links, columns=['path','gene'])\n\n# list pathways, description\npath_names={}\nfor line in open('tmp/pau_pathway_list.txt'):\n    line=line.strip()\n    if not line: continue\n    pid,name=line.split('\\\\t',1)\n    path_names[pid]=name\n\nlinks_df=links_df[links_df['path'].isin(path_names)].drop_duplicates()\n\npath2genes={p: set(g['gene']) for p,g in links_df.groupby('path')}\ngene2paths={g: set(r['path']) for g,r in links_df.groupby('gene')}\nallext=sorted(set(links_df['gene']))\nprint('links',len(links_df),'genes',len(allext),'pathways',len(path2genes))\n\ndef run(fname):\n    d=pd.read_csv(fname)\n    d=d[(d.log2FoldChange.abs()>1.5) & (d.padj<0.05)]\n    genes=sorted(set(d.gene.dropna()))\n    qext2term={g: gene2paths.get(g,set()) for g in genes}\n    qext2term={g:ts for g,ts in qext2term.items() if ts}\n    n_map=len(qext2term)\n    # qTermID2ExtID with foreground only\n    qterm2ext={}\n    for g,ts in qext2term.items():\n        for t in ts:\n            qterm2ext.setdefault(t,set()).add(g)\n    term2ext={p: path2genes[p] for p in qterm2ext}\n    # filter by full set size after intersect allext (already)\n    kept=[p for p in term2ext if 10 <= len(term2ext[p]) <= 500]\n    qterm2ext={p:qterm2ext[p] for p in kept}\n    term2ext={p:term2ext[p] for p in kept}\n    terms=sorted(qterm2ext)\n    N=len(allext)\n    rows=[]\n    for p in terms:\n        k=len(qterm2ext[p])\n        M=len(term2ext[p])\n        n=n_map\n        pv=hypergeom.sf(k-1, N, M, n)\n        rows.append((p,k,M,pv))\n    df=pd.DataFrame(rows, columns=['ID','Count','Size','pvalue'])\n    df['p.adjust']=bh(df.pvalue.values)\n    df['qvalue']=df['p.adjust']\n    sig=df[df['p.adjust']<0.05].sort_values('p.adjust').copy()\n    sig['Description']=sig.ID.map(path_names)\n    print('\\\\n',fname,'DEGs',len(genes),'mapped foreground',n_map,'tested',len(df),'sig padj',len(sig))\n    print(sig[['ID','Description','Count','Size','pvalue','p.adjust']].to_string(index=False))\n    return set(sig.ID)\n\na=run('tmp/GluFevsGluFePlus.csv')\nb=run('tmp/SuccvsGluFePlus.csv')\ninter=a&b\nonly=a-b\nprint('\\\\nintersection',len(inter),'iron-only',len(only))\nprint('iron-only IDs:', sorted(only))\nprint('intersection IDs:', sorted(inter))\nprint('\\\\nANSWER',len(only))\nPY\npython3 tmp/kegg_ora.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
