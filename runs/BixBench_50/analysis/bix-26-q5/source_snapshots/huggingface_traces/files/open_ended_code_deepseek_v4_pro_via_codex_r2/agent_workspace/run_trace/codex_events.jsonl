{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'EOF'\nlinks <- read.delim('tmp/pau_pathway_links.txt', header=FALSE, sep='\\\\t', stringsAsFactors=FALSE)\nlinks[,1] <- sub('\"'^[''^:]+:'\"', '', links[,1])\nlinks[,2] <- sub('\"'^[''^:]+:'\"', '', links[,2])\npl <- read.delim('tmp/pau_pathway_list.txt', header=FALSE, sep='\\\\t', stringsAsFactors=FALSE)\nlinks <- unique(links[links[,2] %in% pl[,1],])\nextid <- unique(links[,1]); N <- length(extid)\nd <- read.csv('tmp/GluFevsGluFePlus.csv', stringsAsFactors=FALSE)\ngene <- unique(d\"'$gene[abs(d$log2FoldChange)>1.5 & d$padj<0.05])\nq <- links[links[,1] %in% gene,,drop=FALSE]\nqmap <- split(q[,2], q[,1]); n <- length(qmap)\nterms <- unique(q[,2])\nsizes <- sapply(terms, function(t) length(unique(links[links[,2]==t,1])))\nterms <- terms[sizes>=10 & sizes<=500]\nres <- do.call(rbind, lapply(terms, function(t){\n k <- length(unique(q[q[,2]==t,1])); M <- sizes[[t]]\n p <- phyper(k-1, M, N-M, n, lower.tail=FALSE)\n data.frame(ID=t,k=k,M=M,p=p)\n}))\nres$padj <- p.adjust(res$p, method='\"'BH')\nprint(res[order(res\"'$p),], row.names=FALSE)\nprint(res[res$padj<0.05, c('\"'ID','p','padj')], row.names=FALSE)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
