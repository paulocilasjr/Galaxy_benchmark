{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport sys, os, json\nsys.path.insert(0,'/opt/bixbench')\nos.environ['BIXBENCH_WORKSPACE_ROOT']='/workspace'\nfrom bioblend.galaxy import GalaxyInstance\nfrom galaxy_execute_mcp_core import _read_api_key\ngi=GalaxyInstance('https://usegalaxy.org', key=_read_api_key())\nhist='bbd44e69cb8906b5ca6b037d8cf39bfc'\ntool='toolshed.g2.bx.psu.edu/repos/goeckslab/kegg_ora/kegg_ora/0.1.0+galaxy1'\nfor fmt in ['21.01']:\n inputs={'foreground': {'src':'hda','id':'f9cad7b01a472135623082490c703e4e'}, 'foreground_has_header': True, 'foreground_column':1, 'background_cond': {'selector':'all_mapped'}, 'mapping_source': {'selector':'kegg_rest','organism':'pau'}, 'p_adjust_scope':'all_pathways'}\n b=gi.tools.build(tool, inputs=inputs, history_id=hist)\n print('FMT',fmt)\n # recursively print input names and values for conditionals\n def walk(nodes, pre=''):\n  for n in nodes:\n   name=n.get('name'); typ=n.get('type'); val=n.get('value')\n   print(pre+str(name), typ, 'VAL=', (str(val)[:120] if val is not None else None))\n   if typ=='conditional':\n    # print cases values too\n    for c in n.get('cases',[]):\n     print(pre+' case', c.get('value'))\n     walk(c.get('inputs',[]), pre+'  ')\n   else:\n    walk(n.get('inputs',[]), pre+'  ')\n walk(b['inputs'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
