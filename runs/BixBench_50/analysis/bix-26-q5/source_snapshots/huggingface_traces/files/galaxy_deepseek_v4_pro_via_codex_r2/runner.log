{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport csv, os\nfiles={'iron':'/workspace/tmp/GluFe_kegg.tsv','innate':'/workspace/tmp/Succ_kegg.tsv'}\nsets={}\nfor key,f in files.items():\n    rows=[]\n    with open(f) as fh:\n        r=csv.DictReader(fh, delimiter='\\\\t')\n        for row in r:\n            try:\n                adj=float(row['adjusted_p_value'])\n            except:\n                adj=None\n            if adj is not None and adj < 0.05:\n                rows.append(row)\n    sets[key]=[row['pathway_id'] for row in rows]\n    print(key, 'sig', len(rows))\n    for row in rows:\n        print(' ', row['pathway_id'], row['pathway_name'], row['adjusted_p_value'])\niron=set(sets['iron']); innate=set(sets['innate'])\nprint('iron sig',len(iron),'innate sig',len(innate))\nprint('iron not innate',len(iron-innate))\nprint(sorted(iron-innate))\nprint('intersection', sorted(iron&innate))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
