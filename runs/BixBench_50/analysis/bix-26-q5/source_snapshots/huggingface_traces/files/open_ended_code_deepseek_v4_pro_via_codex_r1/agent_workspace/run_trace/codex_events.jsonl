{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np, requests, math, time, os\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\n\ndef read_csv(path):\n    df=pd.read_csv(path)\n    df['padj']=pd.to_numeric(df['padj'], errors='coerce')\n    df['log2FoldChange']=pd.to_numeric(df['log2FoldChange'], errors='coerce')\n    return df\n\ndef fetch_kegg(species='pau', cache_dir='/tmp'):\n    cache_link=os.path.join(cache_dir, f'kegg_link_pathway_{species}.txt')\n    cache_list=os.path.join(cache_dir, f'kegg_list_pathway_{species}.txt')\n    if not os.path.exists(cache_link):\n        r=requests.get(f'https://rest.kegg.jp/link/pathway/{species}', timeout=120)\n        r.raise_for_status()\n        open(cache_link,'w').write(r.text)\n    if not os.path.exists(cache_list):\n        r=requests.get(f'https://rest.kegg.jp/list/pathway/{species}', timeout=120)\n        r.raise_for_status()\n        open(cache_list,'w').write(r.text)\n    link=open(cache_link).read().splitlines()\n    names=open(cache_list).read().splitlines()\n    return link, names\n\ndef parse_mapping(link, names):\n    # clusterProfiler strips everything before colon for both\n    rows=[]\n    for line in link:\n        if not line.strip(): continue\n        parts=line.split('\\\\t')\n        if len(parts)<2: continue\n        # KEGGREST keggLink returns gene in first? Our endpoint link/pathway/pau gives gene -> path\n        g=parts[0].split(':',1)[-1]\n        p=parts[1].split(':',1)[-1]\n        rows.append((p,g))\n    path2gene=pd.DataFrame(rows, columns=['path','gene']).dropna().drop_duplicates()\n    path2name={}\n    for line in names:\n        if not line.strip(): continue\n        parts=line.split('\\\\t')\n        if len(parts)<2: continue\n        pid=parts[0]\n        # clusterProfiler name strip; not needed\n        nm=parts[1]\n        path2name[pid]=nm\n    # filter to named terms\n    path2gene=path2gene[path2gene['path'].isin(path2name.keys())].copy()\n    return path2gene, path2name\n\ndef r_bh(p):\n    p=np.asarray(p, dtype=float)\n    n=len(p)\n    if n==0: return np.array([])\n    i=np.arange(n,0,-1)\n    o=np.argsort(p, kind='stable')[::-1] # decreasing p? Wait R o <- order(p, decreasing=TRUE)\n    ro=np.argsort(o, kind='stable')\n    adj=pmin_one(np.minimum.accumulate((n/i)*p[o]))[ro]\n    return adj\n\ndef pmin_one(x):\n    return np.minimum(1.0, x)\n\ndef ora(genes, path2gene):\n    # genes iterable; unique, strings\n    genes=[str(g) for g in genes]\n    genes=list(dict.fromkeys(genes))\n    # gene -> path mapping from annotation (all)\n    g2p=path2gene.groupby('gene')['path'].apply(list).to_dict()\n    # qExtID2TermID only for input genes mapped\n    qmap={g:g2p[g] for g in genes if g in g2p}\n    if not qmap: return None, {}\n    # qExtID2TermID.df & split\n    rows=[]\n    for g,ps in qmap.items():\n        for p in ps:\n            rows.append((p,g))\n    df=pd.DataFrame(rows,columns=['path','gene']).drop_duplicates()\n    qterm2ext={p:list(grp['gene']) for p,grp in df.groupby('path')}\n    # extID universe = all unique genes in path2gene\n    extID=list(dict.fromkeys(path2gene['gene']))\n    # no universe -> as is\n    qterm2ext={p:[g for g in gs if g in extID] for p,gs in qterm2ext.items()}\n    qterms=list(qterm2ext.keys())\n    term2ext={p:[g for g in path2gene.loc[path2gene.path==p,'gene'] if g in extID] for p in qterms}\n    # filter size\n    idx={p for p in qterms if 10 <= len(term2ext[p]) <= 500}\n    qterms=[p for p in qterms if p in idx]\n    qterm2ext={p:qterm2ext[p] for p in qterms}\n    term2ext={p:term2ext[p] for p in qterms}\n    qterms=list(dict.fromkeys(qterm2ext.keys()))\n    if not qterms: return None, {}\n    k=np.array([len(qterm2ext[p]) for p in qterms], dtype=int)\n    M=np.array([len(term2ext[p]) for p in qterms], dtype=int)\n    N=len(extID)\n    n=len(qmap)\n    # p-values\n    pvals=[]\n    for kk,mm in zip(k,M):\n        # phyper(kk-1, mm, N-mm, n, lower.tail=FALSE)\n        p=hypergeom.sf(kk-1, N, mm, n)\n        pvals.append(p)\n    pvals=np.array(pvals)\n    adj=r_bh(pvals)\n    res=pd.DataFrame({\n        'ID':qterms,\n        'Count':k,\n        'Size':M,\n        'pvalue':pvals,\n        'p.adjust':adj,\n        'geneID':['/'.join(qterm2ext[p]) for p in qterms],\n    })\n    return res, path2name\n\ndef enriched_pathways(res):\n    return set(res.loc[res['p.adjust']<0.05,'ID'])\n\nlink,names=fetch_kegg('pau')\np2g,p2n=parse_mapping(link,names)\nprint('mapping rows', len(p2g), 'genes', p2g.gene.nunique(), 'terms', p2g.path.nunique())\nfor label,file in [('GluFe','/workspace/res_GluFevsGluFePlus.csv'),('Succ','/workspace/res_SuccvsGluFePlus.csv')]:\n    df=read_csv(file)\n    sig=df[(df['log2FoldChange'].abs()>1.5)&(df['padj']<0.05)]\n    genes=sig['gene'].tolist()\n    print('\\\\n',label,'input genes',len(genes))\n    res,nm=ora(genes,p2g)\n    if res is None:\n        print('no result'); continue\n    print('tested terms',len(res),'sig p.adjust<0.05', (res.p.adjust<0.05).sum())\n    print('top:',res.sort_values('p.adjust').head(10).to_string(index=False))\n    print('sig terms:')\n    for row in res[res.p.adjust<0.05].sort_values('p.adjust').itertuples():\n        print(row.ID, row.Count, row.p.adjust, p2n.get(row.ID))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
