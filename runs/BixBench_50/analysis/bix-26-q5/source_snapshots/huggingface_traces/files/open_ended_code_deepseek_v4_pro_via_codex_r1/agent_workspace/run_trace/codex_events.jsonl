{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\n# replicate DOSE ORA in base R using cached KEGG mapping\nread_tab <- function(file, header=TRUE) read.csv(file, stringsAsFactors=FALSE)\nfor (spec in c('GluFevsGluFePlus','SuccvsGluFePlus')) {\n  df <- read.csv(paste0('/workspace/res_',spec,'.csv'), stringsAsFactors=FALSE)\n  cat('\\\\n',spec,'rows',nrow(df),'pass',sum(abs(df\"'$log2FoldChange)>1.5 & !is.na(df$padj) & df$padj<0.05, na.rm=TRUE),'\"'\\\\n')\n}\nlink <- readLines('/tmp/kegg_link_pathway_pau.txt')\nname_lines <- readLines('/tmp/kegg_list_pathway_pau.txt')\n# strip prefixes\nlink_rows <- strsplit(link, '\\\\t')\ngene <- sapply(link_rows, function(x) sub('\"'^[''^:]+:'\"','',x[1]))\npath <- sapply(link_rows, function(x) sub('\"'^[''^:]+:'\"','',x[2]))\np2g <- unique(data.frame(path=path, gene=gene, stringsAsFactors=FALSE))\np2n <- setNames(sub('\\\\t.*','',name_lines), sub('\"'^[''^'\"\\\\t]*\\\\t','',name_lines))\n# clusterProfiler name df: first col ID, second name\nname_tab <- do.call(rbind, strsplit(name_lines, '\\\\t'))\ncolnames(name_tab) <- c('path','name')\n# filter mapping to named terms\np2g <- p2g[p2g\"'$path %in% name_tab[,'\"'path'],,drop=FALSE]\ncat('mapping rows',nrow(p2g),'genes',length(unique(p2g\"'$gene)),'\"'terms',length(unique(p2g\"'$path)),'\"'\\\\n')\n\nora_base <- function(gene_vec, p2g) {\n  gene_vec <- unique(as.character(gene_vec))\n  # EXTID2TERMID mapping\n  e2p <- split(p2g\"'$path, p2g$gene)\n  qe2p <- e2p[gene_vec]\n  len <- lengths(qe2p)\n  qe2p <- qe2p[len>0]\n  if(length(qe2p)==0) return(NULL)\n  qdf <- data.frame(extID=rep(names(qe2p), times=lengths(qe2p)), termID=unlist(qe2p, use.names=FALSE), stringsAsFactors=FALSE)\n  qdf <- unique(qdf)\n  qterm2ext <- split(qdf$extID, qdf$termID)\n  extID <- unique(p2g$gene)\n  qterm2ext <- lapply(qterm2ext, intersect, extID)\n  qterms <- unique(names(qterm2ext))\n  term2ext <- split(p2g$gene, p2g$path)[qterms]\n  term2ext <- lapply(term2ext, intersect, extID)\n  idx <- lengths(term2ext) >=10 & lengths(term2ext) <=500\n  term2ext <- term2ext[idx]\n  qterm2ext <- qterm2ext[idx]\n  qterms <- unique(names(qterm2ext))\n  term2ext <- term2ext[qterms]\n  qterm2ext <- qterm2ext[qterms]\n  k <- lengths(qterm2ext); M <- lengths(term2ext)\n  N <- length(extID); n <- length(qe2p)\n  pvalues <- mapply(function(kk, mm) phyper(kk-1, mm, N-mm, n, lower.tail=FALSE), k, M)\n  padj <- p.adjust(pvalues, method='\"'BH')\n  res <- data.frame(ID=qterms, Count=k, Size=M, pvalue=pvalues, p.adjust=padj, stringsAsFactors=FALSE)\n  res[order(pvalues),]\n}\nfor (spec in c('GluFevsGluFePlus','SuccvsGluFePlus')) {\n  df <- read.csv(paste0('/workspace/res_',spec,'.csv'), stringsAsFactors=FALSE)\n  genes <- df\"'$gene[abs(df$log2FoldChange)>1.5 & !is.na(df$padj) & df$padj<0.05]\n  res <- ora_base(genes,p2g)\n  cat('\"'\\\\n',spec,'tested',nrow(res),'sig',sum(res\"'$p.adjust<0.05),'\"'\\\\n')\n  print(res[res\"'$p.adjust<0.05,c('\"'ID','Count','Size','pvalue','p.adjust')])\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
