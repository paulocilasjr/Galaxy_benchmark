'gene')['path'].apply(list).to_dict()\n    qmap={g:g2p[g] for g in genes if g in g2p}\n    if not qmap: return None\n    rows=[]\n    for g,ps in qmap.items():\n        for path in ps: rows.append((path,g))\n    df=pd.DataFrame(rows,columns=['path','gene']).drop_duplicates()\n    qterm2ext={path:list(grp['gene']) for path,grp in df.groupby('path')}\n    extID=list(dict.fromkeys(p2g['gene']))\n    qterm2ext={path:[g for g in gs if g in extID] for path,gs in qterm2ext.items()}\n    qterms=list(qterm2ext.keys())\n    term2ext={path:[g for g in p2g.loc[p2g.path==path,'gene'] if g in extID] for path in qterms}\n    idx=[path for path in qterms if 10<=len(term2ext[path])<=500]\n    qterms=[path for path in idx]\n    qterm2ext={path:qterm2ext[path] for path in qterms}\n    term2ext={path:term2ext[path] for path in qterms}\n    qterms=list(dict.fromkeys(qterm2ext.keys()))\n    if not qterms: return None\n    k=np.array([len(qterm2ext[path]) for path in qterms],dtype=int)\n    M=np.array([len(term2ext[path]) for path in qterms],dtype=int)\n    N=len(extID); n=len(qmap)\n    pvals=np.array([hypergeom.sf(kk-1,N,mm,n) for kk,mm in zip(k,M)],dtype=float)\n    adj=r_bh(pvals)\n    return pd.DataFrame({'ID':qterms,'Count':k,'Size':M,'pvalue':pvals,'p.adjust':adj,\n                         'geneID':['/'.join(qterm2ext[path]) for path in qterms]})\n\ndef show(label,file,p2g,p2n):\n    df=read_csv(file); sig=df[(df.log2FoldChange.abs()>1.5)&(df.padj<0.05)]\n    genes=sig.gene.tolist(); print('\\\\n',label,'input',len(genes))\n    res=ora(genes,p2g)\n    if res is None: print('no result'); return\n    print('tested',len(res),'sig',(res['p.adjust']<0.05).sum())\n    for row in res[res['p.adjust']<0.05].sort_values('p.adjust').itertuples():\n        print(row.ID, row.Count, row.Size, row.pvalue, row.p_adjust if '_' in '' else row[5], p2n.get(row.ID))\n    print('nonsig top:')\n    print(res.sort_values('p.adjust').head(20).to_string(index=False))\n\nlink,names=fetch_kegg('pau'); p2g,p2n=parse_mapping(link,names)\nprint('mapping rows',len(p2g),'genes',p2g.gene.nunique(),'terms',p2g.path.nunique())\nshow('GluFe','/workspace/res_GluFevsGluFePlus.csv',p2g,p2n)\nshow('Succ','/workspace/res_SuccvsGluFePlus.csv',p2g,p2n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
