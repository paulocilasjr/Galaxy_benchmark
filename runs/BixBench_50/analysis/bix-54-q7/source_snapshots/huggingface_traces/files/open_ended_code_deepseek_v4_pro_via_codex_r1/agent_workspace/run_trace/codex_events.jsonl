{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom patsy import dmatrix, cr\nimport statsmodels.api as sm\ntry:\n    df=pd.read_csv('inputs/Swarm_2.csv')\n    dd=df[df.StrainNumber=='287_98'].copy()\n    dd['p']=dd.Ratio.str.split(':').apply(lambda z: float(z[0])/sum(map(float,z)))\n    y=dd.Area.values; x=dd.p.values\n    # fit cr df=4\n    X=dmatrix('cr(p, df=4)', dd, return_type='dataframe')\n    model=sm.OLS(y,X).fit()\n    print(X.shape)\n    print('AIC',model.aic,'params',model.params)\n    grid=np.linspace(x.min(),x.max(),10001)\n    Xg=dmatrix('cr(grid, df=4)', {'grid':grid}, return_type='dataframe')\n    pred=model.predict(Xg)\n    i=pred.argmax()\n    print('max grid p',grid[i],'area',pred[i])\n    # optimize exact\n    from scipy.optimize import minimize_scalar\n    def pr(p):\n        Xp=dmatrix('cr(x, df=4)', {'x':[p]}, return_type='dataframe')\n        return float(model.predict(Xp)[0])\n    res=minimize_scalar(lambda p:-pr(p),bounds=(x.min(),x.max()),method='bounded',options={'xatol':1e-14})\n    print('opt',res.x,pr(res.x))\nexcept Exception as e:\n    import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
