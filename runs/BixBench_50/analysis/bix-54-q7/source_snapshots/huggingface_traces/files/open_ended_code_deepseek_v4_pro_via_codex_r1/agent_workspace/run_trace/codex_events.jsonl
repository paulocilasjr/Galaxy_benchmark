{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('/workspace/inputs/Swarm_2.csv')\n# Restrict to the actual 287:98 mixture system. Pure-strain rows are not mixtures\n# and would not define a meaningful proportion of strain 287 in a mixture.\nmix <- d[d\"'$StrainNumber == '\"'287_98', ]\nmix\"'$p287 <- vapply(strsplit(mix$Ratio, '\"':', fixed=TRUE),\n                   function(z) as.numeric(z[1]) / sum(as.numeric(z)),\n                   numeric(1))\nstopifnot(nrow(mix) == 36, \"'!anyNA(mix$p287), min(mix$p287) > 0, max(mix$p287) < 1)\n\nfit_q <- lm(Area ~ p287 + I(p287''^2), data=mix)\nfit_c <- lm(Area ~ p287 + I(p287''^2) + I(p287''^3), data=mix)\nfit_s <- lm(Area ~ ns(p287, df=4), data=mix)\n\ncat(sprintf('\"'n=%d; AIC quadratic=%.6f cubic=%.6f spline4=%.6f\\\\n',\n            nrow(mix), AIC(fit_q), AIC(fit_c), AIC(fit_s)))\ncat(sprintf('AdjR2 quadratic=%.6f cubic=%.6f spline4=%.6f\\\\n',\n            summary(fit_q)\"'$adj.r.squared,\n            summary(fit_c)$adj.r.squared,\n            summary(fit_s)$adj.r.squared))\n\npred_s <- function(p) as.numeric(predict(fit_s, newdata=data.frame(p287=p)))\nopt <- optimize(pred_s, interval=range(mix$p287), maximum=TRUE,\n                tol=.Machine$double.eps''^0.25)\ncat(sprintf('\"'best=spline4; optimum_p287=%.20f; max_pred_area=%.20f\\\\n',\n            opt\"'$maximum, opt$objective))\ncat(sprintf('\"'R-default print max: %.10g\\\\n', opt\"'$objective))\ncat(sprintf('\"'round1=%.1f round2=%.2f round0=%d\\\\n',\n            opt\"'$objective, opt$objective, round(opt$objective)))\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
