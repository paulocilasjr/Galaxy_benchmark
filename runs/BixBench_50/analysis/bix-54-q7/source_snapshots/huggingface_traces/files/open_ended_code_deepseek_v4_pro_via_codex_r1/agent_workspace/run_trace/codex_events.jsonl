{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('inputs/Swarm_2.csv'); dd <- d[d\"'$StrainNumber=='\"'287_98',]\ndd\"'$p <- vapply(strsplit(dd$Ratio,'\"':'), function(z) as.numeric(z[1])/sum(as.numeric(z)), numeric(1))\n# default boundary knots range\nf1 <- lm(Area~ns(p,df=4),data=dd)\n# fixed boundary 0,1\nf2 <- lm(Area~ns(p,df=4,Boundary.knots=c(0,1)),data=dd)\n# fixed boundary min/max same\nf3 <- lm(Area~ns(p,df=4,Boundary.knots=range(dd\"'$p)),data=dd)\nfor(nm in c('\"'default','bk01','bkrange')) {\n f <- switch(nm,default=f1,bk01=f2,bkrange=f3)\n pr <- function(x) predict(f,newdata=data.frame(p=x))\n o <- optimize(pr,interval=range(dd\"'$p),maximum=TRUE,tol=1e-12)\n cat(nm,'\"'AIC',AIC(f),'maxp',o\"'$maximum,'\"'maxy',o\"'$objective,'\"'\\\\n')\n}\n# compare predictions at 0.9076577\ncat('pred default',predict(f1,newdata=data.frame(p=.9076577)),'bk01',predict(f2,newdata=data.frame(p=.9076577)),'\\\\n')\n# inspect knots\nprint(attr(ns(dd\"'$p,df=4),'\"'knots'))\nprint(attr(ns(dd\"'$p,df=4,Boundary.knots=c(0,1)),'\"'knots'))\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
