{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom patsy import dmatrix, cr\nimport statsmodels.api as sm\nfrom scipy.optimize import minimize_scalar\n\ndf=pd.read_csv('inputs/Swarm_2.csv')\ndd=df[df.StrainNumber=='287_98'].copy()\ndd['p']=dd.Ratio.str.split(':').apply(lambda z: float(z[0])/sum(map(float,z)))\ny=dd.Area.values; x=dd.p.values\nX=dmatrix('cr(p, df=4)', dd, return_type='dataframe')\nmodel=sm.OLS(y,X).fit()\nprint('X shape',X.shape,'AIC',model.aic)\ngrid=np.linspace(x.min(),x.max(),200001)\nXg=dmatrix('cr(grid, df=4)', {'grid':grid}, return_type='dataframe')\npred=model.predict(Xg)\ni=int(pred.argmax())\nprint('max grid p',grid[i],'area',pred[i])\ndef pr(p):\n    Xp=dmatrix('cr(x, df=4)', {'x':[p]}, return_type='dataframe')\n    return float(model.predict(Xp)[0])\nres=minimize_scalar(lambda p:-pr(p),bounds=(x.min(),x.max()),method='bounded',options={'xatol':1e-14,'maxiter':10000})\nprint('opt p',repr(res.x),'area',repr(pr(res.x)))\n# maybe use mean aggregated\nagg=dd.groupby('p',as_index=False).Area.mean()\ny2=agg.Area.values; x2=agg.p.values\nX2=dmatrix('cr(p, df=4)', agg, return_type='dataframe')\nm2=sm.OLS(y2,X2).fit()\nprint('agg AIC',m2.aic)\ngrid2=np.linspace(x2.min(),x2.max(),200001)\nXg2=dmatrix('cr(grid, df=4)', {'grid':grid2}, return_type='dataframe')\npred2=m2.predict(Xg2); i2=int(pred2.argmax())\nprint('agg max grid p',grid2[i2],'area',pred2[i2])\ndef pr2(p):\n    Xp=dmatrix('cr(x, df=4)', {'x':[p]}, return_type='dataframe')\n    return float(m2.predict(Xp)[0])\nres2=minimize_scalar(lambda p:-pr2(p),bounds=(x2.min(),x2.max()),method='bounded',options={'xatol':1e-14})\nprint('agg opt',repr(res2.x),repr(pr2(res2.x)))\n# inspect knots / design\nprint('columns',X.columns)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
