{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('inputs/Swarm_2.csv')\n# create p using labels\nparse_prop <- function(sn, ratio) {\n  if (\"'!grepl('\"'_', sn)) {\n    # pure labels: 1,98,287; proportion strain287 = 1 for sn 287, 0 for others\n    if (sn == '287') return(1)\n    if (sn == '98') return(0)\n    return(NA)\n  }\n  parts <- strsplit(ratio, ':')[[1]]\n  a <- as.numeric(parts[1]); b <- as.numeric(parts[2])\n  a/(a+b)\n}\nd\"'$p <- mapply(parse_prop, d$StrainNumber, d$Ratio)\nprint(d[,c('\"'StrainNumber','Ratio','Area','p')])\ncat('rows all valid:', sum(\"'!is.na(d$p)), '\"'\\\\n')\nfor(sc in c('interior','boundaries','all_mixture_plus_bounds')) {\n if(sc=='interior') dd <- d[grepl('_',d\"'$StrainNumber),]\n else if(sc=='\"'boundaries') dd <- d[grepl('_',d\"'$StrainNumber) | d$StrainNumber %in% c('\"'287','98'),]\n else dd <- d[grepl('_',d\"'$StrainNumber) | d$StrainNumber %in% c('\"'287','98','1'),]\n cat('\\\\nSCOPE',sc,'n',nrow(dd),'p range',range(dd\"'$p),'\"'\\\\n')\n fit2 <- lm(Area ~ p + I(p\"'^2), data=dd)\n fit3 <- lm(Area ~ p + I(p''^2)+I(p''^3), data=dd)\n fit4 <- lm(Area ~ ns(p, df=4), data=dd)\n for(nm in c('\"'quad','cubic','spline4')) {\n   f <- switch(nm, quad=fit2, cubic=fit3, spline4=fit4)\n   aic <- AIC(f)\n   # optimize over observed range\n   lo <- min(dd\"'$p); hi <- max(dd$p)\n   if(nm=='\"'spline4') {\n     pred <- function(x) predict(f, newdata=data.frame(p=x))\n   } else pred <- function(x) predict(f, newdata=data.frame(p=x))\n   # sample\n   grid <- seq(lo,hi,length.out=10001)\n   y <- pred(grid)\n   imax <- which.max(y)\n   cat(nm,'AIC',aic,'max at p',grid[imax],'pred',y[imax],'endpoints',pred(c(lo,hi)),'\\\\n')\n }\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
