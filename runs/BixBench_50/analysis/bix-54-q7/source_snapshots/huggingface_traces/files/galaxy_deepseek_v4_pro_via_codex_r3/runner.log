{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat >/workspace/tmp/fit_models.R <<'RS'\nargs <- commandArgs(trailingOnly=TRUE)\nstopifnot(length(args) == 2L)\ninput <- args[[1]]\noutput <- args[[2]]\n\nlibrary(splines)\n\nd <- read.csv(input, stringsAsFactors=FALSE)\nstopifnot(all(c(\\\"StrainNumber\\\", \\\"Ratio\\\", \\\"Area\\\") %in% names(d)))\n\nparse_p <- function(s) {\n  parts <- strsplit(s, \\\":\\\", fixed=TRUE)[[1]]\n  if (length(parts) \"'!= 2L) return(NA_real_)\n  vals <- suppressWarnings(as.numeric(parts))\n  if (anyNA(vals) || any(vals < 0) || sum(vals) == 0) return(NA_real_)\n  vals[[1]] / sum(vals)\n}\n\nmake_scope <- function(dat, lo, hi) {\n  fit_models <- list(\n    quadratic = lm(Area ~ p + I(p''^2), data=dat),\n    cubic = lm(Area ~ p + I(p''^2) + I(p''^3), data=dat),\n    spline = lm(Area ~ ns(p, df=4), data=dat)\n  )\n  rows <- list()\n  for (model_name in names(fit_models)) {\n    m <- fit_models[[model_name]]\n    n <- length(residuals(m))\n    k <- length(coef(m))\n    rss <- sum(residuals(m)''^2)\n    sigma <- summary(m)$sigma\n    aic <- AIC(m)\n    bic <- BIC(m)\n    adjr2 <- summary(m)$adj.r.squared\n    grid <- seq(lo, hi, length.out=20001L)\n    pred <- predict(m, newdata=data.frame(p=grid))\n    idx <- which.max(pred)\n    rows[[length(rows) + 1L]] <- data.frame(\n      model = model_name,\n      n = n,\n      k = k,\n      rss = rss,\n      sigma = sigma,\n      AIC = aic,\n      BIC = bic,\n      adjR2 = adjr2,\n      opt_p = grid[[idx]],\n      opt_pred = pred[[idx]],\n      stringsAsFactors = FALSE\n    )\n  }\n  out <- do.call(rbind, rows)\n  out$scope <- attr(dat, \"scope\")\n  out\n}\n\n# Mixture-only scope\nd_mix <- d[d$StrainNumber == \"287_98\", , drop=FALSE]\nd_mix$p <- vapply(d_mix$Ratio, parse_p, numeric(1))\nd_mix <- d_mix[!is.na(d_mix$p) & is.finite(d_mix$Area), , drop=FALSE]\nattr(d_mix, \"scope\") <- \"mix_only\"\nstopifnot(nrow(d_mix) > 3L)\n\n# Boundary scope: pure 287 (p=1), pure 98 (p=0), and 287_98 mixtures.\npure <- d[d$StrainNumber %in% c(\"287\", \"98\"), , drop=FALSE]\npure$p <- ifelse(pure$StrainNumber == \"287\", 1, 0)\nbound <- data.frame(\n  p = c(pure$p, d_mix$p),\n  Area = c(pure$Area, d_mix$Area),\n  stringsAsFactors = FALSE\n)\nbound <- bound[!is.na(bound$p) & is.finite(bound$Area), , drop=FALSE]\nattr(bound, \"scope\") <- \"boundary\"\nstopifnot(nrow(bound) > 3L)\n\nmix_res <- make_scope(d_mix, min(d_mix$p), max(d_mix$p))\nbound_res <- make_scope(bound, 0, 1)\n\nall_res <- rbind(mix_res, bound_res)\nall_res <- all_res[, c(\"scope\", \"model\", \"n\", \"k\", \"rss\", \"sigma\", \"AIC\", \"BIC\", \"adjR2\", \"opt_p\", \"opt_pred\")]\nwrite.table(all_res, file=output, sep=\"'\"\\\\t\\\", quote=FALSE, row.names=FALSE, col.names=TRUE)\nRS\ncat >/workspace/tmp/synth.csv <<'CSV'\nDishNumber,StrainNumber,Ratio,Replicate,Area,Circularity,Round\n1,287,1:0,A,10,0.7,0.9\n2,98,1:0,A,14,0.5,0.8\n3,287_98,1:3,A,20,0.4,0.5\n4,287_98,1:1,A,35,0.3,0.7\n5,287_98,3:1,A,50,0.2,0.8\n6,287_98,10:1,A,70,0.1,0.9\nCSV\nRscript /workspace/tmp/fit_models.R /workspace/tmp/synth.csv /workspace/tmp/synth_out.tsv\ncat /workspace/tmp/synth_out.tsv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
