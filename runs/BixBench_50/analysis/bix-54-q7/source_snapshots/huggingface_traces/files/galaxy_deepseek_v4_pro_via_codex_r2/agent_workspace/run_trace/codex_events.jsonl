  quadratic = lm(Area ~ p + I(p^2), data = d),\\n  cubic = lm(Area ~ p + I(p^2) + I(p^3), data = d),\\n  natural_spline = lm(Area ~ ns(p, df = 4), data = d)\\n)\\n\\npred_at <- function(fit, x) {\\n  predict(fit, newdata = data.frame(p = x))\\n}\\n\\nglobal_max <- function(fit, lower, upper) {\\n  grid <- seq(lower, upper, length.out = 5001)\\n  vals <- pred_at(fit, grid)\\n  i <- which.max(vals)\\n\\n  left <- grid[max(1L, i - 2L)]\\n  right <- grid[min(length(grid), i + 2L)]\\n  local <- optimize(function(x) pred_at(fit, x), interval = c(left, right),\\n                    maximum = TRUE, tol = 1e-10)\\n\\n  full <- optimize(function(x) pred_at(fit, x), interval = c(lower, upper),\\n                   maximum = TRUE, tol = 1e-10)\\n\\n  if (full$objective >= local$objective) {\\n    full\\n  } else {\\n    local\\n  }\\n}\\n\\nlower <- min(d$p)\\nupper <- max(d$p)\\nrows <- list()\\n\\nfor (nm in names(fit_models)) {\\n  fit <- fit_models[[nm]]\\n  opt <- global_max(fit, lower, upper)\\n  aic <- AIC(fit)\\n  bic <- BIC(fit)\\n  edf <- as.numeric(extractAIC(fit)[1])\\n  adj_r2 <- summary(fit)$adj.r.squared\\n\\n  rows[[length(rows) + 1L]] <- data.frame(\\n    model = nm,\\n    edf = edf,\\n    n = nrow(d),\\n    aic = as.numeric(aic),\\n    bic = as.numeric(bic),\\n    adj_r2 = adj_r2,\\n    optimum_p = opt$maximum,\\n    max_area = opt$objective,\\n    stringsAsFactors = FALSE\\n  )\\n}\\n\\nsummary_df <- do.call(rbind, rows)\\nwrite.csv(summary_df, file = out_path, row.names = FALSE, quote = FALSE)\\n\\nEOF\\nRscript analysis.R \\\"$(inputs.input.path)\\\" model_summary.csv\\n\", \"version\": \"0.1.0\"}, \"tool_format\": \"GalaxyUserTool\", \"tool_id\": \"colony_area_mixture_model_comparison_v1\", \"uuid\": \"8a31b854-fead-4b4f-9d85-739e5af1a15a\"}\n{\"implicit_collections\": [], \"jobs\": [{\"create_time\": \"2026-08-15T14:54:43.792904\", \"exit_code\": null, \"galaxy_version\": \"26.1\", \"history_id\": \"bbd44e69cb8906b5b1d7cbff225add57\", \"id\": \"bbd44e69cb