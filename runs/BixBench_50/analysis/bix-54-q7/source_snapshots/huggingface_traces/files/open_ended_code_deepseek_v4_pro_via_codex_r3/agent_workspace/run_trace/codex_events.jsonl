{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('/workspace/inputs/Swarm_2.csv')\nm <- d[d\"'$StrainNumber=='\"'287_98',]\nsp <- strsplit(m\"'$Ratio, '\"':')\nnum <- as.numeric(sapply(sp, \"'`[`,1)); den <- as.numeric(sapply(sp, `[`,2)); m$p <- num/(num+den)\nfit <- lm(Area ~ ns(p, df=4), data=m)\ncat('\"'coef:\\\\n'); print(coef(fit)); print(summary(fit)); print(AIC(fit))\n# continuous grid\npseq <- seq(min(m\"'$p), max(m$p), length.out=1e6)\npred <- predict(fit, newdata=data.frame(p=pseq))\ni <- which.max(pred)\ncat('\"'grid opt p', format(pseq[i],digits=16), 'area', format(pred[i],digits=16),'\\\\n')\n# optimize\nneg <- function(p) -predict(fit, newdata=data.frame(p=p))\no <- optimize(neg, interval=c(min(m\"'$p), max(m$p)), tol=1e-12)\ncat('\"'optimize opt p', format(o\"'$minimum,digits=16), '\"'area', format(-o\"'$objective,digits=16),'\"'\\\\n')\n# observed points predictions\nobs <- sort(unique(m\"'$p))\npr <- predict(fit,newdata=data.frame(p=obs))\nprint(data.frame(p=obs,pred=pr),digits=16)\n# endpoints and pure if full\ncat('\"'\\\\nfull boundaries model\\\\n')\nb <- d[d\"'$StrainNumber %in% c('\"'98','287'),]\nb\"'$p <- ifelse(b$StrainNumber=='\"'287',1,0)\nfull <- rbind(m[,c('Area','p')], b[,c('Area','p')])\nfitf <- lm(Area ~ ns(p, df=4), data=full)\no2 <- optimize(function(p) -predict(fitf,newdata=data.frame(p=p)), c(0,1), tol=1e-12)\ncat('full opt p', format(o2\"'$minimum,digits=16), '\"'area', format(-o2\"'$objective,digits=16),'\"'\\\\n')\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
