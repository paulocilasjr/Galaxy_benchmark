{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('/workspace/inputs/Swarm_2.csv'); m <- d[d\"'$StrainNumber=='\"'287_98',]\nsp <- strsplit(m\"'$Ratio, '\"':'); num <- as.numeric(sapply(sp, \"'`[`,1)); den <- as.numeric(sapply(sp, `[`,2)); m$p <- num/(num+den)\n# leave-one-out RMSE and maybe leave one replicate group out\nforms <- list(quadratic=Area~p+I(p''^2), cubic=Area~p+I(p''^2)+I(p''^3), spline=Area~ns(p,df=4))\nloo <- sapply(forms, function(f) {\n  pred <- numeric(nrow(m))\n  for (i in 1:nrow(m)) {\n    fi <- lm(f, data=m[-i,])\n    pred[i] <- predict(fi, newdata=m[i,])\n  }\n  sqrt(mean((m$Area-pred)''^2))\n})\nprint(loo)\n# group-level leave-one-ratio out\ngrp <- unique(m$p)\ngloo <- sapply(forms, function(f) {\n  pred <- numeric(nrow(m))\n  for (g in grp) {\n    tr <- m[m$p != g,]; te <- m[m$p == g,]\n    fi <- lm(f, data=tr)\n    pred[m$p == g] <- predict(fi, newdata=te)\n  }\n  sqrt(mean((m$Area-pred)''^2))\n})\nprint(gloo)\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
