{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('/workspace/inputs/Swarm_2.csv')\nm <- d[d\"'$StrainNumber=='\"'287_98',]\nsp <- strsplit(m\"'$Ratio, '\"':')\nnum <- as.numeric(sapply(sp, \"'`[`,1)); den <- as.numeric(sapply(sp, `[`,2)); m$p <- num/(num+den)\nfit <- lm(Area ~ ns(p, df=4), data=m)\npred <- function(p) predict(fit, newdata=data.frame(p=p))\nlo <- min(m$p); hi <- max(m$p)\nfor (n in c(1e5,1e6,1e7,5e7)) {\n  x <- seq(lo,hi,length.out=n)\n  y <- pred(x)\n  i <- which.max(y)\n  cat('\"'n',n,'maxp',sprintf('%.17g',x[i]),'maxy',sprintf('%.17g',y[i]),'\\\\n')\n}\n# print around max from coarse\nx <- seq(.899,.905,length.out=10001); y<-pred(x); i<-which.max(y)\nprint(data.frame(p=x[pmax(1,i-5):pmin(length(x),i+5)], area=y[pmax(1,i-5):pmin(length(x),i+5)]), digits=17)\n# optimize from many narrow intervals\nbest <- list(value=-Inf)\nfor (l in seq(lo, hi-0.001, length.out=500)) {\n  o <- optimize(function(p) -pred(p), lower=l, upper=min(hi,l+0.002), tol=1e-14)\n  if (-o\"'$objective > best$value) best <- list(p=o$minimum, value=-o$objective)\n}\ncat('\"'many optimize', sprintf('p %.17g area %.17g\\\\n', best\"'$p,best$value))\n# optimize with larger interval around coarse max\nfor (l in seq(.899,.905,length.out=100)) {\n  o <- optimize(function(p) -pred(p), lower=l, upper=.905, tol=1e-14)\n  if (-o$objective > best$value) { best <- list(p=o$minimum, value=-o$objective); cat('\"'new',sprintf('%.17g %.17g\\\\n',best\"'$p,best$value)) }\n}\ncat('\"'best overall', sprintf('p %.17g area %.17g\\\\n',best\"'$p,best$value))\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
