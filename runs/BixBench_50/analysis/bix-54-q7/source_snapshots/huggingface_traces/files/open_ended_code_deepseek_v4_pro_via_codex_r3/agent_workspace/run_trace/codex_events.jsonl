{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nlibrary(splines)\nd <- read.csv('/workspace/inputs/Swarm_2.csv', stringsAsFactors=FALSE)\nprint(d)\n# mixture rows only\nm <- d[d\"'$StrainNumber=='\"'287_98',]\n# parse ratio num:den, prop strain 287 = num/(num+den)\nsp <- strsplit(m\"'$Ratio, '\"':')\nnum <- as.numeric(sapply(sp, \"'`[`,1)); den <- as.numeric(sapply(sp, `[`,2))\nm$p <- num/(num+den)\nprint(m[,c('\"'DishNumber','Ratio','Area','p')])\n# complete same-system boundaries: StrainNumber 287 p=1, 98 p=0\nb <- d[d\"'$StrainNumber %in% c('\"'98','287'),]\nb\"'$p <- ifelse(b$StrainNumber=='\"'287',1,0)\nfull <- rbind(m[,c('Area','p')], b[,c('Area','p')])\nfor (scope in c('mixture','boundaries')) {\n  dat <- if (scope=='mixture') m[,c('Area','p')] else full\n  cat('\\\\nSCOPE',scope,'n',nrow(dat),'p range',range(dat\"'$p),'\"'\\\\n')\n  fits <- list(\n    quad=lm(Area ~ p + I(p\"'^2), data=dat),\n    cubic=lm(Area ~ p + I(p''^2) + I(p''^3), data=dat),\n    ns4=lm(Area ~ ns(p, df=4), data=dat)\n  )\n  for (nm in names(fits)) {\n    f <- fits[[nm]]\n    pred <- function(p) predict(f, newdata=data.frame(p=p))\n    rng <- range(dat$p)\n    if (nm=='\"'ns4') {\n      # optimize via grid to find max predicted\n      grid <- seq(rng[1], rng[2], length.out=100001)\n      y <- pred(grid)\n      i <- which.max(y); optp <- grid[i]; maxy <- y[i]\n    } else {\n      co <- coef(f)\n      # stationary points\n      if (nm=='quad') {\n        sp <- -co[2]/(2*co[3])\n        cand <- c(rng[1], rng[2], sp)\n      } else {\n        a <- co[4]; b <- co[3]; c <- co[2]\n        disc <- b\"'^2 - 3*a*c\n        sp <- if (disc>=0) (-b + c(-1,1)*sqrt(disc))/(3*a) else numeric(0)\n        cand <- c(rng[1], rng[2], sp)\n      }\n      cand <- cand[cand>=rng[1]-1e-12 & cand<=rng[2]+1e-12]\n      y <- pred(cand); i <- which.max(y); optp <- cand[i]; maxy <- y[i]\n    }\n    cat(nm,'\"'df',attr(logLik(f),'df'),'AIC',AIC(f),'BIC',BIC(f),\n        'adjR2',summary(f)\"'$adj.r.squared,'\"'optp',format(optp,digits=12),\n        'maxArea',format(maxy,digits=15),'\\\\n')\n  }\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
