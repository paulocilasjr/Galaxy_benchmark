/site-packages/busco/run_BUSCO.py\nbusco_pkg/site-packages/busco/ConfigManager.py\nbusco_pkg/site-packages/busco/Exceptions.py\nbusco_pkg/site-packages/busco-5.8.3.dist-info/RECORD\nbusco_pkg/site-packages/busco-5.8.3.dist-info/licenses/LICENSE\nbusco_pkg/site-packages/busco-5.8.3.dist-info/direct_url.json\nbusco_pkg/site-packages/busco-5.8.3.dist-info/WHEEL\nbusco_pkg/site-packages/busco-5.8.3.dist-info/top_level.txt\nbusco_pkg/site-packages/busco-5.8.3.dist-info/REQUESTED\nbusco_pkg/site-packages/busco-5.8.3.dist-info/INSTALLER\nbusco_pkg/site-packages/busco-5.8.3.dist-info/METADATA\nbusco_pkg/info/test/run_test.sh\nbusco_pkg/info/test/test_data/eukaryota/info.txt\nbusco_pkg/info/test/test_data/eukaryota/expected_log.txt\nbusco_pkg/info/test/test_data/eukaryota/genome.fna\nbusco_pkg/info/test/test_data/bacteria/info.txt\nbusco_pkg/info/test/test_data/bacteria/expected_log.txt\nbusco_pkg/info/test/test_data/bacteria/genome.fna\nbusco_pkg/info/test/run_test.bat\nbusco_pkg/info/licenses/LICENSE\nbusco_pkg/info/recipe/0001-Set-conda-distribution.patch\nbusco_pkg/info/recipe/4.1.4/run_test.sh\nbusco_pkg/info/recipe/4.1.4/build.sh\nbusco_pkg/info/recipe/4.1.4/meta.yaml\nbusco_pkg/info/recipe/4.1.4/0001-Add-default-config-path-within-prefix.patch\nbusco_pkg/info/recipe/run_test.sh\nbusco_pkg/info/recipe/0001-Add-default-config-path-within-prefix-updated.patch\nbusco_pkg/info/recipe/build.sh\nbusco_pkg/info/recipe/conda_build_config.yaml\nbusco_pkg/info/recipe/meta.yaml\nbusco_pkg/info/recipe/meta.yaml.template\nbusco_pkg/info/run_exports.json\nbusco_pkg/info/paths.json\nbusco_pkg/info/hash_input.json\nbusco_pkg/info/files\nbusco_pkg/info/about.json\nbusco_pkg/info/link.json\nbusco_pkg/info/has_prefix\nbusco_pkg/info/index.json\nbusco_pkg/info/git\n","exit_code":0,"status":"completed"}}
