{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nruns=['Scer','Ncra','Cele','Ggal']\nsets={}\ncounts={}\nfor name in runs:\n    p=Path('/workspace/busco_runs')/name/'run_eukaryota_odb10'/'full_table.tsv'\n    s=set()\n    with p.open() as f:\n        for line in f:\n            if line.startswith('#'): continue\n            parts=line.rstrip('\\\\n').split('\\\\t')\n            if len(parts)<2: continue\n            if parts[1]=='Complete':\n                s.add(parts[0])\n    sets[name]=s\n    counts[name]=len(s)\nprint(counts)\ninter=set.intersection(*sets.values())\nprint('intersection',len(inter))\nprint(sorted(inter)[:20])\n# Also status complete or duplicated? complete any? duplicates union? \nfor label, func in [('Complete only', lambda x: x=='Complete'), ('Complete or Duplicated', lambda x: x in ('Complete','Duplicated'))]:\n    ss={}\n    for name in runs:\n        p=Path('/workspace/busco_runs')/name/'run_eukaryota_odb10'/'full_table.tsv'\n        s=set()\n        with p.open() as f:\n            for line in f:\n                if line.startswith('#'): continue\n                parts=line.rstrip('\\\\n').split('\\\\t')\n                if len(parts)<2: continue\n                if func(parts[1]): s.add(parts[0])\n        ss[name]=s\n    print(label, len(set.intersection(*ss.values())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
