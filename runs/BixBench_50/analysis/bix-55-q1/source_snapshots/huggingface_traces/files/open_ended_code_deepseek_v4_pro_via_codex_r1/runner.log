{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport csv\nbase=Path('/workspace/busco_results')\nspecies=['Cele','Ggal','Ncra','Scer']\nsets={}\nfor sp in species:\n    p=base/sp/'run_eukaryota_odb10'/'full_table.tsv'\n    rows=[]\n    with p.open() as f:\n        for line in f:\n            if line.startswith('#'):\n                continue\n            parts=line.rstrip('\\\\n').split('\\\\t')\n            if len(parts)<2: continue\n            rows.append((parts[0],parts[1]))\n    complete={busco for busco,status in rows if status=='Complete'}\n    single={busco for busco,status in rows if status=='Complete'}\n    # robust count: one complete row and no duplicated row? status Complete implies single; duplicated separate.\n    dup={busco for busco,status in rows if status=='Duplicated'}\n    inter_complete_single = complete - dup\n    counts={}\n    from collections import Counter\n    c=Counter(status for busco,status in rows)\n    print(sp, 'rows',len(rows), 'status counts', dict(c), 'Complete IDs',len(complete), 'single via Complete-Dup',len(inter_complete_single))\n    sets[sp]=complete\ninter=set.intersection(*sets.values())\nprint('intersection size all complete single', len(inter))\nprint('sorted first/last', sorted(inter)[:10], sorted(inter)[-10:])\n# summary counts\nfor sp in species:\n    txt=(base/sp/'run_eukaryota_odb10'/'short_summary.txt').read_text()\n    print('\\\\n',sp)\n    for line in txt.splitlines():\n        if 'Complete and single-copy' in line or 'Complete and duplicated' in line or 'Complete BUSCOs' in line:\n            print(line.strip())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
