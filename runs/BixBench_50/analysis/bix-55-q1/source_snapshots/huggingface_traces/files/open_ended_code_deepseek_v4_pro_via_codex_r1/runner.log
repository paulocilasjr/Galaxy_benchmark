{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import defaultdict\nbase=Path('/workspace/busco_results')\nsp=['Cele','Ggal','Ncra','Scer']\ncomplete_sets={}; complete_single_sets={}; all_complete_sets={}\nfor s in sp:\n    rows=[l.rstrip('\\\\n').split('\\\\t') for l in (base/s/'run_eukaryota_odb10'/'full_table.tsv').open() if not l.startswith('#') and l.strip()]\n    statuses=defaultdict(list)\n    for r in rows: statuses[r[1]].append(r[0])\n    complete_single_sets[s]=set(statuses.get('Complete',[]))\n    # Complete BUSCO groups (all complete copies) = Complete status or Duplicated status\n    all_complete_sets[s]=set(statuses.get('Complete',[])) | set(statuses.get('Duplicated',[]))\nprint('intersection S only', len(set.intersection(*complete_single_sets.values())))\nprint('intersection C groups S+D', len(set.intersection(*all_complete_sets.values())))\n# maybe \\\"present and complete\\\" requiring at least one complete copy per species = C groups intersection\nfor name,sets in [('single',complete_single_sets),('allC',all_complete_sets)]:\n print(name, {k:len(v) for k,v in sets.items()})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
