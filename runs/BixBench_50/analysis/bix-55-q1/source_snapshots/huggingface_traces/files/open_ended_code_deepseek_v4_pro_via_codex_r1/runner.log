s/busco/busco_tools/sepp.py:82:        sepp_job.add_parameter(\"15\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:83:        sepp_job.add_parameter(\"-m\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:84:        sepp_job.add_parameter(\"amino\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:85:        sepp_job.add_parameter(\"-p\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:86:        sepp_job.add_parameter(self._tmp_folder)\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:87:        return sepp_job\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:93:        sepp_version = subprocess.check_output(\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:96:        sepp_version = sepp_version.decode(\"utf-8\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:97:        sepp_version = sepp_version.strip().split(\" \")[1]\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/sepp.py:98:        return sepp_version\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:34:    name = \"hmmsearch\"\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:35:    cmd = \"hmmsearch\"\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:90:        ):  # miniprot pipeline only runs once\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:120:        self.miniprot_pipeline = False\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:142:        ):  # miniprot pipeline only runs once\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:463:                ]  # needed for miniprot pipeline,\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:504:                ].items():  # allows miniprot-specific keyvals to be added simply without\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/hmmer.py:1306:        if self.miniprot_pipeline:\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:3:miniprot.py\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:36:    name = \"miniprot\"\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:37:    cmd = \"miniprot\"\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:41:        self._output_folder = os.path.join(self.run_folder, \"miniprot_output\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:96:    name = \"miniprot_index\"\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:106:        miniprot_job = self.create_job()\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:107:        miniprot_job.add_parameter(\"-t\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:108:        miniprot_job.add_parameter(str(self.cpus))\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:109:        miniprot_job.add_parameter(\"-d\")\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:110:        miniprot_job.add_parameter(self.index_file)\n/workspace/tools/pkgs/busco_pkg/site-packages/busco/busco_tools/miniprot.py:111:        miniprot_job.add_parameter(self.input_file)\n","exit_code":0,"status":"completed"}}
