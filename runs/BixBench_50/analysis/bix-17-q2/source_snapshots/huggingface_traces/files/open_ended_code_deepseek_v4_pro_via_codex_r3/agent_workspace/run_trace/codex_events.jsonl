{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n# Re-run low rows and tally zygosity/so/gene for carriers, plus low VAF stats\nimport openpyxl, glob, os, re, collections, statistics\n# load trio\nwb=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True); ws=wb.active\ntrio=[]\nfor r in list(ws.iter_rows(values_only=True))[1:]:\n sid=re.sub(r'\\\\s+','',str(r[0])) if r[0] is not None else ''\n if sid: trio.append((sid,str(r[1]).strip(),str(r[3]).strip()))\nblm=dict((sid,blm) for sid,st,blm in trio)\ncarrier_ids={sid for sid,st,blm in trio if blm=='Carrier'}\nprint('carrier ids', sorted(carrier_ids, key=lambda x:(not x.isdigit(), x)))\n# chip genes\nwb=openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx', data_only=True); ws=wb.active\nchip=set(str(r[0]).strip().upper() for r in ws.iter_rows(values_only=True) if r[0] is not None)\nzy=collections.Counter(); so=collections.Counter(); gene=collections.Counter(); vafvals=[]; posc=collections.Counter(); indels=collections.Counter()\nexamples=[]\ndef filesid(f):\n token=os.path.basename(f).replace('.xlsx','').split('_')[-1]\n if token.startswith('SRR'): return token\n m=re.match(r'\"'^('\"\\\\d+)',token); return m.group(1) if m else token\nfor f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n sid=filesid(f)\n if sid not in carrier_ids: continue\n wb=openpyxl.load_workbook(f, data_only=True); ws=wb.active; rows=list(ws.iter_rows(values_only=True)); hdr=rows[1]\n idx={n:i for i,n in enumerate(hdr)}\n for r in rows[2:]:\n  if r[0] is None: continue\n  if str(r[idx['Zygosity']]).strip().lower()=='reference': continue\n  s=str(r[idx['Sequence Ontology (Combined)']]).lower()\n  if 'intergenic' in s or 'utr' in s or 'intron_variant' in s: continue\n  v=r[idx['Variant Allele Freq']]\n  if v is None: continue\n  vf=float(v)\n  if vf<0.3:\n   z=r[idx['Zygosity']]; soq=r[idx['Sequence Ontology (Combined)']]; g=r[idx['Gene Names']]; pos=str(r[0]); refalt=str(r[1])\n   zy[z]+=1; so[soq]+=1\n   parts=[x.strip().upper() for x in str(g).split(',')]\n   gl=','.join(parts)\n   gene[gl]+=1\n   vafvals.append(vf); posc[pos]+=1; indels['indel' if ('-' in refalt or '/' in refalt and len(refalt.split('/')[0])\"'!=len(refalt.split('\"'/')[1])) else 'snp']+=1\n   examples.append((sid,pos,refalt,z,vf,soq,g))\n wb.close()\nprint('n low rows',len(vafvals))\nprint('zygosity',zy)\nprint('SO',so)\nprint('genes',gene)\nprint('vaf min/max',min(vafvals),max(vafvals))\nprint('position duplicate counts', {k:v for k,v in posc.items() if v>1})\nprint('indel',indels)\nprint('examples')\nfor e in examples[:100]: print(e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
