{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/analyze.py <<'PY'\nimport openpyxl, glob, os, re, statistics, collections, json\n\ndef norm(s):\n    if s is None: return None\n    return str(s).strip()\n\n# read trio\nwb=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True)\nws=wb.active\ntrio_rows=list(ws.iter_rows(values_only=True))[1:]\ntrio=[]\nfor r in trio_rows:\n    sid=norm(r[0])\n    if sid in (None,''): continue\n    # strip tabs/spaces and weird whitespace internal\n    sid=re.sub(r'\\\\s+','',sid)\n    status=norm(r[1])\n    blm=norm(r[3])\n    trio.append(dict(sample_id=sid,status=status,blm=blm,raw=r))\nprint('trio rows',len(trio))\nprint('status counts',collections.Counter(x['status'] for x in trio))\nprint('blm counts',collections.Counter(x['blm'] for x in trio))\nprint('status+blm counts',collections.Counter((x['status'],x['blm']) for x in trio))\n\n# read chip gene list\nwb=openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx', data_only=True)\nws=wb.active\nchip_genes=set()\nfor r in ws.iter_rows(values_only=True):\n    if r[0] is not None:\n        chip_genes.add(str(r[0]).strip().upper())\nprint('chip genes',len(chip_genes))\n\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nprint('files',len(files))\n\n# map file to sample id\ndef file_sample(path):\n    stem=os.path.basename(path)\n    stem=stem.replace('.xlsx','')\n    token=stem.split('_')[-1]\n    if token.startswith('SRR'):\n        return token\n    m=re.match(r'\"'^('\"\\\\d+)', token)\n    return m.group(1) if m else token\n\n# map sample -> path\npath_by_sample={}\nfor f in files:\n    sid=file_sample(f)\n    path_by_sample[sid]=f\n# trio sample keys set\ntrio_by_id={t['sample_id']:t for t in trio}\nmissing_files=[sid for sid in trio_by_id if sid not in path_by_sample]\nextra_files=[sid for sid in path_by_sample if sid not in trio_by_id]\nprint('missing file samples',missing_files)\nprint('extra file samples',extra_files)\n\ndef so_excluded(so):\n    if so is None: return False\n    s=str(so).lower()\n    if 'intergenic' in s: return True\n    if 'utr' in s: return True\n    if s=='intron_variant': return True\n    # any combined with intron? none in distinct, but robust:\n    if 'intron_variant' in s: return True\n    return False\n\ndef process_file(path, gene_filter):\n    wb=openpyxl.load_workbook(path, data_only=True)\n    ws=wb.active\n    rows=list(ws.iter_rows(values_only=True))\n    if len(rows)<2:\n        wb.close(); return None\n    # header row rows[1]\n    hdr=rows[1]\n    idx={name:i for i,name in enumerate(hdr) if name}\n    c_pos=0; c_zyg=idx.get('Zygosity'); c_vaf=idx.get('Variant Allele Freq'); c_so=idx.get('Sequence Ontology (Combined)'); c_gene=idx.get('Gene Names'); c_inchip=idx.get('In_CHIP')\n    counts=dict(total=0, after_excl=0, low=0, list_low=0)\n    rows_low=[]\n    for r in rows[2:]:\n        if r[c_pos] is None: continue\n        counts['total']+=1\n        zyg=r[c_zyg]\n        so=r[c_so]\n        if zyg is not None and str(zyg).strip().lower()=='reference':\n            continue\n        if so_excluded(so):\n            continue\n        counts['after_excl']+=1\n        v=r[c_vaf]\n        if v is None:\n            continue\n        try:\n            vf=float(v)\n        except:\n            continue\n        if vf < 0.3:\n            counts['low']+=1\n            genes=str(r[c_gene]) if r[c_gene] is not None else ''\n            genes_parts=[g.strip().upper() for g in genes.split(',') if g.strip()]\n            inlist=any(g in chip_genes for g in genes_parts)\n            if inlist:\n                counts['list_low']+=1\n            rows_low.append((r[c_pos], r[c_gene], r[c_so], zyg, vf, inlist))\n    wb.close()\n    return counts, rows_low\n\nresults={}\nall_low_rows={}\nfor f in files:\n    sid=file_sample(f)\n    counts, rows_low=process_file(f, False)\n    results[sid]={'path':f,'counts':counts}\n    all_low_rows[sid]=rows_low\n\n# print per sample counts for trio carrier/affected\nprint('\\\\nPer-sample counts (low = after exclusions & VAF<0.3, list_low = additionally gene in list):')\nfor sid in sorted(trio_by_id, key=lambda x: (not re.match(r'\"'^'\"\\\\d+\"'$'\"',x), (int(x) if x.isdigit() else x))):\n    t=trio_by_id[sid]\n    r=results.get(sid)\n    if not r:\n        print(sid, t['status'], t['blm'], 'NO FILE')\n        continue\n    c=r['counts']\n    print(f\\\"{sid:12s} {t['status']:8s} {t['blm']:10s} total={c['total']:3d} after_excl={c['after_excl']:3d} low={c['low']:3d} list_low={c['list_low']:3d}\\\")\n\nfor group_name, selector in [\n    ('Carrier only', lambda t:t['blm']=='Carrier'),\n    ('Affected only', lambda t:t['blm']=='Affected'),\n    ('Carrier or Affected', lambda t:t['blm'] in ('Carrier','Affected')),\n    ('Status Patient + Affected', lambda t:t['status']=='Patient' and t['blm']=='Affected'),\n    ('Unaffected', lambda t:t['blm']=='Unaffected'),\n]:\n    for metric in ['low','list_low']:\n        vals=[]\n        for sid,t in trio_by_id.items():\n            if selector(t) and sid in results:\n                vals.append(results[sid]['counts'][metric])\n        if vals:\n            print(group_name, metric, 'n',len(vals),'values',sorted(vals),'median',statistics.median(vals),'mean',statistics.mean(vals))\n        else:\n            print(group_name, metric, 'empty')\nPY\npython /tmp/analyze.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
