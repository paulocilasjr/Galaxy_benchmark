{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n# quick recompute carrier median under variant exclusions for SO terms\nimport openpyxl, glob, os, re, collections, statistics\n# trio\nwb=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True); ws=wb.active\ntrio=[]\nfor r in list(ws.iter_rows(values_only=True))[1:]:\n sid=re.sub(r'\\\\s+','',str(r[0])) if r[0] is not None else ''\n if sid: trio.append((sid,str(r[1]).strip(),str(r[3]).strip()))\ncarriers={sid for sid,st,blm in trio if blm=='Carrier'}\ndef sid_of(f):\n tok=os.path.basename(f).replace('.xlsx','').split('_')[-1]\n if tok.startswith('SRR'): return tok\n return re.match(r'\"'^('\"\\\\d+)',tok).group(1)\nfor mode in ['specified','exclude_splice','exclude_splice_upstream','gene_list_only']:\n vals=[]\n for f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n  sid=sid_of(f)\n  if sid not in carriers: continue\n  wb=openpyxl.load_workbook(f,data_only=True); ws=wb.active; rows=list(ws.iter_rows(values_only=True)); h=rows[1]; idx={n:i for i,n in enumerate(h)}\n  cnt=0\n  for r in rows[2:]:\n   if r[0] is None: continue\n   zyg=str(r[idx['Zygosity']]).strip().lower() if r[idx['Zygosity']] is not None else ''\n   so=str(r[idx['Sequence Ontology (Combined)']]).lower() if r[idx['Sequence Ontology (Combined)']] is not None else ''\n   if zyg=='reference': continue\n   if mode=='specified':\n    if 'intergenic' in so or 'utr' in so or 'intron_variant' in so: continue\n   elif mode=='exclude_splice':\n    if 'intergenic' in so or 'utr' in so or 'intron_variant' in so or 'splice' in so: continue\n   elif mode=='exclude_splice_upstream':\n    if 'intergenic' in so or 'utr' in so or 'intron_variant' in so or 'splice' in so or 'upstream' in so: continue\n   elif mode=='gene_list_only':\n    pass\n   v=r[idx['Variant Allele Freq']]\n   if v is None: continue\n   if float(v)<0.3: cnt+=1\n  vals.append(cnt)\n  wb.close()\n vals.sort()\n print(mode, vals, 'median', statistics.median(vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
