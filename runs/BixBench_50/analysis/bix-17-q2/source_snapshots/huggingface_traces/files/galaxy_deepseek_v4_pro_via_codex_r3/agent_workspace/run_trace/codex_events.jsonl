{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cd /opt/bixbench && python - <<'PY'\nimport os, json, sys, time, re\nsys.path.insert(0,'/opt/bixbench')\nimport galaxy_execute_mcp_core as c\nfrom bioblend.galaxy import GalaxyInstance\n\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhid=json.load(open('/workspace/copy_history.json'))['id']\ncontents=gi.histories.show_history(hid, contents=True)\n# carrier IDs from Trio status\ntrio_path='/workspace/tmp/xlsx/230215_Trio_Status.xlsx'\nimport openpyxl\nwb=openpyxl.load_workbook(trio_path, data_only=True, read_only=False); ws=wb.active\ncarrier_ids=set()\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    sid=str(row[0]).strip(); status=row[3]\n    if status=='Carrier':\n        try: carrier_ids.add(int(sid))\n        except: pass\nwb.close()\nprint('carrier ids', sorted(carrier_ids), 'n',len(carrier_ids))\n\n# mapping sample numeric prefix to dataset\nexome_by_sid={}\nfor d in contents:\n    name=d['name']\n    if not name.startswith('230209_'):\n        continue\n    m=re.search(r'_CHIP_(.+?)\\\\.xlsx\"'$'\"', name)\n    if not m: continue\n    sample=m.group(1)\n    mm=re.match(r'(\\\\d+)', sample)\n    if mm:\n        sid=int(mm.group(1))\n        if sid in carrier_ids:\n            exome_by_sid[sid]=d['id']\nprint('mapped',len(exome_by_sid), exome_by_sid.keys())\n\ntool_xlsx='toolshed.g2.bx.psu.edu/repos/ufz/xlsx2tsv/xlsx2tsv/0.2.0+galaxy0'\ncond=\\\"c30 == 'True' and c5 \"'!= '\"'Reference' and c10 \"'!= '\"'' and float(c10) < 0.3 and 'intron' not in str(c14).lower() and 'intergenic' not in str(c14).lower() and 'utr' not in str(c14).lower()\\\"\n\n# load progress if exists\nprogress_path='/workspace/tmp/galaxy_carrier_filtered.json'\nif os.path.exists(progress_path):\n    progress=json.load(open(progress_path))\nelse:\n    progress={}\nprint('existing progress',len(progress))\n\nfor sid in sorted(carrier_ids):\n    if str(sid) in progress:\n        print('skip',sid,'already',progress[str(sid)])\n        continue\n    source_id=exome_by_sid.get(sid)\n    if not source_id:\n        print('missing source',sid); progress[str(sid)]={'error':'missing_source'}; continue\n    print('\\\\nPROCESS',sid,'source',source_id)\n    # convert\n    r1=c.run_galaxy_tool_and_wait(\n        hid, tool_xlsx,\n        {'input_file': {'src':'hda','id':source_id}},\n        input_format='21.01', timeout_seconds=1800\n    )\n    if r1.get('status')\"'!='\"'ok':\n        progress[str(sid)]={'error':'xlsx_job','result':r1}\n        json.dump(progress, open(progress_path,'w'), indent=2)\n        print('xlsx failed',sid,r1.get('failure_summary'))\n        continue\n    coll_id=r1['output_collection_refs'][0]['id']\n    coll=gi.histories.show_dataset_collection(hid, coll_id)\n    elems=coll.get('elements',[])\n    if not elems:\n        progress[str(sid)]={'error':'no_element','coll':coll}\n        json.dump(progress, open(progress_path,'w'), indent=2)\n        continue\n    tab_id=elems[0]['object']['id']\n    # filter\n    r2=c.run_galaxy_tool_and_wait(\n        hid, 'Filter1',\n        {'input': {'src':'hda','id':tab_id}, 'cond':cond, 'header_lines':'2'},\n        input_format='21.01', timeout_seconds=1800\n    )\n    if r2.get('status')\"'!='\"'ok':\n        progress[str(sid)]={'error':'filter_job','result':r2,'tab_id':tab_id}\n        json.dump(progress, open(progress_path,'w'), indent=2)\n        print('filter failed',sid,r2.get('failure_summary'))\n        continue\n    out_id=r2['output_dataset_refs'][0]['id']\n    progress[str(sid)]={'source_id':source_id,'tab_id':tab_id,'filtered_id':out_id}\n    json.dump(progress, open(progress_path,'w'), indent=2)\n    print('done',sid,'filtered',out_id)\n\nprint('\\\\nFINAL progress',json.dumps(progress,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
