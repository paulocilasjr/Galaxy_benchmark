{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, json, openpyxl, csv, collections, re, sys\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip(); gi=GalaxyInstance('https://usegalaxy.org',key=key)\nhid=json.load(open('/workspace/copy_history.json'))['id']\ncontents=gi.histories.show_history(hid,contents=True)\n# trio status parse from downloaded local xlsx\ntriopath='/workspace/tmp/xlsx/230215_Trio_Status.xlsx'\nwb=openpyxl.load_workbook(triopath,data_only=True,read_only=False); ws=wb.active\ntrio=[]\nfor r in ws.iter_rows(min_row=2,values_only=True):\n    sid=r[0]\n    if isinstance(sid,str): sid=sid.strip()\n    trio.append((sid,r[1],r[3]))\nwb.close()\nstatus_by_id={sid:status for sid,_,status in trio}\n# download exome files\nos.makedirs('/workspace/tmp/all_exome',exist_ok=True)\nex=[]\nfor d in contents:\n    if d['name'].startswith('230209_'):\n        sample=re.search(r'_CHIP_(.+?)\\\\.xlsx\"'$'\"',d['name']).group(1)\n        # sample may have suffix -P1 etc, carrier ID is leading numeric before suffix\n        m=re.match(r'(\\\\d+)', sample)\n        sid=int(m.group(1)) if m else None\n        status=status_by_id.get(sid)\n        # carrier if status == 'Carrier' (also maybe affected? no)\n        path=f\\\"/workspace/tmp/all_exome/{d['name']}\\\"\n        if not os.path.exists(path):\n            gi.datasets.download_dataset(d['id'],file_path=path,use_default_filename=False,maxwait=120)\n        ex.append((sid,sample,status,d['name'],path))\nprint('files',len(ex),'carriers',sum(1 for e in ex if e[2]=='Carrier'))\n# parse each carrier\ndef keep(r):\n    # r tuple length 33, indexes 0..32; but may have extra/less\n    try:\n      if len(r)<31: return False\n      if r[29]\"'!='\"'True': return False\n      if r[4]=='Reference': return False\n      vaf=r[9]\n      if vaf is None or str(vaf).strip()=='': return False\n      v=float(vaf)\n      if not (v<0.3): return False\n      so=str(r[13] or '').lower()\n      if 'intron' in so or 'intergenic' in so or 'utr' in so: return False\n      return True\n    except Exception as e:\n      return False\ncounts={}\nfor sid,sample,status,name,path in ex:\n    if status\"'!='\"'Carrier': continue\n    wb=openpyxl.load_workbook(path,data_only=True,read_only=True); ws=wb.active\n    rows=ws.iter_rows(min_row=3,values_only=True) # skip two header rows\n    n=0\n    ont=collections.Counter()\n    for r in rows:\n        if keep(r): n+=1\n    counts[name]=n\n    wb.close()\nprint('carrier counts')\nfor k,v in counts.items(): print(k,v)\nprint('values',sorted(counts.values()))\nvals=sorted(counts.values())\nprint('median', (vals[len(vals)//2-1]+vals[len(vals)//2])/2 if len(vals)%2==0 else vals[len(vals)//2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
