{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, math\nfrom decimal import Decimal, getcontext\ngetcontext().prec=50\np='inputs/JuliaJong_CRISPRa_BCL2_B3GNT_cacerResTcellCytotoxicity_supplData1_mageck.xlsx'\nwb=openpyxl.load_workbook(p, read_only=True, data_only=True)\nws=wb['MAGeCK P-values']\nrows=ws.iter_rows(values_only=True)\nheader=next(rows)\ni1=header.index('Chronic Round1 S1'); i2=header.index('Chronic Round1 S2')\na=[];b=[]\nfor r in rows:\n    a.append(r[i1]); b.append(r[i2])\nn=len(a)\n\ndef rank_avg(vals):\n    order=sorted(range(n), key=lambda i: vals[i])\n    ranks=[0.0]*n\n    j=0\n    while j<n:\n        k=j\n        v=vals[order[j]]\n        while k+1<n and vals[order[k+1]]==v:\n            k+=1\n        avg=(j+1 + k+1)/2.0 # rank average using 1-index\n        for idx in order[j:k+1]:\n            ranks[idx]=avg\n        j=k+1\n    return ranks\nra=rank_avg(a); rb=rank_avg(b)\n# pearson corr\nma=sum(ra)/n; mb=sum(rb)/n\ncov=sum((ra[i]-ma)*(rb[i]-mb) for i in range(n))\nva=sum((x-ma)**2 for x in ra); vb=sum((x-mb)**2 for x in rb)\nrho=cov/math.sqrt(va*vb)\nprint('rho float', repr(rho), format(rho,'.15f'), format(rho,'.17g'))\n# check rank sums etc\nprint('rank sums', sum(ra), sum(rb), n*(n+1)/2)\n# decimal exact perhaps\nD=Decimal\nra_d=[D(str(x)) for x in ra]; rb_d=[D(str(y)) for y in rb]\nma_d=sum(ra_d)/D(n); mb_d=sum(rb_d)/D(n)\ncov_d=sum((ra_d[i]-ma_d)*(rb_d[i]-mb_d) for i in range(n))\nva_d=sum((x-ma_d)**2 for x in ra_d); vb_d=sum((x-mb_d)**2 for x in rb_d)\nrho_d=cov_d/(va_d*vb_d).sqrt()\nprint('rho decimal', rho_d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
