{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nimport gseapy\n\n# Inputs\ncounts = pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\nlayout = pd.read_csv('/workspace/inputs/sample_layout.csv')\nann = pd.read_csv('/workspace/inputs/ensg_to_gene_name.tsv', sep='\\\\t')\n\nlayout['sample_col'] = layout['SampleID'].str.replace('-', '_', regex=False)\ngroups = [\n    'DMSO',\n    'DMSO_Serum_starvation',\n    'Cisplatin_IC50_CBD_IC50',\n    'Cisplatin_IC50_CBD_IC50_Serum_starvation_16h',\n]\nlayout_sub = layout[layout['Group'].isin(groups)].copy()\n\n# Pre-filter across all 30 samples: keep genes with counts > 10 in at least one sample\nkeep = (counts > 10).any(axis=1)\ncounts_sub = counts.loc[keep, layout_sub['sample_col']].copy()\ncts = counts_sub.T  # pydeseq2 expects samples x genes\nmetadata = (\n    layout_sub[['sample_col', 'Group']]\n    .rename(columns={'sample_col': 'sample'})\n    .set_index('sample')\n    .copy()\n)\nmetadata['Group'] = metadata['Group'].astype(str)\n\ndds = DeseqDataSet(counts=cts, metadata=metadata, design='~Group', quiet=True)\ndds.deseq2()\nstat = DeseqStats(\n    dds,\n    contrast=['Group', 'Cisplatin_IC50_CBD_IC50', 'DMSO'],\n    alpha=0.05,\n    cooks_filter=True,\n    independent_filter=True,\n    quiet=True,\n)\nstat.summary()\nres = stat.results_df.copy()\n\nsig = res[\n    (res['padj'] <= 0.05)\n    & (res['log2FoldChange'].abs() >= 0.5)\n    & (res['baseMean'] >= 10)\n].copy()\nprint('prefiltered genes in model:', cts.shape[1])\nprint('significant DE genes:', sig.shape[0])\nprint('up/down:', (sig['log2FoldChange'] > 0).sum(), (sig['log2FoldChange'] < 0).sum())\n\n# Map ENSG -> gene symbol using provided file; use unique mapped symbols.\nens2sym = ann.set_index('ENSG')['gene_name']\nmapped_symbols = sig.index.map(ens2sym)\nsymbols = sorted(mapped_symbols.dropna().unique().tolist())\nprint('mapped unique foreground symbols:', len(symbols), 'unmapped DE:', mapped_symbols.isna().sum())\n\n# gseapy Enrichr against Reactome_2022\nenr = gseapy.enrichr(\n    gene_list=symbols,\n    gene_sets='Reactome_2022',\n    organism='human',\n    outdir=None,\n    no_plot=True,\n    verbose=False,\n)\nres2 = enr.res2d.copy()\n# p53-mediated cell cycle gene regulation = Reactome stable ID R-HSA-6791312\nterm_id = 'R-HSA-6791312'\nmask = res2['Term'].str.contains(term_id, regex=False)\nprint('matches for', term_id, ':', mask.sum())\nif mask.sum() == 1:\n    row = res2[mask].iloc[0]\n    print('Term:', row['Term'])\n    print('Overlap:', row['Overlap'])\n    print('Odds Ratio:', repr(float(row['Odds Ratio'])))\nelse:\n    print(res2[mask][['Term','Overlap','Odds Ratio']].to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
