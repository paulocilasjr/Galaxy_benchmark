{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\nlayout = pd.read_csv('/workspace/inputs/sample_layout.csv')\nlayout['sample_col'] = layout['SampleID'].str.replace('-','_', regex=False)\n# ensure all count columns in layout\nprint(set(counts.columns)-set(layout['sample_col']))\nprint(set(layout['sample_col'])-set(counts.columns))\n# subset groups\ngroups = ['DMSO','DMSO_Serum_starvation','Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h']\nlayout_sub = layout[layout['Group'].isin(groups)].copy()\nprint(layout_sub)\n# prefilter across all 30 samples: counts > 10 in at least one sample\nkeep = (counts > 10).any(axis=1)\nprint('keep', keep.sum(), 'total', len(keep))\ncounts_pre = counts.loc[keep, layout_sub['sample_col']].copy()\nprint(counts_pre.shape)\n# ensure no all-zero\nprint((counts_pre.sum(axis=1)==0).sum())\nmetadata = layout_sub[['sample_col','Group']].rename(columns={'sample_col':'sample'}).reset_index(drop=True)\nmetadata['Group']=metadata['Group'].astype(str)\n# pydeseq2 needs sample as index\nmetadata = metadata.set_index('sample')\nprint(metadata)\nprint(counts_pre.columns.tolist())\nprint(metadata.index.tolist())\ndds = DeseqDataSet(counts=counts_pre, metadata=metadata, design='~Group', quiet=False)\ndds.deseq2()\nstat = DeseqStats(dds, contrast=['Group','Cisplatin_IC50_CBD_IC50','DMSO'], quiet=False)\nstat.summary()\nres = stat.results_df\nprint(res.head())\nprint(res.shape, res.columns)\nres.to_csv('/workspace/tmp/de_result_test.csv')\nprint('done')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
