{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('inputs/SRR35233585_raw_variants.vcf')\ntrans=set([('A','G'),('G','A'),('C','T'),('T','C')])\ncounts_all={'ts':0,'tv':0}\ncounts_first={'ts':0,'tv':0}\ncounts_geno={'ts':0,'tv':0}\nn_snp_all=0;n_snp_first=0;n_snp_geno=0\nmultiallelic=[]\nfor line in p.open():\n    if line.startswith('#'): continue\n    f=line.rstrip('\\\\n').split('\\\\t')\n    ref=f[3]; alts=f[4].split(','); gt=f[9].split(':')[0]\n    snp_alts=[]; valid=[]\n    for a in alts:\n        if len(ref)==1 and len(a)==1:\n            snp_alts.append(a); valid.append(True)\n        else:\n            valid.append(False)\n    # all SNP alt alleles\n    for a in snp_alts:\n        n_snp_all+=1\n        if (ref,a) in trans: counts_all['ts']+=1\n        else: counts_all['tv']+=1\n    # first ALT only\n    if valid[0]:\n        a=alts[0]; n_snp_first+=1\n        if (ref,a) in trans: counts_first['ts']+=1\n        else: counts_first['tv']+=1\n    # genotype allele-specific among called non-ref alt alleles\n    # unphased diploid tokens\n    for tok in gt.replace('|','/').split('/'):\n        if tok=='.' or tok=='0': continue\n        idx=int(tok)-1\n        if 0 <= idx < len(alts) and valid[idx]:\n            a=alts[idx]; n_snp_geno+=1\n            if (ref,a) in trans: counts_geno['ts']+=1\n            else: counts_geno['tv']+=1\n    if len(alts)>1:\n        multiallelic.append((f[1], ref, alts, gt))\nprint('ALL SNP alts', n_snp_all, counts_all, 'ratio', counts_all['ts']/counts_all['tv'])\nprint('FIRST ALT', n_snp_first, counts_first, 'ratio', counts_first['ts']/counts_first['tv'])\nprint('GENO ALTS', n_snp_geno, counts_geno, 'ratio', counts_geno['ts']/counts_geno['tv'])\nprint('multiallelic count', len(multiallelic))\nprint('multiallelic with >1 SNV alts:')\nfor m in multiallelic:\n    snp=[a for a in m[2] if len(a)==1]\n    if len(snp)>1:\n        print(m)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
