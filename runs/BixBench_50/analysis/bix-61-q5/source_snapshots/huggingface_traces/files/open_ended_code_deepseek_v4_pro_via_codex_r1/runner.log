{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\ntrans=set([('A','G'),('G','A'),('C','T'),('T','C')])\nallc=firstc=genoc=0; allt=firstt=genot=0\nfor line in Path('inputs/SRR35233585_raw_variants.vcf').open():\n    if line.startswith('#'): continue\n    f=line.rstrip().split('\\\\t'); ref=f[3]; alts=f[4].split(','); gt=f[9].split(':')[0]\n    valid=[]\n    for a in alts:\n        valid.append(len(ref)==1 and len(a)==1 and a in 'ACGT')\n    for i,a in enumerate(alts):\n        if valid[i]:\n            allc+=1\n            allt += 1 if (ref,a) in trans else 0\n    if valid[0]:\n        firstc+=1\n        firstt += 1 if (ref,alts[0]) in trans else 0\n    for tok in gt.replace('|','/').split('/'):\n        if tok in ('.','0'): continue\n        idx=int(tok)-1\n        if 0<=idx<len(alts) and valid[idx]:\n            genoc+=1\n            genot += 1 if (ref,alts[idx]) in trans else 0\nprint('all', allc, allt, allc-allt, allt/(allc-allt))\nprint('first', firstc, firstt, firstc-firstt, firstt/(firstc-firstt))\nprint('geno', genoc, genot, genoc-genot, genot/(genoc-genot))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
