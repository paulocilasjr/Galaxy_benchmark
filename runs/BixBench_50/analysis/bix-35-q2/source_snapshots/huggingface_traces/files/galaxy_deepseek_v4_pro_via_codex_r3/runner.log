{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport zipfile, re\nfrom Bio import SeqIO\nimport io\nfor z in ['scogs_animals.zip','scogs_fungi.zip']:\n with zipfile.ZipFile(f'/workspace/data/{z}') as f:\n  clip={n.split('.',1)[0]:n for n in f.namelist() if n.endswith('.clipkit')}\n  tree={n.split('.',1)[0]:n for n in f.namelist() if n.endswith('.treefile')}\n  print('\\\\n',z)\n  # first three with tree and first three without tree, count seqs in clipkit\n  for ids in [list(tree)[:3], [x for x in clip if x not in tree][:3]]:\n   for gid in ids:\n    data=f.read(clip[gid]).decode()\n    n=sum(1 for line in data.splitlines() if line.startswith('>'))\n    tr=f.read(tree[gid]).decode() if gid in tree else None\n    if tr:\n      leaves=re.findall(r'([A-Za-z0-9_.|]+):', tr)\n      # crude\n    print(gid,'seqs',n, 'tree?', gid in tree)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
