{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport zipfile, collections\nfor z in ['scogs_animals.zip','scogs_fungi.zip']:\n print('\\\\n==',z)\n with zipfile.ZipFile(f'/workspace/data/{z}') as f:\n  names=f.namelist()\n  bys=collections.defaultdict(list)\n  for n in names:\n   # suffix after last dot\n   s=n.rsplit('.',1)[-1]\n   bys[s].append(n)\n  for s,lst in sorted(bys.items(), key=lambda kv:-len(kv[1])):\n   print(s,len(lst))\n  # base gene ids with each suffix\n  for s in ['faa','mafft','clipkit','treefile','bionj','iqtree','mldist','log','model.gz','ckp.gz']:\n   ids={n.split('.',1)[0] for n in bys.get(s,[])}\n   print(s, 'count', len(ids))\n  # check treefile ids subset of clipkit? \n  clip=set(); tree=set()\n  for n in names:\n   base=n.split('.',1)[0]\n   if n.endswith('.clipkit'): clip.add(base)\n   if n.endswith('.treefile'): tree.add(base)\n  print('clipkit only no tree', len(clip-tree), 'tree not clip', len(tree-clip))\n  # check intersection of tree ids between animals and fungi later\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
