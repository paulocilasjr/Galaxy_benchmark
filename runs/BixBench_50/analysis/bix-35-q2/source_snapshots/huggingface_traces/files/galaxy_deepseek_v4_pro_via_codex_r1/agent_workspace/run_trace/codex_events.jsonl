bel-b '$input_mode.label_b'\n    #end if\n    --output '$output'\n    </command>\n    <inputs>\n        <param name=\"test\" type=\"select\" label=\"Statistical test\">\n            <option value=\"mann_whitney_u\" selected=\"true\">Mann-Whitney U test for independent samples</option>\n            <option value=\"wilcoxon_signed_rank\">Wilcoxon signed-rank test for paired samples</option>\n        </param>\n        <conditional name=\"input_mode\">\n            <param name=\"selector\" type=\"select\" label=\"Input layout\">\n                <option value=\"grouped_table\" selected=\"true\">One table with value and group columns</option>\n                <option value=\"two_tables\">Two tables, one value column per group</option>\n            </param>\n            <when value=\"grouped_table\">\n                <param name=\"input\" type=\"data\" format=\"tabular,txt\" label=\"Input table\"/>\n                <param name=\"has_header\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Input has a header row\"/>\n                <param name=\"value_column\" type=\"integer\" min=\"1\" value=\"2\" label=\"Value column\" help=\"One-based column number containing numeric observations.\"/>\n                <param name=\"group_column\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group column\" help=\"One-based column number containing group labels.\"/>\n                <param name=\"group_a\" type=\"text\" value=\"\" optional=\"true\" label=\"Group A label\" help=\"Leave both group labels blank to use the two groups found in the file.\"/>\n                <param name=\"group_b\" type=\"text\" value=\"\" optional=\"true\" label=\"Group B label\" help=\"Leave both group labels blank to use the two groups found in the file.\"/>\n            </when>\n            <when value=\"two_tables\">\n                <param name=\"input_a\" type=\"data\" format=\"tabular,txt\" label=\"Group A table\"/>\n                <param name=\"input_b\" type=\"data\" format=\"tabular,txt\" label=\"Group B table\"/>\n                <param name=\"has_header_a\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Group A table has a header row\"/>\n                <param name=\"has_header_b\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Group B table has a header row\"/>\n                <param name=\"value_column_a\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group A value column\"/>\n                <param name=\"value_column_b\" type=\"integer\" min=\"1\" value=\"1\" label=\"Group B value column\"/>\n                <param name=\"label_a\" type=\"text\" value=\"group_a\" label=\"Group A output label\"/>\n                <param name=\"label_b\" type=\"text\" value=\"group_b\" label=\"Group B output label\"/>\n            </when>\n        </conditional>\n        <param name=\"alternative\" type=\"select\" label=\"Alternative hypothesis\">\n            <option value=\"two-sided\" selected=\"true\">two-sided</option>\n            <option value=\"less\">less</option>\n            <option value=\"greater\">greater</option>\n        </param>\n        <section name=\"mann_whitney_options\" title=\"Mann-Whitney U options\">\n            <param name=\"method\" type=\"select\" label=\"P-value method\">\n                <option value=\"auto\" selected=\"true\">auto</option>\n                <option value=\"exact\">exact</option>\n                <option value=\"asymptotic\">asymptotic</option>\n            </param>\n            <param name=\"use_continuity\" type=\"boolean\" checked=\"true\" truevalue=\"true\" falsevalue=\"false\" label=\"Use continuity correction for asymptotic method\"/>\n        </section>\n        <section name=\"wilcoxon_options\" title=\"Wilcoxon signed-rank options\">\n            <param name=\"method\" type=\"select\" label=\"P-value method\">\n                <option value=\"auto\" selected=\"true\">auto</option>\n                <option value=\"exact\">exact</option>\n                <option value=\"approx\">approximate/asymptotic</option>\n            </param>\n            <param name=\"zero_method\" type=\"select\" label=\"Zero-difference handling\">\n                <option value=\"wilcox\" selected=\"true\">wilcox: discard zero differences</option>\n                <option value=\"pratt\">pratt: include zero differences in ranking</option>\n                <option value=\"zsplit\">zsplit: split zero ranks between positive and negative sides</option>\n            </param>\n            <param name=\"correction\" type=\"boolean\" checked=\"false\" truevalue=\"true\" falsevalue=\"false\" label=\"Apply continuity correction for normal approximation\"/>\n        </section>\n    </inputs>\n    <outputs>\n        <data name=\"output\" format=\"tabular\" label=\"${tool.name} on ${on_string}: results\"/>\n    </outputs>\n    <tests>\n        <test>\n            <param name=\"test\" value=\"mann_whitney_u\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"input_mode|group_b\" value=\"fungi\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"mann_whitney_options|method\" value=\"exact\"/>\n            <param name=\"mann_whitney_options|use_continuity\" value=\"true\"/>\n            <output name=\"output\" file=\"mann_whitney_grouped_results.tsv\"/>\n        </test>\n        <test>\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"two_tables\"/>\n            <param name=\"input_mode|input_a\" value=\"