\n            <output name=\"output\" file=\"rcv.txt\"/>\n        </test>\n        <test expect_num_outputs=\"3\">\n            <param name=\"operation|selector\" value=\"evolutionary_rate\"/>\n            <param name=\"operation|input_mode|selector\" value=\"collection\"/>\n            <param name=\"operation|input_mode|group_label\" value=\"animals\"/>\n            <param name=\"operation|input_mode|collection\">\n                <collection type=\"list\">\n                    <element name=\"simple.tre\" value=\"simple.tre\"/>\n                    <element name=\"shorter.tre\" value=\"shorter.tre\"/>\n                </collection>\n            </param>\n            <output name=\"output\" file=\"batch_evolutionary_rate.tsv\"/>\n            <output name=\"failed_files\" file=\"empty_failed_files.tsv\"/>\n            <output name=\"summary\" file=\"batch_evolutionary_rate_summary.tsv\"/>\n        </test>\n        <test expect_num_outputs=\"3\">\n            <param name=\"operation|selector\" value=\"long_branch_score\"/>\n            <param name=\"operation|verbose\" value=\"true\"/>\n            <param name=\"operation|input_mode|selector\" value=\"collection\"/>\n            <param name=\"operation|input_mode|group_label\" value=\"animals\"/>\n            <param name=\"operation|input_mode|collection\">\n                <collection type=\"list\">\n                    <element name=\"simple.tre\" value=\"simple.tre\"/>\n                </collection>\n            </param>\n            <output name=\"output\" file=\"batch_long_branch_score_verbose.tsv\"/>\n            <output name=\"failed_files\" file=\"empty_failed_files.tsv\"/>\n            <output name=\"summary\" file=\"batch_long_branch_score_summary.tsv\"/>\n        </test>\n        <test expect_num_outputs=\"3\">\n            <param name=\"operation|selector\" value=\"evolutionary_rate\"/>\n            <param name=\"operation|input_mode|selector\" value=\"grouped_collections\"/>\n            <repeat name=\"operation|input_mode|groups\">\n                <param name=\"label\" value=\"animals\"/>\n                <param name=\"collection\">\n                    <collection type=\"list\">\n                        <element name=\"simple.tre\" value=\"simple.tre\"/>\n                    </collection>\n                </param>\n            </repeat>\n            <repeat name=\"operation|input_mode|groups\">\n                <param name=\"label\" value=\"fungi\"/>\n                <param name=\"collection\">\n                    <collection type=\"list\">\n                        <element name=\"shorter.tre\" value=\"shorter.tre\"/>\n                    </collection>\n                </param>\n            </repeat>\n            <output name=\"output\" file=\"grouped_evolutionary_rate.tsv\"/>\n            <output name=\"failed_files\" file=\"empty_failed_files.tsv\"/>\n            <output name=\"summary\" file=\"grouped_evolutionary_rate_summary.tsv\"/>\n        </test>\n        <test expect_num_outputs=\"3\">\n            <param name=\"operation|selector\" value=\"evolutionary_rate\"/>\n            <param name=\"operation|input_mode|selector\" value=\"zip_archive\"/>\n            <param name=\"operation|input_mode|archive\" value=\"animals_trees.zip\" ftype=\"zip\"/>\n            <param name=\"operation|input_mode|archive_label\" value=\"animals\"/>\n            <param name=\"operation|input_mode|filter_suffix\" value=\".tre\"/>\n            <output name=\"output\" file=\"zip_evolutionary_rate.tsv\"/>\n            <output name=\"failed_files\" file=\"empty_failed_files.tsv\"/>\n            <output name=\"summary\" file=\"zip_evolutionary_rate_summary.tsv\"/>\n        </test>\n        <test expect_num_outputs=\"3\">\n            <param name=\"operation|selector\" value=\"evolutionary_rate\"/>\n            <param name=\"operation|input_mode|selector\" value=\"grouped_zip_archives\"/>\n            <param name=\"operation|input_mode|filter_suffix\" value=\".tre\"/>\n            <repeat name=\"operation|input_mode|archives\">\n                <param name=\"label\" value=\"animals\"/>\n                <param name=\"archive\" value=\"animals_trees.zip\" ftype=\"zip\"/>\n            </repeat>\n            <repeat name=\"operation|input_mode|archives\">\n                <param name=\"label\" value=\"fungi\"/>\n                <param name=\"archive\" value=\"fungi_trees.zip\" ftype=\"zip\"/>\n            </repeat>\n            <output name=\"output\" file=\"grouped_zip_evolutionary_rate.tsv\"/>\n            <output name=\"failed_files\" file=\"empty_failed_files.tsv\"/>\n            <output name=\"summary\" file=\"grouped_zip_evolutionary_rate_summary.tsv\"/>\n        </test>\n    </tests>\n    <help>\nThis wrapper exposes selected PhyKIT tree and alignment metrics.\n\nInput modes\n-----------\n\nSingle-file mode preserves the direct PhyKIT output for one tree or alignment.\nCollection mode runs the selected metric for each member of one Galaxy\ncollection and writes a combined table. Grouped-collection mode accepts repeated\ngroup labels plus collections and writes a long table suitable for downstream\ngroup comparison tools.\n\nZIP archive modes are convenience inputs for archive-heavy histories. They\nextract local Galaxy ZIP datasets inside the job working directory, reject unsafe\nmember paths such as absolute paths or ``..`` traversal, apply the same\nsuffix/regular-expression filters, and then run the selected PhyKIT metric.\nGalaxy-native collection mode remains the preferred route when users want to\ninspect or reuse extracted archive members.\n\nCollection outputs include:\n\n* a metrics table with group, file identifier, file name, metric, value, and\n  status columns;\n* a failed-files table with nonzero or unparsable PhyKIT runs; and\n* a summary table with total, selected, processed, failed, and skipped file\n  counts per group.\n\nUse suffix or regular-expression filters when a collection contains mixed files,\nfor example to process only ``.treefile`` members for tree metrics. In ZIP\nmodes, leaving both filters blank processes every regular archive member and\nwrites a warning to standard error.\n    </help>\n    <citations>\n        <citation type=\"doi\">10.1093/bioinformatics/btab096</citation>\n    </citations>\n</tool>\n","exit_code":0,"status":"completed"}}
