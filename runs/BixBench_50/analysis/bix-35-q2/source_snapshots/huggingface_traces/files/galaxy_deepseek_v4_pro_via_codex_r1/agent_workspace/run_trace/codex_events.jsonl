      <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"mann_whitney_u\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"mann_whitney_options|method\" value=\"exact\"/>\n            <param name=\"mann_whitney_options|use_continuity\" value=\"true\"/>\n            <assert_stderr>\n                <has_text text=\"Provide both group labels, or leave both blank to auto-detect groups\"/>\n            </assert_stderr>\n        </test>\n        <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"grouped_table\"/>\n            <param name=\"input_mode|input\" value=\"grouped_values.tsv\"/>\n            <param name=\"input_mode|has_header\" value=\"true\"/>\n            <param name=\"input_mode|value_column\" value=\"2\"/>\n            <param name=\"input_mode|group_column\" value=\"1\"/>\n            <param name=\"input_mode|group_a\" value=\"animals\"/>\n            <param name=\"input_mode|group_b\" value=\"fungi\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"exact\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <assert_stderr>\n                <has_text text=\"Wilcoxon signed-rank test requires paired observations; use two_tables input mode\"/>\n            </assert_stderr>\n        </test>\n        <test expect_exit_code=\"1\" expect_failure=\"true\">\n            <param name=\"test\" value=\"wilcoxon_signed_rank\"/>\n            <param name=\"input_mode|selector\" value=\"two_tables\"/>\n            <param name=\"input_mode|input_a\" value=\"paired_before_missing.tsv\"/>\n            <param name=\"input_mode|input_b\" value=\"paired_after_missing.tsv\"/>\n            <param name=\"input_mode|has_header_a\" value=\"true\"/>\n            <param name=\"input_mode|has_header_b\" value=\"true\"/>\n            <param name=\"input_mode|value_column_a\" value=\"1\"/>\n            <param name=\"input_mode|value_column_b\" value=\"1\"/>\n            <param name=\"input_mode|label_a\" value=\"before\"/>\n            <param name=\"input_mode|label_b\" value=\"after\"/>\n            <param name=\"alternative\" value=\"two-sided\"/>\n            <param name=\"wilcoxon_options|method\" value=\"exact\"/>\n            <param name=\"wilcoxon_options|zero_method\" value=\"wilcox\"/>\n            <param name=\"wilcoxon_options|correction\" value=\"false\"/>\n            <assert_stderr>\n                <has_text text=\"Wilcoxon signed-rank test requires complete paired observations\"/>\n            </assert_stderr>\n        </test>\n    </tests>\n    <help>\nThis tool currently runs two common nonparametric rank tests:\n\n**Mann-Whitney U**\n  Use for two independent groups.\n\n**Wilcoxon signed-rank**\n  Use for paired observations with equal group lengths. This test requires the\n  two-table input layout so observations are paired by row.\n\nInputs may be provided as one table with a group column and a numeric value\ncolumn, or as two separate tables with one numeric value column per group.\nMissing values encoded as blank, NA, NaN, None, or null are skipped for\nindependent Mann-Whitney U tests. Wilcoxon signed-rank tests require complete\npaired observations.\n\nThe output is a two-column tabular summary containing the selected test,\ngroup labels, sample sizes, alternative hypothesis, method, statistic, and\np-value.\n    </help>\n    <citations>\n        <citation type=\"doi\">10.1038/s41592-019-0686-2</citation>\n    </citations>\n</tool>\n","exit_code":0,"status":"completed"}}
