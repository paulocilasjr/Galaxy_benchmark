ode.selector == \"zip_archive\"\n    --archive-label '$input_mode.archive_label'\n    --filter-suffix '$input_mode.filter_suffix'\n    --filter-regex '$input_mode.filter_regex'\n    --archive '$input_mode.archive'\n#else\n    --filter-suffix '$input_mode.filter_suffix'\n    --filter-regex '$input_mode.filter_regex'\n    #for $archive_group in $input_mode.archives\n    --archive '$archive_group.archive'\n    --archive-group '$archive_group.label'\n    #end for\n#end if\n    </command>\n    <inputs>\n        <conditional name=\"operation\">\n            <param name=\"selector\" type=\"select\" label=\"PhyKIT metric\">\n                <option value=\"evolutionary_rate\">Evolutionary rate</option>\n                <option value=\"total_tree_length\" selected=\"true\">Total tree length</option>\n                <option value=\"long_branch_score\">Long branch score</option>\n                <option value=\"treeness\">Treeness</option>\n                <option value=\"relative_composition_variability\">Relative composition variability</option>\n                <option value=\"relative_composition_variability_taxon\">Relative composition variability per taxon</option>\n            </param>\n            <when value=\"evolutionary_rate\">\n                <conditional name=\"input_mode\">\n                <param name=\"selector\" type=\"select\" label=\"Input mode\">\n                    <option value=\"single\" selected=\"true\">Single tree file</option>\n                    <option value=\"collection\">One tree collection</option>\n                    <option value=\"grouped_collections\">Grouped tree collections</option>\n                    <option value=\"zip_archive\">ZIP archive of tree files</option>\n                    <option value=\"grouped_zip_archives\">Grouped ZIP archives of tree files</option>\n                </param>\n                <when value=\"single\">\n                    <param name=\"input\" type=\"data\" format=\"newick,txt\" label=\"tree file\"/>