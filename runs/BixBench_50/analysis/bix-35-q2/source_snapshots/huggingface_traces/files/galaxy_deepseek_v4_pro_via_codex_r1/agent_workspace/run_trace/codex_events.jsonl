{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport zipfile, collections\nfor zp in ['/workspace/tmpdl/scogs_animals.zip','/workspace/tmpdl/scogs_fungi.zip']:\n    print('\\\\n', zp)\n    z=zipfile.ZipFile(zp)\n    names=z.namelist()\n    prefs=collections.defaultdict(set)\n    for n in names:\n        base=n.rsplit('/',1)[-1]\n        # prefix up to .faa\n        p=base.split('.faa')[0]\n        if base.endswith('.faa'):\n            typ='faa'\n        elif base.endswith('.mafft'):\n            typ='mafft'\n        elif base.endswith('.clipkit'):\n            typ='clipkit'\n        elif base.endswith('.treefile'):\n            typ='treefile'\n        elif base.endswith('.iqtree'):\n            typ='iqtree'\n        elif base.endswith('.bionj'):\n            typ='bionj'\n        elif base.endswith('.mldist'):\n            typ='mldist'\n        elif '.model.gz' in base:\n            typ='modelgz'\n        elif '.ckp.gz' in base:\n            typ='ckpgz'\n        elif base.endswith('.log'):\n            typ='log'\n        else:\n            typ='other'\n        prefs[p].add(typ)\n    counts=collections.Counter()\n    for p,t in prefs.items(): counts[tuple(sorted(t))]+=1\n    print('unique prefixes', len(prefs))\n    print('type set counts')\n    for t,c in counts.most_common(): print(c, t)\n    # counts by number taxa in faa maybe\n    # look at treefile prefixes\n    tps=[p for p,t in prefs.items() if 'treefile' in t]\n    print('treefile prefixes count',len(tps))\n    # examples no tree\n    nops=[p for p,t in prefs.items() if 'treefile' not in t]\n    print('no tree prefixes count',len(nops))\n    print('sample no tree', nops[:5])\n    print('sample tree', tps[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
