{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, io, re, statistics\nfrom collections import defaultdict\n\ndef parse_newick(s):\n    # return dict pair -> distance\n    s=s.strip()\n    if not s.endswith(';'): s+=';'\n    # simple recursive parser for Newick\n    pos=0\n    def skip():\n        nonlocal pos\n        while pos<len(s) and s[pos] in ' \\\\t\\\\n': pos+=1\n    def parse_node():\n        nonlocal pos\n        skip()\n        if s[pos]=='(':\n            pos+=1\n            children=[]\n            while True:\n                children.append(parse_node())\n                skip()\n                if pos<len(s) and s[pos]==',':\n                    pos+=1\n                    continue\n                elif pos<len(s) and s[pos]==')':\n                    pos+=1\n                    break\n                else:\n                    raise ValueError('bad newick')\n            # branch length for internal node\n            skip()\n            bl=None\n            if pos<len(s) and s[pos]==':':\n                pos+=1; bl=parse_number()\n            return ('internal',children,bl)\n        else:\n            # label\n            m=re.match(r\\\"[\"'^(),;:]+\", s[pos:])\n            if not m: raise ValueError('\"'bad label at '+s[pos:])\n            label=m.group(0); pos+=len(label)\n            skip()\n            bl=None\n            if pos<len(s) and s[pos]==':':\n                pos+=1; bl=parse_number()\n            return ('leaf',label,bl)\n    def parse_number():\n        nonlocal pos\n        m=re.match(r\\\"[-+]?\\\\d+(?:\\\\.\\\\d+)?(?:[eE][-+]?\\\\d+)?\\\", s[pos:])\n        if not m: raise ValueError('bad number')\n        pos+=len(m.group(0)); return float(m.group(0))\n    tree=parse_node()\n    skip()\n    return tree\n\ndef collect(tree):\n    # return list leaf labels and paths with cumulative branch lengths to each leaf from root of subtree (undefined root)\n    # Better: recursively get leaves with paths lengths; cross pairs LCA sum.\n    def rec(node):\n        typ=node[0]\n        if typ=='leaf':\n            return {node[1]: 0.0}\n        children=node[1]; bl=node[2] or 0.0\n        d={}\n        for ch in children:\n            sub=rec(ch)\n            # each leaf path length from this node includes branch to child? rec returned distance from child? Need adjust.\n            for lab,v in sub.items():\n                d[lab]=v # oops missing child branch\n        # Redesign\n    return rec\n\ndef path_distances(s):\n    # full recursive returns map leaf->distance from node\n    def rec(node):\n        if node[0]=='leaf':\n            return {node[1]:0.0}\n        d={}\n        for ch in node[1]:\n            child_len=ch[2] if ch[2] is not None else 0.0\n            sub=rec(ch)\n            for lab,v in sub.items():\n                d[lab]=v+child_len\n        return d\n    d=rec(parse_newick(s))\n    labels=list(d)\n    pairs=[]\n    for i in range(len(labels)):\n        for j in range(i+1,len(labels)):\n            pairs.append(d[labels[i]]+d[labels[j]])\n    return pairs\n\nfor f in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    z=zipfile.ZipFile(f)\n    means=[]; pair_counts=[]; taxa_counts=[]\n    for name in z.namelist():\n        if name.endswith('.treefile'):\n            s=z.read(name).decode()\n            ds=path_distances(s)\n            means.append(sum(ds)/len(ds))\n            pair_counts.append(len(ds))\n            taxa_counts.append(len(ds) and int((1+(1+8*len(ds))**0.5)/2))\n    print(f, 'n trees',len(means),'median mean patristic',statistics.median(means),'mean',statistics.mean(means),'min',min(means),'max',max(means))\n    print('taxa counts', sorted(set(taxa_counts)), {x:taxa_counts.count(x) for x in set(taxa_counts)})\n    print('first means', means[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
