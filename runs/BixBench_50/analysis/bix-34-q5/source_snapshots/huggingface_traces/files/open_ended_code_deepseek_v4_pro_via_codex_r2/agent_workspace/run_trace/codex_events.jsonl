{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, statistics, re\n\ndef parse_mldist(text):\n    lines=[l.strip() for l in text.splitlines() if l.strip()]\n    n=int(lines[0])\n    labels=[]; vals=[]\n    for row in lines[1:]:\n        parts=row.split()\n        labels.append(parts[0]); vals.append([float(x) for x in parts[1:]])\n    ds=[]\n    for i in range(n):\n        for j in range(i+1,n):\n            ds.append(vals[i][j])\n    return ds\n\nfor f in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    z=zipfile.ZipFile(f)\n    means=[]; ns=[]\n    for name in z.namelist():\n        if name.endswith('.mldist'):\n            s=z.read(name).decode()\n            ds=parse_mldist(s)\n            means.append(sum(ds)/len(ds)); ns.append(len(ds))\n    med=statistics.median(means)\n    print(f, len(means), 'median mean mldist', med, 'mean',statistics.mean(means))\nprint('ratio mldist', statistics.median([1]) if False else '')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
