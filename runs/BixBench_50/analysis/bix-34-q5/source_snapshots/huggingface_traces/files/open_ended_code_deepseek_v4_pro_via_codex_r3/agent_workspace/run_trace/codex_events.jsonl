{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom statistics import median, mean\n\nclass Node:\n    __slots__=('children','label','length')\n    def __init__(self,children=None,label='',length=None):\n        self.children=children or []; self.label=label; self.length=length\n    def is_leaf(self): return not self.children\n\ndef parse_newick(s):\n    s=s.strip()\n    if s.endswith(';'): s=s[:-1]\n    pos=0\n    def parse_node():\n        nonlocal pos\n        if pos < len(s) and s[pos]=='(':\n            pos+=1; children=[]\n            while True:\n                children.append(parse_node())\n                if pos < len(s) and s[pos]==',':\n                    pos+=1; continue\n                break\n            assert pos < len(s) and s[pos]==')', (s,pos)\n            pos+=1\n            label=''\n            if pos < len(s) and s[pos] not in ',();:':\n                start=pos\n                while pos<len(s) and s[pos] not in ',();:': pos+=1\n                label=s[start:pos]\n            length=None\n            if pos < len(s) and s[pos]==':':\n                pos+=1; start=pos\n                while pos<len(s) and s[pos] not in ',();:': pos+=1\n                length=float(s[start:pos])\n            return Node(children,label,length)\n        else:\n            start=pos\n            while pos<len(s) and s[pos] not in ',();:': pos+=1\n            label=s[start:pos]\n            length=None\n            if pos < len(s) and s[pos]==':':\n                pos+=1; start=pos\n                while pos<len(s) and s[pos] not in ',();:': pos+=1\n                length=float(s[start:pos])\n            return Node(label=label,length=length,children=[])\n    tree=parse_node()\n    return tree\n\ndef collect_leaf_dists(tree):\n    paths=[]; leaves=[]\n    def dfs(node, path):\n        # path root->current, includes current cumulative dist from root\n        if node.is_leaf():\n            leaves.append(node.label); paths.append(path)\n        else:\n            for ch in node.children:\n                dfs(ch, path+[(ch, (path[-1][1] if path else 0.0)+(ch.length or 0.0))])\n    dfs(tree, [(tree,0.0)])\n    ds=[]\n    for i in range(len(leaves)):\n        for j in range(i+1,len(leaves)):\n            pi=paths[i]; pj=paths[j]\n            k=0\n            while k<min(len(pi),len(pj)) and pi[k][0] is pj[k][0]: k+=1\n            common_idx=k-1\n            di=pi[-1][1]-pi[common_idx][1]\n            dj=pj[-1][1]-pj[common_idx][1]\n            ds.append(di+dj)\n    return ds,leaves\n\ndef parse_mldist(f):\n    lines=f.read_text().strip().splitlines(); n=int(lines[0].strip()); names=[]; vals=[]\n    for line in lines[1:]:\n        parts=line.strip().split(); names.append(parts[0]); vals.append([float(x) for x in parts[1:]])\n    ds=[]\n    for i in range(n):\n        for j in range(i+1,n): ds.append(vals[i][j])\n    return ds,names\n\nfor group in ['scogs_animals','scogs_fungi']:\n    p=Path('/workspace/tmp')/group\n    tree_means=[]; ml_means=[]\n    for f in sorted(p.glob('*.treefile')):\n        tree=parse_newick(f.read_text()); ds,leaves=collect_leaf_dists(tree); tree_means.append(mean(ds))\n        base=f.name[:-len('.mafft.clipkit.treefile')]\n        mlfile=p/(base+'.mafft.clipkit.mldist')\n        if mlfile.exists():\n            ds,_=parse_mldist(mlfile); ml_means.append(mean(ds))\n    print(group,'tree n',len(tree_means),'median',median(tree_means),'mean',mean(tree_means),'minmax',min(tree_means),max(tree_means))\n    print(group,'mldist n',len(ml_means),'median',median(ml_means),'mean',mean(ml_means),'minmax',min(ml_means),max(ml_means))\n    print('first 5',tree_means[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
