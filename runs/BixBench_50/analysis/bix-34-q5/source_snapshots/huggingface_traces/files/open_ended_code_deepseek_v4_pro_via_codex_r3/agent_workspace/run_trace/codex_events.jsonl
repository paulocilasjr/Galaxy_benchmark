{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom statistics import median, mean\nimport re\n\ndef parse_newick(s):\n    s=s.strip()\n    if s.endswith(';'): s=s[:-1]\n    pos=0\n    def parse_node():\n        nonlocal pos\n        # children if '('\n        if pos < len(s) and s[pos]=='(':\n            pos+=1\n            children=[]\n            while True:\n                children.append(parse_node())\n                if pos < len(s) and s[pos]==',':\n                    pos+=1\n                    continue\n                else:\n                    break\n            if pos < len(s) and s[pos]==')': pos+=1\n            else: raise ValueError('missing )')\n            label=''\n            if pos < len(s) and s[pos] not in ',);:':\n                # label\n                start=pos\n                while pos<len(s) and s[pos] not in ',);:':\n                    pos+=1\n                label=s[start:pos]\n            length=None\n            if pos < len(s) and s[pos]==':':\n                pos+=1\n                start=pos\n                while pos<len(s) and s[pos] not in ',);':\n                    pos+=1\n                length=float(s[start:pos])\n            return Node(children=children,label=label,length=length)\n        else:\n            start=pos\n            while pos<len(s) and s[pos] not in ',();:':\n                pos+=1\n            label=s[start:pos]\n            length=None\n            if pos<len(s) and s[pos]==':':\n                pos+=1\n                start=pos\n                while pos<len(s) and s[pos] not in ',();':\n                    pos+=1\n                length=float(s[start:pos])\n            return Node(label=label,length=length,children=[])\n    tree=parse_node()\n    if pos \"'!= len(s):\n        # may have root label/length? already handled\n        pass\n    return tree\n\nclass Node:\n    __slots__=('\"'children','label','length')\n    def __init__(self,children=None,label='',length=None):\n        self.children=children or []\n        self.label=label\n        self.length=length\n    def is_leaf(self): return not self.children\n\ndef collect_leaf_dists(tree):\n    # Enumerate leaves with distance from root, and compute pairwise using LCA? Simpler: for each leaf path to root, then pair intersection.\n    paths=[]\n    leaves=[]\n    def dfs(node, path):\n        # path list of (node, cumulative distance up to this node)\n        if node.is_leaf():\n            leaves.append(node.label)\n            paths.append(path)\n        else:\n            for ch in node.children:\n                dfs(ch, path+[(ch, (path[-1][1] if path else 0.0)+(ch.length or 0.0))])\n    dfs(tree, [])\n    ds=[]\n    for i in range(len(leaves)):\n        pi=paths[i]\n        # distances from leaf to each ancestor. Build maps cum distances\n        dist_i={}\n        cum=0\n        # pi is leaf first; node references\n        for idx,(node,d) in enumerate(pi):\n            dist_i[id(node)]=d\n        for j in range(i+1,len(leaves)):\n            pj=paths[j]\n            # find deepest common ancestor node\n            common_depth=0\n            maxk=min(len(pi),len(pj))\n            # path order is leaf -> root; leaf node shared? no. compare node identity from start; leaves unique, then next ancestor.\n            k=0\n            while k<maxk and pi[k][0] is pj[k][0]:\n                k+=1\n            # deepest common is k-1 (the last shared node)\n            common_idx=k-1\n            # distance = distance from each leaf to common node, but paths include cumulative distance to common node (since cumulative includes branch from common to leaf? Need carefully)\n            # Path pi[0] leaf, pi[k] ancestor cumulative distance from root? Our dfs path appends child with cumulative from root to that node. So pi[common_idx] is common node and its cumulative distance from root to common node.\n            # Distance leaf i to common = pi[-1? no leaf path cumulative]?\n            # Actually pi entries for leaf (cum from root to leaf) and ancestors. Need distance between leaf and common = pi[leaf].d - pi[common].d? But pi[leaf] is pi[0].\n            # Wait pi[0]=leaf, d = dist root->leaf. pi[common_idx] = common node with d=dist root->common. Difference = branch sum common->leaf. yes.\n            dist_to_common_i = pi[0][1] - pi[common_idx][1]\n            dist_to_common_j = pj[0][1] - pj[common_idx][1]\n            ds.append(dist_to_common_i+dist_to_common_j)\n    return ds, leaves\n\ndef parse_mldist(f):\n    lines=f.read_text().strip().splitlines()\n    n=int(lines[0].strip())\n    names=[]\n    vals=[]\n    for line in lines[1:]:\n        parts=line.strip().split()\n        names.append(parts[0])\n        vals.append([float(x) for x in parts[1:]])\n    ds=[]\n    for i in range(n):\n        for j in range(i+1,n):\n            ds.append(vals[i][j])\n    return ds,names\n\nfor group in ['scogs_animals','scogs_fungi']:\n    p=Path('/workspace/tmp')/group\n    tree_means=[]; ml_means=[]\n    errors=[]\n    for f in sorted(p.glob('*.treefile')):\n        try:\n            tree=parse_newick(f.read_text())\n            ds,leaves=collect_leaf_dists(tree)\n            tree_means.append(mean(ds))\n        except Exception as e:\n            errors.append((f.name,str(e)))\n        ml=f.with_suffix('') # not easy\n        # derive base: name .faa.mafft.clipkit.treefile\n        base=f.name[:-len('.mafft.clipkit.treefile')]\n        mlfile=p/(base+'.mafft.clipkit.mldist')\n        if mlfile.exists():\n            ds,_=parse_mldist(mlfile)\n            ml_means.append(mean(ds))\n    print(group)\n    print(' treefiles',len(tree_means),'median',median(tree_means),'mean',mean(tree_means),'minmax',min(tree_means),max(tree_means))\n    print(' mldist',len(ml_means),'median',median(ml_means),'mean',mean(ml_means),'minmax',min(ml_means),max(ml_means))\n    if errors: print('errors',errors[:5])\n    print('first 10 tree means', tree_means[:10])\n    print('first 10 ml means', ml_means[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
