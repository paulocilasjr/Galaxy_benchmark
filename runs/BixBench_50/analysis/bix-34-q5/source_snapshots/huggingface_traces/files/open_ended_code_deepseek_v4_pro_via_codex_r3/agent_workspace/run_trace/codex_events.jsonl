{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nfor group in ['scogs_animals','scogs_fungi']:\n    p=Path('/workspace/tmp')/group\n    cnt=Counter()\n    files=sorted(p.glob('*.faa'))\n    with_ml=[]\n    print(group, 'faa files', len(files))\n    for f in files:\n        n=sum(1 for line in f.open() if line.startswith('>'))\n        cnt[n]+=1\n        base=f.name\n        ml=p/(base+'.mafft.clipkit.mldist')\n        if ml.exists(): with_ml.append((f.name,n))\n    print('seq counts:', cnt)\n    print('with mldist:', len(with_ml), Counter(n for _,n in with_ml))\n    print('no mldist sample', [f for f in files if not (p/(f.name+'.mafft.clipkit.mldist')).exists()][:10])\n    # check which suffix exist\n    bybase={f.name.split('.')[0] for f in files}\n    print('unique bases',len(bybase))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
