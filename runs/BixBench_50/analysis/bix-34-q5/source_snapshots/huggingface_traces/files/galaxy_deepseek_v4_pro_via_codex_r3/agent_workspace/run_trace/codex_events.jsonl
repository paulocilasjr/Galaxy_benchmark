 name in z.namelist():\\n        if not name.endswith('.mldist'):\\n            continue\\n        text = z.read(name).decode('ascii')\\n        lines = [line.strip() for line in text.splitlines() if line.strip()]\\n        if not lines:\\n            continue\\n        n = int(lines[0].split()[0])\\n        vals = []\\n        for line in lines[1:]:\\n            parts = line.split()\\n            for tok in parts[1:1+n]:\\n                vals.append(float(tok))\\n        total = sum(vals)\\n        mean = total / (n * (n - 1))\\n        out.append((group, name, mean))\\n\\nout.sort()\\nfor group, name, mean in out:\\n    print(f\\\"{group}\\\\t{name}\\\\t{mean:.12g}\\\")\\nPY\",\n    \"command_version\": \"\",\n    \"copied_from_job_id\": null,\n    \"create_time\": \"2026-08-16T22:38:53.711092\",\n    \"dependencies\": [],\n    \"exit_code\": 0,\n    \"external_id\": null,\n    \"galaxy_version\": \"26.1\",\n    \"handler\": null,\n    \"history_id\": \"bbd44e69cb8906b50f102f5b087bafbb\",\n    \"id\": \"bbd44e69cb8906b52fa5942ef8cda82b\",\n    \"inputs\": {\n      \"animals_archive\": {\n        \"id\": \"f9cad7b01a4721353c333583e8055542\",\n        \"src\": \"hda\",\n        \"uuid\": \"08ec74c0-a79d-4683-b47a-f894a91d31f7\"\n      },\n      \"fungi_archive\": {\n        \"id\": \"f9cad7b01a472135e23ed619ff4edf16\",\n        \"src\": \"hda\",\n        \"uuid\": \"feeb634d-25aa-4b7f-b5e9-96db97e1de1f\"\n      }\n    },\n    \"job_messages\": [],\n    \"job_metrics\": null,\n    \"job_runner_name\": null,\n    \"job_stderr\": \"\",\n    \"job_stdout\": \"\",\n    \"model_class\": \"Job\",\n    \"output_collections\": {},\n    \"outputs\": {\n      \"per_tree_means\": {\n        \"id\": \"f9cad7b01a472135f91f552ad9f1a554\",\n        \"src\": \"hda\",\n        \"uuid\": \"0c361946-6449-4e2b-8fec-18afe92c5ea6\"\n      }\n    },\n    \"params\": {\n      \"__input_ext\": \"\\\"input\\\"\",\n      \"chromInfo\": \"\\\"/cvmfs/data.galaxyproject.org/managed/len/ucsc/?.l