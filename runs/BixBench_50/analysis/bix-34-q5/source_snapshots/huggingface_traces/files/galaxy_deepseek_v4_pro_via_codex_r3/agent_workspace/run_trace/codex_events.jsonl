{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport zipfile, re\nfor f in ['/workspace/tmp/scogs_animals.zip','/workspace/tmp/scogs_fungi.zip']:\n print('\\\\n###', f)\n z=zipfile.ZipFile(f)\n mld=[n for n in z.namelist() if n.endswith('.mldist')]\n sizes=[]\n taxas=set()\n for n in mld:\n  txt=z.read(n).decode('ascii','replace')\n  lines=[l for l in txt.splitlines() if l.strip()]\n  if lines:\n   sizes.append(int(lines[0].strip()))\n   # last taxa line? taxon labels are first token in rows after header\n   for l in lines[1:]:\n    taxas.add(l.split()[0])\n print('mldist count', len(mld), 'size distribution', sorted(set(sizes)), 'counts', {s:sizes.count(s) for s in sorted(set(sizes))})\n print('taxa seen', sorted(taxas))\n # inspect tree taxa counts\n trees=[n for n in z.namelist() if n.endswith('.treefile')]\n print('treefiles', len(trees))\n # sample 3 trees taxon counts using labels\n c={}\n for n in trees:\n  txt=z.read(n).decode('ascii','replace')\n  labels=set(re.findall(r'([A-Za-z_]+):', txt))\n  c[len(labels)]=c.get(len(labels),0)+1\n print('tree taxon label count distribution (regex)', c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
