  {\n            \"label\": \"Variance (population)\",\n            \"value\": \"pvar\"\n          },\n\n### run_trace/galaxy_tool_schema_006/tool_response.json\n{\n  \"description\": \"(operations on tabular data)\",\n  \"edam_operations\": [],\n  \"edam_topics\": [],\n  \"form_style\": \"regular\",\n  \"has_parameters\": true,\n  \"hidden\": \"\",\n  \"hidden_versions\": [],\n  \"icon\": null,\n  \"id\": \"toolshed.g2.bx.psu.edu/repos/iuc/datamash_ops/datamash_ops/1.9+galaxy0\",\n  \"inputs\": [\n    {\n      \"argument\": null,\n      \"edam\": {\n        \"edam_data\": [\n          \"data_0006\",\n          \"data_0006\",\n          \"data_0006\"\n        ],\n        \"edam_formats\": [\n          \"format_3475\",\n          \"format_3475\",\n          \"format_3475\"\n        ]\n      },\n      \"extensions\": [\n        \"tabular\",\n        \"csv\",\n        \"tsv\"\n      ],\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Input tabular dataset\",\n      \"model_class\": \"DataToolParameter\",\n      \"multiple\": false,\n      \"name\": \"in_file\",\n      \"optional\": false,\n      \"options\": {\n        \"dce\": [],\n        \"hda\": [],\n        \"hdca\": [],\n        \"ldda\": []\n      },\n      \"options_meta\": {},\n      \"pinned\": {\n        \"dce\": [],\n        \"hda\": [],\n        \"hdca\": [],\n        \"ldda\": []\n      },\n      \"refresh_on_change\": true,\n      \"tag\": null,\n      \"type\": \"data\",\n      \"value\": null\n    },\n    {\n      \"area\": false,\n      \"argument\": \"--group\",\n      \"datalist\": [],\n      \"help\": \"Group consecutive rows with equal values in the chosen fields. If no columns are specified, each operation is performed in the entire input file. Comma separated list of column indices, e.g. 1,5\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Group by fields\",\n      \"model_class\": \"TextToolParameter\",\n      \"name\": \"grouping\",\n      \"optional\": true,\n      \"refresh_on_change\": false,\n      \"type\": \"text\",\n      \"value\": null\n    },\n    {\n      \"argument\": \"--sort\",\n      \"falsevalue\": \"\",\n      \"help\": \"Input file must be sorted by the grouping columns. Enable this option to automatically sort the input.\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Sort input\",\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"need_sort\",\n      \"optional\": false,\n      \"refresh_on_change\": false,\n      \"truevalue\": \"--sort\",\n      \"type\": \"boolean\",\n      \"value\": false\n    },\n    {\n      \"argument\": \"--header-in\",\n      \"falsevalue\": \"\",\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Input file has a header line\",\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"header_in\",\n      \"optional\": false,\n      \"refresh_on_change\": false,\n      \"truevalue\": \"--header-in\",\n      \"type\": \"boolean\",\n      \"value\": false\n    },\n    {\n      \"argument\": \"--header-out\",\n      \"falsevalue\": \"\",\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Print header line\",\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"he\n### run_trace/galaxy_tool_schema_007/build_response.json\n{\n  \"action\": \"/tool_runner/index\",\n  \"citations\": true,\n  \"creator\": null,\n  \"credentials\": [],\n  \"description\": \"\",\n  \"display\": true,\n  \"edam_operations\": [],\n  \"edam_topics\": [],\n  \"enctype\": \"application/x-www-form-urlencoded\",\n  \"errors\": {\n    \"tools|input2\": \"Parameter 'input2': specify a dataset of the required format / build for pa