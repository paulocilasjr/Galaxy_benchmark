{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport csv, collections\np=Path('/workspace/downloads/ROSMAP_genexp_ad.csv')\nwith p.open(newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n    # read all rows as lists, gene col first\n    rows=[row for row in r]\ncols=header[1:]\ngroups=collections.defaultdict(list)\nfor i,x in enumerate(cols):\n    groups[x].append(i)\nprint('cols',len(cols),'genes',len(rows))\nfor pid, inds in groups.items():\n    if len(inds)>1:\n        # extract col data as strings\n        series=[]\n        for i in inds:\n            vals=[row[i+1] for row in rows]\n            series.append(vals)\n        identical=all(s==series[0] for s in series[1:])\n        # count nonempty/NaN etc; find first differing gene positions\n        diffs=[]\n        for g,(vals) in enumerate(zip(*series)):\n            if len(set(vals))>1:\n                diffs.append((header[0] if False else rows[g][0], list(vals)))\n                if len(diffs)>=3: break\n        print(pid, 'indices', [x+1 for x in inds], 'identical', identical, 'first_diffs', diffs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
