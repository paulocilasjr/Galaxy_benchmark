{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, numpy as np, collections\nfrom numpy.linalg import svd\nwith open('inputs/ROSMAP_genexp_ad.csv') as f:\n    h=next(csv.reader(f)); ids=h[1:]\n    X=np.array([[float(x) for x in row[1:]] for row in csv.reader(f)], dtype=float)\n# fit function centered, full SVD, ratio using eigenvalues/total variance\ndef pca_ratio(Xsamples):\n    Y=np.log10(Xsamples+1.0)\n    Yc=Y-Y.mean(axis=0)\n    # zero variance features\n    var=Yc.var(axis=0, ddof=0)\n    Yz=Yc[:,var>1e-15]\n    # SVD of centered matrix; eigenvalues = s\"'^2/n if ddof=0 denominator n\n    n,p=Yz.shape\n    # scikit-learn divides by n for variance, PCA uses n (not n-1)\n    U,s,Vt=svd(Yz, full_matrices=False)\n    eig=s*s/n\n    total=np.sum(Yz.var(axis=0,ddof=0))\n    ratio=eig/total\n    return ratio[0]*100, ratio[:100].sum(), n, p\nprint('\"'all', pca_ratio(X.T))\n# 178 singletons only\ncnt=collections.Counter(ids)\nkeep_single=np.array([cnt[s]==1 for s in ids])\nprint('singletons', pca_ratio(X.T[keep_single]))\n# 199 choose first occurrence for each duplicated base\nkeep_first=np.zeros(len(ids),dtype=bool)\nseen=set()\nfor i,s in enumerate(ids):\n    if s not in seen:\n        keep_first[i]=True; seen.add(s)\nprint('first occurrence unique base', pca_ratio(X.T[keep_first]))\n# 222 but remove all duplicate groups? same as singleton\n# if scale features (correlation PCA)\nY=np.log10(X.T+1.0)\nfrom sklearn.decomposition import PCA\nfor scale in [False,True]:\n    p=PCA(n_components=100, svd_solver='full')\n    Z=Y\n    p.fit(Z)\n    print('sklearn all scale',scale,p.explained_variance_ratio_[0]*100, p.explained_variance_ratio_.sum())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
