{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom sklearn.decomposition import PCA\n# read expression with duplicate columns preserved as unique? pandas mangles; use raw column order and transpose ourselves\nimport csv\nwith open('inputs/ROSMAP_genexp_ad.csv') as f:\n    r=csv.reader(f)\n    header=next(r)\n    sample_ids=header[1:]\n    rows=[]\n    for row in r:\n        rows.append([float(x) for x in row[1:]])\nX=np.array(rows, dtype=float)  # genes x samples\nprint('X',X.shape, 'any nan',np.isnan(X).any(), 'min',X.min(), 'max',X.max())\n# baseline all columns as samples rows\nY=np.log10(X.T+1.0)\nprint('Y shape',Y.shape)\n# centering and zero var\nmeans=Y.mean(axis=0)\nYc=Y-means\n# remove zero variance features after transform/center\nvars=Yc.var(axis=0, ddof=0)\nprint('zero var features before',np.sum(vars<=1e-15),'max',vars.max())\nnz=vars>0\nYz=Yc[:,nz]\nprint('features after zero var',Yz.shape[1])\npca=PCA(n_components=100, svd_solver='full')\npca.fit(Yz)\nprint('baseline all 222 explained var ratio sum100',pca.explained_variance_ratio_.sum())\nprint('PC1 %',pca.explained_variance_ratio_[0]*100)\nprint('PC1 eigenvalue',pca.explained_variance_[0], 'total',pca.explained_variance_.sum()/pca.explained_variance_ratio_.sum())\n# unique IDs exclusion all duplicate groups\nimport collections\ncnt=collections.Counter(sample_ids)\nkeep=[i for i,s in enumerate(sample_ids) if cnt[s]==1]\nprint('keep count',len(keep), 'drop',len(sample_ids)-len(keep))\nYu=np.log10(X.T[keep]+1.0)\nYc=Yu-Yu.mean(axis=0)\nvars=Yc.var(axis=0,ddof=0)\nnz=vars>1e-15\nYz=Yc[:,nz]\npca=PCA(n_components=100, svd_solver='full')\npca.fit(Yz)\nprint('unique 199 PC1 %',pca.explained_variance_ratio_[0]*100,'sum100',pca.explained_variance_ratio_.sum(),'features',Yz.shape[1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
