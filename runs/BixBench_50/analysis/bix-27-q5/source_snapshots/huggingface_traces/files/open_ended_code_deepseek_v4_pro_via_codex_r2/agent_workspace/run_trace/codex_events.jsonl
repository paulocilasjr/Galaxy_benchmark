{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, numpy as np\nfrom sklearn.decomposition import PCA\nwith open('inputs/ROSMAP_genexp_ad.csv', newline='') as f:\n    header=next(csv.reader(f))\n    n_samples=len(header)-1\n    X=np.array([[float(v) for v in row[1:]] for row in csv.reader(f)], dtype=float)\nprint('raw shape',X.shape,'samples',n_samples,'genes',X.shape[0],'NaN',np.isnan(X).any())\nY=np.log10(X.T + 1.0)  # samples x genes\nprint('Y',Y.shape,'finite',np.isfinite(Y).all(),'zero genes after log',np.sum(Y.var(axis=0)==0))\npca=PCA(n_components=100, svd_solver='full')\npca.fit(Y)\npc1=pca.explained_variance_ratio_[0]\ntotal_ratio=pca.explained_variance_ratio_.sum()\nprint('PC1 ratio',repr(pc1),'percent',pc1*100)\nprint('sum first100 ratios',total_ratio)\nprint('PC1 eigenvalue',pca.explained_variance_[0],'sum eigenvalues all?',pca.explained_variance_.sum())\n# denominator should be trace of centered covariance / n using np.cov ddof=0\nZ=Y-Y.mean(axis=0)\ndenom=np.sum(Z*Z)/Y.shape[0]\nprint('denom trace',denom,'eig/denom',pca.explained_variance_[0]/denom)\n# compare singular value squared/n\nU,s,Vt=np.linalg.svd(Z,full_matrices=False)\nprint('svd first ratio',(s[0]**2/Y.shape[0])/denom)\nprint('all svd sum',np.sum(s**2/Y.shape[0])/denom)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
