{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport csv\nfrom pathlib import Path\nsrc=Path('/workspace/work/count.csv')\noutdir=Path('/workspace/work/per_sample')\noutdir.mkdir(exist_ok=True)\nwith src.open() as f:\n    r=csv.reader(f)\n    header=next(r)\n    assert header==['geneID','KL1','KL2','KL3','WL1','WL2','WL3'], header\n    # create writers\n    files={s: outdir/(s+'.tsv') for s in header[1:]}\n    writers={s: open(p,'w',newline='') for s,p in files.items()}\n    for s,w in writers.items():\n        w.write(f'geneID\\\\t{s}\\\\n')\n    for row in r:\n        gid=row[0]\n        for j,s in enumerate(header[1:], start=1):\n            writers[s].write(f'{gid}\\\\t{row[j]}\\\\n')\n    for w in writers.values():\n        w.close()\nfor p in sorted(outdir.iterdir()):\n    print(p.name, p.stat().st_size)\n    print(p.read_text().splitlines()[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
