{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfor name in ['full_deseq.tsv','reduced_deseq.tsv']:\n p=Path('/workspace/work')/name\n n=0; sig=0; bad=0; pvlt=0; lfcgt=0; bmgt=0\n with p.open() as f:\n  for line in f:\n   parts=line.rstrip('\\\\n').split('\\\\t')\n   if len(parts)<6: continue\n   gid,bm,lfc,lfcse,pv,padj=parts[:6]\n   n+=1\n   try:\n    b=float(bm); l=float(lfc); pval=float(pv)\n   except Exception:\n    bad+=1; continue\n   if pval < 0.05: pvlt+=1\n   if abs(l)>1: lfcgt+=1\n   if b>10: bmgt+=1\n   if pval < 0.05 and abs(l)>1 and b>10:\n    sig+=1\n print(name, 'rows', n, 'bad', bad, 'sig', sig, 'p<.05',pvlt,'|lfc|>1',lfcgt,'baseMean>10',bmgt)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
