{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nfrom bioblend.galaxy.datasets import DatasetClient\nimport os\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\ndc=DatasetClient(gi)\nds='f9cad7b01a472135eaf0f59f7c33ebd2'\ninfo=dc.show_dataset(ds)\nprint(info.get('name'), info.get('file_size'), info.get('state'), info.get('file_ext'))\npath='/workspace/excl3_deseq.tsv'\ndc.download_dataset(ds, file_path=path, use_default_filename=False)\ndef f(x):\n    try: return float(x)\n    except: return None\nn=0; raw=padj=raw_lfc=padj_lfc=0; na_pv=na_padj=na_lfc=0\nwith open(path) as fh:\n    for line in fh:\n        parts=line.rstrip('\\\\n').split('\\\\t')\n        if len(parts)<6: continue\n        n+=1\n        bm=f(parts[1]); lfc=f(parts[2]); pv=f(parts[4]); pa=f(parts[5])\n        if pv is None: na_pv+=1\n        if pa is None: na_padj+=1\n        if lfc is None: na_lfc+=1\n        if pv is not None and pv<0.05: raw+=1\n        if pa is not None and pa<0.05: padj+=1\n        if pv is not None and pv<0.05 and lfc is not None and bm is not None and abs(lfc)>1 and bm>10: raw_lfc+=1\n        if pa is not None and pa<0.05 and lfc is not None and bm is not None and abs(lfc)>1 and bm>10: padj_lfc+=1\nprint('rows',n,'NA pv',na_pv,'NA padj',na_padj,'NA lfc',na_lfc)\nprint('raw p<.05',raw,'padj<.05',padj)\nprint('criteria raw',raw_lfc,'criteria padj',padj_lfc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
