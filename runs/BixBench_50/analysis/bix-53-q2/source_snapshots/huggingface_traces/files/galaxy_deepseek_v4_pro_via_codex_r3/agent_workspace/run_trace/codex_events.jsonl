[[1]]\n342:         if (length(contrast_parts) != 3) {\n343:             cat(\"Error: contrast_definition must be in format 'factor,target,reference'\\n\")\n346:         custom_contrast <- list(\n347:             factor = trim(contrast_parts[1]),\n348:             target = trim(contrast_parts[2]),\n349:             reference = trim(contrast_parts[3])\n351:         # Validate the contrast\n352:         if (!(custom_contrast$factor %in% factor_col_names)) {\n353:             cat(paste0(\"Error: Contrast factor '\", custom_contrast$factor, \"' not found in design formula.\\n\"))\n367:     # So we swap the naming to match the contrast direction used below\n476:     histogram_res <- if (!is.null(unshrunken_res)) unshrunken_res else res\n479:         h <- hist(histogram_res$pvalue, breaks = 0:50 / 50, plot = FALSE)\n490:         h1 <- hist(histogram_res$pvalue[!use], breaks = 0:50 / 50, plot = FALSE)\n491:         h2 <- hist(histogram_res$pvalue[use], breaks = 0:50 / 50, plot = FALSE)\n511:             alpha = opt$alpha_ma\n517:             alpha = opt$alpha_ma\n520:         plotMA(res, main = paste(\"MA-plot for\", title_suffix), ylim = range(res$log2FoldChange, na.rm = TRUE), alpha = opt$alpha_ma)\n524: get_contrast_coefficient_name <- function(dds, contrast_factor, lvl, ref) {\n525:     coefficient_name <- paste0(contrast_factor, \"_\", lvl, \"_vs_\", ref)\n527:         make.names(contrast_factor), \"_\",\n540:             \"Could not find coefficient for '\", contrast_factor, \": \", lvl, \" vs \", ref, \"' for lfcShrink. \",\n543:             \"lfcShrink requires a model coefficient; for non-reference pairwise contrasts, \",\n544:             \"rerun with the requested reference level or disable lfcShrink.\"\n549: get_contrast_results <- function(dds, contrast_factor, lvl, ref, cooks_cutoff, independent_filtering, lfc_shrinkage_type, parallel) {\n551:         res <- results(\n553:             contrast = c(contrast_factor, lvl, ref),\n561:         stop(\"lfcShrink type 'apeglm' requires the apeglm package.\")\n564:         stop(\"lfcShrink type 'ashr' requires the ashr package.\")\n567:     coefficient_name <- get_contrast_coefficient_name(dds, contrast_factor, lvl, ref)\n568:     res <- results(\n575:         cat(paste0(\"Applying DESeq2 lfcShrink type '\", lfc_shrinkage_type, \"' using coefficient '\", coefficient_name, \"'\\n\"))\n577:     shrunk_res <- lfcShrink(\n584:     output_res <- shrunk_res\n585:     if (!(\"pvalue\" %in% names(output_res)) && \"pvalue\" %in% names(res)) {\n586:         output_res$pvalue <- res$pvalue\n596:         return(c(\"geneID\", \"baseMean\", \"log2FoldChange\", \"lfcSE\", \"stat\", \"pvalue\", \"padj\"))\n598:     c(\"geneID\", \"baseMean\", \"log2FoldChange\", \"lfcSE\", \"pvalue\", \"padj\")\n740:     cat(\"Error: DESeq2 lfcShrink cannot be combined with beta prior shrinkage. Turn off beta priors or set lfcShrink to none.\\n\")\n743: if (!is.null(opt$many_contrasts) && opt$lfc_shrinkage_type != \"none\") {\n744:     cat(\"Error: lfcShrink is only supported for a single selected contrast. Disable many_contrasts or set lfcShrink to none.\\n\")\n789: if (is.null(opt$many_contrasts)) {\n790:     # Single contrast mode\n791:     if (!is.null(opt$custom_design_formula) && exists(\"custom_contrast\")) {\n792:         # Use explicit custom contrast\n793:         ref <- custom_contrast$reference\n794:         lvl <- custom_contrast$target\n795:         contrast_factor <- custom_contrast$factor\n797:         # Default: contrast using stored reference and target levels\n806:             cat(\"  2. Use many_contrasts mode to compare all levels pairwise\\n\")\n811:         # contrast = c(factor, level1, level2) computes log2(level1 / level2)\n823:         contrast_factor <- primary_factor\n826:     contrast_results <- get_contrast_results(\n828:         contrast_factor = contrast_factor,\n836:     res <- contrast_results$results\n837:     unshrunken_res <- contrast_results$unshrunken_results\n840:         cat(paste0(contrast_factor, \": \", lvl, \" vs \", ref, \"\\n\"))\n847:     filename <- opt$outfile\n849:     threshold_res <- if (!is.null(unshrunken_res)) unshrunken_res else res\n860:     # rotate through the possible contrasts of the primary factor\n861:     # write out a sorted table of results with the contrast as a suffix\n862:     # add contrast specific plots to the device\n865:         contrast_levels <- all_levels[(i + 1):n]\n866:         for (lvl in contrast_levels) {\n867:             contrast_results <- get_contrast_results(\n869:                 contrast_factor = primary_factor,\n877:             res <- contrast_results$results\n878:             unshrunken_res <- contrast_results$unshrunken_results\n885:             threshold_res <- if (!is.null(unshrunken_res)) unshrunken_res else res\n","exit_code":0,"status":"completed"}}
