{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, json, time\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\nurl=os.environ['GALAXY_URL'].rstrip('/')\ngi=GalaxyInstance(url=url,key=key)\nhid='bbd44e69cb8906b57a8f95fe12e5ad29'\nsamples=['KL1','KL2','KL3','WL1','WL2','WL3']\nids={}\nfor s in samples:\n    path=f'/workspace/samples/{s}.tab'\n    r=gi.tools.upload_file(path, history_id=hid, file_name=f'{s}.tab', file_type='tabular', space_to_tab=False, dbkey='?')\n    # response may be job\n    print('uploaded', s, r)\n# Poll contents\nfor i in range(30):\n    contents=gi.histories.show_history(hid, contents=True)\n    states={c.get('name'):c.get('state') for c in contents if c.get('name') in samples}\n    print(i, states)\n    if all(v=='ok' for v in states.values()): break\n    time.sleep(2)\nprint('final contents names')\nfor c in gi.histories.show_history(hid, contents=True):\n    if c.get('name') in samples:\n        print(c.get('hid'), c.get('id'), c.get('name'), c.get('state'), c.get('extension'), c.get('file_size'))\n        ids[c.get('name')]=c.get('id')\nprint(json.dumps(ids))\nopen('/workspace/sample_ids.json','w').write(json.dumps(ids))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
