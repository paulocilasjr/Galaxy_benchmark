        \"local\",\n          \"2\",\n          false\n        ],\n        [\n          \"mean\",\n          \"3\",\n          false\n        ]\n      ],\n      \"display\": null,\n      \"multiple\": false,\n      \"textable\": false\n    },\n    {\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"outlier_replace_off\",\n      \"argument\": null,\n      \"type\": \"boolean\",\n      \"label\": \"Turn off outliers replacement (only affects with >6 replicates)\",\n      \"help\": \"When there are more than 6 replicates for a given sample, the DESeq2 will automatically replace                     counts with large Cook\\u2019s distance with the trimmed mean over all samples, scaled up by the size factor                     or normalization factor for that sample\",\n      \"help_format\": \"html\",\n      \"refresh_on_change\": false,\n      \"optional\": false,\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"value\": false,\n      \"truevalue\": \"-a\",\n      \"falsevalue\": \"\"\n    },\n    {\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"outlier_filter_off\",\n      \"argument\": null,\n      \"type\": \"boolean\",\n      \"label\": \"Turn off outliers filtering (only affects with >2 replicates)\",\n      \"help\": \"When there are more than 2 replicates for a given sample, the DESeq2 will automatically                     filter genes which contain a Cook\\u2019s distance above a cutoff\",\n      \"help_format\": \"html\",\n      \"refresh_on_change\": false,\n      \"optional\": false,\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"value\": false,\n      \"truevalue\": \"-b\",\n      \"falsevalue\": \"\"\n    },\n    {\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"auto_mean_filter_off\",\n      \"argument\": null,\n      \"type\": \"boolean\",\n      \"label\": \"Turn off independent filtering\",\n      \"help\": \" DESeq2 performs independent filtering by default using the mean of normalized counts as a filter statistic\",\n      \"help_format\": \"html\",\n      \"refresh_on_change\": false,\n      \"optional\": false,\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"value\": false,\n      \"truevalue\": \"-c\",\n      \"falsevalue\": \"\"\n    },\n    {\n      \"model_class\": \"Conditional\",\n      \"name\": \"prefilter_conditional\",\n      \"type\": \"conditional\",\n      \"cases\": [\n        {\n          \"model_class\": \"ConditionalWhen\",\n          \"value\": \"-P\",\n          \"inputs\": [\n            {\n              \"model_class\": \"IntegerToolParameter\",\n              \"name\": \"prefilter_value\",\n              \"argument\": null,\n              \"type\": \"integer\",\n              \"label\": \"Pre-filter value\",\n              \"help\": \"Keep only rows that have at least N reads total.\",\n              \"help_format\": \"html\",\n              \"refresh_on_change\": false,\n              \"min\": 0,\n              \"max\": null,\n              \"optional\": false,\n              \"hidden\": false,\n              \"is_dynamic\": false,\n              \"value\": \"10\",\n              \"area\": false,\n              \"datalist\": []\n            }\n          ]\n        },\n        {\n          \"model_class\": \"ConditionalWhen\",\n          \"value\": \"\",\n          \"inputs\": []\n        }\n      ],\n      \"test_param\": {\n        \"model_class\": \"SelectToolParameter\",\n        \"name\": \"prefilter\",\n        \"argument\": null,\n        \"type\": \"select\",\n        \"label\": \"Perform pre-filtering\",\n        \"help\": \"While it is not necessary to pre-filter                     low count genes before running the DESeq2 functions, there are two reasons which make pre-filtering useful:                     by removing rows in which there are very few reads, we reduce the required memory, and we increase the speed.                     It can also improve visualizations, as features with no information for differential expression are not plotted.\",\n        \"help_format\": \"html\",\n        \"refresh_on_change\": true,\n        \"optional\": false,\n        \"hidden\": false,\n        \"is_dynamic\": false,\n        \"value\": \"\",\n        \"options\": [\n          [\n            \"Enabled\",\n            \"-P\",\n            false\n          ],\n          [\n            \"Disabled\",\n            \"\",\n            true\n          ]\n        ],\n        \"display\": null,\n        \"multiple\": false,\n        \"textable\": false\n      }\n    },\n    {\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"use_beta_priors\",\n      \"argument\": null,\n      \"type\": \"boolean\",\n      \"label\": \"Use beta priors\",\n      \"help\": \"Whether or not to put a zero-mean normal prior on the non-intercept coefficients\",\n      \"help_format\": \"html\",\n      \"refresh_on_change\": false,\n      \"optional\": false,\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"value\": false,\n      \"truevalue\": \"-d\",\n      \"falsevalue\": \"\"\n    },\n    {\n      \"model_class\": \"SelectToolParameter\",\n      \"name\": \"lfc_shrinkage_type\",\n      \"argument\": null,\n      \"type\": \"select\",\n      \"label\": \"Log2 fold-change shrinkage after DESeq2\",\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"refresh_on_change\": false,\n      \"optional\": false,\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"value\": \"none\",\n      \"options\": [\n        [\n          \"Do not apply lfcShrink\",\n          \"none\",\n          true\n        ],\n        [\n          \"DESeq2 lfcShrink: normal\",\n          \"normal\",\n          false\n        ],\n        [\n          \"DESeq2 lfcShrink: apeglm\",\n          \"apeglm\",\n          false\n        ],\n        [\n          \"DESeq2 lfcShrink: ashr\",\n          \"ashr\",\n          false\n        ]\n      ],\n 