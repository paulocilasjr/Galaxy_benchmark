{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, re, statistics, math, collections\n\ndef parse_newick(s):\n    # returns root dict? Instead parse via recursive descent with length.\n    s=s.strip().rstrip(';')\n    pos=0\n    # tokenizer\n    tokens=[]\n    i=0\n    while i<len(s):\n        c=s[i]\n        if c in '(),:':\n            tokens.append(c); i+=1\n        elif c.isspace():\n            i+=1\n        else:\n            j=i\n            while j<len(s) and s[j] not in '(),: \\\\t\\\\n':\n                j+=1\n            tokens.append(s[i:j]); i=j\n    # recursive parser; returns (kind, children, label, length) or leaf\n    pos=0\n    def parse_node():\n        nonlocal pos\n        label=''\n        length=None\n        children=[]\n        if tokens[pos]=='(':\n            pos+=1\n            while True:\n                children.append(parse_node())\n                if pos < len(tokens) and tokens[pos]==',':\n                    pos+=1\n                else:\n                    break\n            if pos < len(tokens) and tokens[pos]==')':\n                pos+=1\n            else:\n                raise ValueError('missing )')\n            # internal label until : or , or ) or end\n            if pos < len(tokens) and tokens[pos] not in [':',',',')',';']:\n                label=tokens[pos]; pos+=1\n        else:\n            label=tokens[pos]; pos+=1\n        if pos < len(tokens) and tokens[pos]==':':\n            pos+=1\n            length=float(tokens[pos]); pos+=1\n        return {'label':label,'length':length,'children':children}\n    root=parse_node()\n    return root\n\ndef compute_treeness(root):\n    total=0.0\n    internal=0.0\n    nleaf=0\n    # recursively accumulate edges: each child link length belongs to child node\n    def rec(node):\n        nonlocal total, internal, nleaf\n        is_leaf = not node['children']\n        if is_leaf:\n            nleaf += 1\n        if node is not root:\n            bl = node['length'] if node['length'] is not None else 0.0\n            total += bl\n            if not is_leaf:\n                internal += bl\n        for ch in node['children']:\n            rec(ch)\n    rec(root)\n    return internal/total if total>0 else 0.0, internal, total, nleaf\n\nfor zname in ['scogs_animals.zip','scogs_fungi.zip']:\n    p=f'/workspace/inputs/{zname}'\n    vals=[]\n    bad=[]\n    with zipfile.ZipFile(p) as z:\n        treefiles=[n for n in z.namelist() if n.endswith('.treefile')]\n        print(zname,'treefiles',len(treefiles))\n        for n in treefiles:\n            s=z.read(n).decode()\n            try:\n                root=parse_newick(s)\n                t,internal,total,nleaf=compute_treeness(root)\n                vals.append(t)\n                if nleaf not in [4,5]:\n                    print('  odd leaves',nleaf,n, s[:80])\n                if not math.isfinite(t): bad.append(n)\n            except Exception as e:\n                bad.append((n,repr(e),s[:200]))\n    print('bad',len(bad), bad[:3])\n    print('median',statistics.median(vals),'mean',statistics.mean(vals),'min max',min(vals),max(vals),'n',len(vals))\n    print('quartiles', [round(x,6) for x in statistics.quantiles(vals, n=4)]) # quartiles if py3.8?\n    print('count zero',sum(v==0 for v in vals))\n    print('top', sorted(vals)[-10:])\n    print('bottom', sorted(vals)[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
