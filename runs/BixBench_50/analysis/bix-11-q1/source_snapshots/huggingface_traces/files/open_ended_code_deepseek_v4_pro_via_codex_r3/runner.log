{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport inspect\nfrom phykit.services.tree.treeness import Treeness\nprint(inspect.getsource(Treeness.calculate_treeness))\nprint(inspect.getsource(Treeness._get_simple_newick_summary))\nPY\"","aggregated_output":"    def calculate_treeness(self, tree=None, print_value=False):\n        if not tree:\n            tree = self.read_tree_file()\n\n        inter_len, total_len = self.calculate_internal_and_total_branch_length_fast(\n            tree\n        )\n\n        try:\n            treeness = float(inter_len / total_len)\n            try:\n                if print_value:\n                    print(f\"{treeness}\")\n                return treeness\n            except BrokenPipeError:\n                pass\n        except ZeroDivisionError:\n            try:\n                print(\"Invalid tree. Tree should contain branch lengths\")\n                return None\n            except BrokenPipeError:\n                pass\n\n    def _get_simple_newick_summary(self, tree_path: str, attr_name: str):\n        try:\n            file_hash = self._get_file_hash(tree_path)\n            return self._cached_simple_newick_summary(tree_path, file_hash)\n        except FileNotFoundError:\n            path = getattr(self, attr_name)\n            raise PhykitUserError(\n                [\n                    f\"{path} corresponds to no such file or directory.\",\n                    \"Please check filename and pathing\",\n                ],\n                code=2,\n            )\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# Use previously parser quickly from scratch maybe just save values from zip with our parser\nimport zipfile, statistics, math, re\n\ndef parse_newick(s):\n    s=s.strip().rstrip(';')\n    tokens=[]; i=0\n    while i<len(s):\n        c=s[i]\n        if c in '(),:': tokens.append(c); i+=1\n        elif c.isspace(): i+=1\n        else:\n            j=i\n            while j<len(s) and s[j] not in '(),: \\\\t\\\\n': j+=1\n            tokens.append(s[i:j]); i=j\n    pos=0\n    def parse_node():\n        nonlocal pos\n        children=[]\n        label=''; length=None\n        if tokens[pos]=='(':\n            pos+=1\n            while True:\n                children.append(parse_node())\n                if pos<len(tokens) and tokens[pos]==',': pos+=1\n                else: break\n            if pos<len(tokens) and tokens[pos]==')': pos+=1\n            else: raise ValueError('missing )')\n            if pos<len(tokens) and tokens[pos] not in [':',',',')',';']:\n                label=tokens[pos]; pos+=1\n        else:\n            label=tokens[pos]; pos+=1\n        if pos<len(tokens) and tokens[pos]==':':\n            pos+=1\n            length=float(tokens[pos]); pos+=1\n        return {'children':children,'length':length}\n    return parse_node()\n\ndef tness(s):\n    root=parse_newick(s)\n    total=0.; internal=0.\n    def rec(node):\n        nonlocal total,internal\n        is_leaf=not node['children']\n        if node is not root:\n            bl=node['length'] if node['length'] is not None else 0.0\n            total+=bl\n            if not is_leaf: internal+=bl\n        for ch in node['children']: rec(ch)\n    rec(root)\n    return internal/total if total else 0.\n\nfor zname in ['scogs_animals.zip','scogs_fungi.zip']:\n    vals=[]\n    with zipfile.ZipFile('/workspace/inputs/'+zname) as z:\n        for n in [n for n in z.namelist() if n.endswith('.treefile')]:\n            vals.append(tness(z.read(n).decode()))\n    r4=[round(v,4) for v in vals]\n    print(zname)\n    print('full median',repr(statistics.median(vals)))\n    print('r4 median',repr(statistics.median(r4)))\n    print('full sorted around median', sorted(vals)[(len(vals)-1)//2:(len(vals)+2)//2+2])\n    print('r4 sorted around median', sorted(r4)[(len(vals)-1)//2:(len(vals)+2)//2+2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
