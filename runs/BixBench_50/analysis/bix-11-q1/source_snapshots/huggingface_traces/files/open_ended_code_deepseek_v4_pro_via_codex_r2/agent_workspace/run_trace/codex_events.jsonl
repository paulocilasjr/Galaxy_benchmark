{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile,re,collections\nfor zname in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n z=zipfile.ZipFile(zname)\n counts=collections.Counter()\n lengths=[]\n for n in z.namelist():\n  if n.endswith('.treefile'):\n   s=z.read(n).decode(errors='replace').strip()\n   taxa=len(re.findall(r'[A-Za-z_]+(?=:)', s))\n   counts[taxa]+=1\n   lengths.append(len(s))\n print(zname, 'taxa count', sorted(counts.items()), 'N',sum(counts.values()))\n # count all .faa sequences maybe taxa per gene for all faa\n counts2=collections.Counter()\n for n in z.namelist():\n  if n.endswith('.faa') and '.mafft' not in n:\n   s=z.read(n).decode(errors='replace')\n   taxa=s.count('>')\n   counts2[taxa]+=1\n print('faa taxa',sorted(counts2.items()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
