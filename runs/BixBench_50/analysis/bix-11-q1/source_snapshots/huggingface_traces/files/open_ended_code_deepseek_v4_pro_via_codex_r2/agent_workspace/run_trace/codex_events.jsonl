{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, collections, os\nfor zname in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    z=zipfile.ZipFile(zname)\n    names=z.namelist()\n    print('\\\\n===',zname,len(names))\n    # Count by extension/suffix and patterns\n    ext=collections.Counter()\n    genes=collections.defaultdict(list)\n    for n in names:\n        base=n.split('/')[-1]\n        # gene id prefix up to .faa\n        if '.faa' in base:\n            g=base.split('.faa')[0]\n            genes[g].append(n)\n        ext[base.split('.',1)[-1] if '.' in base else ''] +=1\n    for e,c in ext.most_common(): print(e,c)\n    print('genes',len(genes))\n    # list sample gene files\n    for g in list(genes)[:10]:\n        print(g, genes[g])\n    # list treefiles count\n    tfs=[n for n in names if n.endswith('.treefile')]\n    print('treefiles',len(tfs))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
