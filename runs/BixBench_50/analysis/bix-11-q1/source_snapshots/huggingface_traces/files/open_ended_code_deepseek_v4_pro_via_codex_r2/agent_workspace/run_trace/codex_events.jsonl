{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport inspect\nfrom phykit.services.tree.base import Tree\nprint(inspect.getsource(Tree._scan_simple_newick_summary))\nPY\"","aggregated_output":"    @staticmethod\n    def _scan_simple_newick_summary(file_path: str):\n        text = Tree._read_single_newick_document(\n            file_path,\n            validate_branch_lengths=False,\n        )\n\n        if not text or any(char in text for char in \"'\\\"[]\"):\n            return None\n\n        tip_names = []\n        total_len = 0.0\n        internal_len = 0.0\n        prev_sig = None\n        i = 0\n        text_len = len(text)\n        delimiters = \"(),:;\"\n        whitespace = \" \\t\\r\\n\"\n\n        while i < text_len:\n            char = text[i]\n            if char in whitespace:\n                i += 1\n                continue\n\n            if char == \"(\":\n                if prev_sig not in (None, \"(\", \",\"):\n                    return None\n                prev_sig = \"(\"\n                i += 1\n                continue\n            if char == \",\":\n                if prev_sig in (None, \"(\", \",\"):\n                    return None\n                prev_sig = \",\"\n                i += 1\n                continue\n            if char == \")\":\n                if prev_sig in (None, \"(\", \",\"):\n                    return None\n                prev_sig = \")\"\n                i += 1\n                continue\n            if char == \";\":\n                if len(set(tip_names)) != len(tip_names):\n                    return None\n                return tuple(tip_names), total_len, internal_len\n\n            if char == \":\":\n                if prev_sig in (None, \"(\", \",\"):\n                    return None\n                i += 1\n                start = i\n                while i < text_len and text[i] not in \",);\":\n                    if text[i] in whitespace:\n                        break\n                    i += 1\n                number = text[start:i]\n                if not number:\n                    return None\n                try:\n                    branch_length = float(number)\n                except ValueError:\n                    return None\n                if not isfinite(branch_length):\n                    return None\n                total_len += branch_length\n                if prev_sig in (\")\", \"internal_label\"):\n                    internal_len += branch_length\n                prev_sig = \"branch_length\"\n                continue\n\n            start = i\n            while i < text_len and text[i] not in delimiters and text[i] not in whitespace:\n                i += 1\n            token = text[start:i]\n            if not token:\n                return None\n            if prev_sig in (\"(\", \",\", None):\n                tip_names.append(token)\n                prev_sig = \"terminal_label\"\n            elif prev_sig == \")\":\n                prev_sig = \"internal_label\"\n            else:\n                return None\n\n        return None\n\n","exit_code":0,"status":"completed"}}
