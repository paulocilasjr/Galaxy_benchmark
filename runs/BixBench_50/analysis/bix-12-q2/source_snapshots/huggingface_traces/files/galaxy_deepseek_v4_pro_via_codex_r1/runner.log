{"type":"item.started","item":{"id":"item_131","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport os, requests, time, json, statistics\nfrom decimal import Decimal\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nh='bbd44e69cb8906b537dee805031326bc'; col='aa0094ee547f9cae'\nx=next(x for x in gi.histories.show_history(h, contents=True, visible=True) if x.get('id')==col)\nurl='https://usegalaxy.org'+x['contents_url']\nelements=requests.get(url, headers={'x-api-key':key}, timeout=120).json()\nmissing_names=set()\n# first gather missing by attempting? We'll use saved local list? no file. We'll re-download all with cache file in tmp and rate limit.\nout={}\nfor i,e in enumerate(elements):\n    did=e['object']['id']; name=e['element_identifier']\n    # use direct display URL with retry\n    disp=f'https://usegalaxy.org/api/histories/{h}/contents/{did}/display?to_ext=tabular'\n    text=None\n    for attempt in range(6):\n        try:\n            r=requests.get(disp, headers={'x-api-key':key}, timeout=60)\n            if r.status_code==200:\n                text=r.text; break\n            elif r.status_code==429:\n                time.sleep(2*(attempt+1))\n            else:\n                break\n        except Exception:\n            time.sleep(2)\n    if text is None:\n        # try bioblend once\n        try:\n            content=gi.datasets.download_dataset(did, maxwait=120)\n            text=content.decode('utf-8','replace') if isinstance(content,bytes) else content\n        except Exception as exc:\n            print('FAIL', name, did, str(exc)[:100])\n            continue\n    out[name]=text\n    if (i+1)%25==0:\n        print('progress', i+1, flush=True)\n        time.sleep(1)\n    time.sleep(0.15)\nprint('got', len(out))\n# parse\nvals=[]\nfor name,text in out.items():\n    parts=text.strip().split('\\\\t')\n    if len(parts)>=3:\n        vals.append(float(parts[2]))\nprint('parsed', len(vals))\npcts=vals\nmed=statistics.median(pcts)\nsv=sorted(pcts)\nidx=len(sv)//2\nprint('n',len(sv),'median',med,'middle',repr(sv[idx]), 'neighbors', sv[idx-5:idx+6])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
