{"type":"item.started","item":{"id":"item_130","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport os, requests, statistics, json\nfrom decimal import Decimal, ROUND_HALF_UP\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nh='bbd44e69cb8906b537dee805031326bc'\ncol='aa0094ee547f9cae'\nx=next(x for x in gi.histories.show_history(h, contents=True, visible=True) if x.get('id')==col)\nurl='https://usegalaxy.org'+x['contents_url']\ndata=requests.get(url, headers={'x-api-key':key}, timeout=120).json()\nvals=[]\nerrors=[]\nfor i,e in enumerate(data):\n    did=e['object']['id']; name=e['element_identifier']\n    try:\n        content=gi.datasets.download_dataset(did, maxwait=120)\n        text=content.decode('utf-8','replace') if isinstance(content,bytes) else content\n        parts=text.strip().split('\\\\t')\n        if len(parts)<3:\n            errors.append((name,'cols',text)); continue\n        pct=float(parts[2]); vals.append((name, float(parts[0]), float(parts[1]), pct, text.strip()))\n    except Exception as exc:\n        errors.append((name,'download',str(exc)))\nprint('n values', len(vals), 'errors', len(errors))\nif errors: print(errors[:20])\npcts=[v[3] for v in vals]\nprint('min max', min(pcts), max(pcts))\nprint('mean', statistics.mean(pcts))\nmed=statistics.median(pcts)\nprint('median float', med)\n# sorted around median\nsv=sorted(pcts)\nidx=len(sv)//2\nprint('middle index', idx, 'value', repr(sv[idx]), 'neighbors', sv[idx-5:idx+6])\n# format options\nfor nd in [2,3,4,5,6]:\n print(nd, f'{med:.{nd}f}')\n# exact median from Decimal formatted\ndecimals=[Decimal(str(p)) for p in pcts]\nsd=sorted(decimals)\nd=sd[len(sd)//2]\nprint('decimal median', d)\nprint('normalized', format(d.normalize(), 'f'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
