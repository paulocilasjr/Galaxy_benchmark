999999999999996 34 955 1370285at2759.faa.mafft\n2 3.563941299790356 3.5999999999999996 34 954 100698at2759.faa.mafft\n113 3.571428571428571 3.5999999999999996 5 140 1459797at2759.faa.mafft\n77 3.5778175313059033 3.5999999999999996 20 559 1339553at2759.faa.mafft\n207 3.588907014681892 3.5999999999999996 22 613 736068at2759.faa.mafft\n182 3.650190114068441 3.6999999999999997 48 1315 551907at2759.faa.mafft\n4 3.7362637362637363 3.6999999999999997 17 455 1014314at2759.faa.mafft\n","exit_code":0,"status":"completed"}}
