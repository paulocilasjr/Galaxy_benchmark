{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport subprocess, zipfile, xml.etree.ElementTree as ET, math, statistics\n# load res\nrscript=r'''\nfor (f in c('/workspace/inputs/res_1vs97.rds','/workspace/inputs/res_1vs98.rds')) { con<-gzfile(f,'rb'); x<-unserialize(con); close(con); y<-unclass(x); ld<-attr(y,'listData'); rn<-attr(y,'rownames'); cat('###FILE',basename(f),'\\\\n'); for(i in seq_along(rn)) cat(rn[i],ld\"'$log2FoldChange[i],ld$padj[i],'\"'\\\\n',sep='\\\\t') }\n'''\nout=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True,check=True).stdout\nres={}; cur=None\nfor line in out.splitlines():\n if line.startswith('###FILE'):cur=line.split()[1];res[cur]={};continue\n p=line.split('\\\\t')\n if len(p)>=3:res[cur][p[0]]=(float(p[1]),float(p[2]))\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse(fn):\n with zipfile.ZipFile(fn) as z:root=ET.fromstring(z.read('word/document.xml'))\n t=root.find('.//w:tbl',ns);d={}\n for tr in t.findall('w:tr',ns)[2:]:\n  cells=[''.join(x.text or '' for x in c.findall('.//w:t',ns)) for c in tr.findall('w:tc',ns)]\n  if len(cells)>=4 and cells[0]:\n   def f(s):\n    s=s.strip();return None if s in ('','-') else float(s)\n   d[cells[0]]=f(cells[2]) # rhlI only\n return d\nhcd=parse('/workspace/ppat.1006504.s012.docx'); bio=parse('/workspace/ppat.1006504.s013.docx')\nhcd_genes={g:v for g,v in hcd.items() if v is not None};bio_genes={g:v for g,v in bio.items() if v is not None}\ncommon=set(hcd_genes)&set(bio_genes); honly=set(hcd_genes)-set(bio_genes); bonly=set(bio_genes)-set(hcd_genes)\nprint('counts HCD',len(hcd_genes),'bio',len(bio_genes),'common',len(common),'Honly',len(honly),'Bonly',len(bonly))\nfor fname,d in res.items():\n print('\\\\n',fname)\n for label,genes in [('Honly',honly),('Bonly',bonly),('common',common)]:\n  vals=[]; signs=[]\n  for g in genes:\n   if g in d:\n    lfc=d[g][0]; vals.append(abs(lfc))\n    # expected sign = -table (if table WT/mutant)\n    # for Honly use HCD table, Bonly biofilm, common use HCD? use separate below\n    if g in hcd_genes: signs.append((lfc>0)==(-hcd_genes[g]>0))\n  if vals:\n   print(label,'n',len(vals),'meanabs',statistics.mean(vals),'medabs',statistics.median(vals))\n # detailed sign per source\n for label,genes,src in [('Honly',honly,hcd_genes),('Bonly',bonly,bio_genes),('common',common,hcd_genes)]:\n  ss=[]; aa=[]\n  for g in genes:\n   if g in d:\n    lfc=d[g][0]; ss.append((lfc>0)==(-src[g]>0)); aa.append(abs(lfc))\n  if ss: print('  ',label,'signag',sum(ss)/len(ss),'n',len(ss),'meanabs',statistics.mean(aa))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
