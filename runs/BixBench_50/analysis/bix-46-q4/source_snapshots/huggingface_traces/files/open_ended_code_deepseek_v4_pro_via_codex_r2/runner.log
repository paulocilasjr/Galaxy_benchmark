{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport subprocess, zipfile, xml.etree.ElementTree as ET, io, math, re\n\nrscript=r'''\nfor (f in c('/workspace/inputs/res_1vs97.rds','/workspace/inputs/res_1vs98.rds')) {\n  con<-gzfile(f,'rb'); x<-unserialize(con); close(con); y<-unclass(x)\n  ld<-attr(y,'listData'); rn<-attr(y,'rownames')\n  cat('\\\\n###FILE', basename(f), '\\\\n')\n  cat('gene\\\\tbaseMean\\\\tlog2FoldChange\\\\tlfcSE\\\\tstat\\\\tpvalue\\\\tpadj\\\\n')\n  for (i in seq_along(rn)) cat(rn[i], ld\"'$baseMean[i], ld$log2FoldChange[i], ld$lfcSE[i], ld$stat[i], ld$pvalue[i], ld$padj[i], '\"'\\\\n', sep='\\\\t')\n}\n'''\nproc=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True,check=True)\nprint('R out lines',len(proc.stdout.splitlines()),'stderr',proc.stderr[:200])\nfiles={}\ncur=None\nfor line in proc.stdout.splitlines():\n    if line.startswith('###FILE'):\n        cur=line.split()[1]; files[cur]={}\n        nextline=False\n        continue\n    parts=line.split('\\\\t')\n    if parts[0]=='gene':\n        continue\n    if len(parts)>=7:\n        files[cur][parts[0]]={'baseMean':float(parts[1]),'log2FoldChange':float(parts[2]),'lfcSE':float(parts[3]),'stat':float(parts[4]),'pvalue':float(parts[5]),'padj':float(parts[6])}\n\n# parse docx tables\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse_docx(fn):\n    with zipfile.ZipFile(fn) as z: root=ET.fromstring(z.read('word/document.xml'))\n    table=root.find('.//w:tbl',ns)\n    rows=[]\n    for tr in table.findall('w:tr',ns):\n        texts=[''.join(x.text or '' for x in c.findall('.//w:t',ns)) for c in tr.findall('w:tc',ns)]\n        rows.append(texts)\n    # skip header rows 0 and 1 (2nd has rhlR/rhlI)\n    data={}\n    for r in rows[2:]:\n        if len(r)>=4 and r[0]:\n            gene=r[0]\n            def conv(s):\n                s=s.strip()\n                if s=='-' or s=='': return None\n                # maybe weird '-2.003' yes\n                return float(s)\n            data[gene]={'rhlR':conv(r[1]),'rhlI':conv(r[2])}\n    return data\n\nfor fn,key in [('/workspace/ppat.1006504.s012.docx','HCD'),('/workspace/ppat.1006504.s013.docx','biofilm')]:\n    tab=parse_docx(fn)\n    print('\\\\n=== table',key,'n genes',len(tab))\n    for reskey in files:\n        vals=[]; diff=[]\n        for gene,d in tab.items():\n            if gene in files[reskey]:\n                lfc=files[reskey][gene]['log2FoldChange']\n                for col in ['rhlR','rhlI']:\n                    if d[col] is not None:\n                        vals.append((d[col],lfc)); diff.append((gene,col,d[col],lfc))\n        print('file',reskey,'matched',len(vals))\n        if vals:\n            # correlations raw and abs\n            def corr(pairs, key):\n                xs=[x[key] for x in pairs]; ys=[x['lfc'] for x in pairs]\n                n=len(xs); mx=sum(xs)/n; my=sum(ys)/n\n                cov=sum((a-mx)*(b-my) for a,b in zip(xs,ys))/n\n                sx=math.sqrt(sum((a-mx)**2 for a in xs)/n); sy=math.sqrt(sum((b-my)**2 for b in ys)/n)\n                return cov/(sx*sy) if sx*sy else 0\n            pairs=[]\n            for gene,d in tab.items():\n                if gene not in files[reskey]: continue\n                lfc=files[reskey][gene]['log2FoldChange']\n                for col in ['rhlR','rhlI']:\n                    if d[col] is not None: pairs.append({'gene':gene,'col':col,'val':d[col],'lfc':lfc})\n            print(' raw corr',corr(pairs,'val'))\n            for col in ['rhlR','rhlI']:\n                pp=[p for p in pairs if p['col']==col]\n                print('  col',col,'n',len(pp),'corr val/lfc',corr(pp,'val'),'corr val/(-lfc)',corr([dict(p,lfc=-p['lfc']) for p in pp],'val'))\n            # print selected genes\n            for gene in ['PA14_35160','PA14_09540','PA14_39960','PA14_51380','PA14_19100']:\n                if gene in tab and gene in files[reskey]:\n                    print(gene, tab[gene], files[reskey][gene]['log2FoldChange'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
