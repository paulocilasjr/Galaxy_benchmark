{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport subprocess, zipfile, xml.etree.ElementTree as ET, math\n# load res lfc and se\nrscript=r'''\nfor (f in c('/workspace/inputs/res_1vs97.rds','/workspace/inputs/res_1vs98.rds')) { con<-gzfile(f,'rb'); x<-unserialize(con); close(con); y<-unclass(x); ld<-attr(y,'listData'); rn<-attr(y,'rownames'); cat('###FILE',basename(f),'\\\\n'); for(i in seq_along(rn)) cat(rn[i],ld\"'$log2FoldChange[i],ld$lfcSE[i],'\"'\\\\n',sep='\\\\t') }\n'''\nout=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True,check=True).stdout\nres={};cur=None\nfor line in out.splitlines():\n if line.startswith('###FILE'):cur=line.split()[1];res[cur]={};continue\n p=line.split('\\\\t');\n if len(p)>=3:res[cur][p[0]]=(float(p[1]),float(p[2]))\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse(fn):\n with zipfile.ZipFile(fn) as z:root=ET.fromstring(z.read('word/document.xml'))\n t=root.find('.//w:tbl',ns);d={}\n for tr in t.findall('w:tr',ns)[2:]:\n  cells=[''.join(x.text or '' for x in c.findall('.//w:t',ns)) for c in tr.findall('w:tc',ns)]\n  if len(cells)>=4 and cells[0]:\n   def f(s):\n    s=s.strip();return None if s in ('','-') else float(s)\n   d[cells[0]]={'rhlR':f(cells[1]),'rhlI':f(cells[2])}\n return d\ntabs={'HCD':parse('/workspace/ppat.1006504.s012.docx'),'biofilm':parse('/workspace/ppat.1006504.s013.docx')}\n\ndef fit(fname,col,cond):\n rfcs=res[fname]; tab=tabs[cond]\n xs=[]; ys=[]; ses=[]\n for g,d in tab.items():\n  t=d[col]\n  if t is None or g not in rfcs:continue\n  x=-t; y=rfcs[g][0]; se=rfcs[g][1]\n  xs.append(x); ys.append(y); ses.append(se)\n n=len(xs)\n if n==0:return None\n # slope through origin weighted by 1/se\"'^2\n w=[1/(s*s) for s in ses]\n b=sum(wi*x*y for wi,x,y in zip(w,xs,ys))/sum(wi*x*x for wi,x in zip(w,xs))\n rss=sum(wi*(y-b*x)**2 for wi,x,y in zip(w,xs,ys))\n tss=sum(wi*y*y for wi,y in zip(w,ys))\n return {'\"'n':n,'b':b,'rss':rss,'tss':tss,'r2':1-rss/tss if tss else 0,'rmse':math.sqrt(sum((y-b*x)**2 for x,y in zip(xs,ys))/n)}\nfor case,cond,c97,c98 in [\n ('HCD A 97=rhlR 98=rhlI','HCD','rhlR','rhlI'),\n ('HCD B 97=rhlI 98=rhlR','HCD','rhlI','rhlR'),\n ('bio C 97=rhlR 98=rhlI','biofilm','rhlR','rhlI'),\n ('bio D 97=rhlI 98=rhlR','biofilm','rhlI','rhlR')]:\n m1=fit('res_1vs97.rds',c97,cond);m2=fit('res_1vs98.rds',c98,cond)\n print('\\\\n',case)\n for nm,m in [('res97',m1),('res98',m2)]:\n  print(nm,m)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
