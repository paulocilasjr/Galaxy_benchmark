{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# Use R output aligned by gene; compute summary metrics for mapping cases\nimport subprocess, zipfile, xml.etree.ElementTree as ET, math, statistics\nrscript=r'''\nfor (f in c('/workspace/inputs/res_1vs97.rds','/workspace/inputs/res_1vs98.rds')) { con<-gzfile(f,'rb'); x<-unserialize(con); close(con); y<-unclass(x); ld<-attr(y,'listData'); rn<-attr(y,'rownames'); cat('###FILE',basename(f),'\\\\n'); for(i in seq_along(rn)) cat(rn[i],ld\"'$log2FoldChange[i],ld$padj[i],'\"'\\\\n',sep='\\\\t') }\n'''\nout=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True,check=True).stdout\nres={};cur=None\nfor line in out.splitlines():\n if line.startswith('###FILE'):cur=line.split()[1];res[cur]={};continue\n p=line.split('\\\\t');\n if len(p)>=3:res[cur][p[0]]=(float(p[1]),float(p[2]))\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse(fn):\n with zipfile.ZipFile(fn) as z:root=ET.fromstring(z.read('word/document.xml'))\n t=root.find('.//w:tbl',ns);d={}\n for tr in t.findall('w:tr',ns)[2:]:\n  cells=[''.join(x.text or '' for x in c.findall('.//w:t',ns)) for c in tr.findall('w:tc',ns)]\n  if len(cells)>=4 and cells[0]:\n   def f(s):\n    s=s.strip();return None if s in ('','-') else float(s)\n   d[cells[0]]={'rhlR':f(cells[1]),'rhlI':f(cells[2])}\n return d\ntabs={'HCD':parse('/workspace/ppat.1006504.s012.docx'),'biofilm':parse('/workspace/ppat.1006504.s013.docx')}\n\ndef metrics(rfcs, table_vals):\n xs=[];ys=[];signs=[];se=[]\n for g,t in table_vals.items():\n  if t is None or g not in rfcs:continue\n  lfc=rfcs[g][0]; expected=-t\n  xs.append(lfc);ys.append(expected);signs.append((lfc>0)==(expected>0));se.append((lfc-expected)**2)\n n=len(xs); mx=sum(xs)/n;my=sum(ys)/n\n cov=sum((x-mx)*(y-my) for x,y in zip(xs,ys))/n;sdx=math.sqrt(sum((x-mx)**2 for x in xs)/n);sdy=math.sqrt(sum((y-my)**2 for y in ys)/n)\n r=cov/(sdx*sdy) if sdx*sdy else 0\n # rank corr\n def ranks(v):\n  order=sorted(range(len(v)),key=lambda i:v[i]);r=[0]*len(v)\n  for rank,i in enumerate(order):r[i]=rank\n  return r\n rx=ranks(xs);ry=ranks(ys);mr=(n-1)/2;covr=sum((a-mr)*(b-mr) for a,b in zip(rx,ry))/n;varr=sum((a-mr)**2 for a in rx)/n;rho=covr/varr if varr else 0\n slope=cov/sdx**2 if sdx else 0\n return {'n':n,'sign':sum(signs)/n,'r':r,'rho':rho,'slope':slope,'rmse':math.sqrt(sum(se)/n)}\n\ncases=[\n ('HCD 97=rhlR 98=rhlI','HCD','rhlR','rhlI'),\n ('HCD 97=rhlI 98=rhlR','HCD','rhlI','rhlR'),\n ('biofilm 97=rhlR 98=rhlI','biofilm','rhlR','rhlI'),\n ('biofilm 97=rhlI 98=rhlR','biofilm','rhlI','rhlR'),\n]\nprint(f\\\"{'case':28s} {'res97':40s} {'res98':40s}\\\")\nfor name,cond,c97,c98 in cases:\n m1=metrics(res['res_1vs97.rds'],{g:d[c97] for g,d in tabs[cond].items()})\n m2=metrics(res['res_1vs98.rds'],{g:d[c98] for g,d in tabs[cond].items()})\n def fmt(m): return f\\\"n={m['n']:3d} sign={m['sign']:.2f} r={m['r']:.2f} rho={m['rho']:.2f} slope={m['slope']:.2f} rmse={m['rmse']:.2f}\\\"\n print(f'{name:28s} {fmt(m1):40s} {fmt(m2):40s}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
