{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport subprocess, zipfile, xml.etree.ElementTree as ET, math, statistics\n# load res via R output\nrscript=r'''\nfor (f in c('/workspace/inputs/res_1vs97.rds','/workspace/inputs/res_1vs98.rds')) {\n con<-gzfile(f,'rb'); x<-unserialize(con); close(con); y<-unclass(x); ld<-attr(y,'listData'); rn<-attr(y,'rownames')\n cat('###FILE', basename(f), '\\\\n')\n for (i in seq_along(rn)) cat(rn[i], ld\"'$log2FoldChange[i], ld$padj[i], '\"'\\\\n', sep='\\\\t')\n}\n'''\nout=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True,check=True).stdout\nfiles={}; cur=None\nfor line in out.splitlines():\n if line.startswith('###FILE'): cur=line.split()[1]; files[cur]={}; continue\n p=line.split('\\\\t');\n if len(p)>=3: files[cur][p[0]]=(float(p[1]),float(p[2]))\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse(fn):\n with zipfile.ZipFile(fn) as z: root=ET.fromstring(z.read('word/document.xml'))\n t=root.find('.//w:tbl',ns)\n d={}\n for tr in t.findall('w:tr',ns)[2:]:\n  cells=[''.join(x.text or '' for x in c.findall('.//w:t',ns)) for c in tr.findall('w:tc',ns)]\n  if len(cells)>=4 and cells[0]:\n   def f(s):\n    s=s.strip()\n    return None if s in ('','-') else float(s)\n   d[cells[0]]={'rhlR':f(cells[1]),'rhlI':f(cells[2])}\n return d\ntables={'HCD':parse('/workspace/ppat.1006504.s012.docx'),'biofilm':parse('/workspace/ppat.1006504.s013.docx')}\n\ndef linreg_scale(xs,ys):\n n=len(xs); mx=sum(xs)/n; my=sum(ys)/n\n cov=sum((x-mx)*(y-my) for x,y in zip(xs,ys)); var=sum((x-mx)**2 for x in xs)\n return cov/var if var else 0\n\nfor fname,res in files.items():\n print('\\\\nFILE',fname)\n for cond,tab in tables.items():\n  for col in ['rhlR','rhlI']:\n   xs=[];ys=[]\n   signs=[]\n   for gene,v in tab.items():\n    if v[col] is None or gene not in res: continue\n    reslfc=res[gene][0]\n    # table likely WT/mutant, so compa