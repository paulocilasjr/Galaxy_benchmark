{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef parse_fasta(path):\n    seqs=[]\n    name=None; buf=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None:\n                seqs.append((name,''.join(buf)))\n            name=line[1:].strip(); buf=[]\n        else:\n            buf.append(line.strip())\n    if name is not None:\n        seqs.append((name,''.join(buf)))\n    return seqs\n\ndef pis(seqs):\n    n=len(seqs)\n    if n<2 or not seqs:\n        return 0\n    L=len(seqs[0][1])\n    if any(len(s)\"'!=L for _,s in seqs):\n        raise ValueError('\"'unequal lengths')\n    pi=0\n    for i in range(L):\n        c=Counter(s[i] for _,s in seqs if s[i]\"'!='\"'-')\n        if sum(1 for v in c.values() if v>=2)>=2:\n            pi+=1\n    return pi\n\nd=Path('/workspace/work/scogs_animals')\nrows=[]\nfor f in d.glob('*.mafft'):\n    try:\n        seqs=parse_fasta(f)\n        p=pis(seqs)\n        rows.append((p,len(seqs),len(seqs[0][1]),f.name))\n    except Exception as e:\n        rows.append((-1,len(seqs),None,f.name,str(e)))\nrows.sort(reverse=True)\nprint('top 30:')\nfor r in rows[:30]:\n    print(r)\nprint('max', rows[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
