{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef parse_fasta(path):\n    seqs=[]; cur=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if cur:\n                seqs.append(''.join(cur)); cur=[]\n        else:\n            cur.append(line.strip())\n    if cur: seqs.append(''.join(cur))\n    return seqs\n\ndef pis(path):\n    seqs=parse_fasta(path)\n    n=len(seqs)\n    if n == 0:\n        return 0,0,n\n    L=len(seqs[0])\n    if any(len(s)\"'!=L for s in seqs):\n        raise ValueError(f'\"'unbalanced {path}: {sorted(set(map(len,seqs)))}')\n    count=0\n    for col in zip(*seqs):\n        chars=[c for c in col if c\"'!='\"'-']\n        if len(chars)<2:\n            continue\n        cnt=Counter(chars)\n        if sum(1 for v in cnt.values() if v>=2) >= 2:\n            count+=1\n    return count,L,n\n\nbest=[]\nfor path in sorted(Path('tmp/sca').glob('*.mafft')):\n    c,L,n=pis(path)\n    best.append((c,L,n,path.name))\nbest.sort(reverse=True)\nprint('top 30')\nfor row in best[:30]:\n    print(row)\nprint('MAX', best[0][0])\nprint('all complete?', [(row) for row in best if row[2]==4][:1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
