{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nimport glob, os\nfrom collections import Counter\n\ndef parse(f):\n    seqs=[]; cur=[]\n    for line in open(f):\n        if line.startswith('>'):\n            if cur: seqs.append(''.join(cur)); cur=[]\n        else:\n            s=line.strip()\n            if s: cur.append(s)\n    if cur: seqs.append(''.join(cur))\n    return seqs\n\nfor kind in ['tmp/sca','tmp/scf']:\n    print('\\\\n',kind)\n    res=[]\n    for f in glob.glob(kind+'/*.mafft'):\n        seqs=parse(f); n=len(seqs)\n        if n\"'!=4: continue\n        L=len(seqs[0])\n        assert all(len(s)==L for s in seqs)\n        # gap as state\n        counts=[]\n        # gaps ignored for each column (treat gap missing)\n        counts_ignore=[]\n        # only columns no gaps, counts aa\n        counts_nogap=[]\n        for j in range(L):\n            chars=[s[j] for s in seqs]\n            cnt=Counter(chars)\n            # informative standard each state count>=2\n            states=[c for c,v in cnt.items() if v>=2]\n            counts.append(len(states)>=2)\n            non_gap=[c for c in chars if c!='\"'-']\n            if len(non_gap)>=4:\n                cnt2=Counter(non_gap)\n                states2=[c for c,v in cnt2.items() if v>=2]\n                counts_ignore.append(len(states2)>=2)\n            elif len(non_gap)>=2:\n                # What definition ignoring gaps? can't have each state count 2 unless all 4 non-gap? with 3 non-gap one singleton\n                cnt2=Counter(non_gap); states2=[c for c,v in cnt2.items() if v>=2]\n                counts_ignore.append(len(states2)>=2)\n            else:\n                counts_ignore.append(False)\n            if all(c\"'!='\"'-' for c in chars):\n                cnt3=Counter(chars); states3=[c for c,v in cnt3.items() if v>=2]\n                counts_nogap.append(len(states3)>=2)\n            else:\n                counts_nogap.append(False)\n        res.append((sum(counts),sum(counts_ignore),sum(counts_nogap),L,n,os.path.basename(f)))\n    for i,(a,b,c,L,n,name) in enumerate(sorted(res, reverse=True)[:30],1):\n        print(i,name,L,a,b,c)\n    print('max gapstate',max(r[0] for r in res),'max ignore',max(r[1] for r in res),'max nogap',max(r[2] for r in res),'num',len(res))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
