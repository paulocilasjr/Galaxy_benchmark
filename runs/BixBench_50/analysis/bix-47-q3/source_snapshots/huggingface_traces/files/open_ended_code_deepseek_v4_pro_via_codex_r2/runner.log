{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, collections, os\nf='inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_556-PF.xlsx'\nwb=openpyxl.load_workbook(f, read_only=False, data_only=True)\nws=wb.active\nit=ws.iter_rows(values_only=True); next(it); hdr=next(it)\nidx={str(h):i for i,h in enumerate(hdr)}\ncounts=collections.Counter(); inchip=collections.Counter(); nonref_by_gene=collections.Counter(); all_by_gene=collections.Counter(); examples={}\nfor r in it:\n if all(v is None for v in r): continue\n g=r[idx['Gene Names']]; ic=r[idx['In_CHIP']]; z=r[idx['Zygosity']]\n counts[g]+=1; inchip[(g,ic)]+=1; all_by_gene[g]+=1\n if z\"'!='\"'Reference': nonref_by_gene[g]+=1\n examples.setdefault(g,(ic,z,r[idx['Chr:Pos']],r[idx['Sequence Ontology (Combined)']]))\nprint('total rows',sum(counts.values()))\nprint('unique genes',len(counts))\nprint('in_chip values by gene?', collections.Counter(ic for _,ic in inchip))\nprint('false in_chip genes')\nfor (g,ic),n in sorted(inchip.items()):\n if ic is not True: print(g,ic,n, examples.get(g))\nprint('all counts sorted')\nfor g,n in all_by_gene.most_common(): print(g,n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
