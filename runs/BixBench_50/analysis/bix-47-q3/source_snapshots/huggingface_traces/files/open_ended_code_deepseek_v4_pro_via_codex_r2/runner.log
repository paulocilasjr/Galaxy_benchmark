{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, collections, os\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nzyg=collections.Counter(); genes=collections.defaultdict(collections.Counter)\n# target 556-PF\nfor f in files:\n    base=os.path.basename(f)\n    try:\n        wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n        ws=wb.active\n        header=None\n        for r in ws.iter_rows(values_only=True):\n            if header is None:\n                header=r\n                idx={str(h):i for i,h in enumerate(header)}\n                z=idx.get('Zygosity'); g=idx.get('Gene Names')\n                continue\n            zv=r[z] if z is not None else None\n            zyg[zv]+=1\n            gv=r[g] if g is not None else None\n            if base=='230209_Exome_GRCh38_CHIP_556-PF.xlsx':\n                genes[gv][zv]+=1\n    except Exception as e:\n        print('ERR',base,e)\nprint('unique zyg all files', zyg)\nprint('556 gene counts by zyg:')\nfor g,c in genes.items():\n    print(g, dict(c), 'nonref', sum(v for k,v in c.items() if k\"'!='\"'Reference'))\nprint('total nonref genes')\nfor g,c in genes.items():\n    s=sum(v for k,v in c.items() if k\"'!='\"'Reference')\n    if s: print(g,s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, collections, os\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nzyg=collections.Counter(); genes=collections.defaultdict(collections.Counter)\n# target 556-PF\nfor f in files:\n    base=os.path.basename(f)\n    try:\n        wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n        ws=wb.active\n        header=None\n        for r in ws.iter_rows(values_only=True):\n            if header is None:\n                header=r\n                idx={str(h):i for i,h in enumerate(header)}\n                z=idx.get('Zygosity'); g=idx.get('Gene Names')\n                continue\n            zv=r[z] if z is not None else None\n            zyg[zv]+=1\n            gv=r[g] if g is not None else None\n            if base=='230209_Exome_GRCh38_CHIP_556-PF.xlsx':\n                genes[gv][zv]+=1\n    except Exception as e:\n        print('ERR',base,e)\nprint('unique zyg all files', zyg)\nprint('556 gene counts by zyg:')\nfor g,c in genes.items():\n    print(g, dict(c), 'nonref', sum(v for k,v in c.items() if k\"'!='\"'Reference'))\nprint('total nonref genes')\nfor g,c in genes.items():\n    s=sum(v for k,v in c.items() if k\"'!='\"'Reference')\n    if s: print(g,s)\nPY\"","aggregated_output":"unique zyg all files Counter({None: 57344})\n556 gene counts by zyg:\nNone {None: 650} nonref 650\ntotal nonref genes\nNone 650\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, collections, os\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nzyg=collections.Counter(); target='230209_Exome_GRCh38_CHIP_556-PF.xlsx'; genes=collections.defaultdict(collections.Counter); rows=0\nfor f in files:\n    base=os.path.basename(f)\n    wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n    ws=wb.active\n    it=ws.iter_rows(values_only=True)\n    next(it); hdr=next(it)\n    idx={str(h):i for i,h in enumerate(hdr)}\n    # print first time\n    if base==target:\n        print('hdr',[(i,h) for i,h in enumerate(hdr)])\n    z=idx.get('Zygosity'); g=idx.get('Gene Names'); filt=idx.get('Filter')\n    for r in it:\n        if all(v is None for v in r): continue\n        zv=r[z]; gv=r[g]; fv=r[filt]\n        zyg[zv]+=1\n        if base==target:\n            genes[gv][zv]+=1; rows+=1\nprint('rows target',rows)\nprint('unique zyg all files', zyg)\nprint('556 gene counts by zyg:')\nfor g,c in genes.items():\n    print(repr(g), dict(c), 'nonref', sum(v for k,v in c.items() if k\"'!='\"'Reference'))\nprint('sorted nonref:')\narr=sorted(((sum(v for k,v in c.items() if k\"'!='\"'Reference'),g) for g,c in genes.items()), reverse=True)\nfor s,g in arr: print(g,s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
