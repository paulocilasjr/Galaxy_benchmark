         \"help_format\": \"html\",\n            \"hidden\": false,\n            \"is_dynamic\": true,\n            \"label\": \"Sort on column\",\n            \"model_class\": \"ColumnListParameter\",\n            \"multiple\": false,\n            \"name\": \"column\",\n            \"numerical\": false,\n            \"optional\": true,\n            \"options\": [\n              [\n                \"Column: 1\",\n                \"1\",\n                false\n              ],\n              [\n                \"Column: 2\",\n                \"2\",\n                false\n              ],\n              [\n                \"Column: 3\",\n                \"3\",\n                false\n              ],\n              [\n                \"Column: 4\",\n                \"4\",\n                false\n              ],\n              [\n                \"Column: 5\",\n                \"5\",\n                false\n              ],\n              [\n                \"Column: 6\",\n                \"6\",\n                false\n              ]\n            ],\n            \"refresh_on_change\": false,\n            \"text_value\": \"1\",\n            \"textable\": false,\n            \"type\": \"data_column\",\n            \"value\": \"1\"\n          },\n          {\n            \"area\": false,\n            \"argument\"\n\nPROV\n {\n  \"checked_parameter_count\": 7,\n  \"mismatches\": [\n    {\n      \"expected\": \"c5\",\n      \"path\": \"sortkeys|0|column\",\n      \"resolved\": \"1\"\n    },\n    {\n      \"expected\": \"r\",\n      \"path\": \"sortkeys|0|order\",\n      \"resolved\": \"\"\n    }\n  ],\n  \"missing_paths\": [],\n  \"status\": \"mismatch\"\n}\n","exit_code":0,"status":"completed"}}
