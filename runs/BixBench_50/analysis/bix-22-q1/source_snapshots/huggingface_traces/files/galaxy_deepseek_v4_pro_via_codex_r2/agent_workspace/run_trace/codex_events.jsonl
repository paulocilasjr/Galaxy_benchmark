{"type":"item.started","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, json\nwith open('/workspace/BatchCorrectedReadCounts_Zenodo.csv', newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n# header[0]=='' ; sample at index i corresponds to column i+1 in Galaxy 1-based (header position i+1)\n# joined c1 gene, c2.. are expression columns in same order\ncol_by_sample={}\nfor i,s in enumerate(header[1:], start=2):\n    col_by_sample[s]=i\nwith open('/workspace/Sample_annotated_Zenodo.csv', newline='') as f:\n    r=csv.DictReader(f)\n    cell_cols={k:[] for k in ['CD4','CD8','CD14','CD19']}\n    seen=set()\n    for row in r:\n        s=row['sample']; ct=row['celltype']\n        if s in seen: continue\n        seen.add(s)\n        if ct in cell_cols:\n            cell_cols[ct].append(col_by_sample[s])\nfor ct in ['CD4','CD8','CD14','CD19']:\n    cols=cell_cols[ct]\n    cols.sort()\n    print(ct, len(cols), cols[:5], cols[-5:])\n    print('list', ','.join('c'+str(x) for x in cols)[:200], '...')\n    print()\n# save lists for use maybe\nwith open('/workspace/celltype_cols.json','w') as f:\n    json.dump({k:list(map(int,v)) for k,v in cell_cols.items()}, f)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
