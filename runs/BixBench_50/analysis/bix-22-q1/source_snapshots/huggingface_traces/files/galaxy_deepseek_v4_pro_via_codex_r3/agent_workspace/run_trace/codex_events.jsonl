{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, json, collections\n# read sample annotation in original order\nsamples=[]\nwith open('/workspace/tmp/Sample_annotated_Zenodo.csv', newline='') as f:\n    r=csv.DictReader(f)\n    for row in r:\n        samples.append((row['sample'], row['celltype']))\n# counts header order from downloaded counts\nwith open('/workspace/tmp/BatchCorrectedReadCounts_Zenodo.csv', newline='') as f:\n    header=next(csv.reader(f))\n# header[1:] sample order\norder=header[1:]\n# build map\nidx_by_cell={ct:[] for ct in ['CD4','CD8','CD14','CD19']}\n# ensure each sample maps to position 1-based: header col 1 = gene; sample col j => c(j+1)\nfor j,name in enumerate(order, start=1):\n    # find celltype\n    for s,ct in samples:\n        if s==name:\n            idx_by_cell[ct].append(j+1)  # c index 1-based; j is sample index starting 1; c index = j+1\n            break\n    else:\n        raise Exception('not found '+name)\nprint({ct:len(v) for ct,v in idx_by_cell.items()})\nexprs={}\nfor ct, idxs in idx_by_cell.items():\n    terms='+'.join(f'c{i}' for i in idxs)\n    n=len(idxs)\n    expr=f'({terms})/{n}'\n    exprs[ct]=expr\n    print(ct, 'len expr', len(expr), 'first', expr[:80], 'last', expr[-40:])\njson.dump(exprs, open('/workspace/tmp/exprs.json','w'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
