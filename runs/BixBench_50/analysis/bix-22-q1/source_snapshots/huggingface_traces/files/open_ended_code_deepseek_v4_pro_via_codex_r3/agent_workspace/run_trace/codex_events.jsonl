{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math, statistics\nann={}\nwith open('inputs/Sample_annotated_Zenodo.csv',newline='') as f:\n    for d in csv.DictReader(f): ann[d['sample']]=d['celltype']\nlengths={}; pc=[]\nwith open('inputs/GeneMetaInfo_Zenodo.csv',newline='') as f:\n    for d in csv.DictReader(f):\n        if d['gene_biotype']=='protein_coding':\n            pc.append(d['Geneid']); lengths[d['Geneid']]=float(d['Length'])\nidx={g:i for i,g in enumerate(pc)}\n# initialize aggregates: raw mean, log mean per sample, maybe means\nwith open('inputs/BatchCorrectedReadCounts_Zenodo.csv',newline='') as f:\n    r=csv.reader(f); header=next(r); cols=header[1:]\n    pos={t:[] for t in ['CD4','CD8','CD14','CD19']}\n    for i,c in enumerate(cols,1):\n        t=ann[c]\n        if t in pos: pos[t].append(i)\n    n=len(pc)\n    rawsum={t:[0.0]*n for t in pos}\n    logsum={t:[0.0]*n for t in pos}\n    count={t:len(pos[t]) for t in pos}\n    for row in r:\n        g=row[0]; i=idx.get(g)\n        if i is None: continue\n        for t,ps in pos.items():\n            rs=0.0; ls=0.0\n            for p in ps:\n                v=float(row[p]); rs+=v; ls+=math.log2(v+1)\n            rawsum[t][i]=rs; logsum[t][i]=ls\nL=[lengths[g] for g in pc]\ndef pearson(a,b):\n    ma=statistics.fmean(a); mb=statistics.fmean(b)\n    return sum((x-ma)*(y-mb) for x,y in zip(a,b))/math.sqrt(sum((x-ma)**2 for x in a)*sum((y-mb)**2 for y in b))\nfor t in ['CD4','CD8','CD14','CD19']:\n    raw=[rawsum[t][i]/count[t] for i in range(n)]\n    logmean=[logsum[t][i]/count[t] for i in range(n)]\n    logL=[math.log2(x) for x in L]\n    print(t)\n    print(' len~raw',pearson(L,raw))\n    print(' len~meanlog',pearson(L,logmean))\n    print(' loglen~raw',pearson(logL,raw))\n    print(' loglen~meanlog',pearson(logL,logmean))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
