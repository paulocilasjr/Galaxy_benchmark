method=pydeseq2
pydeseq2_version=0.5.4
design=~batch + sex
contrast=sex:M_vs_F
coefficient=sex[T.M]
lfc_shrinkage=default (apeglm in PyDESeq2)
counts_input=BatchCorrectedReadCounts_Zenodo.csv
matrix_orientation=genes_by_samples transposed to samples_by_genes for PyDESeq2
samples=723
genes=59453
filter=abs(log2FoldChange)>0.5 AND baseMean>10
filtered_rows=91
FAM138A_baseMean=np.float64(0.48369793410402917)
FAM138A_log2FoldChange=np.float64(-0.06039668606673749)
FAM138A_passes_filter=False
