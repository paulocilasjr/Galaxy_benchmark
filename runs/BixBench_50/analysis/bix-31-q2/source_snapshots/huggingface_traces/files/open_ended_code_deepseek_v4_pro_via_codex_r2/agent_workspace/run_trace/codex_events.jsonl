{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport time, pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nt0=time.time()\nprint('loading...', flush=True)\ncounts=pd.read_csv('/workspace/inputs/BatchCorrectedReadCounts_Zenodo.csv', index_col=0).T\nmeta=pd.read_csv('/workspace/inputs/Sample_annotated_Zenodo.csv', index_col=0)\n# align and subset covariates\nmeta=meta.loc[counts.index].copy()\nmeta['batch']=pd.Categorical(meta['batch'])\nmeta['sex']=pd.Categorical(meta['sex'], categories=['F','M'])\nprint('counts shape', counts.shape, 'meta', meta.shape, flush=True)\nprint('design matrix factors: batch categories', meta['batch'].cat.categories.tolist(), 'sex', meta['sex'].cat.categories.tolist(), flush=True)\n\ndds=DeseqDataSet(counts=counts, metadata=meta[['batch','sex']], design='~batch+sex', n_cpus=8, quiet=False)\nprint('DDS init done', time.time()-t0, flush=True)\nprint('design columns', dds.obsm['design_matrix'].columns.tolist(), flush=True)\ndds.deseq2()\nprint('deseq2 done', time.time()-t0, flush=True)\nstats=DeseqStats(dds, contrast=['sex','M','F'], n_cpus=8, quiet=False)\nstats.summary()\nprint('summary done', time.time()-t0, flush=True)\nprint('LFC cols', stats.LFC.columns.tolist(), flush=True)\nprint('FAM138A unshrunk row', stats.results_df.loc['FAM138A'].to_dict(), flush=True)\nstats.lfc_shrink(coeff='sex[T.M]')\nprint('shrink done', time.time()-t0, flush=True)\nres=stats.results_df.copy()\nprint('FAM138A final row', res.loc['FAM138A'].to_dict(), flush=True)\nprint('columns', res.columns.tolist())\n# save relevant output to a temp parquet/csv for inspection\nres.to_csv('/workspace/tmp/de_results_categorical.csv')\nprint('saved')\nprint('filtered count absLFC>0.5 baseMean>10:', ((res['log2FoldChange'].abs()>0.5)&(res['baseMean']>10)).sum(), flush=True)\nprint('elapsed total', time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
