{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nimport pandas as pd, numpy as np\nann=pd.read_csv('/workspace/inputs/Sample_annotated_Zenodo.csv', index_col=0)\nmetadata=ann[['batch','sex']].copy()\nmetadata['batch']=pd.Categorical(metadata['batch'])\nmetadata['sex']=pd.Categorical(metadata['sex'], categories=['F','M'])\n# Make deterministic with some sex effect\nrng=np.random.default_rng(0)\nn=len(metadata)\ncounts=pd.DataFrame(rng.poisson(20, size=(n,10)), index=metadata.index, columns=[f'g{i}' for i in range(10)])\n# add effect for g0 M vs F\ncounts['g0']=rng.poisson(np.where(metadata['sex']=='M',50,10))\ndds=DeseqDataSet(counts=counts, metadata=metadata, design='~batch+sex', quiet=True)\nprint('design cols', dds.obsm['design_matrix'].columns.tolist())\nprint(dds.obsm['design_matrix'].head())\nprint('vars', dds.variables)\nprint('contrast', dds.contrast('sex','F','M').to_list())\ndds.deseq2()\nstats=DeseqStats(dds, contrast=['sex','M','F'], quiet=True)\nstats.summary()\nprint('results columns', stats.results_df.columns.tolist())\nprint('stats LFC columns', stats.LFC.columns.tolist())\nprint(stats.results_df[['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']].head())\nstats.lfc_shrink(coeff='sex[T.M]')\nprint(stats.results_df[['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']].head())\nprint('g0 row', stats.results_df.loc['g0'].to_dict())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
