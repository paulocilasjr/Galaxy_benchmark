{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np, os\np='/workspace/data_inspect/JD_AgeRelated_CpG_noMT_Final.csv'\ndf=pd.read_csv(p, dtype={'Chromosome':str})\nprint(df.shape)\nprint(df.columns.tolist())\nprint('chr dtype', df['Chromosome'].dtype)\nprint('unique chrom in data sorted?', df['Chromosome'].unique()[:30])\nprint('n unique Pos total', df['Pos'].nunique())\nprint('n unique chrom', df['Chromosome'].nunique())\nprint('rows per pos stats', df.groupby('Pos').size().describe())\nprint('methyl range', df['MethylationPercentage'].min(), df['MethylationPercentage'].max())\nprint('Dage na?', df['Dage'].isna().sum())\nprint('Pos format head', df['Pos'].head(3).tolist())\n# Determine whether a pos can map to multiple chrom\nprint('pos vs chrom mismatches', df.groupby('Pos')['Chromosome'].nunique().gt(1).sum())\n# Filter strict\nf=df[(df['MethylationPercentage']>90)|(df['MethylationPercentage']<10)]\nprint('filtered rows', len(f), 'unique pos', f['Pos'].nunique(), 'chroms', f['Chromosome'].nunique())\nlengths=pd.read_csv('/workspace/data_inspect/JD_Chromosome_Length.csv', dtype={'Chromosome':str})\nprint('length file chroms', lengths['Chromosome'].tolist())\ncounts=f.drop_duplicates('Pos').groupby('Chromosome').size()\ncounts=counts.to_frame('count')\nmerged=counts.merge(lengths, left_index=True, right_on='Chromosome', how='left')\nprint('missing length chroms', merged[merged['Length'].isna()])\nmerged['density']=merged['count']/merged['Length']\nprint(merged.head(20))\nprint('mean density', merged['density'].mean())\nprint('n chroms included', len(merged))\nprint('sum count', merged['count'].sum())\nprint('unique pos filtered expected', f['Pos'].nunique())\n# save expected maybe not final\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
