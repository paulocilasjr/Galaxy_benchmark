{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections, math\ncp='inputs/JD_AgeRelated_CpG_noMT_Final.csv'\nlenp='inputs/JD_Chromosome_Length.csv'\nlengths={}\nwith open(lenp, newline='', encoding='utf-8-sig') as f:\n    for r in csv.DictReader(f):\n        lengths[r['Chromosome']]=int(r['Length'])\nrows=[]\nwith open(cp,newline='') as f:\n    for r in csv.DictReader(f): rows.append(r)\nprint('lengths',len(lengths))\n# unique all positions count by chr\nallunique={}\nfor r in rows:\n    allunique.setdefault(r['Pos'], set()).add(r['Chromosome'])\nprint('all unique pos',len(allunique), 'chr mismatch',sum(len(v)>1 for v in allunique.values()))\nallposchr=collections.Counter(list(v)[0] for v in allunique.values())\n# filters\nfor name, pred in [\n    ('strict',lambda m:m>90 or m<10),\n    ('inclusive',lambda m:m>=90 or m<=10),\n    ('strict_lt',lambda m:m>90 or m<10),\n]:\n    unique={}\n    for r in rows:\n        m=float(r['MethylationPercentage'])\n        if pred(m):\n            unique[r['Pos']]=r['Chromosome']\n    chr_counts=collections.Counter(unique.values())\n    densities={c:n/lengths[c] for c,n in chr_counts.items() if c in lengths}\n    mean=sum(densities.values())/len(densities)\n    print('\\\\n',name,'filtered rows',sum(1 for r in rows if pred(float(r['MethylationPercentage']))),'unique filtered',len(unique))\n    print('chrs with filtered',sorted(densities, key=lambda x:int(x) if x.isdigit() else 9999))\n    print('counts', {c:chr_counts[c] for c in sorted(densities, key=lambda x:int(x) if x.isdigit() else 9999)})\n    print('densities', {c:densities[c] for c in sorted(densities, key=lambda x:int(x) if x.isdigit() else 9999)})\n    print('mean',repr(mean),'sum count',sum(chr_counts.values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
