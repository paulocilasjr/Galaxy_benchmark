{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections\np='inputs/JD_AgeRelated_CpG_noMT_Final.csv'\nrows=[]\nwith open(p, newline='') as f:\n    r=csv.DictReader(f)\n    for i,row in enumerate(r):\n        if i<20:\n            print(row)\n        rows.append(row)\nprint('n',len(rows))\ncols=set(rows[0].keys())\nprint('cols',cols)\nchrom=collections.Counter(r['Chromosome'] for r in rows)\nprint('chrom n',len(chrom), chrom)\nprint('chrom list', sorted(chrom.keys(), key=lambda x: int(x) if x.isdigit() else 9999999))\nposu=collections.Counter(r['Pos'] for r in rows)\nprint('pos unique',len(posu),'max count',max(posu.values()), [x for x in posu if posu[x]==max(posu.values())][:3])\n# duplicate positions stats\nprint('dup pos count', sum(1 for v in posu.values() if v>1))\nprint('counts summary')\ncnts=collections.Counter(posu.values())\nprint(cnts)\nmeths=[float(r['MethylationPercentage']) for r in rows]\nprint('meth min max',min(meths),max(meths))\nprint('>90',sum(m>90 for m in meths),'<10',sum(m<10 for m in meths), '>=90',sum(m>=90 for m in meths), '<=10',sum(m<=10 for m in meths))\nprint('coverage range',min(int(r['Coverage']) for r in rows),max(int(r['Coverage']) for r in rows))\nprint('Dage range',min(float(r['Dage']) for r in rows),max(float(r['Dage']) for r in rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
