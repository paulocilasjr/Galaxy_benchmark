{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections\nfn='inputs/JD_AgeRelated_CpG_noMT_Final.csv'\nlens={}\nwith open('inputs/JD_Chromosome_Length.csv',newline='',encoding='utf-8-sig') as f:\n for row in csv.DictReader(f): lens[row['Chromosome']]=int(row['Length'])\n# keep middle row then unique (if filtering out extremes)\ns=set()\nwith open(fn,newline='') as f:\n for row in csv.DictReader(f):\n  p=float(row['MethylationPercentage'])\n  if p>=10 and p<=90:\n   s.add((row['Chromosome'],row['Pos']))\nprint('middle filtered unique',len(s))\ncnt=collections.Counter(c for c,_ in s)\ndens={}\nfor c,n in cnt.items():\n L=lens[c]; dens[c]=n/L\nprint('chroms',len(dens))\nprint('mean middle', sum(dens.values())/len(dens), repr(sum(dens.values())/len(dens)))\n# middle unique if all rows in site are middle\ngroups=collections.defaultdict(list)\nwith open(fn,newline='') as f:\n for row in csv.DictReader(f):\n  groups[(row['Chromosome'],row['Pos'])].append(float(row['MethylationPercentage']))\ns2={k for k,v in groups.items() if all(p>=10 and p<=90 for p in v)}\nprint('all middle unique', len(s2))\ncnt=collections.Counter(c for c,_ in s2); dens={c:n/lens[c] for c,n in cnt.items()}\nprint('chroms2',len(dens),'mean2',sum(dens.values())/len(dens))\n# sites with mean middle (actual pipeline step)\ns3={k for k,v in groups.items() if 10<=sum(v)/len(v)<=90}\nprint('mean middle sites',len(s3))\ncnt=collections.Counter(c for c,_ in s3); dens={c:n/lens[c] for c,n in cnt.items()}\nprint('chroms3',len(dens),'mean3',sum(dens.values())/len(dens))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
