{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections, statistics, itertools\nfn='inputs/JD_AgeRelated_CpG_noMT_Final.csv'\nlens={}\nwith open('inputs/JD_Chromosome_Length.csv',newline='',encoding='utf-8-sig') as f:\n for row in csv.DictReader(f): lens[row['Chromosome']]=int(row['Length'])\nrows=list(csv.DictReader(open(fn,newline='')))\n\ndef densities(sites):\n c=collections.Counter(chrom for chrom,_ in sites)\n return {chrom:n/lens[chrom] for chrom,n in c.items()}\n\n# A filter rows then unique\nA={(r['Chromosome'],r['Pos']) for r in rows if float(r['MethylationPercentage'])>90 or float(r['MethylationPercentage'])<10}\nprint('A count',len(A),'chroms',len(densities(A)),'mean',statistics.mean(densities(A).values()))\n# B unique by Pos first occurrence, then filter\nseen=set(); B=set()\nfor r in rows:\n k=(r['Chromosome'],r['Pos'])\n if k not in seen:\n  seen.add(k)\n  if float(r['MethylationPercentage'])>90 or float(r['MethylationPercentage'])<10:\n   B.add(k)\nprint('B count',len(B),'chroms',len(densities(B)),'mean',statistics.mean(densities(B).values()))\n# C unique by Pos last occurrence\nseen={}\nfor r in rows:\n seen[(r['Chromosome'],r['Pos'])]=r\nC={k for k,r in seen.items() if float(r['MethylationPercentage'])>90 or float(r['MethylationPercentage'])<10}\nprint('C count',len(C),'chroms',len(densities(C)),'mean',statistics.mean(densities(C).values()))\n# D unique by Pos min methylation (first per site?) extremes any vs all vs mean\nG=collections.defaultdict(list)\nfor r in rows: G[(r['Chromosome'],r['Pos'])].append(float(r['MethylationPercentage']))\nfor name, pred in [\n ('any extreme',lambda v:any(p>90 or p<10 for p in v)),\n ('all extreme',lambda v:all(p>90 or p<10 for p in v)),\n ('mean extreme',lambda v:(sum(v)/len(v))>90 or (sum(v)/len(v))<10),\n ('min or max extreme?',lambda v:min(v)<10 or max(v)>90),\n ('median extreme',lambda v:statistics.median(v)>90 or statistics.median(v)<10),\n]:\n S={k for k,v in G.items() if pred(v)}\n d=densities(S)\n print(name,len(S),len(d),statistics.mean(d.values()) if d else None)\n# E filter rows by 10 < p < 90 (opposite), unique\nE={(r['Chromosome'],r['Pos']) for r in rows if float(r['MethylationPercentage'])>10 and float(r['MethylationPercentage'])<90}\nprint('E between',len(E),len(densities(E)),statistics.mean(densities(E).values()))\n# F filter rows by >=10 <=90, unique\nF={(r['Chromosome'],r['Pos']) for r in rows if 10<=float(r['MethylationPercentage'])<=90}\nprint('F between inclusive',len(F),len(densities(F)),statistics.mean(densities(F).values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
