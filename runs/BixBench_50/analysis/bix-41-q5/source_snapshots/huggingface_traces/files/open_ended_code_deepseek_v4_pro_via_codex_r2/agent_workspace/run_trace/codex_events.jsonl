{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, math, statistics\nfrom collections import defaultdict\np='/workspace/inputs/Swarm_2.csv'\nrows=[]\nwith open(p) as f:\n    for r in csv.DictReader(f):\n        r['Area']=float(r['Area']); r['Circularity']=float(r['Circularity']); r['Round']=float(r['Round'])\n        rows.append(r)\n# means\ngroups=defaultdict(lambda: {'Area':[], 'Circularity':[], 'Round':[]})\nfor r in rows:\n    key=(r['StrainNumber'],r['Ratio'])\n    groups[key]['Area'].append(r['Area']); groups[key]['Circularity'].append(r['Circularity']); groups[key]['Round'].append(r['Round'])\nfor k,v in groups.items():\n    print(k, {m:round(statistics.mean(v[m]),4) for m in ['Area','Circularity','Round']}, 'n',len(v['Area']))\nrefA=statistics.mean(groups[('1','1:0')]['Area']); refC=statistics.mean(groups[('1','1:0')]['Circularity'])\nprint('ref',refA,refC)\nallA=[r['Area'] for r in rows]; allC=[r['Circularity'] for r in rows]\nmeanA=statistics.mean(allA); sdA=statistics.stdev(allA)\nmeanC=statistics.mean(allC); sdC=statistics.stdev(allC)\nprint('stats',meanA,sdA,meanC,sdC)\nprint('\\\\nraw, z-euclidean, range-normalized, minmax per')\nfor k in sorted(groups):\n    if k[0]\"'!='\"'287_98': continue\n    a=statistics.mean(groups[k]['Area']); c=statistics.mean(groups[k]['Circularity'])\n    raw=math.hypot(a-refA,c-refC)\n    z=math.hypot((a-meanA)/sdA-(refA-meanA)/sdA,(c-meanC)/sdC-(refC-meanC)/sdC)\n    rng_a=max(allA)-min(allA); rng_c=max(allC)-min(allC)\n    rng=math.hypot((a-refA)/rng_a,(c-refC)/rng_c)\n    # log area\n    zlog=math.hypot((math.log(a)-math.log(refA))/math.log(10), (c-refC)/(max(allC)-min(allC)))\n    print(k[1], 'mean',round(a,2),round(c,4),'raw',round(raw,2),'z',round(z,4),'range',round(rng,4),'zlog-ish',round(zlog,4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
