{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np\np='/workspace/inputs/Swarm_2.csv'\ndf=pd.read_csv(p)\nprint(df.groupby(['StrainNumber','Ratio']).agg(area=('Area','mean'),circ=('Circularity','mean'),round=('Round','mean'),n=('Area','size')).round(4))\nref=df[df.StrainNumber.eq(1)][['Area','Circularity']].mean()\nprint('ref',ref.to_dict())\nmix=df[df.StrainNumber.eq('287_98')].groupby('Ratio')[['Area','Circularity']].mean()\nprint('mix\\\\n',mix)\n# distances raw\nfor norm in ['raw','z','range']:\n    if norm=='raw':\n        vals=df[['Area','Circularity']]\n        refv=ref\n        mixv=mix\n        d=(mixv-refv).pow(2).sum(axis=1)**0.5\n    elif norm=='z':\n        vals=df[['Area','Circularity']]\n        zdf=(df[['Area','Circularity']]-vals.mean())/vals.std(ddof=0)\n        zref=(ref-vals.mean())/vals.std(ddof=0)\n        zmix=(mix-vals.mean())/vals.std(ddof=0)\n        d=(zmix-zref).pow(2).sum(axis=1)**0.5\n    elif norm=='range':\n        rng=df[['Area','Circularity']].max()-df[['Area','Circularity']].min()\n        d=(((mix-ref)/rng)**2).sum(axis=1)**0.5\n    print(norm, d.idxmin(), d.min(), '\\\\n', d.round(4))\n# also distance based only mixed but scale std among all maybe same\n# log area? area widely; circularity bounded. \nprint('all mean std', df[['Area','Circularity']].mean().round(2), df[['Area','Circularity']].std().round(4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
