{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, itertools, math\n# local exploratory only, not final\np='/workspace/Swarm_2.csv'\ndf=pd.read_csv(p)\nref=df[df.StrainNumber==1][['Area','Circularity']].mean()\nprint('ref',ref)\ngroups=df[df.StrainNumber=='287_98'].groupby('Ratio')[['Area','Circularity']].mean()\nprint(groups)\n# metrics\nfor name, func in [\n ('euclid raw', lambda r: math.sqrt((r.Area-ref.Area)**2+(r.Circularity-ref.Circularity)**2)),\n ('euclid scaled by ref', lambda r: math.sqrt(((r.Area-ref.Area)/ref.Area)**2+((r.Circularity-ref.Circularity)/ref.Circularity)**2)),\n ('rel abs sum', lambda r: abs((r.Area-ref.Area)/ref.Area)+abs((r.Circularity-ref.Circularity)/ref.Circularity)),\n ('abs scaled by sd', lambda r: math.sqrt(((r.Area-ref.Area)/groups.Area.std())**2+((r.Circularity-ref.Circularity)/groups.Circularity.std())**2)),\n]:\n    vals={k:func(r) for k,r in groups.iterrows()}\n    print(name, sorted(vals.items(), key=lambda x:x[1])[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
