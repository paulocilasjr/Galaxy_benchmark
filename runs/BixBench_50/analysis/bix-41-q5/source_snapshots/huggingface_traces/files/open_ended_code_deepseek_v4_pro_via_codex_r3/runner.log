{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, math, statistics\np='/workspace/inputs/Swarm_2.csv'\nrows=list(csv.DictReader(open(p)))\nfor r in rows:\n    r['Area']=float(r['Area']); r['Circularity']=float(r['Circularity'])\ngroups={}\nfor r in rows:\n    key=(r['StrainNumber'],r['Ratio'])\n    groups.setdefault(key,[]).append(r)\nmeans={k:(statistics.mean(x['Area'] for x in v), statistics.mean(x['Circularity'] for x in v)) for k,v in groups.items()}\nref=means[('1','1:0')]\nprint('ref',ref)\nfor k,v in means.items():\n    if k[0]=='287_98':\n        print(k[1], v, 'diff',v[0]-ref[0], v[1]-ref[1], 'raw', math.dist(v,ref))\n# all group means\nallkeys=list(means)\nallarr=[means[k] for k in allkeys]\n# range norm over all group means\nmins=[min(x[i] for x in allarr) for i in range(2)]\nmaxs=[max(x[i] for x in allarr) for i in range(2)]\nrng=[maxs[i]-mins[i] for i in range(2)]\nnorm={k: tuple((means[k][i]-mins[i])/rng[i] for i in range(2)) for k in allkeys}\nrefn=norm[('1','1:0')]\nprint('\\\\nrange norm distances')\nfor k in allkeys:\n    if k[0]=='287_98':\n        print(k[1],norm[k], math.dist(norm[k],refn))\n# z-score over group means\nmu=[statistics.mean([x[i] for x in allarr]) for i in range(2)]\nsd=[statistics.pstdev([x[i] for x in allarr]) for i in range(2)]\nprint('mu sd',mu,sd)\nzs={k: tuple((means[k][i]-mu[i])/sd[i] for i in range(2)) for k in allkeys}\nrefz=zs[('1','1:0')]\nprint('\\\\nz distances')\nfor k in allkeys:\n    if k[0]=='287_98':\n        print(k[1],zs[k], math.dist(zs[k],refz))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
