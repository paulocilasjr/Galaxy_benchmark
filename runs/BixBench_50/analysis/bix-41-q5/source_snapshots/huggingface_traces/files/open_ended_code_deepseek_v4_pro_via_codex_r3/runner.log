{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom math import dist\np='/workspace/inputs/Swarm_2.csv'\ndf=pd.read_csv(p)\nprint(df.groupby(['StrainNumber','Ratio'])[['Area','Circularity']].agg(['mean','std','count']))\nref=df[(df.StrainNumber==1)].mean(numeric_only=True)\nprint('ref', ref)\nmixed=df[df.StrainNumber=='287_98']\ngroups=mixed.groupby('Ratio')[['Area','Circularity']].mean()\nprint('groups')\nprint(groups)\n# raw Euclidean distances\nfor r,g in groups.iterrows():\n    print(r, 'area diff',g.Area-ref.Area,'circ diff',g.Circularity-ref.Circularity,'raw',np.sqrt((g.Area-ref.Area)**2+(g.Circularity-ref.Circularity)**2))\n# normalize by range across mixed or all groups\nallg=df.groupby(['StrainNumber','Ratio'])[['Area','Circularity']].mean()\nrng=allg.max()-allg.min(); print('range all', rng)\nnorm=(allg-allg.min())/rng\nrefn=norm.loc[(1,'1:0')]\nfor idx,g in norm.loc['287_98'].iterrows():\n    print('normall',idx,'d',np.sqrt(((g-refn)**2).sum()), 'coords',g.to_dict())\n# z-score using group means std\nzs=(allg-allg.mean())/allg.std()\nrefz=zs.loc[(1,'1:0')]\nfor idx,g in zs.loc['287_98'].iterrows():\n    print('z',idx,'d',np.sqrt(((g-refz)**2).sum()), 'coords',g.to_dict())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
