{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, math, statistics\nrows=[]\nfor r in csv.DictReader(open('/workspace/inputs/Swarm_2.csv')):\n    r['Area']=float(r['Area']); r['Circularity']=float(r['Circularity']); rows.append(r)\nref=[r for r in rows if r['StrainNumber']=='1']\nmu=[statistics.mean(r[x] for r in ref) for x in ['Area','Circularity']]\nsd=[statistics.pstdev(r[x] for r in ref) for x in ['Area','Circularity']]\nprint('ref mean sd',mu,sd)\n# each mixed group mean standardized by ref sd\ngroups={}\nfor r in rows:\n    if r['StrainNumber']=='287_98':\n        groups.setdefault(r['Ratio'],[]).append(r)\nfor ratio,rs in sorted(groups.items(), key=lambda kv: float(kv[0].split(':')[0])/float(kv[0].split(':')[1])):\n    gm=[statistics.mean(r[x] for r in rs) for x in ['Area','Circularity']]\n    d=math.dist([(gm[i]-mu[i])/sd[i] for i in range(2)],[0,0])\n    print(ratio,gm,'z',[(gm[i]-mu[i])/sd[i] for i in range(2)],'d',d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
