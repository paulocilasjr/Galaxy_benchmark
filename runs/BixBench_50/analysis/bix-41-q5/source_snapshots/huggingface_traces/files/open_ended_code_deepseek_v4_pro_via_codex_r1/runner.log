{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, math, statistics\nrows=list(csv.DictReader(open('/workspace/inputs/Swarm_2.csv')))\ndata=[(r['StrainNumber'],r['Ratio'],float(r['Area']),float(r['Circularity'])) for r in rows]\ns1=[(a,c) for sn,ratio,a,c in data if sn=='1']\nsm=[(a,c) for sn,ratio,a,c in data if sn=='287_98']\nratios=[]\nfor sn,ratio,a,c in data:\n    if sn=='287_98' and ratio not in ratios: ratios.append(ratio)\n# preserve order\nratios=sorted(set(ratio for sn,ratio,a,c in data if sn=='287_98'), key=lambda x: int(x.split(':')[0]) if ':' in x else 0)\nprint(ratios)\ndef mean(vals): return tuple(sum(x)/len(x) for x in zip(*vals))\nms1=mean(s1); print('s1',ms1)\ngroups={r:mean([(a,c) for sn,rr,a,c in data if sn=='287_98' and rr==r]) for r in ratios}\nfor r,m in groups.items(): print(r,m)\n# distances\ndef eu(a,b,w): return math.sqrt(sum(w[i]*(a[i]-b[i])**2 for i in range(2)))\nprint('\\\\nraw')\nfor r,m in groups.items(): print(r, eu(ms1,m,[1,1]))\n# zscore on group means (all ratio groups including s1? define each mixed ratio and strain1)\n# all groups: strain 1 + each mixed ratio.  Also pure 98 and 287 perhaps not relevant.\nall_means={'1':ms1, **groups}\n# function z over group means\nfor scope_name, groups_dict in [\n ('mixed+s1', all_means),\n ('mixedonly', groups),\n]:\n    vals=list(groups_dict.values())\n    mu=tuple(sum(v[i] for v in vals)/len(vals) for i in range(2))\n    sd=tuple(math.sqrt(sum((v[i]-mu[i])**2 for v in vals)/len(vals)) for i in range(2))\n    print('\\\\n',scope_name,'mu sd',mu,sd)\n    for r,m in groups.items():\n        z1=[(ms1[i]-mu[i])/sd[i] for i in range(2)]\n        zr=[(m[i]-mu[i])/sd[i] for i in range(2)]\n        print(r, math.sqrt(sum((z1[i]-zr[i])**2 for i in range(2))), zr)\n# zscore individual observations scope mixed only\nobs=[v for k,v in groups.items() for _ in range(3)] # actually means no.\nobs_mixed=[(a,c) for sn,ratio,a,c in data if sn=='287_98']\nobs_all=[(a,c) for sn,ratio,a,c in data if sn=='287_98' or sn=='1']\nfor scope,obs in [('mixedobs',obs_mixed),('allobs',obs_all)]:\n    n=len(obs); mu=tuple(sum(x[i] for x in obs)/n for i in range(2)); sd=tuple(math.sqrt(sum((x[i]-mu[i])**2 for x in obs)/n) for i in range(2))\n    print('\\\\n',scope,'mu sd',mu,sd)\n    ds=[]\n    for r,m in groups.items():\n        z1=[(ms1[i]-mu[i])/sd[i] for i in range(2)]; zr=[(m[i]-mu[i])/sd[i] for i in range(2)]\n        ds.append((math.sqrt(sum((z1[i]-zr[i])**2 for i in range(2))),r,zr))\n    for d in sorted(ds): print(d)\n# minmax observations\nfor scope,obs in [('mixedobs',obs_mixed),('allobs',obs_all)]:\n    mn=tuple(min(x[i] for x in obs) for i in range(2)); mx=tuple(max(x[i] for x in obs) for i in range(2))\n    print('\\\\nminmax',scope,mn,mx)\n    ds=[]\n    for r,m in groups.items():\n        norm1=[(ms1[i]-mn[i])/(mx[i]-mn[i]) for i in range(2)]; normr=[(m[i]-mn[i])/(mx[i]-mn[i]) for i in range(2)]\n        ds.append((math.sqrt(sum((norm1[i]-normr[i])**2 for i in range(2))),r,normr))\n    for d in sorted(ds): print(d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
