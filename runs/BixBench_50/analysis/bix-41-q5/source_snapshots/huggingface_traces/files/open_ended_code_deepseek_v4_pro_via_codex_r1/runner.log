n data if sn=='287_98']\nobs_all=[(a,c) for sn,ratio,a,c in data if sn=='287_98' or sn=='1']\nfor scope,obs in [('mixedobs',obs_mixed),('allobs',obs_all)]:\n    n=len(obs); mu=tuple(sum(x[i] for x in obs)/n for i in range(2)); sd=tuple(math.sqrt(sum((x[i]-mu[i])**2 for x in obs)/n) for i in range(2))\n    print('\\\\n',scope,'mu sd',mu,sd)\n    ds=[]\n    for r,m in groups.items():\n        z1=[(ms1[i]-mu[i])/sd[i] for i in range(2)]; zr=[(m[i]-mu[i])/sd[i] for i in range(2)]\n        ds.append((math.sqrt(sum((z1[i]-zr[i])**2 for i in range(2))),r,zr))\n    for d in sorted(ds): print(d)\n# minmax observations\nfor scope,obs in [('mixedobs',obs_mixed),('allobs',obs_all)]:\n    mn=tuple(min(x[i] for x in obs) for i in range(2)); mx=tuple(max(x[i] for x in obs) for i in range(2))\n    print('\\\\nminmax',scope,mn,mx)\n    ds=[]\n    for r,m in groups.items():\n        norm1=[(ms1[i]-mn[i])/(mx[i]-mn[i]) for i in range(2)]; normr=[(m[i]-mn[i])/(mx[i]-mn[i]) for i in range(2)]\n        ds.append((math.sqrt(sum((norm1[i]-normr[i])**2 for i in range(2))),r,normr))\n    for d in sorted(ds): print(d)\nPY\"","aggregated_output":"['1:2', '1:3', '1:1', '2:1', '3:1', '4:1', '5:1', '10:1', '50:1', '100:1', '500:1', '1000:1']\ns1 (111959.66666666667, 0.06133333333333333)\n1:2 (26811.333333333332, 0.389)\n1:3 (18760.666666666668, 0.607)\n1:1 (43223.666666666664, 0.19699999999999998)\n2:1 (87056.66666666667, 0.09633333333333334)\n3:1 (89125.33333333333, 0.08566666666666667)\n4:1 (152298.0, 0.055)\n5:1 (118086.33333333333, 0.06666666666666667)\n10:1 (184367.33333333334, 0.042333333333333334)\n50:1 (93919.0, 0.09500000000000001)\n100:1 (74453.66666666667, 0.11133333333333333)\n500:1 (10046.333333333334, 0.8186666666666667)\n1000:1 (45435.333333333336, 0.30233333333333334)\n\nraw\n1:2 85148.3333339638\n1:3 93199.00000159741\n1:1 68736.00000013389\n2:1 24903.000000024596\n3:1 22834.33333334631\n4:1 40338.33333333382\n5:1 6126.666666668979\n10:1 72407.66666666916\n50:1 18040.666666698085