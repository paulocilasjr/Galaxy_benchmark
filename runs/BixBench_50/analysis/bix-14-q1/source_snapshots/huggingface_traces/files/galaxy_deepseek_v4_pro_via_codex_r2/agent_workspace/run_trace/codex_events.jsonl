{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, os, re, json\nfrom bioblend.galaxy import GalaxyInstance\n# parse trio\nwb=openpyxl.load_workbook('tmp/inspect/trio_status.xlsx', data_only=True)\nws=wb.active\nrows=[]\nfor r in range(2,ws.max_row+1):\n    sid=ws.cell(r,1).value\n    if sid is None: continue\n    sid=str(sid).strip().rstrip('\\\\t')\n    status=ws.cell(r,2).value\n    blm=ws.cell(r,4).value\n    rows.append((sid,status,blm))\nprint('total rows',len(rows))\ncarriers=[r for r in rows if r[2]=='Carrier']\nprint('carriers',len(carriers))\nprint(carriers)\n# match dataset names\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5ffb60f585c6c7d7c'\ncontents=gi.histories.show_history(hid, contents=True)\nname_to_did={d['name']:d['id'] for d in contents}\nprint('datasets',len(name_to_did))\nmatched=[]\nfor sid,status,blm in carriers:\n    # possible suffix -P1,-P,-PM,-PF depending status; father/mother maps PF/PM from status\n    suffix = {'Father':'PF','Mother':'PM'}.get(status)\n    fname=f'230209_Exome_GRCh38_CHIP_{sid}-{suffix}.xlsx'\n    did=name_to_did.get(fname)\n    matched.append((sid,status,blm,fname,did))\nprint('matched')\nfor m in matched: print(m)\nprint('missing', [m for m in matched if not m[4]])\nprint('unmatched carriers count', sum(m[4] is None for m in matched))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
