{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, json, time, openpyxl\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5ffb60f585c6c7d7c'\n# determine carriers and dataset ids\nwb=openpyxl.load_workbook('tmp/inspect/trio_status.xlsx', data_only=True)\nws=wb.active\ncarriers=[]\nfor r in range(2, ws.max_row+1):\n    sid=(ws.cell(r,1).value or '')\n    sid=str(sid).strip().rstrip('\\\\t')\n    status=ws.cell(r,2).value\n    blm=ws.cell(r,4).value\n    if blm=='Carrier':\n        carriers.append((sid, status))\ncontents=gi.histories.show_history(hid, contents=True)\nname_to_id={d['name']:d['id'] for d in contents}\npairs=[]\nfor sid,status in carriers:\n    suf={'Father':'PF','Mother':'PM'}.get(status)\n    fname=f'230209_Exome_GRCh38_CHIP_{sid}-{suf}.xlsx'\n    did=name_to_id.get(fname)\n    if did:\n        pairs.append((sid,status,fname,did))\nprint('pairs',len(pairs))\n# submit all xlsx2tsv blank\ntool='toolshed.g2.bx.psu.edu/repos/ufz/xlsx2tsv/xlsx2tsv/0.2.0+galaxy0'\njob_pairs=[]\nfor i,(sid,status,fname,did) in enumerate(pairs):\n    try:\n        res=gi.tools.run_tool(history_id=hid, tool_id=tool, tool_inputs={'input_file':{'src':'hda','id':did}}, input_format='legacy')\n        jobid=res['jobs'][0]['id']\n        job_pairs.append((sid,status,fname,did,jobid))\n        print('submitted',i,sid,jobid)\n    except Exception as e:\n        print('submit error',sid,e)\n# save state\nwith open('tmp/xlsx_jobs.json','w') as f:\n    json.dump(job_pairs,f)\nprint('submitted',len(job_pairs))\n# poll all\npending=list(range(len(job_pairs)))\nresults=[]\nstart=time.time()\nwhile pending and time.time()-start<600:\n    still=[]\n    for idx in pending:\n        sid,status,fname,did,jobid=job_pairs[idx]\n        j=gi.jobs.show_job(jobid, full_details=True)\n        state=j['state']\n        if state in ['ok','error','failed','deleted','paused','stopped']:\n            if state=='ok':\n                outs=j.get('outputs',{})\n                if not outs:\n                    print('NO OUTPUTS',idx,sid,j.get('output_collections'))\n                hda_id=next(iter(outs.values()))['id'] if outs else None\n                results.append((idx,sid,status,fname,did,jobid,state,hda_id))\n            else:\n                print('FAILED',idx,sid,state,j.get('job_messages'),j.get('stderr'))\n                results.append((idx,sid,status,fname,did,jobid,state,None))\n        else:\n            still.append(idx)\n    pending=still\n    if pending:\n        print('pending',len(pending),'elapsed',int(time.time()-start))\n        time.sleep(5)\nprint('done pending',len(pending))\nwith open('tmp/xlsx_results.json','w') as f:\n    json.dump(results,f)\nprint('results count',len(results))\nfor r in results:\n    print(r[:7], r[7])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
