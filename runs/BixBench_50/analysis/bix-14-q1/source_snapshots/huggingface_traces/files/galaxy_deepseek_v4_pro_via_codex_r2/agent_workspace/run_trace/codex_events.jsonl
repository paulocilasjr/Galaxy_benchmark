{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, zipfile, re, json\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5ffb60f585c6c7d7c'\n# match carriers local\nimport openpyxl\nwb=openpyxl.load_workbook('tmp/inspect/trio_status.xlsx', data_only=True); ws=wb.active\ncar=[]\nfor r in range(2,ws.max_row+1):\n sid=str(ws.cell(r,1).value or '').strip().rstrip('\\\\t'); status=ws.cell(r,2).value; blm=ws.cell(r,4).value\n if blm=='Carrier': car.append((sid,{'Father':'PF','Mother':'PM'}.get(status)))\ncontents=gi.histories.show_history(hid, contents=True); name_to_id={d['name']:d['id'] for d in contents}\nmatched=[]\nfor sid,suf in car:\n fname=f'230209_Exome_GRCh38_CHIP_{sid}-{suf}.xlsx'; did=name_to_id.get(fname)\n if did: matched.append((fname,did))\nprint('matched files',len(matched))\n# Download each to tmp/xlsx inspect sheet names and first row col count maybe quick\nos.makedirs('tmp/inspect/xlsx', exist_ok=True)\nfor idx,(fname,did) in enumerate(matched):\n p=f'tmp/inspect/xlsx/{idx}.xlsx'\n gi.datasets.download_dataset(did, file_path=p, use_default_filename=False, maxwait=120)\n z=zipfile.ZipFile(p)\n wbxml=z.read('xl/workbook.xml').decode('utf-8')\n sheetnames=re.findall(r'<sheet [\"'^>]*name=\"([''^\"]*)\"'\"',wbxml)\n # quick count rows/cells from sheet xml\n rel=z.read('xl/_rels/workbook.xml.rels').decode('utf-8')\n sheet_targets=re.findall(r'Target=\\\"([\"'^\"]*)\"'\"',rel)\n print(idx, os.path.basename(fname), 'sheets',sheetnames,'size',os.path.getsize(p))\n if len(sheetnames)\"'!=1:\n  print('\"'MULTI\"'!'\"',sheetnames)\n # parse first sheet rows/cells\n if sheet_targets:\n  target=sheet_targets[0]\n  # target may be worksheets/sheet1.xml, normalize\n  if not target.startswith('xl/'): target='xl/'+target.lstrip('/')\n  sxml=z.read(target).decode('ut