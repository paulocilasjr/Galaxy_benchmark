{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, os, time\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nhid='bbd44e69cb8906b5ffb60f585c6c7d7c'\nresults=json.load(open('tmp/xlsx_results.json'))\n# results entries: idx,sid,status,fname,did,jobid,state,hda_id\njobs=[]\nfor r in results:\n    if r[6]\"'!='\"'ok' or not r[7]: continue\n    res=gi.tools.run_tool(history_id=hid, tool_id='Remove beginning1', tool_inputs={'input':{'src':'hda','id':r[7]},'num_lines':2}, input_format='legacy')\n    jobid=res['jobs'][0]['id']\n    outid=res['outputs'][0]['id']\n    jobs.append({'idx':r[0],'sid':r[1],'xlsx_job':r[5],'tsv':r[7],'rm_job':jobid,'rm_hda':outid})\n    print('submitted rm',r[1],jobid)\njson.dump(jobs,open('tmp/rm_jobs.json','w'))\n# poll\npending=list(range(len(jobs))); final=[]\nstart=time.time()\nwhile pending and time.time()-start<600:\n    still=[]\n    for i in pending:\n        j=gi.jobs.show_job(jobs[i]['rm_job'], full_details=True)\n        st=j['state']\n        if st in ['ok','error','failed','deleted','paused']:\n            if st=='ok':\n                outs=j.get('outputs',{})\n                oid=outs.get('out_file1',{}).get('id')\n                jobs[i]['rm_hda']=oid or jobs[i]['rm_hda']\n                final.append(jobs[i])\n            else:\n                print('rm failed',jobs[i]['sid'],st,j.get('job_messages'),j.get('stderr'))\n        else:\n            still.append(i)\n    pending=still\n    if pending:\n        print('rm pending',len(pending),'elapsed',int(time.time()-start))\n        time.sleep(3)\nprint('final rm',len(final))\njson.dump(final,open('tmp/rm_final.json','w'))\nfor x in final: print(x['sid'],x['rm_hda'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
