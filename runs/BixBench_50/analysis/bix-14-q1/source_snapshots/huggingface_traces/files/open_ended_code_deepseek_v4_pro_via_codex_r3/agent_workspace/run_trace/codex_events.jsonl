{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, os, re, collections, math\n# carriers with files\ncarrier_ids=['185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614']\n# 533 missing; include perhaps not\n# build filename map\ndef sid(fn):\n b=os.path.basename(fn)\n m=re.search(r'CHIP_(\\\\d+)-',b)\n return m.group(1) if m else None\nallrows=[]\nfor f in sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')):\n sid=sid(f)\n if sid not in carrier_ids: continue\n wb=openpyxl.load_workbook(f,data_only=True)\n ws=wb[wb.sheetnames[0]]\n rows=list(ws.iter_rows(values_only=True))\n wb.close()\n for r in rows[2:]:\n  allrows.append((sid,r))\nprint('carrier files',len(set(s for s,r in allrows)),'rows',len(allrows))\n# col indices\ncols=['ChrPos','RefAlt','Primary','Incidental','Zygosity','Mendel','Inherited','DP','GQ','VAF','ACMG','Match','Gene','SO','Effect','Transcript','Exon','HGVSc','HGVSp','Filter','AltAF','AltAC','AN','Hom','VariantID','Classification','Aggregate','Review','Conditions','In_CHIP','Match','In_DNAm','Match2']\nfor s,r in allrows:\n r=list(r)+[None]*(33-len(r))\n if len(r)\"'!=33: print('\"'bad',s,len(r))\n# counts\ncnt=collections.Counter(r[13] for s,r in allrows)\neff=collections.Counter(r[14] for s,r in allrows)\nzyg=collections.Counter(r[4] for s,r in allrows)\nprim=collections.Counter(r[2] for s,r in allrows)\ninc=collections.Counter(r[3] for s,r in allrows)\nprint('SO')\nfor k,v in cnt.most_common(): print(repr(k),v)\nprint('Effect')\nfor k,v in eff.most_common(): print(repr(k),v)\nprint('Zyg')\nfor k,v in zyg.most_common(): print(repr(k),v)\nprint('Primary')\nfor k,v in prim.most_common(): print(repr(k),v)\nprint('Incidental')\nfor k,v in inc.most_common(): print(repr(k),v)\n# count nonreference with VAF\nnonref=[r for s,r in allrows if r[4] not in (None,'Reference')]\nprint('nonref',le