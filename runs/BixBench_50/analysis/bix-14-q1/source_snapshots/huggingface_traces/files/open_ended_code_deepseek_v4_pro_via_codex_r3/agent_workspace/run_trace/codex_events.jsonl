{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport glob, os, re, openpyxl\n# BLM mutation carriers with available variant files\ncarrier_ids = {\n    '185','184','285','287','353','354','556','557','381','396','397',\n    '489','490','499','500','503','504','613','614'\n}\n# 533 is a carrier in Trio_Status but has no provided variant file.\ncoding_so = {\n    'synonymous_variant','missense_variant','splice_region_variant',\n    'stop_gained','stop_lost','start_lost','frameshift_variant',\n    'inframe_insertion','inframe_deletion'\n}\n\ndef sample_id(path):\n    base = os.path.basename(path)\n    m = re.search(r'CHIP_(\\\\d+)-', base)\n    return m.group(1) if m else None\n\ndenominator = 0\nsynonymous = 0\nfor path in sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')):\n    sid = sample_id(path)\n    if sid not in carrier_ids:\n        continue\n    wb = openpyxl.load_workbook(path, data_only=True)\n    ws = wb[wb.sheetnames[0]]\n    rows = list(ws.iter_rows(values_only=True))\n    wb.close()\n    # Rows before the data: row 1 is the merged table title, row 2 is column headers.\n    for row in rows[2:]:\n        so = row[13]\n        if so not in coding_so:\n            continue\n        try:\n            vaf = float(row[9])\n        except (TypeError, ValueError):\n            continue\n        if vaf < 0.3:\n            denominator += 1\n            if so == 'synonymous_variant':\n                synonymous += 1\n\nfraction = synonymous / denominator\nprint(f'carrier files: {len(carrier_ids)}')\nprint(f'coding variants with VAF < 0.3: {denominator}')\nprint(f'synonymous among those: {synonymous}')\nprint(f'fraction: {fraction\"'!r}'\"')\nopen('codex_output/answer.txt','w').write(f'{fraction}\\\\n')\nPY\ncat codex_output/answer.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
