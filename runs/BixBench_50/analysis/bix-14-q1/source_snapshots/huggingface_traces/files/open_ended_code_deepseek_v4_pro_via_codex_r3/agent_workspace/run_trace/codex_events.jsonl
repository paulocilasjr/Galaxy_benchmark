{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, os, re, collections\ncarrier_ids={'185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614'}\ndef sample_id(fn):\n b=os.path.basename(fn); m=re.search(r'CHIP_(\\\\d+)-',b); return m.group(1) if m else None\nCODING={'synonymous_variant','missense_variant','splice_region_variant','stop_gained','stop_lost','start_lost','frameshift_variant','inframe_insertion','inframe_deletion'}\nobservations=[]\nunique_coding=set(); unique_syn=set(); unique_all_vaf=set()\nfor f in sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')):\n sid=sample_id(f)\n if sid not in carrier_ids: continue\n wb=openpyxl.load_workbook(f,data_only=True); ws=wb[wb.sheetnames[0]]; data=list(ws.iter_rows(values_only=True)); wb.close()\n for r in data[2:]:\n  try: v=float(r[9])\n  except: continue\n  if v < 0.3:\n   key=(r[0],r[1],r[13]) # variant + SO (SO fixed per variant)\n   keyvar=(r[0],r[1])\n   observations.append((sid,r))\n   if r[13] in CODING:\n    unique_coding.add(keyvar)\n    if r[13]=='synonymous_variant': unique_syn.add(keyvar)\n# aggregate\nn=len([x for x in observations if x[1][13] in CODING]); syn=sum(1 for x in observations if x[1][13] in CODING and x[1][13]=='synonymous_variant')\nprint('aggregated coding denom',n,'syn',syn,'frac',syn/n)\nprint('unique coding variants with any carrier vaf<.3',len(unique_coding),'unique syn',len(unique_syn),'frac',len(unique_syn)/len(unique_coding) if unique_coding else None)\n# also unique variants counting only all carrier samples? okay\n# unique all VAF<.3 (naive) and syn\nunique_all=set((x[1][0],x[1][1]) for x in observations)\nprint('unique all vaf<.3 variants',len(unique_all))\n# counts by variant if same variant appears in multiple files\ncnt=collections.Counter((x[1][0],x[1][1],x[1][13]) for x in observations if x[1][13] in CODING)\nprint('top repeated coding variants',cnt.most_common(10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
