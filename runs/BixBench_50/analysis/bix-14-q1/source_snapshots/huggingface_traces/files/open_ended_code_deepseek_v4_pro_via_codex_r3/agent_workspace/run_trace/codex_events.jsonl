{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, os, re, collections\nfiles=sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\n# choose a carrier\nf='inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_184-PM.xlsx'\nwb=openpyxl.load_workbook(f, data_only=True)\nws=wb[wb.sheetnames[0]]\nrows=list(ws.iter_rows(values_only=True))\nwb.close()\nprint('rows',len(rows))\nheaders=rows[1]\nfor i,h in enumerate(headers): print(i,h)\n# SO col index 13, Effect 14\ncnt=collections.Counter()\ncnt_eff=collections.Counter()\ncnt_zyg=collections.Counter()\nfor r in rows[2:]:\n so=r[13]; eff=r[14]; zy=r[4]; vaf=r[9]\n cnt[so]+=1; cnt_eff[eff]+=1; cnt_zyg[zy]+=1\nprint('SO')\nfor k,v in cnt.items(): print(repr(k),v)\nprint('EFFECT')\nfor k,v in cnt_eff.items(): print(repr(k),v)\nprint('ZYG')\nfor k,v in cnt_zyg.items(): print(repr(k),v)\n# VAF types for nonref\ncntv=collections.Counter()\nfor r in rows[2:]:\n if r[4]\"'!='\"'Reference':\n  v=r[9]\n  cntv[(type(v).__name__,v)]+=1\nprint('VAF nonref top',cntv.most_common(20))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
