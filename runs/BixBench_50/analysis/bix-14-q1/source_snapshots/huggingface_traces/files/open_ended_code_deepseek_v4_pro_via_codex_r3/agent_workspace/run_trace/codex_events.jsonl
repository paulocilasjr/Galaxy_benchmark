{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport openpyxl, glob, os, re\n# parse trio\nwb=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True)\nws=wb['Sheet1']\nrows=list(ws.iter_rows(min_row=2,values_only=True))\nwb.close()\ncarriers=[]\nfor r in rows:\n sid,status,sex,blm,age,cancer,_=r\n if blm=='Carrier':\n  carriers.append((str(sid).strip(), status, sex))\nprint('carriers',len(carriers))\nfor c in carriers: print(c)\n# map files\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nprint('files',len(files))\ndef sample_from_fn(fn):\n b=os.path.basename(fn)\n m=re.search(r'CHIP_(\\\\d+)-', b)\n if m: return m.group(1)\n m=re.search(r'CHIP_(SRR\\\\d+)', b)\n if m: return m.group(1)\n return b\nfor c in carriers:\n sid=c[0]\n matches=[f for f in files if sample_from_fn(f)==sid]\n print(c, matches)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
