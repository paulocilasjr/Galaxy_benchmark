{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os, collections\ncarrier_ids={'185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614'}\nrows=[]; headers=None\nfor f in glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n m=re.match(r'230209_Exome_GRCh38_CHIP_(\\\\d+)-',os.path.basename(f))\n if not m or m.group(1) not in carrier_ids: continue\n ws=openpyxl.load_workbook(f,data_only=True).active\n vals=list(ws.iter_rows(min_row=2,values_only=True))\n if headers is None: headers=vals[0]\n rows.extend(vals[1:])\nprint(len(rows), len(headers))\ndef vafnum(v):\n try:\n  return float(v)\n except: return None\n# count all rows with VAF not none, coding etc\nvaf_rows=[r for r in rows if vafnum(r[9]) is not None]\nprint('vaf non-none',len(vaf_rows))\n# sequence ontology counts for vaf rows\nc=collections.Counter(r[13] for r in vaf_rows)\nfor k,n in c.most_common(): print('SO vaf',repr(k),n)\nprint('\\\\nbelow .3')\nlow=[r for r in rows if vafnum(r[9]) is not None and vafnum(r[9])<0.3]\nprint('low count',len(low))\nc=collections.Counter(r[13] for r in low)\nfor k,n in c.most_common(): print('SO low',repr(k),n)\n# possible coding definitions\ncoding_terms={'synonymous_variant','missense_variant','inframe_insertion','frameshift_variant','inframe_deletion','splice_region_variant'}\nfor name, terms in [('coding_basic',{'synonymous_variant','missense_variant','inframe_insertion','frameshift_variant','inframe_deletion'}),\n                    ('coding_plus_splice',coding_terms),\n                    ('coding_all_nonutr_nonintron',set(c.keys())-{'intron_variant','3_prime_UTR_variant','5_prime_UTR_variant','upstream_gene_variant','5_prime_UTR_premature_start_codon_gain_variant'})]:\n total=sum(1 for r in low if r[13] in terms)\n syn=sum(1 for r in low if r[13]=='synonymous_variant')\n print(name,total,syn, syn/total if total else None)\n# effect combined counts low\nc=collections.Counter(r[14] for r in low)\nprint('Effect low',c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
