{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os\n# parse trio\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(values_only=True))\nheaders=rows[0]\nprint(headers)\ndata=[]\nfor r in rows[1:]:\n    sid=str(r[0]).strip() if r[0] is not None else ''\n    # strip tabs\n    sid=sid.replace('\\\\t','').strip()\n    data.append((sid,r[1],r[3]))\n# carriers where BLM Mutation Status == Carrier\ncarriers=[r for r in data if r[2]=='Carrier']\nprint('carriers', len(carriers))\nfor c in carriers: print(c)\n# files\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\ndef sample_from_name(fn):\n    base=os.path.basename(fn).replace('230209_Exome_GRCh38_CHIP_','').replace('.xlsx','')\n    return base\nfor f in sorted(files):\n    s=sample_from_name(f)\n    if s in [str(c[0]) for c in carriers]:\n        print('carrier file',s, os.path.basename(f))\nprint('all numeric file samples')\nfor f in sorted(files):\n    s=sample_from_name(f)\n    if re.match(r'\"'^'\"\\\\d+',s):\n        print(s, os.path.basename(f))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
