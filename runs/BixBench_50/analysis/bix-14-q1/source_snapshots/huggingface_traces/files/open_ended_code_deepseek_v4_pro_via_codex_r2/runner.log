{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os, collections, math\ncarrier_ids={'185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614'}\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\n# load headers/rows for carrier files\nall_rows=[]\nheaders=None\nfor f in files:\n    base=os.path.basename(f)\n    m=re.match(r'230209_Exome_GRCh38_CHIP_(\\\\d+)-',base)\n    if not m or m.group(1) not in carrier_ids: continue\n    wb=openpyxl.load_workbook(f, data_only=True)\n    ws=wb.active\n    rows=ws.iter_rows(values_only=True)\n    h=next(rows)\n    if headers is None: headers=h\n    for r in rows:\n        if r[0] is None: continue\n        all_rows.append(r)\nprint('carrier rows',len(all_rows))\nprint('headers')\nfor i,h in enumerate(headers): print(i,h)\n# distributions of relevant columns\nfor idx in [3,4,9,13,14,19,25,30,31]:\n    print('\\\\ncol',idx, headers[idx])\n    c=collections.Counter()\n    for r in all_rows:\n        v=r[idx]\n        if v is None: v='<None>'\n        else: v=str(v)\n        c[v]+=1\n    for k,n in c.most_common(50): print(repr(k),n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
