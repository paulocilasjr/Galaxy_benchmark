{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os, collections\ncarrier_ids={'185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614'}\ncoding_basic={'synonymous_variant','missense_variant','inframe_insertion','inframe_deletion','frameshift_variant'}\ncoding_plus=coding_basic|{'splice_region_variant'}\nrows=[]\nfor f in glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n m=re.match(r'230209_Exome_GRCh38_CHIP_(\\\\d+)-',os.path.basename(f))\n if not m or m.group(1) not in carrier_ids: continue\n vals=list(openpyxl.load_workbook(f,data_only=True).active.iter_rows(min_row=3,values_only=True))\n rows.extend(vals)\ndef num(v):\n try:return float(v)\n except:return None\nfor name,terms in [('basic',coding_basic),('plus',coding_plus)]:\n low=[r for r in rows if num(r[9]) is not None and num(r[9])<0.3 and r[13] in terms]\n rows_all=len(low)\n syn=sum(1 for r in low if r[13]=='synonymous_variant')\n # unique by chr:pos/ref/alt/SO\n unique={(r[0],r[1],r[13]) for r in low}\n unique_syn={(r[0],r[1],r[13]) for r in low if r[13]=='synonymous_variant'}\n unique_var={(r[0],r[1]) for r in low}\n unique_var_syn={(r[0],r[1]) for r in low if r[13]=='synonymous_variant'}\n print(name,'rows',rows_all,syn,syn/rows_all,'unique var+SO',len(unique),len(unique_syn),len(unique_syn)/len(unique),'unique var',len(unique_var),len(unique_var_syn),len(unique_var_syn)/len(unique_var))\n # print counts\n print('syn unique variants', sorted(unique_var_syn))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
