{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os, collections\n# carriers from trio\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx',data_only=True)\ntrio=list(wb.active.iter_rows(values_only=True))\ncarriers={str(r[0]).strip().replace('\\\\t','') for r in trio[1:] if r[3]=='Carrier'}\nprint(carriers)\ncode_basic={'synonymous_variant','missense_variant','inframe_insertion','inframe_deletion','frameshift_variant'}\ncode_plus={'synonymous_variant','missense_variant','inframe_insertion','inframe_deletion','frameshift_variant','splice_region_variant'}\nfor terms_name,terms in [('basic',code_basic),('plus_splice',code_plus)]:\n N=0;S=0;per=collections.Counter()\n for f in glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n  m=re.match(r'230209_Exome_GRCh38_CHIP_(\\\\d+)-',os.path.basename(f))\n  if not m or m.group(1) not in carriers: continue\n  vals=list(openpyxl.load_workbook(f,data_only=True).active.iter_rows(min_row=3,values_only=True))\n  n=s=0\n  for r in vals:\n   try:vaf=float(r[9])\n   except:vaf=None\n   if vaf is not None and vaf<0.3 and r[13] in terms:\n    n+=1\n    if r[13]=='synonymous_variant':s+=1\n  per[os.path.basename(f)]=(s,n)\n  N+=n;S+=s\n print(terms_name, S,N, S/N)\n for k,v in per.items(): print(k,v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
