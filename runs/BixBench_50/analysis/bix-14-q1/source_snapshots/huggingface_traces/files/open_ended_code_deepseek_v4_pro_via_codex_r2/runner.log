{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob, re, os, collections\ncarrier_ids={'185','184','285','287','353','354','556','557','381','396','397','489','490','499','500','503','504','613','614'}\nrows=[]\nfor f in glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n m=re.match(r'230209_Exome_GRCh38_CHIP_(\\\\d+)-',os.path.basename(f))\n if not m or m.group(1) not in carrier_ids: continue\n ws=openpyxl.load_workbook(f,data_only=True).active\n vals=list(ws.iter_rows(min_row=3,values_only=True))\n rows.extend(vals)\nprint('rows',len(rows))\ndef num(v):\n try:return float(v)\n except:return None\n# low vaf all including zeros\nlow=[r for r in rows if num(r[9]) is not None and num(r[9])<0.3]\nprint('low all',len(low),'vaf zero',sum(1 for r in low if num(r[9])==0))\nfor z in ['Reference','Heterozygous','Homozygous Variant',None]:\n subset=[r for r in low if r[4]==z]\n print(z,len(subset),collections.Counter(r[13] for r in subset))\n# low vaf >0 only\nlowpos=[r for r in low if num(r[9])>0]\nprint('low pos',len(lowpos),collections.Counter(r[13] for r in lowpos))\n# low vaf and non-reference zygosity\nnonref=[r for r in low if r[4]\"'!='\"'Reference' and r[4] is not None]\nprint('nonref zygosity',len(nonref),collections.Counter(r[13] for r in nonref))\n# low vaf and zygosity Heterozygous or Homozygous Variant\nnonref2=[r for r in low if r[4] in ('Heterozygous','Homozygous Variant')]\nprint('het/hom',len(nonref2),collections.Counter(r[13] for r in nonref2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
