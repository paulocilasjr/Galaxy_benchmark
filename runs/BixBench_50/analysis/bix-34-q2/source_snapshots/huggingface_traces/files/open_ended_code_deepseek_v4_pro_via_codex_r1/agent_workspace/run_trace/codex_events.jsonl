{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport statistics, zipfile\nname='981902at2759.faa.mafft.clipkit.treefile'\nwith zipfile.ZipFile('inputs/scogs_fungi.zip') as z:\n    nwk=z.read(name).decode().strip()\nprint(nwk)\n\n# Recursive descent Newick parser (no branch length on root)\ndef parse(s):\n    s=s.strip()\n    if s.endswith(';'): s=s[:-1]\n    pos=0\n    def node():\n        nonlocal pos\n        if s[pos]=='(':\n            pos+=1\n            children=[]\n            while True:\n                children.append(node())\n                if s[pos]==',':\n                    pos+=1\n                    continue\n                if s[pos]==')':\n                    pos+=1\n                    break\n                raise ValueError((s,pos))\n            # optional label/branch for internal node\n            label=''\n            start=pos\n            while pos<len(s) and s[pos] not in ',);':\n                pos+=1\n            label=s[start:pos]\n            return {'children':children,'label':label,'length':float(label.split(':')[1]) if ':' in label else 0.0}\n        else:\n            start=pos\n            while pos<len(s) and s[pos] not in ',();':\n                pos+=1\n            token=s[start:pos]\n            name, length = (token.split(':')+['0'])[:2]\n            return {'name':name,'length':float(length),'children':[]}\n    t=node()\n    return t\n\ndef leaves(t):\n    if 'name' in t:\n        return [t['name']]\n    return [x for c in t['children'] for x in leaves(c)]\n\ndef get_nodes_paths(t, prefix=0.0, path=None):\n    if path is None: path={}\n    if 'name' in t:\n        path[t['name']]=prefix\n    else:\n        # prefix is distance to current node\n        for c in t['children']:\n            get_nodes_paths(c, prefix+c['length'], path)\n    return path\n\nt=parse(nwk)\nfrom pprint import pprint\npprint(t)\nd=get_nodes_paths(t)\nprint('dist to root/node A', d)\nnames=leaves(t)\nprint('names', names)\nvals=[]\nfor i,a in enumerate(names):\n    for b in names[i+1:]:\n        # Need pairwise path distance; root-to-leaf sums alone not enough. Recompute recursively.\n        pass\n\n# Build graph from parsed tree by DFS assigning node objects and edge lengths\nedges=[]\nnodeid=0\ndef walk(n, parent_id=None, parent_len=0.0):\n    global nodeid\n    n['id']=nodeid; nodeid+=1\n    if parent_id is not None:\n        edges.append((parent_id,n['id'],parent_len))\n    for c in n.get('children',[]):\n        walk(c,n['id'],c['length'])\nwalk(t)\nprint('edges',edges)\n# adjacency\nfrom collections import defaultdict\nadj=defaultdict(dict)\nfor u,v,w in edges:\n    adj[u][v]=w; adj[v][u]=w\nleaf_ids=[n['id'] for n in []] # no\ndef collect(n):\n    if 'name' in n: return [(n['name'],n['id'])]\n    out=[]\n    for c in n['children']: out+=collect(c)\n    return out\nleaves_info=collect(t)\nprint('leaves_info',leaves_info)\n# compute shortest path (tree unique) between leaves\nfrom collections import deque\ndef dist(a,b):\n    # DFS find path\n    stack=[(a,0,{-1})]\n    seen={a}\n    q=deque([(a,0)])\n    while q:\n        u,du=q.popleft()\n        if u==b: return du\n        for v,w in adj[u].items():\n            if v not in seen:\n                seen.add(v); q.append((v,du+w))\n    return None\npairvals=[]\nfor i,(na,ia) in enumerate(leaves_info):\n    for nb,ib in leaves_info[i+1:]:\n        dd=dist(ia,ib)\n        pairvals.append((na,nb,dd))\n        print(na,'-',nb,dd)\nprint('sorted')\nprint(sorted(v for *_,v in pairvals))\nprint('median',statistics.median([v for *_,v in pairvals]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
