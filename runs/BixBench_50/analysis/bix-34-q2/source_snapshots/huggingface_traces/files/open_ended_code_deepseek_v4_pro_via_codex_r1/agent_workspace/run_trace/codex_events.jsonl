{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport statistics\n\ndef parse(nwk):\n    s=nwk.strip()\n    if s.endswith(';'): s=s[:-1]\n    pos=0\n    def node():\n        nonlocal pos\n        if s[pos]=='(':\n            pos+=1\n            ch=[]\n            while True:\n                ch.append(node())\n                if pos<len(s) and s[pos]==',':\n                    pos+=1; continue\n                if pos<len(s) and s[pos]==')':\n                    pos+=1; break\n                raise ValueError((s,pos))\n            st=pos\n            while pos<len(s) and s[pos] not in ',);': pos+=1\n            lab=s[st:pos]\n            length=float(lab.split(':')[1]) if ':' in lab else 0.0\n            return ('int',ch,length)\n        st=pos\n        while pos<len(s) and s[pos] not in ',();': pos+=1\n        tok=s[st:pos]\n        if ':' in tok:\n            name, length=tok.split(':')\n            return ('leaf',name,float(length))\n        return ('leaf',tok,0.0)\n    return node()\n\ndef all_pair_dists(nwk):\n    t=parse(nwk)\n    edges=[]; idx=0\n    def walk(n, parent=None, plen=0.0):\n        nonlocal idx\n        myid=idx; idx+=1\n        if parent is not None:\n            edges.append((parent,myid,plen))\n        if n[0]=='int':\n            for c in n[1]: walk(c,myid,c[2])\n        return myid\n    walk(t)\n    leaves=[]; \n    def leaveswalk(n):\n        if n[0]=='leaf': leaves.append(n[1])\n        else:\n            for c in n[1]: leaveswalk(c)\n    leaveswalk(t)\n    # map names to ids via second walk\n    name_id={}\n    def mapwalk(n):\n        nonlocal idx\n        myid=idx; idx+=1\n        if n[0]=='leaf': name_id[n[1]]=myid\n        else:\n            for c in n[1]: mapwalk(c)\n    idx=0; mapwalk(t)\n    adj={}\n    for u,v,w in edges:\n        adj.setdefault(u,{})[v]=w\n        adj.setdefault(v,{})[u]=w\n    from collections import deque\n    def dist(a,b):\n        seen={a}; q=deque([(a,0.0)])\n        while q:\n            u,d=q.popleft()\n            if u==b:return d\n            for v,w in adj[u].items():\n                if v not in seen:\n                    seen.add(v); q.append((v,d+w))\n    ds=[]\n    for i,a in enumerate(leaves):\n        for b in leaves[i+1:]:\n            ds.append(dist(name_id[a],name_id[b]))\n    return sorted(ds), statistics.median(ds)\n\nfor f in ['981902at2759.faa.mafft.clipkit.treefile','981902at2759.faa.mafft.clipkit.bionj']:\n    import zipfile\n    n=zipfile.ZipFile('inputs/scogs_fungi.zip').read(f).decode().strip()\n    ds,med=all_pair_dists(n)\n    print(f, ds, med)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
