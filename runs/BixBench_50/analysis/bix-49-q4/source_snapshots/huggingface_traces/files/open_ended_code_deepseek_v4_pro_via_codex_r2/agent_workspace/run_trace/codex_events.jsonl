{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"/workspace/tools/envs/deseq/bin/Rscript - <<'RS'\nsuppressPackageStartupMessages(library(readxl)); suppressPackageStartupMessages(library(DESeq2)); suppressPackageStartupMessages(library(apeglm))\ncoldata <- as.data.frame(read_excel('inputs/Issy_ASXL1_blood_coldata_gender.xlsx'))\ncounts <- read.table('inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt', header=TRUE, row.names=1, check.names=FALSE, sep='')\ncounts <- counts[, coldata\"'$sample, drop=FALSE]\ncoldata$condition <- factor(coldata$condition, levels=c('\"'Control','ASXL1')); coldata\"'$sex <- factor(coldata$sex, levels=c('\"'F','M'))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~ sex + condition); dds <- DESeq(dds)\nfor (alpha in c(0.05,0.1)) {\n res <- results(dds, name='condition_ASXL1_vs_Control', alpha=alpha)\n resL <- lfcShrink(dds, coef='condition_ASXL1_vs_Control', res=res, type='apeglm')\n gtf <- read.csv('inputs/gencode.v31.primary_assembly.genes.csv', stringsAsFactors=FALSE); gtf <- gtf[\"'!duplicated(gtf$gene_id),]; rownames(gtf)<-gtf$gene_id\n hgnc <- read.delim('\"'inputs/HGNC_05-09-19.txt', header=TRUE, sep='\\\\t', stringsAsFactors=FALSE)\n # normalize Ensembl ID stripping version? file Ensembl ID may be ENSG00000121410, no version\n ens_versions <- rownames(resL)\n ens_base <- sub('\\\\\\\\..*','',ens_versions)\n has_hgnc <- ens_versions %in% hgnc\"'$Ensembl.ID.supplied.by.Ensembl | ens_base %in% hgnc$Ensembl.ID.supplied.by.Ensembl\n cat('\"'alpha',alpha,'sig with HGNC ensembl',sum(resL\"'$padj<.05 & has_hgnc,na.rm=TRUE),'\"'total with hgnc',sum(has_hgnc),'\\\\n')\n # gencode gene_name not empty\n has_name <- \"'!is.na(gtf[ens_versions,'\"'gene_name']) & gtf[ens_versions,'gene_name']\"'!='\"''\n cat('sig with gencode gene_name',sum(resL\"'$padj<.05 & has_name,na.rm=TRUE),'\"'total has name',sum(has_name),'\\\\n')\n # hgnc approved symbols via gencode hgnc_id\n gtf_hgnc <- gtf[ens_versions,'hgnc_id']\n has_hgnc_gtf <- \"'!is.na(gtf_hgnc) & gtf_hgnc!='\"'' & gtf_hgnc %in% hgnc\"'$HGNC.ID\n cat('\"'sig with gencode hgnc_id',sum(resL\"'$padj<.05 & has_hgnc_gtf,na.rm=TRUE),'\"'total',sum(has_hgnc_gtf),'\\\\n')\n # protein coding only with hgnc\n pc <- gtf[ens_versions,'gene_type']=='protein_coding'\n cat('sig protein_coding + hgnc_id',sum(resL\"'$padj<.05 & pc & has_hgnc_gtf,na.rm=TRUE),'\"'\\\\n')\n # all significant with approved symbol mapping unique? no\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
