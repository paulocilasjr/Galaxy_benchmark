{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"/workspace/tools/envs/deseq/bin/Rscript - <<'RS'\nsuppressPackageStartupMessages(library(readxl))\nsuppressPackageStartupMessages(library(DESeq2))\nsuppressPackageStartupMessages(library(apeglm))\ncoldata <- as.data.frame(read_excel('inputs/Issy_ASXL1_blood_coldata_gender.xlsx'))\n# match count cols and order\ncounts <- read.table('inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt', header=TRUE, row.names=1, check.names=FALSE, sep='')\ncounts <- counts[, coldata\"'$sample, drop=FALSE]\nstopifnot(identical(colnames(counts), coldata$sample))\ncoldata$condition <- factor(coldata$condition, levels=c('\"'Control','ASXL1'))\ncoldata\"'$sex <- factor(coldata$sex, levels=c('\"'F','M'))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~ sex + condition)\ndds <- DESeq(dds)\nprint(resultsNames(dds))\nfor (alpha in c(0.1,0.05)) {\n  res <- results(dds, name='condition_ASXL1_vs_Control', alpha=alpha)\n  cat('alpha',alpha,'summary\\\\n'); print(summary(res))\n  resL <- lfcShrink(dds, coef='condition_ASXL1_vs_Control', res=res, type='apeglm')\n  cat('lfc summary\\\\n'); print(summary(resL))\n  cat('count padj <0.05 =', sum(resL\"'$padj < 0.05, na.rm=TRUE), '\"'of', nrow(resL), '\\\\n')\n  cat('count pvalue <0.05 =', sum(res\"'$pvalue < 0.05, na.rm=TRUE), '\"'\\\\n')\n  cat('NA padj', sum(is.na(resL\"'$padj)), '\"'NA pvalue', sum(is.na(res\"'$pvalue)), '\"'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
