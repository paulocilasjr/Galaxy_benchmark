{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"/workspace/tools/envs/deseq/bin/Rscript - <<'RS'\nsuppressPackageStartupMessages(library(readxl))\nsuppressPackageStartupMessages(library(DESeq2))\nsuppressPackageStartupMessages(library(apeglm))\ncoldata <- as.data.frame(read_excel('inputs/Issy_ASXL1_blood_coldata_gender.xlsx'))\ncounts <- read.table('inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt', header=TRUE, row.names=1, check.names=FALSE, sep='')\ncounts <- counts[, coldata\"'$sample, drop=FALSE]\ncoldata$condition <- factor(coldata$condition, levels=c('\"'Control','ASXL1'))\ncoldata\"'$sex <- factor(coldata$sex, levels=c('\"'F','M'))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~ sex + condition)\ndds <- DESeq(dds)\nfor (alpha in c(0.05,0.1)) {\n  res <- results(dds, name='condition_ASXL1_vs_Control', alpha=alpha)\n  resL <- lfcShrink(dds, coef='condition_ASXL1_vs_Control', res=res, type='apeglm')\n  gtf <- read.csv('inputs/gencode.v31.primary_assembly.genes.csv', stringsAsFactors=FALSE)\n  # unique gene rows\n  gtf <- gtf[\"'!duplicated(gtf$gene_id),]\n  rownames(gtf) <- gtf$gene_id\n  gt <- gtf[rownames(resL), '\"'gene_type']\n  cat('alpha',alpha,'all sig',sum(resL\"'$padj < .05,na.rm=TRUE),'\"'\\\\n')\n  for (ty in c('protein_coding','lncRNA','pseudogene','processed_pseudogene','transcribed_unprocessed_pseudogene')) {\n    cat(ty, sum(resL\"'$padj < .05 & gt==ty,na.rm=TRUE),'\"'of type total',sum(gt==ty,na.rm=TRUE),'nonNA sig type',sum(resL\"'$padj < .05 & !is.na(gt) & gt==ty,na.rm=TRUE),'\"'\\\\n')\n  }\n  # lfc threshold variants\n  for (l in c(0,0.5,1,1.5,2)) {\n    cat('lfc threshold abs>',l,'sig',sum(resL\"'$padj<.05 & abs(resL$log2FoldChange)>l, na.rm=TRUE),'\"'\\\\n')\n  }\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
