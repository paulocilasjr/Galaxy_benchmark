{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv\np='inputs/gencode.v31.primary_assembly.genes.csv'\nfrom collections import Counter\n# parse header\nwith open(p) as f:\n    header=f.readline().rstrip('\\\\n').split(',')\nprint(header)\nids=set(); rows=0; gene_rows=0\nwith open(p) as f:\n    r=csv.DictReader(f)\n    for row in r:\n        rows+=1\n        if row['type']=='gene':\n            ids.add(row['gene_id']); gene_rows+=1\nprint('total lines', rows, 'gene rows', gene_rows, 'unique gene ids', len(ids))\n# count file ids\nwith open('inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt') as f:\n    next(f)\n    cnt=0; overlap=0; missing=0\n    for line in f:\n        gid=line.split()[0]; cnt+=1\n        if gid in ids: overlap+=1\n        else: missing+=1\nprint('count ids',cnt,'overlap',overlap,'missing',missing)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
