{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\nsuppressPackageStartupMessages({library(DESeq2); library(apeglm); library(openxlsx)})\ncounts <- read.table('/workspace/inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt', header=TRUE, row.names=1, check.names=FALSE)\ncoldata <- read.xlsx('/workspace/inputs/Issy_ASXL1_blood_coldata_gender.xlsx')\ncoldata <- coldata[\"'!is.na(coldata$sample),]\nrownames(coldata) <- coldata$sample\nkeep <- intersect(coldata$sample, colnames(counts))\ncounts <- counts[,keep,drop=FALSE]; coldata <- coldata[colnames(counts),,drop=FALSE]\ncoldata$condition <- factor(coldata$condition, levels=c('\"'Control','ASXL1'))\ncoldata\"'$sex <- factor(coldata$sex, levels=c('\"'F','M'))\n# prefilter\nkeepg <- rowSums(counts) >= 10\ncat('prefilter genes', sum(keepg), 'of', nrow(counts), '\\\\n')\nfor (pre in c(FALSE,TRUE)) {\n  cnt <- if (pre) counts[keepg,,drop=FALSE] else counts\n  dds <- DESeqDataSetFromMatrix(countData=as.matrix(cnt), colData=coldata, design=~sex+condition)\n  dds <- DESeq(dds, quiet=TRUE)\n  res <- results(dds, name='condition_ASXL1_vs_Control')\n  rl <- lfcShrink(dds, coef='condition_ASXL1_vs_Control', type='apeglm', quiet=TRUE)\n  cat('prefilter=',pre,'genes',nrow(cnt),'unshrunken sig',sum(res\"'$padj<0.05,na.rm=TRUE),'\"'shrunken sig',sum(rl\"'$padj<0.05,na.rm=TRUE),'\"'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
