{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time, os\nfrom scipy.stats import spearmanr\nfrom scipy.stats import rankdata\nimport warnings\nwarnings.filterwarnings('ignore')\n\nt0=time.time()\nprint('loading...', flush=True)\nce=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nex=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\nprint('loaded', time.time()-t0, flush=True)\n\ncommon_idx=ce.index.intersection(ex.index)\ncommon_cols=ce.columns.intersection(ex.columns)\nprint('shared models', len(common_idx), 'shared genes', len(common_cols), flush=True)\nX=ex.loc[common_idx, common_cols].to_numpy(dtype=np.float32)\nYraw=ce.loc[common_idx, common_cols].to_numpy(dtype=np.float32)\nY=-Yraw  # essentiality = -gene effect, positive-going\nprint('matrices', X.shape, 'X nan', np.isnan(X).sum(), 'Y nan', np.isnan(Y).sum(), flush=True)\n\nn=len(common_cols)\ncount=0\nfinite_non_nan=0\nvalid_low=[]\nfor j in range(n):\n    x=X[:,j]\n    y=Y[:,j]\n    mask=np.isfinite(y) & np.isfinite(x)\n    k=int(mask.sum())\n    if k < 2:\n        continue\n    try:\n        rho=spearmanr(x[mask], y[mask]).statistic\n    except Exception:\n        rho=np.nan\n    if np.isfinite(rho):\n        finite_non_nan += 1\n        if rho >= 0.6:\n            count += 1\n\nprint('computed genes', finite_non_nan, 'count >=0.6', count, 'skipped low valid', n-finite_non_nan, flush=True)\nprint('total elapsed', time.time()-t0, flush=True)\n\n# Save answer\nos.makedirs('codex_output', exist_ok=True)\nwith open('codex_output/answer.txt','w') as f:\n    f.write(str(count)+'\\\\n')\nprint('wrote codex_output/answer.txt', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
