{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time, warnings\nfrom scipy.stats import rankdata\nwarnings.filterwarnings('ignore')\nce=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nex=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\nidx=ce.index.intersection(ex.index); cols=ce.columns.intersection(ex.columns)\nX=ex.loc[idx,cols].to_numpy(dtype=np.float64)\nY=-ce.loc[idx,cols].to_numpy(dtype=np.float64)\ncount=0; rows=[]\nfor j,g in enumerate(cols):\n    x=X[:,j]; y=Y[:,j]\n    mask=np.isfinite(y)\n    xv=x[mask]; yv=y[mask]\n    if len(xv)<2: continue\n    rx=rankdata(xv); ry=rankdata(yv)\n    # Pearson on ranks\n    r=np.corrcoef(rx,ry)[0,1] if np.std(rx)>0 and np.std(ry)>0 else np.nan\n    if np.isfinite(r) and r>=0.6:\n        count+=1; rows.append((g,len(xv),float(r)))\nprint('vectorized count',count)\nfor g,n,r in sorted(rows,key=lambda z:-z[2])[:20]:\n    print(g,n,r)\n# raw coordinate count\ncount_raw=0; rows_raw=[]\nfor j,g in enumerate(cols):\n    x=X[:,j]; y=-ce.loc[idx,cols].iloc[:,j].to_numpy(dtype=np.float64) # this is transformed already\n# recompute raw explicitly\nXraw=ex.loc[idx,cols].to_numpy(dtype=np.float64)\nYraw=ce.loc[idx,cols].to_numpy(dtype=np.float64)\ncount_raw=0\nfor j,g in enumerate(cols):\n    x=Xraw[:,j]; y=Yraw[:,j]\n    mask=np.isfinite(y)\n    xv=x[mask]; yv=y[mask]\n    if len(xv)<2: continue\n    rx=rankdata(xv); ry=rankdata(yv)\n    r=np.corrcoef(rx,ry)[0,1] if np.std(rx)>0 and np.std(ry)>0 else np.nan\n    if np.isfinite(r) and r>=0.6: count_raw+=1\nprint('raw count >=.6',count_raw)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
