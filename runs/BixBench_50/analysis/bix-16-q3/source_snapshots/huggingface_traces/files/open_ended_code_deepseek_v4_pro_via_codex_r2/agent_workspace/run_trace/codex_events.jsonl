{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np, time, gc\nimport scipy.stats\n\ndef sym(x): return str(x).split(' (')[0]\n\nt0=time.time()\nch=pd.read_csv('inputs/CRISPRGeneEffect.csv', nrows=0).columns.tolist()[1:]\neh=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', nrows=0).columns.tolist()[1:]\ncg={sym(x):x for x in ch}; eg={sym(x):x for x in eh}\ncommon=sorted(set(cg)&set(eg))\nprint('common genes',len(common),'time',time.time()-t0)\n\ncids=pd.read_csv('inputs/CRISPRGeneEffect.csv', usecols=[0]).iloc[:,0].astype(str).tolist()\neids=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', usecols=[0]).iloc[:,0].astype(str).tolist()\ncommon_ids=sorted(set(cids)&set(eids), key=lambda x:cids.index(x))\nprint('common ids',len(common_ids))\n\nuc=['Unnamed: 0']+[cg[g] for g in common]\nue=['Unnamed: 0']+[eg[g] for g in common]\ndtype={c:np.float32 for c in uc[1:]}\nc=pd.read_csv('inputs/CRISPRGeneEffect.csv', usecols=uc, index_col=0, dtype=dtype, low_memory=False).loc[common_ids]\nprint('c shape',c.shape,'load time',time.time()-t0)\ndtype={c:np.float32 for c in ue[1:]}\ne=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', usecols=ue, index_col=0, dtype=dtype, low_memory=False).loc[common_ids]\nprint('e shape',e.shape,'load time',time.time()-t0)\n\n# validate sample with scipy\nfor g in ['A1BG','TP53','MYC','GAPDH','RPL11','KRAS']:\n    if g in common:\n        r=scipy.stats.spearmanr(c[cg[g]], e[eg[g]], nan_policy='omit').statistic\n        print('sample',g,'nvalid',c[cg[g]].notna().sum(),'rho',r)\n\n# propagate NaN effect mask to expression; rank both over valid per column\nmask=c.notna()\ne_masked=e.where(mask)\nprint('mask done',time.time()-t0)\nrc=c.rank(axis=0)\nprint('rank c done',time.time()-t0)\nre=e_masked.rank(axis=0)\nprint('rank e done',time.time()-t0)\nrho=rc.corrwith(re)\nprint('corr done',time.time()-t0)\nprint('rho count',rho.notna().sum(),'nan',rho.isna().sum())\nprint('range',rho.min(),rho.max(),'mean',rho.mean())\nfor th in [0.6,0.7,0.8,0.9]:\n    print('raw rho >=',th,(rho>=th).sum())\nfor th in [-0.6,-0.7,-0.8,-0.9]:\n    print('raw rho <=',th,(rho<=th).sum())\nprint('neg (essentiality= -effect) rho>=0.6',(rho<=-0.6).sum())\n# valid pair distribution among genes hitting neg threshold\nnvalid=c.notna().sum(axis=0)\nfor label, sel in [('raw>=0.6',rho>=0.6),('raw<=-0.6',rho<=-0.6)]:\n    s=nvalid[sel]\n    print(label,'count',int(sel.sum()),'valid stats min median max',s.min(),s.median(),s.max())\n    if len(s):\n      print('valid distribution <=20:',(s<=20).sum(),'<=50',(s<=50).sum(),'<=100',(s<=100).sum(),'<=200',(s<=200).sum(),'<=500',(s<=500).sum())\nprint('total elapsed',time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
