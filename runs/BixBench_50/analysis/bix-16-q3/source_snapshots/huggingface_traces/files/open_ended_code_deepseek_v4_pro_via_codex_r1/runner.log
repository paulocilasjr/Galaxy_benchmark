{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time\nfrom scipy.stats import rankdata\nfrom math import sqrt\n\nt=time.time()\neff=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nexpr=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\ncommon=eff.index.intersection(expr.index)\nprint('samples',len(common), flush=True)\neff=eff.loc[common]; expr=expr.loc[common]\ngenes=eff.columns.intersection(expr.columns)\nprint('genes',len(genes), flush=True)\nE=eff[genes].to_numpy(dtype=np.float64)\nX=expr[genes].to_numpy(dtype=np.float64)\nmask=np.isfinite(E) & np.isfinite(X)\ncount=0; rhos=np.full(len(genes), np.nan); nvals=np.zeros(len(genes),dtype=int)\nfor j in range(len(genes)):\n    m=mask[:,j]\n    n=int(m.sum())\n    nvals[j]=n\n    if n < 2:\n        continue\n    s=-E[m,j]\n    x=X[m,j]\n    # rank average ties\n    rs=rankdata(s)\n    rx=rankdata(x)\n    # avoid constant variable\n    ss=rs.std(ddof=1); sx=rx.std(ddof=1)\n    if ss==0 or sx==0:\n        continue\n    # pearson corr of ranks\n    num=np.sum((rs-rs.mean())*(rx-rx.mean()))\n    den=np.sqrt(np.sum((rs-rs.mean())**2)*np.sum((rx-rx.mean())**2))\n    rho=num/den\n    rhos[j]=rho\n    if rho>=0.6: count+=1\nprint('valid n min max mean', nvals.min(), nvals.max(), nvals.mean(), flush=True)\nprint('rho finite',np.isfinite(rhos).sum(),'min max',np.nanmin(rhos),np.nanmax(rhos),'count>=0.6',count,'count<=-0.6',int((rhos<=-0.6).sum()), flush=True)\nidx=np.argsort(rhos)\nprint('top positive:')\nfor i in idx[-20:][::-1]: print(genes[i],rhos[i],nvals[i])\nprint('bottom:')\nfor i in idx[:10]: print(genes[i],rhos[i],nvals[i])\nprint('total sec',time.time()-t, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
