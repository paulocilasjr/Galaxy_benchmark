{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time, re\nfrom collections import defaultdict\nfrom scipy.stats import rankdata\n\nt=time.time()\n# headers\nhe=pd.read_csv('inputs/CRISPRGeneEffect.csv', nrows=0).columns.tolist()[1:]\nhx=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', nrows=0).columns.tolist()[1:]\ndef sym(x): return re.sub(r'\\\\s*\\\\(\\\\d+\\\\)\\\\s*\"'$'\"','',x)\ndef ent(x): return int(re.search(r'\\\\((\\\\d+)\\\\)\\\\s*\"'$'\"',x).group(1))\nex_by=defaultdict(list)\nfor x in hx: ex_by[ent(x)].append(x)\npairs=[]\nfor e in he:\n    ei=ent(e)\n    opts=ex_by.get(ei)\n    if not opts: continue\n    if len(opts)==1:\n        xcol=opts[0]\n    else:\n        es=sym(e)\n        matches=[x for x in opts if sym(x)==es]\n        xcol=matches[0] if matches else opts[0]\n    pairs.append((e,xcol,ei))\nprint('entrez-matched pairs',len(pairs),flush=True)\neff=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nexpr=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\ncommon=eff.index.intersection(expr.index)\neff=eff.loc[common]; expr=expr.loc[common]\nE=eff[[p[0] for p in pairs]].to_numpy(dtype=np.float64)\nX=expr[[p[1] for p in pairs]].to_numpy(dtype=np.float64)\nmask=np.isfinite(E)&np.isfinite(X)\nprint(E.shape,'nan',np.isnan(E).sum(),np.isnan(X).sum(),'valid min max',mask.sum(0).min(),mask.sum(0).max(),flush=True)\ncount=0; rhos=np.full(len(pairs),np.nan); nvals=np.zeros(len(pairs),dtype=int)\nfor j in range(len(pairs)):\n    m=mask[:,j]; n=int(m.sum()); nvals[j]=n\n    if n<2: continue\n    s=-E[m,j]; x=X[m,j]\n    rs=rankdata(s); rx=rankdata(x)\n    sds=rs.std(ddof=1); sdx=rx.std(ddof=1)\n    if sds==0 or sdx==0: continue\n    num=((rs-rs.mean())*(rx-rx.mean())).sum()\n    den=np.sqrt(((rs-rs.mean())**2).sum()*((rx-rx.mean())**2).sum())\n    rho=num/den; rhos[j]=rho\n    if rho>=.6: count+=1\nprint('rho finite',np.isfinite(rhos).sum(),'min max',np.nanmin(rhos),np.nanmax(rhos),'count>=.6',count,'count<=-.6',int((rhos<=-.6).sum()),flush=True)\nidx=np.argsort(rhos)\nprint('top 30:')\nfor i in idx[-30:][::-1]: print(pairs[i][0], '->', pairs[i][1], rhos[i], nvals[i])\nprint('bottom 10:')\nfor i in idx[:10]: print(pairs[i][0],'->',pairs[i][1],rhos[i],nvals[i])\nprint('sec',time.time()-t,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
