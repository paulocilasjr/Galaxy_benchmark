{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time, re\nfrom scipy.stats import rankdata\n\nt=time.time()\neff = pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nprint('eff read', eff.shape, time.time()-t, 'anyna', eff.isna().any().any())\nt=time.time()\nexpr = pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\nprint('expr read', expr.shape, time.time()-t, 'anyna', expr.isna().any().any())\n# align samples\ncommon = eff.index.intersection(expr.index)\nprint('common samples',len(common))\neff = eff.loc[common]; expr = expr.loc[common]\n# match by exact header label\ngenes = eff.columns.intersection(expr.columns)\nprint('exact common genes',len(genes))\nE = eff[genes].to_numpy(dtype=np.float64)\nX = expr[genes].to_numpy(dtype=np.float64)\nprint(E.shape, X.shape, 'nan count',np.isnan(E).sum(),np.isnan(X).sum())\n# essentiality transform\nS = -E\n# rank columns average ties\nR = np.empty_like(S)\nfor j in range(S.shape[1]):\n    R[:,j] = rankdata(S[:,j])\nQ = np.empty_like(X)\nfor j in range(X.shape[1]):\n    Q[:,j] = rankdata(X[:,j])\n# pearson on ranks\nRc = R - R.mean(axis=0, keepdims=True)\nQc = Q - Q.mean(axis=0, keepdims=True)\nrn = np.sqrt((Rc**2).sum(axis=0))\nqn = np.sqrt((Qc**2).sum(axis=0))\nrho = (Rc*Qc).sum(axis=0)/(rn*qn)\nprint('rho range',rho.min(),rho.max(),'count >=.6',int((rho>=0.6).sum()),'count <=-.6',int((rho<=-0.6).sum()))\n# top/bottom\nidx=np.argsort(rho)\nfor i in list(idx[:10])+list(idx[-10:]): print(genes[i], rho[i])\nprint('time total', time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
