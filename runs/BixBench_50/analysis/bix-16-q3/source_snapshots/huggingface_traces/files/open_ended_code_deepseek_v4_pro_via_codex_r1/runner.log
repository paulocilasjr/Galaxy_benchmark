{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, re\nfor path in ['inputs/CRISPRGeneEffect.csv','inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv']:\n    h=pd.read_csv(path, nrows=0).columns.tolist()\n    print('\\\\n',path)\n    print('ncols',len(h))\n    ids=[]; bad=[]; dup=set(); seen=set()\n    for x in h[1:]:\n        m=re.search(r'\\\\((\\\\d+)\\\\)\\\\s*\"'$'\"', x)\n        if m:\n            i=int(m.group(1)); ids.append(i)\n            if i in seen: dup.add(i)\n            seen.add(i)\n        else: bad.append(x)\n    print('parsed',len(ids),'unique',len(set(ids)),'dup_entrez_count',len(dup),'bad',len(bad), 'bad examples', bad[:10], 'dup examples', list(dup)[:10])\n    # duplicates symbols\n    syms=[re.sub(r'\\\\s*\\\\(\\\\d+\\\\)\\\\s*\"'$'\"','',x) for x in h[1:]]\n    from collections import Counter\n    c=Counter(syms)\n    print('dup symbols', sum(v>1 for v in c.values()), list({s for s,v in c.items() if v>1})[:20])\n    # sample IDs\n    ids_s=[]\n    # use csv to read first column only\n    with open(path, newline='') as f:\n        import csv\n        r=csv.reader(f); next(r)\n        for row in r: ids_s.append(row[0])\n    print('nrows',len(ids_s),'unique',len(set(ids_s)),'first',ids_s[:3],'last',ids_s[-3:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
