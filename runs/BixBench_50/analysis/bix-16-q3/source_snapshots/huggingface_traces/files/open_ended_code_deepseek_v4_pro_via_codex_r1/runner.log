{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time\nfrom scipy.stats import rankdata\n# read only needed, maybe cached? do again or process from prior not retained. read all.\nt=time.time()\neff=pd.read_csv('inputs/CRISPRGeneEffect.csv', index_col=0)\nexpr=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\ncommon=eff.index.intersection(expr.index)\neff=eff.loc[common]; expr=expr.loc[common]\ngenes=eff.columns.intersection(expr.columns)\nE=eff[genes].to_numpy(); X=expr[genes].to_numpy()\nmask=np.isfinite(E) & np.isfinite(X)\nvalid=mask.sum(axis=0)\nprint('genes',len(genes),'valid min max mean median',valid.min(),valid.max(),valid.mean(),np.median(valid))\nprint('distribution: <3', (valid<3).sum(),'<10',(valid<10).sum(),'<50',(valid<50).sum(),'<100',(valid<100).sum(),'=1103',(valid==1103).sum())\nfor th in [0,1,2,3,5,10,20,50,100,500,1000]: print('<=',th,(valid<=th).sum())\n# missing effect count per gene top\nidx=np.argsort(valid)[:20]\nfor i in idx: print(genes[i],valid[i])\nprint('time',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
