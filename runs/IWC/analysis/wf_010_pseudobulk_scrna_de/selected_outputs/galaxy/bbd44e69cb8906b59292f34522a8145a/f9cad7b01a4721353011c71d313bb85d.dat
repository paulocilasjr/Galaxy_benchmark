    "import os, glob, json\n",
    "try:\n",
    "    print('GALAXY_INPUTS_GLOBAL', repr(GALAXY_INPUTS))\n",
    "except Exception as e:\n",
    "    print('GALAXY_INPUTS_GLOBAL_ERROR', repr(e))\n",
    "print('cwd', os.getcwd())\n",
    "print('cwd_files', glob.glob('*')[:50])\n",
    "print('jupyter_files', glob.glob('**/*', recursive=True)[:100])\n",
    "os.makedirs('outputs', exist_ok=True)\n",
    "open('outputs/probe.txt','w').write('probe complete\\n')\n"
   ]
