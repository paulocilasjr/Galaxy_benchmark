   ],
   "source": [
    "import subprocess, shutil, os\n",
    "print('which R', shutil.which('R'))\n",
    "print('which Rscript', shutil.which('Rscript'))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1913e5c5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:16:45.335535Z",
     "iopub.status.busy": "2026-08-28T23:16:45.335363Z",
     "iopub.status.idle": "2026-08-28T23:16:45.517600Z",
     "shell.execute_reply": "2026-08-28T23:16:45.517152Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "return 0\n",
      "R version: 4.3.3 \n",
      "DESeq2 MISSING\n",
      "edgeR MISSING\n",
      "anndataR MISSING\n",
      "\n",
      "\n"
     ]
    }
   ],
   "source": [
    "if shutil.which('Rscript'):\n",
    "    code = \"\"\"\n",
    "cat('R version:', as.character(getRversion()), '\\\\n')\n",
    "if (requireNamespace('DESeq2', quietly=TRUE)) {cat('DESeq2 OK', as.character(packageVersion('DESeq2')), '\\\\n')} else {cat('DESeq2 MISSING\\\\n')}\n",
    "if (requireNamespace('edgeR', quietly=TRUE)) {cat('edgeR OK', as.character(packageVersion('edgeR')), '\\\\n')} else {cat('edgeR MISSING\\\\n')}\n",
    "if (requireNamespace('anndata', quietly=TRUE)) {cat('anndataR OK\\\\n')} else {cat('anndataR MISSING\\\\n')}\n",
    "\"\"\"\n",
    "    r = subprocess.run(['Rscript','-e',code], text=True, capture_output=True, timeout=120)\n",
    "    print('return', r.returncode)\n",
    "    print(r.stdout)\n",
    "    print(r.stderr)"
   ]
  }
 ],
