    "code": "\"BEGIN {FS=OFS=\\\"\\\\t\\\"}\\n{\\n  n++\\n  gene[n]=$1\\n  lfc_text[n]=$3\\n  p_text[n]=$6\\n  p[n]=$6+0\\n  ord[n]=n\\n}\\nEND {\\n  for (i=2; i<=n; i++) {\\n    key=ord[i]\\n    j=i-1\\n    while (j>=1 && (p[ord[j]] > p[key] || (p[ord[j]] == p[key] && ord[j] > key))) {\\n      ord[j+1]=ord[j]\\n      j--\\n    }\\n    ord[j+1]=key\\n  }\\n  prev=1\\n  for (rank=n; rank>=1; rank--) {\\n    k=ord[rank]\\n    q=p[k]*n/rank\\n    if (q>1) q=1\\n    if (q>prev) q=prev\\n    prev=q\\n    fdr[k]=q\\n  }\\n  print \\\"gene\\\",\\\"log2_fold_change\\\",\\\"p_value\\\",\\\"fdr\\\"\\n  for (i=1; i<=n; i++) printf \\\"%s\\\\t%s\\\\t%s\\\\t%.17g\\\\n\\\", gene[i],lfc_text[i],p_text[i],fdr[i]\\n}\"",
