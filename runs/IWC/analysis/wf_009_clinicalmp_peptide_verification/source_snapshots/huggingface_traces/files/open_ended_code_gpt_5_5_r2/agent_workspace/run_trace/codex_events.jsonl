{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"/opt/conda/bin/python - <<'PY'\nimport pandas as pd, os, re, gzip\nsg='data/inputs/sgps_peptide_report/SGPS_peptide-report.tabular'\nmq='data/inputs/maxquant_peptide_report/MaxQuant-peptide-report.tabular'\ncand='data/inputs/distinct_peptides_for_pepquery/Distinct_Peptides_for_PepQuery.tabular'\nsgps=pd.read_csv(sg,sep='\\\\t')\nmaxq=pd.read_csv(mq,sep='\\\\t')\npeps=[l.strip().upper() for l in open(cand) if l.strip()]\nprint('candidate_count',len(peps),len(set(peps)))\nprint('sgps columns',list(sgps.columns))\nprint('maxq columns first last',list(maxq.columns[:15]), list(maxq.columns[-15:]))\nfor name,df,col,protcol in [('sgps',sgps,'Sequence','Protein(s)'),('maxq',maxq,'Sequence','Proteins')]:\n    sub=df[df[col].str.upper().isin(peps)]\n    print(name,'rows_matching_candidates',len(sub),'unique_peps',sub[col].str.upper().nunique())\n    print(sub[[col,protcol]].head(20).to_string(index=False))\n    prots=[]\n    for x in sub[protcol].dropna().astype(str):\n        for p in re.split(r'[;,]',x):\n            p=p.strip()\n            if p: prots.append(p)\n    print(name,'protein sample',prots[:30])\nprint('candidates not in sgps/mq sample')\nseen=set(sgps.loc[sgps.Sequence.str.upper().isin(peps),'Sequence'].str.upper())|set(maxq.loc[maxq.Sequence.str.upper().isin(peps),'Sequence'].str.upper())\nprint(len(set(peps)-seen), sorted(set(peps)-seen)[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
