{"type":"item.started","item":{"id":"item_168","type":"command_execution","command":"/usr/bin/bash -lc \"cat > /tmp/make_final.py <<'PY'\nfrom pathlib import Path\nimport csv, gzip, re, sys\n\nWORK=Path('work')\ndef read_fa_accessions(path):\n    acc=set()\n    opener = gzip.open(path,'rt',errors='replace') if Path(path).read_bytes()[:2]==b'\\\\x1f\\\\x8b' else open(path)\n    with opener as f:\n        for line in f:\n            if line.startswith('>'):\n                tok=line[1:].strip().split()[0]\n                if '|' in tok:\n                    parts=tok.split('|')\n                    if len(parts)>=2: acc.add(parts[1].upper())\n                else:\n                    acc.add(tok.upper())\n    return acc\nhuman_acc=read_fa_accessions('data/inputs/human_uniprot_isoforms_fasta/stream')\ncrap_acc=read_fa_accessions('data/inputs/crap/Contaminants%28cRAP%29-Protein-Database.fasta')\n# also con prefixes\nverified=set()\nfor p in sorted(WORK.glob('pepquery_out/F*_nodb_5g/psm_rank.txt')):\n    with open(p) as f:\n        header=f.readline().rstrip('\\\\n').split('\\\\t')\n        ci=header.index('confident'); pi=header.index('peptide')\n        for line in f:\n            parts=line.rstrip('\\\\n').split('\\\\t')\n            if parts[ci]=='Yes':\n                verified.add(parts[pi].upper())\n\ndef proteins_from_field(field):\n    toks=[]\n    for part in re.split(r'[;,]', field):\n        t=part.strip()\n        if t: toks.append(t)\n    return toks\n\ndef norm(tok):\n    tok=tok.strip()\n    if not tok: return None\n    if '|' in tok:\n        parts=tok.split('|')\n        db=parts[0].upper()\n        if len(parts)>=2:\n            acc=parts[1].upper()\n            if db=='TR': return acc\n            # sp/generic/con are human/contaminant\n            return None\n        return None\n    acc=tok.upper()\n    if acc.startswith('CON_') or acc in crap_acc or acc in human_acc:\n        return None\n    return acc\n\nmapping={}\ndef add(seq, field):\n    if seq not in verified: return\n    for tok in proteins_from_field(field):\n        acc=norm(tok)\n        if acc: mapping.setdefault(seq,set()).add(acc)\n\nwith open('data/inputs/sgps_peptide_report/SGPS_peptide-report.tabular', newline='') as f:\n    r=csv.reader(f, delimiter='\\\\t')\n    next(r)\n    for row in r:\n        if len(row)>=6:\n            add(row[5].upper(), row[1])\nwith open('data/inputs/maxquant_peptide_report/MaxQuant-peptide-report.tabular', newline='') as f:\n    r=csv.reader(f, delimiter='\\\\t')\n    next(r)\n    for row in r:\n        if len(row)>=35:\n            add(row[0].upper(), row[34])\n\n# debug\nprint('verified',len(verified))\nprint('mapped peptides',len(mapping),'unmapped',sorted(verified-set(mapping)))\nrows=[]\nfor seq in sorted(verified):\n    ids=sorted(mapping.get(seq,[]))\n    for aid in ids: rows.append((seq,aid))\nprint('rows',len(rows),'unique ids',len({r[1] for r in rows}))\nwith open('/tmp/final_preview.tsv','w') as f:\n    f.write('peptide\\\\tprotein_id\\\\n')\n    for seq,aid in rows: f.write(f'{seq}\\\\t{aid}\\\\n')\nPY\nmicromamba run -n pepquery python3 /tmp/make_final.py\nhead -30 /tmp/final_preview.tsv; echo '--- tail'; tail -20 /tmp/final_preview.tsv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
