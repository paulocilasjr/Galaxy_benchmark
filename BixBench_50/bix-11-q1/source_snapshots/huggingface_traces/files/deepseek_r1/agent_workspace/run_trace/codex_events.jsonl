n    while stack:\n        name,length,children=stack.pop()\n        if length is not None:\n            total+=length\n            if children:\n                internal+=length\n        if children:\n            ninternal+=1; stack.extend(children)\n        else:\n            nleaves+=1\n    return nleaves, total, internal, (internal/total if total else None)\n\nfor label,p in [('animals','tmp/scogs_animals/*.treefile'),('fungi','tmp/scogs_fungi/*.treefile')]:\n    files=glob.glob(p); rows=[metrics(f) for f in files]\n    print('\\\\n',label,'n',len(rows))\n    print('leaf counts',collections.Counter(r[0] for r in rows))\n    print('n_internal nodes',collections.Counter(r[3] for r in rows))\n    vals=[r[4] for r in rows if r[4] is not None]\n    print('median',statistics.median(vals),'zero count',sum(v==0 for v in vals),'positive',sum(v>0 for v in vals))\n    print('first 20', [round(v,6) for v in vals[:20]])\n    # files with leaves >3 sorted\n    for f,r in zip(files,rows):\n        if r[0]>=4:\n            pass\n    print('files >3 leaves vals:')\n    for f,r in zip(files,rows):\n        if r[0]>3:\n            print(os.path.basename(f), r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
