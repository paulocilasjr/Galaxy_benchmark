{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport urllib.request\nfor url in [\n 'https://raw.githubusercontent.com/JLSteenwyk/PhyKIT/master/phykit/services/tree/treeness.py',\n 'https://raw.githubusercontent.com/JLSteenwyk/PhyKIT/main/phykit/services/tree/treeness.py',\n]:\n try:\n  txt=urllib.request.urlopen(url, timeout=20).read().decode()\n  print('URL',url); print(txt[:5000])\n except Exception as e: print('ERR',url,e)\nPY\"","aggregated_output":"URL https://raw.githubusercontent.com/JLSteenwyk/PhyKIT/master/phykit/services/tree/treeness.py\nfrom __future__ import annotations\n\nfrom .base import Tree\n\n\ndef print_json(*args, **kwargs):\n    from ...helpers.json_output import print_json as _print_json\n\n    return _print_json(*args, **kwargs)\n\n\nclass Treeness(Tree):\n    def __init__(self, args) -> None:\n        parsed = self.process_args(args)\n        super().__init__(tree_file_path=parsed[\"tree_file_path\"])\n        self.json_output = parsed[\"json_output\"]\n\n    def run(self) -> None:\n        summary = self._get_simple_newick_summary(\n            self.tree_file_path,\n            \"tree_file_path\",\n        )\n        if summary is None:\n            tree = self.read_tree_file_unmodified()\n            treeness = self.calculate_treeness(tree)\n        else:\n            _, total_len, internal_len = summary\n            try:\n                treeness = float(internal_len / total_len)\n            except ZeroDivisionError:\n                print(\"Invalid tree. Tree should contain branch lengths\")\n                return\n        treeness = round(treeness, 4)\n        if self.json_output:\n            print_json(dict(treeness=treeness))\n            return\n        print(treeness)\n\n    def process_args(self, args) -> dict[str, str]:\n        return dict(tree_file_path=args.tree, json_output=getattr(args, \"json\", False))\n\nERR https://raw.githubusercontent.com/JLStee