art:i]\n                if val: length=float(val)\n            return (name,length,[]), i\n    root,i=parse_node(text,0)\n    while i<len(text) and text[i] in ' \\\\t\\\\r\\\\n': i+=1\n    if i\"'!=len(text): raise ValueError(f'\"'trailing {text[i:]}')\n    return root\n\ndef treeness(path):\n    txt=open(path).read()\n    root=parse_tree(txt)\n    total=0.0\n    internal=0.0\n    stack=[root]\n    while stack:\n        name,length,children=stack.pop()\n        if length is not None:\n            total += length\n            if children:\n                internal += length\n        stack.extend(children)\n    if total==0: return None\n    return internal/total\n\nfor label, pattern in [('animals','tmp/scogs_animals/*.treefile'),('fungi','tmp/scogs_fungi/*.treefile')]:\n    files=glob.glob(pattern)\n    vals=[]; bad=[]\n    for f in files:\n        try:\n            vals.append(treeness(f))\n        except Exception as e:\n            bad.append((os.path.basename(f),repr(e)))\n    vals=[v for v in vals if v is not None]\n    med=statistics.median(vals)\n    print(label, 'n_files',len(files),'n_vals',len(vals),'median',med, 'mean',statistics.mean(vals), 'min',min(vals),'max',max(vals))\n    if bad: print('bad', bad[:10], 'count',len(bad))\nprint('fungi - animals median', statistics.median([treeness(f) for f in glob.glob('tmp/scogs_fungi/*.treefile')]) - statistics.median([treeness(f) for f in glob.glob('tmp/scogs_animals/*.treefile')]))\nprint('abs difference', abs(statistics.median([treeness(f) for f in glob.glob('tmp/scogs_fungi/*.treefile')]) - statistics.median([treeness(f) for f in glob.glob('tmp/scogs_animals/*.treefile')])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
