{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport zipfile, collections\npath='/workspace/tmp_inspect/scogs_animals.zip'\nwith zipfile.ZipFile(path) as z:\n    counts=collections.Counter()\n    maxseq=0; maxname=None; maxlen=0; maxlen_name=None\n    lens=collections.Counter()\n    for n in z.namelist():\n        if not n.endswith('.mafft'): continue\n        data=z.read(n).decode('ascii')\n        seqs=data.count('>')\n        counts[seqs]+=1\n        if seqs>maxseq: maxseq=seqs; maxname=n\n        # alignment length as chars in first seq after header\n        lines=data.splitlines()\n        seqlines=[l for l in lines if l and not l.startswith('>')]\n        if seqlines:\n            alen=len(seqlines[0])\n            if alen>maxlen: maxlen=alen; maxlen_name=n\n    print('seq count distribution', counts)\n    print('maxseq', maxseq, maxname, 'max alen', maxlen, maxlen_name)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
