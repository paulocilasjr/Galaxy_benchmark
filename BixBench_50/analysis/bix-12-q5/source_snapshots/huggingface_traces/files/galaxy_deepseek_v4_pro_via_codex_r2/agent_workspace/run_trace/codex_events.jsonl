{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport base64, textwrap\nscript = r'''import sys, zipfile, pathlib, subprocess\narchive = pathlib.Path(sys.argv[1])\noutdir = pathlib.Path(\\\"extracted\\\")\noutdir.mkdir(exist_ok=True)\nwith zipfile.ZipFile(archive) as z:\n    z.extractall(outdir)\nfiles = sorted(outdir.glob(\\\"*.mafft\\\"))\nif not files:\n    raise RuntimeError(\\\"no .mafft alignments found\\\")\nwith open(\\\"pis_summary.tsv\\\", \\\"w\\\") as out:\n    out.write(\\\"gene\\\\tpis\\\\ttotal\\\\tpct\\\\n\\\")\n    for f in files:\n        proc = subprocess.run(\n            [\\\"phykit\\\", \\\"parsimony_informative_sites\\\", str(f)],\n            capture_output=True,\n            text=True,\n            check=True,\n        )\n        parts = proc.stdout.strip().split()\n        if len(parts) \"'!= 3:\n            raise RuntimeError(f\"unexpected phykit output for {f.name}: {proc.stdout!r}\")\n        out.write(f\"{f.name}'\"\\\\t{parts[0]}\\\\t{parts[1]}\\\\t{parts[2]}\\\\n\\\")\n'''\nb64=base64.b64encode(script.encode()).decode()\nprint(b64)\nprint('length', len(script), 'b64len', len(b64))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
