{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport zipfile, collections, statistics\nz=zipfile.ZipFile('/workspace/inputs/scogs_animals.zip')\n\ndef parse_fasta(text):\n    seqs=[]; name=None; cur=[]\n    for line in text.splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append((name,''.join(cur).upper()))\n            name=line[1:].strip(); cur=[]\n        else:\n            cur.append(line.strip())\n    if name is not None: seqs.append((name,''.join(cur).upper()))\n    return seqs\n\nmissing_ambiguous=set('BJZX.*-?')  # AMAS amino acid missing/ambiguous\nresults=[]\nfor n in z.namelist():\n    if not n.endswith('.mafft'): continue\n    seqs=parse_fasta(z.read(n).decode())\n    if not seqs: continue\n    L=len(seqs[0][1])\n    assert all(len(s[1])==L for s in seqs)\n    pi=0; variable=0\n    for col in range(L):\n        chars=[s[1][col] for s in seqs if s[1][col] not in missing_ambiguous]\n        if not chars: continue\n        if len(set(chars))>1: variable+=1\n        counts=collections.Counter(chars)\n        pat=[c for c in counts if counts[c]>=2]\n        if len(pat)>=2: pi+=1\n    results.append((pi,L,len(seqs),n, variable))\nresults.sort(reverse=True)\nprint('total alignments',len(results))\nprint('top 30')\nfor r in results[:30]: print(r)\nprint('max', results[0])\n# distribution\npis=[r[0] for r in results]\nprint('PI distribution: >0',sum(p>0 for p in pis), 'min/max/median',min(pis),max(pis),statistics.median(pis))\n# top by taxa\nfor k in [4,3,2,1]:\n    rs=[r for r in results if r[2]==k]\n    print('taxa',k,'max', max(rs, default=None))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
