{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\n\nsamp = pd.read_csv('inputs/Sample_annotated_Zenodo.csv')\ncd14_samples = samp.loc[samp['celltype']=='CD14','sample'].tolist()\nprint('n_cd14', len(cd14_samples), cd14_samples[:5], cd14_samples[-5:])\n\nmeta = pd.read_csv('inputs/GeneMetaInfo_Zenodo.csv', index_col=0)\nprint('meta genes', len(meta), meta.index.is_unique, meta['gene_biotype'].eq('protein_coding').sum())\n\ncounts = pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv', index_col=0, dtype='float32')\nprint('counts shape', counts.shape)\nprint('cols subset present', sum(c in counts.columns for c in cd14_samples), 'all', set(cd14_samples) <= set(counts.columns))\ncd14 = counts[cd14_samples]\nprint('cd14 shape', cd14.shape, 'min', cd14.values.min(), 'max', cd14.values.max())\n# Check NAs\nprint('na in cd14', cd14.isna().sum().sum())\ntotal = cd14.sum(axis=1)\nmean = cd14.mean(axis=1)\n# align meta order\nprint('counts idx is_unique', counts.index.is_unique, 'meta order match', counts.index.equals(meta.index))\nprint('missing meta', len(set(counts.index)-set(meta.index)), 'missing counts', len(set(meta.index)-set(counts.index)))\n# produce dataframe in counts order with length\nlength = meta['Length'].reindex(counts.index)\nbiotype = meta['gene_biotype'].reindex(counts.index)\nmask = biotype.eq('protein_coding') & (total >= 10)\nprint('eligible', mask.sum())\nprint('protein coding total>=10 counts min', total[mask].min(), 'max', total[mask].max())\nprint('length missing eligible', length[mask].isna().sum())\nr, p = pearsonr(length[mask].to_numpy(dtype='float64'), mean[mask].to_numpy(dtype='float64'))\nprint('Pearson r', r)\nprint('p', p)\nprint('length stats eligible', length[mask].describe())\nprint('mean stats eligible', mean[mask].describe())\n# save exact with high precision\nprint('repr', repr(float(r)))\n# Alternative log? maybe log2 mean vs length pearson\nmean_pos=mean[mask]\nprint('log mean min max', np.log2(mean_pos).min(), np.log2(mean_pos).max())\nprint('pearson length vs log2mean', pearsonr(length[mask], np.log2(mean[mask].astype('float64')))[0])\n# spearman\nprint('spearman', __import__('scipy.stats').stats.spearmanr(length[mask], mean[mask]).statistic)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
