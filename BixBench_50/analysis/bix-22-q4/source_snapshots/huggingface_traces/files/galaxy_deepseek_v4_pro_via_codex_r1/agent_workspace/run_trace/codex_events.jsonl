{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc 'key=$(cat /run/secrets/galaxy_api_key)\nhist='\"'bbd44e69cb8906b5c2d5d3e2d414934a'\n# Download headers / small files for staging inspection only\ncurl -sS -H \\\"x-api-key: \"'$key\" -r 0-500000 \"https://usegalaxy.org/api/histories/$hist/contents/f9cad7b01a472135a2c811bc0dce4463/display\" -o /workspace/tmp/counts_head.csv\ncurl -sS -H \"x-api-key: $key\" \"https://usegalaxy.org/api/histories/$hist/contents/f9cad7b01a4721358a382d605891ad19/display\" -o /workspace/tmp/meta.csv\ncurl -sS -H \"x-api-key: $key\" \"https://usegalaxy.org/api/histories/$hist/contents/f9cad7b01a4721356dbdeaaf1d1a2075/display\" -o /workspace/tmp/samples.csv\npython - <<'\"'PY'\nimport csv\n# counts head\nwith open('/workspace/tmp/counts_head.csv', newline='') as f:\n    header=f.readline().rstrip('\\\\n')\nprint('counts header chars', len(header))\ncols=header.split(',')\nprint('num columns (comma split)', len(cols))\nprint('first 5 cols', cols[:5])\nprint('last 5 cols', cols[-5:])\n# sample file\nwith open('/workspace/tmp/samples.csv', newline='') as f:\n    reader=csv.reader(f)\n    samples=[r for r in reader]\nprint('sample header', samples[0])\nprint('num sample rows', len(samples)-1)\ncd14=[r[0] for r in samples[1:] if r[3]=='CD14']\nprint('num CD14', len(cd14))\nprint('first last CD14', cd14[:5], cd14[-5:])\n# meta\nwith open('/workspace/tmp/meta.csv', newline='') as f:\n    reader=csv.reader(f)\n    meta=list(reader)\nprint('meta header', meta[0])\nprint('num meta rows', len(meta)-1)\nfrom collections import Counter\nbt=Counter(r[4] for r in meta[1:])\nprint('gene_biotype counts top', bt.most_common(10), 'protein_coding', bt['protein_coding'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
