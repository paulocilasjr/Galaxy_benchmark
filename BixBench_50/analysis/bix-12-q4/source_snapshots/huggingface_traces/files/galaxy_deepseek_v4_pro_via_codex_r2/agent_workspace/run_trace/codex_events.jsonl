{"type":"item.started","item":{"id":"item_82","type":"mcp_tool_call","server":"bixbench_galaxy_execute","tool":"run_galaxy_udt_and_wait","arguments":{"history_id":"bbd44e69cb8906b56cc85b035b616ce5","representation":{"class":"GalaxyUserTool","id":"codex_phykit_pis_batch_v1","name":"Codex PhyKIT parsimony informative sites batch","version":"0.1.0","container":"quay.io/biocontainers/phykit:1.11.7--pyhdfd78af_0","shell_command":"set -eu\npython - \"$(inputs.archive.path)\" <<'PY'\nimport sys, zipfile, subprocess, tempfile, os\narchive_path = sys.argv[1]\nout_path = \"percentages.tsv\"\nrows = []\nwith zipfile.ZipFile(archive_path) as z:\n    for info in z.infolist():\n        if not info.filename.endswith(\".faa.mafft\"):\n            continue\n        data = z.read(info)\n        with tempfile.TemporaryDirectory() as td:\n            aln = os.path.join(td, \"aln.fa\")\n            with open(aln, \"wb\") as f:\n                f.write(data)\n            out = subprocess.check_output([\"phykit\", \"pis\", aln], text=True).strip()\n        fields = out.split(\"\\t\")\n        if len(fields) < 3:\n            raise RuntimeError(\"unexpected phykit output: \" + out)\n        pct = fields[2].strip()\n        rows.append((info.filename, pct))\nrows.sort()\nwith open(out_path, \"w\") as f:\n    for name, pct in rows:\n        f.write(name + \"\\t\" + pct + \"\\n\")\nPY","inputs":[{"name":"archive","type":"data","format":["zip"]}],"outputs":[{"name":"percentages","type":"data","format":"tabular","from_work_dir":"percentages.tsv"}]},"tool_inputs":{"archive":{"src":"hda","id":"f9cad7b01a472135466b72a19261e082"}},"timeout_seconds":5400},"result":null,"error":null,"status":"in_progress"}}
