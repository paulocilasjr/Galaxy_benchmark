{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, xml.etree.ElementTree as ET\nfrom collections import Counter\n\ndef parse(path):\n z=zipfile.ZipFile(path); M='{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'; ns={'m':M[1:-1]}\n items=[''.join(t.text or '' for t in si.iter(M+'t')) for si in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('m:si',ns)]\n def ci(ref):\n  s=''\n  for ch in ref:\n   if ch.isalpha(): s+=ch\n   else: break\n  n=0\n  for ch in s: n=n*26+ord(ch)-64\n  return n-1\n rows=[]\n for row in ET.fromstring(z.read('xl/worksheets/sheet1.xml')).iter(M+'row'):\n  r=int(row.get('r')); vals={}\n  for c in row.findall(M+'c'):\n   idx=ci(c.get('r')); typ=c.get('t'); v=c.find(M+'v')\n   if v is None:\n    is_=c.find(M+'is'); val=''.join(t.text or '' for t in is_.iter(M+'t')) if is_ is not None else ''\n   else:\n    val=v.text or ''\n    if typ=='s': val=items[int(val)]\n   vals[idx]=val\n  rows.append((r,vals))\n return rows\nrows=parse('/workspace/inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_556-PF.xlsx')\ndata=rows[2:]\nnr=[v for r,v in data if v.get(4)\"'!='\"'Reference']\nprint('nr rows',len(nr))\nfor col,name in [(30,'Match InCHIP'),(12,'Gene Names')]:\n c=Counter()\n for v in nr:\n  val=v.get(col)\n  if val:\n   # split by comma? For col12 maybe multiple, for col30 single\n   for x in [x.strip() for x in str(val).split(',') if x.strip()]:\n    c[x]+=1\n print('\\\\n',name)\n for g,n in c.most_common(20): print(g,n)\n# Also by Gene Names using comma split vs single\nprint('\\\\nTop match col30 all')\nprint(Counter(v.get(30) for v in nr).most_common())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
