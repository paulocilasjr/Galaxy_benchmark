{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# quick parse 556 and check zygosity vs vaf and DP/GQ\nimport zipfile, xml.etree.ElementTree as ET\nfrom collections import Counter\ndef parse(path):\n z=zipfile.ZipFile(path); M='{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'; ns={'m':M[1:-1]}\n items=[''.join(t.text or '' for t in si.iter(M+'t')) for si in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('m:si',ns)]\n def ci(ref):\n  s=''\n  for ch in ref:\n   if ch.isalpha(): s+=ch\n   else: break\n  n=0\n  for ch in s:n=n*26+ord(ch)-64\n  return n-1\n rows=[]\n for row in ET.fromstring(z.read('xl/worksheets/sheet1.xml')).iter(M+'row'):\n  r=int(row.get('r')); vals={}\n  for c in row.findall(M+'c'):\n   idx=ci(c.get('r')); typ=c.get('t'); v=c.find(M+'v')\n   if v is None:\n    is_=c.find(M+'is'); val=''.join(t.text or '' for t in is_.iter(M+'t')) if is_ is not None else ''\n   else:\n    val=v.text or ''\n    if typ=='s': val=items[int(val)]\n   vals[idx]=val\n  rows.append((r,vals))\n return rows\nrows=parse('/workspace/inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_556-PF.xlsx')[2:]\nfor r,v in rows:\n try: vaf=float(v.get(9,'nan'))\n except: vaf=None\n z=v.get(4)\n if (z=='Reference' and (vaf is None or vaf>0)) or (z\"'!='\"'Reference' and (vaf is None or vaf<=0)):\n  print(r,z,v.get(9),v.get(7),v.get(8),v.get(12))\nprint('counts by z/vaf0')\nc=Counter()\nfor r,v in rows:\n try:vaf=float(v.get(9))\n except:vaf=None\n c[(v.get(4), vaf==0 if vaf is not None else 'na')]+=1\nprint(c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
