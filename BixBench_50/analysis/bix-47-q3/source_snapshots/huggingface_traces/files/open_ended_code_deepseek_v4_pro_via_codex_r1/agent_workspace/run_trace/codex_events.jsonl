{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, xml.etree.ElementTree as ET, openpyxl\nfrom collections import Counter\nfrom pathlib import Path\n\ntrio_path = Path('/workspace/inputs/230215_Trio_Status.xlsx')\nwb = openpyxl.load_workbook(trio_path, read_only=True, data_only=True)\nws = wb.active\nheader = [c.value for c in next(ws.iter_rows(min_row=1, max_row=1))]\nprint('trio header:', header)\nmale_carriers=[]\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    sid, status, sex, blm, age, cancer, extra = row\n    if str(blm).strip().lower() == 'carrier' and str(sex).strip().upper() == 'M':\n        try:\n            age_f=float(age)\n        except (TypeError,ValueError):\n            age_f=None\n        male_carriers.append((sid,status,sex,blm,age,age_f))\nprint('male carriers:')\nfor x in male_carriers: print(x)\noldest=max([x for x in male_carriers if x[-1] is not None], key=lambda x:x[-1])\nprint('oldest:', oldest)\nsid_raw = oldest[0]\n# normalize sample id from trio: numeric int or SRR string\nif isinstance(sid_raw,float) and sid_raw.is_integer():\n    sid = str(int(sid_raw))\nelse:\n    sid = str(sid_raw).strip()\n# find matching xlsx files, prefer numeric token and sample header\nfiles=list(Path('/workspace/inputs/CHIP_DP10_GQ20_PASS').glob('*.xlsx'))\ncandidates=[]\nfor f in files:\n    if sid in f.name:\n        candidates.append(f)\nprint('candidate files for', sid, candidates)\n# use file whose stem ends with token equal sid (handle SRR exact and numeric exact)\nif len(candidates)==1:\n    sample_file=candidates[0]\nelse:\n    # prefer filename containing '_CHIP_' + sid + '-' exact, then sid at end before suffix\n    exact=[f for f in candidates if f.stem.split('_')[-1].split('-')[0] == sid]\n    sample_file=exact[0] if exact else candidates[0]\nprint('using', sample_file)\n\ndef parse_chip_xlsx(path):\n    z=zipfile.ZipFile(path)\n    M='{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'\n    ns={'m':M[1:-1]}\n    shared=[]\n    for si in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('m:si',ns):\n        shared.append(''.join(t.text or '' for t in si.iter(M+'t')))\n    def col_index(ref):\n        letters=''\n        for ch in ref:\n            if ch.isalpha(): letters+=ch\n            else: break\n        n=0\n        for ch in letters: n=n*26+ord(ch)-64\n        return n-1\n    parsed=[]\n    for row_el in ET.fromstring(z.read('xl/worksheets/sheet1.xml')).iter(M+'row'):\n        r=int(row_el.get('r'))\n        vals={}\n        for c in row_el.findall(M+'c'):\n            idx=col_index(c.get('r'))\n            typ=c.get('t')\n            v=c.find(M+'v')\n            if v is None:\n                inline=c.find(M+'is')\n                val=''.join(t.text or '' for t in inline.iter(M+'t')) if inline is not None else ''\n            else:\n                val=v.text or ''\n                if typ=='s':\n                    val=shared[int(val)]\n            vals[idx]=val\n        parsed.append((r,vals))\n    return parsed\n\nrows=parse_chip_xlsx(sample_file)\n# header should row2; data from row3\ndata=rows[2:]\nprint('data rows:', len(data), 'max row:', max(r for r,v in data))\nzyg_counter=Counter(v.get(4) for r,v in data)\nprint('zygosity distribution:', zyg_counter)\nnon_ref=[v for r,v in data if v.get(4) not in ('Reference', None, '')]\nprint('non-reference row count:', len(non_ref))\n# genes via CHIP Match column (index 30), case-normalized\ngene_counter=Counter()\nfor v in non_ref:\n    g=(v.get(30) or '').strip().upper()\n    if g:\n        gene_counter[g]+=1\nprint('top genes:')\nfor g,n in gene_counter.most_common(15):\n    print(g,n)\ntop_gene=gene_counter.most_common(1)[0][0]\nprint('ANSWER:', top_gene)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
