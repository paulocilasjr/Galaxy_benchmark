{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, collections, re\np='/workspace/tmp/27_230209_Exome_GRCh38_CHIP_556-PF.xlsx'\nwb=openpyxl.load_workbook(p, read_only=False, data_only=True)\nws=wb['(Variants 674) Filter Variants']\nrows=list(ws.iter_rows(values_only=True))\nprint('rows',len(rows),'headers rows',rows[:2])\ndata=rows[2:]\nprint('data',len(data))\n# columns indices: A0 Chr, B1 Ref/Alt, E4 Zygosity, M12 Gene Names, T19 Filter\nfor idx,name in enumerate(rows[1]): print(idx,repr(name))\nzyg=collections.Counter(r[4] for r in data)\nprint('Zygosity counts', zyg)\ngenes=collections.Counter()\nfor r in data:\n g=r[12]\n if g:\n  for gene in re.split(r'[;,]',str(g)):\n   gene=gene.strip()\n   if gene: genes[gene]+=1\nprint('total gene occurrence rows', sum(genes.values()), 'unique genes', len(genes))\nprint('top genes all rows', genes.most_common(30))\n# non-reference: zygosity not Reference/None? Let's inspect zygosity unique\nnonref=[r for r in data if r[4] not in (None,'Reference')]\nprint('nonref',len(nonref), collections.Counter(r[4] for r in nonref))\ngenes2=collections.Counter()\nfor r in nonref:\n g=r[12]\n if g:\n  for gene in re.split(r'[;,]',str(g)):\n   gene=gene.strip()\n   if gene: genes2[gene]+=1\nprint('nonref gene occurrence sum',sum(genes2.values()), 'unique',len(genes2))\nprint('top nonref genes', genes2.most_common(30))\n# maybe exclude zygosity None? Count nonref if not Reference and not None\nnonref2=[r for r in data if r[4] not in (None,'Reference')]\nprint('same', len(nonref2))\n# if non-reference means zygosity has non-reference alt allele, maybe only not Reference.\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
