{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"mkdir -p codex_output && python3 - <<'PY'\nimport openpyxl, glob, os, re, collections\n# Determine oldest male carrier from Trio_Status\nwb = openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True)\nws = wb.active\nrows = list(ws.iter_rows(values_only=True))\nhdr = rows[0]\nidx = {h:i for i,h in enumerate(hdr)}\nmale_carriers = []\nfor r in rows[1:]:\n    sid, status, sex, blm, age = r[0], r[1], r[2], r[3], r[4]\n    if sex == 'M' and blm == 'Carrier' and isinstance(age, (int, float)):\n        male_carriers.append((age, sid, status))\noldest = max(male_carriers)\nprint('oldest male carrier:', oldest)\n# Locate file by sample ID in filename\npat = f'inputs/CHIP_DP10_GQ20_PASS/*CHIP_{oldest[1]}-*.xlsx'\nfiles = glob.glob(pat)\nprint('matched', files)\nf = files[0]\nwb = openpyxl.load_workbook(f, data_only=True)\nws = wb.active\n# Gene list\nchip = set()\nfor r in openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx', data_only=True).active.iter_rows(values_only=True):\n    if r[0]:\n        chip.add(str(r[0]).strip())\ncounts = collections.Counter()\nfor r in ws.iter_rows(min_row=3, values_only=True):\n    zyg = str(r[4])\n    if zyg in ('Reference', 'None'):\n        continue\n    seen = set()\n    for tok in re.split('[,;]', str(r[12] or '')):\n        tok = tok.strip()\n        if tok in chip:\n            seen.add(tok)\n    for g in seen:\n        counts[g] += 1\nprint('top gene counts:')\nfor g,c in counts.most_common(10):\n    print(g,c)\nans = counts.most_common(1)[0][0]\nprint('ANSWER', ans)\nwith open('codex_output/answer.txt','w') as out:\n    out.write(ans + '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
