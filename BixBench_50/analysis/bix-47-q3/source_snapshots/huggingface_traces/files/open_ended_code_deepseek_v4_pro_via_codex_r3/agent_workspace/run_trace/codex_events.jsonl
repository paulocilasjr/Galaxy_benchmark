{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, collections, re\nchip=set()\nfor r in openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx', data_only=True).active.iter_rows(values_only=True):\n if r[0]: chip.add(str(r[0]).strip())\nprint('chip',sorted(chip))\nf='inputs/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_556-PF.xlsx'\nwb=openpyxl.load_workbook(f, data_only=True); ws=wb.active\nrows=list(ws.iter_rows(values_only=True))\ngenes=collections.Counter(); missing=[]\nfor r in rows[2:]:\n    gs=str(r[12] or '')\n    for g in re.split('[,;]',gs):\n        g=g.strip()\n        if g: genes[g]+=1\n        if g and g not in chip and g not in missing: missing.append(g)\nprint('total unique genes in file',len(genes))\nprint('missing from CHIP list',missing)\nfor g,c in genes.most_common():\n    mark='*' if g not in chip else ' '\n    print(f'{mark} {g:12s} {c}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
