   ],\n                  \"refresh_on_change\": false,\n                  \"textable\": false,\n                  \"type\": \"select\",\n                  \"value\": \"exclude_match\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"regex\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"example: 1,4,2 or c1,c4,c2(selects the first,fourth, and second columns)\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"enter column numbers to keep\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"columns\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"select_columns\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"Python offset indexes or slices.  Examples:                                 <ul>                                 <li>Column offset indexes: 0,3,1 (selects the first,fourth, and second columns)</li>                                 <li>Negative column numbers: -1,-2 (selects the last, and second last columns)</li>                                 <li>python slices ( slice(start, stop[, step]) select a range of columns): <li>                                   <ul>                                     <li>0:3 or :3 (selects the first 3 columns)</li>                                     <li>3:5 (selects the fourth and fifth columns)</li>                                     <li>2: (selects all columns after the second)</li>                                     <li>-2: (selects the last 2 columns)</li>                                     <li>2::-1 (selects the first 3 columns n reverse order: third,second,first)</li>                                   </ul>                                 </ul>\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"enter indices or slices of the columns to keep\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"columns\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"select_column_slices\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"example: 1 or c1 (selects the first column)\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"enter column number to replace\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"column\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                },\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"regex pattern\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"regex_pattern\",\n                  \"optional\": true,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                },\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"replacement expression\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"regex_replace\",\n                  \"optional\": true,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                },\n                {\n                  \"argument\": null,\n                  \"display\": null,\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"Instead of replacing, Add as new column:\",\n                  \"model_class\": \"SelectToolParameter\",\n                  \"multiple\": false,\n                  \"name\": \"add\",\n                  \"optional\": true,\n                  \"options\": [\n                    [\n                      \"prepend to beginning of row\",\n                      \"prepend\",\n                      false\n                    ],\n                    [\n                      \"append to the end of row\",\n                      \"append\",\n                      false\n                    ],\n                    [\n                      \"insert before column field\",\n                      \"before\",\n                      false\n                    ],\n                    [\n                      \"insert after column field\",\n                      \"after\",\n                      false\n                    ]\n                  ],\n                  \"refresh_on_change\": false,\n                  \"textable\": false,\n                  \"type\": \"select\",\n                  \"value\": null\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"replace\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"example: 2,4 or c2,c4 (selects the second, and fourth columns)                                If multiple columns are selected, they should have the same length and separator on each line\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"enter column numbers to normalize\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"columns\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                },\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"List item delimiter in column\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"separator\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \",\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"normalize\"\n            }\n          ],\n          \"model_class\": \"Conditional\",\n          \"name\": \"filter\",\n          \"test_param\": {\n            \"argument\": null,\n            \"display\": null,\n            \"help\": \"\",\n            \"help_format\": \"html\",\n            \"hidden\": false,\n            \"is_dynamic\": false,\n            \"label\": \"Filter By\",\n            \"model_class\": \"SelectToolParameter\",\n            \"multiple\": false,\n            \"name\": \"filter_type\",\n            \"optional\": false,\n            \"options\": [\n              [\n                \"skip leading lines\",\n                \"skip\",\n                false\n              ],\n              [\n                \"comment char\",\n                \"comment\",\n                false\n              ],\n              [\n                \"by regex expression matching\",\n                \"regex\",\n                false\n              ],\n              [\n                \"select columns\",\n                \"select_columns\",\n                false\n              ],\n              [\n                \"select columns by indices/slices\",\n                \"select_column_slices\",\n                false\n              ],\n              [\n                \"regex replace value in column\",\n                \"replace\",\n                false\n              ],\n              [\n                \"prepend a line number column\",\n                \"prepend_line_num\",\n                false\n              ],\n              [\n                \"append a line number column\",\n                \"append_line_num\",\n                false\n              ],\n              [\n                \"prepend a column with the dataset name\",\n                \"prepend_dataset_name\",\n                false\n              ],\n              [\n                \"append a column with the dataset name\",\n                \"append_dataset_name\",\n                false\n              ],\n              [\n                \"prepend a column with the given text\",\n                \"prepend_text\",\n                false\n              ],\n              [\n                \"append a column with the given text\",\n                \"append_text\",\n                false\n              ],\n              [\n                \"normalize list columns, replicates row for each item in list\",\n                \"normalize\",\n                false\n              ]\n            ],\n            \"refresh_on_change\": true,\n            \"textable\": false,\n            \"type\": \"select\",\n            \"value\": \"skip\"\n          },\n          \"type\": \"conditional\"\n        }\n      ],\n      \"max\": null,\n      \"min\": 0,\n      \"model_class\": \"Repeat\",\n      \"name\": \"linefilters\",\n      \"title\": \"Filter Tabular Input Lines\",\n      \"type\": \"repeat\"\n    }\n  ],\n  \"is_workflow_compatible\": true,\n  \"job_credentials_context\": null,\n  \"job_id\": null,\n  \"job_remap\": null,\n  \"labels\": [],\n  \"license\": null,\n  \"message\": \"\",\n  \"method\": \"post\",\n  \"model_class\": \"Tool\",\n  \"name\": \"Filter Tabular\",\n  \"panel_section_id\": \"text_manipulation\",\n  \"panel_section_name\": \"Text Manipulation\",\n  \"requirements\": [\n    {\n      \"name\": \"python\",\n      \"version\": \"3.7\"\n    }\n  ],\n  \"sharable_url\": \"https://toolshed.g2.bx.psu.edu/view/iuc/filter_tabular\",\n  \"state_inputs\": {\n    \"comment_char\": false,\n    \"input\": {\n      \"values\": [\n        {\n          \"id\": \"f9cad7b01a472135dd90be057620d4d8\",\n          \"src\": \"hda\"\n        }\n      ]\n    },\n    \"linefilters\": [\n      {\n        \"__index__\": 0,\n        \"filter\": {\n          \"__current_case__\": 8,\n          \"filter_type\": \"regex\",\n          \"regex_action\": \"include_match\",\n          \"regex_pattern\": \"\\\\tENO1\\\\t\"\n        }\n      }\n    ]\n  },\n  \"tool_errors\": null,\n  \"tool_shed_repository\": {\n    \"changeset_revision\": \"26fc6cf774d4\",\n    \"name\": \"filter_tabular\",\n    \"owner\": \"iuc\",\n    \"tool_shed\": \"toolshed.g2.bx.psu.edu\"\n  },\n  \"version\": \"3.3.1\",\n  \"versions\": [\n    \"2.0.0\",\n    \"3.1.0\",\n    \"3.1.2\",\n    \"3.3.0\",\n    \"3.3.1\"\n  ],\n  \"warnings\": null,\n  \"xrefs\": []\n}\n---\n{\n  \"history_id\": \"bbd44e69cb8906b532e08860429cd4b5\",\n  \"input_format\": \"auto\",\n  \"selected_input_format\": \"21.01\",\n  \"tool_id\": \"toolshed.g2.bx.psu.edu/repos/iuc/filter_tabular/filter_tabular/3.3.1\",\n  \"tool_inputs\": {\n    \"comment_char\": false,\n    \"input\": {\n      \"id\": \"f9cad7b01a472135dd90be057620d4d8\",\n      \"src\": \"hda\"\n    },\n    \"linefilters\": {\n      \"0\": {\n        \"filter\": {\n          \"filter_type\": \"regex\",\n          \"regex_action\": \"include_match\",\n          \"regex_pattern\": \"\\\\tENO1\\\\t\"\n        }\n      }\n    }\n  },\n  \"validate_before_submit\": true\n}\n---\n{\n  \"action\": \"/tool_runner/index\",\n  \"citations\": true,\n  \"creator\": null,\n  \"credentials\": [],\n  \"description\": \"\",\n  \"display\": true,\n  \"edam_operations\": [],\n  \"edam_topics\": [],\n  \"enctype\": \"application/x-www-form-urlencoded\",\n  \"errors\": {},\n  \"form_style\": \"regular\",\n  \"has_parameters\": true,\n  \"help\": \"<div class=\\\"section\\\" id=\\\"filter-tabular\\\">\\n<h1>Filter Tabular</h1>\\n<blockquote>\\nFilter a tabular dataset by applying line filters as it is being read.\\nMultiple filters may be used with each filter using the result of the previous filter.</blockquote>\\n<p><strong>Inputs</strong></p>\\n<blockquote>\\nA tabular dataset.</blockquote>\\n<p><strong>Outputs</strong></p>\\n<blockquote>\\nA filtered tabular dataset.</blockquote>\\n<p><strong>Input Line Filters</strong></p>\\n<blockquote>\\n<p>As a tabular file is being read, line filters may be applied:</p>\\n<blockquote>\\n<ul class=\\\"simple\\\">\\n<li>skip leading lines                - skip the first <em>number</em> of lines</li>\\n<li>comment char                      - omit any lines that start with the specified comment character</li>\\n<li>by regex expression matching      - <em>include/exclude</em> lines that match the regex expression</li>\\n<li>select columns                    - choose to include only selected columns in the order specified</li>\\n<li>select columns by indices/slices  - <em>indices or slices</em> of the columns to keep (<a class=\\\"reference external\\\" href=\\\"https://docs.python.org/3/library/stdtypes.html#common-sequence-operations\\\">python_list</a> indexing)</li>\\n<li>regex replace value in column     - replace a field in a column using a regex substitution (good for date reformatting)</li>\\n<li>regex replace value in column     - add a new column using a regex substitution of a column value</li>\\n<li>prepend a line number column      - each line has the <em>ordinal</em> value of the line read by this filter as the first column</li>\\n<li>append a line number column       - each line has the <em>ordinal</em> value of the line read by this filter as the last column</li>\\n<li>prepend a text column             - each line has the text string as the first column</li>\\n<li>append a text column              - each line has the text string as the last column</li>\\n<li>prepend the dataset name          - each line has the <em>dataset name</em> as the first column</li>\\n<li>append the dataset name           - each line has the <em>dataset name</em> as the last column</li>\\n<li>normalize list columns            - replicates the line for each item in the specified list <em>columns</em></li>\\n</ul>\\n</blockquote>\\n</blockquote>\\n<dl class=\\\"docutils\\\">\\n<dt><strong>Line Filtering Example</strong></dt>\\n<dd><p class=\\\"first\\\"><em>(Six filters are applied as the following file is read)</em></p>\\n<pre class=\\\"last literal-block\\\">\\nInput Tabular File:\\n\\n#People with pets\\nPets FirstName           LastName   DOB       PetNames  PetType\\n2    Paula               Brown      24/05/78  Rex,Fluff dog,cat\\n1    Steven              Jones      04/04/74  Allie     cat\\n0    Jane                Doe        24/05/78\\n1    James               Smith      20/10/80  Spot\\n\\n\\nFilter 1 - append a line number column:\\n\\n#People with pets                                                 1\\nPets FirstName           LastName   DOB       PetNames  PetType   2\\n2    Paula               Brown      24/05/78  Rex,Fluff dog,cat   3\\n1    Steven              Jones      04/04/74  Allie     cat       4\\n0    Jane                Doe        24/05/78                      5\\n1    James               Smith      20/10/80  Spot                6\\n\\nFilter 2 - by regex expression matching [include]: '^\\\\d+' (include lines that start with a number)\\n\\n2    Paula               Brown      24/05/78  Rex,Fluff dog,cat   3\\n1    Steven              Jones      04/04/74  Allie     cat       4\\n0    Jane                Doe        24/05/78                      5\\n1    James               Smith      20/10/80  Spot                6\\n\\nFilter 3 - append a line number column:\\n\\n2    Paula               Brown      24/05/78  Rex,Fluff dog,cat   3  1\\n1    Steven              Jones      04/04/74  Allie     cat       4  2\\n0    Jane                Doe        24/05/78                      5  3\\n1    James               Smith      20/10/80  Spot                6  4\\n\\nFilter 4 - regex replace value in column[4]: '(\\\\d+)/(\\\\d+)/(\\\\d+)' '19\\\\3-\\\\2-\\\\1' (convert dates to sqlite format)\\n\\n2    Paula               Brown      1978-05-24  Rex,Fluff dog,cat   3  1\\n1    Steven              Jones      1974-04-04  Allie     cat       4  2\\n0    Jane                Doe        1978-05-24                      5  3\\n1    James               Smith      1980-10-20  Spot                6  4\\n\\nFilter 5 - normalize list columns[5,6]:\\n\\n2    Paula               Brown      1978-05-24  Rex       dog       3  1\\n2    Paula               Brown      1978-05-24  Fluff     cat       3  1\\n1    Steven              Jones      1974-04-04  Allie     cat       4  2\\n0    Jane                Doe        1978-05-24                      5  3\\n1    James               Smith      1980-10-20  Spot                6  4\\n\\nFilter 6 - select columns by indices/slices: '1:6'\\n\\nPaula               Brown      1978-05-24  Rex       dog\\nPaula               Brown      1978-05-24  Fluff     cat\\nSteven              Jones      1974-04-04  Allie     cat\\nJane                Doe        1978-05-24\\nJames               Smith      1980-10-20  Spot\\n</pre>\\n</dd>\\n</dl>\\n</div>\\n\",\n  \"help_format\": \"restructuredtext\",\n  \"hidden\": \"\",\n  \"hidden_versions\": [],\n  \"history_id\": \"bbd44e69cb8906b532e08860429cd4b5\",\n  \"icon\": null,\n  \"id\": \"toolshed.g2.bx.psu.edu/repos/iuc/filter_tabular/filter_tabular/3.3.1\",\n  \"inputs\": [\n    {\n      \"argument\": null,\n      \"default_value\": null,\n      \"edam\": {\n        \"edam_data\": [\n          \"data_0006\"\n        ],\n        \"edam_formats\": [\n          \"format_3475\"\n        ]\n      },\n      \"extensions\": [\n        \"tabular\"\n      ],\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"Tabular Dataset to filter\",\n      \"model_class\": \"DataToolParameter\",\n      \"multiple\": false,\n      \"name\": \"input\",\n      \"optional\": false,\n      \"options\": {\n        \"dce\": [],\n        \"hda\": [\n          {\n            \"hid\": 4,\n            \"id\": \"f9cad7b01a472135dd90be057620d4d8\",\n            \"keep\": true,\n            \"name\": \"(hidden) Tumor vs Normal\",\n            \"src\": \"hda\",\n            \"tags\": []\n          }\n        ],\n        \"hdca\": [\n          {\n            \"hid\": 3,\n            \"id\": \"aaf75d7ec5a84518\",\n            \"keep\": false,\n            \"name\": \"Excel to Tabular on dataset 2\",\n            \"src\": \"hdca\",\n            \"tags\": []\n          }\n        ],\n        \"ldda\": []\n      },\n      \"options_meta\": {\n        \"hda\": {\n          \"has_more\": false,\n          \"limit\": 50,\n          \"offset\": 0,\n          \"total_estimate\": 0\n        },\n        \"hdca\": {\n          \"has_more\": false,\n          \"limit\": 50,\n          \"offset\": 0,\n          \"total_estimate\": 1\n        }\n      },\n      \"pinned\": {\n        \"dce\": [],\n        \"hda\": [],\n        \"hdca\": [],\n        \"ldda\": []\n      },\n      \"refresh_on_change\": true,\n      \"tag\": null,\n      \"text_value\": \"No dataset.\",\n      \"type\": \"data\",\n      \"value\": {\n        \"values\": [\n          {\n            \"id\": \"f9cad7b01a472135dd90be057620d4d8\",\n            \"src\": \"hda\"\n          }\n        ]\n      }\n    },\n    {\n      \"argument\": null,\n      \"default_value\": true,\n      \"falsevalue\": \"\",\n      \"help\": \"\",\n      \"help_format\": \"html\",\n      \"hidden\": false,\n      \"is_dynamic\": false,\n      \"label\": \"exclude lines starting with #\",\n      \"model_class\": \"BooleanToolParameter\",\n      \"name\": \"comment_char\",\n      \"optional\": false,\n      \"refresh_on_change\": false,\n      \"text_value\": \"False\",\n      \"truevalue\": \"--comment_char '#'\",\n      \"type\": \"boolean\",\n      \"value\": false\n    },\n    {\n      \"cache\": [],\n      \"default\": 0,\n      \"help\": null,\n      \"inputs\": [\n        {\n          \"cases\": [\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": nul