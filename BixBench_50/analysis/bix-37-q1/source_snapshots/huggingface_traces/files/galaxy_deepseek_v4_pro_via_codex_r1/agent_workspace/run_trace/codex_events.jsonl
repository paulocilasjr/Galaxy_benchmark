                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"prepend_text\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"text for column\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"column_text\",\n                  \"optional\": true,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"append_text\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"regex pattern\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"regex_pattern\",\n                  \"optional\": true,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                },\n                {\n                  \"argument\": null,\n                  \"display\": null,\n                  \"help\": \"\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"action for regex match\",\n                  \"model_class\": \"SelectToolParameter\",\n                  \"multiple\": false,\n                  \"name\": \"regex_action\",\n                  \"optional\": false,\n                  \"options\": [\n                    [\n                      \"exclude line on pattern match\",\n                      \"exclude_match\",\n                      false\n                    ],\n                    [\n                      \"include line on pattern match\",\n                      \"include_match\",\n                      false\n                    ],\n                    [\n                      \"exclude line if pattern found\",\n                      \"exclude_find\",\n                      false\n                    ],\n                    [\n                      \"include line if pattern found\",\n                      \"include_find\",\n                      false\n                    ]\n                  ],\n                  \"refresh_on_change\": false,\n                  \"textable\": false,\n                  \"type\": \"select\",\n                  \"value\": \"exclude_match\"\n                }\n              ],\n              \"model_class\": \"ConditionalWhen\",\n              \"value\": \"regex\"\n            },\n            {\n              \"inputs\": [\n                {\n                  \"area\": false,\n                  \"argument\": null,\n                  \"datalist\": [],\n                  \"help\": \"example: 1,4,2 or c1,c4,c2(selects the first,fourth, and second columns)\",\n                  \"help_format\": \"html\",\n                  \"hidden\": false,\n                  \"is_dynamic\": false,\n                  \"label\": \"enter column numbers to keep\",\n                  \"model_class\": \"TextToolParameter\",\n                  \"name\": \"columns\",\n                  \"optional\": false,\n                  \"refresh_on_change\": false,\n                  \"type\": \"text\",\n                  \"value\": \"\"\n                }\n              ],\n              \"model_