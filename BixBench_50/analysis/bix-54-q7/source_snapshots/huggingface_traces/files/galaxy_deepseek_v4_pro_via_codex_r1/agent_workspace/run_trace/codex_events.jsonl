{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"ls -la /opt/bixbench; sed -n '1,240p' /opt/bixbench/galaxy_execute_mcp.py; echo '--- core'; sed -n '1,260p' /opt/bixbench/galaxy_execute_mcp_core.py; echo '--- wait'; sed -n '1,240p' /opt/bixbench/galaxy_wait_mcp.py\"","aggregated_output":"total 108\ndrwxr-xr-x 1 root root  4096 Aug 15 14:41 .\ndrwxr-xr-x 1 root root  4096 Aug 15 01:33 ..\ndrwxr-xr-x 2 root root  4096 Aug 15 14:41 __pycache__\n-rw-r--r-- 1 root root  2206 Aug 13 19:07 galaxy_execute_mcp.py\n-rw-r--r-- 1 root root 66358 Aug 13 19:07 galaxy_execute_mcp_core.py\n-rw-r--r-- 1 root root 16540 Aug 13 19:07 galaxy_wait_mcp.py\n#!/usr/bin/env python3\n\"\"\"Model-facing Galaxy execution tools that block until a final outcome.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Literal\n\ntry:\n    import galaxy_execute_mcp_core as _core\nexcept ImportError:  # Source-tree execution and unit tests.\n    import galaxy_execute_mcp as _core\n\n\ndef run_galaxy_tool_and_wait(\n    history_id: str,\n    tool_id: str,\n    tool_inputs: dict[str, Any],\n    input_format: Literal[\"auto\", \"21.01\", \"legacy\"] = \"auto\",\n    validate_before_submit: bool = True,\n    timeout_seconds: int = 5400,\n) -> dict[str, Any]:\n    \"\"\"Submit once and block until terminal state or the total timeout.\"\"\"\n\n    return _core.run_galaxy_tool_and_wait(\n        history_id=history_id,\n        tool_id=tool_id,\n        tool_inputs=tool_inputs,\n        input_format=input_format,\n        validate_before_submit=validate_before_submit,\n        timeout_seconds=timeout_seconds,\n        start_timeout_seconds=timeout_seconds,\n    )\n\n\ndef run_galaxy_udt_and_wait(\n    history_id: str,\n    representation: dict[str, Any],\n    tool_inputs: dict[str, Any],\n    input_format: Literal[\"auto\", \"21.01\", \"legacy\"] = \"auto\",\n    timeout_seconds: int = 5400,\n) -> dict[str, Any]:\n    \"\"\"Create and submit