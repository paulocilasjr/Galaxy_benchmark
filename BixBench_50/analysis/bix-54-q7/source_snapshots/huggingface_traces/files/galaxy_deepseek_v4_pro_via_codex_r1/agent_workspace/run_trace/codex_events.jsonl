{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport sys, json, os, textwrap\nsys.path.insert(0,'/opt/bixbench')\nimport galaxy_execute_mcp_core as core\n\nhistory_id='bbd44e69cb8906b5d46ac47b3edc613c'\nhda_id='f9cad7b01a4721357e93e0eaf87dead0'\n\nrscript = r'''\nset.seed(1)\ndat <- read.csv(\\\"\"'$(inputs.input.path)\", stringsAsFactors = FALSE)\ntidy_area <- dat[!dat$StrainNumber %in% c(\"1\", \"98\"), , drop = FALSE]\nparts <- strsplit(as.character(tidy_area$Ratio), \":\", fixed = TRUE)\nnum <- as.numeric(sapply(parts, `[`, 1))\nden <- as.numeric(sapply(parts, `[`, 2))\ntidy_area$Frequency <- num / (num + den)\n\nlibrary(splines)\nfit_quad <- lm(Area ~ poly(Frequency, 2, raw = TRUE), data = tidy_area)\nfit_cubic <- lm(Area ~ poly(Frequency, 3, raw = TRUE), data = tidy_area)\nfit_spline <- lm(Area ~ ns(Frequency, df = 4), data = tidy_area)\n\nseq_freq <- seq(min(tidy_area$Frequency), max(tidy_area$Frequency), length.out = 1000)\npred_quad <- predict(fit_quad, newdata = data.frame(Frequency = seq_freq), interval = \"confidence\")\npred_cubic <- predict(fit_cubic, newdata = data.frame(Frequency = seq_freq), interval = \"confidence\")\npred_spline <- predict(fit_spline, newdata = data.frame(Frequency = seq_freq), interval = \"confidence\")\n\nidx_quad <- which.max(pred_quad[, \"fit\"])\nidx_cubic <- which.max(pred_cubic[, \"fit\"])\nidx_spline <- which.max(pred_spline[, \"fit\"])\n\nmodels <- list(\n  quadratic = list(fit = fit_quad, idx = idx_quad, pred = pred_quad),\n  cubic = list(fit = fit_cubic, idx = idx_cubic, pred = pred_cubic),\n  spline = list(fit = fit_spline, idx = idx_spline, pred = pred_spline)\n)\n\nout <- data.frame(\n  model = names(models),\n  optimal_frequency = sapply(models, function(z) seq_freq[z$idx]),\n  max_predicted_area = sapply(models, function(z) z$pred[z$idx, \"fit\"]),\n  r_squared = sapply(models, function(z) summary(z$fit)$r.squared),\n  adj_r_squared = sapply(models, function(z) summary(z$fit)$adj.r.squared),\n  f_statistic = sapply(models, function(z) summary(z$fit)$fstatistic[1]),\n  f_p_value = sapply(models, function(z) {\n    fs <- summary(z$fit)$fstatistic\n    pf(fs[1], fs[2], fs[3], lower.tail = FALSE)\n  }),\n  row.names = NULL\n)\nbest_row <- which.max(out$r_squared)\nbest_model <- out$model[best_row]\nbest_max <- out$max_predicted_area[best_row]\nwrite.table(out, \"result.tsv\", sep = \"'\"\\\\t\\\", row.names = FALSE, col.names = TRUE, quote = FALSE)\ncat(\\\"BEST_MODEL\\\", best_model, \\\"BEST_MAX\\\", format(best_max, digits = 12), \\\"\\\\n\\\")\n'''\n\nshell_command = textwrap.dedent(f'''\\\\\nset -eu\nRscript - <<'RS'\n{rscript}\nRS\n''').lstrip('\\\\n')\n\nrepresentation = {\n    'class': 'GalaxyUserTool',\n    'id': 'r-colony-area-model-comparison-v1',\n    'name': 'R Colony Area Model Comparison',\n    'version': '0.1.0',\n    'container': 'quay.io/biocontainers/r-base:4.3.3',\n    'shell_command': shell_command,\n    'inputs': [\n        {'name': 'input', 'type': 'data', 'format': ['csv']}\n    ],\n    'outputs': [\n        {'name': 'result', 'type': 'data', 'format': 'tabular', 'from_work_dir': 'result.tsv'}\n    ]\n}\n\ntool_inputs = {\n    'input': {'src': 'hda', 'id': hda_id}\n}\n\nprint('Starting UDT run...')\nresult = core.run_galaxy_udt_and_wait(\n    history_id=history_id,\n    representation=representation,\n    tool_inputs=tool_inputs,\n    input_format='21.01',\n    timeout_seconds=5400,\n    start_timeout_seconds=5400,\n)\nprint(json.dumps(result, indent=2)[:12000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
