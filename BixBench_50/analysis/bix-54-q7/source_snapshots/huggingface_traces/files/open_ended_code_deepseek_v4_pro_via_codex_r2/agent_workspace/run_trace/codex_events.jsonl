'adj_r2', format(m\"'$adj_r2, digits=15), '\"'AIC', format(m\"'$aic,digits=15), '\"'BIC', format(m\"'$bic,digits=15), '\"'\\\\n')\n cat('peak_x', format(m\"'$peak_x,digits=15), '\"'peak_y', format(m\"'$peak_y_fit,digits=15), '\"'lwr', format(m\"'$peak_y_lwr,digits=15),'\"'upr',format(m\"'$peak_y_upr,digits=15),'\"'\\\\n')\n}\nbest <- models[[which.max(sapply(models,function(m)m\"'$adj_r2))]]\ncat('\"'\\\\nBEST BY ADJ_R2:', best\"'$name, '\"'\\\\n')\ncat('PEAK_X=', format(best\"'$peak_x, digits=15), '\"'\\\\n')\ncat('PEAK_Y=', format(best\"'$peak_y_fit, digits=15), '\"'\\\\n')\nEOF\nRscript /tmp/fit_swarm.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
