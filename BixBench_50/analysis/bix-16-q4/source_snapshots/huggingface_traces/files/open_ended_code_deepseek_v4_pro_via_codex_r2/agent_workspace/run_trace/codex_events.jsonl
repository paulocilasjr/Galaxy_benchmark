{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, scipy.stats as stats, time\nT=time.time()\n# Load common-gene matrices, aligned by stable cell-line ID\nch=pd.read_csv('inputs/CRISPRGeneEffect.csv', nrows=0)\neh=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', nrows=0)\nfirst_c=ch.columns[0]; first_e=eh.columns[0]\ncommon=[c for c in ch.columns[1:] if c in eh.columns[1:]]\ndt={c:np.float32 for c in common}\ncd=pd.read_csv('inputs/CRISPRGeneEffect.csv', usecols=[first_c]+common, index_col=0, dtype=dt, low_memory=False)\ned=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', usecols=[first_e]+common, index_col=0, dtype=dt, low_memory=False)\ncommon_ids=sorted(set(cd.index)&set(ed.index))\ncd=cd.loc[common_ids]; ed=ed.loc[common_ids]\nprint('aligned',cd.shape,'genes',len(common),'load',time.time()-T, flush=True)\n# Spearman: rank each gene's observations across cell lines, average ties\nr_eff=cd.rank(axis=0, method='average', na_option='keep').to_numpy(dtype=np.float64)\nr_expr=ed.rank(axis=0, method='average', na_option='keep').to_numpy(dtype=np.float64)\nprint('ranked',time.time()-T, flush=True)\nvalid=~(np.isnan(r_eff) | np.isnan(r_expr))\nn=valid.sum(axis=0, dtype=np.float64)\n# pairwise-valid centered Pearson on ranks\ndef masked_col(x): return np.where(valid, x, 0.0)\nsx=masked_col(r_eff).sum(axis=0, dtype=np.float64)\nsy=masked_col(r_expr).sum(axis=0, dtype=np.float64)\nsxx=masked_col(r_eff*r_eff).sum(axis=0, dtype=np.float64)\nsyy=masked_col(r_expr*r_expr).sum(axis=0, dtype=np.float64)\nsxy=masked_col(r_eff*r_expr).sum(axis=0, dtype=np.float64)\nmx=sx/n; my=sy/n\ncov=sxy-n*mx*my\nvarx=sxx-n*mx*mx\nvary=syy-n*my*my\ndenom=np.sqrt(np.maximum(varx*vary, 0))\nwith np.errstate(divide='ignore', invalid='ignore'):\n    rho=cov/denom\nrho=np.clip(rho,-1,1)\ndf=n-2\n# scipy spearmanr t approximation\nwith np.errstate(divide='ignore', invalid='ignore'):\n    t=np.sqrt(np.maximum(df,0))*rho/np.sqrt(np.maximum(1-rho*rho, np.finfo(float).tiny))\np=2*stats.t.sf(np.abs(t), df)\nfinite=np.isfinite(p) & np.isfinite(rho) & (n>=3) & (denom>0)\nprint('computable genes',int(finite.sum()),'nonfinite p',int((~finite).sum()),'time',time.time()-T, flush=True)\nprint('n min median max',n.min(),np.median(n),n.max())\nprint('rho finite range',np.nanmin(rho[finite]),np.nanmax(rho[finite]))\nprint('p range min max',p[finite].min(),p[finite].max())\n# BH on valid p only\npvals=p[finite].copy()\nm=pvals.size\norder=np.argsort(pvals, kind='mergesort')\nrank=np.empty(m, dtype=float)\nrank[order]=np.arange(1,m+1)\nq=np.empty(m, dtype=float)\nq[order]=pvals[order]*m/rank[order]\n# enforce monotonic increasing from most significant\nfor i in range(m-2,-1,-1):\n    if q[order[i]] > q[order[i+1]]:\n        q[order[i]] = q[order[i+1]]\nq=np.minimum(q,1.0)\nsig=q<0.05\nprint('sig BH q<0.05',int(sig.sum()),'percent',float(sig.sum())/m*100)\nprint('sig unadjusted p<0.05',int((pvals<0.05).sum()),'percent',float((pvals<0.05).sum())/m*100)\n# directional counts for sanity; raw effect coordinate signs are for raw gene effect (negative-going)\npos=np.isfinite(rho) & (p<0.05) & (rho>0)\nneg=np.isfinite(rho) & (p<0.05) & (rho<0)\nprint('unadj raw positive significant',int(pos.sum()),'negative',int(neg.sum()))\n# BH directional using q mapping\nqs_all=np.full(len(common), np.nan)\nqs_all[finite]=q\nbhsig=qs_all<0.05\nraw_rho=rho\nprint('BH raw-positive',int(((raw_rho>0)&bhsig).sum()),'raw-negative',int(((raw_rho<0)&bhsig).sum()))\nprint('total common genes',len(common),'time total',time.time()-T)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
