{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, scipy.stats as stats, time\nT=time.time()\n# headers\nch=pd.read_csv('inputs/CRISPRGeneEffect.csv', nrows=0)\neh=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', nrows=0)\ncommon=[c for c in ch.columns[1:] if c in eh.columns[1:]]\nprint('common genes',len(common))\ncd=pd.read_csv('inputs/CRISPRGeneEffect.csv', usecols=[ch.columns[0]]+common, index_col=0, low_memory=False)\ned=pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', usecols=[eh.columns[0]]+common, index_col=0, low_memory=False)\nids=sorted(set(cd.index)&set(ed.index))\ncd=cd.loc[ids]; ed=ed.loc[ids]\nprint('aligned',cd.shape,'dtypes',cd.dtypes.iloc[0],ed.dtypes.iloc[0],'load',time.time()-T, flush=True)\n# exact pairwise-complete Spearman for each common gene\npvals=np.empty(len(common), dtype=float)\nrhos=np.empty(len(common), dtype=float)\nns=np.empty(len(common), dtype=float)\nfor i in range(len(common)):\n    x=cd.iloc[:,i].to_numpy(); y=ed.iloc[:,i].to_numpy()\n    v=~(np.isnan(x)|np.isnan(y))\n    n=int(v.sum()); ns[i]=n\n    if n < 3:\n        pvals[i]=np.nan; rhos[i]=np.nan; continue\n    # rank on valid paired observations only\n    rx=stats.rankdata(x[v]); ry=stats.rankdata(y[v])\n    # Pearson of ranks, then t-based two-sided p (same as spearmanr)\n    if np.all(rx==rx[0]) or np.all(ry==ry[0]):\n        pvals[i]=np.nan; rhos[i]=np.nan; continue\n    r=np.corrcoef(rx,ry)[0,1]\n    rhos[i]=r\n    if abs(r) >= 1.0:\n        pvals[i]=0.0\n    else:\n        t=r*np.sqrt((n-2)/(1-r*r))\n        pvals[i]=2*stats.t.sf(abs(t), n-2)\nprint('computed finite p',int(np.isfinite(pvals).sum()),'of',len(common),'time',time.time()-T, flush=True)\nfinite=np.isfinite(pvals)\nprint('n min median max',ns[finite].min(),np.median(ns[finite]),ns[finite].max())\nprint('rho min max',np.nanmin(rhos[finite]),np.nanmax(rhos[finite]))\nprint('p min max',np.nanmin(pvals[finite]),np.nanmax(pvals[finite]))\n# BH correction over all finite tests\np=pvals[finite]; m=p.size\norder=np.argsort(p, kind='mergesort')\nrank=np.empty(m, dtype=float); rank[order]=np.arange(1,m+1)\nq=np.empty(m, dtype=float); q[order]=p[order]*m/rank[order]\nfor i in range(m-2,-1,-1):\n    if q[order[i]] > q[order[i+1]]:\n        q[order[i]] = q[order[i+1]]\nq=np.minimum(q,1.0)\nsig=q<0.05\nprint('BH significant',int(sig.sum()),'percent',float(sig.sum())/m*100)\nprint('unadj p<0.05',int((p<0.05).sum()),'percent',float((p<0.05).sum())/m*100)\nprint('max significant p',p[sig].max() if sig.any() else None,'min non-significant q',q[~sig].min() if (~sig).any() else None)\nprint('directional raw rho: pos/neg BH',int((rhos[finite]>0 & sig).sum()),int((rhos[finite]<0 & sig).sum()))\nprint('total time',time.time()-T)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
