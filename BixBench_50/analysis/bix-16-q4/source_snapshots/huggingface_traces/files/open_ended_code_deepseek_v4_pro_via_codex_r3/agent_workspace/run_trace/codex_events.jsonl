{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/compute.py <<'PY'\nimport pandas as pd, numpy as np, time\nfrom scipy import stats\nimport os\n\nt0=time.time()\ncrispr=pd.read_csv('/workspace/inputs/CRISPRGeneEffect.csv', index_col=0)\nprint('loaded crispr', crispr.shape, 'time', round(time.time()-t0,1), flush=True)\nexpr=pd.read_csv('/workspace/inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', index_col=0)\nprint('loaded expr', expr.shape, 'time', round(time.time()-t0,1), flush=True)\n\ncommon_rows=crispr.index.intersection(expr.index)\ncommon_cols=crispr.columns.intersection(expr.columns)\nprint('common_rows',len(common_rows),'common_cols',len(common_cols), flush=True)\n\nC=crispr.loc[common_rows, common_cols].to_numpy(dtype=float, copy=True)\nE=expr.loc[common_rows, common_cols].to_numpy(dtype=float, copy=True)\n# free dataframes memory\ndel crispr, expr\nn_samples, n_genes = C.shape\nprint('matrix', C.shape, 'time', round(time.time()-t0,1), flush=True)\n\npvals=np.empty(n_genes, dtype=float)\nrhos=np.empty(n_genes, dtype=float)\nvalid_counts=np.empty(n_genes, dtype=int)\n# maybe process in blocks to print progress\nstart=time.time()\nfor j in range(n_genes):\n    c=C[:,j]; e=E[:,j]\n    mask=~np.isnan(c) & ~np.isnan(e)\n    valid_counts[j]=mask.sum()\n    r,p=stats.spearmanr(c[mask], e[mask], nan_policy='omit')\n    rhos[j]=r; pvals[j]=p\nprint('correlation loop done', round(time.time()-start,1), 'total', round(time.time()-t0,1), flush=True)\n\nfinite = np.isfinite(pvals)\nprint('finite p', finite.sum(), 'nan p', n_genes-finite.sum(), flush=True)\nprint('valid min/max', valid_counts.min(), valid_counts.max(), 'median', np.median(valid_counts), flush=True)\nprint('valid <3 count', (valid_counts<3).sum(), 'valid==0', (valid_counts==0).sum(), flush=True)\n# constant cases\ncst=[]; cst_e=0\nfor j in range(n_genes):\n    c=C[:,j]; e=E[:,j]\n    mask=~np.isnan(c) & ~np.isnan(e)\n    if np.all(c[mask]==c[mask][0]) if mask.sum() else False: cst.append(j)\n    if np.all(e[mask]==e[mask][0]) if mask.sum() else False: cst_e += 1\nprint('constant crispr among valid', len(cst), 'constant expr among valid', cst_e, flush=True)\n\n# BH correction, treating nan as p=1 non-significant\np_for_bh=pvals.copy()\np_for_bh[~np.isfinite(p_for_bh)]=1.0\nm=len(p_for_bh)\norder=np.argsort(p_for_bh, kind='mergesort')\nsorted_p=p_for_bh[order]\nbh=np.empty(m, dtype=float)\nbh[order]=sorted_p * m / np.arange(1,m+1)\n# cumulative min from last to first\ncummin=1.0\nfor i in range(m-1,-1,-1):\n    if bh[order][i] < cummin:\n        cummin=bh[order][i]\n    bh[order][i]=cummin\nbh=np.minimum(bh,1.0)\nsig=bh < 0.05\nprint('sig BH < .05', sig.sum(), 'percent', 100*sig.sum()/m, flush=True)\n# directional counts with finite p and sig\nsig_finite = sig & finite\npos = (rhos>0) & sig_finite\nneg = (rhos<0) & sig_finite\nzero = (rhos==0) & sig_finite\nprint('sig pos', pos.sum(), 'sig neg', neg.sum(), 'zero', zero.sum(), flush=True)\nprint('p range finite', np.nanmin(pvals), np.nanmax(pvals), flush=True)\nprint('number p < .05 raw', (p_for_bh<.05).sum(), 'raw percent', 100*(p_for_bh<.05).sum()/m, flush=True)\n# save pvals/rhos optional? no.\nprint('DONE percent', 100*sig.sum()/m, flush=True)\nPY\n/workspace/venv/bin/python /workspace/compute.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
