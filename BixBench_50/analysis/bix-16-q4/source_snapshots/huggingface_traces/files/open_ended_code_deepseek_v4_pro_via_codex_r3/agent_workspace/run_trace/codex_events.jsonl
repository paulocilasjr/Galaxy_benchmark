{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"/workspace/venv/bin/python - <<'PY'\nimport numpy as np, subprocess, tempfile, os\nrng=np.random.default_rng(0)\np=rng.random(10000)\ndef bh(p):\n    p=np.asarray(p,float); p[np.isnan(p)]=1\n    m=len(p); order=np.argsort(p,kind='mergesort'); sp=p[order]\n    q=np.empty(m); q[order]=sp*m/np.arange(1,m+1)\n    cm=1.0\n    for i in range(m-1,-1,-1):\n        cm=min(cm,q[order][i]); q[order][i]=cm\n    return np.minimum(q,1)\nq=bh(p)\n# write p to stdin R via temp\nwith tempfile.NamedTemporaryFile('w',delete=False,dir='/tmp') as f:\n    np.savetxt(f,p)\n    fn=f.name\nrscript=f'''p=scan(\\\"{fn}\\\"); q=p.adjust(p,\\\"BH\\\"); cat(sum(q<.05), \\\"\\\\\\\\n\\\"); cat(sprintf(\\\"%.20f\\\", sum(q<.05)/length(q)), \\\"\\\\\\\\n\\\"); qq=quantile(q,c(.25,.5,.75,.9,.95,.99)); print(qq)'''\nres=subprocess.run(['Rscript','-e',rscript],capture_output=True,text=True)\nprint(res.stdout)\nprint('python sig',(q<.05).sum(),'percent',(q<.05).mean())\nprint('maxdiff',np.max(np.abs(q-p.adjust?)))\n# can't p.adjust python; use R output not values. just compare p raw stats\nprint('p order equal', np.allclose(np.sort(p), np.sort(p)))\nos.unlink(fn)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
