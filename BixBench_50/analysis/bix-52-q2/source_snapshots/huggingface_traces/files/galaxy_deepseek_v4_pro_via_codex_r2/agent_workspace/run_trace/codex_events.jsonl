{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/tmp && python - <<'PY'\nimport csv, collections\nfor fn in ['JD_AgeRelated_CpG_noMT_Final.csv','ZF_AgeRelated_CpG_noMT_Final.csv']:\n    print('====',fn)\n    with open(fn,newline='') as f:\n        r=csv.DictReader(f)\n        rows=list(r)\n    print('cols', list(rows[0].keys()))\n    print('rows',len(rows))\n    print('chroms', collections.Counter(x['Chromosome'] for x in rows))\n    print('unique Pos', len(set(x['Pos'] for x in rows)))\n    print('unique (Pos,Chromosome)', len(set((x['Pos'],x['Chromosome']) for x in rows)))\n    print('unique StartPosition per chrom?', collections.Counter((x['Chromosome'], x['StartPosition']) for x in rows).most_common(3))\n    # methylation range\n    vals=[float(x['MethylationPercentage']) for x in rows]\n    print('meth min/max',min(vals),max(vals), 'rows >90',sum(v>90 for v in vals),'rows <10',sum(v<10 for v in vals),'both',sum(v>90 or v<10 for v in vals))\n    # unique filtered positions\n    filt_pos=set((x['Chromosome'], x['Pos']) for x in rows if (lambda v:v>90 or v<10)(float(x['MethylationPercentage'])))\n    print('unique filtered positions',len(filt_pos))\n    print('filtered rows',sum(1 for x in rows if float(x['MethylationPercentage'])>90 or float(x['MethylationPercentage'])<10))\nPY\ncd /workspace/tmp && for f in *Chromosome_Length.csv; do echo ===\"'$f; cat \"$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
