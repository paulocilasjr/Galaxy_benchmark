{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/run_deseq2.R <<'EOF'\nsuppressPackageStartupMessages(library(DESeq2))\nsuppressPackageStartupMessages(library(org.Mm.eg.db))\ncounts <- read.csv('/workspace/inputs/count.csv', row.names=1, check.names=FALSE)\ncounts <- as.matrix(counts)\nstorage.mode(counts) <- 'integer'\ncoldata <- data.frame(condition=factor(c('KL','KL','KL','WL','WL','WL'), levels=c('KL','WL')), row.names=colnames(counts))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~condition)\ndds <- DESeq(dds)\nres <- results(dds, contrast=c('condition','WL','KL'), alpha=0.05)\nres <- lfcShrink(dds, coef='condition_WL_vs_KL', type='apeglm', res=res, svalue=FALSE)\nwrite.csv(as.data.frame(res), '/workspace/tmp/r_deseq_results_apeglm.csv')\ncat('res_done n=', nrow(res), '\\\\n', sep='')\nfor(pcol in c('pvalue','padj')) {\n mask <- which(\"'!is.na(res[[pcol]]) & res[[pcol]] < 0.05 & !is.na(res$log2FoldChange) & abs(res$log2FoldChange) > 1 & res$baseMean > 10)\n cat(pcol, length(mask), '\"'\\\\n')\n}\n# map significant padj genes to symbols\nmask <- which(\"'!is.na(res$padj) & res$padj < 0.05 & !is.na(res$log2FoldChange) & abs(res$log2FoldChange) > 1 & res$baseMean > 10)\nids <- rownames(res)[mask]\nsym <- mapIds(org.Mm.eg.db, keys=ids, keytype='\"'ENSEMBL', column='SYMBOL', multiVals='first')\nwriteLines(sym[\"'!is.na(sym)], '\"'/workspace/tmp/r_sig_symbols_padj.txt')\ncat('symbols', sum(\"'!is.na(sym)), '\"'\\\\n')\nEOF\n/workspace/tmp/bin/bin/micromamba run -p /workspace/tmp/mamba_env Rscript /workspace/tmp/run_deseq2.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
