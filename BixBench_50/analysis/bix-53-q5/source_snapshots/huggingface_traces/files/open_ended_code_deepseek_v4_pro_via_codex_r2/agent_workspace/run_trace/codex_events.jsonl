{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, mygene\nres = pd.read_csv('tmp/deseq_results.csv', index_col=0)\nmask = (res['padj'] < 0.05) & (res['log2FoldChange'].abs()>1) & (res['baseMean']>10)\nids = res.index[mask].tolist()\nprint('n ids', len(ids), ids[:5])\nmg = mygene.MyGeneInfo()\nout = mg.querymany(ids, scopes='ensembl.gene', fields='symbol', species='mouse', verbose=False)\n# inspect dup/missing\nprint('out len', len(out))\nmissing=[x for x in out if 'notfound' in x]\nprint('missing count', len(missing), missing[:5])\n# build\npairs=[]\nfor d in out:\n if 'symbol' in d:\n  pairs.append((d['query'], d['symbol']))\nprint('symbol pairs', len(pairs), pairs[:10])\n# duplicates per query\nfrom collections import defaultdict\nmp=defaultdict(list)\nfor q,s in pairs: mp[q].append(s)\ndups={q:v for q,v in mp.items() if len(v)>1}\nprint('queries with >1', len(dups), list(dups.items())[:20])\n# choose first unique\nsymbols=[]\nfor q in ids:\n v=mp.get(q)\n if v and len(v)==1: symbols.append(v[0])\nprint('unique symbols', len(symbols))\nopen('tmp/sig_symbols_padj.txt','w').write('\\\\n'.join(symbols))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
