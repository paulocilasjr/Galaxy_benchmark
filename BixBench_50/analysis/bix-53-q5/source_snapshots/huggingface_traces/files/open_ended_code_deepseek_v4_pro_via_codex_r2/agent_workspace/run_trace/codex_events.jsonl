{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/run_deseq2_variants.R <<'EOF'\nsuppressPackageStartupMessages(library(DESeq2))\nsuppressPackageStartupMessages(library(org.Mm.eg.db))\ncounts <- read.csv('/workspace/inputs/count.csv', row.names=1, check.names=FALSE)\ncounts <- as.matrix(counts); storage.mode(counts) <- 'integer'\ncoldata <- data.frame(condition=factor(c('KL','KL','KL','WL','WL','WL'), levels=c('KL','WL')), row.names=colnames(counts))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~condition)\ndds <- DESeq(dds)\nres <- results(dds, contrast=c('condition','WL','KL'), alpha=0.05)\n# normal shrink\nresn <- lfcShrink(dds, coef='condition_WL_vs_KL', type='normal', res=res, svalue=FALSE)\n# apeglm\nresa <- lfcShrink(dds, coef='condition_WL_vs_KL', type='apeglm', res=res, svalue=FALSE)\nwrite.csv(as.data.frame(resn), '/workspace/tmp/r_deseq_results_normal.csv')\nwrite.csv(as.data.frame(resa), '/workspace/tmp/r_deseq_results_apeglm.csv')\nfor(type in c('normal','apeglm')) {\n rr <- if(type=='normal') resn else resa\n for(pcol in c('pvalue','padj')) {\n  mask <- which(\"'!is.na(rr[[pcol]]) & rr[[pcol]] < 0.05 & !is.na(rr$log2FoldChange) & abs(rr$log2FoldChange) > 1 & rr$baseMean > 10)\n  cat(type, pcol, length(mask), '\"'\\\\n')\n  sym <- mapIds(org.Mm.eg.db, keys=rownames(rr)[mask], keytype='ENSEMBL', column='SYMBOL', multiVals='first')\n  writeLines(sym[\"'!is.na(sym)], paste0('\"'/workspace/tmp/r_sig_symbols_',type,'_',pcol,'.txt'))\n }\n}\nEOF\n/workspace/tmp/bin/bin/micromamba run -p /workspace/tmp/mamba_env Rscript /workspace/tmp/run_deseq2_variants.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
