{"type":"item.started","item":{"id":"item_150","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport sys, os, json, time\nsys.path.insert(0,'/opt/bixbench')\nfrom galaxy_wait_mcp import wait_for_galaxy_jobs\n\nkey=open('/run/secrets/galaxy_api_key').read().strip(); g=GalaxyInstance('https://usegalaxy.org', key=key)\nhist='bbd44e69cb8906b5a524c5e2fe3d8d08'\n\ndef read_rows(path):\n    rows=[]\n    for line in open(path):\n        x=line.rstrip('\\\\n').split('\\\\t')\n        if len(x)<6: continue\n        gid,base,lfc,se,pv,padj=x[:6]\n        try: base=float(base); lfc=float(lfc); pv=float(pv); padj=float(padj)\n        except: continue\n        rows.append((gid,base,lfc,pv,padj))\n    return rows\n\ndef write_ids(rows, idx, out):\n    d=[r[0] for r in rows if r[1]>10 and abs(r[2])>1 and r[idx]<0.05]\n    with open(out,'w') as f:\n        for gid in d: f.write(gid+'\\\\n')\n    return len(d)\n\nuploads=[]\nfor typ in ['apeglm','ashr']:\n    rows=read_rows(f'/workspace/tmp/deseq_{typ}.tsv')\n    for label,idx in [('pvalue',3),('padj',4)]:\n        out=f'/workspace/tmp/sig_{typ}_{label}_ids.txt'\n        n=write_ids(rows, idx, out)\n        name=f'sig_{typ}_{label}_ids.txt'\n        r=g.tools.upload_file(out, hist, file_name=name, file_type='tabular', wait=False)\n        job_id=r['jobs'][0]['id']\n        hda_id=r['outputs'][0]['id']\n        uploads.append((name,hda_id,job_id))\n        print('uploaded',name,n,hda_id,job_id)\n# wait uploads\nprint('wait uploads')\nres=wait_for_galaxy_jobs([u[2] for u in uploads], timeout_seconds=1800)\nprint(json.dumps(res,indent=2)[:3000])\n# save mapping\nwith open('/workspace/tmp/variant_uploads.json','w') as f:\n    json.dump([{'name':u[0],'hda_id':u[1],'job_id':u[2]} for u in uploads],f,indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
