{"type":"item.started","item":{"id":"item_152","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\nimport requests, json, sys\nsys.path.insert(0,'/opt/bixbench')\nfrom bioblend.galaxy import GalaxyInstance\nfrom galaxy_wait_mcp import wait_for_galaxy_jobs\nkey=open('/run/secrets/galaxy_api_key').read().strip(); g=GalaxyInstance('https://usegalaxy.org', key=key)\nbase='https://usegalaxy.org/api/datasets'\nitems=json.load(open('/workspace/tmp/variant_annots.json'))\nuploads=[]\nfor r in items:\n    name=r['name']\n    url=f'{base}/{r[\\\"out_id\\\"]}/display'\n    data=requests.get(url,headers={'x-api-key':key}).text\n    out_path=f'/workspace/tmp/{name}.tsv'\n    with open(out_path,'w') as f: f.write(data)\n    syms=[]\n    for i,line in enumerate(data.splitlines()):\n        if i==0: continue\n        parts=line.split('\\\\t')\n        if len(parts)<2: continue\n        sym=parts[1].strip()\n        if sym and sym.upper()\"'!='\"'NA': syms.append(sym.upper())\n    uniq=list(dict.fromkeys(syms))\n    symfile=f'/workspace/tmp/{name}_symbols.txt'\n    with open(symfile,'w') as f:\n        for s in uniq: f.write(s+'\\\\n')\n    up_name=f'{name}_symbols.txt'\n    res=g.tools.upload_file(symfile, hist='bbd44e69cb8906b5a524c5e2fe3d8d08', file_name=up_name, file_type='tabular', wait=False)\n    uploads.append({'name':name,'symfile':symfile,'hda_id':res['outputs'][0]['id'],'job_id':res['jobs'][0]['id'],'n_unique':len(uniq)})\n    print(name,'n_unique',len(uniq),'hda',res['outputs'][0]['id'],'job',res['jobs'][0]['id'])\nprint('wait uploads')\nprint(json.dumps(wait_for_galaxy_jobs([u['job_id'] for u in uploads], timeout_seconds=1800),indent=2)[:3000])\nwith open('/workspace/tmp/variant_symbol_uploads.json','w') as f: json.dump(uploads,f,indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
