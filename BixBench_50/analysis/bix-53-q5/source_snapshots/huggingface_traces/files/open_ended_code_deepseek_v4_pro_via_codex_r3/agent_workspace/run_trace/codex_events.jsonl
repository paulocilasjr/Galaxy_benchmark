{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(DESeq2))\ncat('apeglm loaded', requireNamespace('apeglm', quietly=TRUE), '\\\\n')\ncounts <- read.csv('/workspace/inputs/count.csv', row.names=1, check.names=FALSE)\ncounts <- as.matrix(counts); mode(counts) <- 'integer'\nsamples <- data.frame(row.names=colnames(counts), condition=factor(c('KL','KL','KL','WL','WL','WL'), levels=c('KL','WL')))\ndds <- DESeqDataSetFromMatrix(counts, samples, ~condition)\ndds <- DESeq(dds, quiet=TRUE)\nres <- lfcShrink(dds, contrast=c('condition','WL','KL'), type='apeglm', quiet=TRUE)\nres <- as.data.frame(res); res\"'$geneID <- rownames(res)\nwrite.csv(res, '\"'/workspace/tmp/deseq2_results_apeglm.csv', row.names=FALSE)\nsig <- res[\"'!is.na(res$padj) & res$padj<0.05 & !is.na(res$log2FoldChange) & abs(res$log2FoldChange)>1 & res$baseMean>10,]\nwrite.table(sig[,c('\"'geneID','baseMean','log2FoldChange','padj')], '/workspace/tmp/sig_genes_apeglm.tsv', sep='\\\\t', quote=FALSE, row.names=FALSE)\ncat('apeglm sig count', nrow(sig), '\\\\n')\nRS\n/opt/agent-venv/bin/python - <<'PY'\nimport pandas as pd, mygene, gseapy as gp\nsig=pd.read_csv('/workspace/tmp/sig_genes_apeglm.tsv', sep='\\\\t')\nids=sig['geneID'].tolist(); mg=mygene.MyGeneInfo(); out=mg.querymany(ids, scopes='ensembl.gene', fields='symbol,name', species='mouse', verbose=False)\nrows=[]\nfor item in out:\n q=item.get('query'); sym=item.get('symbol')\n if isinstance(sym,list): sym=sym[0] if sym else None\n if q: rows.append((q,sym))\nann=pd.DataFrame(rows,columns=['geneID','symbol']).drop_duplicates('geneID')\nm=sig.merge(ann,on='geneID',how='left').dropna(subset=['symbol']).sort_values('padj').drop_duplicates('symbol')\nprint('mapped unique', len(m))\ngenes=m['symbol'].tolist()\nenr=gp.enrichr(gene_list=genes, gene_sets='WikiPathways_2019_Mouse', organism='mouse', outdir=None, cutoff=1)\nres=enr.results\nres.to_csv('/workspace/tmp/enrichr_apeglm.tsv', sep='\\\\t', index=False)\ntop20=res.head(20)\nprint('top20 oxidative', top20['Term'].str.lower().str.contains('oxidative').sum(), 'fraction', top20['Term'].str.lower().str.contains('oxidative').sum()/20)\nprint(top20[['Term','P-value']].to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
