{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(DESeq2))\nres <- read.csv('/workspace/tmp/deseq2_results.csv')\n# unshrunken results from previously? We didn't save. Re-run quickly\ncounts <- read.csv('/workspace/inputs/count.csv', row.names=1, check.names=FALSE)\ncounts <- as.matrix(counts); mode(counts) <- 'integer'\nsamples <- data.frame(row.names=colnames(counts), condition=factor(c('KL','KL','KL','WL','WL','WL'), levels=c('KL','WL')))\ndds <- DESeqDataSetFromMatrix(counts, samples, ~condition)\ndds <- DESeq(dds, quiet=TRUE)\nresraw <- results(dds, contrast=c('condition','WL','KL'))\nresraw <- as.data.frame(resraw)\nresraw\"'$geneID <- rownames(resraw)\n# raw p filter (using shrunken lfc from res)\nres2 <- merge(resraw[,c('\"'geneID','pvalue')], res[,c('geneID','baseMean','log2FoldChange')], by='geneID')\nsigp <- res2[\"'!is.na(res2$pvalue) & res2$pvalue < 0.05 & !is.na(res2$log2FoldChange) & abs(res2$log2FoldChange)>1 & res2$baseMean>10,]\nwrite.table(sigp[,c('\"'geneID','baseMean','log2FoldChange','pvalue')], '/workspace/tmp/sig_genes_pvalue.tsv', sep='\\\\t', quote=FALSE, row.names=FALSE)\ncat('raw p sig count', nrow(sigp), '\\\\n')\nRS\n/opt/agent-venv/bin/python - <<'PY'\nimport pandas as pd, mygene\nfor f in ['sig_genes_pvalue.tsv']:\n sig=pd.read_csv('/workspace/tmp/'+f, sep='\\\\t')\n ids=sig['geneID'].tolist(); mg=mygene.MyGeneInfo(); out=mg.querymany(ids, scopes='ensembl.gene', fields='symbol,name', species='mouse', verbose=False)\n rows=[]\n for item in out:\n  q=item.get('query'); sym=item.get('symbol')\n  if isinstance(sym,list): sym=sym[0] if sym else None\n  if q: rows.append((q,sym))\n ann=pd.DataFrame(rows,columns=['geneID','symbol']).drop_duplicates('geneID')\n m=sig.merge(ann,on='geneID',how='left').dropna(subset=['symbol']).sort_values('pvalue').drop_duplicates('symbol')\n print(f, len(sig), 'mapped unique', len(m))\n m['symbol'].to_csv('/workspace/tmp/symbols_pvalue.tsv', sep='\\\\t', index=False, header=False)\nPY\n/opt/agent-venv/bin/python - <<'PY'\nimport pandas as pd, gseapy as gp\ngenes=pd.read_csv('/workspace/tmp/symbols_pvalue.tsv', header=None)[0].tolist()\nprint('n genes', len(genes))\nenr=gp.enrichr(gene_list=genes, gene_sets='WikiPathways_2019_Mouse', organism='mouse', outdir=None, cutoff=1)\nres=enr.results\nres.to_csv('/workspace/tmp/enrichr_pvalue.tsv', sep='\\\\t', index=False)\ntop20=res.head(20)\nmask=top20['Term'].str.lower().str.contains('oxidative', na=False)\nprint('top20 oxidative', mask.sum(), 'fraction', mask.sum()/20)\nprint(top20[['Term','P-value']].to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
