{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"/opt/agent-venv/bin/python - <<'PY'\nimport pandas as pd, mygene, json, time\nsig=pd.read_csv('/workspace/tmp/sig_genes.tsv', sep='\\\\t')\nprint('sig rows', len(sig))\nids=sig['geneID'].tolist()\nmg=mygene.MyGeneInfo()\nout=[]\nchunk=500\nfor i in range(0,len(ids),chunk):\n    sub=ids[i:i+chunk]\n    for attempt in range(3):\n        try:\n            r=mg.querymany(sub, scopes='ensembl.gene', fields='symbol,name', species='mouse', verbose=False)\n            out.extend(r)\n            break\n        except Exception as e:\n            print('retry', attempt, e)\n            time.sleep(2)\n    else:\n        raise RuntimeError('mygene failed')\nprint('responses', len(out))\n# Parse robustly\nrows=[]\nfor item in out:\n    q=item.get('query')\n    sym=item.get('symbol')\n    if isinstance(sym, list): sym=sym[0] if sym else None\n    if not q: continue\n    rows.append({'geneID':q, 'symbol':sym, 'name':item.get('name')})\nann=pd.DataFrame(rows)\n# keep first occurrence per gene, non-null symbol, non-duplicate symbol\nann=ann.drop_duplicates(subset='geneID', keep='first')\nprint('mapped ids', len(ann), 'unique symbols', ann['symbol'].nunique())\nm=sig.merge(ann, on='geneID', how='left')\nprint('merged with symbol', m['symbol'].notna().sum(), 'null', m['symbol'].isna().sum())\n# print some missing\nprint('missing first 20:', m.loc[m['symbol'].isna(),'geneID'].head(20).tolist())\n# deduplicate symbols: first sorted by padj\nm2=m.dropna(subset=['symbol']).sort_values('padj').drop_duplicates(subset='symbol', keep='first')\nprint('unique gene list for enrichr', len(m2))\nm2[['geneID','symbol','padj','log2FoldChange']].to_csv('/workspace/tmp/sig_symbols.tsv', sep='\\\\t', index=False)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
