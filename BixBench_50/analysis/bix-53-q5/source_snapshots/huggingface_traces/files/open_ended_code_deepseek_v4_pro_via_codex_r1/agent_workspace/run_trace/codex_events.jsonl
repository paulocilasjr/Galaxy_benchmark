{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, os, warnings, time\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nraw = pd.read_csv('/workspace/inputs/count.csv', index_col=0)\ncounts = raw.T.astype(int)\nmeta = pd.DataFrame({'condition':['KL']*3 + ['WL']*3}, index=counts.index)\ndds = DeseqDataSet(counts=counts, metadata=meta, design='~condition', ref_level=['condition','KL'], quiet=True)\ndds.deseq2()\nprint('design cols', dds.obsm['design_matrix'].columns.tolist())\nstat = DeseqStats(dds, contrast=['condition','WL','KL'], alpha=0.05, quiet=True)\nstat.summary()\nprint('pre columns', stat.results_df.columns)\nstat.lfc_shrink(coeff='condition_WL_vs_KL')\nres = stat.results_df\nprint('post columns', res.columns)\nprint(res[['baseMean','log2FoldChange','pvalue','padj']].head())\nmask = (res.pvalue<0.05)&(res.baseMean>10)&(res.log2FoldChange.abs()>1)\nprint('sig genes', mask.sum())\nprint('padj sig 0.05 same mask?', ((res.padj<0.05)&(res.baseMean>10)&(res.log2FoldChange.abs()>1)).sum())\nres.to_csv('/workspace/tmp/pydeseq2_results.csv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
