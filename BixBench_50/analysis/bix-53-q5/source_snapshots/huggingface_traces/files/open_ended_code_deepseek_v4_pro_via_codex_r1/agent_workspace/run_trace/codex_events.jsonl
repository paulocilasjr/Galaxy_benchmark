{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, mygene, gseapy, warnings\nwarnings.filterwarnings('ignore')\nres=pd.read_csv('/workspace/tmp/pydeseq2_results.csv',index_col=0)\nfor pcol in ['pvalue','padj']:\n mask=(res[pcol]<0.05)&(res.baseMean>10)&(res.log2FoldChange.abs()>1)\n genes=res.index[mask].tolist()\n mg=mygene.MyGeneInfo(); out=mg.querymany(genes, scopes='ensembl.gene', fields='symbol', species='mouse', verbose=False)\n sym=[]\n for g in genes:\n  rs=[r for r in out if r.get('query')==g and 'symbol' in r]\n  if rs: sym.append(rs[0]['symbol'].upper())\n uniq=[]; seen=set()\n for s in sym:\n  if s not in seen: seen.add(s); uniq.append(s)\n print('\\\\n',pcol,len(genes),'mapped',len(uniq))\n enr=gseapy.enrichr(gene_list=uniq, gene_sets='WikiPathways_2019_Mouse', organism='mouse', no_plot=True, verbose=False)\n r=enr.results\n top=r.head(20)\n print('top20 oxidative', top.Term.str.contains('oxidative',case=False).sum())\n print(top[['Term','P-value']].to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
