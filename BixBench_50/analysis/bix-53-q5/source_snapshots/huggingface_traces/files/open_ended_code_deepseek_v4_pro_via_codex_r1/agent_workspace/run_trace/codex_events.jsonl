{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom gseapy.enrichr import Enrichr\nimport inspect\nprint(inspect.getsource(Enrichr.get_results)[:8000])\nPY\"","aggregated_output":"    def get_results(self, gene_list: str, gene_set_libraries: List[str]) -> Tuple[str, pd.DataFrame]:\n        \"\"\"Get enrichment results from Enrichr API.\"\"\"\n        payload = {\"list\": (None, gene_list), \"description\": (None, self.descriptions)}\n        job_id = self.send_genes(payload, f\"{self.base_url}/addList\")\n\n        res = self.get_results_dataframe(job_id[\"userListId\"], gene_set_libraries)\n        return (job_id[\"shortId\"], res)\n\n","exit_code":0,"status":"completed"}}
