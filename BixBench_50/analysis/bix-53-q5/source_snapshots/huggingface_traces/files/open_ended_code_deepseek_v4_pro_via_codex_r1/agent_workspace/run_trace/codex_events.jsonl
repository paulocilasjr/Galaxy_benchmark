{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, os, warnings\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nraw = pd.read_csv('/workspace/inputs/count.csv', index_col=0)\ncounts = raw.T  # samples x genes\nmeta = pd.DataFrame({'condition':['KL']*3 + ['WL']*3}, index=counts.index)\nprint(counts.shape, counts.index.tolist())\ndds = DeseqDataSet(counts=counts.astype(int), metadata=meta, design='~condition', ref_level=['condition','KL'], quiet=True)\nprint('obs', dds.obs)\ndds.deseq2()\nprint('design cols', dds.obsm['design_matrix'].columns.tolist())\nstat = DeseqStats(dds, quiet=True)\nstat.summary()\nprint('pre-shrink columns', stat.results_df.columns)\nprint(stat.results_df.head(3))\nprint('coeffs', stat.LFC.columns.tolist())\nstat.lfc_shrink(coeff='condition_WL_vs_KL')\nres = stat.results_df\nprint('post-shrink columns', res.columns)\nprint(res[['baseMean','log2FoldChange','pvalue','padj']].head())\nmask = (res.pvalue<0.05)&(res.baseMean>10)&(res.log2FoldChange.abs()>1)\nprint('sig genes', mask.sum())\nprint('NAs pvalue', res.pvalue.isna().sum(), 'NAs baseMean', res.baseMean.isna().sum(), 'NAs lfc', res.log2FoldChange.isna().sum())\nres.to_csv('/workspace/tmp/pydeseq2_results.csv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
