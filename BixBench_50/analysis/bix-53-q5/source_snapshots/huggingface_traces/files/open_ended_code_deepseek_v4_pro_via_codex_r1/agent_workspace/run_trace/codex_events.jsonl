{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, json, os\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('/workspace/inputs/count.csv', index_col=0)\nprint(counts.shape)\nmeta = pd.DataFrame({'condition':['KL']*3 + ['WL']*3}, index=counts.columns)\nprint(meta)\n# set reference level KL\n# In pydeseq2, design factors; reference_level param?\ntry:\n    dds = DeseqDataSet(counts=counts, metadata=meta, design='~condition', reference_level=['condition','KL'])\nexcept Exception as e:\n    print('err with reference',e)\n    dds = DeseqDataSet(counts=counts, metadata=meta, design='~condition')\nprint('obsm', dds.obsm)\nprint('obs', dds.obs)\nprint('design factors', dds.obsm.get('design_matrix').columns.tolist())\ndds.deseq2()\nstat = DeseqStats(dds)\nstat.summary()\nprint(stat.results_df.head())\nprint(stat.results_df.columns)\nstat.lfc_shrink(coeff='condition_WL_vs_KL')\nres = stat.results_df\nprint(res.head())\nprint(res.columns)\nprint('sig raw p, abs lfc >1, baseMean >10:', ((res.pvalue<0.05)&(res.baseMean>10)&(res.log2FoldChange.abs()>1)).sum())\nres.to_csv('/workspace/tmp/pydeseq2_results.csv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
