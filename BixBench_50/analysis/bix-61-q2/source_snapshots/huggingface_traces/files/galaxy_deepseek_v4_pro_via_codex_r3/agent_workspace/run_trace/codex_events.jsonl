rst in a pair","value":"64"},{"label":"Read is the second in a pair","value":"128"},{"label":"Alignment of the read is not primary","value":"256"},{"label":"Read fails platform/vendor quality checks","value":"512"},{"label":"Read is a PCR or optical duplicate","value":"1024"},{"label":"Alignment is supplementary","value":"2048"}],"truncated":false}},{"active_when":[],"label":"Exclude reads with any of the following flags set (the default set is UNMAP,SECONDARY,QCFAIL,DUP or 0x704).","optional":true,"path":"additional_options|skipped_flags","type":"select","value":null,"options":{"count":12,"sample":[{"label":"Read is paired","value":"1"},{"label":"Read is mapped in a proper pair","value":"2"},{"label":"Read is unmapped","value":"4"},{"label":"Mate is unmapped","value":"8"},{"label":"Read is mapped to the reverse strand of the reference","value":"16"},{"label":"Mate is mapped to the reverse strand of the reference","value":"32"},{"label":"Read is the first in a pair","value":"64"},{"label":"Read is the second in a pair","value":"128"},{"label":"Alignment of the read is not primary","value":"256"},{"label":"Read fails platform/vendor quality checks","value":"512"},{"label":"Read is a PCR or optical duplicate","value":"1024"},{"label":"Alignment is supplementary","value":"2048"}],"truncated":false}},{"active_when":[],"label":"Include reads with deletions in depth computation.","optional":false,"path":"additional_options|deletions","type":"boolean","value":false},{"active_when":[],"label":null,"optional":null,"path":"output_options","type":"section","value":null},{"active_when":[],"label":"Print a file header to file.","optional":false,"path":"output_options|header","type":"boolean","value":false}],"history_context":"requested","matching_field_count":13,"name":"Samtools depth","outputs":[{"format":"tabular","label":"${tool.name} on ${on_string}","name":"output"}],"outputs_source":"show_tool","recommended_input_format":"21.01","selectors":[{"active_when":[],"conditional_