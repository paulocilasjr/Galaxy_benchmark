{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nimport subprocess,csv,math\n# get RDS lfc\nrscript=r'''\na<-readRDS('/workspace/inputs/res_1vs97.rds'); b<-readRDS('/workspace/inputs/res_1vs98.rds')\nrna<-attr(a,'rownames',exact=T); rnb<-attr(b,'rownames',exact=T)\nlda<-unclass(attr(a,'listData',exact=T)); ldb<-unclass(attr(b,'listData',exact=T))\ncat('gene\\\\t97\\\\t98\\\\n')\nfor(g in sort(union(rna,rnb))) { ia<-match(g,rna); ib<-match(g,rnb); cat(g, format(lda\"'$log2FoldChange[ia],digits=15), format(ldb$log2FoldChange[ib],digits=15), sep='\"'\\\\t'); cat('\\\\n') }\n'''\nout=subprocess.check_output(['Rscript','-e',rscript]).decode(); rds={}\nfor line in out.strip().splitlines()[1:]:\n g,a,b=line.split('\\\\t'); rds[g]=(float(a),float(b))\nrows=list(csv.DictReader(open('/workspace/tmp/QS_filtered.csv')))\nmaxd1=maxd2=0; n=0\nfor r in rows:\n g=r['GeneID']\n if g not in rds: continue\n d1=abs(float(r['log2FoldChange_ΔrhlI'])-rds[g][0])\n d2=abs(float(r['log2FoldChange_ΔlasI'])-rds[g][1])\n maxd1=max(maxd1,d1); maxd2=max(maxd2,d2); n+=1\nprint('n',n,'max diff rhlI vs rds97',maxd1,'max diff lasI vs rds98',maxd2)\nprint('target in rds',rds.get('PA14_35160'))\nprint('target in QS?', any(r['GeneID']=='PA14_35160' for r in rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
