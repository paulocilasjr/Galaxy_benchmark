{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"cd /workspace && python3 - <<'PY'\nimport subprocess, json, re, zipfile, html, xml.etree.ElementTree as ET, math, statistics\n# get RDS lfc via Rscript output tsv to stdout\nrscript='''\na<-readRDS('/workspace/inputs/res_1vs97.rds'); b<-readRDS('/workspace/inputs/res_1vs98.rds')\nrna<-attr(a,'rownames',exact=T); rnb<-attr(b,'rownames',exact=T)\nlda<-unclass(attr(a,'listData',exact=T)); ldb<-unclass(attr(b,'listData',exact=T))\ncat('gene\\\\\\\\t97\\\\\\\\t98\\\\\\\\n')\nfor(g in sort(union(rna,rnb))) {\n ia<-match(g,rna); ib<-match(g,rnb)\n cat(g, format(lda\"'$log2FoldChange[ia],digits=12), format(ldb$log2FoldChange[ib],digits=12), sep='\"'\\\\\\\\t'); cat('\\\\\\\\n')\n}\n'''\nout=subprocess.check_output(['Rscript','-e',rscript],cwd='/workspace').decode()\nrds={}\nfor line in out.strip().splitlines()[1:]:\n g,a,b=line.split('\\\\t'); rds[g]=(float(a),float(b))\nprint('rds genes',len(rds),'target',rds.get('PA14_35160'))\nns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\ndef parse(path):\n z=zipfile.ZipFile(path); root=ET.fromstring(z.read('word/document.xml'))\n tbl=root.find('.//w:tbl',ns); rows=[]\n for tr in tbl.findall('.//w:tr',ns):\n  cells=[]\n  for tc in tr.findall('.//w:tc',ns):\n   txt=''.join(p.text or '' for p in tc.findall('.//w:t',ns))\n   cells.append(txt)\n  rows.append(cells)\n return rows\nfor path,name in [('/workspace/tmp/s012.docx','S1_HCD'),('/workspace/tmp/s013.docx','S2_colony')]:\n rows=parse(path)[2:]\n for colidx,colname in [(1,'rhlR'),(2,'rhlI')]:\n  vals=[]\n  for r in rows:\n   if len(r)>=3 and r[0].startswith('PA14_') and r[colidx] not in ('','-'):\n    g=r[0].strip()\n    try: x=float(r[colidx])\n    except: continue\n    if g in rds:\n     # compare RDS 97 and 98 to x and -x? both\n     vals.append((x,rds[g][0],rds[g][1],g))\n  # correlations and MAE with direct and negative\n  for ridx in [0,1]:\n   y=[v[ridx] for v in vals]; x=[v[0] for v in vals]\n   if len(x)<2: continue\n   def cor(a,b):\n    ma=sum(a)/len(a); mb=sum(b)/len(b)\n    num=sum((ai-ma)*(bi-mb) for ai,bi in zip(a,b)); da=math.sqrt(sum((ai-ma)**2 for ai in a)); db=math.sqrt(sum((bi-mb)**2 for bi in b))\n    return num/(da*db) if da and db else 0\n   mae=sum(abs(a-b) for a,b in zip(x,y))/len(x)\n   print(name,colname,'vs rds'+(['97','98'][ridx]),'n',len(x),'cor',round(cor(x,y),3),'mae',round(mae,3),'sample',[(g,round(xi,2),round(yi,2)) for g,xi,yi in zip([v[3] for v in vals],x,y)][:3])\n   neg=[-a for a in x]; print('  vs neg cor',round(cor(neg,y),3),'mae',round(sum(abs(a-b) for a,b in zip(neg,y))/len(y),3))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
