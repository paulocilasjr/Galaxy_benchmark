{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport collections\nfiles=['Cele','Ggal','Ncra','Scer']\nsets={}\nfor name in files:\n    path=Path(f'/workspace/tmp/{name}_full_table.tsv')\n    ids=set()\n    counts=collections.Counter()\n    for line in path.read_text().splitlines():\n        if not line or line.startswith('#'): continue\n        parts=line.split('\\\\t')\n        if len(parts)<2: continue\n        busco,status=parts[0],parts[1]\n        if status=='Complete':\n            ids.add(busco)\n        counts[status]+=1\n    sets[name]=ids\n    print(name, 'Complete IDs', len(ids), 'statuses', dict(counts))\ncommon=set.intersection(*sets.values())\nprint('common complete single-copy', len(common))\nfor name, ids in sets.items():\n    print('missing common from', name, sorted(set(ids-common))[:20], 'count', len(ids-common))\nprint('example common', sorted(common)[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
