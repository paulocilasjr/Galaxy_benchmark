{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, zipfile, openpyxl, io, json, re\nD=json.load(open('/workspace/tmp/datasets.json'))\nsrr=[d for d in D if 'CHIP_SRR' in d['name']]\nfor d in srr:\n    path=f\\\"/workspace/tmp/srr_inspect/{d['id']}.zip\\\"\n    if not os.path.exists(path): continue\n    try:\n        wb=openpyxl.load_workbook(path, read_only=False, data_only=True)\n        ws=wb.active\n        # sample-specific label often in row1 col5 or row2? get row1 nonempty and row2 first cols\n        row1=[ws.cell(1,c).value for c in range(1,10)]\n        row2=[ws.cell(2,c).value for c in range(1,10)]\n        # search for '533' in all cells top 3 rows x 33 cols\n        vals=[]\n        for r in range(1,4):\n            for c in range(1,34):\n                v=ws.cell(r,c).value\n                if v is not None and '533' in str(v):\n                    vals.append((r,c,v))\n        if vals:\n            print('MATCH',d['name'],d['id'],vals)\n        else:\n            print('no533header',d['name'],row1,row2)\n    except Exception as e:\n        print('ERR',d['name'],e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
