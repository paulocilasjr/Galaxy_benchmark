{"type":"item.started","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json, os, subprocess, re, time\nD=json.load(open('/workspace/tmp/datasets.json'))\nparents=[d for d in D if re.search(r'CHIP_\\\\d+-(?:PF|PM)\\\\.xlsx\"'$'\"', d['name'])]\nprint('parent count',len(parents))\n# mapping input id -> name\nbyid={d['id']:d['name'] for d in parents}\n# existing conversions\ncompleted={\n 'f9cad7b01a47213559d560eb7b980b30':'c51f0b394078da18', #184-PM\n 'f9cad7b01a4721357dd56463f610dd69':'445e3946499b590e', #381-PM\n}\nactive={\n 'f9cad7b01a4721351647e808d4734982':{\n   'collection':'9fc99fd601598e0e',\n   'job':'bbd44e69cb8906b517f7b64ed70fbfc3'\n }\n}\nkey=open('/run/secrets/galaxy_api_key').read().strip()\nenv=os.environ.copy(); env['GALAXY_API_KEY']=key; env['GALAXY_URL']='https://usegalaxy.org'\nhist='bbd44e69cb8906b5cf3edb9ce6d91819'\ntool='toolshed.g2.bx.psu.edu/repos/ufz/xlsx2tsv/xlsx2tsv/0.2.0+galaxy0'\nrecords=[]\nfor d in parents:\n    iid=d['id']\n    if iid in completed:\n        records.append({'input':iid,'name':d['name'],'collection':completed[iid],'job':None,'status':'completed'})\n    elif iid in active:\n        a=active[iid]; records.append({'input':iid,'name':d['name'],'collection':a['collection'],'job':a['job'],'status':'active'})\n    else:\n        cmd=['galaxy-cli','--history-id',hist,'tool','run',tool,'-i',f'input_file={iid}','--no-wait']\n        p=subprocess.run(cmd,env=env,text=True,capture_output=True)\n        if p.returncode\"'!=0:\n            print('\"'SUBMIT ERROR',d['name'],p.stdout,p.stderr)\n            continue\n        out=p.stdout.strip()\n        try:\n            obj=json.loads(out)\n        except Exception as e:\n            print('parse error',d['name'],out); continue\n        collection=obj['outputs'][0]['id']\n        job=obj['jobs'][0]['id']\n        records.append({'input':iid,'name':d['name'],'collection':collection,'job':job,'status':'new'})\n        print('submitted'