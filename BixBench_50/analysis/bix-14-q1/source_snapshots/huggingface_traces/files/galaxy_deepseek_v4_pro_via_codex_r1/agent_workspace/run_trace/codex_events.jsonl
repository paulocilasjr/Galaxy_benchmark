{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json,os,subprocess,re,tempfile\nD=json.load(open('/workspace/tmp/datasets.json'))\nsrr=[d for d in D if 'CHIP_SRR' in d['name']]\nprint('srr count',len(srr))\n# don't print key\nkey=open('/run/secrets/galaxy_api_key').read().strip()\nenv=os.environ.copy(); env['GALAXY_API_KEY']=key; env['GALAXY_URL']='https://usegalaxy.org'\nos.makedirs('/workspace/tmp/srr_inspect',exist_ok=True)\nout=[]\nfor d in srr:\n    path=f\\\"/workspace/tmp/srr_inspect/{d['id']}.zip\\\"\n    if not os.path.exists(path):\n        p=subprocess.run(['galaxy-cli','--history-id','bbd44e69cb8906b5cf3edb9ce6d91819','dataset','download',d['id'],path],env=env,text=True,capture_output=True)\n        if p.returncode\"'!=0:\n            print('\"'download err',d['name'],p.stdout,p.stderr); continue\n    # inspect zip for sample id 533 and header text\n    import zipfile\n    try:\n        z=zipfile.ZipFile(path)\n        ss=z.read('xl/sharedStrings.xml').decode('utf-8','ignore')\n        has533='533' in ss\n        # extract sample-specific label around 533\n        m=re.findall(r'[\"'^<>]*(533[''^<>]*|[''^<>]*533)[''^<>]*'\"',ss)\n        labels=[]\n        for x in m:\n            if '533' in x: labels.append(x)\n        print(d['name'], 'has533', has533, labels[:10])\n    except Exception as e:\n        print('zip err',d['name'],e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
