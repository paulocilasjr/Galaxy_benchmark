{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"cd /workspace/tmp/inspect && python - <<'PY'\nimport openpyxl, collections\nfn='exome_P1.xlsx'\nwb=openpyxl.load_workbook(fn, read_only=False, data_only=True)\nfor ws in wb.worksheets:\n print('SHEET',ws.title,ws.max_row,ws.max_column)\n # find header row 2\n hdr={ws.cell(2,c).value:c for c in range(1,ws.max_column+1)}\n print(hdr)\n # count col N (SO), O effect, J VAF, E zygosity for rows 3 onward\n counts=collections.Counter(); eff=collections.Counter(); zyg=collections.Counter(); vafs=[]\n for r in range(3,ws.max_row+1):\n  n=ws.cell(r,14).value\n  o=ws.cell(r,15).value\n  e=ws.cell(r,5).value\n  j=ws.cell(r,10).value\n  counts[n]+=1; eff[o]+=1; zyg[e]+=1\n  if isinstance(j,(int,float)): vafs.append(j)\n print('SO',counts)\n print('Effect',eff)\n print('Zyg',zyg)\n print('VAF rows',len(vafs),'min',min(vafs),'max',max(vafs),'lt0.3',sum(x<0.3 for x in vafs))\n # coding SO list likely\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
