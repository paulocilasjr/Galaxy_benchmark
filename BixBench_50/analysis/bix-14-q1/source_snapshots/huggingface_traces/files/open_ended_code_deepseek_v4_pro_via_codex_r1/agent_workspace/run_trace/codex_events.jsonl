{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, glob, os, re\nstatuses={}\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', data_only=True)\nws=wb.active\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    if r[0] is None: continue\n    sid=str(r[0]).strip()\n    statuses[sid]=(r[1],r[3])\nwb.close()\nfiles=sorted(glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\nfmap={}\nfor f in files:\n    b=os.path.basename(f).replace('230209_Exome_GRCh38_CHIP_','').replace('.xlsx','')\n    fmap[b]=f\n# handle SRR with tab in status\nfor sid,(st,blm) in sorted(statuses.items(), key=lambda x:(str(x[0]),)):\n    present = sid in fmap\n    if blm=='Carrier' or st=='Carrier' or present:\n        pass\nprint('total statuses', len(statuses), 'files',len(files))\nprint('Carriers')\nfor sid,(st,blm) in sorted(statuses.items(), key=lambda x:str(x[0])):\n    if blm=='Carrier':\n        print(repr(sid), st, 'file', 'yes' if sid in fmap else 'NO')\nprint('Affected')\nfor sid,(st,blm) in sorted(statuses.items(), key=lambda x:str(x[0])):\n    if blm=='Affected':\n        print(repr(sid), st, 'file', 'yes' if sid in fmap else 'NO')\nprint('Unaffected count',sum(1 for st,blm in statuses.values() if blm=='Unaffected'))\nprint('unmapped files')\nfor sid in sorted(fmap):\n    if sid not in statuses:\n        print(repr(sid))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
