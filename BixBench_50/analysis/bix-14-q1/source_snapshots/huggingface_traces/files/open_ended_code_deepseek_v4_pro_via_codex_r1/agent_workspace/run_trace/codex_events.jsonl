{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, glob, os, re, collections, math\nstatus_file='/workspace/inputs/230215_Trio_Status.xlsx'\nwb=openpyxl.load_workbook(status_file, data_only=True); ws=wb.active\nstatus={}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    sid=row[0]\n    if sid is None: continue\n    s=str(sid).strip()\n    status[s]={'status':str(row[1]).strip() if row[1] is not None else '', 'blm':str(row[3]).strip() if row[3] is not None else ''}\nwb.close()\nfiles=sorted(glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\ndef match_file(sid, fn):\n    b=os.path.basename(fn)\n    name=b.replace('230209_Exome_GRCh38_CHIP_','').replace('.xlsx','')\n    if sid.startswith('SRR'):\n        return name.startswith(sid)\n    # numeric id may have suffix -P1 etc\n    m=re.match(r'\"'^('\"\\\\d+)(?:[-_].*)?\"'$'\"', name)\n    return bool(m) and m.group(1)==sid\ncarrier_files=[]; affected_files=[]; unaff_files=[]; unmatched=[]\nfor sid, info in status.items():\n    ms=[f for f in files if match_file(sid,f)]\n    if info['blm']=='Carrier':\n        carrier_files += ms\n    elif info['blm']=='Affected':\n        affected_files += ms\n    elif info['blm']=='Unaffected':\n        unaff_files += ms\n    else:\n        print('other',sid,info)\n    if not ms:\n        unmatched.append((sid,info))\nprint('statuses',len(status),'files',len(files),'unmatched',unmatched)\nprint('carrier status count',sum(1 for v in status.values() if v['blm']=='Carrier'),'files',len(carrier_files),'unique',len(set(carrier_files)))\nprint('affected files',len(affected_files),'unaff files',len(unaff_files))\nprint('carrier filenames:')\nfor f in carrier_files: print(os.path.basename(f))\n\nCODING={'synonymous_variant','missense_variant','splice_region_variant','stop_gained','stop_lost','start_lost','frameshift_variant','inframe_insertion','inframe_deletion'}\ndef read_counts(fileset):\n    rows=[]; counts=collections.Counter(); missing=0; total=0\n    for f in fileset:\n        wb=openpyxl.load_workbook(f, read_only=False, data_only=True); ws=wb.active\n        n=0\n        for r in ws.iter_rows(min_row=3, values_only=True):\n            vaf=r[9]; so=r[13]\n            if vaf is None:\n                missing+=1\n                continue\n            try:\n                v=float(vaf)\n            except Exception as e:\n                print('bad vaf',f,r[0],repr(vaf),e); continue\n            if v < 0.3:\n                total+=1; n+=1\n                s=str(so) if so is not None else ''\n                coding=any(term in s for term in CODING)\n                counts['vaf_lt']+=1\n                if coding: counts['coding']+=1\n                if 'synonymous_variant' in s: counts['syn']+=1\n                if coding and 'synonymous_variant' in s: counts['coding_syn']+=1\n        wb.close()\n    return counts,missing,total\nfor label,fs in [('carrier',carrier_files),('affected',affected_files),('unaff',unaff_files)]:\n    c,m,t=read_counts(fs)\n    print('\\\\n',label,'files',len(fs),'vaf<.3 rows',t,'missing vaf rows',m)\n    print(c,'fraction coding denominator', c['coding_syn']/c['coding'] if c['coding'] else None)\n    print('naive syn/all vaf<.3', c['syn']/c['vaf_lt'] if c['vaf_lt'] else None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
