{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, glob, collections, os\nfiles=sorted(glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\nseq=collections.Counter(); eff=collections.Counter(); pairs=collections.Counter(); vaf_nonnum=collections.Counter()\nfor f in files:\n    wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n    ws=wb.active\n    rows=list(ws.iter_rows(min_row=3, values_only=True))\n    for r in rows:\n        seq[str(r[13])]+=1\n        eff[str(r[14])]+=1\n        pairs[(str(r[13]),str(r[14]))]+=1\n        v=r[9]\n        if v is not None:\n            try: float(v)\n            except: vaf_nonnum[repr(v)]+=1\n    wb.close()\nprint('files',len(files),'rows',sum(seq.values()))\nprint('\\\\nSEQ top all')\nfor k,v in seq.most_common(): print(v,k)\nprint('\\\\nEFF')\nfor k,v in eff.most_common(): print(v,k)\nprint('\\\\nPAIRS')\nfor k,v in pairs.most_common(): print(v,k)\nprint('vaf nonnum',vaf_nonnum)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
