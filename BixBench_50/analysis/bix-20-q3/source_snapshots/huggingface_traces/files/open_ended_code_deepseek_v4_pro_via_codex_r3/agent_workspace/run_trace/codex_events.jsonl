{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\n# Compute final exact counts with detailed rows\nimport openpyxl, glob, os, re, collections, json\nmeta={}\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', data_only=True); ws=wb.active\nfor r in list(ws.iter_rows(values_only=True))[1:]:\n    meta[str(r[0]).strip()]=(r[2],r[3])\ncarrier={k for k,v in meta.items() if v[1]=='Carrier'}\nrows=[]\nfor f in glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n    full=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"',os.path.basename(f)).group(1); mm=re.match(r'(\\\\d+)',full); sid=mm.group(1) if mm else full\n    if sid not in carrier: continue\n    wb=openpyxl.load_workbook(f, data_only=True); ws=wb.active; rs=list(ws.iter_rows(values_only=True)); hdr=rs[1]\n    for r in rs[2:]:\n        d={hdr[i]:r[i] for i in range(min(len(hdr),len(r))) if hdr[i] is not None}; d['sample']=sid; d['file']=full\n        rows.append(d)\n# exact helper\ndef is_excluded(so):\n    s=str(so).lower()\n    return ('intron' in s or 'intergenic' in s or '_utr' in s or 'untranslated' in s)\ndef vaf_num(d):\n    try: return float(d.get('Variant Allele Freq'))\n    except: return None\n# pipeline order (reference -> region -> vaf -> clinvar)\npipeline=[]\nfor d in rows:\n    if d.get('Zygosity')=='Reference': continue\n    so=d.get('Sequence Ontology (Combined)')\n    if is_excluded(so): continue\n    fv=vaf_num(d)\n    if fv is None or not fv<0.3: continue\n    cl=d.get('Classification')\n    if cl is None: continue\n    pipeline.append(d)\nprint('pipeline N',len(pipeline),'benign/likely',sum(d.get('Classification') in ('Benign','Likely Benign') for d in pipeline))\nprint('by classification',collections.Counter(d.get('Classification') for d in pipeline))\nprint('by SO',collections.Counter(d.get('Sequence Ontology (Combined)') for d in pipeline))\nprint('by effect',collections.Counter(d.get('Effect (Combined)') for d in pipeline))\nprint('samples',collections.Counter(d['sample'] for d in pipeline))\n# Also order clinvar then region\norder2=[d for d in rows if d.get('Zygosity')\"'!='\"'Reference' and (vaf_num(d) is not None and vaf_num(d)<.3) and d.get('Classification') is not None and not is_excluded(d.get('Sequence Ontology (Combined)'))]\nprint('order2 N',len(order2),'B/LB',sum(d.get('Classification') in ('Benign','Likely Benign') for d in order2))\n# all VAF<.3 nonref after region incl missing clinvar\nallreg=[d for d in rows if d.get('Zygosity')\"'!='\"'Reference' and not is_excluded(d.get('Sequence Ontology (Combined)')) and vaf_num(d) is not None and vaf_num(d)<.3]\nprint('allreg N',len(allreg),'with clinvar',sum(d.get('Classification') is not None for d in allreg),'B/LB among clinvar',sum(d.get('Classification') in ('Benign','Likely Benign') for d in allreg if d.get('Classification') is not None))\n# list allreg classifications\nprint('allreg class',collections.Counter(d.get('Classification') for d in allreg))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
