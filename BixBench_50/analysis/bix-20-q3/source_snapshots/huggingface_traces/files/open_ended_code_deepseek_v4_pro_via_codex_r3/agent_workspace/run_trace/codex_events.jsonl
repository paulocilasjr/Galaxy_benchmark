{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl, glob, os, re, collections\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nallso=collections.Counter(); alleffect=collections.Counter(); allclass=collections.Counter(); allzyg=collections.Counter()\nfor f in files:\n    wb=openpyxl.load_workbook(f, read_only=True, data_only=True)\n    ws=wb.active\n    rows=ws.iter_rows(values_only=True)\n    header=None\n    for i,r in enumerate(rows):\n        if i==1:\n            header=r\n        elif i>1 and header:\n            d={header[j]:r[j] for j in range(min(len(header),len(r))) if header[j] is not None}\n            allso[d.get('Sequence Ontology (Combined)')]+=1\n            alleffect[d.get('Effect (Combined)')]+=1\n            allclass[d.get('Classification')]+=1\n            allzyg[d.get('Zygosity')]+=1\nprint('SO values all files')\nfor k,v in allso.most_common(): print(repr(k),v)\nprint('Effect all')\nfor k,v in alleffect.most_common(): print(repr(k),v)\nprint('Class all')\nfor k,v in allclass.most_common(): print(repr(k),v)\nprint('Zyg all')\nfor k,v in allzyg.most_common(): print(repr(k),v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
