{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl, glob, os, re, collections, math\nmeta={}\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', data_only=True); ws=wb.active\nfor r in list(ws.iter_rows(values_only=True))[1:]:\n    meta[str(r[0]).strip()]=(r[2],r[3])\ncarrier={k for k,v in meta.items() if v[1]=='Carrier'}\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nrows=[]\nfor f in files:\n    b=os.path.basename(f); full=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"',b).group(1); mm=re.match(r'(\\\\d+)',full); sid=mm.group(1) if mm else full\n    if sid not in carrier: continue\n    wb=openpyxl.load_workbook(f, data_only=True); ws=wb.active; rows_l=list(ws.iter_rows(values_only=True)); hdr=rows_l[1]\n    for r in rows_l[2:]:\n        d={hdr[i]:r[i] for i in range(min(len(hdr),len(r))) if hdr[i] is not None}\n        d['sample']=sid\n        rows.append(d)\nprint('total rows',len(rows))\n# Count by zygosity and VAF status and classification\nfrom collections import Counter\nfor desc, func in [\n('all rows',lambda d: True),\n('non-ref zyg',lambda d: d.get('Zygosity')\"'!='\"'Reference'),\n('non-ref and VAF<.3',lambda d: d.get('Zygosity')\"'!='\"'Reference' and isinstance(d.get('Variant Allele Freq'),(int,float,str))),\n]:\n    c=Counter(); \n    for d in rows:\n        if func(d):\n            vaf=d.get('Variant Allele Freq'); z=d.get('Zygosity'); cl=d.get('Classification');\n            try: fv=float(vaf) if vaf is not None else None\n            except: fv=None\n            key=(z, fv is not None, (fv<.3 if fv is not None else None), cl is not None)\n            c[key]+=1\n    print('\\\\n',desc)\n    for k,v in sorted(c.items(), key=lambda x:str(x)): print(k,v)\n# Show vaf distribution non-ref numeric\nvals=[]\nfor d in rows:\n    if d.get('Zygosity')\"'!='\"'Reference':\n        vaf=d.get('Variant Allele Freq')\n        try: vals.append(float(vaf))\n        except: pass\nimport statistics\nprint('nonref numeric vaf n',len(vals),'min max',min(vals),max(vals),'<.3',sum(1 for v in vals if v<.3),'< .3 with cl', sum(1 for v,d in zip(vals,[d for d in rows if d.get('Zygosity')\"'!='\"'Reference']) if False))\n# Need detailed below.\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
