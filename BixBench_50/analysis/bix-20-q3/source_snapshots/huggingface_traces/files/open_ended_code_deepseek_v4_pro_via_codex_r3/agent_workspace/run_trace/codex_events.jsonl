{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl, glob, os, re, collections, math\nmeta = {}\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', read_only=True, data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(values_only=True))\nfor r in rows[1:]:\n    sid=str(r[0]).strip()\n    meta[sid]=(r[2],r[3])\ncarrier=set(k for k,v in meta.items() if v[1]=='Carrier')\nprint('carrier metadata', len(carrier), sorted(carrier))\n# map filenames sample part\nfiles=sorted(glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\ncarr_files=[]\nfor f in files:\n    base=os.path.basename(f)\n    m=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"', base)\n    sample=m.group(1) if m else base\n    if sample in carrier:\n        carr_files.append((sample,f))\nprint('carrier files',len(carr_files),[s for s,f in carr_files])\n# aggregate distributions\nvals=collections.Counter(); so=collections.Counter(); eff=collections.Counter(); zyg=collections.Counter(); classif=collections.Counter(); inchip=collections.Counter(); filtercol=collections.Counter()\nvaf_types=collections.Counter(); vaf_nonref_types=collections.Counter(); missing_clin=collections.Counter(); clin_by_zyg=collections.defaultdict(collections.Counter)\nnrows=0\nfor sample,f in carr_files:\n    wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n    ws=wb.active\n    rows=list(ws.iter_rows(values_only=True))\n    hdr=rows[1]\n    for r in rows[2:]:\n        d={hdr[i]:r[i] for i in range(min(len(hdr),len(r))) if hdr[i] is not None}\n        nrows+=1\n        z=d.get('Zygosity'); so[d.get('Sequence Ontology (Combined)')]+=1; eff[d.get('Effect (Combined)')]+=1; zyg[z]+=1\n        cl=d.get('Classification'); classif[cl]+=1\n        inchip[d.get('In_CHIP')]+=1\n        filtercol[d.get('Filter')]+=1\n        vaf=d.get('Variant Allele Freq')\n        if z=='Reference':\n            vaf_types['ref:'+str(type(vaf).__name__)+':'+('None' if vaf is None else 'notnone')]+=1\n        else:\n            vaf_nonref_types[z]+=1\n            if vaf is not None:\n                try:\n                    fv=float(vaf)\n                    vals[z]+=1\n                except Exception as e: pass\n            else:\n                vals['nonref_'+str(z)+'_missing']+=1\n            if cl is None:\n                missing_clin[z]+=1\n            clin_by_zyg[z][cl]+=1\nprint('nrows',nrows)\nprint('zyg',zyg)\nprint('vaf nonref types',vaf_nonref_types)\nprint('vaf ref types',vaf_types)\nprint('so',so)\nprint('eff',eff)\nprint('classif',classif)\nprint('missing_clin_by_zyg',missing_clin)\nprint('inchip',inchip)\nprint('filter',filtercol)\nprint('clin_by_zyg')\nfor k,v in clin_by_zyg.items(): print(k, v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
