{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl, glob, os, re, collections\nmeta={}\nwb=openpyxl.load_workbook('/workspace/inputs/230215_Trio_Status.xlsx', data_only=True); ws=wb.active\nfor r in list(ws.iter_rows(values_only=True))[1:]:\n    meta[str(r[0]).strip()]=(r[2],r[3])\ncarrier={k for k,v in meta.items() if v[1]=='Carrier'}\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nrows=[]\nfor f in files:\n    b=os.path.basename(f); full=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"',b).group(1); mm=re.match(r'(\\\\d+)',full); sid=mm.group(1) if mm else full\n    if sid not in carrier: continue\n    wb=openpyxl.load_workbook(f, data_only=True); ws=wb.active; rs=list(ws.iter_rows(values_only=True)); hdr=rs[1]\n    for r in rs[2:]:\n        d={hdr[i]:r[i] for i in range(min(len(hdr),len(r))) if hdr[i] is not None}; d['sample']=sid\n        rows.append(d)\n\ndef region_excluded(so):\n    if so is None: return False # unknown, not explicitly excluded? but no None in selected\n    s=str(so).lower()\n    if 'intergenic' in s: return True\n    if 'intron' in s: return True\n    if '_utr' in s or s.startswith('utr') or 'untranslated' in s: return True\n    return False\n\n# baseline selection order variants after reference & region before VAF/class? produce several variants\ndef passes(d, region_filter=True, require_clin=True, nonref=True):\n    if nonref and d.get('Zygosity')=='Reference': return False\n    so=d.get('Sequence Ontology (Combined)')\n    if region_filter and region_excluded(so): return False\n    vaf=d.get('Variant Allele Freq')\n    try: fv=float(vaf)\n    except: return False\n    if not (fv<0.3): return False\n    if require_clin and d.get('Classification') is None: return False\n    return True\nfor name, func in [\n('region+splice keep', lambda d: passes(d,True,True)),\n('no region filter', lambda d: passes(d,False,True)),\n('region but exclude splice too? (coding/syn/missense/inframe/frameshift only)', lambda d: d.get('Zygosity')\"'!='\"'Reference' and d.get('Sequence Ontology (Combined)') in ['synonymous_variant','missense_variant','inframe_insertion','inframe_deletion','frameshift_variant'] and float(d.get('Variant Allele Freq') or -1)<.3 and d.get('Classification') is not None),\n]:\n    sel=[d for d in rows if func(d)]\n    ben=[d for d in sel if d.get('Classification') in ('Benign','Likely Benign')]\n    print('\\\\n',name,'N',len(sel),'B/LB',len(ben),'prop',len(ben)/len(sel) if sel else None)\n    print('SO counts',collections.Counter(d.get('Sequence Ontology (Combined)') for d in sel))\n    print('class counts',collections.Counter(d.get('Classification') for d in sel))\n    print('samples',len(set(d['sample'] for d in sel)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
