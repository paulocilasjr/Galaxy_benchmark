{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, glob, os, re, openpyxl\nprint('pandas',pd.__version__)\n# use pandas header row index 1 (third row), parse all 19 carrier files; check selected count\nmeta=pd.read_excel('/workspace/inputs/230215_Trio_Status.xlsx')\nmeta['Sample ID']=meta['Sample ID'].astype(str).str.strip()\ncarrier=set(meta.loc[meta['BLM Mutation Status']=='Carrier','Sample ID'])\nfiles=glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nframes=[]\nfor f in files:\n    full=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"',os.path.basename(f)).group(1); mm=re.match(r'(\\\\d+)',full); sid=mm.group(1) if mm else full\n    if sid not in carrier: continue\n    df=pd.read_excel(f, header=1)\n    df['sample']=sid\n    frames.append(df)\n    print(sid, df.shape)\nallv=pd.concat(frames, ignore_index=True)\nprint('all columns', list(allv.columns))\nprint('total rows', len(allv))\n# check columns names\nzyg='Zygosity'; so='Sequence Ontology (Combined)'; vaf='Variant Allele Freq'; cls='Classification'; inchip='In_CHIP'\nprint(allv[[zyg,so,vaf,cls,inchip]].head())\n# convert vaf\nallv['vafnum']=pd.to_numeric(allv[vaf], errors='coerce')\n# filter\nexcluded=allv[so].astype(str).str.lower().str.contains('intron|intergenic|_utr|untranslated', regex=True, na=False)\nsel=allv[(allv[zyg]\"'!='\"'Reference') & (~excluded) & (allv['vafnum']<0.3) & (allv[cls].notna())]\nprint('pandas pipeline N',len(sel),'B/LB',sel[cls].isin(['Benign','Likely Benign']).sum())\nprint(sel[cls].value_counts(dropna=False))\nprint(sel[so].value_counts(dropna=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
