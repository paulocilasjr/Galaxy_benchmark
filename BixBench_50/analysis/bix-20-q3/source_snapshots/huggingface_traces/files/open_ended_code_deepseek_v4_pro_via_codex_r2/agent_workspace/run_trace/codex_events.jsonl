{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl,glob,collections,math\np=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')[0]\nwb=openpyxl.load_workbook(p,read_only=False,data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(min_row=3,values_only=True))\nprint('file',p,'rows',len(rows))\n# map headers list from row2\nheaders=[c for c in next(ws.iter_rows(min_row=2,max_row=2,values_only=True))]\nprint(headers)\nfor key in ['E','J','C','D','N','O','Z']:\n    # E index4, J9, C2,D3,N13,O14,Z25\n    idx={'E':4,'J':9,'C':2,'D':3,'N':13,'O':14,'Z':25}[key]\n    vals=collections.Counter(str(r[idx]) for r in rows if idx<len(r))\n    print('\\\\n',key,headers[idx] if idx<len(headers) else '?',len(vals))\n    for v,c in vals.most_common(30): print(repr(v),c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
