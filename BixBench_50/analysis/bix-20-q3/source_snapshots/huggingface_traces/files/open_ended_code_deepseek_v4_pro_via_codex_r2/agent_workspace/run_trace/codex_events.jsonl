{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl,glob,os,re,collections\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nprint('files',len(files))\nallvals=collections.Counter()\nallgenes=collections.Counter()\nallO=collections.Counter()\nallAD=collections.Counter()\nallZ=collections.Counter()\nfor p in files:\n    wb=openpyxl.load_workbook(p,read_only=True,data_only=True)\n    ws=wb.active\n    # read all rows with values only from row3\n    it=ws.iter_rows(min_row=3,values_only=True)\n    n=0\n    for r in it:\n        n+=1\n        if len(r)>13: allvals[str(r[13])]+=1\n        if len(r)>14: allO[str(r[14])]+=1\n        if len(r)>28: allAD[str(r[28])]+=1\n        if len(r)>25: allZ[str(r[25])]+=1\n        if len(r)>12: allgenes[str(r[12])]+=1\n    print(os.path.basename(p), n)\nprint('\\\\nSequence Ontology')\nfor k,v in allvals.most_common(): print(k,v)\nprint('\\\\nEffect')\nfor k,v in allO.most_common(): print(k,v)\nprint('\\\\nIn_CHIP')\nfor k,v in allAD.most_common(): print(k,v)\nprint('\\\\nClassification')\nfor k,v in allZ.most_common(): print(k,v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
