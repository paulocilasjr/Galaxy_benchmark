{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl,glob,os,collections,re,math\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\nallN=collections.Counter(); allZ=collections.Counter(); allIn=collections.Counter(); allE=collections.Counter(); allJblank=0; nonref_blank=[]\nfor p in files:\n    wb=openpyxl.load_workbook(p,data_only=True)\n    ws=wb.active\n    n=0\n    for r in ws.iter_rows(min_row=3,values_only=True):\n        n+=1\n        if len(r)>13: allN[str(r[13])]+=1\n        if len(r)>25: allZ[str(r[25])]+=1\n        if len(r)>29: allIn[str(r[29])]+=1\n        if len(r)>4: allE[str(r[4])]+=1\n        # count non-reference J blank\n        if len(r)>9 and str(r[4])\"'!='\"'Reference' and r[9] is None:\n            allJblank+=1; nonref_blank.append((os.path.basename(p),r[0],r[4],r[9],r[13],r[25]))\n    print(os.path.basename(p), n)\nprint('\\\\nN')\nfor k,v in allN.most_common(): print(repr(k),v)\nprint('\\\\nZ Classification')\nfor k,v in allZ.most_common(): print(repr(k),v)\nprint('\\\\nIn_CHIP')\nfor k,v in allIn.most_common(): print(repr(k),v)\nprint('\\\\nZygosity')\nfor k,v in allE.most_common(): print(repr(k),v)\nprint('\\\\nnonref J blank',allJblank)\nfor x in nonref_blank[:30]: print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
