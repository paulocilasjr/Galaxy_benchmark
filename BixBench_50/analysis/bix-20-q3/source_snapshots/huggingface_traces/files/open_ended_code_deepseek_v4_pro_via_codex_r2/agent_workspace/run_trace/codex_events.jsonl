{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport openpyxl,glob,os,re,collections\n# Read trio statuses\nwb=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True)\nws=wb.active\ntrio=[]\nfor r in ws.iter_rows(min_row=2,values_only=True):\n    if r[0] is None: continue\n    trio.append((str(r[0]).strip(), r[1], r[3]))\ncarriers=set()\nfor sid,status,blm in trio:\n    if blm == 'Carrier':\n        carriers.add(sid)\nprint('carrier IDs',sorted(carriers, key=lambda x:(x.isdigit(), x)))\n\nfiles=glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')\ncarrier_files=[]\nfor p in files:\n    b=os.path.basename(p)\n    m=re.search(r'CHIP_(\\\\d+)-', b)\n    if m and m.group(1) in carriers:\n        carrier_files.append(p)\nprint('carrier files',len(carrier_files))\nfor p in sorted(carrier_files): print(os.path.basename(p))\n\nexclude_terms = {'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\n\ndef is_excluded(so):\n    s = str(so)\n    # exact or split by delimiters\n    parts=[x.strip() for x in re.split(r'[,&|/]',s)]\n    return any(t in exclude_terms for t in parts)\n\ncounts=collections.Counter(); rows=[]\nfor p in carrier_files:\n    wb=openpyxl.load_workbook(p,data_only=True)\n    wsv=wb.active\n    for r in wsv.iter_rows(min_row=3,values_only=True):\n        if len(r)<33: continue\n        zyg=r[4]; vaf=r[9]; cls=r[25]; so=r[13]; refalt=r[1]\n        # normalize\n        sample=os.path.basename(p)\n        rows.append((sample,r[0],zyg,vaf,so,cls,r[2],r[3],r[29],r[13]))\n        # broad categories\n        counts['all']+=1\n        if zyg=='Reference': counts['reference']+=1\n        else: counts['nonref']+=1\n        # Apply task filters\n        if zyg=='Reference': continue\n        if vaf is None:\n            counts['no_vaf']+=1; continue\n        try: v=float(vaf)\n        except: \n            counts['vaf_bad']+=1; continue\n        if v>=0.3:\n            counts['vaf_ge_0.3']+=1; continue\n        if is_excluded(so):\n            counts['region_excluded']+=1; continue\n        if cls is None or str(cls).strip()=='':\n            counts['no_clinvar']+=1; continue\n        counts['denominator']+=1\n        if cls in ('Benign','Likely Benign'):\n            counts['benign_likely']+=1\nprint('\\\\ncounts',dict(counts))\nprint('proportion', counts['benign_likely']/counts['denominator'] if counts['denominator'] else None)\n# print rows after filters maybe all\nprint('\\\\nfiltered rows:')\nfor x in rows:\n    sample,pos,zyg,vaf,so,cls,*_=x\n    if zyg=='Reference' or vaf is None: continue\n    try: v=float(vaf)\n    except: continue\n    if v>=0.3: continue\n    if is_excluded(so): continue\n    if cls is None or str(cls).strip()=='': continue\n    print(sample,pos,zyg,vaf,so,cls)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
