{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, gseapy, re, json, warnings\nwarnings.filterwarnings('ignore')\n# load DE files and map symbols\nfrom pathlib import Path\nfiles={\n'pairwise_no_filter':'/workspace/tmp/deseq2_pairwise_6samples.tsv',\n'pairwise_total6_ge10':'/workspace/tmp/deseq2_pairwise_total6_ge10.tsv',\n'all_groups_no_filter':'/workspace/tmp/deseq2_cbd_vs_dmso.tsv',\n}\n# symbol mapping cache from earlier? do mygene per file quickly\nimport mygene\nmg=mygene.MyGeneInfo()\nlib='GO_Biological_Process_2023'\ngs=gseapy.get_library(name=lib, organism='human')\nprint('lib terms', len(gs), 'sample', list(gs.items())[0])\n# background all genes in library (unique)\nbg=sorted({g for genes in gs.values() for g in genes})\nprint('bg size', len(bg))\nmetab_re=re.compile(r'metabol|glycol|glucose|carbohydrate|lipid|fatty acid|cholesterol|oxidative|energy|gluconeogen|monosaccharide|hexose', re.I)\nfor name,path in files.items():\n    res=pd.read_csv(path,sep='\\\\t',index_col=0)\n    sig=res[(res.padj<0.05)&(res.log2FoldChange.abs()>0.5)]\n    ids=sig.index.tolist()\n    out=mg.querymany(ids, scopes='ensembl.gene', fields='symbol', species='human', verbose=False)\n    syms=[]\n    for d in out:\n        s=d.get('symbol')\n        if isinstance(s,list): s=s[0] if s else None\n        if s: syms.append(s)\n    # map direction\n    mp={d.get('query'): (d.get('symbol')[0] if isinstance(d.get('symbol'),list) else d.get('symbol')) for d in out if d.get('symbol')}\n    sig=sig.copy(); sig['symbol']=[mp.get(i) for i in sig.index]; sig=sig.dropna(subset=['symbol'])\n    up=sig[sig.log2FoldChange>0]['symbol'].tolist(); down=sig[sig.log2FoldChange<0]['symbol'].tolist()\n    print('\\\\n===',name,'DEG',len(sig),'up',len(up),'down',len(down))\n    for direction, genes in [('up',up),('down',down)]:\n        genes=[g for g in genes if g in bg]\n        try:\n            er=gseapy.enrich(gene_list=genes, gene_sets=gs, background=bg, outdir=None, no_plot=True, verbose=False)\n            df=er.res2d.copy()\n            # adjusted p column maybe 'Adjusted P-value' in custom? inspect\n            print(direction, 'res2d cols', df.columns.tolist())\n            # normalize cols\n            pcol=[c for c in df.columns if 'Adjusted' in c][0]\n            termcol=[c for c in df.columns if c.lower()=='term'][0]\n            df[pcol]=pd.to_numeric(df[pcol],errors='coerce')\n            sigdf=df[df[pcol]<0.05]\n            print(direction, 'total sig terms',len(sigdf))\n            metab=sigdf[sigdf[termcol].str.contains(metab_re,regex=True,na=False)]\n            print(direction, 'metabolic sig terms',len(metab))\n            print(metab[[termcol,pcol,'Overlap','Genes']].head(20).to_string(index=False))\n        except Exception as e:\n            print(direction,'ERR',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
