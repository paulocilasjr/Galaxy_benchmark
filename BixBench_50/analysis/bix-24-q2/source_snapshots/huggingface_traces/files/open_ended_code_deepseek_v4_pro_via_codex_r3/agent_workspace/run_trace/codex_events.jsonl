{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, time, json\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\n# normalize column names underscores to hyphens, then map layout order\ncol_map = {c: c.replace('_','-') for c in counts.columns}\ncounts = counts.rename(columns=col_map)\nlayout = pd.read_csv('/workspace/inputs/sample_layout.csv')\nprint('layout shape', layout.shape)\n# map by SampleID\nmeta = layout.set_index('SampleID')[['Group']].copy()\n# ensure same order as counts; counts already 1-1 etc\nprint('all samples in meta', meta.index.isin(counts.columns).all())\nprint('counts not in meta', [c for c in counts.columns if c not in meta.index])\ncounts = counts[meta.index]\nmeta['group'] = pd.Categorical(meta['Group'], categories=['DMSO','CBD_IC50','Untreated','Serum_starvation','DMSO_Serum_starvation','Cisplatin_IC50','Cisplatin_IC50_Serum_starvation_16h','CBD_IC50_Serum_starvation_16h','Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h'])\nmeta = meta[['group']]\n# PyDESeq2 wants counts rows samples, columns genes\nct = counts.T.copy()\nct.index.name='sample'\nprint('counts orient', ct.shape, ct.index[:3], ct.columns[:3])\nt0=time.time()\ndds = DeseqDataSet(counts=ct, metadata=meta, design='~group', quiet=False, n_cpus=4)\nprint('built', time.time()-t0)\nt0=time.time()\ndds.deseq2()\nprint('fit done', time.time()-t0)\nprint(dds.obsm['design_matrix'].columns.tolist())\nprint(dds.obsm['design_matrix'].head())\n# save dds? Use pickle maybe but object may contain anndata. Save results via stats.\nt0=time.time()\nstat = DeseqStats(dds, contrast=['group','CBD_IC50','DMSO'], alpha=0.05, independent_filter=True, cooks_filter=True, n_cpus=4)\nstat.summary()\nprint('stats done', time.time()-t0)\nres = stat.results_df.copy()\nprint('res shape', res.shape)\nprint(res.head())\nprint(res['padj'].notna().sum(), (res['padj']<0.05).sum())\nprint('sig', ((res['padj']<0.05)&(res['log2FoldChange'].abs()>0.5)).sum())\nres.to_csv('/workspace/tmp/deseq2_cbd_vs_dmso.tsv', sep='\\\\t')\nprint('saved')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
