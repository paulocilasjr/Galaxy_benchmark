{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, time\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\ncounts = pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\ncounts.columns=[c.replace('_','-') for c in counts.columns]\nlayout=pd.read_csv('/workspace/inputs/sample_layout.csv').set_index('SampleID')\nsel=[s for s in counts.columns if s.split('-')[0] in ['3','7']]\nsub=counts[sel]\n# variants\nvariants={\n 'total6_ge5': sub[sub.sum(axis=1)>=5],\n 'total6_ge10': sub[sub.sum(axis=1)>=10],\n 'pergroup_total_ge5': sub[(sub[[s for s in sel if s.startswith('3-')]].sum(axis=1)>=5)&(sub[[s for s in sel if s.startswith('7-')]].sum(axis=1)>=5)],\n 'each_sample_ge1': sub[(sub>0).sum(axis=1)>=3],\n}\nfor name,ct_counts in variants.items():\n    print('\\\\nVARIANT',name,ct_counts.shape)\n    meta=layout.loc[sel,['Group']].copy(); meta['group']=pd.Categorical(meta['Group'], categories=['DMSO','CBD_IC50'])\n    ct=ct_counts.T.copy(); ct.index.name='sample'\n    dds=DeseqDataSet(counts=ct, metadata=meta[['group']], design='~group', quiet=True, n_cpus=4)\n    dds.deseq2()\n    stat=DeseqStats(dds, contrast=['group','CBD_IC50','DMSO'], alpha=0.05, independent_filter=True, cooks_filter=True, n_cpus=4)\n    stat.summary()\n    res=stat.results_df\n    sig=res[(res.padj<0.05)&(res.log2FoldChange.abs()>0.5)]\n    print('sig',len(sig),'up',(sig.log2FoldChange>0).sum(),'down',(sig.log2FoldChange<0).sum(),'padj_notna',res.padj.notna().sum())\n    res.to_csv(f'/workspace/tmp/deseq2_pairwise_{name}.tsv',sep='\\\\t')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
