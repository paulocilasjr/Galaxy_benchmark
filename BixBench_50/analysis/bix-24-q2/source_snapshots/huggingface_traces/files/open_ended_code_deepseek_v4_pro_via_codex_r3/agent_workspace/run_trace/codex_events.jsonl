{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np, time\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\ncounts = pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\ncol_map={c:c.replace('_','-') for c in counts.columns}; counts=counts.rename(columns=col_map)\nlayout=pd.read_csv('/workspace/inputs/sample_layout.csv').set_index('SampleID')\n# subset DMSO group 3 and CBD group 7\nsel=[s for s in counts.columns if s.split('-')[0] in ['3','7']]\nmeta=layout.loc[sel,['Group']].copy()\nmeta['group']=pd.Categorical(meta['Group'], categories=['DMSO','CBD_IC50'])\nct=counts[sel].T.copy(); ct.index.name='sample'\nprint(ct.shape, meta)\ndds=DeseqDataSet(counts=ct, metadata=meta[['group']], design='~group', quiet=False, n_cpus=4)\ndds.deseq2()\nstat=DeseqStats(dds, contrast=['group','CBD_IC50','DMSO'], alpha=0.05, independent_filter=True, cooks_filter=True, n_cpus=4)\nstat.summary()\nres=stat.results_df\nprint(res.shape, res.padj.notna().sum(), (res.padj<0.05).sum())\nsig=res[(res.padj<0.05)&(res.log2FoldChange.abs()>0.5)]\nprint('sig',len(sig),'up',(sig.log2FoldChange>0).sum(),'down',(sig.log2FoldChange<0).sum())\nres.to_csv('/workspace/tmp/deseq2_pairwise_6samples.tsv',sep='\\\\t')\nprint(sig.sort_values('padj').head(30).to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
