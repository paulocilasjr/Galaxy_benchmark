{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /workspace/staging /workspace/run_trace && python3 - <<'PY'\nimport csv, os, json, time\nfrom bioblend.galaxy import GalaxyInstance\n\nsrc='/workspace/data/counts_raw_unfiltered.csv'\nselected=['1_1','1_2','1_3','7_1','7_2','7_3']\n# read csv and create one tabular per selected sample\nwith open(src, newline='') as f:\n    r=csv.reader(f)\n    header=next(r)\n    # first col is gene ID header empty string, actual values quoted\n    colmap={name.strip('\\\"'): i for i,name in enumerate(header)}\n    rows=list(r)\n\nfor sample in selected:\n    idx=colmap[sample]\n    path=f'/workspace/staging/{sample}.counts.txt'\n    with open(path,'w',newline='') as out:\n        w=csv.writer(out, delimiter='\\\\t', lineterminator='\\\\n')\n        w.writerow(['gene_id', sample])\n        for row in rows:\n            gene=row[0].strip('\\\"')\n            cnt=row[idx]\n            w.writerow([gene, cnt])\n    print(path, os.path.getsize(path))\n# sample sheet\nwith open('/workspace/staging/sample_sheet.tsv','w',newline='') as out:\n    w=csv.writer(out, delimiter='\\\\t', lineterminator='\\\\n')\n    w.writerow(['SampleID','Group'])\n    w.writerow(['1_1','DMSO']); w.writerow(['1_2','DMSO']); w.writerow(['1_3','DMSO'])\n    w.writerow(['7_1','CBD_IC50']); w.writerow(['7_2','CBD_IC50']); w.writerow(['7_3','CBD_IC50'])\nprint('/workspace/staging/sample_sheet.tsv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
