{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, mygene, time, json, os\nres=pd.read_csv('/workspace/de_cbd_vs_dmso.csv',index_col=0)\nbg=res[res['padj'].notna()].index.tolist()\nprint('bg n', len(bg))\nmg=mygene.MyGeneInfo()\nout={}\nchunks=[bg[i:i+1000] for i in range(0,len(bg),1000)]\nfor ci,ch in enumerate(chunks):\n    try:\n        rr=mg.querymany(ch, scopes='ensembl.gene', fields='symbol,entrezgene,go.BP', species='human', returnall=False, verbose=False)\n    except Exception as e:\n        print('chunk error',ci,e)\n        continue\n    for r in rr:\n        q=r.get('query')\n        sym=r.get('symbol')\n        entrez=r.get('entrezgene')\n        bp=[]\n        go=r.get('go')\n        if isinstance(go,dict):\n            bp=go.get('BP') or []\n        elif isinstance(go,list):\n            pass\n        out[q]={'symbol':sym,'entrez':entrez,'bp':bp}\n    if (ci+1)%10==0: print('chunk',ci+1,'of',len(chunks), 'time', time.strftime('%H:%M:%S'))\nprint('mapped entries',len(out),'notfound',sum(1 for x in bg if x not in out))\n# save simple mapping\nwith open('/workspace/ensembl_mapping.json','w') as f: json.dump(out,f)\n# symbols summary\nsyms=[v['symbol'] for v in out.values() if v.get('symbol')]\nprint('with symbol',len(syms),'unique symbols',len(set(syms)))\nprint('with entrez',sum(1 for v in out.values() if v.get('entrez') is not None))\nprint('with BP',sum(1 for v in out.values() if v.get('bp')))\nprint('sample')\nfor x in bg[:5]: print(x,out.get(x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
