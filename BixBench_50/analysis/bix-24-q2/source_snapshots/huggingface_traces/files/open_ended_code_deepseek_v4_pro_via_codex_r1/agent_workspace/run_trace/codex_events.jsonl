{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport requests, re, html\nfrom bs4 import BeautifulSoup\nu='https://pmc.ncbi.nlm.nih.gov/articles/PMC10572413/'\ntext=requests.get(u,headers={'User-Agent':'Mozilla/5.0'}).text\nsoup=BeautifulSoup(text,'lxml')\n# remove scripts/styles\nfor tag in soup(['script','style','nav','header','footer']): tag.decompose()\ncontent=soup.get_text('\\\\n')\ncontent=re.sub(r'\\\\n+', '\\\\n', content)\n# print snippets around metabolism/CBD/GO/method\nfor term in ['carbohydrate metabolism','Glucose metabolism','downregulat','upregulat','Gene Ontology','Biological Process','log2','padj','adjusted p','Reactome','Metascape','enrich']:\n    print('\\\\n===',term,'===')\n    starts=[m.start() for m in re.finditer(term, content, re.I)][:20]\n    for s in starts:\n        print(content[max(0,s-400):s+800].strip()[:1200])\n        print('---')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
