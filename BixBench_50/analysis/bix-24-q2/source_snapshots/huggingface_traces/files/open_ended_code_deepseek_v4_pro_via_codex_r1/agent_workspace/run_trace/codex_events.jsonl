{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, numpy as np, time, warnings\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\nmeta = pd.read_csv('inputs/sample_layout.csv')\nmeta['sample_col'] = meta['SampleID'].str.replace('-', '_', regex=False)\nmeta = meta.set_index('sample_col')\nsub = meta[meta['Group'].isin(['DMSO','CBD_IC50'])].copy()\nsub['group'] = sub['Group'].astype('category')\ncounts_sub = counts.loc[:, sub.index]\nprint('subset', counts_sub.shape, sub)\ncounts_sub = counts_sub.astype(int)\ndds = DeseqDataSet(counts=counts_sub, metadata=sub[['group']], design='~group', quiet=False)\nt=time.time(); dds.deseq2(); print('deseq2 done', time.time()-t)\nt=time.time(); st=DeseqStats(dds, contrast=['group','CBD_IC50','DMSO'], alpha=0.05, quiet=False)\nst.summary(); print('stats done', time.time()-t)\nres=st.results_df.copy()\nprint(res.shape)\nprint(res[['baseMean','log2FoldChange','pvalue','padj']].describe())\nprint('sig', ((res['padj']<0.05)&(res['log2FoldChange'].abs()>0.5)).sum())\nprint('up', ((res['padj']<0.05)&(res['log2FoldChange']>0.5)).sum())\nprint('down', ((res['padj']<0.05)&(res['log2FoldChange']< -0.5)).sum())\nres.to_csv('/workspace/de_cbd_vs_dmso.csv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
