{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd,json,re,warnings\nwarnings.filterwarnings('ignore')\nimport gseapy\nres=pd.read_csv('/workspace/de_cbd_vs_dmso.csv',index_col=0); mp=json.load(open('/workspace/ensembl_mapping.json'))\nbg=sorted(set(v['symbol'] for i in res[res['padj'].notna()].index if (v:=mp.get(i)) and v.get('symbol')))\nsig=res[(res['padj']<0.05)&(res['log2FoldChange'].abs()>0.5)]\ndef syms(ids): return sorted(set(v['symbol'] for i in ids if (v:=mp.get(i)) and v.get('symbol')))\nup=syms(sig[sig['log2FoldChange']>0].index); down=syms(sig[sig['log2FoldChange']<0].index)\npat=re.compile(r'metabolic|catabolic|biosynthetic|glycol|gluconeo|glucose|carbohydrate|pyruvate|respiration|ATP metabolic|lipid|fatty acid|cholesterol|steroid|retinoid|retinal|estrogen|hormone', re.I)\nfor version in ['GO_Biological_Process_2021','GO_Biological_Process_2023','GO_Biological_Process_2026']:\n gs=json.load(open(f'/workspace/{version}.json'))\n print('\\\\nVERSION',version)\n for lab,gl in [('UP',up),('DOWN',down)]:\n  r=gseapy.enrich(gene_list=gl,gene_sets=gs,background=bg,outdir=None,cutoff=0.05,no_plot=True,verbose=False).results\n  sigr=r[r['Adjusted P-value']<0.05].copy()\n  met=sigr[sigr['Term'].str.contains(pat, regex=True, case=False)]\n  core=sigr[sigr['Term'].str.contains(r'glycol|gluconeo|glucose|carbohydrate|pyruvate|ATP metabolic|aerobic respiration|lipid|fatty acid',regex=True,case=False)]\n  print(lab, 'sig',len(sigr),'metabolic-ish',len(met),'core-energy',len(core),'min_adj',round(r['Adjusted P-value'].min(),5) if len(r) else None)\n  if len(core):\n   print(core[['Term','Overlap','Adjusted P-value','Odds Ratio']].head(10).to_string(index=False, max_colwidth=60))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
