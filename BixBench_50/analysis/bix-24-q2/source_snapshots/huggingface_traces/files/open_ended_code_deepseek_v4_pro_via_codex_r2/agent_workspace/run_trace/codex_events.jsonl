{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages({library(DESeq2)})\ncounts <- read.csv('/workspace/inputs/counts_raw_unfiltered.csv', check.names=FALSE, row.names=1)\nlayout <- read.csv('/workspace/inputs/sample_layout.csv', stringsAsFactors=FALSE)\nlayout\"'$SampleID <- gsub('\"'-','_',layout\"'$SampleID)\nkeep <- layout$Group %in% c('\"'DMSO','CBD_IC50')\nlayout <- layout[keep,]\nlayout <- layout[match(colnames(counts), layout\"'$SampleID),]\nlayout <- layout[!is.na(layout$SampleID),]\nlayout$Group <- factor(layout$Group, levels=c('\"'DMSO','CBD_IC50'))\ncts <- counts[, layout\"'$SampleID]\ndds <- DESeqDataSetFromMatrix(as.matrix(cts), data.frame(row.names=layout$SampleID, Group=layout$Group), ~Group)\ndds <- DESeq(dds)\nres <- results(dds, alpha=0.05)\nfor (type in c('\"'apeglm','ashr','normal')) {\n  cat('\\\\n---', type, '---\\\\n')\n  sh <- tryCatch(lfcShrink(dds, coef='Group_CBD_IC50_vs_DMSO', type=type, quiet=TRUE), error=function(e)e)\n  if (inherits(sh,'error')) {cat('error', conditionMessage(sh),'\\\\n'); next}\n  s <- as.data.frame(sh)\n  up <- sum(\"'!is.na(s$padj) & s$padj<0.05 & s$log2FoldChange>0.5, na.rm=TRUE)\n  down <- sum(!is.na(s$padj) & s$padj<0.05 & s$log2FoldChange< -0.5, na.rm=TRUE)\n  cat('\"'up',up,'down',down,'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
