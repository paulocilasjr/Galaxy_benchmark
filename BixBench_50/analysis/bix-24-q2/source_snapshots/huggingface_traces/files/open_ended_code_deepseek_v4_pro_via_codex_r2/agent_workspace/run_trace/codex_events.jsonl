{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages({library(DESeq2); library(org.Hs.eg.db); library(AnnotationDbi); library(GO.db)})\ncounts <- read.csv('/workspace/inputs/counts_raw_unfiltered.csv', check.names=FALSE, row.names=1)\nlayout <- read.csv('/workspace/inputs/sample_layout.csv', stringsAsFactors=FALSE)\nlayout\"'$SampleID <- gsub('\"'-','_',layout\"'$SampleID)\nlayout <- layout[layout$Group %in% c('\"'DMSO','CBD_IC50'),]\nlayout <- layout[match(colnames(counts), layout\"'$SampleID),]; layout <- layout[!is.na(layout$SampleID),]\nlayout$Group <- factor(layout$Group, levels=c('\"'DMSO','CBD_IC50'))\ncts <- counts[, layout\"'$SampleID]\ndds <- DESeqDataSetFromMatrix(as.matrix(cts), data.frame(row.names=layout$SampleID, Group=layout$Group), ~Group)\ndds <- DESeq(dds, quiet=TRUE)\nres <- results(dds, alpha=0.05)\nresdf <- as.data.frame(res); resdf$gene_id <- rownames(resdf)\nup <- rownames(resdf)[!is.na(resdf$padj) & resdf$padj<0.05 & resdf$log2FoldChange>0.5]\ndown <- rownames(resdf)[!is.na(resdf$padj) & resdf$padj<0.05 & resdf$log2FoldChange< -0.5]\nallens <- unique(c(rownames(counts), up, down))\nmap <- select(org.Hs.eg.db, keys=allens, columns='\"'ENTREZID', keytype='ENSEMBL')\nmap <- map[\"'!is.na(map$ENTREZID) & !duplicated(map$ENSEMBL),]\nmetabolic_ids <- unique(c('\"'GO:0008152', GOBPOFFSPRING[['GO:0008152']]))\nbp_go <- select(GO.db, keys=keys(GO.db,'GOID'), columns=c('GOID','TERM','ONTOLOGY'), keytype='GOID')\nbp_go <- bp_go[bp_go\"'$ONTOLOGY=='\"'BP',]\nrun <- function(uni_ens) {\n  ue <- unique(map\"'$ENTREZID[map$ENSEMBL %in% uni_ens])\n  fgu <- unique(map$ENTREZID[map$ENSEMBL %in% up]); fgd <- unique(map$ENTREZID[map$ENSEMBL %in% down])\n  fgu <- fgu[fgu %in% ue]; fgd <- fgd[fgd %in% ue]\n  g2g <- select(org.Hs.eg.db, keys=ue, columns='\"'GO', keytype='ENTREZID')\n  g2g <- g2g[\"'!is.na(g2g$GO) & g2g$GO %in% bp_go$GOID,]\n  tg <- lapply(split(g2g$ENTREZID,g2g$GO), unique)\n  ora <- function(fg) {\n    N<-length(ue); k<-length(fg)\n    rows <- lapply(names(tg), function(go){m<-length(tg[[go]]); if(m<10||m>500)return(NULL); q<-sum(tg[[go]]%in%fg); if(q==0)return(NULL); data.frame(GOID=go,m=m,q=q,p=phyper(q-1,m,N-m,k,lower.tail=FALSE))})\n    tab<-do.call(rbind,rows); if(is.null(tab)||nrow(tab)==0)return(tab); tab$padj<-p.adjust(tab$p,'\"'BH'); tab[tab\"'$padj<0.05,]\n  }\n  su<-ora(fgu); sd<-ora(fgd)\n  c(uni=length(ue), up=length(fgu), down=length(fgd),\n    sigup=if(is.null(su))0 else nrow(su), sigdown=if(is.null(sd))0 else nrow(sd),\n    metup=if(is.null(su))0 else sum(su$GOID%in%metabolic_ids),\n    metdown=if(is.null(sd))0 else sum(sd$GOID%in%metabolic_ids))\n}\ncat('\"'non-NA padj universe:\\\\n'); print(run(rownames(resdf)[\"'!is.na(resdf$padj)]))\ncat('\"'non-NA pvalue universe:\\\\n'); print(run(rownames(resdf)[\"'!is.na(resdf$pvalue)]))\ncat('\"'all count rows universe:\\\\n'); print(run(rownames(counts)))\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
