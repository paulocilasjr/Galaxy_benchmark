{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, tempfile, pathlib, subprocess, statistics, re\nroot=pathlib.Path('/workspace/tmp'); root.mkdir(exist_ok=True)\ndef newick_edges(s):\n    # remove comments, whitespace\n    s=s.strip()\n    # find all length colon numbers including scientific\n    return [float(x) for x in re.findall(r':([0-9.]+(?:[eE][+-]?\\\\d+)?)', s)]\nfor group,zpath in [('animals','inputs/scogs_animals.zip'),('fungi','inputs/scogs_fungi.zip')]:\n    td=tempfile.mkdtemp(prefix=f'manual_{group}_', dir=str(root))\n    maxdiff=0; bad=0; n=0; vals=[]\n    with zipfile.ZipFile(zpath) as zf:\n        for name in zf.namelist():\n            b=name.split('/')[-1]\n            if not b.endswith('.treefile'): continue\n            p=pathlib.Path(td)/b; data=zf.read(name); p.write_bytes(data)\n            s=data.decode()\n            manual=sum(newick_edges(s))\n            r=subprocess.run(['phykit','total_tree_length',str(p)],capture_output=True,text=True)\n            phy=float(r.stdout.strip().split()[0])\n            diff=abs(manual-phy); maxdiff=max(maxdiff,diff); n+=1; vals.append(phy)\n            if diff>1e-6: bad+=1\n    print(group,'n',n,'maxdiff',maxdiff,'bad',bad,'median manual/phy',statistics.median(vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
