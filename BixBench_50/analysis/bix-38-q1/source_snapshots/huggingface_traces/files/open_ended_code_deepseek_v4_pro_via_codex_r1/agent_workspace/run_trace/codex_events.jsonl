{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, tempfile, os, subprocess, pathlib, statistics, json\nroot=pathlib.Path('/workspace/tmp')\nroot.mkdir(exist_ok=True)\nresults={}\nfor group, zpath in [('animals','inputs/scogs_animals.zip'),('fungi','inputs/scogs_fungi.zip')]:\n    td=tempfile.mkdtemp(prefix=f'{group}_trees_', dir=str(root))\n    vals=[]\n    with zipfile.ZipFile(zpath) as zf:\n        for n in zf.namelist():\n            b=n.split('/')[-1]\n            if not b.endswith('.treefile'):\n                continue\n            p=pathlib.Path(td)/b\n            p.write_bytes(zf.read(n))\n            proc=subprocess.run(['phykit','total_tree_length',str(p)],capture_output=True,text=True,check=True)\n            lines=[l for l in proc.stdout.splitlines() if l.strip()]\n            val=float(lines[0].strip().split()[0])\n            vals.append((b,val))\n    results[group]=vals\n    print(group, 'count', len(vals), 'median', statistics.median(v for _,v in vals))\n    out=pathlib.Path('/workspace/tmp')/f'{group}_tree_lengths.tsv'\n    out.write_text('\\\\n'.join(f'{b}\\\\t{v}' for b,v in vals)+'\\\\n')\n    print('sample first 5', vals[:5])\n# fold changes\nam=statistics.median(v for _,v in results['animals'])\nfm=statistics.median(v for _,v in results['fungi'])\nprint('animals_median',am,'fungi_median',fm,'fungi/animals',fm/am,'animals/fungi',am/fm)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
