{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, os, collections\nfor z in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    with zipfile.ZipFile(z) as zf:\n        names=zf.namelist()\n    print(z, len(names))\n    bysuf=collections.Counter()\n    for n in names:\n        # basename after slash\n        b=n.split('/')[-1]\n        if '.treefile' in b: bysuf['treefile']+=1\n        elif b.endswith('.iqtree'): bysuf['iqtree']+=1\n        elif '.mafft.clipkit' in b and not any(x in b for x in ['.model.gz','.ckp.gz','.log','.mldist','.bionj','.treefile','.iqtree']): bysuf['clipkit']+=1\n        elif b.endswith('.mafft'): bysuf['mafft']+=1\n        elif not any(x in b for x in ['.mafft','.clipkit','.model','.ckp','.log','.mldist','.bionj','.treefile','.iqtree']): bysuf['faa']+=1\n        else: bysuf['other']+=1\n    print(bysuf)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
