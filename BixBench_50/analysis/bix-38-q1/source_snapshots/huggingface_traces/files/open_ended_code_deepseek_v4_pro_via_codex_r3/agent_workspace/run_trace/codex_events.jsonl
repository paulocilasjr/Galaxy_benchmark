{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nfrom pathlib import Path\nimport collections\nfor g in ['scogs_animals','scogs_fungi']:\n    files=list(Path('work',g).iterdir())\n    bybase=collections.defaultdict(list)\n    for f in files:\n        name=f.name\n        for suf in ['.faa.mafft.clipkit.treefile','.faa.mafft.clipkit.iqtree','.faa.mafft.clipkit','.faa.mafft','.faa']:\n            if name.endswith(suf):\n                base=name[:-len(suf)]\n                bybase[base].append(suf)\n                break\n    print(g, 'bases',len(bybase))\n    for suf in ['.faa','.faa.mafft','.faa.mafft.clipkit','.faa.mafft.clipkit.iqtree','.faa.mafft.clipkit.treefile']:\n        n=sum(1 for l in bybase.values() if suf in l)\n        print(' ',suf,n)\n    print('bases tree',len([b for b,l in bybase.items() if '.faa.mafft.clipkit.treefile' in l]))\n    if g=='scogs_animals':\n        animal=set(bybase)\n    else: fungi=set(bybase)\nprint('overlap bases',len(animal & fungi))\nprint('animal-only',len(animal-fungi), 'fungi-only', len(fungi-animal))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
