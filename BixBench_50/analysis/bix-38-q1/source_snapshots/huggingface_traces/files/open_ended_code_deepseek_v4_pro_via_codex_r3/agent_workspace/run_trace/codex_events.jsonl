{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python - <<'PY'\nimport zipfile, collections\nfor fn in ['inputs/scogs_animals.zip','inputs/scogs_fungi.zip']:\n    z=zipfile.ZipFile(fn)\n    names=z.namelist()\n    print(fn, len(names))\n    ext=collections.Counter()\n    for n in names:\n        # suffix\n        parts=n.split('.')\n        # last meaningful extensions\n        if n.endswith('.treefile'): ext['treefile']+=1\n        elif n.endswith('.iqtree'): ext['iqtree']+=1\n        elif n.endswith('.mafft'): ext['mafft']+=1\n        elif n.endswith('.clipkit'): ext['clipkit']+=1\n        elif n.endswith('.model.gz'): ext['model']+=1\n        elif n.endswith('.bionj'): ext['bionj']+=1\n        elif n.endswith('.mldist'): ext['mldist']+=1\n        elif n.endswith('.ckp.gz'): ext['ckp']+=1\n        elif n.endswith('.log'): ext['log']+=1\n        elif n.endswith('.faa'): ext['faa']+=1\n        else: ext['other']+=1\n    print(ext)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
