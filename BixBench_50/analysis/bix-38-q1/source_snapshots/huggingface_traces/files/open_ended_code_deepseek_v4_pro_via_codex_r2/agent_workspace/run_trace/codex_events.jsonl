{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"/workspace/tmp/phykit_venv/bin/python - <<'PY'\nimport glob, os, re, zipfile, collections\nfrom Bio import SeqIO\nfor grp,path in [('animals','/workspace/tmp/scogs_animals_extracted'),('fungi','/workspace/tmp/scogs_fungi_extracted')]:\n    tree_ids={os.path.basename(f).split('.')[0] for f in glob.glob(path+'/*.treefile')}\n    counts=collections.Counter(); tree_count_status=collections.Counter()\n    for f in glob.glob(path+'/*.faa'):\n        gid=os.path.basename(f).split('.')[0]\n        n=sum(1 for _ in SeqIO.parse(f,'fasta'))\n        counts[n]+=1\n        tree_count_status[(n,gid in tree_ids)]+=1\n    print('\\\\n',grp,'raw faa',len(glob.glob(path+'/*.faa')))\n    print(' seq count distribution',sorted(counts.items()))\n    print(' by n and tree status',sorted(tree_count_status.items()))\n    # clipkit counts similarly\n    counts2=collections.Counter(); status2=collections.Counter()\n    for f in glob.glob(path+'/*.clipkit'):\n        gid=os.path.basename(f).split('.')[0]\n        n=sum(1 for _ in SeqIO.parse(f,'fasta'))\n        counts2[n]+=1; status2[(n,gid in tree_ids)]+=1\n    print(' clipkit count distribution',sorted(counts2.items()))\n    print(' clipkit status',sorted(status2.items()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
