{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"/workspace/tmp/phykit_venv/bin/python - <<'PY'\nimport glob, re, statistics\nfrom collections import Counter\n# parse newick total branch length robustly via simple regex numbers after colon\ndef tree_len(path):\n    s=open(path).read().strip()\n    # all branch lengths after colon before comma/paren\n    nums=re.findall(r':([-+]?\\\\d*\\\\.?\\\\d+(?:[eE][-+]?\\\\d+)?)', s)\n    return sum(float(x) for x in nums)\nfor grp,path in [('animals','/workspace/tmp/scogs_animals_extracted'),('fungi','/workspace/tmp/scogs_fungi_extracted')]:\n    vals=[]\n    for f in glob.glob(path+'/*.treefile'):\n        vals.append(tree_len(f))\n    vals=sorted(vals)\n    print(grp,'n',len(vals),'min',min(vals),'max',max(vals))\n    # quantile med\n    n=len(vals)\n    med=(vals[n//2] if n%2 else (vals[n//2-1]+vals[n//2])/2)\n    print(' exact median',repr(med))\n    # rounded phykit median\n    rvals=[round(v,4) for v in vals]\n    rvals=sorted(rvals)\n    n=len(rvals); rmed=(rvals[n//2] if n%2 else (rvals[n//2-1]+rvals[n//2])/2)\n    print(' rounded median',repr(rmed))\n# store exacts\nall={}\nfor grp,path in [('animals','/workspace/tmp/scogs_animals_extracted'),('fungi','/workspace/tmp/scogs_fungi_extracted')]:\n    vals=[tree_len(f) for f in glob.glob(path+'/*.treefile')]\n    vals=sorted(vals); n=len(vals); med=(vals[n//2] if n%2 else (vals[n//2-1]+vals[n//2])/2); all[grp]=(vals,med)\nprint('ratio exact fungi/animal',all['fungi'][1]/all['animals'][1])\n# using phykit rounded medians\nprint('ratio rounded medians',3.0962/1.4219)\n# per-phykit outputs stored\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
