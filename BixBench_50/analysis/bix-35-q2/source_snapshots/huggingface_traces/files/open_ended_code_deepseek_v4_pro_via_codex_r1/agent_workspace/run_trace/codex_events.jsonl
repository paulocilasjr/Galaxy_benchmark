{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/work\npython - <<'PY'\nimport os,re,subprocess\nfrom scipy.stats import mannwhitneyu\npat=re.compile(r'\"'^('\"\\\\d+at\\\\d+)\\\\.faa\\\\.mafft\\\\.clipkit\\\\.treefile\"'$'\"')\nfor d in ['scogs_animals','scogs_fungi']:\n    files={}\n    for fn in os.listdir(d):\n        m=pat.match(fn)\n        if m: files[m.group(1)]=os.path.join(d,fn)\n    rates={}\n    for g,f in files.items():\n        out=subprocess.check_output(['python','-m','phykit','evo_rate',f],text=True).strip()\n        rates[g]=float(out)\n    print(d,len(rates))\n    globals()[d+'_rates']=rates\nA=globals()['scogs_animals_rates']; F=globals()['scogs_fungi_rates']\ncommon=sorted(set(A)&set(F))\nprint('common',len(common))\nfor label,a,f in [('all',[A[g] for g in A],[F[g] for g in F]),('common',[A[g] for g in common],[F[g] for g in common])]:\n    for order in ['AF','FA']:\n        x,y=(a,f) if order=='AF' else (f,a)\n        res=mannwhitneyu(x,y,alternative='two-sided')\n        print(label,order,'U',res.statistic)\n    # manual U1/U2\n    import scipy.stats as st\n    vals=a+f; ranks=st.rankdata(vals); R1=sum(ranks[:len(a)]); U1=len(a)*len(f)+len(a)*(len(a)+1)/2-R1; U2=len(a)*len(f)-U1\n    print('manual',U1,U2,'n',len(a),len(f))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
