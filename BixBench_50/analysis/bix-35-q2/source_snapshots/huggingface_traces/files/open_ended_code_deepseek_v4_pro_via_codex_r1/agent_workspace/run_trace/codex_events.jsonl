{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/work\npython - <<'PY'\nimport os, subprocess, re, math\nfrom scipy.stats import mannwhitneyu\nfor d in ['scogs_animals','scogs_fungi']:\n    files=sorted(os.path.join(dp,fn) for dp,_,fns in os.walk(d) for fn in fns if fn.endswith('.treefile'))\n    rates=[]\n    for f in files:\n        out=subprocess.check_output(['python','-m','phykit','evo_rate',f], text=True).strip()\n        rates.append(float(out))\n    print(d, len(rates), min(rates), max(rates), sum(rates)/len(rates))\n    globals()[d]=rates\n    globals()[d+'_files']=files\n# save raw and rounded?\nfor use_rounded in [False, True]:\n    a=globals()['scogs_animals']; f=globals()['scogs_fungi']\n    if use_rounded:\n        a=[round(x,4) for x in a]; f=[round(x,4) for x in f]\n    for alt in ['two-sided','less','greater']:\n        res=mannwhitneyu(a,f,alternative=alt,method='auto')\n        print('rounded',use_rounded,'alt',alt,'U',res.statistic,'p',res.pvalue)\n    # manual U1 U2\n    import scipy.stats as st\n    rank=st.rankdata(a+f)\n    R1=sum(rank[:len(a)]); U1=len(a)*len(f)+len(a)*(len(a)+1)/2-R1\n    U2=len(a)*len(f)-U1\n    print('manual U1 (animals)',U1,'U2',U2,'n1 n2',len(a),len(f))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
