{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/work\npython - <<'PY'\nimport os,re\nfor d in ['scogs_animals','scogs_fungi']:\n    bases=set()\n    exts=['faa','mafft','clipkit','treefile','iqtree','mldist','bionj','model.gz','ckp.gz','log']\n    for fn in os.listdir(d):\n        for e in exts:\n            suf='.'+e\n            if fn.endswith(suf):\n                bases.add(fn[:-len(suf)])\n                break\n    print(d, 'unique base',len(bases))\n    for e in exts:\n        n=sum(1 for fn in os.listdir(d) if fn.endswith('.'+e))\n        print(e,n)\n    # counts bases per ext\n    base_with_ext={e:set() for e in exts}\n    for fn in os.listdir(d):\n        for e in exts:\n            suf='.'+e\n            if fn.endswith(suf):\n                base_with_ext[e].add(fn[:-len(suf)])\n                break\n    for e in exts:\n        print(' with',e,len(base_with_ext[e]))\n    print('treefile missing from clipkit bases', len(base_with_ext['clipkit']-base_with_ext['treefile']))\n    print('mafft bases missing clipkit', len(base_with_ext['mafft']-base_with_ext['clipkit']))\n    print('faa bases missing mafft', len(base_with_ext['faa']-base_with_ext['mafft']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
