{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cd /workspace/work\npython - <<'PY'\nimport os,re\nfor d in ['scogs_animals','scogs_fungi']:\n    pat=re.compile(r'\"'^('\"\\\\d+at\\\\d+)\\\\.faa')\n    bases=set(); ext_sets={}\n    for fn in os.listdir(d):\n        m=pat.match(fn)\n        if not m: continue\n        b=m.group(1); bases.add(b)\n        # identify suffix after .faa\n        suf=fn[len(b)+4:]  # '' or .mafft...\n        key=suf or '.faa'\n        ext_sets.setdefault(key,set()).add(b)\n    print('\\\\n',d,'bases',len(bases))\n    for k in sorted(ext_sets, key=lambda x:(x.count('.'),x)):\n        print(k, len(ext_sets[k]))\n    missing_tree = bases - ext_sets.get('.mafft.clipkit.treefile',set())\n    print('missing treefile bases',len(missing_tree))\n    print('first missing',sorted(missing_tree)[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
