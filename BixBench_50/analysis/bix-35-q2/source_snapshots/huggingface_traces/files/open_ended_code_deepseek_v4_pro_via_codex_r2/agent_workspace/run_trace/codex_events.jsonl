{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/compute_rates.py <<'PY'\nimport glob, os, argparse, json\nfrom types import SimpleNamespace\nfrom phykit.services.tree.evolutionary_rate import EvolutionaryRate\n\ndef rate(path):\n    return float(str(EvolutionaryRate(SimpleNamespace(tree=path, json=False)).run()))\n    # actually run returns None and prints; use service vars\n\ndef compute_rate(path):\n    # call service object and run capture stdout\n    import io, contextlib\n    buf=io.StringIO()\n    with contextlib.redirect_stdout(buf):\n        EvolutionaryRate(SimpleNamespace(tree=path, json=False)).run()\n    return float(buf.getvalue().strip())\n\nfor d in ['/workspace/tmp/sa','/workspace/tmp/sf']:\n    out={}\n    files=sorted(glob.glob(os.path.join(d,'*.treefile')))\n    for f in files:\n        gene=os.path.basename(f).replace('.faa.mafft.clipkit.treefile','')\n        out[gene]=compute_rate(f)\n    with open(os.path.join(d,'evo_rates.json'),'w') as fh:\n        json.dump(out,fh,indent=2)\n    print(d, len(out), sum(out.values()))\nPY\npython3 /workspace/tmp/compute_rates.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
