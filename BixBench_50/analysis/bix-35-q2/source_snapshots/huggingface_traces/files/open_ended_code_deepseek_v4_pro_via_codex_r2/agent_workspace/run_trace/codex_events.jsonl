{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, scipy.stats as st, numpy as np\nsa=json.load(open('/workspace/tmp/sa/evo_rates.json'))\nsf=json.load(open('/workspace/tmp/sf/evo_rates.json'))\nA=list(sa.values()); F=list(sf.values())\nprint(len(A), len(F), np.mean(A), np.mean(F), np.median(A), np.median(F))\nfor alt in ['two-sided','less','greater']:\n u,p=st.mannwhitneyu(A,F,alternative=alt)\n print(alt,u,p)\nprint('order animals,fungi two-sided',st.mannwhitneyu(A,F,alternative='two-sided'))\nprint('order fungi,animals two-sided',st.mannwhitneyu(F,A,alternative='two-sided'))\n# common\ncommon=set(sa)&set(sf)\nprint('common',len(common))\nAc=[sa[g] for g in sorted(common)]; Fc=[sf[g] for g in sorted(common)]\nprint('common mean med',np.mean(Ac),np.mean(Fc),np.median(Ac),np.median(Fc))\nu,p=st.mannwhitneyu(Ac,Fc,alternative='two-sided'); print('common U',u,p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
