ic\": false,\n            \"label\": \"Replace with\",\n            \"model_class\": \"TextToolParameter\",\n            \"name\": \"replace_pattern\",\n            \"optional\": true,\n            \"refresh_on_change\": false,\n            \"text_value\": \"Not available.\",\n            \"type\": \"text\",\n            \"value\": null\n          },\n          {\n            \"argument\": null,\n            \"default_value\": false,\n            \"falsevalue\": \"\",\n            \"help\": \"see help section for details.\",\n            \"help_format\": \"html\",\n            \"hidden\": false,\n            \"is_dynamic\": false,\n            \"label\": \"Find-Pattern is a regular expression\",\n            \"model_class\": \"BooleanToolParameter\",\n            \"name\": \"is_regex\",\n            \"optional\": false,\n            \"refresh_on_change\": false,\nrun_trace/galaxy_tool_run_005/validation_parameter_provenance.json\n{\n  \"checked_parameter_count\": 8,\n  \"mismatches\": [\n    {\n      \"expected\": \"Chronic Round1 S2\",\n      \"path\": \"find_and_replace|0|find_pattern\",\n      \"resolved\": null\n    },\n    {\n      \"expected\": true,\n      \"path\": \"find_and_replace|0|global\",\n      \"resolved\": false\n    },\n    {\n      \"expected\": \"Chronic Round1 S1\",\n      \"path\": \"find_and_replace|0|replace_pattern\",\n      \"resolved\": null\n    }\n  ],\n  \"missing_paths\": [],\n  \"status\": \"mismatch\"\n}\n","exit_code":0,"status":"completed"}}
