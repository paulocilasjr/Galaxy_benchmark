         \"is_dynamic\": false,\n            \"label\": \"Replace with\",\n            \"model_class\": \"TextToolParameter\",\n            \"name\": \"replace_pattern\",\n            \"optional\": true,\n            \"refresh_on_change\": false,\n            \"text_value\": \"Chronic Round1 S1\",\n            \"type\": \"text\",\n            \"value\": \"Chronic Round1 S1\"\n          },\n          {\n            \"argument\": null,\n            \"default_value\": false,\n            \"falsevalue\": \"\",\n            \"help\": \"see help section for details.\",\n            \"help_format\": \"html\",\n            \"hidden\": false,\n            \"is_dynamic\": false,\n            \"label\": \"Find-Pattern is a regular expression\",\n            \"model_class\": \"BooleanToolParameter\",\n            \"name\": \"is_regex\",\n            \"optional\": false,\n            \"refresh_on_change\": false,\nrun_trace/galaxy_tool_run_006/validation_parameter_provenance.json\n{\n  \"checked_parameter_count\": 8,\n  \"mismatches\": [],\n  \"missing_paths\": [\n    \"find_and_replace_0|caseinsensitive\",\n    \"find_and_replace_0|find_pattern\",\n    \"find_and_replace_0|global\",\n    \"find_and_replace_0|is_regex\",\n    \"find_and_replace_0|replace_pattern\",\n    \"find_and_replace_0|searchwhere|searchwhere_select\",\n    \"find_and_replace_0|skip_first_line\",\n    \"find_and_replace_0|wholewords\"\n  ],\n  \"status\": \"mismatch\"\n}\n","exit_code":0,"status":"completed"}}
