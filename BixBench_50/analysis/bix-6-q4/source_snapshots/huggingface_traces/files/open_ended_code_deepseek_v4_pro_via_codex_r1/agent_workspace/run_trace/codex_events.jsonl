{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, math, statistics\np='/workspace/inputs/JuliaJong_CRISPRa_BCL2_B3GNT_cacerResTcellCytotoxicity_supplData1_mageck.xlsx'\nwb=openpyxl.load_workbook(p, read_only=True, data_only=True)\nws=wb['MAGeCK P-values']\nrows=ws.iter_rows(values_only=True)\nheader=next(rows)\nprint(header)\nidx=[header.index('Chronic Round1 S1'), header.index('Chronic Round1 S2')]\na=[];b=[]\nfor row in rows:\n    if len(row)>max(idx):\n        x=row[idx[0]]; y=row[idx[1]]\n        if x is None or y is None or isinstance(x,str) or isinstance(y,str):\n            continue\n        a.append(float(x)); b.append(float(y))\nprint(len(a))\n# ranks with average ties\ndef rankdata(vals):\n    order=sorted(range(len(vals)), key=lambda i: vals[i])\n    ranks=[0.0]*len(vals)\n    i=0\n    n=len(vals)\n    while i<n:\n        j=i\n        while j+1<n and vals[order[j+1]]==vals[order[i]]:\n            j+=1\n        avg=(i+j+2)/2.0 # rank starts 1\n        for k in range(i,j+1):\n            ranks[order[k]]=avg\n        i=j+1\n    return ranks\nra=rankdata(a); rb=rankdata(b)\nmean_a=sum(ra)/len(ra); mean_b=sum(rb)/len(rb)\ncov=sum((ra[i]-mean_a)*(rb[i]-mean_b) for i in range(len(ra)))\nsa=math.sqrt(sum((x-mean_a)**2 for x in ra)); sb=math.sqrt(sum((x-mean_b)**2 for x in rb))\nr=cov/(sa*sb)\nprint('r', repr(r), format(r,'.15g'))\n# also correlation raw? no\nprint('n',len(a))\nprint('minmax', min(a),max(a), min(b),max(b))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
