{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, math\n# manual rank with average ties\np='/workspace/inputs/JuliaJong_CRISPRa_BCL2_B3GNT_cacerResTcellCytotoxicity_supplData1_mageck.xlsx'\nwb=openpyxl.load_workbook(p, read_only=True, data_only=True)\nws=wb['MAGeCK P-values']\nhdr=next(ws.iter_rows(values_only=True))\nci=[i for i,h in enumerate(hdr) if str(h).startswith('Chronic Round1')]\nx=[];y=[]\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    x.append(float(r[ci[0]])); y.append(float(r[ci[1]]))\ndef rankdata(vals):\n    order=sorted(range(len(vals)), key=lambda i: vals[i])\n    ranks=[0.0]*len(vals)\n    i=0;n=len(order)\n    while i<n:\n        j=i+1\n        while j<n and vals[order[j]]==vals[order[i]]:\n            j+=1\n        avg=(i+1+j)/2.0  # ranks i+1..j inclusive average\n        for k in range(i,j): ranks[order[k]]=avg\n        i=j\n    return ranks\nrx=rankdata(x); ry=rankdata(y)\nmx=sum(rx)/len(rx); my=sum(ry)/len(ry)\nnum=sum((a-mx)*(b-my) for a,b in zip(rx,ry))\nden=(sum((a-mx)**2 for a in rx)*sum((b-my)**2 for b in ry))**0.5\nprint(num/den, len(x))\nfrom scipy.stats import spearmanr\nprint(spearmanr(x,y).statistic)\n# print formatted variants\nrho=num/den\nprint(repr(rho))\nprint(f'{rho:.15f}')\nprint(f'{rho:.12f}')\nprint(f'{rho:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
