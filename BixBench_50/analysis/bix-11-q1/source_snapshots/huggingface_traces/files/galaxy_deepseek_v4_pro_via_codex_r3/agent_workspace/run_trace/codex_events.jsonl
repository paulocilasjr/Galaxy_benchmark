{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, statistics, collections\nfrom pathlib import Path\np=Path('/workspace/tmp/phykit_output.tabular')\nrows=list(csv.DictReader(p.open(), delimiter='\\\\t'))\nprint('rows',len(rows))\ngroups=collections.defaultdict(list)\nfor r in rows:\n    groups[r['group']].append(float(r['value']))\nfor g,vals in groups.items():\n    vals_sorted=sorted(vals)\n    print(g,'n',len(vals),'median',statistics.median(vals),'min',min(vals),'max',max(vals),'mean',sum(vals)/len(vals))\nma=statistics.median(groups['animals'])\nfu=statistics.median(groups['fungi'])\nprint('difference fungi-animals',fu-ma)\nprint('difference animals-fungi',ma-fu)\nprint('round 6',round(fu-ma,6),round(ma-fu,6))\nprint('count zero',sum(v==0 for v in groups['animals']),sum(v==0 for v in groups['fungi']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
