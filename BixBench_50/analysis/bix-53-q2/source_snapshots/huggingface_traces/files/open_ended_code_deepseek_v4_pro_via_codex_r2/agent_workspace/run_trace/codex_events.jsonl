{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(DESeq2))\ncounts <- read.csv('/workspace/inputs/count.csv', row.names=1, check.names=FALSE)\nrun_analysis <- function(samples, label) {\n  ct <- counts[, samples, drop=FALSE]\n  condition <- factor(sub(\\\"\\\\\\\\d+\"'$\",\"\",samples), levels=c(\"WL\",\"KL\"))\n  coldata <- data.frame(row.names=samples, condition=condition)\n  dds <- DESeqDataSetFromMatrix(countData=ct, colData=coldata, design=~condition)\n  dds <- DESeq(dds, quiet=TRUE)\n  res <- results(dds, contrast=c(\"condition\",\"KL\",\"WL\"), alpha=0.05)\n  shr <- lfcShrink(dds, res=res, coef=\"condition_KL_vs_WL\", type=\"apeglm\", quiet=TRUE)\n  dat <- as.data.frame(shr)\n  cat('\"'\\\\n', label, '\\\\n', sep='')\n  cat('dim', nrow(dat), 'baseMean>10', sum(\"'!is.na(dat$baseMean) & dat$baseMean>10), '\"'\\\\n')\n  cat('padj NA', sum(is.na(dat\"'$padj)), '\"'pvalue NA', sum(is.na(dat\"'$pvalue)), '\"'\\\\n')\n  for (pc in c('padj','pvalue')) {\n    p <- dat[[pc]]\n    keep <- \"'!is.na(p) & p < 0.05 & !is.na(dat$baseMean) & dat$baseMean > 10 & !is.na(dat$log2FoldChange) & abs(dat$log2FoldChange) > 1\n    cat(pc, '\"'significant', sum(keep), 'up', sum(keep & dat\"'$log2FoldChange>1), '\"'down', sum(keep & dat\"'$log2FoldChange< -1), '\"'\\\\n')\n  }\n  invisible(dat)\n}\nrun_analysis(c('KL1','KL2','KL3','WL1','WL2','WL3'), 'full KL1-3 vs WL1-3')\nrun_analysis(c('KL1','KL2','WL1','WL2'), 'no third replicates KL1-2 vs WL1-2')\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
