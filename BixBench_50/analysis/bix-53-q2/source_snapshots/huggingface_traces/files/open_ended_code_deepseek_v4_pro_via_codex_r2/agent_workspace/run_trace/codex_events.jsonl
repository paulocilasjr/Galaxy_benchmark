{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nraw = pd.read_csv('/workspace/inputs/count.csv', index_col=0)\nprint('raw shape', raw.shape)\nprint(raw.index[:3], raw.columns.tolist())\n\ndef analyze(samples):\n    cnt = raw[samples].T.copy()\n    cnt.columns.name = None\n    meta = pd.DataFrame({'condition': [s[:2] for s in samples]}, index=samples)\n    dds = DeseqDataSet(counts=cnt, metadata=meta, design=\\\"~C(condition, levels=['WL','KL'])\\\", quiet=True)\n    dds.deseq2()\n    print('dds done', samples, 'non_zero_idx', dds.non_zero_idx.sum(), 'var columns', dds.var.columns.tolist())\n    # inspect design and LFC names\n    print('design matrix:\\\\n', dds.obsm['design_matrix'].head())\n    print('LFC cols', dds.varm['LFC'].columns.tolist())\n    ds = DeseqStats(dds, contrast=['condition','KL','WL'], alpha=0.05, quiet=True)\n    ds.run_wald_test()\n    coeff = [c for c in ds.LFC.columns if c \"'!= '\"'Intercept'][0]\n    print('coeff', coeff)\n    ds.lfc_shrink(coeff=coeff)\n    r = ds.results_df.copy()\n    print(r.columns.tolist())\n    print(r.head())\n    print('padj min/max', r.padj.min(), r.padj.max(), 'NA', r.padj.isna().sum(), 'pvalue NA', r.pvalue.isna().sum())\n    for pcol in ['padj','pvalue']:\n        sig = (r[pcol] < 0.05) & (r['baseMean'] > 10) & (r['log2FoldChange'].abs() > 1)\n        print(pcol, 'count', sig.sum(), 'up', ((r.log2FoldChange>1)&sig).sum(), 'down', ((r.log2FoldChange<-1)&sig).sum())\n    return r\n\nr_all = analyze(['KL1','KL2','KL3','WL1','WL2','WL3'])\nprint('\\\\n\\\\nSUBSET')\nr_sub = analyze(['KL1','KL2','WL1','WL2'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
