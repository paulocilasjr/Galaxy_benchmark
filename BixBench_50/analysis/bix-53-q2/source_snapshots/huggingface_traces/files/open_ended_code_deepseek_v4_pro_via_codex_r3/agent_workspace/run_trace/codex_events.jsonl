{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('/workspace/inputs/count.csv', index_col=0)\n\ndef run(cols):\n    c = counts.loc[:, cols].T\n    meta = pd.DataFrame({'condition': [x[:2] for x in cols]}, index=cols)\n    meta['condition'] = pd.Categorical(meta['condition'], categories=['KL','WL'])\n    dds = DeseqDataSet(counts=c, metadata=meta, design='~condition', ref_level=['condition','KL'], quiet=True)\n    dds.deseq2()\n    ds = DeseqStats(dds, contrast=['condition','WL','KL'], quiet=True)\n    ds.summary()\n    ds.lfc_shrink(coeff='condition_WL_vs_KL')\n    res = ds.results_df.copy()\n    n_pvalue = int(((res['pvalue'] < 0.05) & (res['log2FoldChange'].abs() > 1) & (res['baseMean'] > 10)).sum())\n    n_padj = int(((res['padj'] < 0.05) & (res['log2FoldChange'].abs() > 1) & (res['baseMean'] > 10)).sum())\n    print(cols, 'pvalue', n_pvalue, 'padj', n_padj, 'total', len(res), 'nonNA_padj', res['padj'].notna().sum())\n    return res, n_pvalue, n_padj\n\nfull, nf_p, nf_padj = run(['KL1','KL2','KL3','WL1','WL2','WL3'])\nred, nr_p, nr_padj = run(['KL1','KL2','WL1','WL2'])\nprint('FINAL pvalue full/reduced/direction:', nf_p, nr_p, 'increase' if nr_p>nf_p else 'decrease' if nr_p<nf_p else 'no change')\nprint('FINAL padj full/reduced/direction:', nf_padj, nr_padj, 'increase' if nr_padj>nf_padj else 'decrease' if nr_padj<nf_padj else 'no change')\n# show top rows and overlap differences maybe\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
