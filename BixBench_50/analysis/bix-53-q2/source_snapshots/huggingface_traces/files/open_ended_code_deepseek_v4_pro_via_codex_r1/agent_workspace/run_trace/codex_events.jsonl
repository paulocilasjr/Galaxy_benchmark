{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(DESeq2))\ncounts <- read.csv('inputs/count.csv', row.names=1, check.names=FALSE)\ncat('dims', dim(counts), '\\\\n')\ncat('colSums\\\\n'); print(colSums(counts))\n\nrun_analysis <- function(samples, alpha=0.05) {\n  cmat <- counts[, samples, drop=FALSE]\n  coldata <- data.frame(condition=factor(ifelse(grepl('\"'^KL'\"', samples), 'KL', 'WL'), levels=c('WL','KL')), row.names=samples)\n  dds <- DESeqDataSetFromMatrix(countData=round(as.matrix(cmat)), colData=coldata, design=~condition)\n  dds <- DESeq(dds, quiet=TRUE)\n  res <- results(dds, alpha=alpha)\n  # apeglm needs coef\n  resLFC <- lfcShrink(dds, coef=resultsNames(dds)[2], type='apeglm', res=res, quiet=TRUE)\n  print(resultsNames(dds))\n  print(head(resLFC))\n  sig <- resLFC[which(resLFC\"'$pvalue < 0.05 & abs(resLFC$log2FoldChange) > 1 & resLFC$baseMean > 10),]\n  cat('\"'samples', paste(samples, collapse=','), 'n_nonNA', sum(\"'!is.na(resLFC$pvalue)), '\"'sig_p_abs_bm', nrow(sig), '\\\\n')\n  sig_padj <- resLFC[which(resLFC\"'$padj < 0.05 & abs(resLFC$log2FoldChange) > 1 & resLFC$baseMean > 10),]\n  cat('\"'sig_padj_abs_bm', nrow(sig_padj), '\\\\n')\n  return(list(res=resLFC, sig=sig))\n}\nfull <- run_analysis(c('KL1','KL2','KL3','WL1','WL2','WL3'), alpha=0.05)\nred <- run_analysis(c('KL1','KL2','WL1','WL2'), alpha=0.05)\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
