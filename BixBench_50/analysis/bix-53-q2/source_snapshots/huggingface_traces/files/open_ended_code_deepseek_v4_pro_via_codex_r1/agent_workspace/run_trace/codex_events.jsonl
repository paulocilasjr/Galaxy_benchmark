{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(DESeq2))\ncounts <- read.csv('inputs/count.csv', row.names=1, check.names=FALSE)\nrun <- function(samples, alpha=0.1, shrink_type='apeglm') {\n  cmat <- round(as.matrix(counts[,samples]))\n  coldata <- data.frame(condition=factor(ifelse(grepl('\"'^KL'\"', samples), 'KL', 'WL'), levels=c('WL','KL')), row.names=samples)\n  dds <- DESeqDataSetFromMatrix(cmat, coldata, ~condition)\n  dds <- DESeq(dds, quiet=TRUE)\n  res <- results(dds, alpha=alpha)\n  resLFC <- lfcShrink(dds, coef=resultsNames(dds)[2], type=shrink_type, res=res, quiet=TRUE)\n  c(p=sum(resLFC\"'$pvalue < 0.05 & abs(resLFC$log2FoldChange)>1 & resLFC$baseMean>10, na.rm=TRUE),\n    padj=sum(resLFC$padj < 0.05 & abs(resLFC$log2FoldChange)>1 & resLFC$baseMean>10, na.rm=TRUE))\n}\nfor (a in c(0.05,0.1)) {\n cat('\"'alpha', a, 'full', run(c('KL1','KL2','KL3','WL1','WL2','WL3'), a), '\\\\n')\n cat('alpha', a, 'red', run(c('KL1','KL2','WL1','WL2'), a), '\\\\n')\n}\n# normal shrinkage alpha .05\nfor (s in c('normal')) {\n cat('type',s,'full',run(c('KL1','KL2','KL3','WL1','WL2','WL3'),0.05,s),'\\\\n')\n cat('type',s,'red',run(c('KL1','KL2','WL1','WL2'),0.05,s),'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
