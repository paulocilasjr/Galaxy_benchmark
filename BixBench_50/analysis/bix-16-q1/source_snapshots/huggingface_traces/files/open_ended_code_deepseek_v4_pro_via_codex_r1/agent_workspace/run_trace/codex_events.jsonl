{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport pandas as pd\nimport scipy.stats as st\n\nt0=time.time()\nprint('Reading headers...', flush=True)\neff_all_cols = pd.read_csv('inputs/CRISPRGeneEffect.csv', nrows=0).columns\nexpr_all_cols = pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', nrows=0).columns\n\ndef sym(col):\n    return str(col).split(' (')[0]\n\neff_syms = eff_all_cols[1:].map(sym)\nexpr_syms = expr_all_cols[1:].map(sym)\ncommon = sorted(set(eff_syms) & set(expr_syms))\nprint('common genes', len(common), flush=True)\n\neff_keep = [eff_all_cols[0]] + [eff_all_cols[i+1] for i,s in enumerate(eff_syms) if s in common]\nexpr_keep = [expr_all_cols[0]] + [expr_all_cols[i+1] for i,s in enumerate(expr_syms) if s in common]\n\nprint('Reading effect matrix...', flush=True)\neff = pd.read_csv('inputs/CRISPRGeneEffect.csv', usecols=eff_keep, index_col=0, dtype=np.float32)\nprint('effect shape', eff.shape, 'elapsed', round(time.time()-t0,1), flush=True)\nprint('Reading expression matrix...', flush=True)\nexpr = pd.read_csv('inputs/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv', usecols=expr_keep, index_col=0, dtype=np.float32)\nprint('expr shape', expr.shape, 'elapsed', round(time.time()-t0,1), flush=True)\n\n# rename to symbols for matching\neff.columns = [sym(c) for c in eff.columns]\nexpr.columns = [sym(c) for c in expr.columns]\n# keep same column order\neff = eff.loc[:, common]\nexpr = expr.loc[:, common]\ncommon_ids = eff.index.intersection(expr.index)\nprint('common sample IDs', len(common_ids), flush=True)\neff = eff.loc[common_ids]\nexpr = expr.loc[common_ids]\n\nprint('effect NaNs', int(eff.isna().sum().sum()), 'expr NaNs', int(expr.isna().sum().sum()), flush=True)\n\n# pairwise-complete per gene if any NaNs exist (likely none)\ndef mask_valid(a,b):\n    if np.isnan(a).any() or np.isnan(b).any():\n        return ~(np.isnan(a)|np.isnan(b))\n    return np.ones(a.shape[0], dtype=bool)\n\nprint('Ranking effect columns...', flush=True)\n# Use float64 for ranks\nrank_eff = st.rankdata(eff.to_numpy(dtype=np.float64), axis=0, method='average')\nprint('rank_eff shape', rank_eff.shape, 'elapsed', round(time.time()-t0,1), flush=True)\ndel eff\nprint('Ranking expression columns...', flush=True)\nrank_expr = st.rankdata(expr.to_numpy(dtype=np.float64), axis=0, method='average')\nprint('rank_expr shape', rank_expr.shape, 'elapsed', round(time.time()-t0,1), flush=True)\ndel expr\n\n# Center ranks by column\nrank_eff = rank_eff - rank_eff.mean(axis=0, keepdims=True)\nrank_expr = rank_expr - rank_expr.mean(axis=0, keepdims=True)\n\n# compute correlation diagonal\ncov = np.einsum('ij,ij->j', rank_eff, rank_expr)\nvar_eff = np.einsum('ij,ij->j', rank_eff, rank_eff)\nvar_expr = np.einsum('ij,ij->j', rank_expr, rank_expr)\ndenom = np.sqrt(var_eff * var_expr)\nrho = cov / denom\nprint('rho shape', rho.shape, 'elapsed', round(time.time()-t0,1), flush=True)\n\n# finite check\nfinite = np.isfinite(rho)\nprint('finite', finite.sum(), '/', len(rho), flush=True)\nif finite.sum() < len(rho):\n    print('nonfinite genes', [common[i] for i in np.where(~finite)[0]][:10])\n\nvalid = finite\nmin_idx = int(np.nanargmin(rho))\nprint('min gene', common[min_idx], 'rho', float(rho[min_idx]))\n# top 20 negative\norder = np.argsort(rho)\nfor i in order[:20]:\n    print(i, common[i], float(rho[i]))\nprint('total elapsed', round(time.time()-t0,1), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
