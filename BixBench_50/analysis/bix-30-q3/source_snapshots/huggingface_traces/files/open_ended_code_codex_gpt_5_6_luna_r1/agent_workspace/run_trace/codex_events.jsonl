{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, subprocess, math\npath='inputs/pone.0150501.s002.xls'\ns=xlrd.open_workbook(path).sheet_by_index(0)\nrows=[]\ndef vec(vals):\n    return 'c(' + ','.join('%.17g'%v for v in vals) + ')'\nexpr_equal=[]; expr_welch=[]\nfor i in range(2,s.nrows):\n    x=[float(s.cell_value(i,j)) for j in range(1,11) if not isinstance(s.cell_value(i,j),str)]\n    y=[float(s.cell_value(i,j)) for j in range(11,21) if not isinstance(s.cell_value(i,j),str)]\n    rows.append((s.cell_value(i,0),x,y))\n    expr_equal.append('t.test(%s,%s,var.equal=TRUE)\"'$p.value'\"'%(vec(x),vec(y)))\n    expr_welch.append('t.test(%s,%s,var.equal=FALSE)\"'$p.value'\"'%(vec(x),vec(y)))\nscript='options(warn=-1); pe <- c(%s); pw <- c(%s); cat(sprintf(\\\"%%.17g %% .17g\\\\\\\\n\\\", pe,pw), sep=\\\"\\\")' % (','.join(expr_equal),','.join(expr_welch))\nr=subprocess.run(['R','--vanilla','--slave'],input=script,text=True,capture_output=True,check=True)\nps=[]\nfor line in r.stdout.strip().splitlines():\n    a,b=line.split(); ps.append((float(a),float(b)))\nprint('rows',len(rows),'pvals',len(ps))\n\ndef bonf(p):\n    m=len(p)\n    return [min(1,m*x) for x in p]\ndef by(p):\n    m=len(p); c=sum(1.0/i for i in range(1,m+1))\n    order=sorted(range(m),key=lambda i:p[i])\n    adj=[1.0]*m; running=1.0\n    # adjusted p for sorted p: min over k>=i p_(k)*m*c/(k+1)\n    for pos in range(m-1,-1,-1):\n        val=p[order[pos]]*m*c/(pos+1)\n        running=min(running,val)\n        adj[order[pos]]=min(1.0,running)\n    return adj\nfor kind,k in [('equal',0),('welch',1)]:\n    raw=[v[k] for v in ps]\n    print('\\\\n',kind,'raw p<=.05',sum(x<=.05 for x in raw))\n    pb=bonf(raw); py=by(raw)\n    print('Bonf',sum(x<=.05 for x in pb),'BY',sum(x<=.05 for x in py))\n    print('Bonf sig',[(rows[i][0],raw[i],pb[i]) for i in range(len(raw)) if pb[i]<=.05])\n    print('BY sig',[(rows[i][0],raw[i],py[i]) for i in range(len(raw)) if py[i]<=.05])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
