{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport xlrd, subprocess, math\ns=xlrd.open_workbook('inputs/pone.0150501.s002.xls').sheet_by_index(0)\ndef vec(v): return 'c('+','.join('%.17g'%x for x in v)+')'\nexprs={k:[] for k in ['wilcox','wilcox_exact','paired_wilcox','paired_t']}\nfor i in range(2,s.nrows):\n x=[float(s.cell_value(i,j)) for j in range(1,11) if not isinstance(s.cell_value(i,j),str)]\n y=[float(s.cell_value(i,j)) for j in range(11,21) if not isinstance(s.cell_value(i,j),str)]\n # independent wilcox exact false; exact true; paired only if no missing both paired? R will error if lengths differ\n exprs['wilcox'].append('wilcox.test(%s,%s,exact=FALSE)\"'$p.value'\"'%(vec(x),vec(y)))\n exprs['wilcox_exact'].append('wilcox.test(%s,%s,exact=TRUE)\"'$p.value'\"'%(vec(x),vec(y)))\n if len(x)==len(y):\n  exprs['paired_wilcox'].append('wilcox.test(%s,%s,paired=TRUE,exact=FALSE)\"'$p.value'\"'%(vec(x),vec(y)))\n  exprs['paired_t'].append('t.test(%s,%s,paired=TRUE)\"'$p.value'\"'%(vec(x),vec(y)))\nscript='options(warn=-1);\\\\n'\nfor k,e in exprs.items():\n if e: script += '%s<-c(%s); cat(\\\"%s \\\",sprintf(\\\"%%.17g \\\",%s),\\\"\\\\\\\\n\\\",sep=\\\"\\\")\\\\n'%(k,','.join(e),k,k)\nr=subprocess.run(['R','--vanilla','--slave'],input=script,text=True,capture_output=True,check=True)\nprint(r.stderr)\nfor line in r.stdout.strip().splitlines():\n p=line.split(); k=p[0]; vals=list(map(float,p[1:]));\n m=len(vals); c=sum(1/i for i in range(1,m+1));\n order=sorted(range(m),key=lambda i:vals[i]); adj=[1]*m; run=1\n for pos in range(m-1,-1,-1):\n  run=min(run, vals[order[pos]]*m*c/(pos+1)); adj[order[pos]]=min(1,run)\n print(k,'m',m,'min',min(vals),'raw',sum(x<=.05 for x in vals),'bonf',sum(min(1,m*x)<=.05 for x in vals),'BY',sum(x<=.05 for x in adj),'minbonf',min(m*x for x in vals),'minby',min(adj))\n for i in sorted(range(m),key=lambda i:vals[i])[:5]: print(' ',s.cell_value(i+2,0),vals[i],min(1,m*vals[i]),adj[i])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
