{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd, math, numpy as np\nfrom scipy import stats\nfrom statsmodels.stats.multitest import multipletests\np='/workspace/inputs/pone.0150501.s002.xls'\nsh=xlrd.open_workbook(p).sheet_by_index(0)\nheaders=sh.row_values(1)[1:]\nmat=[]; names=[]\nfor r in range(2,sh.nrows):\n    vals=sh.row_values(r)\n    names.append(vals[0])\n    nums=[]\n    for v in vals[1:]:\n        if isinstance(v,(int,float)):\n            nums.append(float(v))\n        else:\n            nums.append(np.nan)\n    mat.append(nums)\nA=np.array(mat, dtype=float)\nP=[i for i,h in enumerate(headers) if h.startswith('P_')]\nC=[i for i,h in enumerate(headers) if h.startswith('C_')]\nexP={'P_3'}; exC={'C_18'}\n\ndef analysis(center_mode='allmean', exclude=False, threshold=None, sign='sample-gene', equal_var=True):\n    B=A.copy()\n    if threshold is not None:\n        B[B>=threshold]=np.nan\n    pidx=[i for i in P if not exclude or headers[i] not in exP]\n    cidx=[i for i in C if not exclude or headers[i] not in exC]\n    # center per sample based on available values among all 175\n    if center_mode=='allmean':\n        sample_means=np.nanmean(B, axis=0)\n    elif center_mode=='detected_mean':\n        # mean Ct of detected (<34) per sample; no threshold applied to B?\n        sample_means=np.nanmean(np.where(A<threshold if threshold else A, A, np.nan), axis=0)\n    elif center_mode=='none':\n        sample_means=np.zeros(B.shape[1])\n    if center_mode\"'!='\"'none':\n        if sign=='sample-gene':\n            B=sample_means[None,:]-B\n        else:\n            B=B-sample_means[None,:]\n    pvals=[]; details=[]\n    for k,name in enumerate(names):\n        x=B[k,pidx]; y=B[k,cidx]\n        x=x[~np.isnan(x)]; y=y[~np.isnan(y)]\n        if len(x)<2 or len(y)<2:\n            pvals.append(np.nan); details.append((name,np.nan,len(x),len(y))); continue\n        t,pv=stats.ttest_ind(x,y,equal_var=equal_var)\n        pvals.append(pv); details.append((name,pv,len(x),len(y)))\n    pvals=np.array(pvals)\n    valid=~np.isnan(pvals)\n    res=multipletests(pvals[valid],alpha=0.05,method='bonferroni')\n    by=multipletests(pvals[valid],alpha=0.05,method='fdr_by')\n    print('center',center_mode,'sign',sign,'threshold',threshold,'exclude',exclude,'n valid',valid.sum(),'raw',np.sum(pvals[valid]<=0.05),'bonf',np.sum(res[0]),'BY',np.sum(by[0]))\n    bonf_names=[names[valid][i] for i,s in enumerate(res[0]) if s]\n    by_names=[names[valid][i] for i,s in enumerate(by[0]) if s]\n    print('bonf',bonf_names)\n    print('by',by_names)\n    return pvals,details\n\nfor cm in ['none','allmean','detected_mean']:\n  for ex in [False,True]:\n    analysis(cm, ex, threshold=None, sign='sample-gene')\n    analysis(cm, ex, threshold=None, sign='gene-sample')\n    analysis(cm, ex, threshold=34, sign='sample-gene')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
