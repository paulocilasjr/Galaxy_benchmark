{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport xlrd, math, numpy as np\nfrom scipy import stats\nfrom statsmodels.stats.multitest import multipletests\np='/workspace/inputs/pone.0150501.s002.xls'\nsh=xlrd.open_workbook(p).sheet_by_index(0)\nheaders=sh.row_values(1)\ndata=[]\nfor r in range(2,sh.nrows):\n    vals=sh.row_values(r)\n    name=vals[0]\n    nums=[]\n    for v in vals[1:]:\n        if isinstance(v,(int,float)):\n            nums.append(float(v))\n        else:\n            nums.append(np.nan)\n    data.append((name,np.array(nums)))\nheaders=headers[1:]\nidxP=[i for i,h in enumerate(headers) if h.startswith('P_')]\nidxC=[i for i,h in enumerate(headers) if h.startswith('C_')]\n\ndef run(excludeP=None, excludeC=None, center=False, use_cutoff=False, cutoff=34, logrel=False, eq=True):\n    pvals=[]; names=[]; details=[]\n    for name,arr in data:\n        pi=[i for i in idxP if (excludeP is None or headers[i] not in excludeP)]\n        ci=[i for i in idxC if (excludeC is None or headers[i] not in excludeC)]\n        if use_cutoff:\n            # maybe set values >=cutoff to nan per sample? or globally? Try threshold raw ct >=34 missing\n            a=arr.copy()\n            a[a>=cutoff]=np.nan\n        else:\n            a=arr.copy()\n        x=a[pi].astype(float); y=a[ci].astype(float)\n        if center:\n            # subtract mean of detected values per sample? all samples combined excluding missing\n            # center by each sample mean over all 175\n            for sidx in pi+ci:\n                samplevals=a[sidx]\n                # use global mean across all 175 in that sample, ignoring nan\n                m=np.nanmean(samplevals)\n                a[sidx]=a[sidx]-m\n            x=a[pi].astype(float); y=a[ci].astype(float)\n        x=x[~np.isnan(x)]; y=y[~np.isnan(y)]\n        if len(x)<2 or len(y)<2:\n            continue\n        t,pval=stats.ttest_ind(x,y,equal_var=eq)\n        pvals.append(pval); names.append(name); details.append((name,t,pval,len(x),len(y),np.mean(x),np.mean(y)))\n    pvals=np.array(pvals)\n    res=multipletests(pvals,alpha=0.05,method='bonferroni')\n    by=multipletests(pvals,alpha=0.05,method='fdr_by')\n    bonf_sig=np.sum(res[0]); by_sig=np.sum(by[0])\n    raw_sig=np.sum(pvals<=0.05)\n    print('n tests',len(pvals),'raw p<=.05',raw_sig,'bonf',bonf_sig,'BY',by_sig)\n    # names for raw and bonf\n    print('bonf names', [n for n,s in zip(names,res[0]) if s])\n    print('by names', [n for n,s in zip(names,by[0]) if s])\n    return names,pvals,details\n\nprint('ALL raw Ct equal_var')\nrun()\nprint('\\\\nEXCLUDE P3 C18 raw Ct')\nrun(excludeP={'P_3'}, excludeC={'C_18'})\nprint('\\\\nALL centered all 175')\nrun(center=True)\nprint('\\\\nEXCLUDE centered')\nrun(excludeP={'P_3'}, excludeC={'C_18'}, center=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
