{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/ora.py <<'PY'\nimport urllib.request, csv, math, os\nfrom collections import defaultdict\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\n\ndef fetch(url):\n    req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})\n    with urllib.request.urlopen(req, timeout=60) as r:\n        return r.read().decode()\n\nlink=fetch('https://rest.kegg.jp/link/pathway/pau')\n# parse gene -> set paths\ng2p=defaultdict(set)\nfor line in link.splitlines():\n    if '\\\\t' not in line: continue\n    g,p=line.split('\\\\t')\n    g=g.split(':')[1]; p=p.split(':')[1]\n    g2p[g].add(p)\np2g=defaultdict(set)\nfor g,ps in g2p.items():\n    for p in ps: p2g[p].add(g)\ndb_genes=set(g2p)\nall_paths=sorted(p2g)\n\n# load csv\ndata={}\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n    with open(f) as fh: rows=list(csv.DictReader(fh))\n    data[f]={r['gene']:float(r['log2FoldChange']) for r in rows}\nall_measured=set(data[list(data)[0]])\nprint('db genes',len(db_genes),'pathways',len(p2g),'measured overlap',len(all_measured&db_genes))\n\ndef ora(genes, universe, min_g=10, max_g=500, direction_label=''):\n    genes=set(genes)&universe\n    res=[]\n    N=len(universe); n=len(genes)\n    paths=[]\n    for p in all_paths:\n        K=len(p2g[p]&universe)\n        if K<min_g or K>max_g: continue\n        k=len(genes & p2g[p])\n        if k==0: continue\n        pval=hypergeom.sf(k-1,N,K,n)\n        paths.append((p,k,K,pval))\n    if not paths: return res\n    pvals=[x[3] for x in paths]\n    rej,pcorr,_,_=multipletests(pvals,method='fdr_bh')\n    for (p,k,K,pval),adj in zip(paths,pcorr):\n        res.append({'path':p,'k':k,'K':K,'n':n,'p':pval,'padj':adj})\n    return res\n\n# interpretation A per strain up/down\nfor uni_name, universe in [('db',db_genes),('measured',all_measured),('measured_and_db',all_measured&db_genes)]:\n    print('\\\\nUNIVERSE',uni_name,'N',len(universe))\n    sig={}\n    for f,vals in data.items():\n        up={g for g,l in vals.items() if l>1.5}\n        down={g for g,l in vals.items() if l< -1.5}\n        for d,gs in [('up',up),('down',down)]:\n            res=ora(gs,universe)\n            sig[(f,d)]={r['path'] for r in res if r['padj']<0.05}\n            print(f,d,'n query',len(gs&universe),'sig',len(sig[(f,d)]), 'top', sorted(sig[(f,d)])[:5])\n    up3=set.intersection(*[sig[(f,'up')] for f in data])\n    down3=set.intersection(*[sig[(f,'down')] for f in data])\n    print('UP3',len(up3),sorted(up3))\n    print('DOWN3',len(down3),sorted(down3))\n    print('UNION',len(up3|down3))\n\n# interpretation B common genes, ORA combined\nfor uni_name, universe in [('db',db_genes),('measured',all_measured),('measured_and_db',all_measured&db_genes)]:\n    vals_list=list(data.values())\n    up_common={g for g in all_measured if all(vals[g]>1.5 for vals in vals_list)}\n    down_common={g for g in all_measured if all(vals[g]<-1.5 for vals in vals_list)}\n    print('\\\\nB universe',uni_name,'up common',len(up_common),'down common',len(down_common))\n    for d,gs in [('up',up_common),('down',down_common)]:\n        res=ora(gs,universe)\n        sig=[r for r in res if r['padj']<0.05]\n        print(d,'sig',len(sig),sorted(r['path'] for r in sig)[:20])\nPY\npython3 /workspace/tmp/ora.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
