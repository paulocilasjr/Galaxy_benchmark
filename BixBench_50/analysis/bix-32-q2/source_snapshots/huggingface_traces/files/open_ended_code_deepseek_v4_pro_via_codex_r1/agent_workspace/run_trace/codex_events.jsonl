{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request, csv\nfrom collections import defaultdict\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau').read().decode().splitlines()\ng2p=defaultdict(set)\nfor l in link:\n if '\\\\t' not in l: continue\n g,p=l.split('\\\\t'); g=g.split(':')[1]; p=p[5:]; g2p[g].add(p)\ndata={}\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n with open(f) as fh: data[f]={r['gene']:float(r['log2FoldChange']) for r in csv.DictReader(fh)}\nvals=list(data.values())\ncommon_up=[g for g in data[list(data)[0]] if all(v[g]>1.5 for v in vals)]\ncommon_down=[g for g in data[list(data)[0]] if all(v[g]<-1.5 for v in vals)]\nprint('common_up',len(common_up)); print('common_down',len(common_down))\nfrom collections import Counter\npcount=Counter()\nfor g in common_down:\n for p in g2p[g]: pcount[p]+=1\nprint('down common genes annotated',sum(1 for g in common_down if g in g2p))\nfor p,c in pcount.most_common(20): print(p,c, 'total', sum(1 for x in g2p if p in g2p[x]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
