{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/write_pvals.py <<'PY'\nimport urllib.request, csv, os\nfrom collections import defaultdict\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau').read().decode().splitlines()\nlistp=set(l.split('\\\\t')[0] for l in urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau').read().decode().splitlines() if l.strip())\ng2p=defaultdict(set)\nfor l in link:\n if '\\\\t' not in l: continue\n g,p=l.split('\\\\t'); g=g.split(':')[1]; p=p[5:]\n if p in listp: g2p[g].add(p)\np2g=defaultdict(set)\nfor g,ps in g2p.items():\n for p in ps:p2g[p].add(g)\ndb=set(g2p); N=len(db)\ndata={}\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n with open(f) as fh:data[f]={r['gene']:float(r['log2FoldChange']) for r in csv.DictReader(fh)}\nos.makedirs('tmp',exist_ok=True)\nfor f,vals in data.items():\n for d,comp in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5)]:\n  genes=set(g for g,l in vals.items() if comp(l)) & db; n=len(genes)\n  rows=[]\n  for p in sorted(p2g):\n   K=len(p2g[p]);\n   if K<10 or K>500: continue\n   k=len(genes&p2g[p]);\n   if k==0: continue\n   pval=hypergeom.sf(k-1,N,K,n)\n   rows.append((p,k,K,n,pval))\n  padj=multipletests([x[4] for x in rows],method='fdr_bh')[1]\n  with open(f'tmp/{d}{f.split(\\\"/\\\")[1].split(\\\".\\\")[0][-2:]}_pvals.txt','w') as out:\n   out.write('path\\\\tk\\\\tK\\\\tn\\\\tp\\\\tpy_padj\\\\n')\n   for (p,k,K,n,pv),pa in zip(rows,padj):\n    out.write(f'{p}\\\\t{k}\\\\t{K}\\\\t{n}\\\\t{pv:.17g}\\\\t{pa:.17g}\\\\n')\nPY\npython3 /workspace/tmp/write_pvals.py\nRscript /workspace/tmp/check_pvals.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
