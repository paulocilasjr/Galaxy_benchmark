{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# B count variations cached data\nimport urllib.request, csv\nfrom collections import defaultdict\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau').read().decode().splitlines()\nlistp=set(l.split('\\\\t')[0] for l in urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau').read().decode().splitlines() if l.strip())\ng2p=defaultdict(set)\nfor l in link:\n if '\\\\t' not in l:continue\n g,p=l.split('\\\\t'); g=g.split(':')[1]; p=p[5:]\n if p in listp:g2p[g].add(p)\np2g=defaultdict(set)\nfor g,ps in g2p.items():\n for p in ps:p2g[p].add(g)\ndb=set(g2p)\ndata=[]\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n with open(f) as fh:data.append({r['gene']:float(r['log2FoldChange']) for r in csv.DictReader(fh)})\ncommon_up=set(g for g in data[0] if all(v[g]>1.5 for v in data))\ncommon_down=set(g for g in data[0] if all(v[g]<-1.5 for v in data))\ndef run(mn,mx):\n for d,genes in [('up',common_up),('down',common_down)]:\n  genes=genes&db; n=len(genes); rows=[]\n  for p in p2g:\n   K=len(p2g[p])\n   if K<mn or K>mx:continue\n   k=len(genes&p2g[p])\n   if k==0:continue\n   pv=hypergeom.sf(k-1,len(db),K,n); rows.append((p,pv))\n  padj=multipletests([x[1] for x in rows],method='fdr_bh')[1] if rows else []\n  sig={p for (p,pv),pa in zip(rows,padj) if pa<.05}\n  print('min',mn,'max',mx,d,'genes',n,'sig',len(sig),sorted(sig))\nfor mn in [1,2,5,10,15]:run(mn,500)\nrun(10,1000)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
