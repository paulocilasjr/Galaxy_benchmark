{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/ora_details.py <<'PY'\nimport urllib.request, csv\nfrom collections import defaultdict\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\n\ndef fetch(url):\n    with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'Mozilla/5.0'}),timeout=60) as r: return r.read().decode()\nlink=fetch('https://rest.kegg.jp/link/pathway/pau')\nlisted=fetch('https://rest.kegg.jp/list/pathway/pau')\nlist_paths=set(l.split('\\\\t')[0] for l in listed.splitlines() if l.strip())\ng2p=defaultdict(set)\nfor l in link.splitlines():\n    if '\\\\t' not in l: continue\n    g,p=l.split('\\\\t'); g=g.split(':')[1]; p=p[5:]\n    if p in list_paths: g2p[g].add(p)\np2g=defaultdict(set)\nfor g,ps in g2p.items():\n    for p in ps: p2g[p].add(g)\ndb=set(g2p)\ndata={}\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n    with open(f) as fh:\n        data[f]={r['gene']:float(r['log2FoldChange']) for r in csv.DictReader(fh)}\n\ndef ora(genes, min_g=10, max_g=500):\n    genes=set(genes)&db; n=len(genes)\n    rows=[]\n    for p in sorted(p2g):\n        K=len(p2g[p])\n        if K<min_g or K>max_g: continue\n        k=len(genes&p2g[p])\n        if k==0: continue\n        pval=hypergeom.sf(k-1,len(db),K,n)\n        rows.append([p,k,K,n,pval])\n    if not rows: return []\n    rej,padj,_,_=multipletests([x[4] for x in rows],method='fdr_bh')\n    out=[]\n    for x,pa in zip(rows,padj): out.append(x+[pa])\n    return out\nfor f,vals in data.items():\n    up={g for g,l in vals.items() if l>1.5}; down={g for g,l in vals.items() if l< -1.5}\n    for d,gs in [('up',up),('down',down)]:\n        res=ora(gs)\n        print('\\\\n',f,d,'n mapped',len(gs&db))\n        for r in sorted([r for r in res if r[5]<0.05],key=lambda x:x[4]):\n            print(' ',r)\n        print('all sig',len([r for r in res if r[5]<0.05])