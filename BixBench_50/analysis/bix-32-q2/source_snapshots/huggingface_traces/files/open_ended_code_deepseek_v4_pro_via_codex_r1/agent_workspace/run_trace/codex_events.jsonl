{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/kegg_ora.R <<'RS'\n# Base R implementation matching clusterProfiler enrichKEGG defaults for organism pau\noptions(stringsAsFactors = FALSE)\nread_res <- function(f) {\n  con <- gzfile(f, 'rb'); x <- unserialize(con); close(con)\n  a <- attributes(x)\n  data.frame(gene = a\"'$rownames, lfc = a$listData$log2FoldChange, stringsAsFactors = FALSE)\n}\nres_files <- c('\"'inputs/res_1vs97.rds','inputs/res_1vs98.rds','inputs/res_1vs99.rds')\nres_list <- lapply(res_files, read_res)\nnames(res_list) <- c('s97','s98','s99')\n\n# download KEGG\nlink_url <- 'https://rest.kegg.jp/link/pathway/pau'\nlist_url <- 'https://rest.kegg.jp/list/pathway/pau'\nlink <- try(read.delim(url(link_url), header=FALSE, sep='\\\\t', quote=''))\nlisted <- try(read.delim(url(list_url), header=FALSE, sep='\\\\t', quote=''))\nlink[,1] <- sub('\"'^path:'\"', '', link[,1])\nlink[,2] <- sub('\"'^pau:'\"', '', link[,2])\nlink <- link[link[,1] %in% listed[,1], , drop=FALSE]\npath2gene <- split(link[,2], link[,1])\ngene2path <- split(link[,1], link[,2])\nuniverse <- unique(link[,2])\nN <- length(universe)\n\nora <- function(gene_ids, minGSSize=10, maxGSSize=500) {\n  gene_ids <- unique(gene_ids)\n  qmap <- gene2path[gene_ids]\n  lens <- lengths(qmap)\n  qmap <- qmap[lens > 0]\n  n <- length(qmap)\n  if (n == 0) return(data.frame())\n  # term -> query genes\n  qdf <- data.frame(gene=rep(names(qmap), lengths(qmap)), path=unlist(qmap, use.names=FALSE), stringsAsFactors=FALSE)\n  qterm2gene <- split(qdf\"'$gene, qdf$path)\n  # annotate term full genes\n  qterm <- names(qterm2gene)\n  term2gene <- path2gene[qterm]\n  term2gene <- lapply(term2gene, intersect, universe)\n  sizes <- lengths(term2gene)\n  keep <- sizes >= minGSSize & sizes <= maxGSSize\n  term2gene <- term2gene[keep]\n  qterm2gene <- qterm2gene[keep]\n  if (length(term2gene)==0) return(data.frame())\n  qterm <- names(qterm2gene)\n  k <- lengths(qterm2gene)[qterm]\n  M <- lengths(term2gene)[qterm]\n  pvals <- phyper(k - 1, M, N - M, n, lower.tail = FALSE)\n  padj <- p.adjust(pvals, method='\"'BH')\n  data.frame(ID=qterm, k=k, M=M, n=n, pvalue=pvals, p.adjust=padj, stringsAsFactors=FALSE, row.names=NULL)\n}\n\nres_all <- list()\nfor (i in seq_along(res_list)) {\n  rr <- res_list[[i]]\n  up <- rr\"'$gene[rr$lfc > 1.5]\n  down <- rr$gene[rr$lfc < -1.5]\n  for (dir in c('\"'up','down')) {\n    genes <- if (dir=='up') up else down\n    ora_res <- ora(genes)\n    sig <- ora_res[ora_res\"'$p.adjust < 0.05, '\"'ID']\n    key <- paste0(names(res_list)[i], '_', dir)\n    res_all[[key]] <- sig\n    cat(key, 'query', length(genes), 'mapped', sum(genes %in% universe), 'ORA terms tested', nrow(ora_res), 'sig', length(sig), '\\\\n')\n    cat('  sig ids:', paste(sig, collapse=', '), '\\\\n')\n  }\n}\ncommon_up <- Reduce(intersect, res_all[c('s97_up','s98_up','s99_up')])\ncommon_down <- Reduce(intersect, res_all[c('s97_down','s98_down','s99_down')])\ncat('\\\\nPathway-intersection A: up', length(common_up), 'down', length(common_down), 'union', length(union(common_up, common_down)), '\\\\n')\ncat('down ids:', paste(common_down, collapse=', '), '\\\\n')\n\n# Common gene set ORA B\nall_genes <- res_list[[1]]\"'$gene\ncommon_up_genes <- Reduce(intersect, lapply(res_list, function(rr) rr$gene[rr$lfc > 1.5]))\ncommon_down_genes <- Reduce(intersect, lapply(res_list, function(rr) rr$gene[rr$lfc < -1.5]))\ncat('\"'\\\\nCommon genes: up', length(common_up_genes), 'down', length(common_down_genes), '\\\\n')\nfor (dir in c('up','down')) {\n  genes <- if (dir=='up') common_up_genes else common_down_genes\n  ora_res <- ora(genes)\n  sig <- ora_res[ora_res\"'$p.adjust < 0.05, '\"'ID']\n  cat('B',dir,'sig',length(sig),paste(sig,collapse=', '),'\\\\n')\n}\nRS\nRscript /workspace/tmp/kegg_ora.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
