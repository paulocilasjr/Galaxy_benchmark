{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/check_pvals.R <<'RS'\nfiles <- c('up97','down97','up98','down98','up99','down99')\nfor (f in files) {\n  fn <- file.path('tmp',paste0(f,'_pvals.txt'))\n  p <- read.table(fn, header=TRUE, sep='\\\\t')\n  p\"'$r_padj <- p.adjust(p$p, method='\"'BH')\n  p\"'$r_p <- phyper(p$k-1, p$K, p$N-p$K, p$n, lower.tail=FALSE)\n  cat(f, '\"'n', nrow(p), 'py sig', sum(p\"'$py_padj<0.05), '\"'R sig', sum(p\"'$r_padj<0.05), '\"'max p diff', max(abs(p\"'$r_p-p$p)), '\"'max padj diff', max(abs(p\"'$r_padj-p$py_padj)), '\"'\\\\n')\n  if (sum(p\"'$r_padj<0.05) != sum(p$py_padj<0.05)) print(head(p[order(p$r_padj),],15))\n}\nRS\nRscript /workspace/tmp/check_pvals.R'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
