{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# compute A count for varying min/max and universe using cached p? need full recompute\nimport urllib.request, csv\nfrom collections import defaultdict\nfrom scipy.stats import hypergeom\nfrom statsmodels.stats.multitest import multipletests\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau').read().decode().splitlines()\nlistp=set(l.split('\\\\t')[0] for l in urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau').read().decode().splitlines() if l.strip())\ng2p=defaultdict(set)\nfor l in link:\n if '\\\\t' not in l:continue\n g,p=l.split('\\\\t'); g=g.split(':')[1]; p=p[5:]\n if p in listp:g2p[g].add(p)\np2g=defaultdict(set)\nfor g,ps in g2p.items():\n for p in ps:p2g[p].add(g)\ndb=set(g2p)\ndata={}\nfor f in ['tmp/res_1vs97.csv','tmp/res_1vs98.csv','tmp/res_1vs99.csv']:\n with open(f) as fh:data[f]={r['gene']:float(r['log2FoldChange']) for r in csv.DictReader(fh)}\n\ndef run(mn,mx):\n sets={}\n for f,vals in data.items():\n  for d,comp in [('up',lambda x:x>1.5),('down',lambda x:x<-1.5)]:\n   genes=set(g for g,l in vals.items() if comp(l))&db; n=len(genes); rows=[]\n   for p,K in p2g.items():\n    if K<mn or K>mx:continue\n    k=len(genes&p2g[p])\n    if k==0:continue\n    pv=hypergeom.sf(k-1,len(db),K,n); rows.append((p,pv))\n   if rows:\n    padj=multipletests([x[1] for x in rows],method='fdr_bh')[1]\n    sets[(f,d)]={p for (p,pv),pa in zip(rows,padj) if pa<.05}\n   else:sets[(f,d)]=set()\n up=set.intersection(sets[(list(data)[0],'up')],sets[(list(data)[1],'up')],sets[(list(data)[2],'up')])\n down=set.intersection(sets[(list(data)[0],'down')],sets[(list(data)[1],'down')],sets[(list(data)[2],'down')])\n print('min',mn,'max',mx,'up',len(up),'down',len(down),'union',len(up|down))\nfor mn in [1,2,5,10,15]:run(mn,500)\nrun(10,1000); run(10,500)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
