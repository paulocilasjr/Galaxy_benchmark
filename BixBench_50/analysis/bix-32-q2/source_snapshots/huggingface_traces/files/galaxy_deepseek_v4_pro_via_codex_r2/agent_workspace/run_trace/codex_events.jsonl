{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, io, os\nsets=['up97','down97','up98','down98','up99','down99']\nD={}\nfor name in sets:\n    with open(f'/workspace/ora_{name}.tsv') as f:\n        rows=list(csv.DictReader(f, delimiter='\\\\t'))\n    D[name]={r['pathway_id']:(float(r['p_value']),float(r['adjusted_p_value']),r['pathway_name'],int(r['foreground_hits'])) for r in rows}\n# union ids\nallids=set()\nfor d in D.values(): allids|=set(d)\n# print common pathways within up and down\nfor direction in ['up','down']:\n    keys=[f'{direction}97',f'{direction}98',f'{direction}99']\n    common=set(D[keys[0]]) & set(D[keys[1]]) & set(D[keys[2]])\n    print('\\\\n',direction,'common pathways in mapping',len(common))\n    for pid in sorted(common):\n        vals=[D[k][pid] for k in keys]\n        print(pid, D[keys[0]][pid][2], [(f'p={v[0]:.3g}',f'adj={v[1]:.3g}',f'hits={v[3]}') for v in vals])\n    # print rows with raw p < 0.1 by strain\n    for k in keys:\n        s=sorted([(v[0],pid) for pid,v in D[k].items() if v[0]<0.2])\n        print(k,'p<0.2',len(s),[(pid,round(p,5)) for p,pid in s[:20]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
