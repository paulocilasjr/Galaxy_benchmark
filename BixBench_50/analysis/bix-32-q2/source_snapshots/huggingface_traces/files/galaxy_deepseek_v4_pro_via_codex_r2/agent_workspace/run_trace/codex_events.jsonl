{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport requests, csv, io, json, os\nkey=open('/run/secrets/galaxy_api_key').read().strip()\ndst='bbd44e69cb8906b51637b058e740344b'\nsets={\n 'up97':'f9cad7b01a47213519546603c9aa614e',\n 'down97':'f9cad7b01a472135a8a67a786df7b437',\n 'up98':'f9cad7b01a4721355f57058c6c69f014',\n 'down98':'f9cad7b01a4721357f9f2ac23363403f',\n 'up99':'f9cad7b01a4721350394bb0fa769a2e3',\n 'down99':'f9cad7b01a4721356dd2fd69b202c56b',\n}\nres={}\nfor name,hid in sets.items():\n    url=f'https://usegalaxy.org/api/histories/{dst}/contents/{hid}/display'\n    r=requests.get(url,headers={'x-api-key':key})\n    open(f'/workspace/ora_{name}.tsv','wb').write(r.content)\n    text=r.content.decode('utf-8')\n    rows=list(csv.DictReader(io.StringIO(text), delimiter='\\\\t'))\n    sig=[]\n    for row in rows:\n        padj=float(row['adjusted_p_value'])\n        pval=float(row['p_value'])\n        if padj < 0.05:\n            sig.append((row['pathway_id'], row['pathway_name'], row['foreground_hits'], row['pathway_genes_in_universe'], row['foreground_genes_in_universe'], row['universe_genes'], pval, padj))\n    res[name]=sig\n    print('\\\\n',name,'rows',len(rows),'sig_adj',len(sig))\n    for s in sig:\n        print(' ',s)\n# intersections\nups=[set(x[0] for x in res[k]) for k in ['up97','up98','up99']]\ndowns=[set(x[0] for x in res[k]) for k in ['down97','down98','down99']]\ninter_up=set.intersection(*ups) if ups else set()\ninter_down=set.intersection(*downs) if downs else set()\nprint('\\\\nUP intersection',inter_up)\nprint('DOWN intersection',inter_down)\nprint('UNION',len(inter_up|inter_down))\nprint('count up',len(inter_up),'count down',len(inter_down))\n# raw p intersections for reference\nraws=[]\nfor name,sig in res.items():\n    s=set(x[0] for x in sig if x[6] <0.05)\n    print(name,'rawp_sig',len(s),s)\n    raws.append((name,s))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
