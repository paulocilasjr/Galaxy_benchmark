{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nimport os\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nmapping={\n'97_up':'f9cad7b01a4721354fafb809ec85c0c0',\n'97_dn':'f9cad7b01a472135acaf1bb4dbd6048e',\n'98_up':'f9cad7b01a472135992f74687dc5f81f',\n'98_dn':'f9cad7b01a4721358599e0fde769cf49',\n'99_up':'f9cad7b01a472135d967202ab0b7e983',\n'99_dn':'f9cad7b01a472135d6dddf9c0073ffa3',\n}\nfor name,id in mapping.items():\n    p=f'/workspace/tmp/ora_fh_{name}.tsv'\n    gi.datasets.download_dataset(id, file_path=p, use_default_filename=False, maxwait=120)\n    print(name, os.path.getsize(p))\nPY\npython - <<'PY'\nimport csv\nsets={}\nfor s in ['up','dn']:\n    sets[s]={}\n    for strain in ['97','98','99']:\n        path=f'/workspace/tmp/ora_fh_{strain}_{s}.tsv'\n        sig=[]\n        with open(path) as f:\n            for r in csv.DictReader(f, delimiter='\\\\t'):\n                if float(r['adjusted_p_value']) < 0.05:\n                    sig.append(r['pathway_id'])\n        sets[s][strain]=set(sig)\n        print(strain,s,len(sig),sorted(sig))\n    inter=sets[s]['97']&sets[s]['98']&sets[s]['99']\n    print(s,'intersection',sorted(inter),len(inter))\nup=sets['up']['97']&sets['up']['98']&sets['up']['99']\ndn=sets['dn']['97']&sets['dn']['98']&sets['dn']['99']\nprint('union', sorted(up|dn), len(up|dn))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
