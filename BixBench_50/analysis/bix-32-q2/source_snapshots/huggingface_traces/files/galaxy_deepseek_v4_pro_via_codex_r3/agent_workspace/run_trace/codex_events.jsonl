{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, os\nsigns=['up','dn']\nsets={}\nfor s in signs:\n    sets[s]={}\n    for strain in ['97','98','99']:\n        path=f'/workspace/tmp/ora_{strain}_{s}.tsv'\n        sig=[]\n        allp=[]\n        with open(path) as f:\n            for r in csv.DictReader(f, delimiter='\\\\t'):\n                adj=float(r['adjusted_p_value'])\n                if adj < 0.05:\n                    sig.append(r['pathway_id'])\n                if adj < 1:\n                    allp.append((r['pathway_id'], adj))\n        sets[s][strain]=set(sig)\n        print(strain, s, 'sig', len(sig), sorted(sig))\n    inter=sets[s]['97'] & sets[s]['98'] & sets[s]['99']\n    print(s, 'intersection', sorted(inter), 'count', len(inter))\nup=sets['up']['97']&sets['up']['98']&sets['up']['99']\ndn=sets['dn']['97']&sets['dn']['98']&sets['dn']['99']\nprint('union unique', len(up|dn), sorted(up|dn))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
