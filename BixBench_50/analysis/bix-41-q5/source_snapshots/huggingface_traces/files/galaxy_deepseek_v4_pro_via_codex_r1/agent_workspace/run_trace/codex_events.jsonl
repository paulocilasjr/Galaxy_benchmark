{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, math\nrows=list(csv.DictReader(open('/workspace/Swarm_2.csv')))\nfrom collections import defaultdict\ng=defaultdict(list)\nfor r in rows:\n    key=(r['StrainNumber'],r['Ratio'])\n    g[key].append((float(r['Area']),float(r['Circularity'])))\nmeans={k:(sum(a for a,c in v)/len(v), sum(c for a,c in v)/len(v)) for k,v in g.items()}\nref=means[('1','1:0')]\nprint('ref',ref)\nfor k in sorted(means, key=lambda x: (x[0], x[1])):\n    if k[0]=='287_98':\n        m=means[k]; d=math.hypot(m[0]-ref[0],m[1]-ref[1])\n        print(k,m,'edist',d)\n# normalized by range maybe\nareas=[v[0] for k,v in means.items()]; circs=[v[1] for k,v in means.items()]\nra=max(areas)-min(areas); rc=max(circs)-min(circs)\nprint('ranges',ra,rc)\nfor k,v in means.items():\n    if k[0]=='287_98':\n        d=math.hypot((v[0]-ref[0])/ra,(v[1]-ref[1])/rc)\n        print(k,v,'scaled',d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
