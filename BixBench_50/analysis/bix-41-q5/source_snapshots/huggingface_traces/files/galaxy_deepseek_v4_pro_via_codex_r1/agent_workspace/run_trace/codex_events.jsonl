{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, math\nrows=list(csv.DictReader(open('/workspace/Swarm_2.csv')))\nfrom collections import defaultdict\ng=defaultdict(list)\nfor r in rows:\n    g[(r['StrainNumber'],r['Ratio'])].append((float(r['Area']),float(r['Circularity'])))\nmeans={k:(sum(a for a,c in v)/len(v), sum(c for a,c in v)/len(v)) for k,v in g.items()}\nref=means[('1','1:0')]\nprint('ref',ref)\nfor metric in ['raw_euclid','abs_pct_mean','scaled_range','scaled_sd']:\n    # compute sd among mixed for scaling maybe\n    mixed=[(k,v) for k,v in means.items() if k[0]=='287_98']\n    if metric=='scaled_sd':\n        aa=[v[0] for k,v in mixed]; cc=[v[1] for k,v in mixed]\n        sa=(sum((x-(sum(aa)/len(aa)))**2 for x in aa)/(len(aa)-1))**.5\n        sc=(sum((x-(sum(cc)/len(cc)))**2 for x in cc)/(len(cc)-1))**.5\n        def d(v):\n            return math.hypot((v[0]-ref[0])/sa,(v[1]-ref[1])/sc)\n        best=min(mixed,key=lambda kv:d(kv[1]))\n        print(metric,'sd',sa,sc,'best',best[0],best[1],'dist',d(best[1]))\n    elif metric=='scaled_range':\n        aa=[v[0] for k,v in mixed]; cc=[v[1] for k,v in mixed]\n        sa=max(aa)-min(aa); sc=max(cc)-min(cc)\n        def d(v):\n            return math.hypot((v[0]-ref[0])/sa,(v[1]-ref[1])/sc)\n        best=min(mixed,key=lambda kv:d(kv[1]))\n        print(metric,'range',sa,sc,'best',best[0],best[1],'dist',d(best[1]))\n    elif metric=='raw_euclid':\n        def d(v):\n            return math.hypot(v[0]-ref[0],v[1]-ref[1])\n        best=min(mixed,key=lambda kv:d(kv[1]))\n        print(metric,'best',best[0],best[1],'dist',d(best[1]))\n    else:\n        def d(v):\n            return (abs(v[0]-ref[0])/ref[0] + abs(v[1]-ref[1])/ref[1])/2\n        best=min(mixed,key=lambda kv:d(kv[1]))\n        print(metric,'best',best[0],best[1],'dist',d(best[1]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
