{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"which bcftools || true; which samtools || true; which vcftools || true; python3 - <<'PY'\nimport gzip\nfrom pathlib import Path\np=Path('inputs/SRR35233585_raw_variants.vcf')\n# count categories ignoring headers, classify records with single-char ref/alt\nn=0; ts=0; tv=0; indel=0; multi=0; other=0\nfor line in open(p):\n    if line.startswith('#'): continue\n    f=line.rstrip('\\\\n').split('\\\\t')\n    ref=f[3]; alts=f[4].split(',')\n    # include only biallelic single base? count site-wise each ALT separately?\n    if len(ref)==1 and all(len(a)==1 for a in alts):\n        n+=len(alts)\n        for a in alts:\n            pair={ref,a}\n            if pair in ({'A','G'},{'C','T'}): ts+=1\n            else: tv+=1\n    elif len(alts)==1 and (len(ref)\"'!=1 or len(alts[0])!=1):\n        indel+=1\n    else:\n        multi+=1\nprint('\"'biallelic/site all alts n',n,'ts',ts,'tv',tv,'ratio',ts/tv if tv else None)\n# Count records biallelic only and also alt-specific\nnrec=0; ts1=0; tv1=0; nonbiallelic=0; multiallelic_records=0; indels=0; complex=0\nfor line in open(p):\n    if line.startswith('#'): continue\n    f=line.rstrip('\\\\n').split('\\\\t')\n    ref=f[3]; alts=f[4].split(',')\n    if len(alts)==1 and len(ref)==1 and len(alts[0])==1:\n        nrec+=1\n        pair={ref,alts[0]}\n        if pair in ({'A','G'},{'C','T'}): ts1+=1\n        else: tv1+=1\n    else:\n        nonbiallelic+=1\n        if len(alts)>1: multiallelic_records+=1\n        if len(alts)==1 and (len(ref)\"'!=1 or len(alts[0])!=1): indels+=1\n        if len(alts)==1 and len(ref)!=1 and len(alts[0])!=1: complex+=1\nprint('\"'biallelic SNV records',nrec,'ts',ts1,'tv',tv1,'ratio',ts1/tv1 if tv1 else None,'nonbiallelic',nonbiallelic,'multiallelic_records',multiallelic_records,'indels',indels)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
