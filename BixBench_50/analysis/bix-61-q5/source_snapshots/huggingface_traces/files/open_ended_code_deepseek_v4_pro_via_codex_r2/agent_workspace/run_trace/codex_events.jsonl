{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom collections import Counter\nimport math\nvcf='inputs/SRR35233585_raw_variants.vcf'\ntrans=set([('A','G'),('G','A'),('C','T'),('T','C')])\n# all alt allele pairs; count each SNP allele, skip non-single-base ref/alt\nallele_ts=tv=0\nfirst_ts=tv=0\nsite_snp=0\nmulti_snp=0\nrecords=0\nsnps=0\nindels=0\nfor line in open(vcf):\n    if line.startswith('#'): continue\n    records+=1\n    f=line.rstrip('\\\\n').split('\\\\t')\n    ref=f[3]; alts=f[4].split(','); gt=f[9].split(':')[0]\n    # count sites with any snp (ref len1 and any alt len1)\n    any_snp=len(ref)==1 and any(len(a)==1 for a in alts)\n    if any_snp: snps+=1\n    any_indel=len(ref)\"'!=1 or any(len(a)!=1 for a in alts)\n    if any_indel: indels+=1\n    for a in alts:\n        if len(ref)==1 and len(a)==1 and ref!=a:\n            allele_ts += 1 if (ref,a) in trans else 0\n            allele_tv += 0 if (ref,a) in trans else 1\n    # first alt only\n    a=alts[0]\n    if len(ref)==1 and len(a)==1 and ref!=a:\n        first_ts += 1 if (ref,a) in trans else 0\n        first_tv += 0 if (ref,a) in trans else 1\nprint('\"'records',records,'snpsites',snps,'indels',indels)\nprint('allele ts/tv',allele_ts,allele_tv,round(allele_ts/allele_tv,6),round(allele_ts/allele_tv,2))\nprint('first alt ts/tv',first_ts,first_tv,round(first_ts/first_tv,6),round(first_ts/first_tv,2))\n# biallelic snps only\nbi_ts=bi_tv=0\nfor line in open(vcf):\n    if line.startswith('#'): continue\n    f=line.rstrip('\\\\n').split('\\\\t'); ref=f[3]; alt=f[4]\n    if ',' in alt: continue\n    if len(ref)==1 and len(alt)==1 and ref\"'!=alt:\n        bi_ts += 1 if (ref,alt) in trans else 0\n        bi_tv += 0 if (ref,alt) in trans else 1\nprint('\"'biallelic snp ts/tv',bi_ts,bi_tv,round(bi_ts/bi_tv,6),round(bi_ts/bi_tv,2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
