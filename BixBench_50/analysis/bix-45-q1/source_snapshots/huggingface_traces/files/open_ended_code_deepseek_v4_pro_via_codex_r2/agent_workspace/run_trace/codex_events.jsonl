{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\n# Recompute quickly by direct phykit class for all to ensure and variants\nfrom pathlib import Path\nimport json, subprocess, math\nfrom scipy import stats\nfrom statistics import median,mean\nfrom phykit.services.alignment.rcv import RelativeCompositionVariability\nfrom argparse import Namespace\n\ndef phykit_rcv(path):\n    inst=RelativeCompositionVariability(Namespace(alignment=str(path), json=False))\n    return inst.calculate_rcv()\n# But run method rounds to 4 decimals. Use run? We'll use calculate and round.\ndef vals(d):\n    vv={}\n    for p in sorted(Path(d).glob('*.faa.mafft')):\n        x=phykit_rcv(p)\n        vv[p.name[:-len('.faa.mafft')]]=round(x,4)\n    return vv\nA=vals('/workspace/work_animals'); F=vals('/workspace/work_fungi')\ncommon=sorted(set(A)&set(F))\nfor name, fa in [('all',F),('common',{g:F[g] for g in common})]:\n    u,p=stats.mannwhitneyu(list(A.values()), list(fa.values()), alternative='two-sided')\n    print(name, len(A), len(fa), 'p', repr(p), 'U',u, 'medA',median(A.values()),'medF',median(fa.values()))\n# MWU method='asymptotic' perhaps scipy default exact? let's check\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
