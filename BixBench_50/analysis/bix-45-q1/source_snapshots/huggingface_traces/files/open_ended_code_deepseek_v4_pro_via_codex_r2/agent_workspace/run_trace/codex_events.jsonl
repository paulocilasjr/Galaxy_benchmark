{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nfrom scipy import stats\nfrom statistics import median, mean\n\ndef old_rcv(path):\n    # replicate phykit <=2.0: concat all record.seq including gaps; denom num_records*aln_len\n    from Bio import AlignIO\n    aln=AlignIO.read(str(path),'fasta')\n    aln_len=aln.get_alignment_length(); num=len(aln)\n    concat=''.join(str(r.seq) for r in aln)\n    total=Counter(concat)\n    avg={c:total[c]/num for c in total}\n    vals=[]\n    for r in aln:\n        rc=Counter(str(r.seq))\n        temp=sum(abs(rc[c]-avg[c]) for c in total)\n        vals.append(temp/(num*aln_len))\n    return sum(vals)\n\ndef vals(d):\n    vv={}\n    for p in sorted(Path(d).glob('*.faa.mafft')):\n        vv[p.name[:-len('.faa.mafft')]]=round(old_rcv(p),4)\n    return vv\nA=vals('/workspace/work_animals');F=vals('/workspace/work_fungi')\nprint('old n',len(A),len(F),'medA',median(A.values()),'medF',median(F.values()),'meanA',mean(A.values()),'meanF',mean(F.values()))\nprint('p all',stats.mannwhitneyu(list(A.values()),list(F.values()),alternative='two-sided'))\ncommon=set(A)&set(F)\nprint('p common',stats.mannwhitneyu(list(A.values()),[F[g] for g in common],alternative='two-sided'))\n# distributions above .25\nfor name,V in [('A',A.values()),('F',F.values())]:\n print(name,'>0.25',sum(v>.25 for v in V)/len(V), 'max',max(V), 'min',min(V))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
