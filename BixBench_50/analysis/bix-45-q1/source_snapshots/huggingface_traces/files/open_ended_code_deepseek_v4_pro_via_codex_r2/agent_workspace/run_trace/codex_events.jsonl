{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && python3 - <<'PY'\n# produce final summary and save answer candidate? not yet\nimport sys\nsys.path.insert(0,'/workspace/phykit203')\nfrom phykit.services.alignment.rcv import RelativeCompositionVariability\nfrom argparse import Namespace\nfrom pathlib import Path\nfrom scipy import stats\nfrom collections import Counter\n\ndef compute(d):\n    vals={}\n    for p in sorted(Path(d).glob('*.faa.mafft')):\n        raw=RelativeCompositionVariability(Namespace(alignment=str(p))).calculate_rcv()\n        vals[p.name[:-len('.faa.mafft')]]=round(raw,4)\n    return vals\nA=compute('work_animals'); F=compute('work_fungi')\nres=stats.mannwhitneyu(list(A.values()),list(F.values()),alternative='two-sided')\nprint('A count',len(A),'F count',len(F),'common',len(set(A)&set(F)))\nprint('p all scipy',format(res.pvalue,'.17g'))\nprint('U all',res.statistic)\nprint('p common scipy',format(stats.mannwhitneyu(list(A.values()),[F[g] for g in set(A)&set(F)],alternative='two-sided').pvalue,'.17g'))\nprint('A median/mean/min/max',__import__('statistics').median(A.values()),sum(A.values())/len(A),min(A.values()),max(A.values()))\nprint('F median/mean/min/max',__import__('statistics').median(F.values()),sum(F.values())/len(F),min(F.values()),max(F.values()))\n# R-style continuity correct p\n# calculate using scipy default (already)\nPY\nRscript - <<'EOF'\na=scan('/workspace/old_A.csv',quiet=TRUE); b=scan('/workspace/old_F.csv',quiet=TRUE)\nres=wilcox.test(a,b,alternative='two.sided',exact=FALSE,correct=TRUE)\ncat('R p',format(res\"'$p.value,digits=22,scientific=TRUE),'\"'\\\\n')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
