{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, collections, numpy as np\nwith open('inputs/ROSMAP_genexp_ad.csv', newline='') as f:\n    r=csv.reader(f); h=next(r); rows=list(r)\nX=np.array([[float(x) for x in row[1:]] for row in rows],float).T\nY=np.log10(X+1)\nids=h[1:]\ngroups=collections.defaultdict(list)\nfor i,pid in enumerate(ids): groups[pid].append(i)\n# standardize rows (genes columns) for correlation-ish dot\nYc=Y-Y.mean(axis=1, keepdims=True)\nnorms=np.linalg.norm(Yc, axis=1)\nZ=Yc/norms[:,None]\nsame=[]; out=[]\n# sample random unrelated pairs\nrng=np.random.default_rng(0)\n# all same id pairs\nfor pid, idx in groups.items():\n    if len(idx)>1:\n        for a in range(len(idx)):\n            for b in range(a+1,len(idx)):\n                same.append(Z[idx[a]]@Z[idx[b]])\n# random out from unique groups selecting singles only maybe all random\nuids=list(groups.keys())\nfor _ in range(1000):\n    p1,p2=rng.choice(uids, size=2, replace=False)\n    i=rng.choice(groups[p1]); j=rng.choice(groups[p2])\n    out.append(Z[i]@Z[j])\nprint('same id n',len(same),'mean',np.mean(same),'min',np.min(same),'max',np.max(same))\nprint('unrelated n',len(out),'mean',np.mean(out),'min',np.min(out),'max',np.max(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
