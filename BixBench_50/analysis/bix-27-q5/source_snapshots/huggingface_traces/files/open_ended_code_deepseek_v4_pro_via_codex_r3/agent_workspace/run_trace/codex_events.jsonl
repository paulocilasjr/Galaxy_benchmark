{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, collections, math\nwith open('inputs/ROSMAP_genexp_ad.csv', newline='') as f:\n    r=csv.reader(f); h=next(r); rows=list(r)\n# transpose matrix numeric; rows list genes, each row [gene, values]\ngene_names=[row[0] for row in rows]\nvals=[[float(x) for x in row[1:]] for row in rows]\n# n_samples x n_genes\nimport numpy as np\nX=np.array(vals, dtype=float).T\nids=h[1:]\ngroups=collections.defaultdict(list)\nfor i,pid in enumerate(ids): groups[pid].append(i)\nfor pid in sorted(groups):\n    if len(groups[pid])>1:\n        idx=groups[pid]\n        # correlation all pairs after log10+1 perhaps\n        Y=np.log10(X[idx]+1)\n        pairs=[]\n        for a in range(len(idx)):\n            for b in range(a+1,len(idx)):\n                x=Y[a]; y=Y[b]\n                # centering\n                xc=x-x.mean(); yc=y-y.mean()\n                den=math.sqrt((xc@xc)*(yc@yc))\n                corr=(xc@yc)/den if den else float('nan')\n                pairs.append((idx[a], idx[b], corr))\n        print(pid, [(i,j,round(c,4)) for i,j,c in pairs])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
