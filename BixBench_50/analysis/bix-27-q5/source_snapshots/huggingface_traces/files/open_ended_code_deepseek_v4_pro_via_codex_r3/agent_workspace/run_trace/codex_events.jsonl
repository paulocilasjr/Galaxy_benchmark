{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, numpy as np, collections, time\nwith open('inputs/ROSMAP_genexp_ad.csv', newline='') as f:\n    r=csv.reader(f); h=next(r); rows=list(r)\nX=np.array([[float(x) for x in row[1:]] for row in rows], float).T\nids=h[1:]\nY=np.log10(X+1)\n\ndef pca(Y):\n    # center columns (genes/features), ddof=1 total variance\n    Yc=Y-Y.mean(axis=0, keepdims=True)\n    # compute total variance across full feature space\n    total=float((Yc**2).sum()/(Y.shape[0]-1))\n    # SVD: U (n,k), s (k), Vt (k,p); centered rows\n    U,s,Vt=np.linalg.svd(Yc, full_matrices=False)\n    ev=(s**2)/(Y.shape[0]-1)\n    return ev, total, ev[0]/total*100, U,s\n\nev_all,tot_all,pct_all,_,_=pca(Y)\nprint('all n', Y.shape, 'total variance', tot_all, 'PC1 eigen', ev_all[0], 'pct', pct_all)\nprint('first 5 ratios all', ev_all[:5]/tot_all*100)\nprint('sum ev all / total', ev_all.sum()/tot_all, 'ncomp min', min(Y.shape)-1)\n\n# unique only (exclude any id occurring more than once)\ncnt=collections.Counter(ids)\nkeep=[i for i,pid in enumerate(ids) if cnt[pid]==1]\nY_unique=Y[keep]\nev_u,tot_u,pct_u,_,_=pca(Y_unique)\nprint('unique n', Y_unique.shape, 'total variance', tot_u, 'PC1 eigen', ev_u[0], 'pct', pct_u)\nprint('first 5 ratios unique', ev_u[:5]/tot_u*100)\nprint('sum ev unique / total', ev_u.sum()/tot_u, 'ncomp min', min(Y_unique.shape)-1)\n\n# averaging duplicates as technical replicate scenario\ngroups=collections.defaultdict(list)\nfor i,pid in enumerate(ids): groups[pid].append(i)\n# iterate in occurrence order preserve order of first appearance, average Y for each group\norder=[]\nfor pid in ids:\n    if pid not in order: order.append(pid)\nY_avg=[]\nfor pid in order:\n    Y_avg.append(Y[groups[pid]].mean(axis=0))\nY_avg=np.array(Y_avg)\nev_a,tot_a,pct_a,_,_=pca(Y_avg)\nprint('avg groups n', Y_avg.shape, 'pct', pct_a)\nprint('first5 avg', ev_a[:5]/tot_a*100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
