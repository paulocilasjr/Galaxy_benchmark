{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, collections, numpy as np\npath='/workspace/inputs/ROSMAP_genexp_ad.csv'\nwith open(path, newline='') as f:\n    r=csv.reader(f); h=next(r); rows=list(r)\nids=h[1:]\n# transpose parse to columns floats\nmat=np.array([[float(x) for x in row[1:]] for row in rows], dtype=float) # genes x samples\nprint('mat',mat.shape)\nby=collections.defaultdict(list)\nfor j,name in enumerate(ids): by[name].append(j)\nfor name in sorted(by):\n    if len(by[name])>1:\n        cols=by[name]\n        sub=mat[:,cols]\n        exact=np.array_equal(sub[:,0], sub[:,1]) if len(cols)==2 else False\n        # mean abs diff between first and others\n        diffs=[]\n        for k in range(1,len(cols)):\n            d=np.abs(sub[:,0]-sub[:,k])\n            diffs.append((d.mean(), d.max(), float(np.corrcoef(sub[:,0], sub[:,k])[0,1])))\n        print(name, 'cols',cols, 'exact_pair0_1', exact, 'mean/max diff', [(round(a,3),round(b,3),round(c,5)) for a,b,c in diffs])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
