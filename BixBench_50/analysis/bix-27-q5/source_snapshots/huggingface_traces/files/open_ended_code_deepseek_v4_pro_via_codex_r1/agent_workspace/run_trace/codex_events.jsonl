{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, collections\nimport numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import PCA\n\nexpr_path='/workspace/inputs/ROSMAP_genexp_ad.csv'\nmeta_path='/workspace/inputs/ROSMAP_meta_ad.csv'\n\n# Raw expression header to preserve duplicated sample labels without pandas renaming.\nwith open(expr_path, newline='') as f:\n    reader = csv.reader(f)\n    header = next(reader)\n    # rows: genes x samples, numeric data\n    data = np.array([[float(v) for v in row[1:]] for row in reader], dtype=np.float64)\n\nsample_ids = header[1:]\ngene_ids = [row[0] for row in csv.reader(open(expr_path)) if False]  # not used\nprint('matrix genes x samples:', data.shape)\nprint('unique sample labels:', len(set(sample_ids)), 'total sample labels:', len(sample_ids))\nprint('any NaN in expression:', np.isnan(data).any())\nprint('any Inf:', np.isinf(data).any())\nprint('min raw:', data.min(), 'max raw:', data.max())\n\n# Metadata companion check.\nwith open(meta_path, newline='') as f:\n    r = csv.reader(f)\n    mh = next(r)\n    mrows = list(r)\nmeta_ids = [row[0] for row in mrows]\nprint('metadata rows:', len(meta_ids), 'unique metadata IDs:', len(set(meta_ids)))\nprint('metadata fields:', mh)\nprint('metadata IDs missing from expression:', sorted(set(meta_ids)-set(sample_ids)))\nprint('expression IDs missing from metadata:', sorted(set(sample_ids)-set(meta_ids)))\n\ncounts = collections.Counter(sample_ids)\ncollided = {k for k,v in counts.items() if v > 1}\nprint('collided primary labels:', len(collided))\nprint('collided columns:', sum(counts[k] for k in collided))\nprint('resolved columns:', len(sample_ids) - sum(counts[k] for k in collided))\n\n# inspect every metadata row in every repeated-ID group for secondary identity and conflicts\n# (already done separately; here summarize invariant conflicts)\nstable_fields = ['msex', 'apoe_genotype']\nby = collections.defaultdict(list)\nfor row in mrows:\n    by[row[0]].append(row)\nconflicts = 0\nfor k,v in by.items():\n    if len(v) > 1:\n        for field in stable_fields:\n            fi = mh.index(field)\n            vals = {row[fi] for row in v}\n            if len(vals) > 1:\n                conflicts += 1\nprint('stable-field conflict groups:', conflicts)\n\n# Per skill: exclude every occurrence of collided primary IDs.\nkeep_cols = [i for i, sid in enumerate(sample_ids) if sid not in collided]\nprint('keeping columns:', len(keep_cols))\n\n# samples as rows, genes as columns\nX = data[:, keep_cols].T.astype(np.float64)\nprint('fitted orientation samples x genes:', X.shape)\n\n# log10 transform with pseudocount 1\nXlog = np.log10(X + 1.0)\nprint('finite after log:', np.isfinite(Xlog).all())\n\n# remove zero-variance genes after final transform\nvar = Xlog.var(axis=0, ddof=1)\nnonconst = var > 0\nprint('zero-variance genes after log:', int((~nonconst).sum()))\nY = Xlog[:, nonconst]\nYc = Y - Y.mean(axis=0)\nprint('centered finite:', np.isfinite(Yc).all())\n\n# numpy exact full SVD\nU, S, Vt = np.linalg.svd(Yc, full_matrices=False)\neig = S**2 / (Y.shape[0] - 1)\ntotal_var = eig.sum()\npc1_np = eig[0] / total_var * 100\nprint('num components available:', len(eig))\nprint('total variance:', repr(total_var))\nprint('PC1 explained variance (numpy full denominator):', repr(pc1_np))\n\n# sklearn PCA n_components=100, full solver\npca = PCA(n_components=100, svd_solver='full')\npca.fit(Y)\nprint('sklearn components:', pca.n_components_, 'features:', pca.n_features_in_)\nprint('sklearn PC1 ratio %:', repr(pca.explained_variance_ratio_[0]*100))\nprint('sklearn sum first100 %:', repr(pca.explained_variance_ratio_.sum()*100))\nprint('sklearn first eigenvalue:', repr(pca.explained_variance_[0]))\nprint('sklearn full total variance (approx):', repr(pca.explained_variance_.sum() / pca.explained_variance_ratio_.sum()))\nprint('difference numpy/sklearn:', repr(abs(pc1_np - pca.explained_variance_ratio_[0]*100)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
