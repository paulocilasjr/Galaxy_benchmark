{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom sklearn.decomposition import PCA\n# read raw header with duplicate names preserved; pandas mangles but numeric values okay.\nexpr=pd.read_csv('/workspace/inputs/ROSMAP_genexp_ad.csv', index_col=0)\nprint('expr shape', expr.shape)\nX=expr.T.astype(float) # samples x genes 222 x 2456\nXlog=np.log10(X.values + 1.0)\n# zero variance features after log\nnonconst=np.var(Xlog, axis=0) > 0\nprint('nonconst genes', nonconst.sum(), 'zero variance', (~nonconst).sum())\nY=Xlog[:, nonconst]\nprint('Y shape', Y.shape)\n# center features\nYc=Y - Y.mean(axis=0)\nprint('finite?', np.isfinite(Yc).all())\n# use numpy svd\nU,S,Vt=np.linalg.svd(Yc, full_matrices=False)\neig=S**2/(Y.shape[0]-1)\ntotal=eig.sum()\nprint('rank/eigs count', len(eig), 'total variance', total)\nprint('svd first ratio', eig[0]/total*100)\nprint('sum first 100 ratio', eig[:100].sum()/total*100)\n# sklearn verify\npca=PCA(n_components=100, svd_solver='full')\npca.fit(Y)\nprint('sklearn first', pca.explained_variance_ratio_[0]*100)\nprint('sklearn sum100', pca.explained_variance_ratio_.sum()*100)\nprint('sklearn total denom?', pca.explained_variance_.sum(), 'n_features', pca.n_features_in_)\n# compare eigen first\nprint('sklearn ev first', pca.explained_variance_[0])\nprint('numpy eig first', eig[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
