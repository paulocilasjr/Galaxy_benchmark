{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport csv, collections, numpy as np, pandas as pd\nfrom sklearn.decomposition import PCA\n# raw header names\nwith open('/workspace/inputs/ROSMAP_genexp_ad.csv') as f:\n    h=f.readline().rstrip('\\\\n').split(',')\nids=h[1:]\nexpr=pd.read_csv('/workspace/inputs/ROSMAP_genexp_ad.csv', index_col=0)\n# map raw names manually to columns; expr columns mangled but order same as ids\n# Count raw IDs\ncnt=collections.Counter(ids)\ndups={k for k,v in cnt.items() if v>1}\nkeep=[i for i,name in enumerate(ids) if name not in dups]\nprint('n keep', len(keep), 'n excluded', len(ids)-len(keep))\nX=expr.T.astype(float).values[keep,:]\nXlog=np.log10(X+1.0)\nprint('Xlog shape', Xlog.shape)\nY=Xlog - Xlog.mean(axis=0)\nU,S,Vt=np.linalg.svd(Y, full_matrices=False)\neig=S**2/(Y.shape[0]-1)\ntotal=eig.sum()\nprint('PC1 resolved %', eig[0]/total*100)\nprint('sum100', eig[:100].sum()/total*100)\n# average duplicates variant (though not skill)\n# build groups positions\nby=collections.defaultdict(list)\nfor i,name in enumerate(ids): by[name].append(i)\nagg=[]\nfor name, pos in by.items():\n    if len(pos)==1: agg.append(expr.iloc[:,pos[0]].values.astype(float))\n    else:\n        # average raw values across duplicate columns\n        agg.append(expr.iloc[:,pos].values.astype(float).mean(axis=1))\nA=np.array(agg).T\nAlog=np.log10(A+1.0)\nY=Alog-Alog.mean(axis=0)\nU,S,Vt=np.linalg.svd(Y, full_matrices=False)\neig=S**2/(Y.shape[0]-1)\nprint('agg by ID unique n=', A.shape[0], 'PC1 %', eig[0]/eig.sum()*100, 'sum100', eig[:100].sum()/eig.sum()*100)\n# dedup keep first\nfirst_by={}\nfor i,name in enumerate(ids):\n    if name not in first_by: first_by[name]=i\nidx=sorted(first_by.values())\nX=expr.T.astype(float).values[idx,:]\nXlog=np.log10(X+1.0); Y=Xlog-Xlog.mean(axis=0)\nU,S,Vt=np.linalg.svd(Y, full_matrices=False); eig=S**2/(Y.shape[0]-1)\nprint('first occurrence n=', len(idx), 'PC1 %', eig[0]/eig.sum()*100, 'sum100', eig[:100].sum()/eig.sum()*100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
