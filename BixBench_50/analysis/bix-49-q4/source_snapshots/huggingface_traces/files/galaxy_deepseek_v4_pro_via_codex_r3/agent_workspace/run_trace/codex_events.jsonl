{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os, math\nfrom bioblend.galaxy import GalaxyInstance\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\ndid='f9cad7b01a472135a5537f87b6345b98'\ndata=gi.datasets.download_dataset(did, maxwait=300)\nopen('/workspace/deseq2_result.tsv','wb').write(data)\nprint(type(data), len(data))\ntext=data.decode('utf-8', errors='replace')\nlines=text.splitlines()\nprint('lines', len(lines))\nfor i,line in enumerate(lines[:5]):\n    print(i, repr(line))\nfor i,line in enumerate(lines[-5:], start=max(0,len(lines)-5)):\n    print(i, repr(line))\n# count padj column 6, no header\ncount=0\nnonnum=0\nfor i,line in enumerate(lines,1):\n    if not line.strip(): continue\n    fields=line.split('\\\\t')\n    if len(fields)<6:\n        print('short line', i, fields)\n        continue\n    val=fields[5].strip()\n    if val == 'NA' or val == '':\n        continue\n    try:\n        p=float(val)\n    except Exception as e:\n        nonnum+=1\n        if nonnum<=5:\n            print('bad padj', i, repr(val))\n        continue\n    if p < 0.05:\n        count+=1\nprint('padj<0.05 count', count, 'nonnum', nonnum)\n# summary of padj distributions\nimport collections\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
