\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet_spaced_levels.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated group\"/>\n            <param name=\"select_data|design_formula_mode|target_level\" value=\"Treated group\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n                <param name=\"lfc_shrinkage_type\" value=\"normal\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"pdf,normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <metadata name=\"column_names\" value=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                <assert_contents>\n                    <has_line_matching expression=\"^FBgn0003360\\t1933\\.9504[^\\t]*\\t-2\\.5[^\\t]*\\t0\\.11[^\\t]*\\t[0-9.]+e-[0-9]+\\t[0-9.]+e-[0-9]+$\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n            <output name=\"plots\" ftype=\"pdf\">\n                <assert_contents>\n                    <has_size min=\"1\"/>\n                </assert_contents>\n            </output>\n            <assert_stdout>\n                <has_text text=\"using rlog transformation for plots (7 samples)\"/>\n            </assert_stdout>\n        </test>\n        <!-- Use VST for generic plots when the dataset contains more than 30 samples -->\n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"treated_01.counts\" value=\"large_sample_counts/treated_01.counts\"/>\n                    <element name=\"treated_02.counts\" value=\"large_sample_counts/treated_02.counts\"/>\n                    <element name=\"treated_03.counts\" value=\"large_sample_counts/treated_03.counts\"/>\n                    <element name=\"treated_04.counts\" value=\"large_sample_counts/treated_04.counts\"/>\n                    <element name=\"treated_05.counts\" value=\"large_sample_counts/treated_05.counts\"/>\n                    <element name=\"treated_06.counts\" value=\"large_sample_counts/treated_06.counts\"/>\n                    <element name=\"treated_07.counts\" value=\"large_sample_counts/treated_07.counts\"/>\n                    <element name=\"treated_08.counts\" value=\"large_sample_counts/treated_08.counts\"/>\n                    <element name=\"treated_09.counts\" value=\"large_sample_counts/treated_09.counts\"/>\n                    <element name=\"treated_10.counts\" value=\"large_sample_counts/treated_10.counts\"/>\n                    <element name=\"treated_11.counts\" value=\"large_sample_counts/treated_11.counts\"/>\n                    <element name=\"treated_12.counts\" value=\"large_sample_counts/treated_12.counts\"/>\n                    <element name=\"treated_13.counts\" value=\"large_sample_counts/treated_13.counts\"/>\n                    <element name=\"treated_14.counts\" value=\"large_sample_counts/treated_14.counts\"/>\n                    <element name=\"treated_15.counts\" value=\"large_sample_counts/treated_15.counts\"/>\n                    <element name=\"treated_16.counts\" value=\"large_sample_counts/treated_16.counts\"/>\n                    <element name=\"untreated_01.counts\" value=\"large_sample_counts/untreated_01.counts\"/>\n                    <element name=\"untreated_02.counts\" value=\"large_sample_counts/untreated_02.counts\"/>\n                    <element name=\"untreated_03.counts\" value=\"large_sample_counts/untreated_03.counts\"/>\n                    <element name=\"untreated_04.counts\" value=\"large_sample_counts/untreated_04.counts\"/>\n                    <element name=\"untreated_05.counts\" value=\"large_sample_counts/untreated_05.counts\"/>\n                    <element name=\"untreated_06.counts\" value=\"large_sample_counts/untreated_06.counts\"/>\n                    <element name=\"untreated_07.counts\" value=\"large_sample_counts/untreated_07.counts\"/>\n                    <element name=\"untreated_08.counts\" value=\"large_sample_counts/untreated_08.counts\"/>\n                    <element name=\"untreated_09.counts\" value=\"large_sample_counts/untreated_09.counts\"/>\n                    <element name=\"untreated_10.counts\" value=\"large_sample_counts/untreated_10.counts\"/>\n                    <element name=\"untreated_11.counts\" value=\"large_sample_counts/untreated_11.counts\"/>\n                    <element name=\"untreated_12.counts\" value=\"large_sample_counts/untreated_12.counts\"/>\n                    <element name=\"untreated_13.counts\" value=\"large_sample_counts/untreated_13.counts\"/>\n                    <element name=\"untreated_14.counts\" value=\"large_sample_counts/untreated_14.counts\"/>\n                    <element name=\"untreated_15.counts\" value=\"large_sample_counts/untreated_15.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet_31_samples.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <param name=\"select_data|design_formula_mode|target_level\" value=\"Treated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"pdf\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <has_n_lines n=\"120\"/>\n                </assert_contents>\n            </output>\n            <output name=\"plots\" ftype=\"pdf\">\n                <assert_contents>\n                    <has_size min=\"1\"/>\n                </assert_contents>\n            </output>\n            <assert_stdout>\n                <has_text text=\"using full VST for plots (31 samples; 120 genes eligible for fast VST)\"/>\n            </assert_stdout>\n        </test>\n        <!--Test sample_sheet_contrasts mode with DESeq2 apeglm lfcShrink and non-simple factor levels -->\n        <test expect_num_outputs=\"3\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet_spaced_levels.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated group\"/>\n            <param name=\"select_data|design_formula_mode|target_level\" value=\"Treated group\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n                <param name=\"lfc_shrinkage_type\" value=\"apeglm\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"pdf,normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <metadata name=\"column_names\" value=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                <assert_contents>\n                    <has_line_matching expression=\"^FBgn0003360\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+$\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n            <output name=\"plots\" ftype=\"pdf\">\n                <assert_contents>\n                    <has_size min=\"1\"/>\n                </assert_contents>\n            </output>\n        </test>\n        <!--Test sample_sheet_contrasts mode with DESeq2 lfcShrink apeglm -->\n        <test expect_num_outputs=\"3\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <param name=\"select_data|design_formula_mode|target_level\" value=\"Treated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n                <param name=\"lfc_shrinkage_type\" value=\"apeglm\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"pdf,normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <metadata name=\"column_names\" value=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                <assert_contents>\n                    <has_line_matching expression=\"^FBgn0003360\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+$\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n            <output name=\"plots\" ftype=\"pdf\">\n                <assert_contents>\n                    <has_size min=\"1\"/>\n                </assert_contents>\n            </output>\n        </test>\n        <!--Test sample_sheet_contrasts mode with DESeq2 lfcShrink ashr -->\n        <test expect_num_outputs=\"3\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"automatic\"/>\n            <param name=\"select_data|design_formula_mode|factor\" value=\"2\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <param name=\"select_data|design_formula_mode|target_level\" value=\"Treated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"0\"/>\n                <param name=\"lfc_shrinkage_type\" value=\"ashr\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"pdf,normCounts\"/>\n            </section>\n            <output name=\"deseq_out\">\n                <metadata name=\"column_names\" value=\"GeneID,Base mean,log2(FC),lfcSE,P-value,P-adj\"/>\n                <assert_contents>\n                    <has_line_matching expression=\"^FBgn0003360\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+\\t[^\\t]+$\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n            <output name=\"plots\" ftype=\"pdf\">\n                <assert_contents>\n                    <has_size min=\"1\"/>\n                </assert_contents>\n            </output>\n        </test>\n        <!--Test sample_sheet_contrasts with custom design formula -->\n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"custom\"/>\n            <param name=\"select_data|design_formula_mode|design_formula\" value=\"~ treatment\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"GSM461176_untreat_single.counts\\tGSM461177_untreat_paired.counts\\tGSM461178_untreat_paired.counts\\tGSM461182_untreat_single.counts\\tGSM461179_treat_single.counts\\tGSM461180_treat_paired.counts\\tGSM461181_treat_paired.counts\"/>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <!-- Custom formula ~treatment with reference=Untreated, compares Treated vs Untreated -->\n                    <has_text_matching expression=\"FBgn0003360\\t1933\\.9504.*\\t-2\\.8399.*\\t0\\.1309.*\\t-21\\.68.*\\t.*e-104\\t.*e-101\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n        </test>\n        <!--Test sample_sheet_contrasts with multi-factor custom design formula -->\n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"custom\"/>\n            <param name=\"select_data|design_formula_mode|design_formula\" value=\"~ sequencing + treatment\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <!-- Verify all 7 samples present with correct values (column order may vary) -->\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                    <has_n_columns n=\"8\"/>\n                </assert_contents>\n            </output>\n            <output name=\"deseq_out\">\n                <assert_contents>\n                    <!-- Multi-factor design ~sequencing + treatment controls for sequencing type -->\n                    <!-- Effect estimates differ from single-factor design due to covariate adjustment -->\n                    <has_text_matching expression=\"FBgn0003360\\t1933\\.950.*\\t-2\\.88.*\\t0\\.111.*\\t-25\\.8.*\\t.*e-14[0-9]\\t.*e-14[0-9]\"/>\n                    <has_n_lines n=\"3999\"/>\n                </assert_contents>\n            </output>\n        </test>\n        <!--Test sample_sheet_contrasts with numeric factor column in design formula -->\n        <test expect_num_outputs=\"2\">\n            <param name=\"select_data|how\" value=\"sample_sheet_contrasts\"/>\n            <param name=\"select_data|countsFile\">\n                <collection type=\"list\">\n                    <element name=\"GSM461179_treat_single.counts\" value=\"GSM461179_treat_single.counts\"/>\n                    <element name=\"GSM461180_treat_paired.counts\" value=\"GSM461180_treat_paired.counts\"/>\n                    <element name=\"GSM461181_treat_paired.counts\" value=\"GSM461181_treat_paired.counts\"/>\n                    <element name=\"GSM461176_untreat_single.counts\" value=\"GSM461176_untreat_single.counts\"/>\n                    <element name=\"GSM461177_untreat_paired.counts\" value=\"GSM461177_untreat_paired.counts\"/>\n                    <element name=\"GSM461178_untreat_paired.counts\" value=\"GSM461178_untreat_paired.counts\"/>\n                    <element name=\"GSM461182_untreat_single.counts\" value=\"GSM461182_untreat_single.counts\"/>\n                </collection>\n            </param>\n            <param name=\"select_data|sample_sheet\" value=\"sample_sheet_numeric.tab\"/>\n            <param name=\"select_data|design_formula_mode|mode\" value=\"custom\"/>\n            <param name=\"select_data|design_formula_mode|design_formula\" value=\"~ replicate + treatment\"/>\n            <param name=\"select_data|design_formula_mode|reference_level\" value=\"Untreated\"/>\n            <section name=\"advanced_options\">\n                <param name=\"use_beta_priors\" value=\"1\"/>\n            </section>\n            <section name=\"output_options\">\n                <param name=\"output_selector\" value=\"normCounts\"/>\n            </section>\n            <output name=\"counts_out\">\n                <assert_contents>\n                    <has_text_matching expression=\"FBgn0000003\\t0\\t0\\t0\\t0\\t0\\t0\\t0\"/>\n                    <has_n_