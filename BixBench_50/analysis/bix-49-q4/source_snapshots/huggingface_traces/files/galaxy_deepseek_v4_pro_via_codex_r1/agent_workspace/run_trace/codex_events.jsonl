{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom bioblend.galaxy import GalaxyInstance\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport os, json\nfrom pathlib import Path\nkey=open(os.environ['GALAXY_API_KEY_FILE']).read().strip()\ngi=GalaxyInstance(url='https://usegalaxy.org', key=key)\nhist='bbd44e69cb8906b56bbc515c55c48d53'\nsplit=Path('/workspace/tmp/split')\nfiles=sorted(split.glob('*.counts'))\n# sample sheet upload first or after; do all.\ndef upload(path):\n    name=path.name\n    r=gi.tools.upload_file(str(path), hist, file_name=name, file_type='tabular', space_to_tab=False)\n    out=r['outputs'][0]\n    return name, out['id'], out.get('state')\nwith ThreadPoolExecutor(max_workers=4) as ex:\n    futs=[ex.submit(upload,p) for p in files]\n    results={}\n    for fut in as_completed(futs):\n        name,did,state=fut.result()\n        results[name]=did\n        print(name,did,state, flush=True)\n# upload sample sheet\nr=gi.tools.upload_file(str(split/'sample_sheet.tab'), hist, file_name='sample_sheet.tab', file_type='tabular', space_to_tab=False)\nsheet_id=r['outputs'][0]['id']\nprint('SHEET', sheet_id, r['outputs'][0].get('state'))\nwith open('/workspace/tmp/upload_ids.json','w') as f:\n    json.dump({'results':results,'sheet':sheet_id}, f, indent=2)\nprint('saved')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
