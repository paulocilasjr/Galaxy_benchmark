{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np, warnings\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts_path='inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt'\nmeta_path='inputs/Issy_ASXL1_blood_coldata_gender.xlsx'\ncounts=pd.read_csv(counts_path, sep=r'\\\\s+', index_col=0)\nmeta=pd.read_excel(meta_path)\nprint('counts', counts.shape, 'meta', meta.shape)\nprint('missing in meta from counts', [s for s in counts.columns if s not in set(meta['sample'])])\nprint('meta not in counts', [s for s in meta['sample'] if s not in set(counts.columns)])\ncounts=counts[meta['sample']]\nmeta=meta.set_index('sample')\n# factors\nmeta['condition']=pd.Categorical(meta['condition'], categories=['Control','ASXL1'], ordered=False)\nmeta['sex']=pd.Categorical(meta['sex'], categories=['F','M'], ordered=False)\nprint(meta[['condition','sex']])\nprint(meta['condition'].value_counts())\nprint(meta['sex'].value_counts())\n\ndds=DeseqDataSet(counts=counts, metadata=meta[['condition','sex']], design='~ sex + condition', design_factors=['sex','condition'], ref_level=['F','Control'], quiet=False)\ndds.deseq2()\nprint('dds done')\n# results with alpha 0.05\nst=DeseqStats(dds, contrast=['condition','ASXL1','Control'], alpha=0.05, independent_filter=True, cooks_filter=True)\nst.summary()\nprint('summary done')\nres=st.results_df\nprint(res.shape)\nprint(res.columns.tolist())\nprint(res.head())\nprint('padj notna', res['padj'].notna().sum())\nprint('padj<.05', (res['padj'] < 0.05).sum())\nprint('padj<=.05', (res['padj'] <= 0.05).sum())\nprint(res['padj'].describe())\n# inspect independent filter threshold\nprint('threshold attrs', st.independent_filter, getattr(st,'alpha',None))\nif hasattr(st,'filter_threshold'): print('filter_threshold', st.filter_threshold)\n# all significant gene names maybe\nsig=res[res['padj']<0.05].sort_values('padj')\nprint('sig head/tail')\nprint(sig[['baseMean','log2FoldChange','stat','pvalue','padj']].head(20))\nprint('n sig',len(sig))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
