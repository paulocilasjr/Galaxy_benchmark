{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/run_deseq2_138.R <<'RS'\nsuppressPackageStartupMessages({\n  library(DESeq2)\n  library(apeglm)\n  library(readxl)\n})\nprint(paste(\\\"R\\\", getRversion(), \\\"DESeq2\\\", as.character(packageVersion(\\\"DESeq2\\\")), \\\"apeglm\\\", as.character(packageVersion(\\\"apeglm\\\"))))\ncounts <- read.table(\\\"/workspace/inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt\\\",\n                     header=TRUE, sep=\\\"\\\", check.names=FALSE, row.names=1, stringsAsFactors=FALSE)\ncoldata_raw <- as.data.frame(read_excel(\\\"/workspace/inputs/Issy_ASXL1_blood_coldata_gender.xlsx\\\"))\ncoldata_raw\"'$sample <- as.character(coldata_raw$sample)\nrownames(coldata_raw) <- coldata_raw$sample\ncommon <- intersect(coldata_raw$sample, colnames(counts))\ncounts <- counts[, common, drop=FALSE]\ncoldata <- coldata_raw[common, , drop=FALSE]\ncoldata$condition <- factor(coldata$condition, levels=c(\"Control\", \"ASXL1\"))\ncoldata$sex <- factor(coldata$sex, levels=c(\"F\", \"M\"))\nstopifnot(all(rownames(coldata) == colnames(counts)))\ndds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~sex+condition)\ndds <- DESeq(dds, quiet=TRUE)\nprint(resultsNames(dds))\nres <- results(dds, alpha=0.05, contrast=c(\"condition\",\"ASXL1\",\"Control\"))\nshrink <- lfcShrink(dds, res=res, coef=\"condition_ASXL1_vs_Control\", type=\"apeglm\")\nprint(summary(res))\nprint(summary(shrink))\nprint(all.equal(res$padj, shrink$padj))\ncat(\"not NA padj:\", sum(!is.na(shrink$padj)), \"'\"\\\\n\\\")\ncat(\\\"significant padj<0.05:\\\", sum(shrink\"'$padj < 0.05, na.rm=TRUE), \"'\"\\\\n\\\")\ncat(\\\"pvalue<0.05:\\\", sum(shrink\"'$pvalue < 0.05, na.rm=TRUE), \"'\"\\\\n\\\")\ncat(\\\"filterThreshold:\\\", metadata(res)\"'$filterThreshold, \"'\"\\\\n\\\")\n# top table for sanity\nprint(head(shrink[order(shrink\"'$padj), c(\"baseMean\",\"log2FoldChange\",\"pvalue\",\"padj\")], 10))\nsaveRDS(list(dds=dds, res=res, shrink=shrink), \"/workspace/tmp/deseq2_results_138.rds\")\nwriteLines(as.character(sum(shrink$padj < 0.05, na.rm=TRUE)), \"/workspace/tmp/significant_count_138.txt\")\nRS\n/workspace/tmp/mamba/bin/micromamba run -p /workspace/tmp/r42-env Rscript /workspace/tmp/run_deseq2_138.R'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
