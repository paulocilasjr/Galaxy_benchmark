{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/run_deseq2.R <<'RS'\nsuppressPackageStartupMessages({\n  library(DESeq2)\n  library(apeglm)\n  library(readxl)\n})\nprint(paste(\\\"DESeq2\\\", as.character(packageVersion(\\\"DESeq2\\\")), \\\"apeglm\\\", as.character(packageVersion(\\\"apeglm\\\"))))\n\ncounts <- read.table(\\\"/workspace/inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt\\\",\n                     header=TRUE, sep=\\\"\\\", check.names=FALSE, row.names=1, stringsAsFactors=FALSE)\ncoldata_raw <- as.data.frame(read_excel(\\\"/workspace/inputs/Issy_ASXL1_blood_coldata_gender.xlsx\\\"))\ncoldata_raw\"'$sample <- as.character(coldata_raw$sample)\ncoldata_raw$condition <- as.character(coldata_raw$condition)\ncoldata_raw$sex <- as.character(coldata_raw$sex)\nrownames(coldata_raw) <- coldata_raw$sample\n\ncat(\"counts dim\", dim(counts), \"'\"\\\\n\\\")\ncat(\\\"coldata dim\\\", dim(coldata_raw), \\\"\\\\n\\\")\ncat(\\\"counts sample names:\\\\n\\\"); print(colnames(counts))\ncat(\\\"coldata samples:\\\\n\\\"); print(coldata_raw\"'$sample)\n\ncommon <- intersect(coldata_raw$sample, colnames(counts))\ncat(\"common n\", length(common), \"'\"\\\\n\\\")\ncat(\\\"counts not in coldata:\\\", setdiff(colnames(counts), common), \\\"\\\\n\\\")\ncat(\\\"coldata not in counts:\\\", setdiff(coldata_raw\"'$sample, common), \"'\"\\\\n\\\")\n\ncounts <- counts[, common, drop=FALSE]\ncoldata <- coldata_raw[common, , drop=FALSE]\ncoldata\"'$condition <- factor(coldata$condition, levels=c(\"Control\", \"ASXL1\"))\ncoldata$sex <- factor(coldata$sex, levels=c(\"F\", \"M\"))\nstopifnot(all(rownames(coldata) == colnames(counts)))\n\ncat(\"condition table:'\"\\\\n\\\"); print(table(coldata\"'$condition))\ncat(\"sex table:'\"\\\\n\\\"); print(table(coldata\"'$sex))\n\ndds <- DESeqDataSetFromMatrix(countData = counts,\n                              colData = coldata,\n                              design = ~ sex + condition)\ndds <- DESeq(dds, quiet=FALSE)\ncat(\"resultsNames:'\"\\\\n\\\"); print(resultsNames(dds))\nres <- results(dds, alpha=0.05, contrast=c(\\\"condition\\\",\\\"ASXL1\\\",\\\"Control\\\"))\ncat(\\\"res summary before shrink:\\\\n\\\"); summary(res)\nshrink <- lfcShrink(dds, coef=\\\"condition_ASXL1_vs_Control\\\", type=\\\"apeglm\\\")\ncat(\\\"shrink summary:\\\\n\\\"); summary(shrink)\n# ensure padj identical to res where present\nprint(all.equal(res\"'$padj, shrink$padj))\ncat(\"not NA padj:\", sum(!is.na(res$padj)), \"'\"\\\\n\\\")\ncat(\\\"shrink not NA padj:\\\", sum(\"'!is.na(shrink$padj)), \"'\"\\\\n\\\")\ncat(\\\"significant res padj<0.05:\\\", sum(res\"'$padj < 0.05, na.rm=TRUE), \"'\"\\\\n\\\")\ncat(\\\"significant shrink padj<0.05:\\\", sum(shrink\"'$padj < 0.05, na.rm=TRUE), \"'\"\\\\n\\\")\ncat(\\\"pvalue<0.05:\\\", sum(res\"'$pvalue < 0.05, na.rm=TRUE), \"'\"\\\\n\\\")\ncat(\\\"baseMean filter threshold? metadata:\\\\n\\\")\nprint(metadata(res)\"'$filterThreshold)\n# save RData for optional\nsaveRDS(list(dds=dds, res=res, shrink=shrink), \"/workspace/tmp/deseq2_results.rds\")\nwriteLines(as.character(sum(shrink$padj < 0.05, na.rm=TRUE)), \"/workspace/tmp/significant_count.txt\")\nRS\n/workspace/tmp/r-env/bin/Rscript /workspace/tmp/run_deseq2.R'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
