{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tmp/run_protein_coding_check.R <<'RS'\nsuppressPackageStartupMessages({library(DESeq2); library(apeglm); library(readxl)})\ncounts <- read.table(\\\"/workspace/inputs/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt\\\", header=TRUE, sep=\\\"\\\", check.names=FALSE, row.names=1, stringsAsFactors=FALSE)\ng <- read.csv(\\\"/workspace/inputs/gencode.v31.primary_assembly.genes.csv\\\", stringsAsFactors=FALSE)\nstopifnot(identical(rownames(counts), g\"'$gene_id))\ncoldata_raw <- as.data.frame(read_excel(\"/workspace/inputs/Issy_ASXL1_blood_coldata_gender.xlsx\"))\ncoldata_raw$sample <- as.character(coldata_raw$sample); rownames(coldata_raw)<-coldata_raw$sample\ncommon <- intersect(coldata_raw$sample, colnames(counts)); counts<-counts[,common]; coldata<-coldata_raw[common,]\ncoldata$condition<-factor(coldata$condition, levels=c(\"Control\",\"ASXL1\")); coldata$sex<-factor(coldata$sex, levels=c(\"F\",\"M\"))\nfor (gt in c(\"protein_coding\",\"all\")) {\n  if (gt==\"all\") {idx<-rep(TRUE,nrow(counts)); label<-\"all\"} else {idx<-g$gene_type==gt; label<-gt}\n  dds <- DESeqDataSetFromMatrix(countData=counts[idx,,drop=FALSE], colData=coldata, design=~sex+condition)\n  dds <- DESeq(dds, quiet=TRUE)\n  res <- results(dds, alpha=0.05, contrast=c(\"condition\",\"ASXL1\",\"Control\"))\n  shrink <- lfcShrink(dds, res=res, coef=\"condition_ASXL1_vs_Control\", type=\"apeglm\")\n  cat(label, \"features\", sum(idx), \"sig\", sum(shrink$padj<0.05, na.rm=TRUE), \"p<\", sum(shrink$pvalue<0.05, na.rm=TRUE), \"notNA\", sum(!is.na(shrink$padj)), \"'\"\\\\n\\\")\n}\nRS\n/workspace/tmp/mamba/bin/micromamba run -p /workspace/tmp/r42-env Rscript /workspace/tmp/run_protein_coding_check.R\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
