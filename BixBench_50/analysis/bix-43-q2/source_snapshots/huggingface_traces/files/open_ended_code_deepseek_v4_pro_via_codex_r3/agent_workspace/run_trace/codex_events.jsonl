{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\nfrom pathlib import Path\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\nprint('counts shape', counts.shape)\nprint('columns', list(counts.columns))\nprint('index head', list(counts.index[:5]))\nprint('duplicated index', counts.index.duplicated().sum())\nprint('non-integer?', counts.dtypes.value_counts().to_dict())\nlayout = pd.read_csv('inputs/sample_layout.csv')\nprint(layout)\n# mapping header names\nfor s in layout['SampleID']:\n    print(s, s.replace('-','_') in counts.columns)\nprint('all match', all(s.replace('-','_') in counts.columns for s in layout['SampleID']))\n# prefilter all 30\nkeep = (counts > 10).any(axis=1)\nprint('prefilter keep', keep.sum(), 'out of', len(counts))\n# subset groups\nsel_groups = ['DMSO','DMSO_Serum_starvation','Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h']\nsel = layout[layout.Group.isin(sel_groups)].copy()\ncols = [s.replace('-','_') for s in sel.SampleID]\nprint('sel samples', len(sel), sel)\nsub = counts.loc[keep, cols]\nprint('subset shape', sub.shape)\nprint('any NA', sub.isna().sum().sum())\nprint('min', sub.values.min(), 'max', sub.values.max())\nprint('sums by group')\n# show mapping coverage\nmp = pd.read_csv('inputs/ensg_to_gene_name.tsv', sep='\\\\t')\nprint('mapping shape', mp.shape, 'unique ensg', mp.ENSG.nunique(), 'unique gene', mp.gene_name.nunique())\nprint('dup ensg', mp.ENSG.duplicated().sum(), 'dup gene', mp.gene_name.duplicated().sum())\nprint('missing genes', sub.index[~sub.index.isin(mp.ENSG)].shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
