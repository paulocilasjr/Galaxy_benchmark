{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\nlayout = pd.read_csv('inputs/sample_layout.csv')\nsel_groups = ['DMSO','DMSO_Serum_starvation','Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h']\nsel = layout[layout.Group.isin(sel_groups)].copy()\n# order as layout\ncols = [s.replace('-','_') for s in sel.SampleID]\nmeta = sel.set_index('SampleID')[['Group']].rename_axis(index='sample')\nmeta.index = meta.index.str.replace('-','_')\n# prefilter across all 30\nkeep = (counts > 10).any(axis=1)\nsub = counts.loc[keep, cols]\nprint('sub', sub.shape, 'meta', meta)\n# ensure order matching\nsub = sub[meta.index]\nprint('group counts', meta.Group.value_counts())\ndds = DeseqDataSet(counts=sub, metadata=meta, design_factors='Group', n_cpus=4)\nprint('dds created, obs', dds.n_obs, 'vars', dds.n_vars)\ndds.deseq2()\nprint('deseq2 done')\nds = DeseqStats(dds, contrast=['Group','Cisplatin_IC50_CBD_IC50','DMSO'], n_cpus=4)\nds.summary()\nres = ds.results_df.copy()\nprint('res shape', res.shape)\nprint(res.head())\nprint('NA counts', res.isna().sum())\n# filter criteria\nsig = res[(res.padj <= 0.05) & (res.log2FoldChange.abs() >= 0.5) & (res.baseMean >= 10)].copy()\nprint('sig DEGs', sig.shape)\nprint(sig.head())\nprint('lfc range', sig.log2FoldChange.min(), sig.log2FoldChange.max())\nprint('baseMean min', sig.baseMean.min(), 'padj max', sig.padj.max())\n# save interim to tmp for subsequent\nres.to_csv('/workspace/tmp/pydeseq2_res.csv')\nsig.to_csv('/workspace/tmp/sig_deg.csv')\nprint(sig.index[:10].tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
