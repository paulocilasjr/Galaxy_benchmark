{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nimport gseapy\n\n# Inputs\ncounts_all = pd.read_csv('inputs/counts_raw_unfiltered.csv', index_col=0)\nlayout = pd.read_csv('inputs/sample_layout.csv')\nmapping = pd.read_csv('inputs/ensg_to_gene_name.tsv', sep='\\\\t')\nensg_to_symbol = mapping.set_index('ENSG')['gene_name']\n\n# Pre-filter across all 30 samples\nkeep_all = (counts_all > 10).any(axis=1)\n\n# Keep only the four related groups for dispersion estimation and the requested contrast\ngroups = [\n    'DMSO',\n    'DMSO_Serum_starvation',\n    'Cisplatin_IC50_CBD_IC50',\n    'Cisplatin_IC50_CBD_IC50_Serum_starvation_16h',\n]\nmeta = layout[layout['Group'].isin(groups)].copy()\nmeta['SampleID'] = meta['SampleID'].str.replace('-', '_', regex=False)\nmeta = meta.set_index('SampleID')[['Group']]\ncounts_sub = counts_all.loc[keep_all, meta.index]\n\n# pydeseq2 expects samples x genes in this version\ncounts_model = counts_sub.T\ndds = DeseqDataSet(\n    counts=counts_model,\n    metadata=meta,\n    design='~Group',\n    n_cpus=4,\n    quiet=True,\n)\ndds.deseq2()\nds = DeseqStats(\n    dds,\n    contrast=['Group', 'Cisplatin_IC50_CBD_IC50', 'DMSO'],\n    alpha=0.05,\n    n_cpus=4,\n    quiet=True,\n)\nds.summary()\nres = ds.results_df\n\nsig = res[\n    (res['padj'] <= 0.05)\n    & (res['log2FoldChange'].abs() >= 0.5)\n    & (res['baseMean'] >= 10)\n].copy()\n\n# Map to the gene-symbol namespace required by Reactome_2022/Enrichr.\nsymbols = pd.Series(sig.index.map(ensg_to_symbol), index=sig.index)\nsymbols = symbols.dropna().astype(str)\nsymbols = symbols[symbols.str.len() > 0]\nsymbols = pd.Series(symbols.unique())\n\nenr = gseapy.enrichr(\n    gene_list=symbols.tolist(),\n    gene_sets='Reactome_2022',\n    organism='human',\n    outdir=None,\n    no_plot=True,\n)\nresults = enr.res