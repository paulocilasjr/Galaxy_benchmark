{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport time, pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nprint('loading', flush=True)\nt=time.time()\ncounts=pd.read_csv('/workspace/inputs/counts_raw_unfiltered.csv', index_col=0)\nlayout=pd.read_csv('/workspace/inputs/sample_layout.csv')\nann=pd.read_csv('/workspace/inputs/ensg_to_gene_name.tsv', sep='\\\\t')\nlayout['sid']=layout['SampleID'].str.replace('-','_')\nsel=['DMSO','DMSO_Serum_starvation','Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h']\nmeta=layout[layout['Group'].isin(sel)].set_index('sid')\n# prefilter on all 30 samples: counts greater than 10 in at least one sample\nkeep=(counts > 10).any(axis=1)\nprint('prefilter genes', int(keep.sum()), flush=True)\nsub=counts.loc[keep, meta.index].T.astype(int)\nmeta=meta[['Group']].rename(columns={'Group':'group'})\nprint('sub shape', sub.shape, flush=True)\ndds=DeseqDataSet(counts=sub, metadata=meta, design='~group', quiet=True, n_cpus=4)\nprint('dds created', time.time()-t, flush=True)\ndds.deseq2()\nprint('deseq2 done', time.time()-t, flush=True)\nst=DeseqStats(dds, contrast=['group','Cisplatin_IC50_CBD_IC50','DMSO'], alpha=0.05, quiet=True, n_cpus=4)\nst.summary(quiet=True)\nprint('stats done', time.time()-t, flush=True)\nres=st.results_df.copy()\nprint(res.shape)\nprint(res.head())\n# filter criteria\nmask=(res['padj']<=0.05)&(res['log2FoldChange'].abs()>=0.5)&(res['baseMean']>=10)\ndeg=res[mask]\nprint('DEG count', len(deg))\nprint(deg.head())\nprint(deg.tail())\n# save to workspace tmp for next step (internal, not audit)\ndeg.to_csv('/workspace/tmp/deg_full.csv')\ndeg[['baseMean','log2FoldChange','padj']].to_csv('/workspace/tmp/deg_meta.csv')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
