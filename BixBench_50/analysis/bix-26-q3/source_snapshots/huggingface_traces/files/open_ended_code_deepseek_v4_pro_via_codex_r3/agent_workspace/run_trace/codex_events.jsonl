{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request\nfrom collections import defaultdict\nfrom math import comb\nup=set(open('tmp/upgenes.txt').read().split())\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau',timeout=30).read().decode()\npairs=[]\nfor l in link.splitlines():\n    parts=l.split('\\\\t')\n    if len(parts)==2:\n        g=parts[0].split(':')[-1]; p=parts[1].split(':')[-1]\n        pairs.append((g,p))\nplist=urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau',timeout=30).read().decode()\npath_ids=set(l.split('\\\\t')[0] for l in plist.splitlines() if '\\\\t' in l)\npairs=[(g,p) for g,p in pairs if p in path_ids]\npath2genes=defaultdict(set)\nfor g,p in pairs: path2genes[p].add(g)\nextID={g for g,p in pairs}\nN=len(extID)\n# mapped input\nmapped={g for g in up if g in extID}\n# gene to terms\ngene2terms=defaultdict(set)\nfor g,p in pairs: gene2terms[g].add(p)\nqTermID=set()\nfor g in mapped: qTermID |= gene2terms[g]\nprint('N',N,'n mapped',len(mapped),'qTermID raw',len(qTermID))\n# filter by gene set size\nqTermID_filtered=set()\nfor t in qTermID:\n    M=len(path2genes[t])\n    if 10<=M<=500:\n        qTermID_filtered.add(t)\nprint('qTermID filtered',len(qTermID_filtered))\nrows=[]\nn=len(mapped)\nfor t in sorted(qTermID_filtered):\n    M=len(path2genes[t]); k=len(mapped & path2genes[t])\n    # phyper(k-1,M,N-M,n,lower.tail=FALSE)\n    p=sum(comb(M,i)*comb(N-M,n-i) for i in range(k,min(M,n)+1))/comb(N,n)\n    rows.append((t,M,k,p))\nrows.sort(key=lambda x:x[3])\n# p.adjust BH\nimport numpy as np\nps=np.array([r[3] for r in rows],float)\nm=len(ps)\n# R p.adjust BH\nfrom scipy? no, implement\norder=ps.argsort()\nqs=np.empty(m)\nprev=1.0\nfor rank in range(m,0,-1):\n    idx=order[rank-1]\n    val=ps[idx]*m/rank\n    if val<prev: prev=val\n    qs[idx]=prev\nfor r,q in zip(rows,qs):\n    if r[0]=='pau02010': print('ABC',r,q)\nprint('sig p.adjust <=.05',sum(qs<=0.05))\nprint('total rows',m)\n# print all sig\nfor r,q in zip(rows,qs):\n    if q<=0.05: print('sig',r,q)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
