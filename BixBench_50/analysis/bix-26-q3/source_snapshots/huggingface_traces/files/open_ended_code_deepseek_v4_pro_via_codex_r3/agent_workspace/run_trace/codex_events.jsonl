{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request, math, re\nfrom math import comb\nfrom collections import defaultdict\n# input sets\nallg=set(open('tmp/allgenes.txt').read().split())\nup=set(open('tmp/upgenes.txt').read().split())\n# link\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau',timeout=30).read().decode()\npairs=[]\nfor l in link.splitlines():\n    parts=l.split('\\\\t')\n    if len(parts)==2:\n        g=parts[0].split(':')[-1]; p=parts[1].split(':')[-1]\n        pairs.append((g,p))\n# path list names\nplist=urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau',timeout=30).read().decode()\npath_ids=set(l.split('\\\\t')[0].replace('path:','') for l in plist.splitlines() if '\\\\t' in l)\n# only path ids in list\npairs=[(g,p) for g,p in pairs if p in path_ids]\npath2genes=defaultdict(set)\nfor g,p in pairs: path2genes[p].add(g)\nextID={g for g,p in pairs}\nprint('extID',len(extID),'paths with pairs',len(path2genes))\ninput_genes=up & extID\nprint('input mapped',len(input_genes), 'missing', len(up-extID))\nN=len(extID); n=len(input_genes)\nrows=[]\nfor p,genes in path2genes.items():\n    gs=genes & extID\n    M=len(gs)\n    if M<10 or M>500: continue\n    k=len(input_genes & gs)\n    # p upper tail\n    pval=sum(comb(M,i)*comb(N-M,n-i) for i in range(k,min(M,n)+1))/comb(N,n) if k<=n and n<=N else 1\n    rows.append(dict(path=p,M=M,k=k,p=pval))\n# sort\nrows.sort(key=lambda r:r['p'])\n# BH all filtered pathways\nm=len(rows)\nprint('filtered pathways',m)\nfor i,r in enumerate(rows):\n    r['rank']=i+1\n    r['bh_all']=min(r['p']*m/(i+1),1)\n    # enforce monotonic\n    r['bh_all']=min(r['bh_all'],1)\n# monotonic bh descending\nfor i in range(m-2,-1,-1):\n    rows[i]['bh_all']=min(rows[i]['bh_all'],rows[i+1]['bh_all'])\n# BH count>0\npos=[r for r in rows if r['k']>0]\nmp=len(pos)\nfor i,r in enumerate(pos):\n    r['rank_pos']=i+1\n    r['bh_pos']=r['p']*mp/(i+1)\nfor i in range(len(pos)-2,-1,-1):\n    pos[i]['bh_pos']=min(pos[i]['bh_pos'],pos[i+1]['bh_pos'])\npos_by=pos\n# print ABC\nfor r in rows:\n    if r['path']=='pau02010':\n        print('ABC row all',r)\nfor r in pos:\n    if r['path']=='pau02010':\n        print('ABC row pos',r)\nprint('\\\\nTop 20 all-BH:')\nfor r in rows[:20]: print(r['path'],r['M'],r['k'],r['p'],r['bh_all'])\nprint('\\\\nTop 20 pos-BH:')\nfor r in pos[:20]: print(r['path'],r['M'],r['k'],r['p'],r.get('bh_pos'))\n# all pathways p<=.05 adjusted?\nprint('sig bh_all',sum(r['bh_all']<0.05 for r in rows), 'ABC sig?', [r['bh_all'] for r in rows if r['path']=='pau02010'])\nprint('sig bh_pos',sum(r['bh_pos']<0.05 for r in pos), 'ABC sig?', [r['bh_pos'] for r in pos if r['path']=='pau02010'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request, math, re\nfrom math import comb\nfrom collections import defaultdict\n# input sets\nallg=set(open('tmp/allgenes.txt').read().split())\nup=set(open('tmp/upgenes.txt').read().split())\n# link\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau',timeout=30).read().decode()\npairs=[]\nfor l in link.splitlines():\n    parts=l.split('\\\\t')\n    if len(parts)==2:\n        g=parts[0].split(':')[-1]; p=parts[1].split(':')[-1]\n        pairs.append((g,p))\n# path list names\nplist=urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau',timeout=30).read().decode()\npath_ids=set(l.split('\\\\t')[0].replace('path:','') for l in plist.splitlines() if '\\\\t' in l)\n# only path ids in list\npairs=[(g,p) for g,p in pairs if p in path_ids]\npath2genes=defaultdict(set)\nfor g,p in pairs: path2genes[p].add(g)\nextID={g for g,p in pairs}\nprint('extID',len(extID),'paths with pairs',len(path2genes))\ninput_genes=up & extID\nprint('input mapped',len(input_genes), 'missing', len(up-extID))\nN=len(extID); n=len(input_genes)\nrows=[]\nfor p,genes in path2genes.items():\n    gs=genes & extID\n    M=len(gs)\n    if M<10 or M>500: continue\n    k=len(input_genes & gs)\n    # p upper tail\n    pval=sum(comb(M,i)*comb(N-M,n-i) for i in range(k,min(M,n)+1))/comb(N,n) if k<=n and n<=N else 1\n    rows.append(dict(path=p,M=M,k=k,p=pval))\n# sort\nrows.sort(key=lambda r:r['p'])\n# BH all filtered pathways\nm=len(rows)\nprint('filtered pathways',m)\nfor i,r in enumerate(rows):\n    r['rank']=i+1\n    r['bh_all']=min(r['p']*m/(i+1),1)\n    # enforce monotonic\n    r['bh_all']=min(r['bh_all'],1)\n# monotonic bh descending\nfor i in range(m-2,-1,-1):\n    rows[i]['bh_all']=min(rows[i]['bh_all'],rows[i+1]['bh_all'])\n# BH count>0\npos=[r for r in rows if r['k']>0]\nmp=len(pos)\nfor i,r in enumerate(pos):\n    r['rank_pos']=i+1\n    r['bh_pos']=r['p']*mp/(i+1)\nfor i in range(len(pos)-2,-1,-1):\n    pos[i]['bh_pos']=min(pos[i]['bh_pos'],pos[i+1]['bh_pos'])\npos_by=pos\n# print ABC\nfor r in rows:\n    if r['path']=='pau02010':\n        print('ABC row all',r)\nfor r in pos:\n    if r['path']=='pau02010':\n        print('ABC row pos',r)\nprint('\\\\nTop 20 all-BH:')\nfor r in rows[:20]: print(r['path'],r['M'],r['k'],r['p'],r['bh_all'])\nprint('\\\\nTop 20 pos-BH:')\nfor r in pos[:20]: print(r['path'],r['M'],r['k'],r['p'],r.get('bh_pos'))\n# all pathways p<=.05 adjusted?\nprint('sig bh_all',sum(r['bh_all']<0.05 for r in rows), 'ABC sig?', [r['bh_all'] for r in rows if r['path']=='pau02010'])\nprint('sig bh_pos',sum(r['bh_pos']<0.05 for r in pos), 'ABC sig?', [r['bh_pos'] for r in pos if r['path']=='pau02010'])\nPY\"","aggregated_output":"extID 2055 paths with pairs 138\ninput mapped 40 missing 93\nfiltered pathways 91\nABC row all {'path': 'pau02010', 'M': 202, 'k': 11, 'p': 0.0011227894740503178, 'rank': 1, 'bh_all': 0.10217384213857891, 'rank_pos': 1, 'bh_pos': 0.03368368422150953}\nABC row pos {'path': 'pau02010', 'M': 202, 'k': 11, 'p': 0.0011227894740503178, 'rank': 1, 'bh_all': 0.10217384213857891, 'rank_pos': 1, 'bh_pos': 0.03368368422150953}\n\nTop 20 all-BH:\npau02010 202 11 0.0011227894740503178 0.10217384213857891\npau01210 47 4 0.012012195713390548 0.54655490495927\npau00785 24 2 0.07790106451586178 1\npau02020 268 8 0.14023389535314454 1\npau00640 43 2 0.20323734761937837 1\npau00280 45 2 0.21765170160139513 1\npau00660 13 1 0.2260848650892874 1\npau04146 14 1 0.24124480896608885 1\npau00290 17 1 0.28500804397624013 1\npau00130 21 1 0.33954878166178637 1\npau00360 21 1 0.33954878166178637 1\npau01110 444 10 0.3580179038234213 1\npau00470 23 1 0.36527607150956337 1\npau03010 67 2 0.37737221434269624 1\npau00340 25 1 0.390025277365228 1\npau00770 26 1 0.4020444837225634 1\npau00350 27 1 0.41383266541359226 1\npau00020 29 1 0.436733191237693 1\npau00400 32 1 0.4694569778452056 1\npau01501 34 1 