{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request,re\nfrom math import comb\n# Extract DEGs via R? Let's write DEG list to file using R first? Use subprocess or parse R? easiest run R then output to file\nPY\nRscript - <<'RS'\nx<-readRDS('inputs/res_GluFevsGluFePlus.rds')\na<-attributes(x); rn<-a\"'$rownames; ld<-a$listData\nlfc<-ld$log2FoldChange; padj<-ld$padj\npos<-rn[padj<0.05 & lfc>1.5]\nallgenes<-rn\nwriteLines(pos, '\"'tmp/upgenes.txt')\nwriteLines(allgenes, 'tmp/allgenes.txt')\ncat(length(pos), '\\\\n')\nRS\npython3 - <<'PY'\nimport urllib.request,re\nup=set(open('tmp/upgenes.txt').read().split())\nallg=set(open('tmp/allgenes.txt').read().split())\ndata=urllib.request.urlopen('https://rest.kegg.jp/get/pau02010',timeout=30).read().decode()\n# find GENE block\nm=re.search(r'\"'^GENE'\"\\\\s+(.*?)(?=\"'^[A-Z_]+'\"\\\\s+|\\\\Z)', data, re.S|re.M)\nblock=m.group(1)\ngenes=set()\nfor line in block.splitlines():\n    line=line.strip()\n    if not line: continue\n    # first token before space\n    g=line.split()[0]\n    genes.add(g)\nprint('pathway genes',len(genes))\nprint('overlap up',len(up&genes))\nprint('overlap all',len(allg&genes))\nprint('up genes in path', sorted(up&genes))\nfrom math import comb\nN=len(allg); K=len(allg&genes); n=len(up); k=len(up&genes)\nprint('N K n k', N,K,n,k)\n# hypergeom upper tail P(X>=k)\np=sum(comb(K,i)*comb(N-K,n-i) for i in range(k,min(K,n)+1))/comb(N,n)\nprint('p',p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
