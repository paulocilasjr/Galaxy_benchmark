{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# compute overlaps for variants using R output maybe redo with all abs\nimport urllib.request\nfrom collections import defaultdict\nfrom math import comb\nallg=open('tmp/allgenes.txt').read().split()\n# parse values with R quickly\nimport subprocess, json, os\n# use R to write sets\nsubprocess.run(['Rscript','-'],input='''x<-readRDS(\\\"inputs/res_GluFevsGluFePlus.rds\\\");a<-attributes(x);ld<-a\"'$listData; rn<-a$rownames; lfc<-ld$log2FoldChange; padj<-ld$padj; writeLines(rn[padj<0.05 & abs(lfc)>=1.5],\"tmp/absgenes.txt\"); writeLines(rn[padj<0.05 & lfc<= -1.5],\"tmp/downgenes.txt\")'\"''',text=True)\nabsgenes=set(open('tmp/absgenes.txt').read().split()); down=set(open('tmp/downgenes.txt').read().split())\nlink=urllib.request.urlopen('https://rest.kegg.jp/link/pathway/pau',timeout=30).read().decode()\npairs=[]\nfor l in link.splitlines():\n p=l.split('\\\\t')\n if len(p)==2: pairs.append((p[0].split(':')[-1],p[1].split(':')[-1]))\nplist=urllib.request.urlopen('https://rest.kegg.jp/list/pathway/pau',timeout=30).read().decode()\nids=set(l.split('\\\\t')[0] for l in plist.splitlines() if '\\\\t' in l)\npairs=[x for x in pairs if x[1] in ids]\np2g=defaultdict(set)\nfor g,p in pairs:p2g[p].add(g)\next={g for g,p in pairs}\nabc=p2g['pau02010']\nprint('abs count',len(absgenes),'abs in ext',len(absgenes&ext),'abc overlap',len(absgenes&abc), sorted(absgenes&abc))\nprint('down count',len(down),'down in ext',len(down&ext),'down abc overlap',len(down&abc), sorted(down&abc))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
