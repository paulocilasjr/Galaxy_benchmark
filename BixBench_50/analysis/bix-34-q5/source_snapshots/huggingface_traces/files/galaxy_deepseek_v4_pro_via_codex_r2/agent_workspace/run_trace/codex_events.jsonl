{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport zipfile, statistics, csv\nmeans={}\nfor line in open('/tmp/patristic_means.tsv'):\n    g,gene,v=line.rstrip('\\\\n').split('\\\\t'); means[(g,gene)]=float(v)\nfor path,g in [('/tmp/scogs_animals.zip','animals'),('/tmp/scogs_fungi.zip','fungi')]:\n    z=zipfile.ZipFile(path)\n    mld=[n for n in z.namelist() if n.endswith('.mldist')]\n    diffs=[]\n    for n in mld[:5]:\n        lines=z.read(n).decode().splitlines()\n        N=int(lines[0])\n        vals=[]\n        for ln in lines[1:]:\n            parts=ln.split()\n            if len(parts)\"'!=N+1: continue\n            vals += [float(x) for x in parts[1:]]\n        # unique pair mean equals sum all off-diagonal / (N*(N-1))\n        total=sum(vals)\n        # diagonal zeros contribute 0, off-diagonal both directions included\n        if N>1:\n            mean=total/(N*(N-1))\n        else: mean=0\n        gene=n[:-len('\"'.faa.mafft.clipkit.mldist')]+'.faa.mafft.clipkit.treefile'\n        # gene names in means use treefile name\n        udt=means.get((g,n[:-len('.mldist')]+'.treefile'))\n        if udt is None:\n            # try\n            print('no udt',g,n)\n            continue\n        print(g,n,N,'mldist mean',mean,'udt',udt,'diff',mean-udt)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
