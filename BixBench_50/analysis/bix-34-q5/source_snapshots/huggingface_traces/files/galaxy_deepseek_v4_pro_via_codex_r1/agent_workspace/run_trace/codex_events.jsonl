{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"cat > tmp/udt_job.py <<'PY'\n#\"'!/usr/bin/env python3\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport zipfile\n\n\ndef tree_members(archive_path):\n    with zipfile.ZipFile(archive_path) as zf:\n        names = [n for n in zf.namelist() if n.endswith('\"'.faa.mafft.clipkit.treefile')]\n    return sorted(set(names))\n\n\ndef process_group(archive_path, group_label, out_dir):\n    os.makedirs(out_dir, exist_ok=True)\n    group_dir = os.path.join(out_dir, group_label)\n    os.makedirs(group_dir, exist_ok=True)\n    names = tree_members(archive_path)\n    per_tree = []\n    failures = []\n    with zipfile.ZipFile(archive_path) as zf:\n        for idx, name in enumerate(names):\n            local_path = os.path.join(group_dir, f'{idx:04d}.treefile')\n            with zf.open(name) as src, open(local_path, 'wb') as dst:\n                dst.write(src.read())\n            proc = subprocess.run(\n                ['phykit', 'patristic_distances', '-v', local_path],\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n            )\n            if proc.returncode \"'!= 0:\n                failures.append(name)\n                continue\n            values = []\n            for line in proc.stdout.splitlines():\n                if '\"'\\\\t' not in line:\n                    continue\n                parts = line.rstrip('\\\\n').split('\\\\t')\n                if len(parts) < 3:\n                    continue\n                try:\n                    values.append(float(parts[-1]))\n                except ValueError:\n                    continue\n            if values:\n                per_tree.append((name, sum(values) / len(values)))\n            else:\n                failures.append(name)\n    return per_tree, failures\n\n\ndef main():\n    animals_zip = sys.argv[1]\n    fungi_zip = sys.argv[2]\