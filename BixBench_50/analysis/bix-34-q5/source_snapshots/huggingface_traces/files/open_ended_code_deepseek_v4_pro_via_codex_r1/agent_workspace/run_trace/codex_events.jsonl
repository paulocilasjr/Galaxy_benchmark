{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile,io,statistics,itertools\nfrom Bio import Phylo\n\ndef analyze(group):\n    z=f'/workspace/inputs/scogs_{group}.zip'\n    with zipfile.ZipFile(z) as f:\n        means=[]; counts={}; missing=[]\n        for n in f.namelist():\n            if not n.endswith('.treefile'): continue\n            tree=Phylo.read(io.StringIO(f.read(n).decode()),'newick')\n            terms=tree.get_terminals()\n            ds=[tree.distance(a,b) for a,b in itertools.combinations(terms,2)]\n            means.append(statistics.mean(ds))\n            counts[len(terms)]=counts.get(len(terms),0)+1\n            if len(terms)<4: missing.append((n, len(terms), [t.name for t in terms], statistics.mean(ds)))\n    print(group, 'n',len(means),'counts',counts,'median',statistics.median(means))\n    print('all4 median',statistics.median([m for m,c in zip(means, [None]) if True]))\n    # recreate with taxon count\n    all4=[]; \n    with zipfile.ZipFile(z) as f:\n        for n in f.namelist():\n            if not n.endswith('.treefile'): continue\n            tree=Phylo.read(io.StringIO(f.read(n).decode()),'newick')\n            terms=tree.get_terminals()\n            if len(terms)==4:\n                ds=[tree.distance(a,b) for a,b in itertools.combinations(terms,2)]\n                all4.append(statistics.mean(ds))\n    print('all4 n',len(all4),'median',statistics.median(all4))\n    print('missing sample',missing[:10], 'total missing', len(missing))\nfor g in ['animals','fungi']:\n    analyze(g)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
