{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, statistics, itertools, re\n\ndef parse_newick(s):\n    # Return root node and leaves\n    pos=0\n    def parse_node():\n        nonlocal pos\n        # skip spaces\n        while pos < len(s) and s[pos].isspace(): pos+=1\n        children=[]\n        label=''\n        length=None\n        if s[pos]=='(':\n            pos+=1\n            while True:\n                children.append(parse_node())\n                while pos < len(s) and s[pos].isspace(): pos+=1\n                if pos < len(s) and s[pos]==',':\n                    pos+=1\n                    continue\n                elif pos < len(s) and s[pos]==')':\n                    pos+=1\n                    break\n                else:\n                    raise ValueError('Expected , or ) at '+str(pos)+': '+s[pos:pos+20])\n        else:\n            # leaf label until : , ) ;\n            start=pos\n            while pos < len(s) and s[pos] not in ':(),;':\n                pos+=1\n            label=s[start:pos].strip()\n        # optional branch length\n        while pos < len(s) and s[pos].isspace(): pos+=1\n        if pos < len(s) and s[pos]==':':\n            pos+=1\n            start=pos\n            while pos < len(s) and (s[pos].isdigit() or s[pos] in '.eE+-'):\n                pos+=1\n            length=float(s[start:pos])\n        return {'label':label,'length':length,'children':children}, label\n    root,label=parse_node()\n    return root\n\ndef all_leaf_pairs_dists(root):\n    # iterative stack path to leaves with parent length included\n    leaves=[]\n    def dfs(node,path):\n        # node itself edge length to parent handled at child call? simpler: when visit child add child.length\n        pass\n    def collect(node, dist_so_far):\n        # dist_so_far includes length of edge into node\n        if not node['children']:\n            leaves.append((node['label'],dist_so_far))\n        for ch in node['children']:\n            collect(ch, dist_so_far + (ch['length'] if ch['length'] is not None else 0.0))\n    collect(root,0.0)\n    return [(a[0],b[0],a[1]+b[1]) for a,b in itertools.combinations(leaves,2)]\n\ndef summarize(z):\n    with zipfile.ZipFile(z) as f:\n        vals=[]\n        for n in f.namelist():\n            if n.endswith('.treefile'):\n                s=f.read(n).decode().strip().rstrip(';')\n                root,label=parse_newick(s)\n                ds=[d for _,_,d in all_leaf_pairs_dists(root)]\n                vals.append(statistics.mean(ds))\n    return vals\nfor g in ['animals','fungi']:\n    vals=summarize(f'/workspace/inputs/scogs_{g}.zip')\n    print(g,len(vals),statistics.median(vals),statistics.mean(vals),min(vals),max(vals))\nprint('ratio', statistics.median(summarize('/workspace/inputs/scogs_fungi.zip'))/statistics.median(summarize('/workspace/inputs/scogs_animals.zip')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
