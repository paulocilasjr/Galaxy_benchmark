{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, io, statistics, itertools, math\nfrom Bio import Phylo\nfrom collections import defaultdict\n\ndef tree_dists(newick):\n    tree=Phylo.read(io.StringIO(newick),'newick')\n    terms=tree.get_terminals()\n    out={}\n    for a,b in itertools.combinations(terms,2):\n        out[(a.name,b.name)]=tree.distance(a,b)\n    return out\n\ndef get_tree_dist_dict(group):\n    z=f'/workspace/inputs/scogs_{group}.zip'\n    with zipfile.ZipFile(z) as f:\n        arr=[]\n        for n in f.namelist():\n            if n.endswith('.treefile'):\n                d=tree_dists(f.read(n).decode())\n                arr.append(d)\n    return arr\n\nfor group in ['animals','fungi']:\n    arr=get_tree_dist_dict(group)\n    print('\\\\n',group,'trees',len(arr))\n    # per tree mean/median/gmean\n    means=[statistics.mean(d.values()) for d in arr]\n    medians=[statistics.median(d.values()) for d in arr]\n    print('per-tree means median',statistics.median(means),'mean',statistics.mean(means))\n    print('per-tree medians median',statistics.median(medians))\n    # per pair means across trees\n    pairs=sorted(set().union(*[set(d.keys()) for d in arr]))\n    pairvals={p:[d[p] for d in arr if p in d] for p in pairs}\n    pm=[statistics.mean(v) for v in pairvals.values()]\n    print('pair mean median',statistics.median(pm),'mean',statistics.mean(pm))\n    print('pair mean range',min(pm),max(pm))\n    # maybe median per pair across trees then mean? \n    pm2=[statistics.median(v) for v in pairvals.values()]\n    print('pair median median',statistics.median(pm2),'mean',statistics.mean(pm2))\n    for p,v in sorted(pairvals.items()): print(p,len(v),round(statistics.mean(v),4),round(statistics.median(v),4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
