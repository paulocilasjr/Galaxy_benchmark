{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile,io,statistics,itertools\nfrom Bio import Phylo\nfrom collections import defaultdict\n\ndef tree_dists(newick):\n    tree=Phylo.read(io.StringIO(newick),'newick')\n    terms=tree.get_terminals()\n    d={}\n    for a,b in itertools.combinations(terms,2): d[(a.name,b.name)]=tree.distance(a,b)\n    return d\nfor group in ['animals','fungi']:\n with zipfile.ZipFile(f'/workspace/inputs/scogs_{group}.zip') as f:\n  per_taxon=[]\n  per_tree_means=[]\n  per_tree_medians=[]\n  for n in f.namelist():\n   if n.endswith('.treefile'):\n    d=tree_dists(f.read(n).decode())\n    # mean per tree\n    per_tree_means.append(statistics.mean(d.values()))\n    # per taxon mean within tree\n    taxa=set()\n    for a,b in d:\n     taxa.add(a); taxa.add(b)\n    for t in taxa:\n     vals=[v for (a,b),v in d.items() if a==t or b==t]\n     per_taxon.append(statistics.mean(vals))\n print(group,'per taxon mean median',statistics.median(per_taxon), 'mean',statistics.mean(per_taxon), 'n',len(per_taxon))\nprint('ratio', statistics.median([]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
