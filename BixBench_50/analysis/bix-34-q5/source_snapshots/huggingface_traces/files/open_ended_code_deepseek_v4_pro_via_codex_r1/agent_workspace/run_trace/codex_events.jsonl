{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, glob, os\nfrom collections import defaultdict\n\ndef read_statuses(path):\n    with zipfile.ZipFile(path) as f:\n        data=f.read('run_eukaryota_odb10/full_table.tsv').decode()\n    lines=data.splitlines()[3:]\n    out=defaultdict(list)\n    for line in lines:\n        parts=line.split('\\\\t')\n        if len(parts)<3: continue\n        out[parts[0]].append(parts[1])\n    return out\nfor group, species in [('animals',['Cele','Ggal','Mmus','Xlae']),('fungi',['Ncra','Scer','Spom','Umay'])]:\n    stats=[read_statuses(f'/workspace/inputs/{group.capitalize()}_{sp}.busco.zip') for sp in species]\n    # single copy complete in all\n    genes=set(stats[0])\n    for st in stats[1:]: genes &= set(st)\n    sc=set(g for g in genes if all(st[g]==['Complete'] for st in stats))\n    print(group, 'all complete single',len(sc))\n    # compare scogs tree stems\n    with zipfile.ZipFile(f'/workspace/inputs/scogs_{group}.zip') as f:\n        tree_stems=set(n.split('/')[-1].split('.faa')[0] for n in f.namelist() if n.endswith('.treefile'))\n    print('tree count',len(tree_stems),'intersection with sc',len(tree_stems & sc),'only tree not sc',len(tree_stems-sc), list(tree_stems-sc)[:5])\n    print('only sc not tree',len(sc-tree_stems),list(sc-tree_stems)[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, glob, os\nfrom collections import defaultdict\n\ndef read_statuses(path):\n    with zipfile.ZipFile(path) as f:\n        data=f.read('run_eukaryota_odb10/full_table.tsv').decode()\n    lines=data.splitlines()[3:]\n    out=defaultdict(list)\n    for line in lines:\n        parts=line.split('\\\\t')\n        if len(parts)<3: continue\n        out[parts[0]].append(parts[1])\n    return out\nfor group, species in [('animals',['Cele','Ggal','Mmus','Xlae']),('fungi',['Ncra','Scer','Spom','Umay'])]:\n    stats=[read_statuses(f'/workspace/inputs/{group.capitalize()}_{sp}.busco.zip') for sp in species]\n    # single copy complete in all\n    genes=set(stats[0])\n    for st in stats[1:]: genes &= set(st)\n    sc=set(g for g in genes if all(st[g]==['Complete'] for st in stats))\n    print(group, 'all complete single',len(sc))\n    # compare scogs tree stems\n    with zipfile.ZipFile(f'/workspace/inputs/scogs_{group}.zip') as f:\n        tree_stems=set(n.split('/')[-1].split('.faa')[0] for n in f.namelist() if n.endswith('.treefile'))\n    print('tree count',len(tree_stems),'intersection with sc',len(tree_stems & sc),'only tree not sc',len(tree_stems-sc), list(tree_stems-sc)[:5])\n    print('only sc not tree',len(sc-tree_stems),list(sc-tree_stems)[:5])\nPY\"","aggregated_output":"animals all complete single 22\ntree count 100 intersection with sc 22 only tree not sc 78 ['1538526at2759', '331411at2759', '1488436at2759', '1441854at2759', '1355894at2759']\nonly sc not tree 0 []\nfungi all complete single 211\ntree count 249 intersection with sc 211 only tree not sc 38 ['1364586at2759', '1085752at2759', '976469at2759', '625387at2759', '1108845at2759']\nonly sc not tree 0 []\n","exit_code":0,"status":"completed"}}
