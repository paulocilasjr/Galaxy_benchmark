{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport zipfile, io, statistics, itertools, math, os\nfrom Bio import Phylo\n\ndef pairwise_dists_tree(newick):\n    tree=Phylo.read(io.StringIO(newick),'newick')\n    terms=tree.get_terminals()\n    dists={}\n    # ensure rooted? Bio Phylo unrooted? For tree string, node root maybe no name, could parse. Use distance method on tree? \n    for a,b in itertools.combinations(terms,2):\n        d=tree.distance(a,b)\n        dists[(a.name,b.name)]=d\n    return terms,dists\n\ndef summary(z, ext='treefile'):\n    with zipfile.ZipFile(z) as f:\n        names=[n for n in f.namelist() if n.endswith('.'+ext)]\n        vals=[]; info=[]\n        for n in names:\n            data=f.read(n).decode().strip()\n            if ext=='treefile':\n                terms,dists=pairwise_dists_tree(data)\n                if not dists:\n                    continue\n                ds=list(dists.values())\n                mean=statistics.mean(ds)\n                # get terminal names\n            elif ext=='mldist':\n                lines=data.splitlines()\n                if not lines: continue\n                ntax=int(lines[0])\n                # triangular matrix lines each has ntax floats\n                rows=[]\n                for line in lines[1:1+ntax]:\n                    parts=line.split()\n                    rows.append([float(x) for x in parts[1:]])\n                ds=[]\n                for i in range(ntax):\n                    for j in range(i):\n                        ds.append(rows[i][j])\n                mean=statistics.mean(ds)\n                terms=rows\n            vals.append(mean)\n            info.append((n,mean,len(ds), [a.name for a in terms] if ext=='treefile' else None))\n        return vals, info\nfor group in ['animals','fungi']:\n    z=f'/workspace/inputs/scogs_{group}.zip'\n    print('\\\\nGROUP',group)\n    for ext in ['treefile','mldist']:\n        vals,info=summary(z,ext)\n        print(ext,'n',len(vals),'median',statistics.median(vals),'mean',statistics.mean(vals),'minmax',min(vals),max(vals))\n        # sample info with min/max\n        for x in sorted(info,key=lambda x:x[1])[:2]: print(' min',x)\n        for x in sorted(info,key=lambda x:x[1])[-2:]: print(' max',x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
