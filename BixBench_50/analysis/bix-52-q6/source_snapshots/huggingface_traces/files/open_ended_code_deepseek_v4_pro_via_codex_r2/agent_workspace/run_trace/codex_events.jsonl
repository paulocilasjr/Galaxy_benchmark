{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv, collections\n# load lengths JD\nlengths={}\nwith open('inputs/JD_Chromosome_Length.csv', newline='', encoding='utf-8-sig') as f:\n    r=csv.reader(f); next(r)\n    for c,l in r:\n        lengths[c.strip()]=int(l)\n# parse CpG\nsites=collections.defaultdict(set)\nwith open('inputs/JD_AgeRelated_CpG_noMT_Final.csv', newline='') as f:\n    r=csv.reader(f); h=next(r)\n    ci=h.index('Chromosome'); pi=h.index('Pos'); si=h.index('StartPosition')\n    for row in r:\n        sites[row[ci]].add((row[pi], row[si]))\nprint('chrom','unique_sites','length','density_per_bp','density_per_Mb','rows')\nallrows=collections.Counter()\nwith open('inputs/JD_AgeRelated_CpG_noMT_Final.csv', newline='') as f:\n    r=csv.reader(f); next(r); ci=1\n    h=['Pos','SampleShared','Sample','SampleL','StartPosition','EndPosition','MethylationPercentage','CountMethylated','CountNonMethylated','Chromosome','Coverage','Dage']; ci=h.index('Chromosome')\n    for row in r: allrows[row[ci]]+=1\nres=[]\nfor c,st in sites.items():\n    l=lengths.get(c)\n    res.append((len(st)/l if l else None,c,len(st),l,len(st)/(l/1e6) if l else None,allrows[c]))\nfor x in sorted(res, reverse=True):\n    print(x)\nprint('max by density per bp:', max(res, key=lambda x:x[0]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
