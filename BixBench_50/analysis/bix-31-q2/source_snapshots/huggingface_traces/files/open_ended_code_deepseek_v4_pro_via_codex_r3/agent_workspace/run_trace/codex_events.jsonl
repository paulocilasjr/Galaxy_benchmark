\\"_MoM_dispersions\\\"].values,\n        min_disp=dds.min_disp, max_disp=dds.max_disp)\n    dds.var[\\\"genewise_dispersions\\\"] = np.full(dds.n_vars, np.nan)\n    dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"genewise_dispersions\\\"] = np.clip(\n        dispersions_, dds.min_disp, dds.max_disp)\n    dds.var[\\\"_genewise_converged\\\"] = pd.array([pd.NA]*dds.n_vars, dtype=\\\"boolean\\\")\n    dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"_genewise_converged\\\"] = l_bfgs_b_converged_\n\nprint('loading', flush=True)\nt=time.time()\nmeta=pd.read_csv('inputs/Sample_annotated_Zenodo.csv').set_index('sample')\ncounts=pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv',index_col=0).astype(np.int32).T\nmeta=meta.loc[counts.index]\nmeta['batch']='b'+meta['batch'].astype(str)\nprint('counts', counts.shape, 'rss', rss_gb(), flush=True)\ndds=DeseqDataSet(counts=counts, metadata=meta, design='~ batch + sex', n_cpus=4, quiet=True, low_memory=True, refit_cooks=False)\nprint('DDS init rss', rss_gb(), flush=True)\ndds.fit_size_factors()\nprint('size factors rss', rss_gb(), flush=True)\nfit_genewise_dispersions_lowmem(dds)\nprint('genewise rss', rss_gb(), flush=True)\ndds.fit_dispersion_trend()\nprint('trend rss', rss_gb(), flush=True)\ndds.fit_dispersion_prior()\nprint('prior rss', rss_gb(), flush=True)\ndds.fit_MAP_dispersions()\nprint('MAP rss', rss_gb(), flush=True)\n# Use single-process inference for the remaining larger matrix operations.\ndds.inference.n_cpus = 1\ndds.fit_LFC()\nprint('LFC rss', rss_gb(), flush=True)\nfor key in ['_mu_LFC','_hat_diagonals']:\n    if key in dds.obsm:\n        del dds.obsm[key]\nfor key in list(dds.layers.keys()):\n    if key in ['normed_counts','_mu_hat']:\n        del dds.layers[key]\ngc.collect()\nprint('after cleanup rss', rss_gb(), flush=True)\nstat=DeseqStats(dds, contrast=['sex','M','F'], n_cpus=1, quiet=True, cooks_filter=False, independent_filter=False)\nstat.run_wald_test()\nprint('wald rss', rss_gb(), flush=True)\ncoeff='sex[T.M]'\nprint('LFC cols', stat.LFC.columns.tolist(), flush=True)\nprint('unshrunk FAM138A natural LFC', float(stat.LFC.loc['FAM138A', coeff]), 'SE', float(stat.SE.loc['FAM138A']), flush=True)\nstat.lfc_shrink(coeff=coeff)\nprint('shrink rss', rss_gb(), flush=True)\nnatural=float(stat.LFC.loc['FAM138A', coeff])\nlfc=natural/np.log(2)\nbaseMean=float(stat.base_mean.loc['FAM138A'])\nprint('FAM138A log2FoldChange', repr(lfc))\nprint('FAM138A baseMean', repr(baseMean))\nprint('FAM138A natural LFC', repr(natural))\nprint('FAM138A shrunken SE', repr(float(stat.SE.loc['FAM138A'])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
