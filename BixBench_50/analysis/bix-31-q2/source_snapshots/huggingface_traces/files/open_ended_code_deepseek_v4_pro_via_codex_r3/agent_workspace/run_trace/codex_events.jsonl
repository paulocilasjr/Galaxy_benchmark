{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nimport pandas as pd, numpy as np, gc\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.utils import robust_method_of_moments_disp, n_or_more_replicates\nfrom scipy.stats import f\n\ndef fit_genewise_dispersions_lowmem(dds):\n    if \\\"size_factors\\\" not in dds.obs:\n        dds.fit_size_factors(fit_type=dds.size_factors_fit_type)\n    dds.var[\\\"non_zero\\\"] = ~(dds.X == 0).all(axis=0)\n    dds.non_zero_idx = np.arange(dds.n_vars)[dds.var[\\\"non_zero\\\"]]\n    dds.non_zero_genes = dds.var_names[dds.var[\\\"non_zero\\\"]]\n    dds._fit_MoM_dispersions()\n    # Keep normed_counts for now.\n    design_matrix=dds.obsm['design_matrix'].values\n    size_factors=dds.obs['size_factors'].values\n    if len(dds.obsm['design_matrix'].value_counts())==dds.obsm['design_matrix'].shape[-1]:\n        mu_hat_=dds.inference.lin_reg_mu(counts=dds.X[:,dds.non_zero_idx],size_factors=size_factors,design_matrix=design_matrix,min_mu=dds.min_mu)\n    else:\n        _,mu_hat_,_,_=dds.inference.irls(counts=dds.X[:,dds.non_zero_idx],size_factors=size_factors,design_matrix=design_matrix,disp=dds.var.loc[dds.var['non_zero'],'_MoM_dispersions'].values,min_mu=dds.min_mu,beta_tol=dds.beta_tol)\n    dds.layers['_mu_hat']=np.full((dds.n_obs,dds.n_vars),np.nan)\n    dds.layers['_mu_hat'][:,dds.var['non_zero']]=mu_hat_\n    del mu_hat_; gc.collect()\n    dispersions_,conv=dds.inference.alpha_mle(counts=dds.X[:,dds.non_zero_idx],design_matrix=design_matrix,mu=dds.layers['_mu_hat'][:,dds.non_zero_idx],alpha_hat=dds.var.loc[dds.var['non_zero'],'_MoM_dispersions'].values,min_disp=dds.min_disp,max_disp=dds.max_disp)\n    dds.var['genewise_dispersions']=np.full(dds.n_vars,np.nan)\n    dds.var.loc[dds.var['non_zero'],'genewise_dispersions']=np.clip(dispersions_,dds.min_disp,dds.max_disp)\n    dds.var['_genewise_converged']=pd.array([pd.NA]*dds.n_vars,dtype='boolean')\n    dds.var.loc[dds.var['non_zero'],'_genewise_converged']=conv\n\nmeta=pd.read_csv('inputs/Sample_annotated_Zenodo.csv').set_index('sample')\ncounts=pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv',index_col=0).astype(np.int32).T\nmeta=meta.loc[counts.index]; meta['batch']='b'+meta['batch'].astype(str)\ndds=DeseqDataSet(counts=counts,metadata=meta,design='~ batch + sex',n_cpus=4,quiet=True,low_memory=False,refit_cooks=False)\ndds.fit_size_factors()\nfit_genewise_dispersions_lowmem(dds)\ndds.fit_dispersion_trend()\ndds.fit_dispersion_prior()\ndds.fit_MAP_dispersions()\n# target computations\ngene='FAM138A'\ngi=dds.var_names.get_loc(gene)\ndm=dds.obsm['design_matrix'].values\nsf=dds.obs['size_factors'].values\ndisp=np.array([dds.var.loc[gene,'dispersions']],dtype=float)\nbeta,mu,hat,conv=dds.inference.irls(counts=dds.X[:,gi:gi+1],size_factors=sf,design_matrix=dm,disp=disp,min_mu=dds.min_mu,beta_tol=dds.beta_tol)\nmu=mu[:,0]; hat=hat[:,0]\n# robust method of moments dispersion for this gene only from normed_counts\nnormed_col=dds.layers['normed_counts'][:,gi]\n# call robust method with one gene column; signature expects ndarray shape n x p and design df\nrdisp=robust_method_of_moments_disp(normed_col[:,None], dds.obsm['design_matrix'])\n# Calculate cooks as in method\nres=(dds.X[:,gi]-mu)\nres=res**2\nV=mu**2*rdisp[0]+mu\nres=res/V/5\nres=res*hat/(1-hat)**2\ncutoff=f.ppf(0.99,5,dds.n_obs-5)\nuse_for_max=n_or_more_replicates(dds.obsm['design_matrix'],3)\nprint('gene',gene)\nprint('dispersion',dds.var.loc[gene,'dispersions'])\nprint('mu_LFC',mu)\nprint('hat_diagonals',hat)\nprint('rdisp',rdisp)\nprint('cooks',res)\nprint('cooks_cutoff',cutoff)\nprint('use_for_max count',use_for_max.sum(),'of',len(use_for_max))\nprint('max cooks sample index',np.argmax(res),'sample',dds.obs_names[np.argmax(res)],'maxcooks',res.max())\nprint('outlier among use_for_max',bool((res[use_for_max]>cutoff).any()))\npos=np.argmax(res)\nprint('pos sample',dds.obs_names[pos], 'count at pos',dds.X[pos,gi], 'counts greater than pos', int((dds.X[:,gi]>dds.X[pos,gi]).sum()))\nprint('would be final outlier:', bool((res[use_for_max]>cutoff).any()) and int((dds.X[:,gi]>dds.X[pos,gi]).sum())<3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
