f \"prior_disp_var\" not in self.uns:\n            self.fit_dispersion_prior()\n\n        # Convert design matrix to numpy for speed\n        design_matrix = self.obsm[\"design_matrix\"].values\n\n        if not self.quiet:\n            print(\"Fitting MAP dispersions...\", file=sys.stderr)\n        start = time.time()\n        dispersions_, l_bfgs_b_converged_ = self.inference.alpha_mle(\n            counts=self.X[:, self.non_zero_idx],\n            design_matrix=design_matrix,\n            mu=self.layers[\"_mu_hat\"][:, self.non_zero_idx],\n            alpha_hat=self.var.loc[self.var[\"non_zero\"], \"fitted_dispersions\"].values,\n         \n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nimport pandas as pd, numpy as np, time, resource, gc, warnings\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ndef rss_gb():\n    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024/1024\n\ndef fit_genewise_dispersions_lowmem(dds):\n    if \\\"size_factors\\\" not in dds.obs:\n        dds.fit_size_factors(fit_type=dds.size_factors_fit_type)\n    dds.var[\\\"non_zero\\\"] = ~(dds.X == 0).all(axis=0)\n    dds.non_zero_idx = np.arange(dds.n_vars)[dds.var[\\\"non_zero\\\"]]\n    dds.non_zero_genes = dds.var_names[dds.var[\\\"non_zero\\\"]]\n    dds._fit_MoM_dispersions()\n    # normed_counts is no longer needed after rough dispersions\n    if \\\"normed_counts\\\" in dds.layers:\n        del dds.layers[\\\"normed_counts\\\"]\n    gc.collect()\n    design_matrix = dds.obsm[\\\"design_matrix\\\"].values\n    size_factors = dds.obs[\\\"size_factors\\\"].values\n    # replicate fit_genewise_dispersions mu_hat branch\n    if len(dds.obsm[\\\"design_matrix\\\"].value_counts()) == dds.obsm[\\\"design_matrix\\\"].shape[-1]:\n        mu_hat_ = dds.inference.lin_reg_mu(\n            counts=dds.X[:, dds.non_zero_idx],\n            size_factors=size_factors,\n            design_matrix=design_matrix,\n            min_mu=dds.min_mu,\n        )\n    else:\n        _, mu_hat_, _, _ = dds.inference.irls(\n            counts=dds.X[:, dds.non_zero_idx],\n            size_factors=size_factors,\n            design_matrix=design_matrix,\n            disp=dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"_MoM_dispersions\\\"].values,\n            min_mu=dds.min_mu,\n            beta_tol=dds.beta_tol,\n        )\n    dds.layers[\\\"_mu_hat\\\"] = np.full((dds.n_obs, dds.n_vars), np.nan)\n    dds.layers[\\\"_mu_hat\\\"][:, dds.var[\\\"non_zero\\\"]] = mu_hat_\n    del mu_hat_; gc.collect()\n    dispersions_, l_bfgs_b_converged_ = dds.inference.alpha_mle(\n        counts=dds.X[:, dds.non_zero_idx],\n        design_matrix=design_matrix,\n        mu=dds.layers[\\\"_mu_hat\\\"][:, dds.non_zero_idx],\n        alpha_hat=dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"_MoM_dispersions\\\"].values,\n        min_disp=dds.min_disp,\n        max_disp=dds.max_disp,\n    )\n    dds.var[\\\"genewise_dispersions\\\"] = np.full(dds.n_vars, np.nan)\n    dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"genewise_dispersions\\\"] = np.clip(\n        dispersions_, dds.min_disp, dds.max_disp\n    )\n    dds.var[\\\"_genewise_converged\\\"] = pd.array([pd.NA]*dds.n_vars, dtype=\\\"boolean\\\")\n    dds.var.loc[dds.var[\\\"non_zero\\\"], \\\"_genewise_converged\\\"] = l_bfgs_b_converged_\n\nprint('loading', flush=True)\nt=time.time()\nmeta=pd.read_csv('inputs/Sample_annotated_Zenodo.csv').set_index('sample')\ncounts=pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv',index_col=0)\ncounts=counts.astype(np.int32)\ncounts=counts.T\nmeta=meta.loc[counts.index]\nmeta['batch']='b'+meta['batch'].astype(str)\nprint('counts', counts.shape, 'rss', rss_gb(), flush=True)\ndds=DeseqDataSet(counts=counts, metadata=meta, design='~ batch + sex', n_cpus=4, quiet=True, low_memory=True, refit_cooks=False)\nprint('DDS init rss', rss_gb(), flush=True)\ndds.fit_size_factors()\nprint('size factors rss', rss_gb(), flush=True)\nfit_genewise_dispersions_lowmem(dds)\nprint('genewise rss', rss_gb(), flush=True)\ndds.fit_dispersion_trend()\nprint('trend rss', rss_gb(), flush=True)\ndds.fit_dispersion_prior()\nprint('prior rss', rss_gb(), flush=True)\ndds.fit_MAP_dispersions()\nprint('MAP rss', rss_gb(), flush=True)\ndds.fit_LFC()\nprint('LFC rss', rss_gb(), flush=True)\nfor key in ['_mu_LFC','_hat_diagonals']:\n    if key in dds.obsm:\n        del dds.obsm[key]\nfor key in list(dds.layers.keys()):\n    if key in ['normed_counts','_mu_hat']:\n        del dds.layers[key]\ngc.collect()\nprint('after cleanup rss', rss_gb(), flush=True)\nstat=DeseqStats(dds, contrast=['sex','M','F'], n_cpus=4, quiet=True, cooks_filter=False, independent_filter=False)\nstat.run_wald_test()\nprint('wald rss', rss_gb(), flush=True)\ncoeff='sex[T.M]'\nprint('LFC cols', stat.LFC.columns.tolist(), flush=True)\nprint('unshrunk FAM138A natural LFC', float(stat.LFC.loc['FAM138A', coeff]), 'SE', float(stat.SE.loc['FAM138A']), flush=True)\nstat.lfc_shrink(coeff=coeff)\nprint('shrink rss', rss_gb(), flush=True)\nnatural=float(stat.LFC.loc['FAM138A', coeff])\nlfc=natural/np.log(2)\nbaseMean=float(stat.base_mean.loc['FAM138A'])\nprint('FAM138A log2FoldChange', repr(lfc))\nprint('FAM138A baseMean', repr(baseMean))\nprint('FAM138A natural LFC', repr(natural))\nprint('FAM138A shrunken SE', repr(float(stat.SE.loc['FAM138A'])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
