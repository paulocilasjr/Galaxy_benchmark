{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, numpy as np, statsmodels.api as sm\np='/workspace/inputs/data.xlsx'\nwb=openpyxl.load_workbook(p,data_only=True,read_only=True)\nws=wb.active\nrows=list(ws.iter_rows(values_only=True))\nh=rows[0]\ndata=[]\nfor r in rows[1:]:\n    if any(v is not None and str(v).strip()\"'!='\"'' for v in r):\n        d=dict(zip(h,r))\n        if d['Groups'] is not None and d['Efficacy'] is not None and isinstance(d['Age'],(int,float)):\n            data.append(d)\nprint('n',len(data), 'minmax age',min(d['Age'] for d in data),max(d['Age'] for d in data))\n# y variants\nage=np.array([d['Age'] for d in data],float)\nys={}\nys['PR_vs_other']=np.array([1 if d['Efficacy']=='PR' else 0 for d in data])\nys['group1']=np.array([1 if d['Groups']==1 else 0 for d in data])\nys['PR_or_SD?']=np.array([1 if d['Efficacy'] in ('PR','SD') else 0 for d in data]) # unlikely\nfor name,y in ys.items():\n    X=sm.add_constant(age)\n    try:\n        model=sm.Logit(y,X).fit(disp=0)\n        print('\\\\n',name,'n y1',sum(y))\n        print(model.params)\n        print(model.bse)\n        print('coef age', model.params['x1'] if 'x1' in model.params else model.params.iloc[1])\n        print('llf',model.llf)\n    except Exception as e:\n        print(name,e)\n# maybe scipy exact\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
