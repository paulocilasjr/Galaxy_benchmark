\"nameext\": \"\", \"nameroot\": \"230209_Exome_GRCh38_CHIP_SRR5688669\", \"path\": \"/jetstream2/scratch/main/jobs/78874511/inputs/dataset_cb756b62-f3e5-441a-aa6b-8f5a2c76eafd.dat\"}, {\"basename\": \"230209_Exome_GRCh38_CHIP_SRR5688704\", \"class\": \"File\", \"format\": \"zip\", \"location\": \"step_input://84\", \"nameext\": \"\", \"nameroot\": \"230209_Exome_GRCh38_CHIP_SRR5688704\", \"path\": \"/jetstream2/scratch/main/jobs/78874511/inputs/dataset_24d4c0f3-e7eb-4dbb-9b86-783e4d569c64.dat\"}, {\"basename\": \"230209_Exome_GRCh38_CHIP_SRR5688812\", \"class\": \"File\", \"format\": \"zip\", \"location\": \"step_input://85\", \"nameext\": \"\", \"nameroot\": \"230209_Exome_GRCh38_CHIP_SRR5688812\", \"path\": \"/jetstream2/scratch/main/jobs/78874511/inputs/dataset_3520dbe1-409b-4e7b-afaf-3191d69ef508.dat\"}, {\"basename\": \"230209_Exome_GRCh38_CHIP_SRR6447679\", \"class\": \"File\", \"format\": \"zip\", \"location\": \"step_input://86\", \"nameext\": \"\", \"nameroot\": \"230209_Exome_GRCh38_CHIP_SRR6447679\", \"path\": \"/jetstream2/scratch/main/jobs/78874511/inputs/dataset_00ff814b-aa27-4fcc-a1a0-cc55c07be8bb.dat\"}]\" <<'PY'\nimport sys, zipfile, re\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\n\nNS = {\"m\": \"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"}\n\ndef col_number(ref):\n    m = re.match(r\"([A-Z]+)\", ref or \"\")\n    if not m:\n        return 0\n    n = 0\n    for ch in m.group(1):\n        n = n * 26 + (ord(ch) - 64)\n    return n\n\ndef read_xlsx(path):\n    with zipfile.ZipFile(path) as z:\n        shared = []\n        if \"xl/sharedStrings.xml\" in z.namelist():\n            root = ET.fromstring(z.read(\"xl/sharedStrings.xml\"))\n            for si in root.findall(\"m:si\", NS):\n                shared.append(\"\".join(t.text or \"\" for t in si.iter(\"{%s}t\" % NS[\"m\"])))\n        sheets = sorted(n for n in z.namelist() if n.startswith(\"xl/worksheets/sheet\") and n.endswith(\".xml\"))\n        if not sheets:\n            return []\n        root = ET.fromstring(z.read(sheets[0]))\n        rows = []\n        for row in root.findall(\".//m:row\", NS):\n            cells = {}\n            for cell in row.findall(\"m:c\", NS):\n                idx = col_number(cell.attrib.get(\"r\", \"\"))\n                typ = cell.attrib.get(\"t\")\n                if typ == \"inlineStr\":\n                    val = \"\".join(t.text or \"\" for t in cell.iter(\"{%s}t\" % NS[\"m\"]))\n                else:\n                    v = cell.find(\"m:v\", NS)\n                    val = v.text if v is not None and v.text is not None else \"\"\n                    if typ == \"s\" and val != \"\":\n                        val = shared[int(val)]\n                    elif typ == \"b\":\n                        val = \"True\" if val == \"1\" else \"False\"\n                cells[idx] = val\n            width = max(cells.keys(), default=0)\n            rows.append([cells.get(i, \"\") for i in range(1, width + 1)])\n        return rows\n\nmanifest = sys.argv[1]\nitems = re.findall(r\"basename:\\s*([^,}]+).*?path:\\s*([^,}]+)\", manifest)\nwith open(\"merged.tsv\", \"w\", encoding=\"utf-8\") as out:\n    for basename, raw_path in items:\n        path = Path(raw_path.strip())\n        try:\n            rows = read_xlsx(path)\n        except Exception:\n            continue\n        name = basename.strip()\n        if name.startswith(\"230209_Exome_GRCh38_CHIP_\"):\n            key = name[len(\"230209_Exome_GRCh38_CHIP_\"):]\n        else:\n            key = name\n        key = key.split(\"-\", 1)[0]\n        for vals in rows[2:]:\n            vals = (vals + [\"\"] * 33)[:33]\n            out.write(\"\\t\".join(vals + [key]) + \"\\n\")\nPY",
