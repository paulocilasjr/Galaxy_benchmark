{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, re, math, statistics, collections\n# parse trio\ntrio=[]\nws=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True).active\nfor r in ws.iter_rows(min_row=2, values_only=True):\n    sid=str(r[0]).strip().replace('\\\\t','').strip()\n    status=str(r[1]).strip() if r[1] is not None else ''\n    blm=str(r[3]).strip() if r[3] is not None else ''\n    trio.append({'sid':sid,'status':status,'blm':blm})\n\nfiles=sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\nfilemap={}\nfor f in files:\n    token=os.path.basename(f).split('_')[-1].split('.')[0]\n    filemap[token]=f\n\ndef match_trio(rec):\n    sid=rec['sid']\n    if sid in filemap: return sid\n    if re.fullmatch(r'\\\\d+',sid):\n        cands=[t for t in filemap if re.fullmatch(re.escape(sid)+r'-[A-Z0-9]+', t)]\n        if len(cands)==1: return cands[0]\n        if len(cands)>1: print('multi', sid, cands)\n    return None\n\n# parse one file filtered count\nexcl_ont = {'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\n\ndef count_file(f, excl_ref=True, excl_missing_vaf=True, min_vaf=0.3):\n    ws=openpyxl.load_workbook(f, data_only=True).active\n    n=0\n    kept=[]\n    for r in ws.iter_rows(min_row=3, values_only=True):\n        zyg=str(r[4]).strip() if r[4] is not None else 'None'\n        ont=str(r[13]).strip() if r[13] is not None else ''\n        # exclude ontology terms if term present? exact entire value? Use set split\n        ont_parts=set(ont.split(',')) if ont else set()\n        if excl_ref and (zyg=='Reference'):\n            continue\n        if ont_parts & excl_ont:\n            continue\n        if zyg not in ('Heterozygous','Homozygous Variant'):\n            # maybe skip None; count separately\n            pass\n        vaf=r[9]\n        try:\n            v=float(vaf)\n        except:\n            if excl_missing_vaf:\n                continue\n            v=None\n        if v is not None and v < min_vaf:\n            n+=1\n            kept.append(r)\n    return n,kept\n\ndef median_counts(recs):\n    counts=[]\n    for rec in recs:\n        tok=match_trio(rec)\n        if tok is None:\n            #print('no file',rec)\n            continue\n        n,_=count_file(filemap[tok])\n        counts.append(n)\n        print(rec['sid'], rec['status'], rec['blm'], 'file', tok, 'count', n)\n    print('N with files',len(counts),'counts',counts,'median',statistics.median(counts))\n    return counts\n\nfor label, pred in [\n    ('blm Carrier exact', lambda r:r['blm']=='Carrier'),\n    ('blm Affected', lambda r:r['blm']=='Affected'),\n    ('blm Carrier or Affected', lambda r:r['blm'] in ('Carrier','Affected')),\n    ('Unaffected', lambda r:r['blm']=='Unaffected'),\n]:\n    print('\\\\n###',label)\n    recs=[r for r in trio if pred(r)]\n    print('records',len(recs))\n    median_counts(recs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
