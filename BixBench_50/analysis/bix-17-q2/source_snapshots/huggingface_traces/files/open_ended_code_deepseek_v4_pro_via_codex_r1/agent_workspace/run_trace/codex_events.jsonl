{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, re, statistics\n\ntrio_ws = openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx', data_only=True).active\ncarriers = []\nfor row in trio_ws.iter_rows(min_row=2, values_only=True):\n    sample_id = str(row[0]).strip().replace('\\\\t', '').strip()\n    blm_status = str(row[3]).strip()\n    if blm_status == 'Carrier':\n        carriers.append(sample_id)\n\nfile_map = {}\nfor path in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n    token = os.path.basename(path).split('_')[-1].split('.')[0]\n    file_map[token] = path\n\ndef resolve_path(sample_id):\n    if sample_id in file_map:\n        return file_map[sample_id]\n    if re.fullmatch(r'\\\\d+', sample_id):\n        candidates = [t for t in file_map if re.fullmatch(re.escape(sample_id) + r'-[A-Z0-9]+', t)]\n        if len(candidates) == 1:\n            return file_map[candidates[0]]\n    return None\n\nexcluded_ontology = {\n    'intron_variant',\n    'intergenic_variant',\n    '3_prime_UTR_variant',\n    '5_prime_UTR_variant',\n    '5_prime_UTR_premature_start_codon_gain_variant',\n}\n\ndef count_chip_variants(path):\n    ws = openpyxl.load_workbook(path, data_only=True).active\n    count = 0\n    for row in ws.iter_rows(min_row=3, values_only=True):\n        zygosity = row[4]\n        ontology = row[13]\n        vaf_raw = row[9]\n        if zygosity == 'Reference':\n            continue\n        if ontology in excluded_ontology:\n            continue\n        try:\n            vaf = float(vaf_raw)\n        except (TypeError, ValueError):\n            continue\n        if vaf < 0.3:\n            count += 1\n    return count\n\ncounts = []\nfor sample_id in carriers:\n    path = resolve_path(sample_id)\n    if path is None:\n        continue\n    counts.append(count_chip_variants(path))\n\nprint('carrier sample IDs:', carriers)\nprint('counts:', counts)\nprint('median:', statistics.median(counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
