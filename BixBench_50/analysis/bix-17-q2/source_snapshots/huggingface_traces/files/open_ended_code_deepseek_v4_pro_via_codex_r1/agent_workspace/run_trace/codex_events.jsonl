7] or ''))\n    if excl: continue\n    try:v=float(r[9])\n    except:continue\n    if v<0.3:n+=1\n   counts.append(n)\n  print(label,counts,'median',statistics.median(counts))\nPY\"","aggregated_output":"Carrier [3, 4, 1, 6, 2, 2, 1, 5, 1, 0, 3, 3, 4, 2, 1, 2, 1, 5, 1] median 2\nAffected [2, 1, 1, 0, 2, 0, 3, 2, 5, 3] median 2.0\nCombined [2, 3, 4, 1, 1, 6, 1, 2, 2, 0, 1, 5, 2, 1, 0, 0, 3, 3, 3, 4, 2, 2, 1, 5, 2, 1, 3, 5, 1] median 2\n\nMODE ont+hgvs_utr\nCarrier [2, 4, 1, 6, 2, 2, 1, 5, 1, 0, 3, 3, 4, 2, 1, 2, 1, 5, 1] median 2\nAffected [2, 1, 1, 0, 2, 0, 3, 2, 5, 3] median 2.0\nCombined [2, 2, 4, 1, 1, 6, 1, 2, 2, 0, 1, 5, 2, 1, 0, 0, 3, 3, 3, 4, 2, 2, 1, 5, 2, 1, 3, 5, 1] median 2\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, collections\nfor f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx'):\n w=openpyxl.load_workbook(f,data_only=True).active\n positions=[str(r[0]) for r in w.iter_rows(min_row=3,values_only=True)]\n c=collections.Counter(positions)\n dups=[(p,n) for p,n in c.items() if n>1]\n if dups:\n  print(os.path.basename(f),'total',len(positions),'unique',len(c),'dups',dups[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
