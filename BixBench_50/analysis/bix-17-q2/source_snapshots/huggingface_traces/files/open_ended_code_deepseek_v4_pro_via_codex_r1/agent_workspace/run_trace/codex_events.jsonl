{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, re, collections, statistics\n# Count passing variants by row vs unique position/refalt for carriers\nchip=set(); ws=openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx',data_only=True).active\nfor r in ws.iter_rows(values_only=True):\n if r[0]: chip.add(str(r[0]))\ntrio_ws=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True).active\ncarriers=[]\nfor r in trio_ws.iter_rows(min_row=2,values_only=True):\n sid=str(r[0]).strip().replace('\\\\t','').strip(); status=str(r[1]).strip(); blm=str(r[3]).strip()\n if blm=='Carrier': carriers.append(sid)\nfiles={os.path.basename(f).split('_')[-1].split('.')[0]:f for f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')}\ndef match(sid):\n if sid in files:return sid\n cand=[t for t in files if re.fullmatch(re.escape(sid)+r'-[A-Z0-9]+',t)]\n return cand[0] if len(cand)==1 else None\nexcl={'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\nfor sid in carriers:\n tok=match(sid)\n if not tok: continue\n w=openpyxl.load_workbook(files[tok],data_only=True).active\n rows=[]; positions=[]\n for r in w.iter_rows(min_row=3,values_only=True):\n  if r[4]=='Reference': continue\n  if r[13] in excl: continue\n  try: v=float(r[9])\n  except: continue\n  if v<0.3:\n   rows.append(r); positions.append(str(r[0]))\n dup=[(p,n) for p,n in collections.Counter(positions).items() if n>1]\n print(sid, 'row count',len(rows),'unique pos',len(set(positions)), 'dup',dup)\n if dup:\n  for r in rows:\n   if str(r[0]) in [p for p,n in dup]: print('   ',r[0],r[1],r[4],r[9],r[12],r[13],r[16],r[17])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
