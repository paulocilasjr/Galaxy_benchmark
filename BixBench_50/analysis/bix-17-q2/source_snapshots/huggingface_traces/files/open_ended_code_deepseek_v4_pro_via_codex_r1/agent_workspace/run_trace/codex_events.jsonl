{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, re\n# collect non-reference VAF<0.3 excluding only reference, print those with c.* or c.- HGVS and ont not UTR\npat=re.compile(r':c\\\\.\\\\*|:c\\\\.-')\nexcl_ont={'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\nfor f in sorted(glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')):\n w=openpyxl.load_workbook(f,data_only=True).active\n for r in w.iter_rows(min_row=3,values_only=True):\n  if r[4]=='Reference': continue\n  try: v=float(r[9])\n  except: continue\n  if v>=0.3: continue\n  h=str(r[17] or '')\n  if pat.search(h):\n   print(os.path.basename(f), r[0],r[1],r[4],v,r[12],r[13],r[14],r[16],h, 'ONTexcluded?', r[13] in excl_ont)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
