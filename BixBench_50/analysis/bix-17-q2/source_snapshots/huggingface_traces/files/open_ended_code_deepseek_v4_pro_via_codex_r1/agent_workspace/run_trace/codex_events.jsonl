{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# median counts with additional HGVS UTR/intron detection variants\nimport openpyxl, glob, os, re, statistics\nchip=set()\nws=openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx',data_only=True).active\nfor r in ws.iter_rows(values_only=True):\n if r[0]: chip.add(str(r[0]))\ntrio_ws=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True).active\nrecs=[]\nfor r in trio_ws.iter_rows(min_row=2,values_only=True):\n sid=str(r[0]).strip().replace('\\\\t','').strip(); status=str(r[1]).strip(); blm=str(r[3]).strip()\n recs.append((sid,status,blm))\nfiles={os.path.basename(f).split('_')[-1].split('.')[0]:f for f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')}\ndef match(sid):\n if sid in files:return sid\n if re.fullmatch(r'\\\\d+',sid):\n  cand=[t for t in files if re.fullmatch(re.escape(sid)+r'-[A-Z0-9]+',t)]\n  return cand[0] if len(cand)==1 else None\n return None\nont_excl={'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\ndef is_excluded(ont,hgvs):\n if ont in ont_excl: return True\n # c.* UTR 3'; c.- UTR 5'; maybe also c. with +/-\n if hgvs:\n  if ':c.*' in hgvs or ':c.-' in hgvs:\n   return True\n  # n. UTR? probably not\n return False\nfor mode in ['ont','ont+hgvs_utr']:\n print('\\\\nMODE',mode)\n for label,pred in [('Carrier',lambda r:r[2]=='Carrier'),('Affected',lambda r:r[2]=='Affected'),('Combined',lambda r:r[2] in ('Carrier','Affected'))]:\n  counts=[]\n  for sid,status,blm in recs:\n   if not pred((sid,status,blm)): continue\n   tok=match(sid)\n   if not tok: continue\n   w=openpyxl.load_workbook(files[tok],data_only=True).active;n=0\n   for r in w.iter_rows(min_row=3,values_only=True):\n    if r[4]=='Reference': continue\n    if mode=='ont':\n     excl=r[13] in ont_excl\n    else:\n     excl=is_excluded(str(r[13]),str(r[17] or ''))\n    if excl: continue\n    try:v=float(r[9])\n    except:continue\n    if v<0.3:n+=1\n   counts.append(n)\n  print(label,counts,'median',statistics.median(counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
