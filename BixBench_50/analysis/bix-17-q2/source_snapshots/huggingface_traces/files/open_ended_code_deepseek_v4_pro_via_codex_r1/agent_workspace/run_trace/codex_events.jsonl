{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport openpyxl, glob, os, re, statistics\n# reproduce carrier counts and list rows\nchip=set(); ws=openpyxl.load_workbook('inputs/230214_Schenz_et_al_2022_CHIP_Genes.xlsx',data_only=True).active\nfor r in ws.iter_rows(values_only=True):\n if r[0]: chip.add(str(r[0]))\ntrio=[]\nws=openpyxl.load_workbook('inputs/230215_Trio_Status.xlsx',data_only=True).active\nfor r in ws.iter_rows(min_row=2,values_only=True):\n sid=str(r[0]).strip().replace('\\\\t','').strip(); status=str(r[1]).strip(); blm=str(r[3]).strip()\n if blm=='Carrier': trio.append((sid,status,blm))\nfiles={os.path.basename(f).split('_')[-1].split('.')[0]:f for f in glob.glob('inputs/CHIP_DP10_GQ20_PASS/*.xlsx')}\ndef match(sid):\n if sid in files:return sid\n cand=[t for t in files if re.fullmatch(re.escape(sid)+r'-[A-Z0-9]+',t)]\n return cand[0] if len(cand)==1 else None\nexcl={'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\nallc=[]\nfor sid,status,blm in trio:\n tok=match(sid)\n if not tok: continue\n w=openpyxl.load_workbook(files[tok],data_only=True).active\n passed=[]\n for r in w.iter_rows(min_row=3,values_only=True):\n  # optionally gene list restriction no effect\n  zyg=str(r[4]); ont=str(r[13])\n  if zyg=='Reference': continue\n  if ont in excl: continue\n  try: v=float(r[9])\n  except: continue\n  if v<0.3:\n   passed.append((r[0],r[1],zyg,v,r[12],ont,r[14],r[16],r[17]))\n print(sid,tok,'count',len(passed))\n for p in passed: print('   ',p)\n allc.append(len(passed))\nprint('ALL counts',allc,'median',statistics.median(allc))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
