{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl\nfrom pathlib import Path\nfrom collections import Counter\nzyg=Counter(); so=Counter(); zyg_so=Counter(); chip=Counter(); effect=Counter(); filt=Counter(); mendel=Counter(); vaf_blank=0; vaf_lt=0; vaf_ge=0; total=0\nbad=[]\nfor p in Path('/workspace/inspect/exomes').glob('*.xlsx'):\n wb=openpyxl.load_workbook(p, read_only=False, data_only=True); ws=wb.active\n for i,row in enumerate(ws.iter_rows(values_only=True)):\n  if i<2: continue\n  total+=1\n  z=row[4]; s=row[13]; v=row[9]; ch=row[29]; eff=row[14]; f=row[19]; me=row[5]\n  zyg[z]+=1; so[s]+=1; zyg_so[(z,s)]+=1; chip[ch]+=1; effect[eff]+=1; filt[f]+=1; mendel[me]+=1\n  if v is None or str(v).strip()=='':\n   vaf_blank+=1\n  else:\n   try:\n    if float(v)<0.3: vaf_lt+=1\n    else: vaf_ge+=1\n   except: bad.append((p.name,i,v))\nprint('total data',total,'vaf blank/lt/ge',vaf_blank,vaf_lt,vaf_ge,'bad',bad[:5])\nprint('zygosity',zyg)\nprint('SO unique:')\nfor k,v in sorted(so.items(), key=lambda x:-x[1]): print(repr(k),v)\nprint('chip',chip)\nprint('effect',effect)\nprint('filter',filt)\nprint('mendel',mendel)\nprint('zyg_so top')\nfor k,v in sorted(zyg_so.items(), key=lambda x:-x[1]): print(k,v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
