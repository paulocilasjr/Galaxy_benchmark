{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, re\nfrom pathlib import Path\nwb=openpyxl.load_workbook('/workspace/inspect/trio.xlsx', read_only=True, data_only=True)\nws=wb.active\nrows=list(ws.iter_rows(values_only=True))\n# parse all\nfrom collections import Counter\nprint(Counter(r[1] for r in rows[1:]))\nprint(Counter(r[3] for r in rows[1:]))\nprint('carriers:')\nfor r in rows[1:]:\n if r[3]=='Carrier': print(r)\nprint('patients affected:')\nfor r in rows[1:]:\n if r[1]=='Patient': print(r)\n# file samples\nfiles=[]\nfor line in Path('/workspace/hist_datasets.tsv').read_text().splitlines():\n    parts=line.split('\\\\t')\n    name=parts[1]\n    m=re.search(r'CHIP_(.+?)\\\\.xlsx\"'$'\"',name)\n    if m: files.append(m.group(1))\nprint('num files',len(files))\n# map trio carrier sample ids\ncarrier_ids=[str(r[0]).strip().rstrip('\\\\t') for r in rows[1:] if r[3]=='Carrier']\nprint('carrier ids',carrier_ids)\nprint('files matching carriers:')\nfor cid in carrier_ids:\n    # numeric filenames can be cid-suffix\n    matches=[f for f in files if f.startswith(cid+'-') or f==cid]\n    print(cid,matches)\n# control maybe\nunaff_ids=[str(r[0]).strip().rstrip('\\\\t') for r in rows[1:] if r[3]=='Unaffected']\nprint('unaff count',len(unaff_ids))\n# missing carrier files\nallfiles=set(files)\nfor cid in carrier_ids:\n    if not any(f.startswith(cid+'-') for f in files):\n        print('no file',cid)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
