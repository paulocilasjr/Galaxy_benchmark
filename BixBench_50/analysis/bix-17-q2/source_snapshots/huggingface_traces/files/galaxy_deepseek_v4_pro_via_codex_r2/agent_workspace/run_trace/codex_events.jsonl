{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom bioblend.galaxy import GalaxyInstance\nimport json, csv\nkey=Path('/run/secrets/galaxy_api_key').read_text().strip()\ngi=GalaxyInstance('https://usegalaxy.org', key=key)\nhist='bbd44e69cb8906b5a942f3e9daa81ecb'\n# read carrier Galaxy output\nrows=[]\nwith open('/workspace/inspect/carrier_tab.tsv') as f:\n    r=csv.DictReader(f, delimiter='\\\\t')\n    for x in r: rows.append(x)\n# map\nsuffix={'Father':'PF','Mother':'PM'}\ncarrier_files=[]\nmissing=[]\nfor x in rows:\n    sid=x['Sample ID'].strip()\n    st=x['Status'].strip()\n    if st in suffix:\n        fname=f'{sid}-{suffix[st]}'\n        carrier_files.append((sid,st,fname))\n    else:\n        print('unexpected status',x)\n# find history datasets by name basename\ncont=gi.histories.show_history(hist, contents=True)\nname_to_d= {d['name'].replace('.xlsx',''): d for d in cont if d['name'].startswith('230209_Exome_GRCh38_CHIP_')}\nelements=[]; mapping={}\nfor sid,st,fname in carrier_files:\n    d=name_to_d.get(fname)\n    if not d:\n        missing.append((sid,st,fname)); continue\n    elements.append({'id':d['id'],'name':fname,'src':'hda'})\n    mapping[d['id']]=fname\nprint('missing',missing)\nprint('elements',len(elements))\ndesc={'collection_type':'list','element_identifiers':elements,'name':'carrier_exomes_xlsx'}\ncoll=gi.histories.create_dataset_collection(hist, desc, copy_elements=False)\nprint('collection_id',coll['id'],'count',coll.get('element_count'))\n# save mapping and collection id\nPath('/workspace/inspect/carrier_coll.json').write_text(json.dumps({'collection_id':coll['id'],'mapping':mapping},indent=2))\n# verify elements source ids\nprint(json.dumps(coll['elements'][:3],indent=2)[:2000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
