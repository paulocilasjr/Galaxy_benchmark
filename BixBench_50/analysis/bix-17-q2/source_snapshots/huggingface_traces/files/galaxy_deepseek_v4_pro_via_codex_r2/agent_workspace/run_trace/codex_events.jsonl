{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl\nfrom pathlib import Path\nimport re, statistics, json\n# carrier file sample labels\ncarrier_samples = ['185-PF','184-PM','285-PF','287-PM','353-PF','354-PM','556-PF','557-PM','381-PM','396-PF','397-PM','489-PF','490-PM','499-PF','500-PM','503-PF','504-PM','613-PF','614-PM']\nexclude_so = {'intron_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}\ncounts={}\nrows_all=[]\nfor sample in carrier_samples:\n p=Path('/workspace/inspect/exomes')/(sample+'.xlsx')\n wb=openpyxl.load_workbook(p, read_only=False, data_only=True); ws=wb.active\n cnt=0\n for i,row in enumerate(ws.iter_rows(values_only=True)):\n  if i<2: continue\n  z=row[4]; s=row[13]; v=row[9]\n  if z=='Reference': continue\n  if s in exclude_so: continue\n  if v is None or str(v).strip()=='': continue\n  try: fv=float(v)\n  except: continue\n  if fv<0.3:\n   cnt+=1\n   rows_all.append((sample,row[0],row[1],z,s,v,row[30]))\n counts[sample]=cnt\nprint(counts)\nprint('median',statistics.median(counts.values()))\nprint('mean',statistics.mean(counts.values()))\nprint('sum',sum(counts.values()))\nfor r in rows_all: print(r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
