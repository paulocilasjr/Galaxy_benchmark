{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl, glob\nfrom pathlib import Path\nfrom collections import Counter, defaultdict\nzyg=Counter(); so=Counter(); zyg_so=Counter(); vaf_nonnum=[]\nchip_vals=Counter(); effect=Counter(); filter_vals=Counter(); mendel=Counter()\nsamples=[]\nfor p in Path('/workspace/inspect/exomes').glob('*.xlsx'):\n    sample=p.stem\n    samples.append(sample)\n    wb=openpyxl.load_workbook(p, read_only=True, data_only=True)\n    ws=wb.active\n    for i,row in enumerate(ws.iter_rows(values_only=True)):\n        if i<2: continue\n        # row length maybe 33\n        if len(row)<33: continue\n        z=row[4]; s=row[13]; v=row[9]; ch=row[30]; eff=row[14]; filt=row[19]; me=row[5]\n        zyg[z]+=1; so[s]+=1; zyg_so[(z,s)]+=1; chip_vals[ch]+=1; effect[eff]+=1; filter_vals[filt]+=1; mendel[me]+=1\nprint('samples',len(samples))\nprint('zygosity',zyg)\nprint('\\\\nSO unique:')\nfor k,v in sorted(so.items(), key=lambda x:-x[1]): print(repr(k),v)\nprint('\\\\nchip values',chip_vals)\nprint('\\\\neffect unique')\nfor k,v in sorted(effect.items(), key=lambda x:-x[1]): print(repr(k),v)\nprint('\\\\nfilter unique')\nfor k,v in sorted(filter_vals.items(), key=lambda x:-x[1]): print(repr(k),v)\nprint('\\\\nmendel',mendel)\n# identify UTR/intergenic SO values\nfor k,v in sorted(so.items(), key=lambda x:-x[1]):\n    if k and ('UTR' in k or 'intergenic' in k or 'intron' in k or 'intragenic' in k or 'splice' in k or 'upstream' in k or 'downstream' in k):\n        print('special',repr(k),v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
