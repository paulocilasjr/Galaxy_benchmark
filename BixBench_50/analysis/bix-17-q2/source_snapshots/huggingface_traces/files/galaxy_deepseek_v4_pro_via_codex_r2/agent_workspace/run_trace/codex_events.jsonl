{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport openpyxl\nfrom pathlib import Path\nwb=openpyxl.load_workbook('/workspace/inspect/exome13.xlsx', read_only=True, data_only=True)\nws=wb.active\nprint('max_row',ws.max_row,'max_col',ws.max_column)\nfor i,row in enumerate(ws.iter_rows(values_only=True)):\n    print(i,row)\n    if i>=5: break\n# distribution of zygosity and seq ontology for all rows\nfrom collections import Counter\nzyg=Counter(); so=Counter(); vaf_bin=Counter(); chip=Counter()\nfor i,row in enumerate(ws.iter_rows(values_only=True)):\n    if i<2: continue\n    # indices: 0 ChrPos,1 RefAlt,2 primary,3 incidental,4 Zygosity,5 Mendel,6 inherited,7 DP,8 GQ,9 VAF,10 ACMG,11 Match ACMG,12 Gene Names,13 SO,14 Effect,...\n    zyg[ (row[4], str(row[13])) ]+=1\n    # vaf\n    v=row[9]\n    try:\n      fv=float(v)\n      if fv<0.3: vaf_bin['<0.3']+=1\n      else: vaf_bin['>=0.3']+=1\n    except: vaf_bin['NA']+=1\nprint('zygosity x SO top')\nfor k,c in zyg.most_common(40): print(k,c)\nprint('vaf bins',vaf_bin)\nprint('rows',ws.max_row-2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
