{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re\nfrom openpyxl import load_workbook\nds=json.load(open('/workspace/copy_datasets.json'))\nexomes=[d['name'] for d in ds if d['name'].startswith('230209_Exome')]\nwb=load_workbook('/workspace/tmp/230215_Trio_Status.xlsx', read_only=True, data_only=True)\nrows=[]\nfor i,row in enumerate(wb['Sheet1'].iter_rows(values_only=True)):\n    if i==0: continue\n    sid=str(row[0]).strip()\n    status=row[1]\n    blm=row[3]\n    rows.append((sid,status,blm))\n# map by tokens in filename\nimport re\nmissing=[]\nfor sid,status,blm in rows:\n    base=str(sid)\n    # sample id may include suffix; find any exome containing sample token\n    matches=[e for e in exomes if re.search(rf'CHIP_{re.escape(base)}[-_]', e)]\n    if not matches:\n        missing.append((sid,status,blm))\nprint('trios',len(rows),'exomes',len(exomes))\nprint('missing exome rows',missing)\ncarriers=[r for r in rows if r[2]=='Carrier']\nprint('carriers',len(carriers))\nfor r in carriers:\n    matches=[e for e in exomes if re.search(rf'CHIP_{re.escape(r[0])}[-_]', e)]\n    print(r,matches)\n# any exome not in trios\nex_tokens=[]\nfor e in exomes:\n    m=re.search(r'CHIP_([\"'^.-]+)'\"',e)\n    ex_tokens.append(m.group(1) if m else e)\nunmatched=[(e,t) for e,t in zip(exomes,ex_tokens) if not any(r[0]==t for r in rows)]\nprint('exomes unmatched to trio sample id',unmatched)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
