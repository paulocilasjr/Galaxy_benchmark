{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport openpyxl, glob, os\nfrom collections import Counter, defaultdict\nfiles=sorted(glob.glob('/workspace/inputs/CHIP_DP10_GQ20_PASS/*.xlsx'))\n# inspect all files, load normal mode maybe expensive but fine\ncnt=Counter(); colvals=defaultdict(Counter); nrows=[]\nfor f in files:\n    wb=openpyxl.load_workbook(f, read_only=False, data_only=True)\n    ws=wb.active\n    rows=list(ws.iter_rows(min_row=3, values_only=True))\n    nrows.append(len(rows))\n    for r in rows:\n        # indexes 0 based from row: 4 zygosity, 9 VAF, 12 genes,13 SO, 29 In_CHIP, 30 gene list?, 31 false?\n        cnt['rows']+=1\n        for idx,name in [(4,'zygosity'),(9,'vaf'),(12,'gene_names'),(13,'so'),(29,'in_chip'),(30,'match_gene'),(31,'match_bool')]:\n            val=r[idx] if idx<len(r) else None\n            # truncate values\n            if name in ('gene_names','so'):\n                val=str(val)[:80]\n            colvals[name][val]+=1\nprint('files',len(files),'total rows',cnt['rows'])\nprint('row counts min max sample:',min(nrows),max(nrows), Counter(nrows).most_common(10))\nfor name in ['zygosity','in_chip','match_gene','match_bool']:\n print('\\\\n',name)\n for k,v in colvals[name].most_common(30): print(repr(k),v)\nprint('\\\\nvaf sample unique/range')\nvs=[k for k,v in colvals['vaf'].items()]\nprint(len(vs), 'min',min([x for x in vs if isinstance(x,(int,float))],default=None),'max',max([x for x in vs if isinstance(x,(int,float))],default=None))\nprint('vaf types',Counter(type(k).__name__ for k in colvals['vaf']).most_common())\nprint('SO counts:')\nfor k,v in colvals['so'].most_common(30): print(repr(k),v)\nprint('gene names unique',len(colvals['gene_names']))\nprint('top genes')\nfor k,v in colvals['gene_names'].most_common(80): print(repr(k),v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
