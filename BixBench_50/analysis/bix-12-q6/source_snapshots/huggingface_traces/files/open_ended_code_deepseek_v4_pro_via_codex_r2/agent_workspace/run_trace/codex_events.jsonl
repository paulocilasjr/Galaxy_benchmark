{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef parse(path):\n seqs=[]; name=None; buf=[]\n for line in path.read_text().splitlines():\n  if line.startswith('>'):\n   if name is not None: seqs.append(''.join(buf))\n   name=line[1:]; buf=[]\n  else: buf.append(line.strip())\n if name is not None: seqs.append(''.join(buf))\n return seqs\n\ndef count_amas(seqs):\n L=max(map(len,seqs))\n arr=[s.ljust(L,'-') for s in seqs]\n ok=set('ABCDEFGHIKLMNPQRSTVWYZ')\n info=0\n for col in zip(*arr):\n  uppers=[c.upper() for c in col]\n  if any(c not in ok for c in uppers):\n   continue\n  c=Counter(uppers)\n  if sum(1 for v in c.values() if v>=2)>=2:\n   info+=1\n return info\n\ndef count_biopython_style(seqs):\n L=max(map(len,seqs))\n arr=[s.ljust(L,'-') for s in seqs]\n ok=set('ABCDEFGHIKLMNPQRSTVWYZ')\n info=0\n for col in zip(*arr):\n  u=[c.upper() for c in col if c.upper() in ok]\n  if len(u)\"'!=len(col): continue\n  c=Counter(u)\n  if sum(1 for v in c.values() if v>=2)>=2: info+=1\n return info\n\nfor group in ['\"'animals','fungi']:\n base=Path('/workspace/tmp')/f'inspect_{group}'/group\n files=sorted(base.glob('*.mafft'))\n for name,func in [('our_ignoregaps',lambda s: count_amas(s)),('amas_exclude',lambda s: count_amas(s))]: pass\n # Actually our previous ignore gaps is different\n for label in ['ignore_gaps_valid_states','exclude_any_nonAA']:\n  counts=[]\n  for f in files:\n   seqs=parse(f)\n   if label=='ignore_gaps_valid_states':\n    ok=set('ABCDEFGHIKLMNPQRSTVWYZ'); info=0; arr=[s.ljust(max(map(len,seqs)),'-') for s in seqs]\n    for col in zip(*arr):\n     c=Counter(c.upper() for c in col if c.upper() in ok)\n     if sum(1 for v in c.values() if v>=2)>=2: info+=1\n    counts.append(info)\n   else:\n    counts.append(count_amas(seqs))\n  print(group,label,'sum',sum(counts),'nonzero',sum(c>0 for c in counts),'first20',counts[:20])\n  Path(f'/workspace/tmp/{group}_{label}.txt').write_text('\\\\n'.join(map(str,counts)))\n\nfrom scipy.stats import mannwhitneyu\nfor label in ['ignore_gaps_valid_states','exclude_any_nonAA']:\n x=list(map(int,Path(f'/workspace/tmp/animals_{label}.txt').read_text().split()))\n y=list(map(int,Path(f'/workspace/tmp/fungi_{label}.txt').read_text().split()))\n print(label, mannwhitneyu(x,y,alternative='two-sided').statistic)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
