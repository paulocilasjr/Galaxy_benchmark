{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom scipy.stats import mannwhitneyu\nx=list(map(int,Path('/workspace/tmp/animals_counts.txt').read_text().split()))\ny=list(map(int,Path('/workspace/tmp/fungi_counts.txt').read_text().split()))\n# hypothetical filters\nprint('all U',mannwhitneyu(x,y).statistic)\n# non-zero only\nxx=[v for v in x if v>0]; yy=[v for v in y if v>0]\nprint('nonzero',len(xx),len(yy),mannwhitneyu(xx,yy).statistic)\n# animals with 4 taxa only: values from seq count distribution\nfrom pathlib import Path\nfrom collections import Counter\ndef parse(path):\n seqs=[]; n=None; b=[]\n for l in path.read_text().splitlines():\n  if l.startswith('>'):\n   if n is not None: seqs.append(''.join(b))\n   n=l[1:];b=[]\n  else:b.append(l.strip())\n if n is not None:seqs.append(''.join(b))\n return seqs\ndef count(seqs):\n L=max(map(len,seqs)); arr=[s.ljust(L,'-') for s in seqs]; ok=set('ABCDEFGHIKLMNPQRSTVWYZ'); info=0\n for col in zip(*arr):\n  c=Counter(v.upper() for v in col if v.upper() in ok)\n  if sum(1 for z in c.values() if z>=2)>=2:info+=1\n return info\nfor group in ['animals','fungi']:\n base=Path('/workspace/tmp')/f'inspect_{group}'/group\n vals=[]\n for f in sorted(base.glob('*.mafft')):\n  seqs=parse(f)\n  if len(seqs)>=4: vals.append(count(seqs))\n print(group,'4plus',len(vals),sum(vals),vals[:20],mannwhitneyu(vals, vals).statistic if False else '')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
