{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef parse_fasta(path):\n    seqs=[]; name=None; buf=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append(''.join(buf))\n            name=line[1:].strip(); buf=[]\n        else:\n            buf.append(line.strip())\n    if name is not None: seqs.append(''.join(buf))\n    return seqs\n\ndef count_info(seqs):\n    L=max((len(s) for s in seqs), default=0)\n    arr=[s.ljust(L,'-') for s in seqs]\n    ok=set('ABCDEFGHIKLMNPQRSTVWYZ')\n    info=0\n    for col in zip(*arr):\n        c=Counter()\n        for x in col:\n            u=x.upper()\n            if u in ok: c[u]+=1\n        states=[v for v in c.values() if v>=2]\n        if len(states)>=2:\n            info+=1\n    return info\nfor group in ['animals','fungi']:\n    base=Path('/workspace/tmp')/f'inspect_{group}'/group\n    files=sorted(base.glob('*.mafft'))\n    counts=[]\n    seqcounts=[]\n    for f in files:\n        seqs=parse_fasta(f)\n        seqcounts.append(len(seqs))\n        counts.append(count_info(seqs))\n    print(group, 'n', len(counts), 'sum', sum(counts), 'nonzero', sum(c>0 for c in counts))\n    print('seqcount distribution', Counter(seqcounts))\n    print('counts', counts)\n    Path(f'/workspace/tmp/{group}_counts.txt').write_text('\\\\n'.join(map(str,counts)))\n\ndef mwu(x,y):\n    # U for x (first), with average ranks\n    vals=sorted(set(x+y))\n    ranks={v:i+1 for i,v in enumerate(vals)}\n    rankx=sum(ranks[v] for v in x)\n    n=len(x)\n    U=rankx - n*(n+1)//2\n    # alternative U for y\n    ranky=sum(ranks[v] for v in y)\n    m=len(y)\n    U2=ranky - m*(m+1)//2\n    return U,U2, min(U,U2)\nanimals=list(map(int,Path('/workspace/tmp/animals_counts.txt').read_text().split()))\nfungi=list(map(int,Path('/workspace/tmp/fungi_counts.txt').read_text().split()))\nprint('U animals-first, fungi-second, min', mwu(animals,fungi))\n# scipy-like tied? U unchanged\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
