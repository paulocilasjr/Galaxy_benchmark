{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef parse_fasta(path):\n    seqs=[]; name=None; buf=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None:\n                seqs.append(''.join(buf).replace(' ',''))\n            name=line[1:].strip(); buf=[]\n        else:\n            buf.append(line.strip())\n    if name is not None:\n        seqs.append(''.join(buf).replace(' ',''))\n    return seqs\n\ndef count_info(seqs, gap_mode='exclude', ambiguous='exclude'):\n    if not seqs: return 0\n    L=max(len(s) for s in seqs)\n    arr=[]\n    for s in seqs:\n        arr.append(s.ljust(L,'-'))\n    # strict amino acid alphabet excluding stop/unknown; gaps '-' and '.' considered gaps\n    ok=set('ABCDEFGHIKLMNPQRSTVWYZ')\n    info=0\n    for col in zip(*arr):\n        # count valid amino acids; gap_mode exclude: ignore gap/unknown\n        counts=Counter()\n        for c in col:\n            u=c.upper()\n            if u in ok:\n                counts[u]+=1\n            elif u=='-' or u=='.' or u=='X' or u=='*':\n                pass\n            else:\n                pass\n        states=[v for v in counts.values() if v>=2]\n        if len(states)>=2:\n            info+=1\n    return info\n\nfor group in ['animals','fungi']:\n    base=Path('/workspace/tmp')/f'inspect_{group}'/group\n    files=sorted(base.glob('*.mafft'))\n    counts=[]\n    for f in files:\n        seqs=parse_fasta(f)\n        c=count_info(seqs)\n        counts.append(c)\n    print(group, 'n alignments', len(files), 'sum', sum(counts), 'minmax', min(counts), max(counts), 'zeros', sum(c==0 for c in counts))\n    print('first 20', counts[:20])\n    Path(f'/workspace/tmp/{group}_counts.txt').write_text('\\\\n'.join(map(str,counts)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
