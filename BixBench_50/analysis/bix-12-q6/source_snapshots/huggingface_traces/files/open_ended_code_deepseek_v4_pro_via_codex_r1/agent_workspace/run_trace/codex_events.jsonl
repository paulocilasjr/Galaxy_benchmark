{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport scipy.stats as st\n\ndef parse(path):\n    seqs=[]; name=None; chars=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append((name,''.join(chars)))\n            name=line[1:].strip(); chars=[]\n        else:\n            chars.append(line.strip())\n    if name is not None: seqs.append((name,''.join(chars)))\n    return seqs\n\ndef pis(seqs, gap='-'):\n    n=len(seqs)\n    if n<2: return 0\n    L=len(seqs[0])\n    for _,s in seqs:\n        if len(s)\"'!=L:\n            print('\"'unequal',len(s),L)\n    c=0\n    for j in range(L):\n        chars=[s[j] for _,s in seqs if s[j]\"'!=gap]\n        if len(chars)<4: continue\n        counts=Counter(chars)\n        if len(counts)>=2 and sum(v>=2 for v in counts.values())>=2:\n            c+=1\n    return c\n\nfor scope in ['\"'all','common','mafft']:\n    pass\nfor group in ['animals','fungi']:\n    files=sorted(Path('/workspace/tmp',group).glob('*.mafft'))\n    vals=[]\n    for f in files:\n        vals.append((f.name,pis(parse(f))))\n    Path('/workspace/tmp',f'{group}_pis.tsv').write_text('\\\\n'.join(f'{a}\\\\t{b}' for a,b in vals)+'\\\\n')\n    print(group, len(vals), 'mean', sum(b for a,b in vals)/len(vals), 'minmax', min(b for a,b in vals), max(b for a,b in vals), 'zeros', sum(b==0 for a,b in vals))\n\nan={a:b for a,b in (l.split('\\\\t') for l in Path('/workspace/tmp/animals_pis.tsv').read_text().splitlines())}\nfu={a:b for a,b in (l.split('\\\\t') for l in Path('/workspace/tmp/fungi_pis.tsv').read_text().splitlines())}\ncommon=sorted(set(an)&set(fu))\nprint('common n',len(common))\nfor label, x,y in [\n    ('all animal vs all fungi', [int(an[k]) for k in an], [int(fu[k]) for k in fu]),\n    ('common animal vs common fungi', [int(an[k]) for k in common], [int(fu[k]) for k in common]),\n]:\n    r=st.mannwhitneyu(x,y,alternative='two-sided')\n    print(label, r)\n    print('sum ranks x',sum(st.rankdata(x+y)[:len(x)]), 'U', len(x)*len(y)+len(x)*(len(x)+1)/2-sum(st.rankdata(x+y)[:len(x)]))\n    # also alternative greater? \n    for alt in ['two-sided','less','greater']:\n        print(alt, st.mannwhitneyu(x,y,alternative=alt).statistic)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
