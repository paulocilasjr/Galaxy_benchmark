{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport json\n\ndef parse(path):\n    seqs=[]; name=None; chars=[]\n    for line in path.read_text().splitlines():\n        if line.startswith('>'):\n            if name is not None: seqs.append((name,''.join(chars)))\n            name=line[1:].strip(); chars=[]\n        else:\n            chars.append(line.strip())\n    if name is not None: seqs.append((name,''.join(chars)))\n    return seqs\n\ndef count_pis(path, exclude=set('-?X*.x')):\n    seqs=parse(path)\n    if len(seqs)<4:\n        return 0, len(seqs)\n    L=len(seqs[0][1])\n    # ensure equal lengths\n    assert all(len(s)==L for _,s in seqs)\n    pis=0\n    for i in range(L):\n        col=[s[i].upper() for _,s in seqs if s[i].upper() not in exclude]\n        if len(col)<4:\n            continue\n        cnt=Counter(col)\n        if sum(1 for v in cnt.values() if v>=2)>=2:\n            pis+=1\n    return pis, len(seqs)\n\ndef ranks(vals):\n    order=sorted(range(len(vals)), key=lambda i:(vals[i],i))\n    r=[0.0]*len(vals); i=0\n    while i<len(order):\n        j=i\n        while j+1<len(order) and vals[order[j+1]]==vals[order[i]]:\n            j+=1\n        avg=(i+j)/2+1\n        for k in range(i,j+1): r[order[k]]=avg\n        i=j+1\n    return r\nfor group in ['animals','fungi']:\n    files=sorted(Path('/workspace/tmp',group).glob('*.mafft'))\n    vals={}\n    dist=[]\n    for f in files:\n        pi,n=count_pis(f)\n        vals[f.name]=pi\n        dist.append(n)\n    Path('/workspace/tmp',f'{group}_raw_pis.json').write_text(json.dumps(vals,sort_keys=True))\n    arr=list(vals.values())\n    print(group,'files',len(arr),'sum',sum(arr),'mean',sum(arr)/len(arr),'minmax',min(arr),max(arr),'zeros',sum(v==0 for v in arr))\n    from collections import Counter as C\n    print('taxa dist',C(dist))\n    print('quantiles', sorted(arr)[0], sorted(arr)[len(arr)//4], sorted(arr)[len(arr)//2], sorted(arr)[3*len(arr)//4], sorted(arr)[-1])\nan=json.loads(Path('/workspace/tmp/animals_raw_pis.json').read_text())\nfu=json.loads(Path('/workspace/tmp/fungi_raw_pis.json').read_text())\n# preserve sorted file order by name from all groups\nanimal_keys=sorted(an)\nfungi_keys=sorted(fu)\nx=[an[k] for k in animal_keys]\ny=[fu[k] for k in fungi_keys]\nr=ranks(x+y); n=len(x); R=sum(r[:n]); U=n*len(y)+n*(n+1)/2-R\nprint('n1',n,'n2',len(y),'R1',R,'U1',U,'U2',n*len(y)-U)\n# scipy if available? no. install? not needed.\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
