{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"cd /workspace/tmp/scogs.ktaXc8 && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport scipy.stats as st\n\ndef read_align(path):\n    seqs=[]\n    cur=[]\n    name=None\n    for line in open(path):\n        line=line.rstrip('\\\\n')\n        if line.startswith('>'):\n            if name is not None:\n                seqs.append(''.join(cur))\n            name=line[1:]\n            cur=[]\n        else:\n            cur.append(line.strip())\n    if name is not None: seqs.append(''.join(cur))\n    return seqs\n\ndef pic(seqs, ignore_gaps=True):\n    L=min(map(len,seqs)) if seqs else 0\n    if L==0: return 0\n    count=0\n    for col in zip(*seqs):\n        counts=Counter(c for c in col if not (ignore_gaps and c in '-?.'))\n        # parsimony informative: at least two distinct chars each count >=2\n        if sum(v>=2 for v in counts.values()) >=2:\n            count+=1\n    return count\n\nfor group in ['animals','fungi']:\n    arr=[]\n    for f in sorted(Path(group).glob('*.mafft')):\n        seqs=read_align(f)\n        arr.append(pic(seqs))\n    print(group, len(arr), sum(arr), min(arr), max(arr))\n    if group=='animals': A=arr\n    else: F=arr\nres=st.mannwhitneyu(A,F,alternative='two-sided')\nprint('U',res.statistic,'p',res.pvalue)\nprint('n1 n2', len(A),len(F))\nprint('sum ranks animals', sum(st.rankdata(A+F)[:len(A)]), 'U manual', sum(st.rankdata(A+F)[:len(A)])-len(A)*(len(A)+1)//2)\nprint(st.mannwhitneyu(A,F,alternative='less').statistic, st.mannwhitneyu(A,F,alternative='greater').statistic)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
