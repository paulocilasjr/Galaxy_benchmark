{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"cd /workspace/tmp/scogs.ktaXc8 && python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\n\ndef read_align(path):\n    seqs=[]; cur=[]; name=None\n    for line in open(path):\n        line=line.rstrip('\\\\n')\n        if line.startswith('>'):\n            if name is not None: seqs.append(''.join(cur))\n            name=line[1:]; cur=[]\n        else: cur.append(line.strip())\n    if name is not None: seqs.append(''.join(cur))\n    return seqs\n\ndef pic(seqs, mode):\n    cols=zip(*seqs)\n    n=0\n    for col in cols:\n        if mode=='all':\n            c=Counter(col)\n        elif mode=='no_gap':\n            c=Counter(x for x in col if x\"'!='\"'-')\n        elif mode=='no_gap_x':\n            c=Counter(x for x in col if x not in '-Xx')\n        elif mode=='no_gap_q':\n            c=Counter(x for x in col if x not in '-?')\n        if sum(v>=2 for v in c.values())>=2: n+=1\n    return n\n\ndef mw(A,B):\n    vals=A+B\n    pairs=sorted((v,i) for i,v in enumerate(vals))\n    ranks=[0]*len(vals); i=0\n    while i<len(pairs):\n        j=i\n        while j+1<len(pairs) and pairs[j+1][0]==pairs[i][0]: j+=1\n        r=(i+1+j+1)/2\n        for k in range(i,j+1): ranks[pairs[k][1]]=r\n        i=j+1\n    return sum(ranks[:len(A)])-len(A)*(len(A)+1)/2\narrs={g:[] for g in ['animals','fungi']}\nfor g in arrs:\n    for f in sorted(Path(g).glob('*.mafft')):\n        arrs[g].append(read_align(f))\nfor mode in ['all','no_gap','no_gap_x','no_gap_q']:\n    A=[pic(s,mode) for s in arrs['animals']]\n    F=[pic(s,mode) for s in arrs['fungi']]\n    print(mode,sum(A),sum(F),mw(A,F))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
