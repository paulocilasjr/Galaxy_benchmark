{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy.stats import pearsonr\nmeta=pd.read_csv('inputs/GeneMetaInfo_Zenodo.csv').set_index('Unnamed: 0')\nann=pd.read_csv('inputs/Sample_annotated_Zenodo.csv')\ncounts=pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv').set_index('Unnamed: 0')\npc=meta.index[meta.gene_biotype.eq('protein_coding')]\nlength=meta.loc[pc,'Length'].astype(float)\nfor ct in ['CD4','CD8','CD14','CD19']:\n cols=ann.loc[ann.celltype.eq(ct),'sample']\n avg=counts.loc[pc, cols].mean(axis=1)\n r=pearsonr(length, avg).statistic\n print(ct, f'{r:.12f}', f'{abs(r):.12f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
