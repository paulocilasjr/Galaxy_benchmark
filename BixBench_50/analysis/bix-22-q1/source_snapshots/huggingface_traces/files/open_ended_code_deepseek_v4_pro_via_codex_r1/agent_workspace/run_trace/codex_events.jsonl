{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy.stats import pearsonr\n\nmeta=pd.read_csv('inputs/GeneMetaInfo_Zenodo.csv')\nann=pd.read_csv('inputs/Sample_annotated_Zenodo.csv')\ncounts=pd.read_csv('inputs/BatchCorrectedReadCounts_Zenodo.csv')\nprint('counts shape', counts.shape)\nprint('first col name', counts.columns[0])\n# align\ncounts=counts.set_index(counts.columns[0])\nprint('index name', counts.index.name, 'nunique', counts.index.nunique())\nmeta=meta.set_index(meta.columns[0])\nmeta.index.name='gene'\nprint('meta index', meta.index[:3])\n# keep protein coding only\npc=meta.index[meta['gene_biotype']=='protein_coding']\nprint('pc count', len(pc))\nX=counts.loc[pc]\nprint('X shape', X.shape)\n# ann mapping\ncelltypes=['CD4','CD8','CD14','CD19']\nsamples_by={ct: ann.loc[ann.celltype==ct,'sample'].tolist() for ct in celltypes}\nfor ct in celltypes:\n print(ct, len(samples_by[ct]), 'all in X', set(samples_by[ct])<=set(X.columns))\nfor ct in celltypes:\n cols=samples_by[ct]\n mean = X[cols].mean(axis=1).astype(float)\n length=meta.loc[mean.index,'Length'].astype(float)\n for variant, y in [\n  ('mean_raw', mean),\n  ('log1p_mean', np.log1p(mean)),\n  ('mean_log1p', X[cols].apply(lambda s: np.log1p(s)).mean(axis=1)),\n  ('log2_mean+1', np.log2(mean+1)),\n ]:\n  mask=np.isfinite(y) & np.isfinite(length)\n  r,p=pearsonr(length[mask], y[mask])\n  print(f'{ct:4} {variant:15} r={r:.8f} p={p:.3g} n={mask.sum()}')\nprint('\\\\nValue stats by type raw means')\nfor ct in celltypes:\n cols=samples_by[ct]; mean=X[cols].mean(axis=1)\n print(ct, 'min', mean.min(), 'median', mean.median(), 'mean', mean.mean(), 'max', mean.max(), 'zeros', (mean==0).sum())\nprint('\\\\nLength stats', meta.loc[pc,'Length'].astype(float).describe())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
