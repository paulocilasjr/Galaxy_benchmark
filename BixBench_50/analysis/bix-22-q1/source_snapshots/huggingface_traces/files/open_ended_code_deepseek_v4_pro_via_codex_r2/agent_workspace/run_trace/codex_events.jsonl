{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport pandas as pd, numpy as np, time\nstart=time.time()\ncounts=pd.read_csv('/workspace/inputs/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)\nprint('counts', counts.shape, 'load time', time.time()-start)\nmeta=pd.read_csv('/workspace/inputs/GeneMetaInfo_Zenodo.csv', index_col=0)\nsamp=pd.read_csv('/workspace/inputs/Sample_annotated_Zenodo.csv')\n# align meta order maybe count index same\nprint('index equal?', counts.index.equals(meta.index))\n# protein coding simple exact\npc = meta['gene_biotype']=='protein_coding'\nprint('pc', pc.sum())\n# ensure in counts\npc_idx = meta.index[pc]\nprint('all pc in counts?', pc_idx.isin(counts.index).sum(), len(pc_idx))\n# cell columns\nct_order=['CD4','CD8','CD14','CD19']\nfor ct in ct_order:\n    cols=samp.loc[samp['celltype']==ct,'sample'].tolist()\n    # all cols exist\n    sub=counts.loc[pc_idx, cols]\n    print(ct, 'cols', len(cols), 'genes', sub.shape[0], 'zero frac', (sub==0).mean().mean())\n    avg=sub.mean(axis=1)\n    length=meta.loc[pc_idx,'Length']\n    r=np.corrcoef(length, avg)[0,1]\n    rlog=np.corrcoef(length, np.log2(avg+1))[0,1]\n    rlog10=np.corrcoef(length, np.log10(avg+1))[0,1]\n    # spearman raw\n    from scipy.stats import pearsonr, spearmanr\n    print('raw pearson', pearsonr(length, avg)[0], 'abs', abs(pearsonr(length, avg)[0]), 'log2', pearsonr(length,np.log2(avg+1))[0], 'spearman raw', spearmanr(length,avg)[0])\nprint('done', time.time()-start)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
