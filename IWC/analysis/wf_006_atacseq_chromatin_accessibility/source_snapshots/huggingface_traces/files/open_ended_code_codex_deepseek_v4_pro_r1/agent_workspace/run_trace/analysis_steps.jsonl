{"stage":"bowtie_paired_end_alignment","status":"success","successful_chain":true,"tool_or_command":"bowtie -q --phred33-quals -p 8 -X 2000 -I 0 --fr --no-unal --sam --chunkmbs 1024 --best -x reference/bowtie_hg19/bowtie/hg19 -1 /tmp/trimmed_R1.fastq -2 /tmp/trimmed_R2.fastq | samtools view -bS -o work/bowtie1.raw.bam -","effective_parameters":{"quality":"phred33","threads":8,"max_insert":2000,"min_insert":0,"orientation":"fr","chunkmbs":1024,"best":true},"inputs":["/tmp/trimmed_R1.fastq","/tmp/trimmed_R2.fastq","reference/bowtie_hg19/bowtie/hg19"],"outputs":["work/bowtie1.raw.bam","work/bowtie1_align.log"],"validation":"Bowtie exit 0; 47,598,470 paired-end alignments reported from 55,850,171 input pairs"}
{"stage":"alignment_filter_and_coordinate_sort","status":"success","successful_chain":true,"tool_or_command":"samtools view -u -f 0x2 -F 0x100 -F 0x800 -q 30 -e 'rname!=\"chrM\"' work/bowtie1.raw.bam | samtools sort -@ 4 -m 1G -o work/filtered.sorted.bam -","effective_parameters":{"required_flags":"0x2","filter_flags":"0x100,0x800","min_mapq":30,"exclude_rname":"chrM","sort_threads":4,"sort_memory":"1G"},"inputs":["work/bowtie1.raw.bam"],"outputs":["work/filtered.sorted.bam"],"validation":"samtools exit 0; 38,636,172 filtered alignments"}
{"stage":"pcr_duplicate_removal","status":"success","successful_chain":true,"tool_or_command":"samtools sort -n -@ 4 -m 1G -o work/filtered.namesorted.bam work/filtered.sorted.bam && samtools fixmate -m -u work/filtered.namesorted.bam - | samtools sort -@ 4 -m 1G -o work/fixmate.sorted.bam - && samtools markdup -r -s -@ 8 work/fixmate.sorted.bam work/dedup.bam","effective_parameters":{"sort_threads":4,"sort_memory":"1G","markdup_threads":8,"markdup_remove":true},"inputs":["work/filtered.sorted.bam"],"outputs":["work/filtered.namesorted.bam","work/fixmate.sorted.bam","work/dedup.bam","work/markdup.stats.txt","work/dedup.bam.bai"],"validation":"markdup removed 13,648,680 duplicate pairs; 24,987,492 final alignments"}
