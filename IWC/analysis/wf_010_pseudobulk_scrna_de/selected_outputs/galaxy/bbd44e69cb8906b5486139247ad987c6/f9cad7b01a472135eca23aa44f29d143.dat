   "source": [
    "from galaxy_ie_helpers import get\n",
    "import subprocess\n",
    "p=get(28)\n",
    "print('path',p)\n",
    "code = \"\"\"\n",
    "x <- tryCatch(read.table('/import/28', sep='\\\\t', header=TRUE, stringsAsFactors=FALSE), error=function(e) e)\n",
    "print(class(x))\n",
    "if (inherits(x, 'error')) {cat('ERROR:', conditionMessage(x), '\\\\n')} else {print(dim(x)); print(head(x))}\n",
    "\"\"\"\n",
    "r=subprocess.run(['Rscript','-e',code],text=True,capture_output=True)\n",
    "print('rc',r.returncode)\n",
    "print('STDOUT')\n",
    "print(r.stdout)\n",
    "print('STDERR')\n",
    "print(r.stderr)"
   ]
  }
 ],
