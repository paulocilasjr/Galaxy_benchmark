   "source": [
    "from galaxy_ie_helpers import get\n",
    "p=get(28)\n",
    "with open(p,'r') as f:\n",
    "    lines=f.read().splitlines()\n",
    "print('nlines',len(lines))\n",
    "for i,line in enumerate(lines):\n",
    "    n=len(line.split('\\t'))\n",
    "    if n != 3 or i<5 or i>len(lines)-5:\n",
    "        print(i+1,n,repr(line))"
   ]
  }
 ],
