    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "n_obs 4903 n_vars 19090\n",
      "individual categories ['Control #1', 'Control #2', 'Control #3', 'SARS-CoV2 pos Mild', 'SARS-CoV2 pos Severe #1', 'SARS-CoV2 pos Severe #2', 'SARS-CoV2 pos Severe #3']\n",
      "disease categories ['COVID-19', 'normal']\n",
      "cell type categories ['B cell', 'T cell', 'erythroid lineage cell', 'monocyte', 'neutrophil', 'platelet']\n"
     ]
    }
   ],
   "source": [
    "def decode_obj(a):\n",
    "    return [x.decode('utf-8') if isinstance(x, bytes) else str(x) for x in a]\n",
    "\n",
    "with h5py.File(h5_path, 'r') as f:\n",
    "    n_obs = f['layers/counts/indptr'].shape[0] - 1\n",
    "    n_vars = f['layers/counts/indices'].shape[0] if False else None\n",
    "    # Read categories and codes\n",
    "    def read_cat(name):\n",
    "        cats = decode_obj(f[f'obs/{name}/categories'][:])\n",
    "        codes = f[f'obs/{name}/codes'][:]\n",
    "        vals = np.array(cats, dtype=object)[codes]\n",
    "        return cats, vals\n",
    "    individual_cats, individual = read_cat('individual')\n",
    "    disease_cats, disease = read_cat('disease')\n",
    "    cell_type_cats, cell_type = read_cat('cell_type')\n",
    "    gene_symbols = decode_obj(f['var/gene_symbol'][:])\n",
    "    data = f['layers/counts/data'][:]\n",
    "    indices = f['layers/counts/indices'][:]\n",
    "    indptr = f['layers/counts/indptr'][:]\n",
    "\n",
    "print('n_obs', n_obs, 'n_vars', len(gene_symbols))\n",
    "print('individual categories', individual_cats)\n",
    "print('disease categories', disease_cats)\n",
    "print('cell type categories', cell_type_cats)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f406c504",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:24:02.174892Z",
     "iopub.status.busy": "2026-08-28T23:24:02.174721Z",
     "iopub.status.idle": "2026-08-28T23:24:02.178554Z",
     "shell.execute_reply": "2026-08-28T23:24:02.178012Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "counts matrix (4903, 19090) 10062946\n"
     ]
    }
   ],
   "source": [
    "C = csr_matrix((data, indices, indptr), shape=(len(individual), len(gene_symbols)))\n",
    "print('counts matrix', C.shape, C.nnz)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "bc73135c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:24:02.180130Z",
     "iopub.status.busy": "2026-08-28T23:24:02.179968Z",
     "iopub.status.idle": "2026-08-28T23:24:02.187350Z",
     "shell.execute_reply": "2026-08-28T23:24:02.186846Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "total individual-cell-type combinations 39\n",
      "retained 34\n",
      "dropped 5\n",
      "drop Control #1|||erythroid lineage cell 2\n",
      "drop Control #2|||platelet 4\n",
      "drop SARS-CoV2 pos Mild|||platelet 7\n",
      "drop SARS-CoV2 pos Severe #3|||monocyte 5\n",
      "drop SARS-CoV2 pos Severe #3|||platelet 1\n"
     ]
    }
   ],
   "source": [
    "def sanitize(s):\n",
    "    return s.replace(' ', '_').replace('-', '_')\n",
    "\n",
    "keys = np.array([f'{a}|||{b}' for a, b in zip(individual, cell_type)], dtype=object)\n",
    "uniq_keys, group_idx = np.unique(keys, return_inverse=True)\n",
    "cell_counts = np.bincount(group_idx)\n",
    "keep = cell_counts >= 10\n",
    "keep_rows = np.where(keep)[0]\n",
    "print('total individual-cell-type combinations', len(uniq_keys))\n",
    "print('retained', int(keep.sum()))\n",
    "print('dropped', int((~keep).sum()))\n",
    "for i in np.where(~keep)[0]:\n",
    "    print('drop', uniq_keys[i], int(cell_counts[i]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "20142941",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:24:02.188864Z",
     "iopub.status.busy": "2026-08-28T23:24:02.188700Z",
     "iopub.status.idle": "2026-08-28T23:24:02.245057Z",
     "shell.execute_reply": "2026-08-28T23:24:02.244435Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pseudobulk matrix (34, 19090)\n"
     ]
    }
   ],
   "source": [
    "G = csr_matrix((np.ones(len(group_idx), dtype=np.float64), (group_idx, np.arange(len(group_idx)))),\n",
    "               shape=(len(uniq_keys), len(individual)))\n",
    "P = (G[keep_rows, :] @ C).toarray().astype(np.int64)\n",
    "print('pseudobulk matrix', P.shape)"
   ]
  },
