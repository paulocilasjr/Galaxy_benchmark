     ]
    }
   ],
   "source": [
    "h5_path = get(1)\n",
    "print('downloaded', h5_path, os.path.getsize(h5_path))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e6511d8c",
   "metadata": {
    "execution": {
