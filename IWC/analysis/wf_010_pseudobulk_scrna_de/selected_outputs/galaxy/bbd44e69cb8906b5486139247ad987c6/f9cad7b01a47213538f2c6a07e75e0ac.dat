     ]
    }
   ],
   "source": [
    "sample_meta = []\n",
    "for row_i, key_i in enumerate(keep_rows):\n",
    "    key = uniq_keys[key_i]\n",
    "    ind_raw, ct_raw = key.split('|||')\n",
    "    mask = keys == key\n",
    "    dis = disease[mask][0]\n",
    "    sample_meta.append({\n",
    "        'sample': f'{sanitize(ind_raw)}_{sanitize(ct_raw)}',\n",
    "        'individual': ind_raw,\n",
    "        'cell_type': ct_raw,\n",
    "        'cell_type_sanitized': sanitize(ct_raw),\n",
    "        'disease': dis\n",
    "    })\n",
    "meta = pd.DataFrame(sample_meta)\n",
    "print(meta.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "9c7d2cb5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:24:02.259651Z",
     "iopub.status.busy": "2026-08-28T23:24:02.259481Z",
     "iopub.status.idle": "2026-08-28T23:24:02.268191Z",
     "shell.execute_reply": "2026-08-28T23:24:02.267693Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "N 34 M 556360.0 S 27\n",
      "threshold cpm 17.97397368610252 genes pass cpm 1438 pass sum 4423 kept genes 1429\n"
     ]
    }
   ],
   "source": [
    "totals = P.sum(axis=1)\n",
    "N = int(P.shape[0])\n",
    "M = float(np.median(totals))\n",
    "S = int(math.ceil(10 + 0.7 * (N - 10)))\n",
    "print('N', N, 'M', M, 'S', S)\n",
    "cpm = (P.astype(np.float64) / totals[:, None]) * 1_000_000.0\n",
    "thr = (10.0 / M) * 1_000_000.0\n",
    "pass_cpm = (cpm >= thr).sum(axis=0) >= S\n",
    "sum_counts = P.sum(axis=0)\n",
    "pass_sum = sum_counts >= 1000\n",
    "keep_genes = np.where(pass_cpm & pass_sum)[0]\n",
    "print('threshold cpm', thr, 'genes pass cpm', int(pass_cpm.sum()), 'pass sum', int(pass_sum.sum()), 'kept genes', len(keep_genes))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "63654a19",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:24:02.269734Z",
