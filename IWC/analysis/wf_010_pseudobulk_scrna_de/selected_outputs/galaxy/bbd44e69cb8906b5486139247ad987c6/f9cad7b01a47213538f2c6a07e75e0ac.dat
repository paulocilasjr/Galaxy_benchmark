   "source": [
    "import sys, os, subprocess, math\n",
    "print('starting pseudobulk notebook')\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '--quiet', 'h5py'], check=False)\n",
    "import h5py\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.sparse import csr_matrix\n",
    "from galaxy_ie_helpers import get, put\n",
    "print('imports ok')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
