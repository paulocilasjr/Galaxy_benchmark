   ],
   "source": [
    "os.makedirs('deseq_counts', exist_ok=True)\n",
    "count_files = []\n",
    "for j, sample_id in enumerate(meta['sample']):\n",
    "    fn = f'deseq_counts/{j}_{sample_id}.tsv'\n",
    "    df = pd.DataFrame({'gene': gene_col, sample_id: P[:, keep_genes][j, :]})\n",
    "    df.to_csv(fn, sep='\\t', index=False)\n",
    "    count_files.append(fn)\n",
    "\n",
    "sample_sheet = meta[['sample', 'disease', 'cell_type_sanitized']].rename(columns={'cell_type_sanitized': 'cell_type'})\n",
    "sample_sheet.to_csv('sample_sheet.tsv', sep='\\t', index=False)\n",
    "print('wrote', len(count_files), 'sample count files and sample_sheet.tsv')\n",
    "print(sample_sheet.to_string())"
   ]
