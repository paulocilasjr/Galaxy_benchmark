     "shell.execute_reply": "2026-08-28T23:24:02.286693Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "wrote pseudobulk_counts.tsv (1429, 35)\n"
     ]
    }
   ],
   "source": [
    "gene_col = np.array([gene_symbols[i] for i in keep_genes], dtype=object)\n",
    "# Build final matrix with gene as first column\n",
    "final_counts = pd.DataFrame(P[:, keep_genes].T, columns=meta['sample'].tolist())\n",
    "final_counts.insert(0, 'gene', gene_col)\n",
    "final_counts.to_csv('pseudobulk_counts.tsv', sep='\\t', index=False)\n",
    "print('wrote pseudobulk_counts.tsv', final_counts.shape)"
   ]
  },
