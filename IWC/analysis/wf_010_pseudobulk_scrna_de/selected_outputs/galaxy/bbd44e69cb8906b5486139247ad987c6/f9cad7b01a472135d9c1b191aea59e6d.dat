     "text": [
      "safe sample sheet rows 34\n",
      "                  sample disease   cell_type\n",
      "0      Control__1_B_cell  normal      B_cell\n",
      "1      Control__1_T_cell  normal      T_cell\n",
      "2    Control__1_monocyte  normal    monocyte\n",
      "3  Control__1_neutrophil  normal  neutrophil\n",
      "4    Control__1_platelet  normal    platelet\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "wrote safe count files 34\n"
     ]
    }
   ],
   "source": [
    "from galaxy_ie_helpers import get, put\n",
    "import pandas as pd, os\n",
    "\n",
    "sheet_path = get(28)\n",
    "sheet = pd.read_csv(sheet_path, sep='\\t')\n",
    "sheet['sample'] = sheet['sample'].str.replace('#', '_', regex=False)\n",
    "sheet.to_csv('sample_sheet_safe.tsv', sep='\\t', index=False)\n",
    "print('safe sample sheet rows', len(sheet))\n",
    "print(sheet.head())\n",
    "\n",
    "os.makedirs('safe_counts', exist_ok=True)\n",
    "out_files = []\n",
    "for hid in range(29, 63):\n",
    "    path = get(hid)\n",
    "    df = pd.read_csv(path, sep='\\t')\n",
    "    old_col = str(df.columns[1])\n",
    "    new_col = old_col.replace('#', '_')\n",
    "    df.columns = [str(df.columns[0]), new_col]\n",
    "    out = f'safe_counts/{hid}_{new_col}.tsv'\n",
    "    df.to_csv(out, sep='\\t', index=False)\n",
    "    out_files.append(out)\n",
    "print('wrote safe count files', len(out_files))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b5892a54",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-28T23:37:33.245524Z",
