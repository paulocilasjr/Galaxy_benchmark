     "iopub.status.idle": "2026-08-28T23:39:47.411703Z",
     "shell.execute_reply": "2026-08-28T23:39:47.411099Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "uploaded safe sample sheet and count files\n"
     ]
    }
   ],
   "source": [
    "put('sample_sheet_safe.tsv', file_type='tabular')\n",
    "put(out_files, file_type='tabular')\n",
    "print('uploaded safe sample sheet and count files')"
   ]
  },
