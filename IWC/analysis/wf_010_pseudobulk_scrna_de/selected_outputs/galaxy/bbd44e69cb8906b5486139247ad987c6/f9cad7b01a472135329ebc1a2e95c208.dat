   "source": [
    "if get is not None:\n",
    "    path = get(1)\n",
    "    print('downloaded', path, os.path.getsize(path) if os.path.exists(path) else 'missing')\n",
    "    try:\n",
    "        import anndata as ad\n",
    "        adata = ad.read_h5ad(path)\n",
    "        print('adata', adata.shape)\n",
    "        print('obs cols', list(adata.obs.columns))\n",
    "        print('var cols', list(adata.var.columns))\n",
    "        print('layers', list(adata.layers.keys()))\n",
    "        print('obs head')\n",
    "        print(adata.obs.head().to_string())\n",
    "    except Exception as e:\n",
    "        print('anndata read failed:', repr(e))"
   ]
  }
