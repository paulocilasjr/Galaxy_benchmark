   "source": [
    "mods = ['anndata','scanpy','h5py','numpy','pandas','scipy','statsmodels','rpy2']\n",
    "for m in mods:\n",
    "    try:\n",
    "        __import__(m)\n",
    "        print(m, 'OK')\n",
    "    except Exception as e:\n",
    "        print(m, 'MISSING', repr(e))"
   ]
  },
