   "source": [
    "import os, h5py, numpy as np\n",
    "src_path = GALAXY_INPUTS['source'][0]['path']\n",
    "print('path', src_path)\n",
    "with h5py.File(src_path, 'r') as f:\n",
    "    print('root_keys', list(f.keys()))\n",
    "    def show(name, obj):\n",
    "        if name.count('/') <= 2:\n",
    "            print('NODE', name, type(obj).__name__, dict(obj.attrs))\n",
    "    f.visititems(show)\n",
    "    for name in ['obs','var','layers','X']:\n",
    "        if name in f:\n",
    "            obj=f[name]\n",
    "            print('TOP',name,type(obj).__name__, list(obj.keys())[:20] if hasattr(obj,'keys') else obj.shape)\n"
   ]
  }
 ],
