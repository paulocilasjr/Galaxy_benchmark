   ],
   "source": [
    "import os, re, json, csv\n",
    "import pandas as pd\n",
    "meta_path = GALAXY_INPUTS['meta'][0]['path']\n",
    "meta = pd.read_csv(meta_path, sep='\\t', index_col=0)\n",
    "meta.index = [re.sub(r'[ \\-]', '_', str(x)) for x in meta.index.astype(str)]\n",
    "if not {'disease', 'cell_type'}.issubset(meta.columns):\n",
    "    raise ValueError('Required metadata columns missing')\n",
    "sheet = meta.reset_index().rename(columns={'index': 'sample'})\n",
    "sheet = sheet[['sample', 'disease', 'cell_type']]\n",
    "if sheet['sample'].duplicated().any():\n",
    "    raise ValueError('Duplicate sample identifiers')\n",
    "sheet.to_csv('outputs/sample_sheet.tsv', sep='\\t', index=False, lineterminator='\\n', quoting=csv.QUOTE_ALL)\n",
    "print(json.dumps({'n_samples': int(sheet.shape[0]), 'columns': list(sheet.columns), 'samples': sheet['sample'].tolist()}))\n"
   ]
  }
 ],
