      "{\"n_samples\": 34, \"columns\": [\"sample\", \"disease\", \"cell_type\"], \"samples\": [\"Control_#1_B_cell\", \"Control_#2_B_cell\", \"Control_#3_B_cell\", \"SARS_CoV2_pos_Mild_B_cell\", \"SARS_CoV2_pos_Severe_#1_B_cell\", \"SARS_CoV2_pos_Severe_#2_B_cell\", \"SARS_CoV2_pos_Severe_#3_B_cell\", \"Control_#1_T_cell\", \"Control_#2_T_cell\", \"Control_#3_T_cell\", \"SARS_CoV2_pos_Mild_T_cell\", \"SARS_CoV2_pos_Severe_#1_T_cell\", \"SARS_CoV2_pos_Severe_#2_T_cell\", \"SARS_CoV2_pos_Severe_#3_T_cell\", \"Control_#3_erythroid_lineage_cell\", \"SARS_CoV2_pos_Mild_erythroid_lineage_cell\", \"SARS_CoV2_pos_Severe_#1_erythroid_lineage_cell\", \"SARS_CoV2_pos_Severe_#2_erythroid_lineage_cell\", \"Control_#1_monocyte\", \"Control_#2_monocyte\", \"Control_#3_monocyte\", \"SARS_CoV2_pos_Mild_monocyte\", \"SARS_CoV2_pos_Severe_#1_monocyte\", \"SARS_CoV2_pos_Severe_#2_monocyte\", \"Control_#1_neutrophil\", \"Control_#2_neutrophil\", \"Control_#3_neutrophil\", \"SARS_CoV2_pos_Mild_neutrophil\", \"SARS_CoV2_pos_Severe_#1_neutrophil\", \"SARS_CoV2_pos_Severe_#2_neutrophil\", \"Control_#1_platelet\", \"Control_#3_platelet\", \"SARS_CoV2_pos_Severe_#1_platelet\", \"SARS_CoV2_pos_Severe_#2_platelet\"]}\n"
     ]
