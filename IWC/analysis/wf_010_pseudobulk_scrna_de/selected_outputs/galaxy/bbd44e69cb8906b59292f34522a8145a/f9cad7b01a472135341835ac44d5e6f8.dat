   "source": [
    "import os, json, numpy as np, pandas as pd\n",
    "import anndata as ad\n",
    "src_path = GALAXY_INPUTS['source'][0]['path']\n",
    "adata = ad.read_h5ad(src_path)\n",
    "print('shape', adata.shape)\n",
    "print('obs_columns', list(adata.obs.columns))\n",
    "print('var_columns', list(adata.var.columns))\n",
    "print('var_name_head', [str(x) for x in adata.var_names[:10]])\n",
    "for col in ['individual','disease','cell_type']:\n",
    "    print(col, 'nunique', adata.obs[col].nunique(), 'values', [str(x) for x in adata.obs[col].astype(str).unique()[:30]])\n",
    "print('layers', list(adata.layers.keys()))\n",
    "print('counts_dtype', adata.layers['counts'].dtype, 'counts_type', type(adata.layers['counts']).__name__)\n",
    "if 'gene_symbol' in adata.var.columns:\n",
    "    print('gene_symbol_head', [str(x) for x in adata.var['gene_symbol'].iloc[:10]])\n",
    "else:\n",
    "    print('gene_symbol_column_absent')\n",
    "print('individual_disease_consistency', adata.obs.groupby('individual', observed=True)['disease'].nunique().max())\n"
   ]
  }
